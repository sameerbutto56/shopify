<script>
  window.enamelsSwitchPreviewTab = function(mode) {
    var custBtn = document.getElementById('tab-btn-cust');
    var adminBtn = document.getElementById('tab-btn-admin');
    var custPane = document.getElementById('pane-cust-preview');
    var adminPane = document.getElementById('pane-admin-preview');

    if (mode === 'admin') {
      if (custBtn) custBtn.classList.remove('active');
      if (adminBtn) adminBtn.classList.add('active');
      if (custPane) custPane.classList.remove('active');
      if (adminPane) adminPane.classList.add('active');
    } else {
      if (adminBtn) adminBtn.classList.remove('active');
      if (custBtn) custBtn.classList.add('active');
      if (adminPane) adminPane.classList.remove('active');
      if (custPane) custPane.classList.add('active');
    }
  };

  window.enamelsTrackWhatsAppClick = function() {
    try {
      sessionStorage.setItem('enamels_wa_proof_submitted', 'true');
    } catch(e) {}
  };
</script>
