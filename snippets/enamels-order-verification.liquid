{% comment %}
  Enamels Order & Online Payment Verification Component
  Displays:
  1. Official Confirmation & Verification Call Notice
  2. Order Reference & Pending Verification Status Card
  3. WhatsApp Payment Screenshot Submission Button & Guidance
  4. Mandatory Customer Order Confirmation Preview (Sample Demonstration Data)
  5. Mandatory Admin Order Details Preview (9-Section Clean Layout for Enamels Operations Team)
{% endcomment %}

{%- liquid
  assign raw_wa = settings.whatsapp_number | default: '923011331133'
  assign wa_clean = raw_wa | replace: '+', '' | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', ''
  assign order_ref = order.name | default: order.order_number | default: 'ENM-2026-8941'
-%}

<div class="enamels-order-verification-container" id="enamels-order-verification-box">
  
  <!-- Verification Card Main -->
  <div class="enamels-verif-card">
    
    <!-- Header Status Banner -->
    <div class="verif-card-header">
      <div class="verif-status-badge">
        <span class="status-pulse-dot"></span>
        <span id="verif-status-text">⏳ Payment Pending Verification</span>
      </div>
      <div class="verif-order-ref">
        Order: <strong id="verif-display-order-id">#{{ order_ref | remove: '#' }}</strong>
      </div>
    </div>

    <!-- Official Confirmation Call Message -->
    <div class="verif-message-box">
      <div class="verif-icon-circle">✓</div>
      <div class="verif-message-content">
        <h3 class="verif-message-title">Order Received — Pending Verification</h3>
        <p class="verif-message-body">
          Thank you for placing your order with Enamels! Your payment and order details have been received. Our verification team will contact you within one working day to verify your payment and confirm your order. Please keep your phone available.
        </p>
      </div>
    </div>

    <!-- WhatsApp Screenshot Submission Block -->
    {% if wa_clean != blank %}
      <div class="verif-whatsapp-box">
        <div class="whatsapp-box-left">
          <div class="wa-shield-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="#128c7e">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.41 1.56 1.56 2.41 3.62 2.41 5.83 0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31c-.82-1.31-1.26-2.83-1.26-4.38 0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.03-1.25-.75-.67-1.26-1.5-1.41-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.13-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.84-.86 2.05 0 1.21.88 2.38 1 2.55.13.17 1.74 2.65 4.21 3.72.59.25 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.23-.17-.48-.3"/>
            </svg>
          </div>
          <div>
            <strong class="wa-box-title">For faster payment verification:</strong>
            <p class="wa-box-sub">
              For faster payment verification, please send a screenshot of your payment transaction along with your Order Number to our official Enamels WhatsApp number.
            </p>
          </div>
        </div>

        <div class="whatsapp-btn-wrap">
          <a
            href="https://wa.me/{{ wa_clean }}?text=Hello%20Enamels%2C%20I%20have%20placed%20Order%20%23{{ order_ref | remove: '#' }}%20and%20completed%20my%20online%20payment.%20I%20am%20sharing%20my%20payment%20screenshot%20for%20verification.%20Please%20verify%20and%20confirm%20my%20order."
            id="enamels-btn-whatsapp-screenshot"
            class="btn-send-screenshot-wa"
            target="_blank"
            rel="noopener"
            onclick="window.enamelsTrackWhatsAppClick()"
          >
            <span class="wa-btn-icon">💬</span>
            <span class="wa-btn-text">Send Payment Screenshot on WhatsApp</span>
          </a>
          <span class="wa-manual-note">
            📎 Please manually attach your payment screenshot or receipt inside WhatsApp before sending.
          </span>
        </div>
      </div>
    {% endif %}

