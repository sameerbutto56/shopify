    <div class="verif-details-grid">
      <div class="verif-detail-col">
        <span class="detail-label">Verification Window</span>
        <strong class="detail-val">Within 1 Working Day</strong>
        <span class="detail-sub">Mon – Sat (9:00 AM – 6:00 PM)</span>
      </div>

      <div class="verif-detail-col">
        <span class="detail-label">Payment Verification Rule</span>
        <strong class="detail-val">Bank & Gateway Clearance</strong>
        <span class="detail-sub">Orders confirmed upon actual bank credit</span>
      </div>

      <div class="verif-detail-col">
        <span class="detail-label">Official Support Contact</span>
        <strong class="detail-val">+{{ wa_clean }}</strong>
        <span class="detail-sub">Official Enamels WhatsApp Desk</span>
