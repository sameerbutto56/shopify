{% comment %}
  ENAMELS ONLINE — HOME SERVICE BOOKING SYSTEM & ADMIN ORDER MANAGEMENT
  Features:
  - Part 1: Service-Request Form (Customer info, approved Lahore address snapshot, visit window, PKR 25k min order policy, PKR 3,000 adjustable deposit, NO online product selection)
  - Part 2: Admin Home Service Order Management (Dedicated Home Service order view, 10-stage lifecycle, visit/measurements tracking, final order linking, single deposit credit accounting)
{% endcomment %}

{% liquid
  assign ss_heading = section.settings.heading | default: "Enamels Home Service — Sizing & Uniform Consultation"
  assign ss_subtext = section.settings.subtext | default: "Experience personalized medical uniform fitting at your hospital, clinic, or residence in Lahore. An authorized Enamels representative visits with sample sizing garments, genuine textile swatch rings, and embroidery consultation to assess your exact requirements and take precision measurements in person."
  assign min_order = section.settings.min_order_value | default: 25000
  assign adv_deposit = section.settings.advance_amount | default: 3000
  assign adv_expl = section.settings.advance_explanation | default: "100% adjustable against your final order total. It is not an additional service charge."
  assign srv_area = section.settings.service_area_notice | default: "Service is provided exclusively to administrator-approved Lahore medical zones and healthcare corridors."
  assign conf_msg = section.settings.confirmation_message | default: "Our Customer Care team will contact you directly to confirm visit slot, venue, and consultation details."
  assign show_prefs = true
  if section.settings.show_visit_preferences == false
    assign show_prefs = false
  endif
  assign show_notes = true
  if section.settings.show_customer_notes == false
    assign show_notes = false
  endif
%}

<script id="enamels-home-service-config" type="application/json">
{
  "heading": {{ ss_heading | json }},
  "subtext": {{ ss_subtext | json }},
  "minOrderValue": {{ min_order }},
  "advanceAmount": {{ adv_deposit }},
  "advanceExplanation": {{ adv_expl | json }},
  "serviceAreaNotice": {{ srv_area | json }},
  "confirmationMessage": {{ conf_msg | json }},
  "showVisitPreferences": {{ show_prefs }},
  "showCustomerNotes": {{ show_notes }},
  "addresses": [
    {% assign addr_count = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'approved_address' %}
        {% if addr_count > 0 %},{% endif %}
        {
          "id": {{ block.id | json }},
          "area": {{ block.settings.area | json }},
          "zoneTag": {{ block.settings.zone_tag | json }},
          "fullAddress": {{ block.settings.full_address | json }},
          "active": {{ block.settings.active | json }}
        }
        {% assign addr_count = addr_count | plus: 1 %}
      {% endif %}
    {% endfor %}
  ]
}
</script>

<div class="chroma-view-panel" id="view-self-service">
  <div class="page-container" style="padding-top: 10px; padding-bottom: 60px;">

    <!-- Breadcrumb -->
    <div style="font-size: 12px; color: #64748b; padding: 16px 0 10px;">
      <a href="#" onclick="window.navigateToView('home'); return false;" style="color: #64748b; text-decoration: none;">Home</a>
      <span style="margin: 0 6px;">/</span>
      <strong style="color: #102a43;">Enamels Home Service Booking</strong>
    </div>

    <!-- ============================================================ -->
    <!-- 1. HERO SECTION: PROMINENT SERVICE EXPLANATION & POLICIES    -->
    <!-- ============================================================ -->
    <div class="self-service-hero-card">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px; flex-wrap: wrap;">
        <span class="nav-tag-highlight" style="background: #008779; color: #ffffff; font-weight: 700; letter-spacing: 0.5px; padding: 4px 10px;">
          PREMIUM CONCIERGE SERVICE
        </span>
        <span class="self-service-location-pill" style="background: #e0f2fe; color: #0369a1; font-weight: 700;">
          📍 Available in Lahore Only
        </span>
        <span style="background: #fef3c7; color: #92400e; font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 999px;">
          MINIMUM ORDER: PKR {{ min_order }}
        </span>
      </div>

      <h1 class="self-service-main-heading" style="font-size: 26px; color: #102a43; font-weight: 700; margin: 0 0 8px;">
        {{ ss_heading | escape }}
      </h1>

      <p class="self-service-main-desc" style="font-size: 14px; color: #475569; line-height: 1.6; max-width: 860px; margin: 0 0 20px;">
        {{ ss_subtext | escape }}
      </p>

      <!-- Prominent Policy Banner Cards Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; margin-bottom: 20px;">
        <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 8px; padding: 14px 16px;">
          <div style="font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">1. Minimum Order Requirement</div>
          <div style="font-size: 18px; font-weight: 700; color: #102a43;">PKR {{ min_order }}</div>
          <p style="font-size: 11px; color: #64748b; margin: 4px 0 0; line-height: 1.4;">
            Qualifying uniform order value finalized during or after the representative's in-person visit.
          </p>
        </div>

        <div style="background: #f0fdfa; border: 1.5px solid #99f6e4; border-radius: 8px; padding: 14px 16px;">
          <div style="font-size: 11px; font-weight: 700; color: #008779; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">2. Adjustable Advance Deposit</div>
          <div style="font-size: 18px; font-weight: 700; color: #008779;">PKR {{ adv_deposit }}</div>
          <p style="font-size: 11px; color: #0f766e; margin: 4px 0 0; line-height: 1.4; font-weight: 500;">
            <strong>{{ adv_expl | escape }}</strong>
          </p>
        </div>

        <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 8px; padding: 14px 16px;">
          <div style="font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">3. Service Coverage</div>
          <div style="font-size: 18px; font-weight: 700; color: #102a43;">Lahore Only</div>
          <p style="font-size: 11px; color: #64748b; margin: 4px 0 0; line-height: 1.4;">
            {{ srv_area | escape }}
          </p>
        </div>

        <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 8px; padding: 14px 16px;">
          <div style="font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">4. Next Step Coordination</div>
          <div style="font-size: 16px; font-weight: 700; color: #102a43;">Customer Care Call</div>
          <p style="font-size: 11px; color: #64748b; margin: 4px 0 0; line-height: 1.4;">
            {{ conf_msg | escape }}
          </p>
        </div>
      </div>

      <!-- Key Benefits Grid -->
      <div class="self-service-benefits-grid">
        <div class="self-service-benefit-item">
          <div class="self-service-benefit-icon">📏</div>
          <div>
            <h4 class="self-service-benefit-title">In-Person Sizing & Fitting</h4>
            <p class="self-service-benefit-desc">Representative brings trial garments to take exact measurements in person.</p>
          </div>
        </div>

        <div class="self-service-benefit-item">
          <div class="self-service-benefit-icon">🎨</div>
          <div>
            <h4 class="self-service-benefit-title">Textile & Swatch Rings</h4>
            <p class="self-service-benefit-desc">Touch authentic 4-way stretch twill, micro-drape, and gabardine swatches.</p>
          </div>
        </div>

        <div class="self-service-benefit-item">
          <div class="self-service-benefit-icon">🪡</div>
          <div>
            <h4 class="self-service-benefit-title">Embroidery & Insignia Review</h4>
            <p class="self-service-benefit-desc">Discuss Madeira Polyneon™ threads, clinician titles, and crest placements.</p>
          </div>
        </div>

        <div class="self-service-benefit-item">
          <div class="self-service-benefit-icon">📋</div>
          <div>
            <h4 class="self-service-benefit-title">Dedicated Order Management</h4>
            <p class="self-service-benefit-desc">Full visit tracking with single PKR {{ adv_deposit }} advance adjustment credited to final order.</p>
          </div>
        </div>
      </div>

      <!-- Staff Portal Trigger Link -->
      <div style="text-align: right; padding-top: 6px;">
        <button type="button" onclick="window.openSelfServiceAdminModal()" style="background: none; border: none; font-size: 12px; color: #64748b; text-decoration: underline; cursor: pointer;">
          🔐 Staff Portal: Manage Home Service Orders
        </button>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- 2. STREAMLINED SERVICE REQUEST FORM CONTAINER                -->
    <!-- ============================================================ -->
    <div class="self-service-booking-container" id="self-service-booking-card">

      <!-- Form Stepper Header (3 Clean Steps) -->
      <div class="pdp-stepper-container" style="margin-bottom: 24px;">
        <div class="pdp-stepper-header-meta">
          <div class="pdp-step-counter-badge" id="ss-step-counter-badge">
            <span class="pdp-step-badge-dot"></span>
            <span id="ss-step-badge-text">Step 1 of 3: Customer Information & Visit Preferences</span>
            <span class="pdp-step-badge-sep">•</span>
            <span id="ss-step-remaining-text">2 steps remaining</span>
          </div>
          <div class="pdp-stepper-status-msg" id="ss-stepper-status-msg">
            Enter clinician contact details & preferred visit window
          </div>
        </div>

        <div class="pdp-stepper-track-wrap">
          <div class="pdp-stepper-progress-bg">
            <div class="pdp-stepper-progress-fill" id="ss-progress-fill" style="width: 33.3%;"></div>
          </div>
          <div class="pdp-stepper-track" id="ss-stepper-track">
            <!-- Step 1 -->
            <button type="button" class="pdp-step-btn active" id="ss-nav-btn-contact" onclick="window.goToSelfServiceStep(1)">
              <div class="pdp-step-circle">
                <span class="step-num">1</span>
                <span class="step-check">✓</span>
              </div>
              <div class="pdp-step-text">
                <span class="pdp-step-label">Contact & Visit</span>
                <span class="pdp-step-state-text" id="ss-sub-contact">Required</span>
              </div>
            </button>
            <!-- Step 2 -->
            <button type="button" class="pdp-step-btn upcoming" id="ss-nav-btn-address" onclick="window.goToSelfServiceStep(2)">
              <div class="pdp-step-circle">
                <span class="step-num">2</span>
                <span class="step-check">✓</span>
              </div>
              <div class="pdp-step-text">
                <span class="pdp-step-label">Lahore Area</span>
                <span class="pdp-step-state-text" id="ss-sub-address">Select Zone</span>
              </div>
            </button>
            <!-- Step 3 -->
            <button type="button" class="pdp-step-btn upcoming" id="ss-nav-btn-review" onclick="window.goToSelfServiceStep(3)">
              <div class="pdp-step-circle">
                <span class="step-num">3</span>
                <span class="step-check">✓</span>
              </div>
              <div class="pdp-step-text">
                <span class="pdp-step-label">Review & Deposit</span>
                <span class="pdp-step-state-text" id="ss-sub-review">PKR {{ adv_deposit }} Advance</span>
              </div>
            </button>
          </div>
        </div>
      </div>

      <!-- FORM ERROR BANNER -->
      <div class="pdp-step-error-banner" id="ss-form-error-banner" style="display: none; margin-bottom: 16px;"></div>

      <!-- ==================================================== -->
      <!-- STEP 1 PANE: CUSTOMER CONTACT & VISIT PREFERENCES    -->
      <!-- ==================================================== -->
      <div class="self-service-pane active" id="ss-pane-1">
        <div class="pdp-step-box-header">
          <h3 class="pdp-step-title">
            <span>👤 Step 1: Customer Contact & Visit Preferences</span>
          </h3>
          <span style="font-size: 11px; color: #64748b;">All fields marked * are required</span>
        </div>

        <p style="font-size: 13px; color: #64748b; margin: 8px 0 16px; line-height: 1.5;">
          Provide your contact details so our Customer Care team can coordinate your in-person visit. An Enamels representative will bring sample garments, sizing sets, and textile rings directly to your clinic or hospital to collect your uniform requirements and measurements in person.
        </p>

        <div class="alteration-fields-grid" style="margin-top: 14px;">
          <div class="form-field-group">
            <label>Full Name & Title (e.g. Dr. Ayesha Malik) *</label>
            <input type="text" class="form-field-input" id="ss-input-name" placeholder="Doctor / Clinician Full Name" />
          </div>

          <div class="form-field-group">
            <label>Mobile Number (Pakistan format) *</label>
            <input type="tel" class="form-field-input" id="ss-input-phone" placeholder="0300-1234567" />
          </div>

          <div class="form-field-group">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <label>WhatsApp Number (Optional if different)</label>
              <label style="font-size: 11px; color: #008779; cursor: pointer; display: flex; align-items: center; gap: 4px;">
                <input type="checkbox" id="ss-same-whatsapp" onchange="window.syncSelfServiceWhatsApp(this.checked)" />
                <span>Same as Mobile</span>
              </label>
            </div>
            <input type="tel" class="form-field-input" id="ss-input-whatsapp" placeholder="0300-1234567" />
          </div>

          <div class="form-field-group">
            <label>Email Address (Optional)</label>
            <input type="email" class="form-field-input" id="ss-input-email" placeholder="doctor@hospital.org" />
          </div>

          <div class="form-field-group" style="grid-column: 1 / -1;">
            <label>Preferred Contact Method for Visit Coordination *</label>
            <div style="display: flex; gap: 20px; margin-top: 6px; flex-wrap: wrap;">
              <label style="display: flex; align-items: center; gap: 8px; font-size: 13px; cursor: pointer;">
                <input type="radio" name="ss_contact_method" value="WhatsApp" checked style="accent-color: #008779;" />
                <span>WhatsApp Message (Recommended for clinical schedules)</span>
              </label>
              <label style="display: flex; align-items: center; gap: 8px; font-size: 13px; cursor: pointer;">
                <input type="radio" name="ss_contact_method" value="Phone Call" style="accent-color: #008779;" />
                <span>Phone Call</span>
              </label>
            </div>
          </div>

          {% if show_prefs %}
          <div class="form-field-group">
            <label>Preferred Visit Date or Time Window (Optional)</label>
            <select class="form-field-select" id="ss-input-visit-window">
              <option value="Flexible / Coordinate with Customer Care">Flexible (Customer Care will coordinate)</option>
              <option value="Morning (10:00 AM – 1:00 PM)">Morning (10:00 AM – 1:00 PM)</option>
              <option value="Afternoon (2:00 PM – 5:00 PM)">Afternoon (2:00 PM – 5:00 PM)</option>
              <option value="Evening (5:00 PM – 8:00 PM)">Evening (5:00 PM – 8:00 PM)</option>
            </select>
          </div>

          <div class="form-field-group">
            <label>Specific Preferred Date (Optional, subject to availability)</label>
            <input type="date" class="form-field-input" id="ss-input-preferred-date" />
          </div>
          {% endif %}

          {% if show_notes %}
          <div class="form-field-group" style="grid-column: 1 / -1;">
            <label>Additional Notes or Special Requirements (Optional)</label>
            <textarea class="form-field-input" id="ss-input-notes" rows="3" placeholder="e.g. Please bring sample sizes for surgical scrub trousers, prefer visit between ward rounds, interested in custom embroidery options."></textarea>
          </div>
          {% endif %}
        </div>

        <div class="pdp-step-nav-bar">
          <button type="button" class="btn-step-prev" onclick="window.navigateToView('home')">
            ← Return to Homepage
          </button>
          <button type="button" class="btn-step-next" id="ss-step1-next-btn" onclick="window.nextSelfServiceStep(1)">
            Continue to Lahore Service Address →
          </button>
        </div>
      </div>

      <!-- ==================================================== -->
      <!-- STEP 2 PANE: SELECT SERVICE ADDRESS IN LAHORE        -->
      <!-- ==================================================== -->
      <div class="self-service-pane" id="ss-pane-2">
        <div class="pdp-step-box-header">
          <h3 class="pdp-step-title">
            <span>📍 Step 2: Select Approved Lahore Service Address</span>
          </h3>
          <span style="font-size: 11px; background: #e0f2fe; color: #0369a1; padding: 2px 8px; border-radius: 4px; font-weight: 700;">
            LAHORE ONLY
          </span>
        </div>

        <p style="font-size: 13px; color: #475569; margin: 8px 0 16px; line-height: 1.5;">
          Select your address from the administrator-configured list of approved Lahore service locations. <strong>Free-text arbitrary addresses outside Lahore are not permitted.</strong> An immutable snapshot of your chosen approved address will be stored with your booking.
        </p>

        <!-- Clickable Address Selection Cards List -->
        <div id="ss-approved-addresses-list" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 12px; margin-bottom: 20px;">
          <!-- Dynamically populated by renderApprovedAddressesList() -->
        </div>

        <!-- Optional Landmark / Hospital Ward Field -->
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px;">
          <h4 style="font-size: 12px; font-weight: 700; color: #102a43; margin: 0 0 4px; text-transform: uppercase;">
            Optional Location Details / Hospital Landmark
          </h4>
          <p style="font-size: 11px; color: #64748b; margin: 0 0 10px;">
            Specify your hospital wing, doctor's hostel room, or parking instructions. This field does not alter your approved service zone.
          </p>
          <input type="text" class="form-field-input" id="ss-input-landmark" placeholder="e.g. Doctors Hostel Block B, Ward 4 Consultation Room, Gate 3 Entry" />
        </div>

        <div class="pdp-step-nav-bar">
          <button type="button" class="btn-step-prev" onclick="window.goToSelfServiceStep(1)">
            ← Back to Contact Information
          </button>
          <button type="button" class="btn-step-next" onclick="window.nextSelfServiceStep(2)">
            Continue to Review & Advance Policy →
          </button>
        </div>
      </div>

      <!-- ==================================================== -->
      <!-- STEP 3 PANE: REVIEW BOOKING & ADVANCE DEPOSIT        -->
      <!-- ==================================================== -->
      <div class="self-service-pane" id="ss-pane-3">
        <div class="pdp-step-box-header">
          <h3 class="pdp-step-title">
            <span>📋 Step 3: Review Booking & Advance Deposit Policy</span>
          </h3>
          <span style="font-size: 11px; background: #f0fdf4; color: #166534; padding: 2px 8px; border-radius: 4px; font-weight: 700;">
            ADVANCE REQUIRED: PKR {{ adv_deposit }}
          </span>
        </div>

        <p style="font-size: 13px; color: #64748b; margin: 8px 0 16px; line-height: 1.5;">
          Please review your contact information, approved Lahore service location, and visit preferences before submitting your Home Service request.
        </p>

        <!-- Comprehensive Booking Summary Recap Grid -->
        <div class="self-service-recap-grid" id="ss-review-recap-grid" style="margin-top: 14px;">
          <!-- Dynamically populated by renderSelfServiceRecap() -->
        </div>

        <!-- Pricing & Advance Adjustment Policy Card -->
        <div class="pdp-step-box" style="background: #ffffff; border: 1.5px solid #cbd5e1; border-radius: 8px; padding: 20px; margin: 20px 0;">
          <h4 style="font-size: 14px; font-weight: 700; color: #102a43; margin: 0 0 12px; text-transform: uppercase;">
            💰 Home Service Pricing & Advance Policy
          </h4>

          <table class="order-summary-table" style="font-size: 13px;">
            <tbody>
              <tr>
                <td>Home Service Minimum Qualifying Order:</td>
                <td class="text-right" style="font-weight: 700; color: #102a43;">PKR {{ min_order }}</td>
              </tr>
              <tr>
                <td>Estimated Product Order Value:</td>
                <td class="text-right" style="font-weight: 600; color: #64748b;">To be determined during visit</td>
              </tr>
              <tr style="background: #f0fdfa;">
                <td><strong>Required Booking Deposit (Adjustable):</strong></td>
                <td class="text-right" style="font-weight: 800; color: #008779; font-size: 15px;">PKR {{ adv_deposit }}</td>
              </tr>
              <tr style="border-top: 2px solid #102a43;">
                <td><strong>Eventual Remaining Balance Due:</strong></td>
                <td class="text-right" style="font-weight: 700; color: #102a43; font-size: 14px;">Final Order Total − PKR {{ adv_deposit }} Deposit</td>
              </tr>
            </tbody>
          </table>

          <div style="margin-top: 14px; padding: 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; font-size: 12px; color: #475569; line-height: 1.5;">
            ℹ️ <strong>Advance Payment Adjustment Policy:</strong> The PKR {{ adv_deposit }} advance is an adjustable booking deposit deducted directly from your final uniform order total. It is <strong>not</strong> an additional fee or consultation surcharge. The minimum qualifying order value of PKR {{ min_order }} will apply when our representative finalizes your requirements in person.
          </div>
        </div>

        <!-- Supported Payment Method Selection for Advance -->
        <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 20px; margin-bottom: 20px;">
          <h4 style="font-size: 13px; font-weight: 700; color: #102a43; margin: 0 0 12px; text-transform: uppercase;">
            Payment Method for PKR {{ adv_deposit }} Booking Deposit
          </h4>

          <div style="display: flex; flex-direction: column; gap: 12px;">
            <label style="display: flex; align-items: flex-start; gap: 12px; background: #ffffff; border: 1.5px solid #008779; border-radius: 6px; padding: 14px; cursor: pointer;">
              <input type="radio" name="ss_payment_method" value="shopify_checkout" checked style="margin-top: 3px; accent-color: #008779;" onchange="window.toggleManualPaymentDetails(false)" />
              <div>
                <strong style="color: #102a43; font-size: 13px;">Shopify Secure Checkout (Card / Digital Deposit)</strong>
                <p style="font-size: 12px; color: #64748b; margin: 4px 0 0;">
                  Places a PKR {{ adv_deposit }} "Home Service Booking Deposit" line item in your cart with full booking metadata for secure card or digital checkout.
                </p>
              </div>
            </label>

            <label style="display: flex; align-items: flex-start; gap: 12px; background: #ffffff; border: 1.5px solid #cbd5e1; border-radius: 6px; padding: 14px; cursor: pointer;">
              <input type="radio" name="ss_payment_method" value="bank_transfer" style="margin-top: 3px; accent-color: #008779;" onchange="window.toggleManualPaymentDetails(this.checked)" />
              <div>
                <strong style="color: #102a43; font-size: 13px;">Official Bank Transfer / JazzCash / EasyPaisa</strong>
                <p style="font-size: 12px; color: #64748b; margin: 4px 0 0;">
                  Submit with proof of transfer. Booking is placed in "Awaiting Advance Payment" until verified by staff.
                </p>
              </div>
            </label>
          </div>

          <!-- Manual Bank Transfer Details (Collapsible) -->
          <div id="ss-manual-bank-details" style="display: none; margin-top: 14px; padding: 14px; background: #f0fdfa; border: 1px dashed #00b8a9; border-radius: 6px; font-size: 12px;">
            <div style="font-weight: 700; color: #008779; margin-bottom: 6px;">Enamels Official Advance Accounts:</div>
            <div>Bank: <strong>Meezan Bank Limited</strong> | Title: <strong>Enamels Online Medical</strong></div>
            <div>IBAN: <strong>PK42MEZN0001020104928192</strong> | Account: <strong>0102-0104928192</strong></div>
            <div style="margin-top: 4px;">JazzCash / EasyPaisa: <strong>0301-1331133</strong></div>
            <div style="margin-top: 10px;">
              <label style="font-weight: 600; display: block; margin-bottom: 4px;">Bank Transaction Reference / Deposit Slip Number</label>
              <input type="text" class="form-field-input" id="ss-input-trx-ref" placeholder="e.g. TRX-982341 or JazzCash Ref ID" />
            </div>
          </div>
        </div>

        <!-- Terms Acknowledgement Checkbox -->
        <div style="padding: 14px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; margin-bottom: 20px;">
