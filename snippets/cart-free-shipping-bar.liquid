{% doc %}
  Dynamic Free Shipping Goal Progress Bar for Cart Drawer & Cart Page
{% enddoc %}

{%- liquid
  assign threshold_amount = settings.free_shipping_threshold | default: 2999
  assign threshold_cents = threshold_amount | times: 100
  assign current_total = cart.total_price
  assign remaining_cents = threshold_cents | minus: current_total

  if remaining_cents <= 0
    assign is_unlocked = true
    assign progress_percent = 100
  else
    assign is_unlocked = false
    assign progress_percent = current_total | times: 100 | divided_by: threshold_cents
    if progress_percent > 100
      assign progress_percent = 100
    endif
  endif
-%}

<div class="cart-free-shipping-goal" data-threshold="{{ threshold_cents }}">
  <div class="free-shipping-message">
    {% if is_unlocked %}
      <span class="unlocked-text">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="#059669" style="vertical-align: -3px; margin-right: 4px;">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <strong>Congratulations!</strong> You've unlocked <strong>FREE SHIPPING</strong>!
      </span>
    {% else %}
      <span class="locked-text">
        Add <strong><span class="remaining-amount">{{ remaining_cents | money }}</span></strong> more to get <strong>FREE SHIPPING</strong>!
      </span>
    {% endif %}
  </div>
  <div class="free-shipping-progress-track">
    <div
      class="free-shipping-progress-bar{% if is_unlocked %} is-complete{% endif %}"
      style="width: {{ progress_percent }}%;"
      role="progressbar"
      aria-valuenow="{{ progress_percent }}"
      aria-valuemin="0"
      aria-valuemax="100"
    ></div>
  </div>
</div>

<style>
  .cart-free-shipping-goal {
    padding: 12px 16px;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    font-size: 13px;
    color: #1e293b;
    line-height: 1.4;
  }
  .free-shipping-message {
    margin-bottom: 8px;
    text-align: center;
  }
  .free-shipping-message strong {
    color: #0f172a;
    font-weight: 600;
  }
  .free-shipping-progress-track {
    width: 100%;
    height: 6px;
    background: #e2e8f0;
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }
  .free-shipping-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #10b981 0%, #059669 100%);
    border-radius: 999px;
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .free-shipping-progress-bar.is-complete {
    background: #059669;
  }
</style>
