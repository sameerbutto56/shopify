{% comment %}
  Enamels Global Bespoke Customizer Modal
  Provides instant zero-latency access to the 9-step scrub customizer
  across all storefront pages without 404 errors.
{% endcomment %}

<!-- Customizer Backdrop & Modal Container -->
<div
  class="enamels-customizer-modal-wrap"
  id="enamels-customizer-modal-overlay"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="customizer-modal-title"
  style="display: none;"
>
  <div class="enamels-customizer-modal-backdrop" onclick="window.closeCustomizerModal()"></div>

  <div class="enamels-customizer-modal-content">
    <div class="enamels-customizer-modal-bar">
      <div class="customizer-modal-title-group">
        <span class="customizer-modal-badge">Official Clinical Studio</span>
        <h2 class="customizer-modal-heading" id="customizer-modal-title">Customize Your Own Scrub</h2>
      </div>
      <button
        type="button"
        class="enamels-customizer-modal-close"
        onclick="window.closeCustomizerModal()"
        aria-label="Close Customizer Studio"
      >
        ✕
      </button>
    </div>

    <div class="enamels-customizer-modal-body">
      {% render 'enamels-customization-wizard' %}
    </div>
  </div>
</div>

<style>
  .enamels-customizer-modal-wrap {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .enamels-customizer-modal-wrap.is-open {
    opacity: 1;
    visibility: visible;
    display: flex !important;
  }

  .enamels-customizer-modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .enamels-customizer-modal-content {
    position: relative;
    width: 100%;
    max-width: 1160px;
    max-height: 94vh;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    z-index: 2;
    transform: scale(0.96);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .enamels-customizer-modal-wrap.is-open .enamels-customizer-modal-content {
    transform: scale(1);
  }

  .enamels-customizer-modal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    flex-shrink: 0;
  }

  .customizer-modal-badge {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #008779;
    display: block;
    margin-bottom: 2px;
  }

  .customizer-modal-heading {
    font-size: 18px;
    font-weight: 800;
    color: #102a43;
    margin: 0;
  }

  .enamels-customizer-modal-close {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #475569;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .enamels-customizer-modal-close:hover {
    background: #ef4444;
    color: #ffffff;
    border-color: #ef4444;
  }

  .enamels-customizer-modal-body {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: 16px 20px 32px;
    -webkit-overflow-scrolling: touch;
  }

  @media (max-width: 640px) {
    .enamels-customizer-modal-wrap {
      padding: 0;
    }
    .enamels-customizer-modal-content {
      max-height: 100vh;
      height: 100vh;
      border-radius: 0;
    }
    .enamels-customizer-modal-bar {
      padding: 12px 16px;
    }
    .enamels-customizer-modal-body {
      padding: 12px 12px 28px;
    }
  }
</style>

<script>
  (function initCustomizerModalController() {
    window.openCustomizerModal = function() {
      var modal = document.getElementById('enamels-customizer-modal-overlay');
      if (modal) {
        modal.style.display = 'flex';
        // Force reflow for transition
        modal.offsetHeight;
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';

        try {
          if (window.history && window.history.pushState && window.location.hash !== '#customizer') {
            window.history.pushState({ modal: 'customizer' }, '', '#customizer');
          }
        } catch(e) {}
      }
    };

    window.closeCustomizerModal = function() {
      var modal = document.getElementById('enamels-customizer-modal-overlay');
      if (modal) {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        setTimeout(function() {
          if (!modal.classList.contains('is-open')) {
            modal.style.display = 'none';
          }
        }, 250);
        document.body.style.overflow = '';

        try {
          if (window.location.hash === '#customizer') {
            if (window.history && window.history.pushState) {
              window.history.pushState(null, '', window.location.pathname + window.location.search);
            }
          }
        } catch(e) {}
      }
    };

    // Global listener: intercept clicks on any link targeting /pages/customizer or #customizer
    function setupCustomizerTriggers() {
      var customizerLinks = document.querySelectorAll('a[href*="customizer"], a[href="#customizer"], [data-open-customizer]');
      customizerLinks.forEach(function(link) {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          window.openCustomizerModal();
        });
      });
    }

    // Auto-open if URL indicates customizer or 404 from /pages/customizer
    function checkUrlForCustomizer() {
      var path = window.location.pathname.toLowerCase();
      var hash = window.location.hash.toLowerCase();
      var search = window.location.search.toLowerCase();

      if (path.indexOf('customizer') !== -1 || hash === '#customizer' || search.indexOf('customizer') !== -1) {
        // If on 404 page, hide 404 banner
        var page404 = document.querySelector('.main-404, .template-404, #main-404');
        if (page404) {
          page404.style.display = 'none';
        }
        window.openCustomizerModal();
      }
    }

    // Override window.navigateToView if present
    var origNav = window.navigateToView;
    window.navigateToView = function(viewId) {
      if (viewId === 'ready-to-wear' || viewId === 'customizer' || viewId === 'customize') {
        window.openCustomizerModal();
        return;
      }
      if (typeof origNav === 'function') {
        origNav(viewId);
      }
    };

    document.addEventListener('DOMContentLoaded', function() {
      setupCustomizerTriggers();
      checkUrlForCustomizer();

      // Mutation observer to handle dynamically rendered category cards
      var observer = new MutationObserver(function() {
        setupCustomizerTriggers();
      });
      observer.observe(document.body, { childList: true, subtree: true });

      // Handle browser back button
      window.addEventListener('popstate', function(e) {
        if (window.location.hash === '#customizer') {
          window.openCustomizerModal();
        } else {
          var modal = document.getElementById('enamels-customizer-modal-overlay');
          if (modal && modal.classList.contains('is-open')) {
            window.closeCustomizerModal();
          }
        }
      });

      // Escape key to close modal
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' || e.keyCode === 27) {
          window.closeCustomizerModal();
        }
      });
    });

    if (document.readyState === 'interactive' || document.readyState === 'complete') {
      setupCustomizerTriggers();
      checkUrlForCustomizer();
    }
  })();
</script>
