{% comment %}
  ENAMELS ONLINE — COMPLETE MEN / WOMEN BROWSING HIERARCHY
  Levels:
  - Level 1: Men / Women Selection
  - Level 2: Product Category Selection (Scrubs, Lab Coats, Caps, Sleeves & Accessories)
  - Level 3: Filtered Product Category View
  - Level 4: Brand / Article Series Selection (Sprinter, Velora, Crown, Flexwell, etc.)
  - Level 5: Available Product & Color Swatches Selection
  - Level 6: Launch into Existing Customization Studio
{% endcomment %}

<!-- VIEW: COLLECTION & BROWSING HIERARCHY -->
<div class="chroma-view-panel" id="view-category-scrubs">
  <div class="page-container" style="padding-top: 30px; padding-bottom: 60px;">

    <!-- Interactive Multi-Level Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="collection-breadcrumbs-bar" style="font-size: 13px; color: #64748b; margin-bottom: 22px; display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
      <a href="#" onclick="window.navigateToView('home'); return false;" class="breadcrumb-link">Home</a>
      <span class="breadcrumb-sep">/</span>
      
      <!-- Gender crumb -->
      <span id="crumb-gender-wrap">
        <a href="#" id="crumb-gender" onclick="window.navigateToGender(STATE.genderFilter || 'men'); return false;" class="breadcrumb-link">Men</a>
      </span>

      <!-- Category crumb -->
      <span id="crumb-category-sep" style="display: none;">/</span>
      <span id="crumb-category-wrap" style="display: none;">
        <a href="#" id="crumb-category" onclick="window.selectProductCategory(STATE.productCategoryFilter); return false;" class="breadcrumb-link">Scrubs</a>
      </span>

      <!-- Article crumb -->
      <span id="crumb-article-sep" style="display: none;">/</span>
      <strong style="color: #102a43;" id="crumb-article-current">All Products</strong>
    </nav>

    <!-- Collection Header -->
    <div class="collection-header-container" style="margin-bottom: 28px;">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap;">
        <span class="nav-tag-highlight" id="collection-category-tag" style="background: #102a43; color: #ffffff;">CATALOGUE</span>
        <span class="level-indicator-pill" id="collection-level-tag">STEP 1 OF 3: SELECT PRODUCT CATEGORY</span>
      </div>
      <h1 class="collection-main-heading" id="collection-main-heading">
        Men's Clinical Collection
      </h1>
      <p class="collection-sub-desc" id="collection-sub-desc">
        Explore purpose-built clinical uniforms and surgical apparel engineered for healthcare professionals. Choose a product category below to begin.
      </p>
    </div>

    <!-- LEVEL 2: PRODUCT CATEGORY SELECTION CARDS SECTION -->
    <div id="collection-category-selector-section" style="margin-bottom: 36px;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; flex-wrap: wrap; gap: 8px;">
        <h2 style="font-size: 14px; font-weight: 700; color: #102a43; text-transform: uppercase; letter-spacing: 0.5px; margin: 0;">
          1. Select Product Category:
        </h2>
        <button
          type="button"
          class="gender-pill-btn active"
          id="btn-cat-all"
          onclick="window.selectProductCategory('all')"
          style="padding: 4px 12px; font-size: 11px;"
        >
          View All Categories
        </button>
      </div>

      <div class="collection-category-grid" id="collection-category-cards-grid">
        <!-- Dynamically rendered by renderCategoryCardsForGender(gender, activeCat) -->
      </div>
    </div>

    <!-- LEVEL 4: BRANDS / ARTICLE SERIES SELECTOR SECTION -->
    <div id="collection-article-cards-section" style="margin-bottom: 32px; display: none;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <h2 style="font-size: 14px; font-weight: 700; color: #102a43; text-transform: uppercase; letter-spacing: 0.5px; margin: 0;">
            2. Select Brand / Article Series:
          </h2>
          <button
            type="button"
            onclick="window.navigateToGender(STATE.genderFilter || 'men')"
            style="background: none; border: none; color: #008779; font-size: 12px; font-weight: 600; cursor: pointer; text-decoration: underline;"
          >
            ← Change Category
          </button>
        </div>
        <button
          type="button"
          class="gender-pill-btn active"
          id="btn-article-all"
          onclick="window.selectArticle('all')"
          style="padding: 4px 12px; font-size: 11px;"
        >
          View All Series
        </button>
      </div>

      <div class="article-selector-grid" id="collection-article-cards-grid">
        <!-- Dynamically populated based on active gender & category -->
      </div>
    </div>

    <!-- Quick Navigation & Gender Switcher Bar -->
    <div class="scrubs-filter-bar">
      <!-- Gender Switcher Quick-Pills -->
      <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
        <span style="font-size: 11px; font-weight: 700; color: #102a43; text-transform: uppercase;">Gender:</span>
        <div class="gender-filter-pills">
          <button type="button" class="gender-pill-btn" id="gender-filter-men" onclick="window.navigateToGender('men')">
            Men
          </button>
          <button type="button" class="gender-pill-btn" id="gender-filter-women" onclick="window.navigateToGender('women')">
            Women
          </button>
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
        <span style="font-size: 11px; font-weight: 700; color: #102a43; text-transform: uppercase;">Category:</span>
        <div class="series-filter-tabs" id="category-filter-pills-bar">
          <button type="button" class="series-tab-btn active" id="cat-pill-all" onclick="window.selectProductCategory('all')">
            All Categories
          </button>
          <button type="button" class="series-tab-btn" id="cat-pill-scrubs" onclick="window.selectProductCategory('scrubs')">
            Scrubs
          </button>
          <button type="button" class="series-tab-btn" id="cat-pill-lab-coat" onclick="window.selectProductCategory('lab-coat')">
            Lab Coats
          </button>
          <button type="button" class="series-tab-btn" id="cat-pill-caps" onclick="window.selectProductCategory('caps')">
            Caps
          </button>
          <button type="button" class="series-tab-btn" id="cat-pill-accessories" onclick="window.selectProductCategory('accessories')">
            Accessories
          </button>
        </div>
      </div>
    </div>

    <!-- Active Filter Counter & Sort -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; font-size: 13px; color: #64748b; flex-wrap: wrap; gap: 12px;">
      <div>
        Showing <strong id="scrubs-visible-count" style="color: #102a43;">0</strong> designs for
        <span id="collection-filter-descriptor" style="font-weight: 600; color: #008779;">Men's All Products</span>
      </div>
      <div>
        <label for="scrubs-sort-select" style="font-size: 12px; margin-right: 6px;">Sort By:</label>
        <select id="scrubs-sort-select" onchange="window.sortScrubsCatalogue(this.value)" style="padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 12px; outline: none; background: #ffffff;">
          <option value="featured">Featured Best Sellers</option>
          <option value="price-low">Price: Low to High</option>
          <option value="price-high">Price: High to Low</option>
          <option value="name">Alphabetical (A-Z)</option>
        </select>
      </div>
    </div>

    <!-- LEVEL 5 & 6: DYNAMIC GRID OF PRODUCTS WITH COLOR SWATCHES -->
    <div class="products-cards-grid" id="scrubs-products-grid">
      <!-- Injected dynamically via catalogue data -->
    </div>

  </div>
</div>
