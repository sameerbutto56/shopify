{% comment %}
  ENAMELS ONLINE — MEN / WOMEN PRODUCT BROWSING HIERARCHY
  Strict Separation:
  - Page 1: Men / Women Category Landing Page (Category Cards ONLY, no products underneath)
  - Page 2: Selected Product Category Listing Page (Breadcrumbs, Back Button, Header, Working "All" + Article Filters, Counter, Sort, and Dynamic Product Cards Grid)
{% endcomment %}

<!-- VIEW: COLLECTION & BROWSING HIERARCHY -->
<div class="chroma-view-panel" id="view-category-scrubs">
  <div class="page-container" style="padding-top: 30px; padding-bottom: 60px;">

    <!-- ============================================================ -->
    <!-- SUBVIEW 1: MEN/WOMEN CATEGORY LANDING (PAGE 1)               -->
    <!-- Displays Category Cards ONLY. No product grid underneath!    -->
    <!-- ============================================================ -->
    <div id="subview-category-landing" style="display: block;">
      
      <!-- Interactive Breadcrumbs for Page 1 -->
      <nav aria-label="Breadcrumb" class="collection-breadcrumbs-bar" style="font-size: 13px; color: #64748b; margin-bottom: 22px; display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
        <a href="#" onclick="window.navigateToView('home'); return false;" class="breadcrumb-link">Home</a>
        <span class="breadcrumb-sep">/</span>
        <strong style="color: #102a43;" id="landing-crumb-gender">Men's Categories</strong>
      </nav>

      <!-- Category Landing Header with Quick Gender Switcher -->
      <div class="collection-header-container" style="margin-bottom: 32px;">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; margin-bottom: 12px;">
          <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
            <span class="nav-tag-highlight" id="landing-category-tag" style="background: #102a43; color: #ffffff;">CATALOGUE</span>
            <span class="level-indicator-pill" id="landing-level-tag">STEP 1 OF 2: CHOOSE PRODUCT CATEGORY</span>
          </div>

          <!-- Gender Switcher Pill Group on Landing Page -->
          <div class="landing-gender-switch-bar">
            <button
              type="button"
              class="gender-pill-toggle active"
              id="landing-gender-btn-men"
              onclick="window.navigateToGender('men', 'all', 'all')"
              aria-label="View Men's Product Categories"
            >
              Men's Categories
            </button>
            <button
              type="button"
              class="gender-pill-toggle"
              id="landing-gender-btn-women"
              onclick="window.navigateToGender('women', 'all', 'all')"
              aria-label="View Women's Product Categories"
            >
              Women's Categories
            </button>
          </div>
        </div>

        <h1 class="collection-main-heading" id="landing-main-heading">
          Men's Clinical Collection
        </h1>
        <p class="collection-sub-desc" id="landing-sub-desc">
          Explore purpose-built clinical uniforms and surgical apparel engineered for healthcare professionals. Choose a product category below to view designs and available articles.
        </p>
      </div>

      <!-- LEVEL 2: PRODUCT CATEGORY SELECTION CARDS SECTION -->
      <div id="collection-category-selector-section" style="margin-bottom: 20px;">
        <div class="collection-category-grid" id="collection-category-cards-grid">
          <!-- Dynamically populated by renderCategoryCardsForGender(gender) -->
        </div>
      </div>

      <!-- PAGE 1 ENDS HERE: STRICTLY NO PRODUCT CARDS OR PRODUCT GRID! -->
    </div>


    <!-- ============================================================ -->
    <!-- SUBVIEW 2: SELECTED PRODUCT CATEGORY & LISTING (PAGE 2)      -->
    <!-- Displays Category Title, Article Filters with "All", Sort,   -->
    <!-- and Product Grid. Filtered cleanly by gender & category.      -->
    <!-- ============================================================ -->
    <div id="subview-product-listing" style="display: none;">

      <!-- Top Navigation Row: Breadcrumbs & Back Button -->
      <div class="listing-nav-top-row" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 22px;">
        <nav aria-label="Breadcrumb" class="collection-breadcrumbs-bar" style="font-size: 13px; color: #64748b; display: flex; align-items: center; flex-wrap: wrap; gap: 6px;">
          <a href="#" onclick="window.navigateToView('home'); return false;" class="breadcrumb-link">Home</a>
          <span class="breadcrumb-sep">/</span>
          
          <!-- Gender Crumb (returns to Page 1: Category Landing) -->
          <a href="#" id="listing-crumb-gender" onclick="window.navigateToGender(STATE.genderFilter || 'men', 'all', 'all'); return false;" class="breadcrumb-link">Men</a>
          
          <span class="breadcrumb-sep">/</span>
          <!-- Category Crumb (resets article filter to All) -->
          <a href="#" id="listing-crumb-category" onclick="window.setArticleFilter('all'); return false;" class="breadcrumb-link">Scrubs</a>

          <!-- Article Crumb (shown when an individual article is selected) -->
          <span id="listing-crumb-article-sep" style="display: none;" class="breadcrumb-sep">/</span>
          <strong style="color: #102a43; display: none;" id="listing-crumb-article-current">All Products</strong>
        </nav>

        <!-- Back to Categories Button -->
        <button
          type="button"
          class="btn-back-to-categories"
          onclick="window.navigateToGender(STATE.genderFilter || 'men', 'all', 'all')"
          aria-label="Return to Category Selection"
        >
          <span class="back-arrow-icon">←</span>
          <span id="back-to-categories-label">Back to Categories</span>
        </button>
      </div>

      <!-- Category Listing Header -->
      <div class="collection-header-container" style="margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap;">
          <span class="nav-tag-highlight" id="listing-category-tag" style="background: #102a43; color: #ffffff;">MEN'S SCRUBS</span>
          <span class="level-indicator-pill" id="listing-level-tag">STEP 2 OF 2: SELECT ARTICLE & PRODUCT</span>
        </div>
        <h1 class="collection-main-heading" id="listing-main-heading">
          Men's Scrubs
        </h1>
        <p class="collection-sub-desc" id="listing-sub-desc">
          Athletic raglan cuts, reinforced double-needle stitching, and executive mandarin collar scrubs engineered for peak hospital rounds.
        </p>
      </div>

      <!-- ACCESSORIES CATEGORY SELECTION AREA (SECTION 5) -->
      <div class="accessories-category-selection-container" id="accessories-category-selection-area" style="display: none; margin-bottom: 28px;">
        <div class="categories-section-header" style="margin-bottom: 16px; text-align: left;">
          <span class="categories-section-tag">CLINICAL GEAR & ESSENTIALS</span>
          <h2 style="font-size: 20px; font-weight: 700; color: #102a43; margin: 4px 0;">Select Accessory Category</h2>
          <p style="font-size: 13px; color: #64748b; margin: 0;">Explore surgical scrub caps, medical compression sleeves, hospital badges, and footwear.</p>
        </div>
        <div class="accessories-category-cards-grid">
          <!-- 1. Sleeves -->
          <a href="#collection-sleeves" class="accessories-category-card" onclick="window.selectProductCategory('sleeves'); return false;">
            <div class="acc-cat-thumb">
              <img src="{{ 'cat-flexfit.jpg' | asset_url }}" alt="Medical Compression Sleeves" width="160" height="160" loading="lazy" />
            </div>
            <div class="acc-cat-info">
              <h3 class="acc-cat-title">Sleeves</h3>
              <span class="acc-cat-sub">Compression & UV Protection →</span>
            </div>
          </a>
          <!-- 2. Caps -->
          <a href="#collection-caps" class="accessories-category-card" onclick="window.selectProductCategory('caps'); return false;">
            <div class="acc-cat-thumb">
              <img src="{{ 'cat-caps.jpg' | asset_url }}" alt="BunFit Surgical Caps" width="160" height="160" loading="lazy" />
            </div>
            <div class="acc-cat-info">
              <h3 class="acc-cat-title">Caps</h3>
              <span class="acc-cat-sub">BunFit™ Tie-Back Scrub Caps →</span>
            </div>
          </a>
          <!-- 3. Other Accessories -->
          <a href="#collection-accessories" class="accessories-category-card" onclick="window.selectProductCategory('accessories'); return false;">
            <div class="acc-cat-thumb">
              <img src="{{ 'cat-labcoat.jpg' | asset_url }}" alt="Clinical Accessories" width="160" height="160" loading="lazy" />
            </div>
            <div class="acc-cat-info">
              <h3 class="acc-cat-title">Clinical Accessories</h3>
              <span class="acc-cat-sub">Stethoscope Loops & Badges →</span>
            </div>
          </a>
          <!-- 4. Hospital Footwear -->
          <a href="#collection-clogs" class="accessories-category-card" onclick="window.selectProductCategory('accessories'); return false;">
            <div class="acc-cat-thumb">
              <img src="{{ 'cat-sprinter.jpg' | asset_url }}" alt="Clinical Footwear" width="160" height="160" loading="lazy" />
            </div>
            <div class="acc-cat-info">
              <h3 class="acc-cat-title">Hospital Footwear</h3>
              <span class="acc-cat-sub">Ergonomic Supportive Clogs →</span>
            </div>
          </a>
        </div>
      </div>

      <!-- BRAND COLLECTION GENDER FILTER BAR (SECTION 2: ALL / MEN / WOMEN) -->
      <div class="brand-gender-pills-bar" id="brand-gender-filter-bar" style="display: none; margin-bottom: 20px; padding: 14px 18px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px;">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
            <span style="font-size: 13px; font-weight: 700; color: #102a43;">Filter by Gender:</span>
            <div class="brand-gender-pills-group" id="brand-gender-pills-container" style="display: flex; gap: 8px; flex-wrap: wrap;">
              <button type="button" class="filter-pill-btn active" id="brand-gender-pill-all" onclick="window.setBrandGenderFilter('all')">
                <span class="filter-pill-text">All Styles</span>
                <span class="filter-pill-count" id="brand-count-all">0</span>
              </button>
              <button type="button" class="filter-pill-btn" id="brand-gender-pill-men" onclick="window.setBrandGenderFilter('men')">
                <span class="filter-pill-text">Men</span>
                <span class="filter-pill-count" id="brand-count-men">0</span>
              </button>
              <button type="button" class="filter-pill-btn" id="brand-gender-pill-women" onclick="window.setBrandGenderFilter('women')">
                <span class="filter-pill-text">Women</span>
                <span class="filter-pill-count" id="brand-count-women">0</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- STANDARD FILTER BAR WITH "ALL BRANDS" + BRAND SERIES PILLS (SECTIONS 3 & 4) -->
      <div class="product-listing-filter-bar" id="product-listing-filter-bar">
        <div class="filter-bar-header-row">
          <div class="filter-pills-label-wrap">
            <span class="filter-bar-title" id="filter-bar-brand-title">Brand / Series:</span>
            <!-- Article filter pills container rendered dynamically -->
            <div class="article-filter-pills-group" id="article-filter-pills-container">
              <!-- Dynamically populated: [All Brands] [Vilora] [Splender] [Ground] [FlexFit] [Helium] [BunFit] -->
            </div>
          </div>

          <!-- Quick Gender Switch within Category -->
          <div class="listing-gender-switch-wrap" id="listing-gender-switch-wrap">
            <span class="filter-bar-subtitle">Gender:</span>
            <div class="listing-gender-btn-group">
              <button type="button" class="listing-gender-btn active" id="listing-gender-men" onclick="window.switchListingGender('men')">
                Men
              </button>
              <button type="button" class="listing-gender-btn" id="listing-gender-women" onclick="window.switchListingGender('women')">
                Women
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Active Filter Counter & Sorting Controls -->
      <div class="listing-status-row" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; font-size: 13px; color: #64748b; flex-wrap: wrap; gap: 12px;">
        <div class="listing-count-display">
          Showing <strong id="scrubs-visible-count" style="color: #102a43; font-size: 14px;">0</strong> designs for
          <span id="collection-filter-descriptor" style="font-weight: 600; color: #008779;">Men's Scrubs — All Articles</span>
        </div>
        <div class="listing-sort-wrap" style="display: flex; align-items: center; gap: 8px;">
          <label for="scrubs-sort-select" style="font-size: 12px; font-weight: 600; color: #475569;">Sort By:</label>
          <select id="scrubs-sort-select" onchange="window.sortScrubsCatalogue(this.value)" class="listing-sort-dropdown">
            <option value="featured">Featured Best Sellers</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
            <option value="name">Alphabetical (A-Z)</option>
          </select>
        </div>
      </div>

      <!-- BRAND EMPTY STATE (WHEN BRAND HAS NO PRODUCTS FOR CHOSEN GENDER) -->
      <div id="brand-empty-state-box" style="display: none; padding: 48px 24px; text-align: center; background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 12px; margin: 24px 0;">
        <div style="font-size: 36px; margin-bottom: 12px;">🩺</div>
        <h3 style="font-size: 18px; font-weight: 700; color: #102a43; margin: 0 0 8px;" id="empty-state-title">No Matching Products Found</h3>
        <p style="font-size: 13px; color: #64748b; max-width: 480px; margin: 0 auto 20px; line-height: 1.5;" id="empty-state-message">
          There are currently no products matching this filter combination.
        </p>
        <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
          <button type="button" class="btn-card-action" style="width: auto; padding: 10px 20px;" onclick="window.resetBrandFilters()">View All Brand Products</button>
          <button type="button" class="btn-hero-secondary" style="width: auto; padding: 10px 20px;" onclick="window.navigateToView('home')">Explore Homepage Brands</button>
        </div>
      </div>

      <!-- DYNAMIC GRID OF PRODUCTS WITH COLOR SWATCHES -->
      <div class="products-cards-grid" id="scrubs-products-grid">
        <!-- Injected dynamically via catalogue data -->
      </div>

    </div>

  </div>
</div>
