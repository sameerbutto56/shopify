{% comment %}
  ENAMELS ONLINE — HOMEPAGE DYNAMIC ARCHITECTURE & THEME STUDIO SYSTEM
  Extensively editable through Shopify Theme Editor (Theme Studio).
  Preserves authentic white visual identity, 3D tilt category cards,
  slideshow, signature scrub lines, hospital shades, concierge booking,
  trust badges, and verified clinical reviews.
{% endcomment %}

<div class="chroma-view-panel active" id="view-home">

  {% liquid
    assign enable_slideshow = true
    if section.settings.enable_slideshow == false
      assign enable_slideshow = false
    endif

    assign show_arrows = true
    if section.settings.show_slideshow_arrows == false
      assign show_arrows = false
    endif

    assign show_dots = true
    if section.settings.show_slideshow_dots == false
      assign show_dots = false
    endif

    assign slide_blocks_count = 0
    for block in section.blocks
      if block.type == 'slide'
        assign slide_blocks_count = slide_blocks_count | plus: 1
      endif
    endfor
  %}

  {% if enable_slideshow %}
  <!-- ============================================================ -->
  <!-- 1. AUTHENTIC BANNER SLIDESHOW (EDITABLE VIA THEME STUDIO)    -->
  <!-- ============================================================ -->
  <section class="enamels-slideshow-container" id="enamels-hero-slideshow" aria-label="Official Enamels Slideshow">
    <div class="slideshow-track" id="enamels-slideshow-track">
      {% for block in section.blocks %}
          {% if block.type == 'slide' and block.settings.visible != false %}
            {%- liquid
              assign has_title = false
              if block.settings.title != blank
                assign has_title = true
              endif

              assign has_caption = false
              if block.settings.subtitle != blank
                assign has_caption = true
              endif

              assign has_button = false
              if block.settings.button_label != blank
                assign has_button = true
              endif

              assign has_content = false
              if has_title or has_caption or has_button
                assign has_content = true
              endif

              assign slide_link = block.settings.link | default: block.settings.button_link | default: '#collection-sprinter'
              assign button_target = block.settings.button_link | default: block.settings.link | default: '#collection-sprinter'
              assign focal_point = block.settings.image_focal_point | default: 'center'
              assign caption_pos_desk = block.settings.caption_position | default: 'center_left'
              assign caption_pos_mob = block.settings.caption_position_mobile | default: 'bottom'
              assign text_align = block.settings.text_align | default: 'left'
              assign caption_style = block.settings.caption_style | default: 'subtle_glass'
              assign text_color = block.settings.text_color | default: '#ffffff'
              assign button_style = block.settings.button_style | default: 'primary_teal'
              assign alt_text = block.settings.alt | default: block.settings.title | default: 'Enamels Medical Apparel' | escape
            -%}
            <div class="slide-panel" id="shopify-block-{{ block.id }}" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <div class="slide-media-wrap">
                {% if slide_link != blank and has_button == false %}
                  <a href="{{ slide_link }}" class="slide-media-link" aria-label="{{ alt_text }}">
                {% endif %}

                {% if block.settings.image != blank %}
                  <picture class="slide-picture">
                    {% if block.settings.image_mobile != blank %}
                      <source media="(max-width: 767px)" srcset="{{ block.settings.image_mobile | image_url: width: 900 }}">
                    {% endif %}
                    <img
                      src="{{ block.settings.image | image_url: width: 1800 }}"
                      alt="{{ alt_text }}"
                      class="slide-img-full"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                      style="object-position: {{ focal_point }};"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    />
                  </picture>
                {% else %}
                  <picture class="slide-picture">
                    <img
                      src="{{ 'banner-autumn.jpg' | asset_url }}"
                      alt="{{ alt_text }}"
                      class="slide-img-full"
                      width="1500"
                      height="575"
                      style="object-position: {{ focal_point }};"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    />
                  </picture>
                {% endif %}

                {% if slide_link != blank and has_button == false %}
                  </a>
                {% endif %}

                {% if has_content %}
                  <div class="slide-caption-overlay pos-{{ caption_pos_desk }} mpos-{{ caption_pos_mob }}">
                    <div class="slide-caption-card style-{{ caption_style }} align-{{ text_align }}" style="--slide-text-color: {{ text_color }};">
                      {% if has_title %}
                        <h2 class="slide-caption-title">{{ block.settings.title | escape }}</h2>
                      {% endif %}
                      {% if has_caption %}
                        <p class="slide-caption-sub">{{ block.settings.subtitle | escape }}</p>
                      {% endif %}
                      {% if has_button %}
                        <a href="{{ button_target }}" class="slide-caption-btn btn-{{ button_style }}">
                          {{ block.settings.button_label | escape }}
                        </a>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
    </div>

    {% if show_arrows %}
    <!-- Navigation Controls -->
    <button type="button" class="slideshow-arrow prev" onclick="window.stepBannerSlide(-1)" aria-label="Previous Slide">‹</button>
    <button type="button" class="slideshow-arrow next" onclick="window.stepBannerSlide(1)" aria-label="Next Slide">›</button>
    {% endif %}

    {% if show_dots %}
    <!-- Pagination Dots -->
    <div class="slideshow-dots-bar" id="slideshow-dots-bar">
      {% assign dot_index = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'slide' %}
          <button type="button" class="slideshow-dot {% if dot_index == 0 %}active{% endif %}" onclick="window.jumpToBannerSlide({{ dot_index }})" aria-label="Slide {{ dot_index | plus: 1 }}"></button>
          {% assign dot_index = dot_index | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </section>

  {% endif %}

  <!-- ============================================================ -->
  <!-- 2. EXPLORE OUR BRANDS / SIGNATURE ARTICLES (SECTION 2)       -->
  <!-- ============================================================ -->
  <section class="frubs-brands-section page-container" id="homepage-featured-articles" aria-label="Explore Our Brands and Signature Articles">
    {% assign brands_tag_text = section.settings.brands_tag | strip %}
    {% assign brands_title_text = section.settings.brands_title | strip %}
    {% assign brands_subtitle_text = section.settings.brands_subtitle | strip %}
    {% if brands_tag_text != blank or brands_title_text != blank or brands_subtitle_text != blank %}
      <div class="categories-section-header" style="margin-bottom: 12px;">
        {% if brands_tag_text != blank %}
          <span class="categories-section-tag">{{ brands_tag_text | escape }}</span>
        {% endif %}
        {% if brands_title_text != blank %}
          <h2 class="categories-section-title">{{ brands_title_text | escape }}</h2>
        {% endif %}
        {% if brands_subtitle_text != blank %}
          <p class="categories-section-subtitle">{{ brands_subtitle_text | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="frubs-brands-grid">
      <!-- 1. Vilora (Velora) -->
      <a href="#collection-vilora" class="frubs-brand-tile" onclick="window.navigateToBrand('Velora'); return false;" aria-label="Explore Vilora Series">
        <div class="frubs-brand-tile-media">
          <span class="frubs-brand-tile-badge" style="background: #be185d; color: #ffffff;">MICRO-DRAPE</span>
          <img src="{{ 'cat-velora.jpg' | asset_url }}" alt="Vilora Luxury Medical Scrubs" width="300" height="400" loading="eager" />
        </div>
        <div class="frubs-brand-tile-body">
          <h3 class="frubs-brand-tile-title">Vilora Series</h3>
          <p class="frubs-brand-tile-sub">Liquid-soft micro-drape with fluid-repellent antimicrobial finishing tailored for female clinicians.</p>
          <span class="frubs-brand-tile-cta">Explore Vilora →</span>
        </div>
      </a>

      <!-- 2. Splender (Sprinter) -->
      <a href="#collection-splender" class="frubs-brand-tile" onclick="window.navigateToBrand('Sprinter'); return false;" aria-label="Explore Splender Series">
        <div class="frubs-brand-tile-media">
          <span class="frubs-brand-tile-badge" style="background: #102a43; color: #ffffff;">4-WAY STRETCH</span>
          <img src="{{ 'cat-sprinter.jpg' | asset_url }}" alt="Splender Athletic Scrub Series" width="300" height="400" loading="eager" />
        </div>
        <div class="frubs-brand-tile-body">
          <h3 class="frubs-brand-tile-title">Splender Series</h3>
          <p class="frubs-brand-tile-sub">Athletic mechanical stretch twill, raglan sleeve mobility & 6-pocket functional cargo joggers.</p>
          <span class="frubs-brand-tile-cta">Explore Splender →</span>
        </div>
      </a>

      <!-- 3. Ground (Crown) -->
      <a href="#collection-ground" class="frubs-brand-tile" onclick="window.navigateToBrand('Crown'); return false;" aria-label="Explore Ground Series">
        <div class="frubs-brand-tile-media">
          <span class="frubs-brand-tile-badge" style="background: #b45309; color: #ffffff;">EXECUTIVE CUT</span>
          <img src="{{ 'cat-crown.jpg' | asset_url }}" alt="Ground Executive Mandarin Scrubs" width="300" height="400" loading="eager" />
        </div>
        <div class="frubs-brand-tile-body">
          <h3 class="frubs-brand-tile-title">Ground Series</h3>
          <p class="frubs-brand-tile-sub">Distinctive standing mandarin collar with concealed front placket tailored for senior consultant rounds.</p>
          <span class="frubs-brand-tile-cta">Explore Ground →</span>
        </div>
      </a>

      <!-- 4. FlexFit (Flexwell) -->
      <a href="#collection-flexfit" class="frubs-brand-tile" onclick="window.navigateToBrand('Flexwell'); return false;" aria-label="Explore FlexFit Series">
        <div class="frubs-brand-tile-media">
          <span class="frubs-brand-tile-badge" style="background: #0f766e; color: #ffffff;">ALL-DAY FLEX</span>
          <img src="{{ 'cat-flexfit.jpg' | asset_url }}" alt="FlexFit Clinical Comfort" width="300" height="400" loading="lazy" />
        </div>
        <div class="frubs-brand-tile-body">
          <h3 class="frubs-brand-tile-title">FlexFit Series</h3>
          <p class="frubs-brand-tile-sub">Reinforced stretch seams and deep multi-pocket storage engineered for high-activity ward rotations.</p>
          <span class="frubs-brand-tile-cta">Explore FlexFit →</span>
        </div>
      </a>

      <!-- 5. Helium Lab Coats -->
      <a href="#collection-helium" class="frubs-brand-tile" onclick="window.navigateToBrand('Helium'); return false;" aria-label="Explore Helium Series">
        <div class="frubs-brand-tile-media">
          <span class="frubs-brand-tile-badge" style="background: #0369a1; color: #ffffff;">LAB COATS</span>
          <img src="{{ 'cat-labcoat.jpg' | asset_url }}" alt="Helium Technical White Lab Coats" width="300" height="400" loading="lazy" />
        </div>
        <div class="frubs-brand-tile-body">
          <h3 class="frubs-brand-tile-title">Helium Series</h3>
          <p class="frubs-brand-tile-sub">Crisp optical white technical doctor coats with reinforced stethoscope loop & tablet pockets.</p>
          <span class="frubs-brand-tile-cta">Explore Helium →</span>
        </div>
      </a>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 3. SMALL CATEGORY THUMBNAILS + LARGE BRAND VIDEO (SECTION 3) -->
  <!-- ============================================================ -->
  <section class="split-cat-video-section page-container" id="homepage-category-video-split" aria-label="Category Selection and Brand Showcase">
    <div class="split-cat-video-grid">
      <!-- Left: Small Category Thumbnails -->
      <div class="split-thumbnails-column">
        <div class="split-column-header">
          <span class="categories-section-tag">QUICK CATALOGUE DISCOVERY</span>
          <h2 class="split-column-title">Shop by Category</h2>
          <p class="split-column-sub">Browse clinical apparel, scrubs, lab coats, and medical accessories tailored for every role.</p>
        </div>

        <div class="split-thumbnails-grid">
          <!-- 1. Men -->
          <a href="#men" class="split-category-tile" onclick="window.navigateToGender('men'); return false;" aria-label="Shop Men's Medical Scrubs">
            <div class="split-category-thumb">
              <img src="{{ 'cat-men-scrubs.jpg' | asset_url }}" alt="Men's Scrubs" width="160" height="160" loading="lazy" />
            </div>
            <div class="split-category-info">
              <h3 class="split-category-name">Men</h3>
              <span class="split-category-meta">12 Styles →</span>
            </div>
          </a>

          <!-- 2. Women -->
          <a href="#women" class="split-category-tile" onclick="window.navigateToGender('women'); return false;" aria-label="Shop Women's Medical Scrubs">
            <div class="split-category-thumb">
              <img src="{{ 'cat-women-scrubs.jpg' | asset_url }}" alt="Women's Scrubs" width="160" height="160" loading="lazy" />
            </div>
            <div class="split-category-info">
              <h3 class="split-category-name">Women</h3>
              <span class="split-category-meta">14 Styles →</span>
            </div>
          </a>

          <!-- 3. Sale -->
          <a href="/collections/sale" class="split-category-tile" aria-label="Shop Enamels Sale & Promotional Editions">
            <div class="split-category-thumb">
              <span class="customizer-banner-badge" style="background: #e11d48; color: #ffffff; font-size: 10px; padding: 2px 6px; top: 8px; left: 8px;">SALE</span>
              <img src="{{ 'cat-sale.jpg' | asset_url }}" alt="Enamels Medical Scrubs on Sale" width="160" height="160" loading="lazy" />
            </div>
            <div class="split-category-info">
              <h3 class="split-category-name">Sale</h3>
              <span class="split-category-meta">Promotions →</span>
            </div>
          </a>

          <!-- 4. Bulk Orders -->
          <a href="/pages/bulk-orders" class="split-category-tile" aria-label="Bulk Hospital & Institution Orders">
            <div class="split-category-thumb">
              <span class="customizer-banner-badge" style="background: #0284c7; color: #ffffff; font-size: 10px; padding: 2px 6px; top: 8px; left: 8px;">MIN 10</span>
              <img src="{{ 'cat-bulk-orders.jpg' | asset_url }}" alt="Enamels Hospital Bulk Uniforms" width="160" height="160" loading="lazy" />
            </div>
            <div class="split-category-info">
              <h3 class="split-category-name">Bulk Orders</h3>
              <span class="split-category-meta">Institutions →</span>
            </div>
          </a>

          <!-- 5. Home Service -->
          <a href="/pages/home-service" class="split-category-tile" onclick="if (typeof window.navigateToView === 'function' && document.getElementById('view-self-service')) { window.navigateToView('self-service'); return false; }" aria-label="Lahore Concierge Home Fitting Service">
            <div class="split-category-thumb">
              <span class="customizer-banner-badge" style="background: #008779; color: #ffffff; font-size: 10px; padding: 2px 6px; top: 8px; left: 8px;">CONCIERGE</span>
              <img src="{{ 'cat-home-service.jpg' | asset_url }}" alt="Lahore Clinician Home Fitting" width="160" height="160" loading="lazy" />
            </div>
            <div class="split-category-info">
              <h3 class="split-category-name">Home Service</h3>
              <span class="split-category-meta">Lahore Fitting →</span>
            </div>
          </a>

          <!-- 6. Make Your Own Scrubs -->
          <a href="/pages/customizer" class="split-category-tile" onclick="if (typeof window.navigateToView === 'function' && document.getElementById('view-ready-to-wear')) { window.navigateToView('ready-to-wear'); return false; }" aria-label="Bespoke Medical Scrub Customizer">
            <div class="split-category-thumb">
              <span class="customizer-banner-badge" style="background: #b45309; color: #ffffff; font-size: 10px; padding: 2px 6px; top: 8px; left: 8px;">BESPOKE</span>
              <img src="{{ 'cat-customizer.jpg' | asset_url }}" alt="Make Your Own Scrubs Customizer" width="160" height="160" loading="lazy" />
            </div>
            <div class="split-category-info">
              <h3 class="split-category-name">Make Your Own Scrubs</h3>
              <span class="split-category-meta">Custom Studio →</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Right: Large Brand Video Showcase -->
      <div class="split-video-column">
        <div class="brand-video-card-container">
          <div class="brand-video-wrapper">
            {% assign shopify_video = section.settings.video %}
            {% if section.settings.brand_video_poster != blank %}
              {% assign brand_poster = section.settings.brand_video_poster | image_url: width: 900 %}
            {% elsif shopify_video != blank and shopify_video.preview_image != blank %}
              {% assign brand_poster = shopify_video.preview_image | image_url: width: 900 %}
            {% else %}
              {% assign brand_poster = '' %}
            {% endif %}
            {% assign brand_video_src = section.settings.brand_video_url %}
            {% assign is_autoplay = section.settings.video_autoplay %}
            {% if is_autoplay == nil %}{% assign is_autoplay = true %}{% endif %}
            {% assign is_loop = section.settings.video_loop %}
            {% if is_loop == nil %}{% assign is_loop = true %}{% endif %}
            {% assign is_muted = section.settings.video_muted %}
            {% if is_muted == nil %}{% assign is_muted = true %}{% endif %}
            {% assign is_controls = section.settings.video_controls %}
            {% if is_controls == nil %}{% assign is_controls = false %}{% endif %}
            {% assign video_cta_link = section.settings.video_cta_link %}
            {% assign video_cta_label = section.settings.video_cta_label | strip %}

            {% if shopify_video != blank %}
              {{
                shopify_video
                | video_tag:
                  id: 'enamels-brand-promo-video',
                  class: 'brand-promo-video-element',
                  image_size: '900x',
                  poster: brand_poster,
                  autoplay: is_autoplay,
                  loop: is_loop,
                  muted: is_muted,
                  controls: is_controls,
                  playsinline: true,
                  preload: 'metadata',
                  aria-label: 'Enamels Medical Performance Brand Showcase Video'
              }}
            {% elsif brand_video_src != blank %}
              <video
                id="enamels-brand-promo-video"
                class="brand-promo-video-element"
                poster="{{ brand_poster }}"
                {% if is_autoplay %}autoplay{% endif %}
                {% if is_muted %}muted{% endif %}
                {% if is_loop %}loop{% endif %}
                {% if is_controls %}controls{% endif %}
                playsinline
                preload="metadata"
                aria-label="Enamels Medical Performance Brand Showcase Video"
              >
                <source src="{{ brand_video_src }}" type="video/mp4">
              </video>
            {% else %}
              <div class="brand-video-placeholder-wrap">
                <img
                  src="{{ brand_poster }}"
                  alt="Enamels Brand Video Poster"
                  class="brand-promo-video-element"
                  width="900"
                  height="600"
                  loading="lazy"
                >
              </div>
            {% endif %}

            {% assign video_badge_text = section.settings.video_badge | strip %}
            {% assign video_title_text = section.settings.video_title | strip %}
            {% assign video_desc_text = section.settings.video_desc | strip %}
            {% if video_badge_text != blank or video_title_text != blank or video_desc_text != blank or video_cta_label != blank %}
            <!-- Video Overlay Card with Controls -->
            <div class="brand-video-overlay-banner">
              {% if video_badge_text != blank or video_title_text != blank or video_desc_text != blank %}
              <div class="brand-video-info">
                {% if video_badge_text != blank %}
                  <span class="brand-video-badge">{{ video_badge_text | escape }}</span>
                {% endif %}
                {% if video_title_text != blank %}
                  <h3 class="brand-video-title">{{ video_title_text | escape }}</h3>
                {% endif %}
                {% if video_desc_text != blank %}
                  <p class="brand-video-desc">{{ video_desc_text | escape }}</p>
                {% endif %}
              </div>
              {% endif %}
              <div class="brand-video-controls">
                {% if video_cta_link != blank and video_cta_label != blank %}
                  <a
                    href="{{ video_cta_link }}"
                    class="brand-video-cta-link-btn"
                    aria-label="{{ video_cta_label | escape }}"
                  >
                    {{ video_cta_label | escape }}
                  </a>
                {% endif %}
                <button
                  type="button"
                  class="brand-video-toggle-btn"
                  id="brand-video-play-pause-btn"
                  onclick="if (typeof window.toggleBrandPromoVideo === 'function') { window.toggleBrandPromoVideo(event); }"
                  aria-label="Pause Promotional Video"
                >
                  <span id="brand-video-btn-icon">⏸</span>
                  <span id="brand-video-btn-label">Pause</span>
                </button>
              </div>
            </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 7. CURATED LIVE PRODUCT GRID (REAL SHOPIFY PRODUCTS INCLUDED)-->
  <!-- ============================================================ -->
  <section class="page-container" style="padding: 56px 0;" id="homepage-live-catalogue-section" aria-label="Curated Live Product Catalogue">
    <div class="categories-section-header">
      <span class="categories-section-tag">ONLINE STORE APPAREL & ACCESSORIES</span>
      <h2 class="categories-section-title">Curated Product Catalogue</h2>
      <p class="categories-section-subtitle">
        Explore our live collection of clinical scrubs, lab coats, surgical caps, and accessories.
      </p>
    </div>

    <!-- Category Filter Bar for Homepage -->
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin: 20px 0 28px; padding-bottom: 16px; border-bottom: 1px solid #e2e8f0;">
      <div style="display: flex; gap: 8px; flex-wrap: wrap;" id="homepage-category-filter-pills">
        <button type="button" class="filter-pill-btn active" id="hp-filter-all" onclick="window.filterHomepageGrid('all')">
          <span class="filter-pill-text">All Products</span>
        </button>
        <button type="button" class="filter-pill-btn" id="hp-filter-scrubs" onclick="window.filterHomepageGrid('scrubs')">
          <span class="filter-pill-text">Scrubs</span>
        </button>
        <button type="button" class="filter-pill-btn" id="hp-filter-labcoat" onclick="window.filterHomepageGrid('lab-coat')">
          <span class="filter-pill-text">Lab Coats</span>
        </button>
        <button type="button" class="filter-pill-btn" id="hp-filter-caps" onclick="window.filterHomepageGrid('caps')">
          <span class="filter-pill-text">Surgical Caps</span>
        </button>
        <button type="button" class="filter-pill-btn" id="hp-filter-accessories" onclick="window.filterHomepageGrid('accessories')">
          <span class="filter-pill-text">Accessories</span>
        </button>
      </div>

      <div style="display: flex; align-items: center; gap: 8px;">
        <label for="homepage-sort-select" style="font-size: 12px; color: #64748b; font-weight: 600;">Sort By:</label>
        <select id="homepage-sort-select" class="form-field-select" style="padding: 6px 12px; font-size: 12px; width: auto;" onchange="window.sortHomepageGrid(this.value)">
          <option value="featured">Featured</option>
          <option value="price-low">Price: Low to High</option>
          <option value="price-high">Price: High to Low</option>
          <option value="name">Name: A to Z</option>
        </select>
      </div>
    </div>

    <!-- The Grid where real Shopify products like 'junaid' immediately render -->
    <div class="enamels-products-grid" id="homepage-live-products-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px;">
      <!-- Populated dynamically via window.renderHomepageLiveGrid() -->
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 5. MAKE YOUR OWN SCRUBS (BESPOKE STUDIO SHOWCASE)           -->
  <!-- ============================================================ -->
  <section class="page-container" style="padding: 48px 0 24px;" id="homepage-customizer-banner" aria-label="Make Your Own Scrubs Bespoke Studio">
    <div class="customizer-editorial-banner">
      <div class="customizer-banner-media">
        <span class="customizer-banner-badge">BESPOKE CUSTOM STUDIO</span>
        <img src="{{ 'cat-sprinter.jpg' | asset_url }}" alt="Make Your Own Scrubs Custom Studio" width="600" height="450" loading="lazy" />
      </div>
      <div class="customizer-banner-content">
        <span class="categories-section-tag" style="margin-bottom: 8px;">TAILORED CLINICAL PRECISION</span>
        <h2 class="customizer-banner-title">Make Your Own Scrubs</h2>
        <p class="customizer-banner-desc">
          Experience our interactive customization studio. Select proprietary medical fabrics, approved hospital shades, custom measurements in inches or cm, size auto-fill, C (Custom) fit, and personalized doctor title & hospital crest embroidery.
        </p>
