        <span>Olive Shine</span>
      </button>
      <button type="button" class="pdp-swatch-item" onclick="window.filterCatalogueByColor('#14532D', 'Hunter Green')">
        <span class="pdp-swatch-color-dot" style="background: #14532D;"></span>
        <span>Hunter Green</span>
      </button>
      <button type="button" class="pdp-swatch-item" onclick="window.filterCatalogueByColor('#18181B', 'Obsidian Black')">
        <span class="pdp-swatch-color-dot" style="background: #18181B;"></span>
        <span>Obsidian Black</span>
      </button>
      <button type="button" class="pdp-swatch-item" onclick="window.filterCatalogueByColor('#64748B', 'Heather Grey')">
        <span class="pdp-swatch-color-dot" style="background: #64748B;"></span>
        <span>Heather Grey</span>
      </button>
      <button type="button" class="pdp-swatch-item" onclick="window.filterCatalogueByColor('#00B8A9', 'Clinical Teal')">
        <span class="pdp-swatch-color-dot" style="background: #00B8A9;"></span>
        <span>Clinical Teal</span>
      </button>
      <button type="button" class="pdp-swatch-item" onclick="window.filterCatalogueByColor('#A855F7', 'Lilac Lavender')">
        <span class="pdp-swatch-color-dot" style="background: #A855F7;"></span>
        <span>Lilac Lavender</span>
      </button>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 5. TRUST BADGES ARCHITECTURE                                 -->
  <!-- ============================================================ -->
  <section style="background-color: #f8fafc; border-top: 1px solid #e2e8f0; padding: 40px 0;">
    <div class="page-container">
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;">
        <div style="text-align: center; padding: 16px;">
          <div style="font-size: 26px; margin-bottom: 8px;">🚚</div>
          <h4 style="font-size: 13px; font-weight: 700; margin: 0 0 4px; text-transform: uppercase;">Free Shipping</h4>
          <p style="font-size: 11px; color: #64748b; margin: 0;">On all orders over Rs. 7,000 nationwide</p>
        </div>
        <div style="text-align: center; padding: 16px;">
          <div style="font-size: 26px; margin-bottom: 8px;">💵</div>
          <h4 style="font-size: 13px; font-weight: 700; margin: 0 0 4px; text-transform: uppercase;">Cash on Delivery</h4>
          <p style="font-size: 11px; color: #64748b; margin: 0;">Available across all cities in Pakistan</p>
        </div>
        <div style="text-align: center; padding: 16px;">
          <div style="font-size: 26px; margin-bottom: 8px;">⚡</div>
          <h4 style="font-size: 13px; font-weight: 700; margin: 0 0 4px; text-transform: uppercase;">7-Day Easy Exchange</h4>
          <p style="font-size: 11px; color: #64748b; margin: 0;">Instant sizing support via WhatsApp</p>
        </div>
        <div style="text-align: center; padding: 16px;">
          <div style="font-size: 26px; margin-bottom: 8px;">🪡</div>
          <h4 style="font-size: 13px; font-weight: 700; margin: 0 0 4px; text-transform: uppercase;">Custom Embroidery</h4>
          <p style="font-size: 11px; color: #64748b; margin: 0;">Computerized name & hospital crests</p>
        </div>
      </div>
    </div>
  </section>

</div>
