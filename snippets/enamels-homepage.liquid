  <!-- ============================================================ -->
  <!-- 4. SHOP BY CLINICAL HOSPITAL SHADE                           -->
  <!-- ============================================================ -->
  {% liquid
    assign enable_palette = true
    if section.settings.enable_color_palette == false
      assign enable_palette = false
    endif

    assign swatch_blocks_count = 0
    for block in section.blocks
      if block.type == 'color_swatch'
        assign swatch_blocks_count = swatch_blocks_count | plus: 1
      endif
    endfor
  %}

  {% if enable_palette %}
  <section class="page-container" style="padding: 50px 0;">
    <div class="section-header-wrap" style="margin-top: 0;">
      <span class="section-tag-sub">{{ section.settings.palette_tag | default: 'COLOR HARMONY' | escape }}</span>
