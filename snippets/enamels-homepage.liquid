{% comment %}
  ENAMELS ONLINE — HOMEPAGE DYNAMIC ARCHITECTURE & THEME STUDIO SYSTEM
  Extensively editable through Shopify Theme Editor (Theme Studio).
  Preserves authentic white visual identity, 3D tilt category cards,
  slideshow, signature scrub lines, hospital shades, concierge booking,
  trust badges, and verified clinical reviews.
{% endcomment %}

<div class="chroma-view-panel active" id="view-home">

  {% liquid
    assign enable_slideshow = true
    if section.settings.enable_slideshow == false
      assign enable_slideshow = false
    endif

    assign show_arrows = true
    if section.settings.show_slideshow_arrows == false
      assign show_arrows = false
    endif

    assign show_dots = true
    if section.settings.show_slideshow_dots == false
      assign show_dots = false
    endif

    assign slide_blocks_count = 0
    for block in section.blocks
      if block.type == 'slide'
        assign slide_blocks_count = slide_blocks_count | plus: 1
      endif
    endfor
  %}

  {% if enable_slideshow %}
  <!-- ============================================================ -->
  <!-- 1. AUTHENTIC BANNER SLIDESHOW (EDITABLE VIA THEME STUDIO)    -->
  <!-- ============================================================ -->
  <section class="enamels-slideshow-container" id="enamels-hero-slideshow" aria-label="Official Enamels Slideshow">
    <div class="slideshow-track" id="enamels-slideshow-track">
      {% if slide_blocks_count > 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'slide' %}
            <a href="{{ block.settings.link | default: '#collection-sprinter' }}" class="slide-panel" id="shopify-block-{{ block.id }}" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <picture>
                  {% if block.settings.image_mobile != blank %}
                    <source media="(max-width: 640px)" srcset="{{ block.settings.image_mobile | image_url: width: 800 }}">
                  {% endif %}
                  <img
                    src="{{ block.settings.image | image_url: width: 1600 }}"
                    alt="{{ block.settings.alt | default: block.settings.title | default: 'Enamels Medical Apparel' | escape }}"
                    class="slide-img-full"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  />
                </picture>
              {% else %}
                <img
                  src="{{ 'banner-autumn.jpg' | asset_url }}"
                  alt="{{ block.settings.alt | default: 'Enamels Medical Apparel' | escape }}"
                  class="slide-img-full"
                  width="1500"
                  height="575"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                />
              {% endif %}
              {% if block.settings.title != blank or block.settings.subtitle != blank %}
                <div class="slide-caption-overlay">
                  {% if block.settings.title != blank %}<h2 class="slide-caption-title">{{ block.settings.title | escape }}</h2>{% endif %}
                  {% if block.settings.subtitle != blank %}<p class="slide-caption-sub">{{ block.settings.subtitle | escape }}</p>{% endif %}
                </div>
              {% endif %}
            </a>
          {% endif %}
        {% endfor %}
      {% else %}
        <!-- Slide 1: Sprinter Autumn Edition -->
        <a href="#collection-sprinter" class="slide-panel" onclick="window.navigateToCollection('Sprinter'); return false;">
          <img
            src="{{ 'banner-autumn.jpg' | asset_url }}"
            alt="Enamels Sprinter Autumn Edition"
            class="slide-img-full"
            width="1500"
            height="575"
            loading="eager"
          />
        </a>

        <!-- Slide 2: Clinical Clogs & Footwear -->
        <a href="#collection-clogs" class="slide-panel" onclick="window.navigateToCollection('clogs', 'category'); return false;">
          <img
            src="{{ 'banner-clogs.jpg' | asset_url }}"
            alt="Enamels Clinical Clogs & Footwear"
            class="slide-img-full"
            width="1500"
            height="625"
            loading="lazy"
          />
        </a>

        <!-- Slide 3: New Arrivals / Abbotabad Banner -->
        <a href="#collection-new-arrivals" class="slide-panel" onclick="window.navigateToCollection('all', 'category'); return false;">
          <img
            src="{{ 'banner-abbotabad.jpg' | asset_url }}"
            alt="Enamels New Arrivals 2026"
            class="slide-img-full"
            width="1500"
            height="575"
            loading="lazy"
          />
        </a>

        <!-- Slide 4: Surgical Caps (BunFit™ Series) -->
        <a href="#collection-caps" class="slide-panel" onclick="window.navigateToCollection('caps', 'category'); return false;">
          <img
            src="{{ 'banner-caps.jpg' | asset_url }}"
            alt="Enamels BunFit Surgical Caps"
            class="slide-img-full"
            width="1500"
            height="575"
            loading="lazy"
          />
        </a>

        <!-- Slide 5: Velora By Enamels -->
        <a href="#collection-velora" class="slide-panel" onclick="window.navigateToCollection('Velora'); return false;">
          <img
            src="{{ 'banner-velora.jpg' | asset_url }}"
            alt="Velora Luxury Micro-Drape By Enamels"
            class="slide-img-full"
            width="1500"
            height="575"
            loading="lazy"
          />
        </a>
      {% endif %}
    </div>

    {% if show_arrows %}
    <!-- Navigation Controls -->
    <button type="button" class="slideshow-arrow prev" onclick="window.stepBannerSlide(-1)" aria-label="Previous Slide">‹</button>
    <button type="button" class="slideshow-arrow next" onclick="window.stepBannerSlide(1)" aria-label="Next Slide">›</button>
    {% endif %}

    {% if show_dots %}
    <!-- Pagination Dots -->
    <div class="slideshow-dots-bar" id="slideshow-dots-bar">
      {% if slide_blocks_count > 0 %}
        {% assign dot_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'slide' %}
            <button type="button" class="slideshow-dot {% if dot_index == 0 %}active{% endif %}" onclick="window.jumpToBannerSlide({{ dot_index }})" aria-label="Slide {{ dot_index | plus: 1 }}"></button>
            {% assign dot_index = dot_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      {% else %}
        <button type="button" class="slideshow-dot active" onclick="window.jumpToBannerSlide(0)" aria-label="Slide 1"></button>
        <button type="button" class="slideshow-dot" onclick="window.jumpToBannerSlide(1)" aria-label="Slide 2"></button>
        <button type="button" class="slideshow-dot" onclick="window.jumpToBannerSlide(2)" aria-label="Slide 3"></button>
        <button type="button" class="slideshow-dot" onclick="window.jumpToBannerSlide(3)" aria-label="Slide 4"></button>
        <button type="button" class="slideshow-dot" onclick="window.jumpToBannerSlide(4)" aria-label="Slide 5"></button>
      {% endif %}
    </div>
    {% endif %}
  </section>
  {% endif %}

  <!-- ============================================================ -->
  <!-- 2. HOMEPAGE CATEGORIES (PREMIUM 3D REDESIGN & DYNAMIC BLOCKS) -->
  <!-- ============================================================ -->
  {% liquid
    assign category_blocks_count = 0
    for block in section.blocks
      if block.type == 'category_card'
        assign category_blocks_count = category_blocks_count | plus: 1
      endif
    endfor
  %}

  <section class="enamels-categories-section-3d page-container" id="homepage-categories-section">
    <div class="categories-section-header">
      <span class="categories-section-tag">{{ section.settings.categories_tag | default: 'CLINICAL APPAREL & SERVICES' | escape }}</span>
      <h2 class="categories-section-title">{{ section.settings.categories_title | default: 'Categories' | escape }}</h2>
      <p class="categories-section-subtitle">
        {{ section.settings.categories_subtitle | default: 'Explore purpose-built medical uniforms, personalized studio customization, and concierge in-person sizing.' | escape }}
      </p>
    </div>

    <div class="enamels-categories-3d-grid" id="enamels-3d-cards-grid">
      {% if category_blocks_count > 0 %}
        {% assign card_counter = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'category_card' %}
            {% assign card_counter = card_counter | plus: 1 %}
            {% liquid
              assign card_href = '#men'
              assign card_onclick = "window.navigateToGender('men'); return false;"
              assign default_card_img = 'cat-men-scrubs.jpg'

              case block.settings.card_type
                when 'men'
                  assign card_href = '#men'
                  assign card_onclick = "window.navigateToGender('men'); return false;"
                  assign default_card_img = 'cat-men-scrubs.jpg'
                when 'women'
                  assign card_href = '#women'
                  assign card_onclick = "window.navigateToGender('women'); return false;"
                  assign default_card_img = 'cat-women-scrubs.jpg'
                when 'home_service'
                  assign card_href = '#self-service'
                  assign card_onclick = "window.navigateToView('self-service'); return false;"
                  assign default_card_img = 'cat-labcoat.jpg'
                when 'customizer'
                  assign card_href = '#ready-to-wear'
                  assign card_onclick = "window.navigateToView('ready-to-wear'); return false;"
                  assign default_card_img = 'cat-sprinter.jpg'
                when 'summer'
                  assign card_href = '#summer-collection'
                  assign card_onclick = "window.navigateToSeasonalCollection('summer'); return false;"
                  assign default_card_img = 'cat-velora.jpg'
                when 'winter'
                  assign card_href = '#winter-collection'
                  assign card_onclick = "window.navigateToSeasonalCollection('winter'); return false;"
                  assign default_card_img = 'cat-crown.jpg'
                when 'self_service_modal'
                  assign card_href = '#self-service-portal'
                  assign card_onclick = "window.openComingSoonModal('self-service'); return false;"
                  assign default_card_img = 'cat-flexfit.jpg'
                when 'bulk_order_modal'
                  assign card_href = '#bulk-order'
                  assign card_onclick = "window.openComingSoonModal('bulk-order'); return false;"
                  assign default_card_img = 'banner-abbotabad.jpg'
                when 'custom_link'
                  assign card_href = block.settings.custom_link | default: '#men'
                  assign card_onclick = ''
              endcase
            %}

            <div class="category-card-3d-wrap" data-card-index="{{ card_counter }}" id="shopify-block-{{ block.id }}" {{ block.shopify_attributes }}>
              <a href="{{ card_href }}" class="category-card-3d" {% if card_onclick != '' %}onclick="{{ card_onclick }}"{% endif %} aria-label="{{ block.settings.title | escape }}">
                <div class="category-card-glare"></div>
                <div class="category-card-media-wrap">
                  <span class="category-card-badge {{ block.settings.badge_color | default: 'badge-men' }}">
                    {{ block.settings.badge_text | default: "ENAMELS" | escape }}
                  </span>
                  {% if block.settings.image != blank %}
                    <img
                      src="{{ block.settings.image | image_url: width: 600 }}"
                      alt="{{ block.settings.title | escape }}"
                      class="category-card-media-img"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                      loading="lazy"
                    />
                  {% else %}
                    <img
                      src="{{ default_card_img | asset_url }}"
                      alt="{{ block.settings.title | escape }}"
                      class="category-card-media-img"
                      width="600"
                      height="450"
                      loading="lazy"
                    />
                  {% endif %}
                </div>
                <div class="category-card-body">
                  <div class="category-card-header-row">
                    <h3 class="category-card-title">{{ block.settings.title | escape }}</h3>
                    {% if block.settings.count_or_fee != blank %}
                      <span class="category-card-count">{{ block.settings.count_or_fee | escape }}</span>
                    {% endif %}
                  </div>
                  <p class="category-card-desc">{{ block.settings.description | escape }}</p>
                  <div class="category-card-footer">
                    <span class="category-card-cta">
                      {{ block.settings.cta_text | default: 'Explore Collection' | escape }}
                      <span class="category-card-arrow-circle" aria-hidden="true">→</span>
                    </span>
                  </div>
                </div>
              </a>
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        <!-- 1. Men -->
        <div class="category-card-3d-wrap" data-card-index="1">
          <a href="#men" class="category-card-3d" onclick="window.navigateToGender('men'); return false;" aria-label="Explore Men's Scrubs Collection">
            <div class="category-card-glare"></div>
            <div class="category-card-media-wrap">
              <span class="category-card-badge badge-men">MEN'S APPAREL</span>
              <img src="{{ 'cat-men-scrubs.jpg' | asset_url }}" alt="Men's Scrubs & Medical Apparel" class="category-card-media-img" width="600" height="450" loading="eager" />
            </div>
            <div class="category-card-body">
              <div class="category-card-header-row">
                <h3 class="category-card-title">Men</h3>
                <span class="category-card-count">12 Styles</span>
              </div>
              <p class="category-card-desc">Athletic mechanical stretch, twill scrubs, and structured executive cuts tailored for male medical professionals.</p>
              <div class="category-card-footer">
                <span class="category-card-cta">
                  Explore Collection
                  <span class="category-card-arrow-circle" aria-hidden="true">→</span>
                </span>
              </div>
            </div>
          </a>
        </div>

        <!-- 2. Women -->
        <div class="category-card-3d-wrap" data-card-index="2">
          <a href="#women" class="category-card-3d" onclick="window.navigateToGender('women'); return false;" aria-label="Explore Women's Scrubs Collection">
            <div class="category-card-glare"></div>
            <div class="category-card-media-wrap">
              <span class="category-card-badge badge-women">WOMEN'S APPAREL</span>
              <img src="{{ 'cat-women-scrubs.jpg' | asset_url }}" alt="Women's Scrubs & Medical Apparel" class="category-card-media-img" width="600" height="450" loading="eager" />
            </div>
            <div class="category-card-body">
              <div class="category-card-header-row">
                <h3 class="category-card-title">Women</h3>
                <span class="category-card-count">14 Styles</span>
              </div>
              <p class="category-card-desc">Contour princess seams, elegant fluid drape, and ergonomic silhouettes designed for female clinicians.</p>
              <div class="category-card-footer">
                <span class="category-card-cta">
                  Explore Collection
                  <span class="category-card-arrow-circle" aria-hidden="true">→</span>
                </span>
              </div>
            </div>
          </a>
        </div>

        <!-- 3. Home Service -->
        <div class="category-card-3d-wrap" data-card-index="3">
          <a href="#self-service" class="category-card-3d" onclick="window.navigateToView('self-service'); return false;" aria-label="Book Enamels Home Service Representative Visit">
            <div class="category-card-glare"></div>
            <div class="category-card-media-wrap">
              <span class="category-card-badge badge-concierge">LAHORE CONCIERGE</span>
              <img src="{{ 'cat-labcoat.jpg' | asset_url }}" alt="Enamels Home Service Representative Visit" class="category-card-media-img" width="600" height="450" loading="lazy" />
            </div>
            <div class="category-card-body">
              <div class="category-card-header-row">
                <h3 class="category-card-title">Home Service</h3>
                <span class="category-card-fee">Rs. 500 Visit</span>
              </div>
              <p class="category-card-desc">Request an in-person representative visit in Lahore for precision measurement, fabric swatch inspection, and guided order placement.</p>
              <div class="category-card-footer">
                <span class="category-card-cta cta-teal">
                  Book Representative Visit
                  <span class="category-card-arrow-circle" aria-hidden="true">→</span>
                </span>
              </div>
            </div>
          </a>
        </div>

        <!-- 4. Make Your Own Scrubs -->
        <div class="category-card-3d-wrap" data-card-index="4">
          <a href="#ready-to-wear" class="category-card-3d" onclick="window.navigateToView('ready-to-wear'); return false;" aria-label="Launch Make Your Own Scrubs Customizer Studio">
            <div class="category-card-glare"></div>
            <div class="category-card-media-wrap">
              <span class="category-card-badge badge-studio">CUSTOM STUDIO</span>
              <img src="{{ 'cat-sprinter.jpg' | asset_url }}" alt="Make Your Own Scrubs 3D Configurator" class="category-card-media-img" width="600" height="450" loading="lazy" />
            </div>
            <div class="category-card-body">
              <div class="category-card-header-row">
                <h3 class="category-card-title">Make Your Own Scrubs</h3>
                <span class="category-card-badge-pill">Bespoke</span>
              </div>
              <p class="category-card-desc">Interactive all-in-one customizer. Select proprietary fabrics, hospital shades, bespoke sizing, custom alterations, and doctor name embroidery.</p>
              <div class="category-card-footer">
                <span class="category-card-cta">
                  Launch Customizer Studio
                  <span class="category-card-arrow-circle" aria-hidden="true">→</span>
                </span>
              </div>
            </div>
          </a>
        </div>

        <!-- 5. Summer Collection -->
        <div class="category-card-3d-wrap" data-card-index="5">
          <a href="#summer-collection" class="category-card-3d" onclick="window.navigateToSeasonalCollection('summer'); return false;" aria-label="Shop Summer Medical Collection">
            <div class="category-card-glare"></div>
            <div class="category-card-media-wrap">
              <span class="category-card-badge badge-summer">AEROCOOL™ EDITION</span>
              <img src="{{ 'cat-velora.jpg' | asset_url }}" alt="Summer Medical Apparel Collection" class="category-card-media-img" width="600" height="450" loading="lazy" />
            </div>
            <div class="category-card-body">
              <div class="category-card-header-row">
                <h3 class="category-card-title">Summer Collection</h3>
                <span class="category-card-count">Aerocool Fit</span>
              </div>
              <p class="category-card-desc">Ultra-lightweight, moisture-wicking fabrics engineered for peak breathability and effortless cooling through high-demand summer rotations.</p>
              <div class="category-card-footer">
                <span class="category-card-cta">
                  Shop Summer Edition
                  <span class="category-card-arrow-circle" aria-hidden="true">→</span>
                </span>
              </div>
            </div>
          </a>
        </div>

        <!-- 6. Winter Collection -->
        <div class="category-card-3d-wrap" data-card-index="6">
          <a href="#winter-collection" class="category-card-3d" onclick="window.navigateToSeasonalCollection('winter'); return false;" aria-label="Shop Winter Medical Collection">
            <div class="category-card-glare"></div>
            <div class="category-card-media-wrap">
              <span class="category-card-badge badge-winter">AUTUMN / WINTER</span>
              <img src="{{ 'cat-crown.jpg' | asset_url }}" alt="Winter Medical Apparel Collection" class="category-card-media-img" width="600" height="450" loading="lazy" />
            </div>
            <div class="category-card-body">
              <div class="category-card-header-row">
                <h3 class="category-card-title">Winter Collection</h3>
                <span class="category-card-count">Warm Twill</span>
              </div>
              <p class="category-card-desc">Thermal-retaining structured twill, mandarin collars, and layering clinical coats engineered for cooler hospital environments.</p>
              <div class="category-card-footer">
                <span class="category-card-cta">
                  Shop Winter Edition
                  <span class="category-card-arrow-circle" aria-hidden="true">→</span>
                </span>
              </div>
            </div>
          </a>
        </div>

        <!-- 7. Self-Service (Coming Soon) -->
        <div class="category-card-3d-wrap" data-card-index="7">
          <a href="#self-service-portal" class="category-card-3d" onclick="window.openComingSoonModal('self-service'); return false;" aria-label="Self-Service Portal - Coming Soon">
            <div class="category-card-glare"></div>
            <div class="category-card-media-wrap">
              <span class="category-card-badge badge-coming-soon">COMING SOON</span>
              <img src="{{ 'cat-flexfit.jpg' | asset_url }}" alt="Enamels Self-Service Digital Portal" class="category-card-media-img" width="600" height="450" loading="lazy" />
            </div>
            <div class="category-card-body">
              <div class="category-card-header-row">
                <h3 class="category-card-title">Self-Service</h3>
                <span class="category-card-badge-pill" style="background: #fef3c7; color: #b45309;">Coming Soon</span>
              </div>
              <p class="category-card-desc">Direct self-ordering digital portal with rapid measurement profile management and express department reorders.</p>
              <div class="category-card-footer">
                <span class="category-card-cta" style="color: #b45309;">
                  Preview Portal
                  <span class="category-card-arrow-circle" aria-hidden="true" style="color: #b45309; background: #fef3c7;">→</span>
                </span>
              </div>
            </div>
          </a>
        </div>

        <!-- 8. Bulk Order (Coming Soon) -->
        <div class="category-card-3d-wrap" data-card-index="8">
          <a href="#bulk-order" class="category-card-3d" onclick="window.openComingSoonModal('bulk-order'); return false;" aria-label="Bulk Order & Hospital Ward Orders - Coming Soon">
            <div class="category-card-glare"></div>
            <div class="category-card-media-wrap">
              <span class="category-card-badge badge-coming-soon">COMING SOON</span>
              <img src="{{ 'banner-abbotabad.jpg' | asset_url }}" alt="Enamels Institutional Ward & Bulk Orders" class="category-card-media-img" width="600" height="450" loading="lazy" />
            </div>
            <div class="category-card-body">
              <div class="category-card-header-row">
                <h3 class="category-card-title">Bulk Order</h3>
                <span class="category-card-badge-pill" style="background: #fef3c7; color: #b45309;">Coming Soon</span>
              </div>
              <p class="category-card-desc">Institutional procurement, departmental hospital crest embroidery, and tiered corporate volume discounts for medical institutions.</p>
              <div class="category-card-footer">
                <span class="category-card-cta" style="color: #b45309;">
                  Inquire for Enterprise
                  <span class="category-card-arrow-circle" aria-hidden="true" style="color: #b45309; background: #fef3c7;">→</span>
                </span>
              </div>
            </div>
          </a>
        </div>
      {% endif %}
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 3. PROPRIETARY SERIES SPOTLIGHT                              -->
  <!-- ============================================================ -->
  {% liquid
    assign enable_series = true
    if section.settings.enable_series_showcase == false
      assign enable_series = false
    endif

    assign series_blocks_count = 0
    for block in section.blocks
      if block.type == 'series_card'
        assign series_blocks_count = series_blocks_count | plus: 1
      endif
    endfor
  %}

  {% if enable_series %}
  <section style="background-color: #f8fafc; padding: 60px 0; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;">
    <div class="page-container">
      <div class="section-header-wrap" style="margin-top: 0;">
        <span class="section-tag-sub">{{ section.settings.series_tag | default: 'ENGINEERED FOR CLINICAL ROLES' | escape }}</span>
        <h2 class="section-title-main">{{ section.settings.series_title | default: 'Signature Scrub Lines' | escape }}</h2>
        <p class="section-title-desc">{{ section.settings.series_subtitle | default: 'From intense ER calls to executive outpatient consultations, discover purpose-built medical uniforms.' | escape }}</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
        {% if series_blocks_count > 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'series_card' %}
              {% liquid
                assign bg_color = '#e0f2fe'
                assign text_color = '#0369a1'
                case block.settings.badge_color_preset
                  when 'pink'
                    assign bg_color = '#fdf2f8'
                    assign text_color = '#be185d'
                  when 'amber'
                    assign bg_color = '#fef3c7'
                    assign text_color = '#b45309'
                  when 'teal'
                    assign bg_color = '#ccfbf1'
                    assign text_color = '#0f766e'
                endcase
              %}
              <div class="category-tile-card" style="padding: 24px; text-align: left;" id="shopify-block-{{ block.id }}" {{ block.shopify_attributes }}>
                <span style="font-size: 10px; font-weight: 700; background: {{ bg_color }}; color: {{ text_color }}; padding: 4px 8px; border-radius: 4px; text-transform: uppercase;">
                  {{ block.settings.badge_tag | escape }}
                </span>
                <h3 style="font-size: 18px; font-weight: 700; color: #102a43; margin: 12px 0 6px;">{{ block.settings.title | escape }}</h3>
                <p style="font-size: 12px; color: #64748b; margin-bottom: 16px; line-height: 1.5;">{{ block.settings.description | escape }}</p>
                <div style="font-size: 13px; font-weight: 700; color: #102a43; margin-bottom: 16px;">{{ block.settings.price_label | escape }}</div>
