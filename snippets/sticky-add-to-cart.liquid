{% doc %}
  Sticky Add to Cart Bar for high mobile conversion
{% enddoc %}

<div class="sticky-atc-bar" id="sticky-atc-bar" aria-hidden="true">
  <div class="page-width sticky-atc-inner">
    <div class="sticky-atc-product">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 90 }}"
          alt="{{ product.title | escape }}"
          width="42"
          height="42"
          loading="lazy"
          class="sticky-atc-img"
        >
      {% endif %}
      <div class="sticky-atc-meta">
        <span class="sticky-atc-title">{{ product.title | truncate: 35 }}</span>
        <span class="sticky-atc-price">{{ product.selected_or_first_available_variant.price | money }}</span>
      </div>
    </div>

    <div class="sticky-atc-actions">
      <button
        type="button"
        class="sticky-atc-btn button"
        id="sticky-atc-btn"
        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
        {% unless product.available %}disabled{% endunless %}
      >
        {% if product.available %}
          Add to Cart
        {% else %}
          Sold Out
        {% endif %}
      </button>
    </div>
  </div>
</div>

<style>
  .sticky-atc-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: #ffffff;
    box-shadow: 0 -4px 16px rgba(0,0,0,0.08);
    border-top: 1px solid #e5e7eb;
    z-index: 990;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 10px 0;
  }
  .sticky-atc-bar.is-visible {
    transform: translateY(0);
  }
  .sticky-atc-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .sticky-atc-product {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .sticky-atc-img {
    width: 44px;
    height: 44px;
    border-radius: 6px;
    object-fit: cover;
    border: 1px solid #e5e7eb;
  }
  .sticky-atc-meta {
    display: flex;
    flex-direction: column;
  }
  .sticky-atc-title {
    font-size: 14px;
    font-weight: 600;
    color: #111827;
  }
  .sticky-atc-price {
    font-size: 13px;
    font-weight: 700;
    color: #059669;
  }
  .sticky-atc-btn {
    padding: 10px 24px;
    background: #111827;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    min-width: 140px;
    transition: background 0.2s ease;
  }
  .sticky-atc-btn:hover {
    background: #27272a;
  }
  @media screen and (max-width: 640px) {
    .sticky-atc-inner {
      padding: 0 16px;
    }
    .sticky-atc-title {
      max-width: 160px;
      font-size: 13px;
    }
    .sticky-atc-btn {
      padding: 10px 18px;
      min-width: 110px;
      font-size: 13px;
    }
  }
</style>

<script>
  (function() {
    function initStickyATC() {
      const bar = document.getElementById('sticky-atc-bar');
      const atcBtn = document.getElementById('sticky-atc-btn');
      if (!bar) return;

      const mainAddToCart = document.querySelector('form[action*="/cart/add"] button[type="submit"]') ||
                            document.querySelector('.product-form__submit');

      if (mainAddToCart) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) {
              bar.classList.add('is-visible');
              bar.setAttribute('aria-hidden', 'false');
            } else {
              bar.classList.remove('is-visible');
              bar.setAttribute('aria-hidden', 'true');
            }
          });
        }, { threshold: 0 });

        observer.observe(mainAddToCart);
      }

      if (atcBtn) {
        atcBtn.addEventListener('click', async () => {
          const variantId = atcBtn.dataset.variantId;
          atcBtn.disabled = true;
          atcBtn.textContent = 'Adding...';

          try {
            const res = await fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: variantId, quantity: 1 })
            });
            if (res.ok) {
              atcBtn.textContent = 'Added!';
              atcBtn.style.background = '#059669';
              window.location.reload();
            } else {
              atcBtn.textContent = 'Error';
              atcBtn.disabled = false;
            }
          } catch(e) {
            atcBtn.textContent = 'Add to Cart';
            atcBtn.disabled = false;
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStickyATC);
    } else {
      initStickyATC();
    }
  })();
</script>
