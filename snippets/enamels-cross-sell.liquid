  .cross-sell-variant-box {
    margin-bottom: 14px;
  }

  .cross-sell-sublabel {
    display: block;
    font-size: 11px;
    font-weight: 700;
    color: #475569;
    margin-bottom: 6px;
    text-transform: uppercase;
