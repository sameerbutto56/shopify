{% comment %}
  Enamels Interactive Cross-Selling & Product Preview System
  Features:
  - Replaces tiny static thumbnails with an interactive, responsive discovery system
  - Category tabs: Caps | Sleeves | Accessories | More ▾
  - Usable product dropdown & search selector with live product names & prices
  - Large, accurate high-resolution product preview image (contain/cover, aspect ratio)
  - Synchronized product title, pricing, SKU, and variant selection (color, size)
  - Multi-item complementary staging tray (bundle Caps + Sleeves + Scrub)
  - 1-Click direct Add-to-Cart with variant validation & cart drawer refresh
  - 100% real Shopify product data from collections or catalogue
{% endcomment %}

{%- liquid
  assign heading = section.settings.cross_sell_heading | default: 'Complementary Clinical Essentials' | escape
  assign subheading = section.settings.cross_sell_subheading | default: 'Discover perfectly paired surgical caps, compression sleeves, and medical accessories to complete your uniform.' | escape
  assign image_fit = section.settings.cross_sell_image_fit | default: 'contain'
  assign aspect_ratio = section.settings.cross_sell_aspect_ratio | default: '3/4'
  assign btn_label = section.settings.cross_sell_btn_label | default: 'Add to Cart' | escape
-%}

<div class="enamels-cross-sell-container" id="enamels-cross-sell-section" data-image-fit="{{ image_fit }}" data-aspect-ratio="{{ aspect_ratio }}">
  <!-- Section Header -->
  <div class="cross-sell-header-row">
    <div>
      <span class="cross-sell-kicker">STEP 8: COMPLEMENTARY CLINICAL ADD-ONS</span>
      <h3 class="cross-sell-main-title">{{ heading }}</h3>
      <p class="cross-sell-desc">{{ subheading }}</p>
    </div>
    <div class="cross-sell-badge-pill">
      <span>✨ Verified Matching Accessories</span>
    </div>
  </div>

  <!-- Category Selection Bar: Caps | Sleeves | Accessories | More ▾ -->
  <div class="cross-sell-tabs-bar" role="tablist" aria-label="Complementary Categories">
    <button
      type="button"
      class="cross-sell-tab-btn active"
      id="tab-btn-caps"
      role="tab"
      aria-selected="true"
      aria-controls="cross-sell-tab-panel"
      onclick="window.selectCrossSellCategory('caps')"
    >
      <span class="tab-icon">🧢</span>
      <span>Surgical Caps</span>
    </button>

    <button
      type="button"
      class="cross-sell-tab-btn"
      id="tab-btn-sleeves"
      role="tab"
      aria-selected="false"
      aria-controls="cross-sell-tab-panel"
      onclick="window.selectCrossSellCategory('sleeves')"
    >
      <span class="tab-icon">💪</span>
      <span>Arm Sleeves</span>
    </button>

    <button
      type="button"
      class="cross-sell-tab-btn"
      id="tab-btn-accessories"
      role="tab"
      aria-selected="false"
      aria-controls="cross-sell-tab-panel"
      onclick="window.selectCrossSellCategory('accessories')"
    >
      <span class="tab-icon">🩺</span>
      <span>Accessories</span>
    </button>

    <!-- More Menu Dropdown -->
    <div class="cross-sell-more-dropdown-wrap">
      <button
        type="button"
        class="cross-sell-tab-btn cross-sell-more-trigger"
        id="cross-sell-more-btn"
        aria-haspopup="true"
        aria-expanded="false"
        onclick="window.toggleCrossSellMoreMenu(event)"
      >
        <span class="tab-icon">➕</span>
        <span id="cross-sell-more-label">More</span>
        <span class="dropdown-arrow" aria-hidden="true">▾</span>
      </button>

      <div class="cross-sell-more-popover" id="cross-sell-more-menu" role="menu" aria-label="Additional Complementary Categories">
        <button type="button" class="more-menu-item" role="menuitem" onclick="window.selectCrossSellCategory('labcoats')">
          <span>🥼 Fitted Lab Coats</span>
        </button>
        <button type="button" class="more-menu-item" role="menuitem" onclick="window.selectCrossSellCategory('socks')">
          <span>🧦 Compression Socks</span>
        </button>
        <button type="button" class="more-menu-item" role="menuitem" onclick="window.selectCrossSellCategory('embroidery')">
          <span>🧵 Custom Embroidery & Patches</span>
        </button>
        <button type="button" class="more-menu-item" role="menuitem" onclick="window.selectCrossSellCategory('underscrubs')">
          <span>👕 Breathable Underscrubs</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Interactive Cross-Sell Workspace (Grid: Preview on Left, Selector & Variants on Right) -->
  <div class="cross-sell-workspace" id="cross-sell-tab-panel" role="tabpanel">
    <!-- Left Column: Large Product Image Preview Area -->
    <div class="cross-sell-preview-column">
      <div class="cross-sell-preview-stage" id="cross-sell-stage">
        <div class="cross-sell-stage-badge" id="cross-sell-stock-badge">In Stock</div>
        <img
          id="cross-sell-main-img"
          src="{{ 'cat-caps.jpg' | asset_url }}"
          alt="Product Preview"
          class="cross-sell-large-image"
          loading="lazy"
          width="400"
          height="400"
        />
        <div class="cross-sell-stage-overlay">
          <span id="cross-sell-img-caption">BunFit™ Surgical Cap</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Product Selector, Variant Options, and Action Controls -->
    <div class="cross-sell-controls-column">
      <!-- 1. Product Selection Dropdown -->
      <div class="form-field-group" style="margin-bottom: 14px;">
        <label for="cross-sell-product-select" class="cross-sell-label">
          <span>Select Product:</span>
          <span class="cross-sell-cat-pill" id="cross-sell-active-cat-name">Surgical Caps</span>
        </label>
        <div class="cross-sell-select-wrapper">
          <select
            id="cross-sell-product-select"
            class="cross-sell-select-input"
            onchange="window.handleCrossSellProductChange(this.value)"
            aria-label="Select complementary product"
          >
            <!-- Dynamically populated via real Shopify live products -->
          </select>
        </div>
      </div>

      <!-- 2. Product Name & Pricing Header -->
      <div class="cross-sell-meta-block">
        <h4 class="cross-sell-active-title" id="cross-sell-active-title">BunFit™ Extra Volume Surgical Cap</h4>
        <div class="cross-sell-price-row">
          <span class="cross-sell-current-price" id="cross-sell-active-price">Rs. 1,450</span>
          <span class="cross-sell-compare-price" id="cross-sell-active-compare" style="display: none;">Rs. 1,850</span>
          <span class="cross-sell-discount-tag" id="cross-sell-active-discount" style="display: none;">Save 20%</span>
        </div>
        <p class="cross-sell-active-desc" id="cross-sell-active-desc">
          High-performance hair containment pouch with elastic tie-back. Prevents tension headaches during extended surgical rounds.
        </p>
      </div>

      <!-- 3. Variant Options Area (Color, Size, etc.) -->
      <div id="cross-sell-variant-options-wrap" class="cross-sell-variant-box">
        <!-- Variant Option 1 (e.g. Color) -->
        <div class="form-field-group" id="cross-sell-opt-1-group" style="display: none; margin-bottom: 12px;">
          <label class="cross-sell-sublabel" id="cross-sell-opt-1-label">Select Color:</label>
          <div class="cross-sell-pill-options" id="cross-sell-opt-1-pills"></div>
        </div>

        <!-- Variant Option 2 (e.g. Size) -->
        <div class="form-field-group" id="cross-sell-opt-2-group" style="display: none; margin-bottom: 12px;">
          <label class="cross-sell-sublabel" id="cross-sell-opt-2-label">Select Size:</label>
          <div class="cross-sell-pill-options" id="cross-sell-opt-2-pills"></div>
        </div>
      </div>

      <!-- 4. Action Buttons -->
      <div class="cross-sell-actions-row">
        <!-- Quantity Step -->
        <div class="cross-sell-qty-picker">
          <button type="button" class="cross-qty-btn" onclick="window.stepCrossSellQty(-1)" aria-label="Decrease quantity">-</button>
          <input type="text" id="cross-sell-qty-input" value="1" readonly aria-label="Quantity" />
          <button type="button" class="cross-qty-btn" onclick="window.stepCrossSellQty(1)" aria-label="Increase quantity">+</button>
        </div>

        <!-- Add Directly to Cart -->
        <button
          type="button"
          class="btn-cross-sell-atc"
          id="btn-cross-sell-add"
          onclick="window.addActiveCrossSellToCart()"
        >
          <span>🛒 {{ btn_label }}</span>
        </button>

        <!-- Stage/Bundle with Scrub Option -->
        <button
          type="button"
          class="btn-cross-sell-bundle"
          id="btn-cross-sell-stage"
          onclick="window.stageCrossSellForScrubBundle()"
          title="Add to your scrub order bundle below"
        >
          <span>➕ Bundle with Scrub</span>
        </button>
      </div>

      <!-- Success Notification Banner -->
      <div id="cross-sell-notice" class="cross-sell-notice-banner" style="display: none;">
        <span class="notice-icon">✓</span>
        <span id="cross-sell-notice-msg">Item added to your order!</span>
      </div>
    </div>
  </div>

  <!-- Multi-Item Complementary Staging Tray (Shows bundled caps, sleeves, etc.) -->
  <div id="cross-sell-staged-tray" class="cross-sell-staged-tray" style="display: none;">
    <div class="staged-tray-header">
      <span class="staged-tray-title">📦 Bundled Add-Ons for this Order:</span>
      <span class="staged-tray-count" id="staged-tray-count">0 items selected</span>
    </div>
    <div class="staged-items-chips" id="staged-items-chips">
      <!-- Staged items rendered here -->
    </div>
  </div>
</div>

