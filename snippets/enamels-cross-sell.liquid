</style>

<script>
  (function() {
    'use strict';

    // State object for the cross-selling interactive engine
    const CROSS_SELL_STATE = {
      activeCategory: 'caps',
      activeProduct: null,
      activeVariant: null,
      selectedOptions: {},
      qty: 1,
      productsByCategory: {
        caps: [],
        sleeves: [],
        accessories: [],
        labcoats: [],
        socks: [],
        embroidery: [],
        underscrubs: []
      },
      stagedItems: []
    };

    window.CrossSellEngine = CROSS_SELL_STATE;

    // Load and categorize products from Shopify live catalogue or fallbacks
    function initializeCatalogData() {
      const live = window.ShopifyLiveProducts || [];

      // Categorize products by tags or product type
      live.forEach(p => {
        const type = (p.product_type || '').toLowerCase();
        const title = (p.title || '').toLowerCase();
        const tags = (p.tags || []).map(t => String(t).toLowerCase());

        const isCap = type.includes('cap') || title.includes('cap') || tags.some(t => t.includes('cap'));
        const isSleeve = type.includes('sleeve') || title.includes('sleeve') || tags.some(t => t.includes('sleeve'));
        const isLabCoat = type.includes('lab') || title.includes('lab') || tags.some(t => t.includes('lab'));
        const isSocks = type.includes('sock') || title.includes('sock') || tags.some(t => t.includes('sock'));
        const isEmbroidery = type.includes('customization') || title.includes('embroidery') || title.includes('patch');

        if (isCap) CROSS_SELL_STATE.productsByCategory.caps.push(p);
        else if (isSleeve) CROSS_SELL_STATE.productsByCategory.sleeves.push(p);
        else if (isLabCoat) CROSS_SELL_STATE.productsByCategory.labcoats.push(p);
        else if (isSocks) CROSS_SELL_STATE.productsByCategory.socks.push(p);
        else if (isEmbroidery) CROSS_SELL_STATE.productsByCategory.embroidery.push(p);
        else if (type.includes('accessories') || tags.some(t => t.includes('accessories'))) {
          CROSS_SELL_STATE.productsByCategory.accessories.push(p);
        }
      });

      // Provide robust fallback entries if store catalogue does not have specific categories populated yet
      if (!CROSS_SELL_STATE.productsByCategory.caps.length) {
        CROSS_SELL_STATE.productsByCategory.caps = [
          {
            id: 'cap-bunfit-navy',
            title: 'BunFit™ Extra Volume Scrub Cap (Navy)',
            price: 145000,
            compare_at_price: 185000,
            featured_image: "{{ 'cat-caps.jpg' | asset_url }}",
            description: 'Specifically engineered for medical professionals with long hair or buns. Generous volume pouch with tie-back.',
            options: ['Color'],
            variants: [
              { id: 49900101, title: 'Deep Navy', price: 145000, available: true, options: ['Deep Navy'], featured_image: "{{ 'cat-caps.jpg' | asset_url }}" },
              { id: 49900102, title: 'Clinical Teal', price: 145000, available: true, options: ['Clinical Teal'], featured_image: "{{ 'cat-caps.jpg' | asset_url }}" },
              { id: 49900103, title: 'Obsidian Black', price: 145000, available: true, options: ['Obsidian Black'], featured_image: "{{ 'cat-caps.jpg' | asset_url }}" }
            ]
          },
          {
            id: 'cap-kennedy-designer',
            title: 'Kennedy Series Designer Cap (Printed)',
            price: 165000,
            compare_at_price: null,
            featured_image: "{{ 'cat-caps.jpg' | asset_url }}",
            description: 'Modern low-profile clinical cap with breathable sweatband and antimicrobial finish.',
            options: ['Design'],
            variants: [
              { id: 49900104, title: 'Cardiac Wave', price: 165000, available: true, options: ['Cardiac Wave'], featured_image: "{{ 'cat-caps.jpg' | asset_url }}" },
              { id: 49900105, title: 'Anaesthesia Minimalist', price: 165000, available: true, options: ['Anaesthesia Minimalist'], featured_image: "{{ 'cat-caps.jpg' | asset_url }}" }
            ]
          }
        ];
      }

      if (!CROSS_SELL_STATE.productsByCategory.sleeves.length) {
        CROSS_SELL_STATE.productsByCategory.sleeves = [
          {
            id: 'sleeves-med-compression',
            title: 'Med Sleeves Graduated Compression Arms',
            price: 75000,
            compare_at_price: 95000,
            featured_image: "{{ 'cat-customizer.jpg' | asset_url }}",
            description: 'Medical-grade arm sleeves providing graduated compression to reduce fatigue during lengthy clinical procedures.',
            options: ['Size', 'Color'],
            variants: [
              { id: 49900201, title: 'M / Black', price: 75000, available: true, options: ['M', 'Black'], featured_image: "{{ 'cat-customizer.jpg' | asset_url }}" },
              { id: 49900202, title: 'L / Black', price: 75000, available: true, options: ['L', 'Black'], featured_image: "{{ 'cat-customizer.jpg' | asset_url }}" },
              { id: 49900203, title: 'M / Navy', price: 75000, available: true, options: ['M', 'Navy'], featured_image: "{{ 'cat-customizer.jpg' | asset_url }}" }
            ]
          }
        ];
      }

      if (!CROSS_SELL_STATE.productsByCategory.accessories.length) {
        CROSS_SELL_STATE.productsByCategory.accessories = [
          {
            id: 'acc-compression-socks',
            title: 'Clinical Graduated Compression Socks',
            price: 55000,
            compare_at_price: null,
            featured_image: "{{ 'cat-home-service.jpg' | asset_url }}",
            description: '15-20 mmHg graduated calf compression socks for nursing and surgical shifts.',
            options: ['Size'],
            variants: [
              { id: 49900301, title: 'Medium (38-41)', price: 55000, available: true, options: ['Medium (38-41)'], featured_image: "{{ 'cat-home-service.jpg' | asset_url }}" },
              { id: 49900302, title: 'Large (42-45)', price: 55000, available: true, options: ['Large (42-45)'], featured_image: "{{ 'cat-home-service.jpg' | asset_url }}" }
            ]
          }
        ];
      }

      if (!CROSS_SELL_STATE.productsByCategory.labcoats.length) {
        CROSS_SELL_STATE.productsByCategory.labcoats = [
          {
            id: 'coat-helium-fitted',
            title: 'Helium Series Women’s Fitted Lab Coat',
            price: 295000,
            compare_at_price: null,
            featured_image: "{{ 'cat-bulk-orders.jpg' | asset_url }}",
            description: 'Tailored technical white lab coat with tablet-sized pockets and wrinkle resistance.',
            options: ['Size'],
            variants: [
              { id: 49900401, title: 'S', price: 295000, available: true, options: ['S'], featured_image: "{{ 'cat-bulk-orders.jpg' | asset_url }}" },
              { id: 49900402, title: 'M', price: 295000, available: true, options: ['M'], featured_image: "{{ 'cat-bulk-orders.jpg' | asset_url }}" },
              { id: 49900403, title: 'L', price: 295000, available: true, options: ['L'], featured_image: "{{ 'cat-bulk-orders.jpg' | asset_url }}" }
            ]
          }
        ];
      }
    }

    // Category Selector
    window.selectCrossSellCategory = function(catKey) {
      CROSS_SELL_STATE.activeCategory = catKey;

      // Update Tab UI
      document.querySelectorAll('.cross-sell-tab-btn').forEach(btn => btn.classList.remove('active'));
      const activeTab = document.getElementById(`tab-btn-${catKey}`);
      if (activeTab) activeTab.classList.add('active');

      // Close More dropdown
      const moreMenu = document.getElementById('cross-sell-more-menu');
      const moreBtn = document.getElementById('cross-sell-more-btn');
      if (moreMenu) moreMenu.classList.remove('open');
      if (moreBtn) moreBtn.setAttribute('aria-expanded', 'false');

      // Update active category pill label
      const catNameMap = {
        caps: 'Surgical Caps',
        sleeves: 'Arm Sleeves',
        accessories: 'Accessories',
        labcoats: 'Fitted Lab Coats',
        socks: 'Compression Socks',
        embroidery: 'Embroidery & Crests',
        underscrubs: 'Breathable Underscrubs'
      };
      const catPill = document.getElementById('cross-sell-active-cat-name');
      if (catPill) catPill.textContent = catNameMap[catKey] || catKey.toUpperCase();

      // Populate product dropdown for this category
      populateProductDropdown(catKey);
    };

    window.toggleCrossSellMoreMenu = function(e) {
      e.stopPropagation();
      const menu = document.getElementById('cross-sell-more-menu');
      const btn = document.getElementById('cross-sell-more-btn');
      if (!menu) return;
      const isOpen = menu.classList.contains('open');
      menu.classList.toggle('open', !isOpen);
      if (btn) btn.setAttribute('aria-expanded', String(!isOpen));
    };

    // Close menu when clicking outside
    document.addEventListener('click', () => {
      const menu = document.getElementById('cross-sell-more-menu');
      const btn = document.getElementById('cross-sell-more-btn');
      if (menu && menu.classList.contains('open')) {
        menu.classList.remove('open');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      }
    });

    // Populate Product Dropdown
    function populateProductDropdown(catKey) {
      const select = document.getElementById('cross-sell-product-select');
      if (!select) return;

      const prods = CROSS_SELL_STATE.productsByCategory[catKey] || [];
      select.innerHTML = '';

      if (!prods.length) {
        const opt = document.createElement('option');
        opt.value = '';
        opt.textContent = 'No products found in this category';
        select.appendChild(opt);
        return;
      }

      prods.forEach((p, idx) => {
        const opt = document.createElement('option');
        opt.value = p.id;
        const priceFmt = (p.price > 1000) ? Math.round(p.price / 100) : p.price;
        opt.textContent = `${p.title.replace('DEMO — ', '')} — Rs. ${priceFmt.toLocaleString()}`;
        if (idx === 0) opt.selected = true;
        select.appendChild(opt);
      });

      // Select first product
      selectProduct(prods[0]);
    }

    // Select Product and Render Large Image, Variants, and Info
    function selectProduct(product) {
      if (!product) return;
      CROSS_SELL_STATE.activeProduct = product;
      CROSS_SELL_STATE.selectedOptions = {};

      // 1. Update Preview Image
      const imgEl = document.getElementById('cross-sell-main-img');
      const captionEl = document.getElementById('cross-sell-img-caption');
      const imgSrc = product.featured_image || (product.images && product.images[0]?.src) || "{{ 'cat-caps.jpg' | asset_url }}";

      if (imgEl) {
        imgEl.style.opacity = '0';
        setTimeout(() => {
          imgEl.src = imgSrc;
          imgEl.alt = product.title;
          imgEl.style.opacity = '1';
        }, 150);
      }
      if (captionEl) captionEl.textContent = product.title.replace('DEMO — ', '');

      // 2. Update Titles and Price
      const titleEl = document.getElementById('cross-sell-active-title');
      const priceEl = document.getElementById('cross-sell-active-price');
      const compEl = document.getElementById('cross-sell-active-compare');
      const discEl = document.getElementById('cross-sell-active-discount');
      const descEl = document.getElementById('cross-sell-active-desc');

      if (titleEl) titleEl.textContent = product.title.replace('DEMO — ', '');

      const basePrice = (product.price > 1000) ? Math.round(product.price / 100) : product.price;
      if (priceEl) priceEl.textContent = `Rs. ${basePrice.toLocaleString()}`;

      if (product.compare_at_price && product.compare_at_price > product.price) {
        const compPrice = (product.compare_at_price > 1000) ? Math.round(product.compare_at_price / 100) : product.compare_at_price;
        if (compEl) {
          compEl.textContent = `Rs. ${compPrice.toLocaleString()}`;
          compEl.style.display = 'inline';
        }
        if (discEl) {
          const pct = Math.round(((compPrice - basePrice) / compPrice) * 100);
          discEl.textContent = `Save ${pct}%`;
          discEl.style.display = 'inline';
        }
      } else {
        if (compEl) compEl.style.display = 'none';
        if (discEl) discEl.style.display = 'none';
      }

      if (descEl) descEl.textContent = product.description || 'Premium medical hospital apparel crafted for performance.';

      // 3. Render Variants
      renderVariantControls(product);
    }

    window.handleCrossSellProductChange = function(productId) {
      const prods = CROSS_SELL_STATE.productsByCategory[CROSS_SELL_STATE.activeCategory] || [];
      const chosen = prods.find(p => String(p.id) === String(productId));
      if (chosen) selectProduct(chosen);
    };

    // Render Variant Options (Option 1 Color, Option 2 Size)
    function renderVariantControls(product) {
      const opt1Group = document.getElementById('cross-sell-opt-1-group');
      const opt1Label = document.getElementById('cross-sell-opt-1-label');
      const opt1Pills = document.getElementById('cross-sell-opt-1-pills');

      const opt2Group = document.getElementById('cross-sell-opt-2-group');
      const opt2Label = document.getElementById('cross-sell-opt-2-label');
      const opt2Pills = document.getElementById('cross-sell-opt-2-pills');

      if (!product.variants || !product.variants.length) {
        if (opt1Group) opt1Group.style.display = 'none';
        if (opt2Group) opt2Group.style.display = 'none';
        CROSS_SELL_STATE.activeVariant = null;
        return;
      }

      const options = product.options || ['Option'];
      const variants = product.variants;

      // Reset
      if (opt1Pills) opt1Pills.innerHTML = '';
      if (opt2Pills) opt2Pills.innerHTML = '';

      // Option 1
      if (options.length >= 1) {
        const opt1Name = options[0];
        if (opt1Label) opt1Label.textContent = `Select ${opt1Name}:`;
        if (opt1Group) opt1Group.style.display = 'block';

        const opt1Values = [...new Set(variants.map(v => v.options?.[0] || v.title).filter(Boolean))];
        opt1Values.forEach((val, idx) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = `cross-sell-option-btn ${idx === 0 ? 'selected' : ''}`;
          btn.textContent = val;
          btn.onclick = () => {
            document.querySelectorAll('#cross-sell-opt-1-pills .cross-sell-option-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            CROSS_SELL_STATE.selectedOptions[opt1Name] = val;
            updateSelectedVariant(product);
          };
          opt1Pills.appendChild(btn);
        });
        CROSS_SELL_STATE.selectedOptions[opt1Name] = opt1Values[0];
      } else {
        if (opt1Group) opt1Group.style.display = 'none';
      }

      // Option 2
      if (options.length >= 2) {
        const opt2Name = options[1];
        if (opt2Label) opt2Label.textContent = `Select ${opt2Name}:`;
        if (opt2Group) opt2Group.style.display = 'block';

        const opt2Values = [...new Set(variants.map(v => v.options?.[1]).filter(Boolean))];
        opt2Values.forEach((val, idx) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = `cross-sell-option-btn ${idx === 0 ? 'selected' : ''}`;
          btn.textContent = val;
          btn.onclick = () => {
            document.querySelectorAll('#cross-sell-opt-2-pills .cross-sell-option-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            CROSS_SELL_STATE.selectedOptions[opt2Name] = val;
            updateSelectedVariant(product);
          };
          opt2Pills.appendChild(btn);
        });
        CROSS_SELL_STATE.selectedOptions[opt2Name] = opt2Values[0];
      } else {
        if (opt2Group) opt2Group.style.display = 'none';
      }

      updateSelectedVariant(product);
    }

    // Resolve matching variant from selected options
    function updateSelectedVariant(product) {
      if (!product.variants || !product.variants.length) return;

      const opts = product.options || [];
      const val1 = opts[0] ? CROSS_SELL_STATE.selectedOptions[opts[0]] : null;
      const val2 = opts[1] ? CROSS_SELL_STATE.selectedOptions[opts[1]] : null;

      let matched = product.variants.find(v => {
        const vOpt1 = v.options?.[0] || v.title;
        const vOpt2 = v.options?.[1];
        if (val1 && val2) return vOpt1 === val1 && vOpt2 === val2;
        if (val1) return vOpt1 === val1;
        return true;
      });

      if (!matched) matched = product.variants[0];
      CROSS_SELL_STATE.activeVariant = matched;

      // Update price and preview image if variant has its own image
      const priceEl = document.getElementById('cross-sell-active-price');
      const badgeEl = document.getElementById('cross-sell-stock-badge');
      const imgEl = document.getElementById('cross-sell-main-img');

      if (matched) {
        const varPrice = (matched.price > 1000) ? Math.round(matched.price / 100) : matched.price;
        if (priceEl) priceEl.textContent = `Rs. ${varPrice.toLocaleString()}`;

        if (badgeEl) {
          badgeEl.textContent = matched.available ? 'In Stock' : 'Out of Stock';
          badgeEl.style.background = matched.available ? 'rgba(16, 42, 67, 0.85)' : '#e11d48';
        }

        if (matched.featured_image && imgEl) {
          imgEl.src = matched.featured_image;
        }
      }
    }

    // Quantity Picker
    window.stepCrossSellQty = function(delta) {
      CROSS_SELL_STATE.qty = Math.max(1, CROSS_SELL_STATE.qty + delta);
      const input = document.getElementById('cross-sell-qty-input');
      if (input) input.value = CROSS_SELL_STATE.qty;
    };

    // 1-Click Direct Add to Cart Action
    window.addActiveCrossSellToCart = async function() {
      const prod = CROSS_SELL_STATE.activeProduct;
      const variant = CROSS_SELL_STATE.activeVariant || prod?.variants?.[0];
      if (!prod) return;

      const qty = CROSS_SELL_STATE.qty || 1;
      const variantId = variant?.id || null;
      const title = prod.title.replace('DEMO — ', '');
      const unitPrice = variant?.price ? (variant.price > 1000 ? Math.round(variant.price / 100) : variant.price) : 1450;
      const variantTitle = variant?.title && variant.title !== 'Default Title' ? variant.title : 'Standard';

      const cartItem = {
        id: `cross-${prod.id}-${Date.now()}`,
        productId: prod.id,
        variantId: variantId,
        title: title,
        series: 'Complementary Addon',
        image: variant?.featured_image || prod.featured_image || "{{ 'cat-caps.jpg' | asset_url }}",
        color: variantTitle,
        size: 'Standard',
        quantity: qty,
        unitPrice: unitPrice,
        lineTotal: unitPrice * qty,
        properties: {
          'Complementary Add-On': title,
          'Variant': variantTitle
        },
        requiresAdvancePayment: false
      };

      // 1. Sync to local stored cart
      try {
        let stored = [];
        const raw = localStorage.getItem('enamels_demo_cart');
        if (raw) stored = JSON.parse(raw);
        stored.push(cartItem);
        localStorage.setItem('enamels_demo_cart', JSON.stringify(stored));
      } catch(e) {}

      // 2. Sync to Shopify backend cart if valid numeric variant exists
      if (variantId && typeof variantId === 'number') {
        try {
          await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              items: [{ id: variantId, quantity: qty }]
            })
          });
        } catch(e) {
          console.debug('Shopify backend cart add:', e);
        }
      }

      // 3. Show notification & trigger cart drawer
      showNoticeBanner(`✓ Added ${qty}× ${title} (${variantTitle}) to Cart!`);

      if (typeof window.updateCartBadge === 'function') window.updateCartBadge();
      if (typeof window.updateAllShippingCalculators === 'function') window.updateAllShippingCalculators();
      if (typeof window.openCartDrawer === 'function') {
        setTimeout(() => window.openCartDrawer(), 300);
      }
    };

    // Stage item to bundle directly with scrub order
    window.stageCrossSellForScrubBundle = function() {
      const prod = CROSS_SELL_STATE.activeProduct;
      const variant = CROSS_SELL_STATE.activeVariant || prod?.variants?.[0];
      if (!prod) return;

      const qty = CROSS_SELL_STATE.qty || 1;
      const unitPrice = variant?.price ? (variant.price > 1000 ? Math.round(variant.price / 100) : variant.price) : 1450;
      const title = prod.title.replace('DEMO — ', '');
      const variantTitle = variant?.title && variant.title !== 'Default Title' ? variant.title : 'Standard';

      const stagedItem = {
        title: `${title} (${variantTitle})`,
        price: unitPrice * qty,
        variantId: variant?.id,
        qty: qty
      };

      // Also register to STATE.pdpCompanionAddons so main scrub ATC picks it up!
      if (window.EnamelsChromaticState && Array.isArray(window.EnamelsChromaticState.pdpCompanionAddons)) {
        window.EnamelsChromaticState.pdpCompanionAddons.push({
          title: `${title} (${variantTitle})`,
          price: unitPrice * qty
        });
      }

      CROSS_SELL_STATE.stagedItems.push(stagedItem);
      renderStagedTray();
      showNoticeBanner(`✓ Bundled ${qty}× ${title} with your scrub order!`);
    };

    // Render Staged Tray
    function renderStagedTray() {
      const tray = document.getElementById('cross-sell-staged-tray');
      const countEl = document.getElementById('staged-tray-count');
      const chipsEl = document.getElementById('staged-items-chips');
      if (!tray || !chipsEl) return;

      const items = CROSS_SELL_STATE.stagedItems;
      if (!items.length) {
        tray.style.display = 'none';
        return;
      }

      tray.style.display = 'block';
      if (countEl) countEl.textContent = `${items.length} ${items.length === 1 ? 'item' : 'items'} bundled`;
      chipsEl.innerHTML = '';

      items.forEach((it, idx) => {
        const chip = document.createElement('div');
        chip.className = 'staged-chip';
        chip.innerHTML = `
          <span>${it.title} (+Rs. ${it.price.toLocaleString()})</span>
          <button type="button" class="staged-chip-remove" onclick="window.removeStagedCrossSell(${idx})" aria-label="Remove item">✕</button>
        `;
        chipsEl.appendChild(chip);
      });
    }

    window.removeStagedCrossSell = function(idx) {
      CROSS_SELL_STATE.stagedItems.splice(idx, 1);
      if (window.EnamelsChromaticState && Array.isArray(window.EnamelsChromaticState.pdpCompanionAddons)) {
        window.EnamelsChromaticState.pdpCompanionAddons.splice(idx, 1);
      }
      renderStagedTray();
    };

    function showNoticeBanner(msg) {
      const banner = document.getElementById('cross-sell-notice');
      const msgEl = document.getElementById('cross-sell-notice-msg');
      if (banner && msgEl) {
        msgEl.textContent = msg;
        banner.style.display = 'flex';
        clearTimeout(window._csNoticeTimeout);
        window._csNoticeTimeout = setTimeout(() => {
          banner.style.display = 'none';
        }, 3500);
      }
    }

    // Initialize on DOM load
    document.addEventListener('DOMContentLoaded', () => {
      initializeCatalogData();
      window.selectCrossSellCategory('caps');
    });

    // Also initialize immediately in case script loads after DOMContentLoaded
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initializeCatalogData();
      window.selectCrossSellCategory('caps');
    }
  })();
</script>
