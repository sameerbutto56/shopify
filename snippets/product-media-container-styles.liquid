{%- doc -%}
  Shared product media container styles used by product media gallery and product card gallery markup.

  @example
  {% render 'product-media-container-styles' %}
{%- enddoc -%}

{% stylesheet %}
  :where(:not(.dialog-zoomed-gallery)) > .product-media-container {
    --slide-width: 100%;

    display: flex;
    aspect-ratio: var(--gallery-aspect-ratio, var(--media-preview-ratio));
    max-height: var(--constrained-height);
    width: var(--slide-width, 100%);

    /* Relative position needed for video and 3d models */
    position: relative;
    overflow: hidden;

    &:where(.constrain-height) {
      /* arbitrary offset value based on average theme spacing and header height */
      --viewport-offset: 400px;
      --constrained-min-height: 300px;
      --constrained-height: max(var(--constrained-min-height), calc(100vh - var(--viewport-offset)));

      margin-inline: auto;
    }

    @supports (--test: round(up, 100%, 1px)) {
      /* width and overflow forces children to shrink to parent width */
      --slide-width: round(up, 100%, 1px);
    }
  }

  @media screen and (max-width: 749px) {
    .product-media-container.constrain-height {
      max-height: none;
    }
  }

  @media screen and (min-width: 750px) {
    .product-media-container.constrain-height {
      --viewport-offset: var(--header-height, 100px);
      --constrained-min-height: 500px;
    }

    /* Header-dependent page rules use #header-group as the :has() subject and reach the page with `~`.
       With body as the subject, every [open] or [aria-expanded] change in the header restyles the whole page. */
    #header-group:has(> .header-section > header-component[transparent]) ~ * .product-media-container.constrain-height,
    quick-add-dialog[header-transparent] .product-media-container.constrain-height {
      --viewport-offset: 0px;
    }
  }

  .product-media-container img {
    aspect-ratio: inherit;
    object-fit: var(--product-media-fit, contain);
    object-position: var(--product-media-position, center);
  }

  .product-media-container.media-fit-contain img {
    object-position: var(--product-media-position, center);
  }

  .product-media-container.media-fit {
    --product-media-fit: contain;

    img {
      object-fit: var(--product-media-fit, contain);
      object-position: var(--product-media-position, center);
    }
  }

  /* Standard 1200x1800 (2:3 Portrait) Card Presentation */
  .card-gallery {
    aspect-ratio: var(--gallery-aspect-ratio, 2 / 3) !important;
    background-color: var(--product-card-bg, #f8fafc) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
  }

  .card-gallery img {
    object-fit: var(--product-media-fit, contain) !important;
    object-position: var(--product-media-position, center center) !important;
    padding: 6px !important;
    box-sizing: border-box !important;
    width: 100% !important;
    height: 100% !important;
  }
{% endstylesheet %}
