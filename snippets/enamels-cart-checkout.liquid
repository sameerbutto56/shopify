      <button type="button" class="btn-card-action" onclick="window.closeComingSoonModal(); window.navigateToGender('men');" style="background: #102a43; color: #ffffff; padding: 10px 20px; font-size: 13px; width: auto;">
        Browse Current Collection →
      </button>
      <button type="button" class="btn-card-action" onclick="window.closeComingSoonModal();" style="background: #f1f5f9; color: #475569; padding: 10px 20px; font-size: 13px; width: auto;">
