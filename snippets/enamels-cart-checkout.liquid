<script>
(function() {
    // ------------------------------------------------------------
    // 9. CART DRAWER & PERSISTENCE (SECTION 14)
    // ------------------------------------------------------------
    function getStoredCart() {
      try {
        const raw = localStorage.getItem('enamels_demo_cart');
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    }

    function saveCart(cart) {
      try {
        localStorage.setItem('enamels_demo_cart', JSON.stringify(cart));
      } catch (e) {}
    }

    function updateCartBadge() {
      const cart = getStoredCart();
      const count = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);

      const navBadge = document.getElementById('enamels-cart-count');
      const drawerBadge = document.getElementById('cart-drawer-count-badge');

      if (navBadge) navBadge.textContent = count;
      if (drawerBadge) drawerBadge.textContent = count;
    }

    window.openCartDrawer = function() {
      renderCartDrawerItems();
      const drawer = document.getElementById('enamels-cart-drawer') || document.getElementById('cart-drawer') || document.querySelector('.enamels-cart-drawer');
      const overlay = document.getElementById('cart-drawer-overlay') || document.querySelector('.enamels-cart-drawer-overlay');
      if (drawer) drawer.classList.add('open');
      if (overlay) overlay.classList.add('open');
    };

    window.closeCartDrawer = function() {
      const drawer = document.getElementById('enamels-cart-drawer') || document.getElementById('cart-drawer') || document.querySelector('.enamels-cart-drawer');
      const overlay = document.getElementById('cart-drawer-overlay') || document.querySelector('.enamels-cart-drawer-overlay');
      if (drawer) drawer.classList.remove('open');
      if (overlay) overlay.classList.remove('open');
    };

    function renderCartDrawerItems() {
      const cart = getStoredCart();
      const container = document.getElementById('cart-items-container');
      const subtotalEl = document.getElementById('cart-drawer-subtotal');
      const advanceAlert = document.getElementById('cart-advance-payment-warning');
      const freeShipProg = document.getElementById('free-shipping-progress');
      const freeShipStatus = document.getElementById('free-shipping-status');

      if (!container) return;

      if (!cart.length) {
        container.innerHTML = `
          <div style="text-align: center; padding: 60px 20px; color: #64748b;">
            <div style="font-size: 36px; margin-bottom: 12px;">🛒</div>
            <p style="font-weight: 700; color: #102a43; margin-bottom: 4px;">Your Cart is Empty</p>
            <p style="font-size: 12px; margin-bottom: 20px;">Explore our scrub collections and technical medical apparel.</p>
            <button type="button" class="btn-card-action" onclick="window.closeCartDrawer(); window.navigateToView('category-scrubs');" style="width: auto; padding: 10px 20px;">
              Browse Scrubs Collection
            </button>
          </div>
        `;
        if (subtotalEl) subtotalEl.textContent = 'Rs. 0';
        if (advanceAlert) advanceAlert.style.display = 'none';
        if (freeShipProg) freeShipProg.style.width = '0%';
        if (freeShipStatus) freeShipStatus.textContent = 'Rs. 7,000 remaining';
        return;
      }

      let subtotal = 0;
      let hasAdvanceItem = false;

      const isCustomizedCart = cart.some(item =>
        item.requiresAdvancePayment ||
        item.isCustomSize ||
        item.customization ||
        (item.properties && (
          item.properties['Customization Type'] ||
          item.properties['Custom Sizing'] === 'Yes' ||
          item.properties['Custom Measurements'] ||
          item.properties['Tailoring Specification']
        ))
      );
      if (isCustomizedCart) hasAdvanceItem = true;

      container.innerHTML = cart.map((item, idx) => {
        const itemLineTotal = (item.unitPrice || 0) * (item.quantity || 1);
        subtotal += itemLineTotal;
        if (item.requiresAdvancePayment) hasAdvanceItem = true;

        // Structured properties display
        let propsHtml = '';
        if (item.color) propsHtml += `<div>Colour: <strong>${item.color}</strong></div>`;
        if (item.size) propsHtml += `<div>Size: <strong>${item.size}</strong></div>`;
        if (item.alterations) {
          propsHtml += `<div style="color: #00b8a9;">↳ Alterations: ${item.alterations.shirtLength} Top, ${item.alterations.trouserLength} Trouser</div>`;
        }
        if (item.engraving) {
          propsHtml += `<div style="color: #102a43;">↳ Engraving (${item.engraving.font}): "${item.engraving.lines.line1}" [${item.engraving.threadColor}]</div>`;
        }
        if (item.logo) {
          propsHtml += `<div style="color: #102a43;">↳ Crest: ${item.logo.name} (${item.logo.placement})</div>`;
        }
        if (item.requiresAdvancePayment) {
          propsHtml += `<span class="cart-advance-tag">⚠️ ADVANCE PAYMENT REQUIRED</span>`;
        }

        return `
          <div class="cart-item-card">
            <img src="${item.image ? (window.ShopifyThemeAssets?.[item.image] || item.image) : ''}" alt="${item.title}" class="cart-item-thumb" onerror="this.src='{{ 'cat-sprinter.jpg' | asset_url }}'" />
            <div class="cart-item-meta">
              <h4 class="cart-item-title">${item.title}</h4>
              <div class="cart-item-props">${propsHtml}</div>
              <div class="cart-item-actions">
                <div class="cart-item-qty-row">
                  <button type="button" class="qty-btn" onclick="window.updateCartItemQty(${idx}, -1)">-</button>
                  <span style="font-size: 12px; font-weight: 700; width: 20px; text-align: center;">${item.quantity || 1}</span>
                  <button type="button" class="qty-btn" onclick="window.updateCartItemQty(${idx}, 1)">+</button>
                </div>
                <button type="button" class="cart-item-remove-link" onclick="window.removeCartItem(${idx})">Remove</button>
              </div>
            </div>
            <div class="cart-item-price-col">
              Rs. ${itemLineTotal.toLocaleString()}
            </div>
          </div>
        `;
      }).join('');

      if (subtotalEl) subtotalEl.textContent = `Rs. ${subtotal.toLocaleString()}`;
      if (advanceAlert) advanceAlert.style.display = hasAdvanceItem ? 'flex' : 'none';

      const codBtn = document.getElementById('btn-cart-cod-option');
      const codBadge = document.getElementById('cart-cod-trust-badge');
      if (codBtn) {
        if (hasAdvanceItem) {
          codBtn.style.opacity = '0.5';
          codBtn.style.background = '#f1f5f9';
          codBtn.style.borderColor = '#cbd5e1';
          codBtn.style.color = '#94a3b8';
          codBtn.title = 'Cash on Delivery is unavailable for tailored bespoke scrubs (100% advance payment required).';
        } else {
          codBtn.style.opacity = '1';
          codBtn.style.background = '#f0fdf4';
          codBtn.style.borderColor = '#86efac';
          codBtn.style.color = '#166534';
          codBtn.title = '';
        }
      }
      if (codBadge) {
        if (hasAdvanceItem) {
          codBadge.innerHTML = '⚠️ <strong>Advance Payment Required:</strong> Cash on Delivery is unavailable for bespoke customized scrubs.';
          codBadge.style.color = '#b45309';
        } else {
          codBadge.innerHTML = 'Cash on Delivery available across all cities in Pakistan • Nationwide Trax / TCS';
          codBadge.style.color = '#94a3b8';
        }
      }

      // Free shipping progress calculation (Rs. 7,000 threshold)
      const threshold = 7000;
      const progress = Math.min(100, (subtotal / threshold) * 100);
      const remaining = Math.max(0, threshold - subtotal);

      if (freeShipProg) freeShipProg.style.width = `${progress}%`;
      if (freeShipStatus) {
        freeShipStatus.textContent = remaining === 0
          ? '🎉 Free Shipping Unlocked!'
          : `Rs. ${remaining.toLocaleString()} remaining`;
      }

      // Recompute and synchronize shipping calculations
      if (typeof window.updateAllShippingCalculators === 'function') {
        window.updateAllShippingCalculators();
      }
    }

    window.updateCartItemQty = function(idx, delta) {
      const cart = getStoredCart();
      if (!cart[idx]) return;

      cart[idx].quantity = (cart[idx].quantity || 1) + delta;
      if (cart[idx].quantity <= 0) {
        cart.splice(idx, 1);
      } else {
        cart[idx].lineTotal = cart[idx].unitPrice * cart[idx].quantity;
      }

      saveCart(cart);
      updateCartBadge();
      renderCartDrawerItems();
    };

    window.removeCartItem = function(idx) {
      const cart = getStoredCart();
      cart.splice(idx, 1);
      saveCart(cart);
      updateCartBadge();
      renderCartDrawerItems();
    };

    // ------------------------------------------------------------
    // 10. CHECKOUT WORKFLOWS (SECTION 15)
    // ------------------------------------------------------------
    window.openCheckoutModal = function(mode) {
      const cart = getStoredCart();
      if (!cart.length) {
        alert('Your cart is empty. Please select a product first.');
        return;
      }

      const isCustomizedCart = cart.some(item =>
        item.requiresAdvancePayment ||
        item.isCustomSize ||
        item.customization ||
        (item.properties && (
          item.properties['Customization Type'] ||
          item.properties['Custom Sizing'] === 'Yes' ||
          item.properties['Custom Measurements'] ||
          item.properties['Tailoring Specification']
        ))
      );

      if (mode === 'cod' && isCustomizedCart) {
        alert('Notice: Cash on Delivery is unavailable for tailored bespoke scrubs. Because customized medical apparel is individually crafted to custom clinician measurements, full advance payment via Card Payment or Online Bank Transfer is required.');
        mode = 'bank';
      }

      window.closeCartDrawer();
      const modal = document.getElementById('checkout-options-modal');
      const codView = document.getElementById('checkout-view-cod');
      const bankView = document.getElementById('checkout-view-bank');
      const repView = document.getElementById('checkout-view-rep');
      const confView = document.getElementById('checkout-view-confirmation');

      if (modal) modal.style.display = 'flex';
      if (codView) codView.style.display = mode === 'cod' ? 'block' : 'none';
      if (bankView) bankView.style.display = mode === 'bank' ? 'block' : 'none';
      if (repView) repView.style.display = mode === 'rep' ? 'block' : 'none';
      if (confView) confView.style.display = 'none';
    };

    window.closeCheckoutModal = function() {
      const modal = document.getElementById('checkout-options-modal');
      if (modal) modal.style.display = 'none';
    };

    // Real Shopify Checkout Bridge & Cart Synchronization (Native Shopify Checkout)
    window.proceedToShopifyCheckout = async function(paymentIntent = 'standard') {
      const cart = getStoredCart();
      if (!cart || !cart.length) {
        alert('Your cart is empty. Please select a product first.');
        return;
      }

      const checkoutBtn = document.getElementById('btn-cart-shopify-checkout');
      const checkoutText = document.getElementById('btn-cart-checkout-text');
      if (checkoutBtn) {
        checkoutBtn.disabled = true;
        if (checkoutText) checkoutText.textContent = 'Connecting to Shopify Checkout...';
      }

      try {
        // Clear Shopify cart first
        await fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } });

        // Identify customized cart items reliably
        const isCustomizedCart = cart.some(item =>
          Boolean(item.requiresAdvancePayment ||
          item.isCustomSize ||
          item.customSize ||
          item.customization ||
          item.category === 'bespoke' ||
          (item.properties && (
            item.properties['Customization Type'] ||
            item.properties['Custom Sizing'] === 'Yes' ||
            item.properties['Custom Measurements'] ||
            item.properties['Tailoring Specification'] ||
            item.properties['Embroidery Line 1'] ||
            item.properties['Hospital Crest / Logo'] ||
            item.properties['Article Category'] === 'Customized Medical Scrub' ||
            item.properties['Bespoke Garment ID']
          )))
        );

        // Build item payloads with customizer line-item properties
        const fallbackVariantId = window.ShopifyLiveProducts?.[0]?.variants?.[0]?.id || null;
        const itemsPayload = cart.map(item => {
          const props = { ...(item.properties || {}) };
          if (!props['Article']) props['Article'] = item.title;
          if (item.color && !props['Colour']) props['Colour'] = item.color;
          if (item.size && !props['Size']) props['Size'] = item.size;
          if (item.isCustomSize && !props['Tailoring Specification']) {
            props['Tailoring Specification'] = 'Custom Tailored Specification (C)';
          }
          if (isCustomizedCart && !props['Advance Payment Required']) {
            props['Advance Payment Required'] = '100% Advance Payment Required (COD Disabled)';
          }

          const variantId = item.variantId || item.variant_id || fallbackVariantId;
          if (!variantId) return null;
          return {
            id: variantId,
            quantity: item.quantity || 1,
            properties: props
          };
        }).filter(Boolean);

        if (!itemsPayload.length) {
          alert('No valid product variant selected. Please choose an in-stock variant.');
          return;
        }

        const addRes = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: itemsPayload })
        });

        if (!addRes.ok) {
          throw new Error(`Cart add failed with status ${addRes.status}`);
        }

        // Synchronize destination and shipping rate attributes before redirecting
        let destCountry = 'Pakistan';
        let comp = { Q: cart.length, A: 0 };
        let shipResult = { shippingFee: 250, formulaText: 'Standard Courier' };
        if (typeof window.calculateShippingCharges === 'function') {
          destCountry = (typeof window.getActiveShippingCountry === 'function')
            ? window.getActiveShippingCountry()
            : (localStorage.getItem('enamels_delivery_country') || 'Pakistan');
          const subtotal = cart.reduce((sum, it) => sum + ((it.unitPrice || it.price || 0) * (it.quantity || 1)), 0);
          comp = typeof window.analyzeCartComposition === 'function'
            ? window.analyzeCartComposition(cart)
            : { Q: cart.length, A: 0 };
          shipResult = window.calculateShippingCharges(destCountry, subtotal, cart);
        }
        const isDom = !destCountry || destCountry.toLowerCase() === 'pk' || destCountry.toLowerCase().includes('pak');

        const cartAttributes = {
          'Delivery Country Code': isDom ? 'PK' : destCountry,
          'Delivery Destination': isDom ? 'Pakistan' : destCountry,
          'Scrub Units (Q)': comp.Q,
          'Chargeable Add-on Units (A)': comp.A,
          'Estimated Shipping (PKR)': shipResult.shippingFee,
          'Shipping Rate Calculation': shipResult.formulaText,
          'customized_order': isCustomizedCart ? 'true' : 'false',
          'payment_rule': isCustomizedCart ? 'advance_payment_only' : 'standard',
          'cod_eligible': isCustomizedCart ? 'false' : 'true',
          'Advance Payment Required': isCustomizedCart ? 'Yes (100% Advance Payment for Customized Garments)' : 'Standard Delivery Rules'
        };

        if (paymentIntent === 'bank_transfer') {
          cartAttributes['payment_intent'] = 'bank_transfer';
          cartAttributes['discount_code'] = 'BANK2';
          cartAttributes['eligible_bank_discount'] = '2% on Subtotal';
        } else {
          cartAttributes['payment_intent'] = 'standard';
        }

        await fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ attributes: cartAttributes })
        });

        if (paymentIntent === 'bank_transfer') {
          window.location.href = '/checkout?discount=BANK2';
        } else {
          window.location.href = '/checkout';
        }
      } catch (err) {
        console.error('Shopify checkout sync error:', err);
        window.location.href = '/checkout';
      } finally {
        if (checkoutBtn) {
          checkoutBtn.disabled = false;
          if (checkoutText) checkoutText.textContent = 'Proceed to Official Checkout';
        }
      }
    };

    window.submitBankOrder = async function() {
      withCartDebounce(async () => {
        const name = document.getElementById('bank-order-name')?.value;
        const phone = document.getElementById('bank-order-phone')?.value;
        const addr = document.getElementById('bank-order-address')?.value;

        if (!name || !phone || !addr) {
          alert('Please provide your Name, WhatsApp/Phone, and Delivery Address to receive your reference number.');
          return;
        }

        const refNumber = `ENM-2026-${Math.floor(10000 + Math.random() * 90000)}`;

        // Sync items to Shopify cart in background so checkout is populated
        try {
          const cart = getStoredCart();
          if (cart && cart.length) {
            await fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
            const fallbackVariantId = window.ShopifyLiveProducts?.[0]?.variants?.[0]?.id || null;
            const itemsPayload = cart.map(item => {
              const variantId = item.variantId || item.variant_id || fallbackVariantId;
              if (!variantId) return null;
              return {
                id: variantId,
                quantity: item.quantity || 1,
                properties: {
                  ...(item.properties || {}),
                  'Order Reference': refNumber,
                  'Customer Name': name,
                  'Customer Phone': phone
                }
              };
            }).filter(Boolean);
            if (itemsPayload.length) {
              await fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items: itemsPayload })
              });
            }
            let shippingAttrs = {};
            if (typeof window.calculateShippingCharges === 'function') {
              try {
                const destCountry = (typeof window.getActiveShippingCountry === 'function')
                  ? window.getActiveShippingCountry()
                  : (localStorage.getItem('enamels_delivery_country') || 'Pakistan');
                const isDom = !destCountry || destCountry.toLowerCase() === 'pk' || destCountry.toLowerCase().includes('pak');
                const subtotal = cart.reduce((sum, it) => sum + ((it.unitPrice || it.price || 0) * (it.quantity || 1)), 0);
                const comp = typeof window.analyzeCartComposition === 'function' ? window.analyzeCartComposition(cart) : { Q: cart.length, A: 0 };
                const shipResult = window.calculateShippingCharges(destCountry, subtotal, cart);
                shippingAttrs = {
                  'Delivery Country Code': isDom ? 'PK' : destCountry,
                  'Delivery Destination': isDom ? 'Pakistan' : destCountry,
                  'Scrub Units (Q)': comp.Q,
                  'Chargeable Add-on Units (A)': comp.A,
                  'Estimated Shipping (PKR)': shipResult.shippingFee,
                  'Shipping Rate Calculation': shipResult.formulaText
                };
              } catch (e) {}
            }

            await fetch('/cart/update.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                note: `Bank Transfer Order ${refNumber} - ${name} (${phone}) - Delivery: ${addr}`,
                attributes: {
                  'Enamels Reference': refNumber,
                  'Customer Name': name,
                  'Customer Phone': phone,
                  'Delivery Address': addr,
                  'Payment Method': 'Direct Bank Transfer (Meezan Bank)',
                  ...shippingAttrs
                }
              })
            });
          }
        } catch (e) {
          console.warn('Bank order cart sync:', e);
        }

        showOrderConfirmation(refNumber, 'Payment Pending Verification (Unpaid)', 'Direct Manual Bank Transfer (Meezan Bank)');
      });
    };

    window.submitCodOrder = async function() {
      withCartDebounce(async () => {
        const name = document.getElementById('cod-order-name')?.value;
        const phone = document.getElementById('cod-order-phone')?.value;
        const city = document.getElementById('cod-order-city')?.value;
        const addr = document.getElementById('cod-order-address')?.value;
        const notes = document.getElementById('cod-order-notes')?.value || '';

        if (!name || !phone || !addr || !city) {
          alert('Please enter your Full Name, Phone / WhatsApp, City, and Delivery Address for Cash on Delivery.');
          return;
        }

        const refNumber = `ENM-COD-${Math.floor(10000 + Math.random() * 90000)}`;

        try {
          const cart = getStoredCart();
          if (cart && cart.length) {
            await fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
            const fallbackVariantId = window.ShopifyLiveProducts?.[0]?.variants?.[0]?.id || null;
            const itemsPayload = cart.map(item => {
              const variantId = item.variantId || item.variant_id || fallbackVariantId;
              if (!variantId) return null;
              return {
                id: variantId,
                quantity: item.quantity || 1,
                properties: {
                  ...(item.properties || {}),
                  'Payment Method': 'Cash on Delivery (COD)',
                  'Order Reference': refNumber,
                  'Customer Name': name,
                  'Customer Phone': phone,
                  'Delivery City': city
                }
              };
            }).filter(Boolean);
            if (itemsPayload.length) {
              await fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items: itemsPayload })
              });
            }

            const subtotal = cart.reduce((sum, it) => sum + ((it.unitPrice || it.price || 0) * (it.quantity || 1)), 0);
            const comp = typeof window.analyzeCartComposition === 'function' ? window.analyzeCartComposition(cart) : { Q: cart.length, A: 0 };
            const shipResult = typeof window.calculateShippingCharges === 'function'
              ? window.calculateShippingCharges('Pakistan', subtotal, cart)
              : { shippingFee: subtotal > 7000 ? 0 : 250, formulaText: subtotal > 7000 ? 'Free Nationwide Delivery (Order > PKR 7,000)' : 'Standard Courier (PKR 250)' };

            await fetch('/cart/update.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                note: `COD Order ${refNumber} - ${name} (${phone}) - ${city} - Address: ${addr} ${notes ? '(' + notes + ')' : ''}`,
                attributes: {
                  'Enamels Reference': refNumber,
                  'Customer Name': name,
                  'Customer Phone': phone,
                  'Delivery City': city,
                  'Delivery Address': addr,
                  'Delivery Destination': 'Pakistan',
                  'Delivery Country Code': 'PK',
                  'Payment Method': 'Cash on Delivery (COD)',
                  'Payment Status': 'Pending Cash Collection on Delivery (Unpaid)',
                  'Scrub Units (Q)': comp.Q,
                  'Chargeable Add-on Units (A)': comp.A,
                  'Estimated Shipping (PKR)': shipResult.shippingFee,
                  'Shipping Rate Calculation': shipResult.formulaText
                }
              })
            });
          }
        } catch (e) {
          console.warn('COD order cart sync error:', e);
        }

        showOrderConfirmation(refNumber, 'Pending Cash Collection on Delivery (Unpaid)', 'Cash on Delivery (COD - TCS / Trax)');
      });
    };

    window.submitRepOrder = async function() {
      withCartDebounce(async () => {
        const name = document.getElementById('rep-order-name')?.value;
        const phone = document.getElementById('rep-order-phone')?.value;

        if (!name || !phone) {
          alert('Please enter your Name and WhatsApp contact number so our sizing concierge can assist you.');
          return;
        }

        const refNumber = `ENM-REQ-${Math.floor(10000 + Math.random() * 90000)}`;

        // Sync items to Shopify cart in background with concierge notes
        try {
          const cart = getStoredCart();
          if (cart && cart.length) {
            await fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
            const fallbackVariantId = window.ShopifyLiveProducts?.[0]?.variants?.[0]?.id || null;
            const itemsPayload = cart.map(item => {
              const variantId = item.variantId || item.variant_id || fallbackVariantId;
              if (!variantId) return null;
              return {
                id: variantId,
                quantity: item.quantity || 1,
                properties: {
                  ...(item.properties || {}),
                  'Concierge Reference': refNumber,
                  'Customer Name': name,
                  'Customer Phone': phone
                }
              };
            }).filter(Boolean);
            if (itemsPayload.length) {
              await fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items: itemsPayload })
              });
            }
            await fetch('/cart/update.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                note: `Representative Assisted Order ${refNumber} - ${name} (${phone})`,
                attributes: {
                  'Concierge Request': refNumber,
                  'Customer Name': name,
                  'Customer Phone': phone,
                  'Assisted Mode': 'Sizing Concierge'
                }
              })
            });
          }
        } catch (e) {
          console.warn('Rep order cart sync:', e);
        }

        showOrderConfirmation(refNumber, 'Concierge Sizing Request Received', 'Customer Representative Assisted Order');
      });
    };

    function showOrderConfirmation(refId, statusText, paymentMode) {
      const bankView = document.getElementById('checkout-view-bank');
      const repView = document.getElementById('checkout-view-rep');
      const confView = document.getElementById('checkout-view-confirmation');
      const refEl = document.getElementById('conf-reference-id');
      const statusEl = document.getElementById('conf-status-badge');
      const msgEl = document.getElementById('conf-message');

      if (bankView) bankView.style.display = 'none';
      if (repView) repView.style.display = 'none';
      if (confView) confView.style.display = 'block';

      if (refEl) refEl.textContent = `#${refId}`;
      if (statusEl) statusEl.textContent = `Status: ${statusText}`;
      if (msgEl) msgEl.textContent = `Your order via ${paymentMode} has been logged. Please share payment receipt on WhatsApp (+92 301 13 31 133).`;

      // Clear demo cart
      localStorage.removeItem('enamels_demo_cart');
      updateCartBadge();
    }


})();
</script>
