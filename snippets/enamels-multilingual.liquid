    function applyLanguage(langCode) {
      const data = translations[langCode] || translations.en;
      const html = document.documentElement;

      // Set lang and dir attributes
      html.setAttribute('lang', langCode);
      html.setAttribute('dir', data.dir);

      // Save to localStorage
      localStorage.setItem('enamels_selected_lang', langCode);

      // Update trigger label
      const label = document.getElementById('current-lang-label');
      if (label) label.textContent = data.label;

      // Update active option
      document.querySelectorAll('.lang-option-btn').forEach(btn => {
        const isMatch = btn.dataset.lang === langCode;
        btn.classList.toggle('active', isMatch);
        btn.setAttribute('aria-selected', isMatch);
      });

      // Update key UI elements if found on page
      const heroTitle = document.querySelector('.hero h2, .customizer-section-title');
      if (heroTitle && data.hero_title) heroTitle.textContent = data.hero_title;

      const heroSub = document.querySelector('.hero p');
      if (heroSub && data.hero_sub) heroSub.textContent = data.hero_sub;

      const seriesTitle = document.querySelector('.series-section-title');
      if (seriesTitle && data.series_heading) seriesTitle.textContent = data.series_heading;

      const seriesSub = document.querySelector('.series-section-subtitle');
      if (seriesSub && data.series_sub) seriesSub.textContent = data.series_sub;

      const colorTitle = document.querySelector('.colour-section-title');
      if (colorTitle && data.color_heading) colorTitle.textContent = data.color_heading;

      const wizardHead = document.querySelector('.wizard-heading');
      if (wizardHead && data.wizard_title) wizardHead.textContent = data.wizard_title;

      const wizardAddBtn = document.getElementById('wizard-submit-btn');
      if (wizardAddBtn && data.wizard_btn_add) wizardAddBtn.textContent = data.wizard_btn_add;

      // Toggle RTL CSS link if needed
      const rtlLink = document.getElementById('enamels-rtl-stylesheet');
      if (rtlLink) {
        rtlLink.disabled = (data.dir !== 'rtl');
      }
    }

    // Toggle menu
    const trigger = document.getElementById('enamels-lang-trigger');
    const menu = document.getElementById('enamels-lang-menu');

    if (trigger && menu) {
      trigger.addEventListener('click', function(e) {
        e.stopPropagation();
        const isOpen = menu.classList.toggle('open');
        trigger.setAttribute('aria-expanded', isOpen);
      });

      document.addEventListener('click', function(e) {
        if (!e.target.closest('#enamels-lang-root')) {
          menu.classList.remove('open');
          trigger.setAttribute('aria-expanded', 'false');
        }
      });

      document.querySelectorAll('.lang-option-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const selected = this.dataset.lang;
          applyLanguage(selected);
          menu.classList.remove('open');
          trigger.setAttribute('aria-expanded', 'false');
        });
      });
    }

    // Initialize from saved preference
    const savedLang = localStorage.getItem('enamels_selected_lang') || 'en';
    applyLanguage(savedLang);
  })();
</script>
