{% comment %}
  Enamels Multilingual Engine & Language Selector
  Supports 5 Languages: English, Urdu (اردو), Arabic (العربية), Pashto (پښتو), and Punjabi (پنجابی).
  Includes persistent locale state and automatic RTL/LTR direction switching.
{% endcomment %}

<div class="enamels-lang-widget" id="enamels-lang-root">
  <button type="button" class="enamels-lang-btn" id="enamels-lang-trigger" aria-expanded="false" aria-haspopup="listbox" title="Select Language">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span id="current-lang-label">English</span>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div class="enamels-lang-dropdown" id="enamels-lang-menu" role="listbox">
    <button type="button" class="lang-option-btn active" data-lang="en" data-dir="ltr" role="option" aria-selected="true">
      <span class="lang-flag">🇬🇧</span>
      <span class="lang-name">English</span>
      <span class="lang-native">(Default)</span>
    </button>
    <button type="button" class="lang-option-btn" data-lang="ur" data-dir="rtl" role="option" aria-selected="false">
      <span class="lang-flag">🇵🇰</span>
      <span class="lang-name">Urdu</span>
      <span class="lang-native">(اردو)</span>
    </button>
    <button type="button" class="lang-option-btn" data-lang="ar" data-dir="rtl" role="option" aria-selected="false">
      <span class="lang-flag">🇸🇦</span>
      <span class="lang-name">Arabic</span>
      <span class="lang-native">(العربية)</span>
    </button>
    <button type="button" class="lang-option-btn" data-lang="ps" data-dir="rtl" role="option" aria-selected="false">
      <span class="lang-flag">🇦🇫</span>
      <span class="lang-name">Pashto</span>
      <span class="lang-native">(پښتو)</span>
    </button>
    <button type="button" class="lang-option-btn" data-lang="pa" data-dir="rtl" role="option" aria-selected="false">
      <span class="lang-flag">🇵🇰</span>
      <span class="lang-name">Punjabi</span>
      <span class="lang-native">(پنجابی)</span>
    </button>
  </div>
</div>

<style>
  .enamels-lang-widget {
    position: relative;
    display: inline-block;
    z-index: 99;
  }

  .enamels-lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(16, 42, 67, 0.15);
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #102a43;
    cursor: pointer;
    transition: all 0.2s ease;
    backdrop-filter: blur(8px);
  }

  .enamels-lang-btn:hover {
    background: #ffffff;
    border-color: #00b8a9;
    box-shadow: 0 2px 8px rgba(0, 184, 169, 0.2);
  }

  @media screen and (max-width: 749px) {
    .enamels-lang-btn {
      padding: 4px 8px;
      font-size: 0.72rem;
      gap: 4px;
    }
  }

  .enamels-lang-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    width: 190px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    box-shadow: 0 10px 25px -5px rgba(16, 42, 67, 0.15);
    padding: 6px;
    display: none;
    flex-direction: column;
    gap: 2px;
  }

  [dir="rtl"] .enamels-lang-dropdown {
    right: auto;
    left: 0;
  }

  .enamels-lang-dropdown.open {
    display: flex;
  }

  .lang-option-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 8px 10px;
    border: none;
    background: transparent;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #334155;
    cursor: pointer;
    text-align: left;
    transition: background 0.15s ease;
  }

  [dir="rtl"] .lang-option-btn {
    text-align: right;
  }

  .lang-option-btn:hover {
    background: #f1f5f9;
    color: #102a43;
  }

  .lang-option-btn.active {
    background: #e6fffa;
    color: #00b8a9;
    font-weight: 700;
  }

  .lang-flag {
    font-size: 1rem;
  }

  .lang-native {
    margin-left: auto;
    font-size: 0.75rem;
    color: #64748b;
  }

  [dir="rtl"] .lang-native {
    margin-left: 0;
    margin-right: auto;
  }
</style>

