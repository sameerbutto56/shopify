{% comment %}
  Enamels Rebuilt 7-Step Bespoke Scrub Customization Workflow
  Sequence:
  1. Fabric Selection (Thumbnail cards with "Select & Next")
  2. Color & Contrast (Main color + Contrast (If Applicable) with "Select & Next")
  3. Design Selection (Collection-based dynamic system: Vilora, Crown, etc. with "Select & Next")
  4. Size & Fit (XS-2XL + Custom, Enamels standard size charts, auto-custom detection, "Select & Next")
  5. Personalization (Name engraving, logo, placement, thread, "Continue to Review")
  6. Review (Summary of all choices, transparent price breakdown, edit links)
  7. Payment & Order Submission (100% advance payment, Card 4% vs Online Transfer 2% discount, PK vs Intl shipping, No COD)
{% endcomment %}

{%- liquid
  # Dynamic Source Resolution
  assign target_design_col = nil
  if design_collection != blank
    assign target_design_col = collections[design_collection]
  endif
  if target_design_col == blank or target_design_col.products.size == 0
    if collections['basic-scrubs'] != blank and collections['basic-scrubs'].products.size > 0
      assign target_design_col = collections['basic-scrubs']
    elsif collections['scrubs'] != blank and collections['scrubs'].products.size > 0
      assign target_design_col = collections['scrubs']
    elsif collections['male-scrubs'] != blank and collections['male-scrubs'].products.size > 0
      assign target_design_col = collections['male-scrubs']
    else
      assign target_design_col = collections['all']
    endif
  endif

  # Dynamic Logo Collection
  assign target_logo_col = nil
  if logo_collection != blank
    assign target_logo_col = collections[logo_collection]
  endif
  if target_logo_col == blank or target_logo_col.products.size == 0
    if collections['logos'] != blank and collections['logos'].products.size > 0
      assign target_logo_col = collections['logos']
    elsif collections['hospital-logos'] != blank and collections['hospital-logos'].products.size > 0
      assign target_logo_col = collections['hospital-logos']
    elsif collections['crests'] != blank and collections['crests'].products.size > 0
      assign target_logo_col = collections['crests']
    endif
  endif

  # Dynamic Fabric Collection
  assign target_fabric_col = nil
  if fabric_collection != blank
    assign target_fabric_col = collections[fabric_collection]
  endif

  # Step Headings & Text (Editable in Shopify Studio / Theme Editor)
  assign step1_title = section.settings.step1_title | default: 'Select Technical Clinical Fabric'
  assign step1_subtitle = section.settings.step1_subtitle | default: 'Choose the medical-grade textile tailored for your shift duration and hospital environment.'
  assign step2_title = section.settings.step2_title | default: 'Select Scrub Color & Contrast'
  assign step2_subtitle = section.settings.step2_subtitle | default: 'Pick your approved medical scrub shade and optional contrast accents.'
  assign step3_title = section.settings.step3_title | default: 'Select Scrub Design Collection'
  assign step3_subtitle = section.settings.step3_subtitle | default: 'Select a scrub collection to view available bespoke styles and colors.'
  assign step4_title = section.settings.step4_title | default: 'Size & Fit Selection'
  assign step4_subtitle = section.settings.step4_subtitle | default: 'Choose your gender and desired fit silhouette. Altering any measurement value automatically customizes your tailored cut.'
  assign step4_notice = section.settings.step4_notice | default: 'Please select your size carefully. Your customized scrub will be manufactured according to the selected size and measurements.'
  assign step5_title = section.settings.step5_title | default: 'Doctor & Staff Personalization'
  assign step5_subtitle = section.settings.step5_subtitle | default: 'Add official computerized embroidery: Doctor Name, credentials, and hospital crest.'
  assign line1_label = section.settings.line1_label | default: 'Line 1: Doctor / Staff Name'
  assign line1_max = section.settings.line1_max | default: 45
  assign line2_label = section.settings.line2_label | default: 'Line 2: Title / Department / Hospital'
  assign line2_max = section.settings.line2_max | default: 45
  assign step6_title = section.settings.step6_title | default: 'Review Your Customized Scrub'
  assign step6_subtitle = section.settings.step6_subtitle | default: 'Verify every specification before proceeding directly to secure checkout.'
  assign checkout_btn_label = section.settings.checkout_btn_label | default: 'Proceed to Checkout →'
  assign checkout_notice = section.settings.checkout_notice | default: '100% advance payment required for bespoke personalized apparel. Select Card Payment or Online Bank Transfer (Direct IBAN / Raast) at Shopify Checkout.'
-%}

<div class="enamels-customizer-engine" id="enamels-customizer-app">
  
  <!-- 1. Continuous Red Payment Alert Marquee Banner -->
  <div class="enamels-payment-alert-marquee" role="alert" aria-live="polite">
    <div class="marquee-track">
      <span class="marquee-item">🚨 IMPORTANT: Customized Scrubs Require 100% Advance Payment. Cash on Delivery (COD) Is Not Available.</span>
      <span class="marquee-item">🚨 IMPORTANT: Customized Scrubs Require 100% Advance Payment. Cash on Delivery (COD) Is Not Available.</span>
      <span class="marquee-item">🚨 IMPORTANT: Customized Scrubs Require 100% Advance Payment. Cash on Delivery (COD) Is Not Available.</span>
    </div>
  </div>

  <!-- Stepper Progress Bar (Single Checkout 6-Step Flow) -->
  <div class="enamels-stepper-bar-wrap">
    <div class="enamels-stepper-bar" role="tablist">
      <button type="button" class="enamels-step-btn active" data-step="1" id="step-btn-1">
        <span class="step-circle">1</span>
        <span class="step-name">Fabric</span>
      </button>
      <button type="button" class="enamels-step-btn" data-step="2" id="step-btn-2">
        <span class="step-circle">2</span>
        <span class="step-name">Color & Contrast</span>
      </button>
      <button type="button" class="enamels-step-btn" data-step="3" id="step-btn-3">
        <span class="step-circle">3</span>
        <span class="step-name">Design</span>
      </button>
      <button type="button" class="enamels-step-btn" data-step="4" id="step-btn-4">
        <span class="step-circle">4</span>
        <span class="step-name">Size & Fit</span>
      </button>
      <button type="button" class="enamels-step-btn" data-step="5" id="step-btn-5">
        <span class="step-circle">5</span>
        <span class="step-name">Personalization</span>
      </button>
      <button type="button" class="enamels-step-btn" data-step="6" id="step-btn-6">
        <span class="step-circle">6</span>
        <span class="step-name">Review & Checkout</span>
      </button>
    </div>
  </div>

  <!-- Mobile Step Pill Indicator -->
  <div class="enamels-mobile-step-pill-indicator">
    <span>Step <strong id="enamels-mob-curr-num">1</strong> of 6:</span>
    <strong id="enamels-mob-curr-title" style="color: #008779;">Fabric Selection</strong>
  </div>

  <!-- Main Customizer Content Area -->
  <div class="enamels-customizer-main">
    
    <!-- =========================================================================
         STEP 1: FABRIC SELECTION
         ========================================================================= -->
    <div class="enamels-wizard-pane active" id="wizard-pane-1" data-step-index="1">
      <div class="enamels-pane-head">
        <span class="pane-eyebrow">Step 1 of 6</span>
        <h3 class="pane-title">{{ step1_title }}</h3>
        <p class="pane-subtitle">{{ step1_subtitle }}</p>
      </div>

      <div class="enamels-fabric-grid">
        <!-- Fabric 1: Crown -->
        <div class="enamels-fabric-card active" data-fabric-id="crown" data-fabric-name="Crown™ Technical Clinical Fabric" data-fabric-fee="0" onclick="window.enamelsSelectFabricAndNext('crown', 'Crown™ Technical Clinical Fabric', 0, this)" role="button" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();window.enamelsSelectFabricAndNext('crown', 'Crown™ Technical Clinical Fabric', 0, this);}" style="cursor: pointer;">
          <div class="fabric-card-media">
            <img src="{{ 'enamels-na-blue.jpg' | asset_url }}" alt="Crown Technical Fabric" width="320" height="220" loading="eager">
            <span class="fabric-badge">Crown Series</span>
          </div>
          <div class="fabric-card-body">
            <div class="fabric-header">
              <h4 class="fabric-title">Crown™ Clinical Fabric</h4>
              <span class="fabric-price">+PKR 0</span>
            </div>
            <p class="fabric-desc">Signature Crown blend: 74% Poly, 20% Rayon, 6% Spandex. Highly durable, fluid-repellent, wrinkle-free weave designed for intensive hospital shifts.</p>
            <div class="tech-tag-row">
              <span class="tech-tag">Crown Colors</span>
              <span class="tech-tag">4-Way Stretch</span>
              <span class="tech-tag">Fluid Repellent</span>
              <span class="tech-tag">Wrinkle-Free</span>
            </div>
          </div>
        </div>

        <!-- Fabric 2: Sprinter -->
        <div class="enamels-fabric-card" data-fabric-id="sprinter" data-fabric-name="Sprinter™ Active Performance Weave" data-fabric-fee="350" onclick="window.enamelsSelectFabricAndNext('sprinter', 'Sprinter™ Active Performance Weave', 350, this)" role="button" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();window.enamelsSelectFabricAndNext('sprinter', 'Sprinter™ Active Performance Weave', 350, this);}" style="cursor: pointer;">
          <div class="fabric-card-media">
            <img src="{{ 'banner-velora.jpg' | asset_url }}" alt="Sprinter Performance Fabric" width="320" height="220" loading="lazy">
            <span class="fabric-badge badge-pro">Sprinter Series</span>
          </div>
          <div class="fabric-card-body">
            <div class="fabric-header">
              <h4 class="fabric-title">Sprinter™ Active Weave</h4>
              <span class="fabric-price">+PKR 350</span>
            </div>
            <p class="fabric-desc">High-motion athletic clinical knit: 85% Micro-Poly, 15% Spandex. Ultra-breathable, moisture-wicking and flexible for fast-paced ER and surgical teams.</p>
            <div class="tech-tag-row">
              <span class="tech-tag">Sprinter Colors</span>
              <span class="tech-tag">Athletic Stretch</span>
              <span class="tech-tag">Moisture Wicking</span>
              <span class="tech-tag">Cooling</span>
            </div>
          </div>
        </div>

        <!-- Fabric 3: Tender -->
        <div class="enamels-fabric-card" data-fabric-id="tender" data-fabric-name="Tender™ Ultra-Soft Touch Microfiber" data-fabric-fee="450" onclick="window.enamelsSelectFabricAndNext('tender', 'Tender™ Ultra-Soft Touch Microfiber', 450, this)" role="button" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();window.enamelsSelectFabricAndNext('tender', 'Tender™ Ultra-Soft Touch Microfiber', 450, this);}" style="cursor: pointer;">
          <div class="fabric-card-media">
            <img src="{{ 'enamels-na-seagreen.jpg' | asset_url }}" alt="Tender Ultra-Soft Touch" width="320" height="220" loading="lazy">
            <span class="fabric-badge badge-vip">Tender Series</span>
          </div>
          <div class="fabric-card-body">
            <div class="fabric-header">
              <h4 class="fabric-title">Tender™ Ultra-Soft Touch</h4>
              <span class="fabric-price">+PKR 450</span>
            </div>
            <p class="fabric-desc">Butter-soft brushed microfiber: 70% Poly-Modal, 25% Rayon, 5% Lycra. Luxurious hand feel, gentle on sensitive skin during long 24-hour pediatric & clinical rounds.</p>
            <div class="tech-tag-row">
              <span class="tech-tag">Tender Colors</span>
              <span class="tech-tag">Butter-Soft</span>
              <span class="tech-tag">Hypoallergenic</span>
              <span class="tech-tag">Silky Drape</span>
            </div>
          </div>
        </div>

        <!-- Fabric 4: Flex Twill -->
        <div class="enamels-fabric-card" data-fabric-id="flex-twill" data-fabric-name="4-Way Flex Twill" data-fabric-fee="0" onclick="window.enamelsSelectFabricAndNext('flex-twill', '4-Way Flex Twill', 0, this)" role="button" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();window.enamelsSelectFabricAndNext('flex-twill', '4-Way Flex Twill', 0, this);}" style="cursor: pointer;">
          <div class="fabric-card-media">
            <img src="{{ 'enamels-na-blue.jpg' | asset_url }}" alt="4-Way Flex Twill" width="320" height="220" loading="lazy">
            <span class="fabric-badge">Standard Included</span>
          </div>
          <div class="fabric-card-body">
            <div class="fabric-header">
              <h4 class="fabric-title">4-Way Flex Twill</h4>
              <span class="fabric-price">+PKR 0</span>
            </div>
            <p class="fabric-desc">72% Polyester, 21% Rayon, 7% Spandex. Lightweight, wrinkle-free, breathable weave for dynamic clinical mobility.</p>
            <div class="tech-tag-row">
              <span class="tech-tag">Flex Colors</span>
              <span class="tech-tag">4-Way Stretch</span>
              <span class="tech-tag">Anti-Static</span>
              <span class="tech-tag">Breathable</span>
            </div>
          </div>
        </div>

        <!-- Fabric 5: Aerocool -->
        <div class="enamels-fabric-card" data-fabric-id="aerocool" data-fabric-name="Aerocool™ Micro-Drape" data-fabric-fee="500" onclick="window.enamelsSelectFabricAndNext('aerocool', 'Aerocool™ Micro-Drape', 500, this)" role="button" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();window.enamelsSelectFabricAndNext('aerocool', 'Aerocool™ Micro-Drape', 500, this);}" style="cursor: pointer;">
          <div class="fabric-card-media">
            <img src="{{ 'enamels-na-black.jpg' | asset_url }}" alt="Aerocool Micro-Drape" width="320" height="220" loading="lazy">
            <span class="fabric-badge badge-pro">ICU & ER Grade</span>
          </div>
          <div class="fabric-card-body">
            <div class="fabric-header">
              <h4 class="fabric-title">Aerocool™ Micro-Drape</h4>
              <span class="fabric-price">+PKR 500</span>
            </div>
            <p class="fabric-desc">88% Technical Micro-Poly, 12% Lycra with laser ventilation micropores. Antimicrobial fluid barrier, quick-dry performance.</p>
            <div class="tech-tag-row">
              <span class="tech-tag">Aerocool Colors</span>
              <span class="tech-tag">Anti-Microbial</span>
              <span class="tech-tag">Fluid Barrier</span>
              <span class="tech-tag">Fast-Drying</span>
            </div>
          </div>
        </div>

        <!-- Fabric 6: Executive -->
        <div class="enamels-fabric-card" data-fabric-id="executive" data-fabric-name="Executive Heavyweight Stretch" data-fabric-fee="750" onclick="window.enamelsSelectFabricAndNext('executive', 'Executive Heavyweight Stretch', 750, this)" role="button" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();window.enamelsSelectFabricAndNext('executive', 'Executive Heavyweight Stretch', 750, this);}" style="cursor: pointer;">
          <div class="fabric-card-media">
            <img src="{{ 'enamels-na-black.jpg' | asset_url }}" alt="Executive Heavyweight Stretch" width="320" height="220" loading="lazy">
            <span class="fabric-badge badge-vip">Consultant Edition</span>
          </div>
          <div class="fabric-card-body">
            <div class="fabric-header">
              <h4 class="fabric-title">Executive Heavyweight Stretch</h4>
              <span class="fabric-price">+PKR 750</span>
            </div>
            <p class="fabric-desc">65% Poly-Rayon, 30% Long-Staple Cotton, 5% Elastane. Holds an authoritative, sharp tailored drape through 24-hour rounds.</p>
            <div class="tech-tag-row">
              <span class="tech-tag">Executive Colors</span>
              <span class="tech-tag">Autoclave Safe</span>
              <span class="tech-tag">Fade-Resistant</span>
              <span class="tech-tag">Crisp Drape</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- =========================================================================
         STEP 2: COLOR & CONTRAST (COMBINED)
         ========================================================================= -->
    <div class="enamels-wizard-pane" id="wizard-pane-2" data-step-index="2">
      <div class="enamels-pane-head">
        <span class="pane-eyebrow">Step 2 of 6</span>
        <h3 class="pane-title">{{ step2_title }}</h3>
        <p class="pane-subtitle">{{ step2_subtitle }}</p>
      </div>

      <!-- Section A: Main Color -->
      <div class="color-selection-section">
        <div class="color-section-header">
          <div style="display: flex; align-items: center; gap: 8px;">
            <h4 class="sub-heading-title" style="margin: 0;">A. Main Color</h4>
            <span id="active-fabric-color-context" style="font-size: 11px; font-weight: 700; color: #008779; background: #e6fffa; border: 1px solid #99f6e4; padding: 2px 8px; border-radius: 999px;">Crown™ Colors</span>
          </div>
          <span class="selected-shade-pill">Selected: <strong id="active-main-color-label">Crown Ceil Blue</strong></span>
        </div>

        <div class="enamels-swatch-circles-grid" id="cust-swatch-circles-track" role="radiogroup" aria-label="Main Scrub Color">
          <button type="button" class="cust-swatch-circle active" data-color-name="Ceil Blue" data-color-hex="#6ba4b8" style="--swatch-bg: #6ba4b8;" title="Ceil Blue">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="cust-swatch-circle" data-color-name="Royal Navy" data-color-hex="#0f172a" style="--swatch-bg: #0f172a;" title="Royal Navy">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="cust-swatch-circle" data-color-name="Obsidian Black" data-color-hex="#18181b" style="--swatch-bg: #18181b;" title="Obsidian Black">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="cust-swatch-circle" data-color-name="Olive Green" data-color-hex="#3f4e3b" style="--swatch-bg: #3f4e3b;" title="Olive Green">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="cust-swatch-circle" data-color-name="Hunter Green" data-color-hex="#14532d" style="--swatch-bg: #14532d;" title="Hunter Green">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="cust-swatch-circle" data-color-name="Burgundy" data-color-hex="#581c87" style="--swatch-bg: #581c87;" title="Burgundy">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="cust-swatch-circle" data-color-name="Terracotta Rust" data-color-hex="#a0522d" style="--swatch-bg: #a0522d;" title="Terracotta Rust">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="cust-swatch-circle" data-color-name="Slate Grey" data-color-hex="#64748b" style="--swatch-bg: #64748b;" title="Slate Grey">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="cust-swatch-circle" data-color-name="Teal Blue" data-color-hex="#008779" style="--swatch-bg: #008779;" title="Teal Blue">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="cust-swatch-circle" data-color-name="Lilac Purple" data-color-hex="#9370db" style="--swatch-bg: #9370db;" title="Lilac Purple">
            <span class="swatch-check">✓</span>
          </button>
        </div>
      </div>

      <!-- Section B: Contrast (If Applicable) -->
      <div class="contrast-selection-section" style="margin-top: 32px; padding-top: 24px; border-top: 1px dashed #cbd5e1;">
        <div class="color-section-header">
          <h4 class="sub-heading-title">B. Contrast (If Applicable)</h4>
          <span class="selected-shade-pill">Contrast: <strong id="active-contrast-label">None / Monochrome</strong></span>
        </div>
        <p style="font-size: 12px; color: #64748b; margin: 4px 0 14px;">Select an optional contrast shade for neckline piping, pocket borders, or sleeve trim. (Leave as None for standard monochrome).</p>

        <div class="enamels-contrast-swatches-grid" role="radiogroup" aria-label="Contrast Color">
          <button type="button" class="contrast-swatch-circle active" data-contrast-name="None / Monochrome" data-contrast-hex="transparent" style="--swatch-bg: #ffffff; border: 2px dashed #94a3b8;" title="None">
            <span style="font-size: 11px; font-weight: 700; color: #64748b;">None</span>
          </button>
          <button type="button" class="contrast-swatch-circle" data-contrast-name="Contrast Pure White" data-contrast-hex="#ffffff" style="--swatch-bg: #ffffff;" title="White">
            <span class="swatch-check" style="color: #0f172a;">✓</span>
          </button>
          <button type="button" class="contrast-swatch-circle" data-contrast-name="Contrast Obsidian Black" data-contrast-hex="#18181b" style="--swatch-bg: #18181b;" title="Black">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="contrast-swatch-circle" data-contrast-name="Contrast Royal Navy" data-contrast-hex="#0f172a" style="--swatch-bg: #0f172a;" title="Navy">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="contrast-swatch-circle" data-contrast-name="Contrast Ceil Blue" data-contrast-hex="#6ba4b8" style="--swatch-bg: #6ba4b8;" title="Ceil Blue">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="contrast-swatch-circle" data-contrast-name="Contrast Medical Gold" data-contrast-hex="#d4af37" style="--swatch-bg: #d4af37;" title="Gold">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="contrast-swatch-circle" data-contrast-name="Contrast Enamels Teal" data-contrast-hex="#008779" style="--swatch-bg: #008779;" title="Teal">
            <span class="swatch-check">✓</span>
          </button>
        </div>
      </div>

      <!-- Action Button directly on this step -->
      <div class="wizard-nav-actions" style="margin-top: 32px; display: flex; justify-content: space-between; align-items: center;">
        <button type="button" class="btn-step-prev" onclick="window.enamelsGoStep(1)">← Back to Fabric</button>
        <button type="button" class="btn-select-next" style="width: auto; padding: 14px 32px;" onclick="window.enamelsSaveColorsAndNext()">
          Select & Next →
        </button>
      </div>
    </div>

    <!-- =========================================================================
         STEP 3: DESIGN SELECTION (COLLECTION-BASED SYSTEM)
         ========================================================================= -->
    <div class="enamels-wizard-pane" id="wizard-pane-3" data-step-index="3">
      <div class="enamels-pane-head">
        <span class="pane-eyebrow">Step 3 of 6</span>
        <h3 class="pane-title">{{ step3_title }}</h3>
        <p class="pane-subtitle">{{ step3_subtitle }}</p>
      </div>

      <!-- 3A. Dynamic Collection Category Selector -->
      <div class="design-collection-selector-wrap">
        <div class="collection-pills-row" id="design-collections-track">
          <button type="button" class="design-cat-pill active" data-col-handle="all" onclick="window.enamelsSwitchDesignCollection('all', 'All Clinical Scrubs')">
            <span class="pill-thumb" style="display:inline-flex; align-items:center; justify-content:center; background:#008779; color:#fff; border-radius:50%; width:32px; height:32px; font-size:14px;">🩺</span>
            <span>All Designs</span>
          </button>
          <button type="button" class="design-cat-pill" data-col-handle="male" onclick="window.enamelsSwitchDesignCollection('male', 'Male Medical Scrubs')">
            <span class="pill-thumb" style="display:inline-flex; align-items:center; justify-content:center; background:#0f172a; color:#fff; border-radius:50%; width:32px; height:32px; font-size:14px;">👨</span>
            <span>Male Scrubs</span>
          </button>
          <button type="button" class="design-cat-pill" data-col-handle="female" onclick="window.enamelsSwitchDesignCollection('female', 'Female Medical Scrubs')">
            <span class="pill-thumb" style="display:inline-flex; align-items:center; justify-content:center; background:#ec4899; color:#fff; border-radius:50%; width:32px; height:32px; font-size:14px;">👩</span>
            <span>Female Scrubs</span>
          </button>
          <button type="button" class="design-cat-pill" data-col-handle="crown" onclick="window.enamelsSwitchDesignCollection('crown', 'Crown™ Series')">
            <span class="pill-thumb" style="display:inline-flex; align-items:center; justify-content:center; background:#0284c7; color:#fff; border-radius:50%; width:32px; height:32px; font-size:14px;">👑</span>
            <span>Crown Series</span>
          </button>
          <button type="button" class="design-cat-pill" data-col-handle="velora" onclick="window.enamelsSwitchDesignCollection('velora', 'Velora™ Series')">
            <span class="pill-thumb" style="display:inline-flex; align-items:center; justify-content:center; background:#8b5cf6; color:#fff; border-radius:50%; width:32px; height:32px; font-size:14px;">★</span>
            <span>Velora Series</span>
          </button>
          <button type="button" class="design-cat-pill" data-col-handle="sprinter" onclick="window.enamelsSwitchDesignCollection('sprinter', 'Sprinter™ Series')">
            <span class="pill-thumb" style="display:inline-flex; align-items:center; justify-content:center; background:#059669; color:#fff; border-radius:50%; width:32px; height:32px; font-size:14px;">⚡</span>
            <span>Sprinter Series</span>
          </button>
          {%- if design_collections_list != blank -%}
            {%- for col in design_collections_list -%}
              <button type="button" class="design-cat-pill" data-col-handle="{{ col.handle }}" onclick="window.enamelsSwitchDesignCollection('{{ col.handle }}', '{{ col.title | escape }}')">
                {%- if col.featured_image != blank -%}
                  <img src="{{ col.featured_image | image_url: width: 72, height: 72, crop: 'center' }}" alt="{{ col.title | escape }}" class="pill-thumb" width="36" height="36">
                {%- else -%}
                  <span class="pill-thumb" style="display:inline-flex; align-items:center; justify-content:center; background:#e2e8f0; color:#102a43; border-radius:50%; width:32px; height:32px; font-size:12px;">★</span>
                {%- endif -%}
                <span>{{ col.title }}</span>
              </button>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <!-- 3B. Dynamic Designs Grid for the Selected Collection -->
      <div class="selected-collection-banner" style="margin: 20px 0 14px; font-size: 14px; color: #475569;">
        Showing Designs from: <strong id="active-collection-title-display" style="color: #102a43;">All Designs</strong>
      </div>

      <div class="enamels-designs-grid" id="customizer-designs-container">
        {%- if target_design_col != blank and target_design_col.products.size > 0 -%}
          {%- for prod in target_design_col.products -%}
            {%- liquid
              assign prod_t_lower = prod.title | downcase
              assign prod_series_tag = 'all'
              if prod_t_lower contains 'crown'
                assign prod_series_tag = 'crown'
              elsif prod_t_lower contains 'velora' or prod_t_lower contains 'vilora'
                assign prod_series_tag = 'velora'
              elsif prod_t_lower contains 'sprinter'
                assign prod_series_tag = 'sprinter'
              elsif prod_t_lower contains 'flexwell'
                assign prod_series_tag = 'flexwell'
              endif
              
              assign prod_gender = 'all'
              if prod_t_lower contains 'women' or prod_t_lower contains 'female' or prod_t_lower contains 'ladies'
                assign prod_gender = 'female'
              elsif prod_t_lower contains 'men' or prod_t_lower contains 'male'
                assign prod_gender = 'male'
              endif
              
              assign first_var = prod.selected_or_first_available_variant
              assign p_price_num = prod.price | divided_by: 100
              assign p_media_url = ''
              if prod.featured_media != blank
                assign p_media_url = prod.featured_media | image_url: width: 600
              endif

              # Extract Color Values for this product
              assign prod_colors_string = ''
              for opt in prod.options_with_values
                assign opt_l = opt.name | downcase
                if opt_l contains 'color' or opt_l contains 'colour'
                  assign prod_colors_string = opt.values | join: ','
                  break
                endif
              endfor
            -%}
            <div
              class="enamels-design-card{% if forloop.first %} active{% endif %}"
              data-design-id="{{ prod.id }}"
              data-variant-id="{{ first_var.id }}"
              data-design-name="{{ prod.title | escape }}"
              data-design-price="{{ p_price_num }}"
              data-design-img="{{ p_media_url }}"
              data-col="{{ prod_series_tag }}"
              data-gender="{{ prod_gender }}"
              data-colors="{{ prod_colors_string | escape }}"
              onclick="window.enamelsSelectDesignAndNext('{{ prod.id }}', '{{ first_var.id }}', '{{ prod.title | escape }}', {{ p_price_num }}, '{{ p_media_url }}', this)"
              role="button"
              tabindex="0"
              onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();window.enamelsSelectDesignAndNext('{{ prod.id }}', '{{ first_var.id }}', '{{ prod.title | escape }}', {{ p_price_num }}, '{{ p_media_url }}', this);}"
              style="cursor: pointer;"
            >
              <script type="application/json" class="design-variants-data">{{ prod.variants | json }}</script>
              <div class="design-card-media">
                {% if p_media_url != blank %}
                  <img src="{{ p_media_url }}" alt="{{ prod.title | escape }}" width="300" height="380" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
                {% else %}
                  <div style="width: 100%; height: 260px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-weight: 700;">🩺 ENAMELS</div>
                {% endif %}
              </div>
              <div class="design-card-body">
                <h4 class="design-card-title">{{ prod.title | escape }}</h4>
                <span class="design-card-sub">{{ prod.type | default: 'Medical Scrub Suit' }}</span>
                <span class="design-card-price">{{ prod.price | money_without_trailing_zeros }}</span>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div style="grid-column: 1 / -1; text-align: center; padding: 40px 20px;">
            <p style="color: #64748b;">No scrub products found in the selected collection.</p>
          </div>
        {%- endif -%}
      </div>

      <div class="wizard-nav-actions" style="margin-top: 24px;">
        <button type="button" class="btn-step-prev" onclick="window.enamelsGoStep(2)">← Back to Color & Contrast</button>
      </div>
    </div>

    <!-- =========================================================================
         STEP 4: SIZE & FIT (GENDER SELECTION, FEMALE 3-FIT SYSTEM, MEASUREMENTS)
         ========================================================================= -->
    <div class="enamels-wizard-pane" id="wizard-pane-4" data-step-index="4">
      <div class="enamels-pane-head">
        <span class="pane-eyebrow">Step 4 of 6</span>
        <h3 class="pane-title">{{ step4_title }}</h3>
        <p class="pane-subtitle">{{ step4_subtitle }}</p>
      </div>

      <!-- 1. Gender Selector -->
      <div class="form-group" style="margin-bottom: 18px;">
        <label class="form-label">A. Select Gender:</label>
        <div style="display: flex; gap: 12px;">
          <button type="button" class="gender-pill active" id="gender-pill-male" onclick="window.enamelsSetGender('male')">
            <span style="font-size: 16px;">👨</span> Male Scrubs
          </button>
          <button type="button" class="gender-pill" id="gender-pill-female" onclick="window.enamelsSetGender('female')">
            <span style="font-size: 16px;">👩</span> Female Scrubs
          </button>
        </div>
      </div>

      <!-- 2. Female 3-Fit Selector (Dynamic when Female is selected) -->
      <div id="female-fit-container" style="display: none; margin-bottom: 20px; background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 10px; padding: 16px;">
        <label class="form-label" style="margin-bottom: 8px;">B. Choose Female Fit Silhouette:</label>
        <div class="female-fit-grid">
          <button type="button" class="female-fit-card active" id="ffit-slim" onclick="window.enamelsSetFemaleFit('slim')">
            <strong style="display:block; font-size:13px; color:#102a43;">Slim Fit</strong>
            <span style="font-size:11px; color:#64748b;">Tailored waist & contoured silhouette</span>
          </button>
          <button type="button" class="female-fit-card" id="ffit-regular" onclick="window.enamelsSetFemaleFit('regular')">
            <strong style="display:block; font-size:13px; color:#102a43;">Regular Fit</strong>
            <span style="font-size:11px; color:#64748b;">Standard clinical comfort drape</span>
          </button>
          <button type="button" class="female-fit-card" id="ffit-loose" onclick="window.enamelsSetFemaleFit('loose')">
            <strong style="display:block; font-size:13px; color:#102a43;">Loose Fit</strong>
            <span style="font-size:11px; color:#64748b;">Modest, roomier cut for extra mobility</span>
          </button>
        </div>
      </div>

      <!-- 3. Mandatory Fit Notice Banner -->
      <div class="enamels-mandatory-fit-notice" style="background: #fffbeb; border: 1.5px solid #fde68a; border-radius: 8px; padding: 12px 16px; margin-bottom: 18px; display: flex; align-items: flex-start; gap: 10px;">
        <span style="font-size: 20px; line-height: 1;">⚠️</span>
        <span style="font-size: 13px; font-weight: 700; color: #92400e; line-height: 1.45;">
          {{ step4_notice }}
        </span>
      </div>

      <!-- 4. Size Selection Chips (Dynamic from Admin Configuration) -->
      <div class="size-chips-bar" id="wiz-size-chips-container" role="radiogroup" aria-label="Standard Sizes">
        <button type="button" class="size-chip-btn" data-size="S" onclick="window.enamelsSelectStandardSize('S')">Small (S)</button>
        <button type="button" class="size-chip-btn active" data-size="M" onclick="window.enamelsSelectStandardSize('M')">Medium (M)</button>
        <button type="button" class="size-chip-btn" data-size="L" onclick="window.enamelsSelectStandardSize('L')">Large (L)</button>
        <button type="button" class="size-chip-btn" data-size="XL" onclick="window.enamelsSelectStandardSize('XL')">XL</button>
        <button type="button" class="size-chip-btn" data-size="2XL" onclick="window.enamelsSelectStandardSize('2XL')">2XL</button>
        <button type="button" class="size-chip-btn size-chip-custom" data-size="Custom" id="size-chip-custom-btn" onclick="window.enamelsSelectCustomDirectly()">Custom Fit</button>
      </div>

      <!-- Measurements Container (Pre-populated from Dynamic Size Chart) -->
      <div class="custom-measurements-panel" id="measurements-container-step4">
        <div class="measurements-header">
          <div>
            <h4 class="measurements-title" id="m-chart-heading">Medium (M) Standard Measurements</h4>
            <p class="measurements-desc">Alter any measurement field to automatically customize your scrub fit.</p>
          </div>
          <div class="unit-toggle-group">
            <button type="button" class="unit-btn active" data-unit="in" onclick="window.enamelsSetUnit('in')">Inches (in)</button>
            <button type="button" class="unit-btn" data-unit="cm" onclick="window.enamelsSetUnit('cm')">Centimeters (cm)</button>
          </div>
        </div>

        <div class="auto-custom-alert" id="auto-custom-pill-alert" style="display: none;">
          ✨ Measurement changed! Selected size has automatically switched to <strong>Custom</strong>.
        </div>

        <!-- Dynamic Measurements Inputs Grid -->
        <div class="measurements-inputs-grid" id="wiz-measurements-grid">
          <!-- Populated dynamically by window.renderDynamicMeasurementInputs() -->
        </div>
      </div>

      <!-- Action Button directly on this step -->
      <div class="wizard-nav-actions" style="margin-top: 32px; display: flex; justify-content: space-between; align-items: center;">
        <button type="button" class="btn-step-prev" onclick="window.enamelsGoStep(3)">← Back to Design</button>
        <button type="button" class="btn-select-next" style="width: auto; padding: 14px 32px;" onclick="window.enamelsSaveSizeAndNext()">
          Select & Next →
        </button>
      </div>
    </div>

    <!-- =========================================================================
         STEP 5: PERSONALIZATION
         ========================================================================= -->
    <div class="enamels-wizard-pane" id="wizard-pane-5" data-step-index="5">
      <div class="enamels-pane-head">
        <span class="pane-eyebrow">Step 5 of 6</span>
        <h3 class="pane-title">{{ step5_title }}</h3>
        <p class="pane-subtitle">{{ step5_subtitle }}</p>
      </div>

      <div class="enamels-personalization-box">
        <!-- Placement Radio Group -->
        <div class="form-group">
          <label class="form-label">Name Embroidery Placement:</label>
          <div class="placement-options-grid">
            <label class="placement-pill active" onclick="window.enamelsSetPlacement('none', 0, this)">
              <input type="radio" name="wiz_emb_placement" value="none" checked>
              <span class="placement-text">None (No Embroidery)</span>
              <span class="placement-price">+PKR 0</span>
            </label>
            <label class="placement-pill" onclick="window.enamelsSetPlacement('left_chest', 500, this)">
              <input type="radio" name="wiz_emb_placement" value="left_chest">
              <span class="placement-text">Left Chest (Above Pocket)</span>
              <span class="placement-price">+PKR 500</span>
            </label>
            <label class="placement-pill" onclick="window.enamelsSetPlacement('right_chest', 500, this)">
              <input type="radio" name="wiz_emb_placement" value="right_chest">
              <span class="placement-text">Right Chest</span>
              <span class="placement-price">+PKR 500</span>
            </label>
            <label class="placement-pill" onclick="window.enamelsSetPlacement('sleeve', 400, this)">
              <input type="radio" name="wiz_emb_placement" value="sleeve">
              <span class="placement-text">Left Sleeve</span>
              <span class="placement-price">+PKR 400</span>
            </label>
            <label class="placement-pill" onclick="window.enamelsSetPlacement('both', 800, this)">
              <input type="radio" name="wiz_emb_placement" value="both">
              <span class="placement-text">Both Chest & Sleeve</span>
              <span class="placement-price">+PKR 800</span>
            </label>
          </div>
        </div>

        <!-- Name & Thread (Hidden when None) -->
        <div id="wiz-emb-fields-wrapper" style="display: none; margin-top: 24px;">
          <!-- Line 1: Compulsory -->
          <div class="form-group">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
              <label for="wiz-cust-name-1" class="form-label" style="margin: 0;">{{ line1_label }}:</label>
              <span style="font-size: 11px; font-weight: 700; color: #e11d48; background: #ffe4e6; padding: 2px 8px; border-radius: 4px;">* Compulsory</span>
            </div>
            <input type="text" id="wiz-cust-name-1" class="form-input" placeholder="e.g. Dr. Sarah Ahmed, MD" maxlength="{{ line1_max }}" oninput="window.enamelsUpdateEmbLines()">
            <span class="form-hint">Maximum {{ line1_max }} characters. Primary engraving line.</span>
          </div>

          <!-- Line 2: Optional -->
          <div class="form-group" style="margin-top: 14px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
              <label for="wiz-cust-name-2" class="form-label" style="margin: 0;">{{ line2_label }}:</label>
              <span style="font-size: 11px; font-weight: 600; color: #64748b; background: #f1f5f9; padding: 2px 8px; border-radius: 4px;">Optional</span>
            </div>
            <input type="text" id="wiz-cust-name-2" class="form-input" placeholder="e.g. Consultant Cardiologist" maxlength="{{ line2_max }}" oninput="window.enamelsUpdateEmbLines()">
            <span class="form-hint">Maximum {{ line2_max }} characters. Appears directly beneath Line 1.</span>
          </div>

          <!-- Extra Dynamic Lines Container -->
          <div id="wiz-extra-emb-lines-container" style="margin-top: 10px;"></div>

          <!-- Add Line Button (+) -->
          <div style="margin-top: 12px;">
            <button type="button" class="btn-add-emb-line" id="btn-add-emb-line" onclick="window.enamelsAddExtraEmbLine()" style="display: inline-flex; align-items: center; gap: 6px; background: #f8fafc; border: 1.5px dashed #008779; color: #008779; font-weight: 700; font-size: 12px; padding: 7px 14px; border-radius: 6px; cursor: pointer;">
              <span>➕ Add Additional Engraving Line (+PKR 250)</span>
            </button>
          </div>

          <div class="form-group" style="margin-top: 18px;">
            <label class="form-label">Thread Color:</label>
            <div class="thread-color-grid">
              <button type="button" class="thread-chip active" data-thread="Pure White" onclick="window.enamelsSetThread('Pure White', '#ffffff', this)">
                <span class="thread-dot" style="background: #ffffff; border: 1px solid #ccc;"></span> White
              </button>
              <button type="button" class="thread-chip" data-thread="Medical Gold" onclick="window.enamelsSetThread('Medical Gold', '#d4af37', this)">
                <span class="thread-dot" style="background: #d4af37;"></span> Gold
              </button>
              <button type="button" class="thread-chip" data-thread="Silver Grey" onclick="window.enamelsSetThread('Silver Grey', '#c0c0c0', this)">
                <span class="thread-dot" style="background: #c0c0c0;"></span> Silver
              </button>
              <button type="button" class="thread-chip" data-thread="Navy Blue" onclick="window.enamelsSetThread('Navy Blue', '#0f172a', this)">
                <span class="thread-dot" style="background: #0f172a;"></span> Navy
              </button>
              <button type="button" class="thread-chip" data-thread="Black" onclick="window.enamelsSetThread('Black', '#000000', this)">
                <span class="thread-dot" style="background: #000000;"></span> Black
              </button>
              <button type="button" class="thread-chip" data-thread="Enamels Teal" onclick="window.enamelsSetThread('Enamels Teal', '#008779', this)">
                <span class="thread-dot" style="background: #008779;"></span> Teal
              </button>
            </div>
          </div>

          <!-- Live Preview Canvas -->
          <div class="embroidery-preview-canvas" style="margin-top: 18px;">
            <div class="preview-badge">Live Pocket Embroidery Preview</div>
            <div class="scrub-pocket-mockup">
              <div class="pocket-stitch-line"></div>
              <div class="preview-embroidered-text" id="wiz-emb-live-text">DR. SARAH AHMED, MD</div>
              <div class="preview-embroidered-subtext" id="wiz-emb-live-subtext" style="font-size: 10px; opacity: 0.85; margin-top: 2px;"></div>
            </div>
          </div>
        </div>

        <!-- Custom Logo Option (Collection Logo or Custom File Upload) -->
        <div class="form-group" style="margin-top: 24px; padding-top: 20px; border-top: 1px solid #e2e8f0;">
          <label class="form-label">Hospital / Clinic Logo Embroidery:</label>
          <div class="logo-options-grid">
            <label class="logo-chip active" onclick="window.enamelsSetLogo('none', 0, this)">
              <input type="radio" name="wiz_logo_type" value="none" checked>
              <span>No Logo (+PKR 0)</span>
            </label>
            {%- if target_logo_col != blank and target_logo_col.products.size > 0 -%}
              {%- for logo_prod in target_logo_col.products -%}
                {%- assign logo_fee_num = logo_prod.price | divided_by: 100 -%}
                <label class="logo-chip" onclick="window.enamelsSetLogo('{{ logo_prod.handle }}', {{ logo_fee_num }}, this)">
                  <input type="radio" name="wiz_logo_type" value="{{ logo_prod.handle }}">
                  {%- if logo_prod.featured_media != blank -%}
                    <img src="{{ logo_prod.featured_media | image_url: width: 60 }}" alt="{{ logo_prod.title | escape }}" width="22" height="22" style="border-radius: 4px; object-fit: contain; vertical-align: middle; margin-right: 6px;">
                  {%- endif -%}
                  <span>{{ logo_prod.title | escape }} (+PKR {{ logo_fee_num }})</span>
                </label>
              {%- endfor -%}
            {%- else -%}
              <label class="logo-chip" onclick="window.enamelsSetLogo('crest', 450, this)">
                <input type="radio" name="wiz_logo_type" value="crest">
                <span>Official Hospital Crest (+PKR 450)</span>
              </label>
              <label class="logo-chip" onclick="window.enamelsSetLogo('patch', 550, this)">
                <input type="radio" name="wiz_logo_type" value="patch">
                <span>Silicone Logo Patch (+PKR 550)</span>
              </label>
            {%- endif -%}
            <!-- Upload Custom Logo File Option -->
            <label class="logo-chip" onclick="window.enamelsSetLogo('custom_upload', 550, this)">
              <input type="radio" name="wiz_logo_type" value="custom_upload">
              <span>📎 Upload Custom Logo (+PKR 550)</span>
            </label>
          </div>

          <!-- Custom Logo File Upload Box (Shown when custom_upload selected) -->
          <div id="wiz-logo-upload-box" style="display: none; margin-top: 14px; background: #f8fafc; border: 1.5px dashed #008779; border-radius: 8px; padding: 16px;">
            <div style="display: flex; align-items: flex-start; gap: 12px;">
              <span style="font-size: 24px;">📁</span>
              <div style="flex: 1;">
                <label for="wiz-logo-file-input" style="display: block; font-size: 13px; font-weight: 700; color: #102a43; margin-bottom: 4px;">
                  Select Logo File (PNG, JPG, SVG, PDF • Max 10MB):
                </label>
                <input
                  type="file"
                  id="wiz-logo-file-input"
                  accept=".png,.jpg,.jpeg,.svg,.pdf"
                  onchange="window.enamelsHandleLogoFileUpload(this)"
                  style="font-size: 12px; margin-top: 4px;"
                >
                <span class="form-hint">Accepted formats: High-res PNG, JPG, SVG, or vector PDF up to 10MB. File will be digitized for high-precision embroidery.</span>
                <div id="wiz-logo-file-preview-strip" style="display: none; margin-top: 10px; align-items: center; gap: 10px; background: #fff; padding: 8px 12px; border-radius: 6px; border: 1px solid #cbd5e1;">
                  <img id="wiz-logo-thumb-preview" src="" alt="Logo Preview" style="width: 36px; height: 36px; object-fit: contain; border-radius: 4px; display: none;">
                  <div style="font-size: 12px;">
                    <strong id="wiz-logo-file-name" style="color: #102a43; display: block;">logo.png</strong>
                    <span id="wiz-logo-file-size" style="color: #64748b; font-size: 11px;">1.2 MB • Attached successfully</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Button directly on this step -->
      <div class="wizard-nav-actions" style="margin-top: 32px; display: flex; justify-content: space-between; align-items: center;">
        <button type="button" class="btn-step-prev" onclick="window.enamelsGoStep(4)">← Back to Size & Fit</button>
        <button type="button" class="btn-select-next" style="width: auto; padding: 14px 32px;" onclick="window.enamelsSavePersonalizationAndNext()">
          Continue to Review →
        </button>
      </div>
    </div>

    <!-- =========================================================================
         STEP 6: REVIEW & DIRECT SHOPIFY CHECKOUT
         ========================================================================= -->
    <div class="enamels-wizard-pane" id="wizard-pane-6" data-step-index="6">
      <div class="enamels-pane-head">
        <span class="pane-eyebrow">Step 6 of 6</span>
        <h3 class="pane-title">{{ step6_title }}</h3>
        <p class="pane-subtitle">{{ step6_subtitle }}</p>
      </div>

      <div class="review-summary-card">
        <div class="review-card-top">
          <div class="review-article-preview">
            <img id="rev-design-thumb" src="{{ 'enamels-na-seagreen.jpg' | asset_url }}" alt="Design Preview" width="100" height="130">
            <div>
              <h4 id="rev-design-name" class="review-item-title">Vilora Luxury Micro-Drape V-Neck</h4>
              <span id="rev-col-name" class="review-item-sub">Collection: Vilora Collection</span>
              <div id="rev-design-base-price" style="font-size: 13px; font-weight: 700; color: #008779; margin-top: 4px;">Base Price: PKR 6,400</div>
            </div>
          </div>
          <button type="button" class="btn-edit-step" onclick="window.enamelsGoStep(3)">Edit Design ✎</button>
        </div>

        <div class="review-items-list">
          <!-- Fabric -->
          <div class="review-row">
            <div class="review-row-left">
              <span class="review-lbl">Fabric:</span>
              <strong id="rev-fabric-name">4-Way Flex Twill</strong>
            </div>
            <div class="review-row-right">
              <span id="rev-fabric-fee" class="review-fee">+PKR 0</span>
              <button type="button" class="btn-edit-step" onclick="window.enamelsGoStep(1)">Edit ✎</button>
            </div>
          </div>

          <!-- Color & Contrast -->
