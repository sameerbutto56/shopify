{% comment %}
  Enamels Rebuilt 7-Step Bespoke Scrub Customization Workflow
  Sequence:
  1. Fabric Selection (Thumbnail cards with "Select & Next")
  2. Color & Contrast (Main color + Contrast (If Applicable) with "Select & Next")
  3. Design Selection (Collection-based dynamic system: Vilora, Crown, etc. with "Select & Next")
  4. Size & Fit (XS-2XL + Custom, Enamels standard size charts, auto-custom detection, "Select & Next")
  5. Personalization (Name engraving, logo, placement, thread, "Continue to Review")
  6. Review (Summary of all choices, transparent price breakdown, edit links)
  7. Payment & Order Submission (100% advance payment, Card 4% vs Online Transfer 2% discount, PK vs Intl shipping, No COD)
{% endcomment %}

{%- liquid
  # Dynamic Source Resolution
  assign target_design_col = nil
  if design_collection != blank
    assign target_design_col = collections[design_collection]
  endif
  if target_design_col == blank or target_design_col.products.size == 0
    if collections['basic-scrubs'] != blank and collections['basic-scrubs'].products.size > 0
      assign target_design_col = collections['basic-scrubs']
    elsif collections['scrubs'] != blank and collections['scrubs'].products.size > 0
      assign target_design_col = collections['scrubs']
    elsif collections['male-scrubs'] != blank and collections['male-scrubs'].products.size > 0
      assign target_design_col = collections['male-scrubs']
    else
      assign target_design_col = collections['all']
    endif
  endif

  # Dynamic Logo Collection
  assign target_logo_col = nil
  if logo_collection != blank
    assign target_logo_col = collections[logo_collection]
  endif

  # Dynamic Fabric Collection
  assign target_fabric_col = nil
  if fabric_collection != blank
    assign target_fabric_col = collections[fabric_collection]
  endif
-%}

<div class="enamels-customizer-engine" id="enamels-customizer-app">
  
  <!-- 1. Continuous Red Payment Alert Marquee Banner -->
  <div class="enamels-payment-alert-marquee" role="alert" aria-live="polite">
    <div class="marquee-track">
      <span class="marquee-item">🚨 IMPORTANT: Customized Scrubs Require 100% Advance Payment. Cash on Delivery (COD) Is Not Available.</span>
      <span class="marquee-item">🚨 IMPORTANT: Customized Scrubs Require 100% Advance Payment. Cash on Delivery (COD) Is Not Available.</span>
      <span class="marquee-item">🚨 IMPORTANT: Customized Scrubs Require 100% Advance Payment. Cash on Delivery (COD) Is Not Available.</span>
    </div>
  </div>

  <!-- Stepper Progress Bar -->
  <div class="enamels-stepper-bar-wrap">
    <div class="enamels-stepper-bar" role="tablist">
      <button type="button" class="enamels-step-btn active" data-step="1" id="step-btn-1">
        <span class="step-circle">1</span>
        <span class="step-name">Fabric</span>
      </button>
      <button type="button" class="enamels-step-btn" data-step="2" id="step-btn-2">
        <span class="step-circle">2</span>
        <span class="step-name">Color & Contrast</span>
      </button>
      <button type="button" class="enamels-step-btn" data-step="3" id="step-btn-3">
        <span class="step-circle">3</span>
        <span class="step-name">Design</span>
      </button>
      <button type="button" class="enamels-step-btn" data-step="4" id="step-btn-4">
        <span class="step-circle">4</span>
        <span class="step-name">Size & Fit</span>
      </button>
      <button type="button" class="enamels-step-btn" data-step="5" id="step-btn-5">
        <span class="step-circle">5</span>
        <span class="step-name">Personalization</span>
      </button>
      <button type="button" class="enamels-step-btn" data-step="6" id="step-btn-6">
        <span class="step-circle">6</span>
        <span class="step-name">Review</span>
      </button>
      <button type="button" class="enamels-step-btn" data-step="7" id="step-btn-7">
        <span class="step-circle">7</span>
        <span class="step-name">Payment</span>
      </button>
    </div>
  </div>

  <!-- Mobile Step Pill Indicator -->
  <div class="enamels-mobile-step-pill-indicator">
    <span>Step <strong id="enamels-mob-curr-num">1</strong> of 7:</span>
    <strong id="enamels-mob-curr-title" style="color: #008779;">Fabric Selection</strong>
  </div>

  <!-- Main Customizer Content Area -->
  <div class="enamels-customizer-main">
    
    <!-- =========================================================================
         STEP 1: FABRIC SELECTION
         ========================================================================= -->
    <div class="enamels-wizard-pane active" id="wizard-pane-1" data-step-index="1">
      <div class="enamels-pane-head">
        <span class="pane-eyebrow">Step 1 of 7</span>
        <h3 class="pane-title">Select Technical Clinical Fabric</h3>
        <p class="pane-subtitle">Choose the medical-grade textile tailored for your shift duration and hospital environment.</p>
      </div>

      <div class="enamels-fabric-grid">
        <!-- Fabric 1 -->
        <div class="enamels-fabric-card active" data-fabric-id="flex-twill" data-fabric-name="4-Way Flex Twill" data-fabric-fee="0">
          <div class="fabric-card-media">
            <img src="{{ 'enamels-na-blue.jpg' | asset_url }}" alt="4-Way Flex Twill" width="320" height="220" loading="eager">
            <span class="fabric-badge">Standard Included</span>
          </div>
          <div class="fabric-card-body">
            <div class="fabric-header">
              <h4 class="fabric-title">4-Way Flex Twill</h4>
              <span class="fabric-price">+PKR 0</span>
            </div>
            <p class="fabric-desc">72% Polyester, 21% Rayon, 7% Spandex. Lightweight, wrinkle-free, breathable weave for dynamic clinical mobility.</p>
            <div class="tech-tag-row">
              <span class="tech-tag">4-Way Stretch</span>
              <span class="tech-tag">Wrinkle-Free</span>
              <span class="tech-tag">Anti-Static</span>
              <span class="tech-tag">Breathable</span>
            </div>
            <button type="button" class="btn-select-next" onclick="window.enamelsSelectFabricAndNext('flex-twill', '4-Way Flex Twill', 0, this)">
              Select & Next →
            </button>
          </div>
        </div>

        <!-- Fabric 2 -->
        <div class="enamels-fabric-card" data-fabric-id="aerocool" data-fabric-name="Aerocool™ Micro-Drape" data-fabric-fee="500">
          <div class="fabric-card-media">
            <img src="{{ 'banner-velora.jpg' | asset_url }}" alt="Aerocool Micro-Drape" width="320" height="220" loading="lazy">
            <span class="fabric-badge badge-pro">ICU & ER Grade</span>
          </div>
          <div class="fabric-card-body">
            <div class="fabric-header">
              <h4 class="fabric-title">Aerocool™ Micro-Drape</h4>
              <span class="fabric-price">+PKR 500</span>
            </div>
            <p class="fabric-desc">88% Technical Micro-Poly, 12% Lycra with laser ventilation micropores. Antimicrobial fluid barrier, quick-dry performance.</p>
            <div class="tech-tag-row">
              <span class="tech-tag">Ultra-Breathable</span>
              <span class="tech-tag">Anti-Microbial</span>
              <span class="tech-tag">Fluid Repellent</span>
              <span class="tech-tag">Fast-Drying</span>
            </div>
            <button type="button" class="btn-select-next" onclick="window.enamelsSelectFabricAndNext('aerocool', 'Aerocool™ Micro-Drape', 500, this)">
              Select & Next →
            </button>
          </div>
        </div>

        <!-- Fabric 3 -->
        <div class="enamels-fabric-card" data-fabric-id="executive" data-fabric-name="Executive Heavyweight Stretch" data-fabric-fee="750">
          <div class="fabric-card-media">
            <img src="{{ 'enamels-na-black.jpg' | asset_url }}" alt="Executive Heavyweight Stretch" width="320" height="220" loading="lazy">
            <span class="fabric-badge badge-vip">Consultant Edition</span>
          </div>
          <div class="fabric-card-body">
            <div class="fabric-header">
              <h4 class="fabric-title">Executive Heavyweight Stretch</h4>
              <span class="fabric-price">+PKR 750</span>
            </div>
            <p class="fabric-desc">65% Poly-Rayon, 30% Long-Staple Cotton, 5% Elastane. Holds an authoritative, sharp tailored drape through 24-hour rounds.</p>
            <div class="tech-tag-row">
              <span class="tech-tag">Autoclave Safe</span>
              <span class="tech-tag">Fade-Resistant</span>
              <span class="tech-tag">Crisp Drape</span>
              <span class="tech-tag">Fluid Barrier</span>
            </div>
            <button type="button" class="btn-select-next" onclick="window.enamelsSelectFabricAndNext('executive', 'Executive Heavyweight Stretch', 750, this)">
              Select & Next →
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- =========================================================================
         STEP 2: COLOR & CONTRAST (COMBINED)
         ========================================================================= -->
    <div class="enamels-wizard-pane" id="wizard-pane-2" data-step-index="2">
      <div class="enamels-pane-head">
        <span class="pane-eyebrow">Step 2 of 7</span>
        <h3 class="pane-title">Color & Contrast</h3>
        <p class="pane-subtitle">Select your base scrub shade, followed by optional contrast trim styling.</p>
      </div>

      <!-- Section A: Main Color -->
      <div class="color-selection-section">
        <div class="color-section-header">
          <h4 class="sub-heading-title">A. Main Color</h4>
          <span class="selected-shade-pill">Selected: <strong id="active-main-color-label">Ceil Blue</strong></span>
        </div>

        <div class="enamels-swatch-circles-grid" role="radiogroup" aria-label="Main Scrub Color">
          <button type="button" class="cust-swatch-circle active" data-color-name="Ceil Blue" data-color-hex="#6ba4b8" style="--swatch-bg: #6ba4b8;" title="Ceil Blue">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="cust-swatch-circle" data-color-name="Royal Navy" data-color-hex="#0f172a" style="--swatch-bg: #0f172a;" title="Royal Navy">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="cust-swatch-circle" data-color-name="Obsidian Black" data-color-hex="#18181b" style="--swatch-bg: #18181b;" title="Obsidian Black">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="cust-swatch-circle" data-color-name="Olive Green" data-color-hex="#3f4e3b" style="--swatch-bg: #3f4e3b;" title="Olive Green">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="cust-swatch-circle" data-color-name="Hunter Green" data-color-hex="#14532d" style="--swatch-bg: #14532d;" title="Hunter Green">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="cust-swatch-circle" data-color-name="Burgundy" data-color-hex="#581c87" style="--swatch-bg: #581c87;" title="Burgundy">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="cust-swatch-circle" data-color-name="Terracotta Rust" data-color-hex="#a0522d" style="--swatch-bg: #a0522d;" title="Terracotta Rust">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="cust-swatch-circle" data-color-name="Slate Grey" data-color-hex="#64748b" style="--swatch-bg: #64748b;" title="Slate Grey">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="cust-swatch-circle" data-color-name="Teal Blue" data-color-hex="#008779" style="--swatch-bg: #008779;" title="Teal Blue">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="cust-swatch-circle" data-color-name="Lilac Purple" data-color-hex="#9370db" style="--swatch-bg: #9370db;" title="Lilac Purple">
            <span class="swatch-check">✓</span>
          </button>
        </div>
      </div>

      <!-- Section B: Contrast (If Applicable) -->
      <div class="contrast-selection-section" style="margin-top: 32px; padding-top: 24px; border-top: 1px dashed #cbd5e1;">
        <div class="color-section-header">
          <h4 class="sub-heading-title">B. Contrast (If Applicable)</h4>
          <span class="selected-shade-pill">Contrast: <strong id="active-contrast-label">None / Monochrome</strong></span>
        </div>
        <p style="font-size: 12px; color: #64748b; margin: 4px 0 14px;">Select an optional contrast shade for neckline piping, pocket borders, or sleeve trim. (Leave as None for standard monochrome).</p>

        <div class="enamels-contrast-swatches-grid" role="radiogroup" aria-label="Contrast Color">
          <button type="button" class="contrast-swatch-circle active" data-contrast-name="None / Monochrome" data-contrast-hex="transparent" style="--swatch-bg: #ffffff; border: 2px dashed #94a3b8;" title="None">
            <span style="font-size: 11px; font-weight: 700; color: #64748b;">None</span>
          </button>
          <button type="button" class="contrast-swatch-circle" data-contrast-name="Contrast Pure White" data-contrast-hex="#ffffff" style="--swatch-bg: #ffffff;" title="White">
            <span class="swatch-check" style="color: #0f172a;">✓</span>
          </button>
          <button type="button" class="contrast-swatch-circle" data-contrast-name="Contrast Obsidian Black" data-contrast-hex="#18181b" style="--swatch-bg: #18181b;" title="Black">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="contrast-swatch-circle" data-contrast-name="Contrast Royal Navy" data-contrast-hex="#0f172a" style="--swatch-bg: #0f172a;" title="Navy">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="contrast-swatch-circle" data-contrast-name="Contrast Ceil Blue" data-contrast-hex="#6ba4b8" style="--swatch-bg: #6ba4b8;" title="Ceil Blue">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="contrast-swatch-circle" data-contrast-name="Contrast Medical Gold" data-contrast-hex="#d4af37" style="--swatch-bg: #d4af37;" title="Gold">
            <span class="swatch-check">✓</span>
          </button>
          <button type="button" class="contrast-swatch-circle" data-contrast-name="Contrast Enamels Teal" data-contrast-hex="#008779" style="--swatch-bg: #008779;" title="Teal">
            <span class="swatch-check">✓</span>
          </button>
        </div>
      </div>

      <!-- Action Button directly on this step -->
      <div style="margin-top: 32px; display: flex; justify-content: space-between; align-items: center;">
        <button type="button" class="btn-step-prev" onclick="window.enamelsGoStep(1)">← Back to Fabric</button>
        <button type="button" class="btn-select-next" style="width: auto; padding: 14px 32px;" onclick="window.enamelsSaveColorsAndNext()">
          Select & Next →
        </button>
      </div>
    </div>

    <!-- =========================================================================
         STEP 3: DESIGN SELECTION (COLLECTION-BASED SYSTEM)
         ========================================================================= -->
    <div class="enamels-wizard-pane" id="wizard-pane-3" data-step-index="3">
      <div class="enamels-pane-head">
        <span class="pane-eyebrow">Step 3 of 7</span>
        <h3 class="pane-title">Select Scrub Design Collection</h3>
        <p class="pane-subtitle">Browse collections dynamically from Shopify Admin. Click any collection to view its designs.</p>
      </div>

      <!-- 3A. Dynamic Collection Category Selector -->
      <div class="design-collection-selector-wrap">
        <div class="collection-pills-row" id="design-collections-track">
          <button type="button" class="design-cat-pill active" data-col-handle="all" onclick="window.enamelsSwitchDesignCollection('all', 'All Clinical Scrubs')">
            <span class="pill-thumb" style="display:inline-flex; align-items:center; justify-content:center; background:#008779; color:#fff; border-radius:50%; width:32px; height:32px; font-size:14px;">🩺</span>
            <span>All Designs</span>
          </button>
          {%- if design_collections_list != blank -%}
            {%- for col in design_collections_list -%}
              <button type="button" class="design-cat-pill" data-col-handle="{{ col.handle }}" onclick="window.enamelsSwitchDesignCollection('{{ col.handle }}', '{{ col.title | escape }}')">
                {%- if col.featured_image != blank -%}
                  <img src="{{ col.featured_image | image_url: width: 72, height: 72, crop: 'center' }}" alt="{{ col.title | escape }}" class="pill-thumb" width="36" height="36">
                {%- else -%}
                  <span class="pill-thumb" style="display:inline-flex; align-items:center; justify-content:center; background:#e2e8f0; color:#102a43; border-radius:50%; width:32px; height:32px; font-size:12px;">★</span>
                {%- endif -%}
                <span>{{ col.title }}</span>
              </button>
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} Discover article series from target_design_col.products {%- endcomment -%}
            {%- assign wiz_detected_series = '' -%}
            {%- for p in target_design_col.products -%}
              {%- assign p_t_lower = p.title | downcase -%}
              {%- for tag in p.tags -%}
                {%- assign tag_l = tag | downcase -%}
                {%- if tag_l contains 'series:' -%}
                  {%- assign s_val = tag | split: ':' | last | strip -%}
                  {%- unless wiz_detected_series contains s_val -%}
                    {%- assign wiz_detected_series = wiz_detected_series | append: s_val | append: '::' -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if p_t_lower contains 'crown' -%}{%- unless wiz_detected_series contains 'Crown' -%}{%- assign wiz_detected_series = wiz_detected_series | append: 'Crown::' -%}{%- endunless -%}{%- endif -%}
              {%- if p_t_lower contains 'velora' or p_t_lower contains 'vilora' -%}{%- unless wiz_detected_series contains 'Velora' -%}{%- assign wiz_detected_series = wiz_detected_series | append: 'Velora::' -%}{%- endunless -%}{%- endif -%}
              {%- if p_t_lower contains 'sprinter' -%}{%- unless wiz_detected_series contains 'Sprinter' -%}{%- assign wiz_detected_series = wiz_detected_series | append: 'Sprinter::' -%}{%- endunless -%}{%- endif -%}
              {%- if p_t_lower contains 'flexwell' -%}{%- unless wiz_detected_series contains 'Flexwell' -%}{%- assign wiz_detected_series = wiz_detected_series | append: 'Flexwell::' -%}{%- endunless -%}{%- endif -%}
            {%- endfor -%}
            {%- assign wiz_series_list = wiz_detected_series | split: '::' -%}
            {%- for s in wiz_series_list -%}
              {%- if s != blank -%}
                {%- assign s_clean = s | strip -%}
                {%- assign s_h = s_clean | downcase | replace: ' ', '-' -%}
                <button type="button" class="design-cat-pill" data-col-handle="{{ s_h }}" onclick="window.enamelsSwitchDesignCollection('{{ s_h }}', '{{ s_clean }} Series')">
                  <span class="pill-thumb" style="display:inline-flex; align-items:center; justify-content:center; background:#e0f2fe; color:#0369a1; border-radius:50%; width:32px; height:32px; font-weight:700; font-size:11px;">{{ s_clean | slice: 0, 2 | upcase }}</span>
                  <span>{{ s_clean }} Series</span>
                </button>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <!-- 3B. Dynamic Designs Grid for the Selected Collection -->
      <div class="selected-collection-banner" style="margin: 20px 0 14px; font-size: 14px; color: #475569;">
        Showing Designs from: <strong id="active-collection-title-display" style="color: #102a43;">All Designs</strong>
      </div>

      <div class="enamels-designs-grid" id="customizer-designs-container">
        {%- if target_design_col != blank and target_design_col.products.size > 0 -%}
          {%- for prod in target_design_col.products -%}
            {%- liquid
              assign prod_t_lower = prod.title | downcase
              assign prod_series_tag = 'all'
              if prod_t_lower contains 'crown'
                assign prod_series_tag = 'crown'
              elsif prod_t_lower contains 'velora' or prod_t_lower contains 'vilora'
                assign prod_series_tag = 'velora'
              elsif prod_t_lower contains 'sprinter'
                assign prod_series_tag = 'sprinter'
              elsif prod_t_lower contains 'flexwell'
                assign prod_series_tag = 'flexwell'
              endif
              
              assign first_var = prod.selected_or_first_available_variant
              assign p_price_num = prod.price | divided_by: 100
              assign p_media_url = ''
              if prod.featured_media != blank
                assign p_media_url = prod.featured_media | image_url: width: 600
              endif

              # Extract Color Values for this product
              assign prod_colors_string = ''
              for opt in prod.options_with_values
                assign opt_l = opt.name | downcase
                if opt_l contains 'color' or opt_l contains 'colour'
                  assign prod_colors_string = opt.values | join: ','
                  break
                endif
              endfor
            -%}
            <div
              class="enamels-design-card{% if forloop.first %} active{% endif %}"
              data-design-id="{{ prod.id }}"
              data-variant-id="{{ first_var.id }}"
              data-design-name="{{ prod.title | escape }}"
              data-design-price="{{ p_price_num }}"
              data-design-img="{{ p_media_url }}"
              data-col="{{ prod_series_tag }}"
              data-colors="{{ prod_colors_string | escape }}"
            >
              <div class="design-card-media">
                {% if p_media_url != blank %}
                  <img src="{{ p_media_url }}" alt="{{ prod.title | escape }}" width="300" height="380" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
                {% else %}
                  <div style="width: 100%; height: 260px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-weight: 700;">🩺 ENAMELS</div>
                {% endif %}
              </div>
              <div class="design-card-body">
                <h4 class="design-card-title">{{ prod.title | escape }}</h4>
                <span class="design-card-sub">{{ prod.type | default: 'Medical Scrub Suit' }}</span>
                <span class="design-card-price">{{ prod.price | money_without_trailing_zeros }}</span>
                <button
                  type="button"
                  class="btn-select-next"
                  onclick="window.enamelsSelectDesignAndNext('{{ prod.id }}', '{{ first_var.id }}', '{{ prod.title | escape }}', {{ p_price_num }}, '{{ p_media_url }}', this)"
                >
                  Select & Next →
                </button>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div style="grid-column: 1 / -1; text-align: center; padding: 40px 20px;">
            <p style="color: #64748b;">No scrub products found in the selected collection.</p>
          </div>
        {%- endif -%}
      </div>

      <div style="margin-top: 24px;">
        <button type="button" class="btn-step-prev" onclick="window.enamelsGoStep(2)">← Back to Color & Contrast</button>
      </div>
    </div>

    <!-- =========================================================================
         STEP 4: SIZE & FIT (STANDARD MEASUREMENTS & AUTO CUSTOM DETECTION)
         ========================================================================= -->
    <div class="enamels-wizard-pane" id="wizard-pane-4" data-step-index="4">
      <div class="enamels-pane-head">
        <span class="pane-eyebrow">Step 4 of 7</span>
        <h3 class="pane-title">Size & Fit Selection</h3>
        <p class="pane-subtitle">Choose your size. The official Enamels measurement chart populates below. Altering any value automatically customizes your fit.</p>
      </div>

      <!-- Size Selection Chips -->
      <div class="size-chips-bar" role="radiogroup" aria-label="Standard Sizes">
        <button type="button" class="size-chip-btn" data-size="XS" onclick="window.enamelsSelectStandardSize('XS')">XS</button>
        <button type="button" class="size-chip-btn" data-size="S" onclick="window.enamelsSelectStandardSize('S')">S</button>
        <button type="button" class="size-chip-btn active" data-size="M" onclick="window.enamelsSelectStandardSize('M')">M</button>
        <button type="button" class="size-chip-btn" data-size="L" onclick="window.enamelsSelectStandardSize('L')">L</button>
        <button type="button" class="size-chip-btn" data-size="XL" onclick="window.enamelsSelectStandardSize('XL')">XL</button>
