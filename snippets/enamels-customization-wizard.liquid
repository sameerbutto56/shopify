        pantHip: 42,
        pantInseam: 30.5,
        thigh: 24.5
      },
      // Step 5: Personalization
      personalization: {
        placement: 'none',
        line1: '',
        line2: '',
        extraLines: [],
        thread: 'Pure White',
        fee: 0,
        logoType: 'none',
        logoFee: 0,
        logoFileName: '',
        logoFileSize: '',
        logoFileData: ''
      },
      // Step 7: Payment & Delivery
      deliveryDest: 'pk', // 'pk' or 'intl'
      paymentMethod: 'card' // 'card' or 'bank_transfer'
    };

    function getActiveSizeChart() {
      if (state.gender === 'female') {
        if (state.femaleFit === 'slim') return ENAMELS_FEMALE_SLIM_CHART;
        if (state.femaleFit === 'loose') return ENAMELS_FEMALE_LOOSE_CHART;
        return ENAMELS_FEMALE_REGULAR_CHART;
      }
      return ENAMELS_MALE_SIZE_CHART;
    }

    // Safe financial calculations
    function calculateFinancials() {
      var base = state.design.basePrice || 6400;
      var fabricFee = state.fabric.fee || 0;
      var extraLinesCount = state.personalization.extraLines.length;
      var placementBaseFee = (state.personalization.placement !== 'none') ? (state.personalization.fee || 500) : 0;
      var extraLinesFee = extraLinesCount * 250;
      var logoFee = state.personalization.logoFee || 0;
      var embFee = placementBaseFee + extraLinesFee + logoFee;
      var productValue = base + fabricFee;

      // Delivery
      var deliveryFee = (state.deliveryDest === 'intl') ? 4000 : 250;

      // Card Bank Charges (4%) vs Online Transfer Discount (2% on product only)
      var cardFee = 0;
      var onlineDiscount = 0;

      if (state.paymentMethod === 'card') {
        cardFee = Math.round((productValue + embFee) * 0.04);
      } else if (state.paymentMethod === 'bank_transfer') {
        onlineDiscount = Math.round(productValue * 0.02);
      }

      var finalTotal = (productValue + embFee) - onlineDiscount + cardFee + deliveryFee;

      return {
        productValue: productValue,
        base: base,
        fabricFee: fabricFee,
        embFee: embFee,
        deliveryFee: deliveryFee,
        cardFee: cardFee,
        onlineDiscount: onlineDiscount,
        finalTotal: finalTotal
      };
    }

    function updateReviewAndPaymentUI() {
      var f = calculateFinancials();

      // Review UI updates
      var rThumb = document.getElementById('rev-design-thumb');
      var rName = document.getElementById('rev-design-name');
      var rCol = document.getElementById('rev-col-name');
      var rBaseP = document.getElementById('rev-design-base-price');
      if (rThumb && state.design.img) rThumb.src = state.design.img;
      if (rName) rName.textContent = state.design.name;
      if (rCol) rCol.textContent = 'Collection: ' + state.collection.title;
      if (rBaseP) rBaseP.textContent = 'Base Price: PKR ' + state.design.basePrice.toLocaleString();

      var rFabName = document.getElementById('rev-fabric-name');
      var rFabFee = document.getElementById('rev-fabric-fee');
      if (rFabName) rFabName.textContent = state.fabric.name;
      if (rFabFee) rFabFee.textContent = state.fabric.fee > 0 ? '+PKR ' + state.fabric.fee.toLocaleString() : '+PKR 0';

      var rColName = document.getElementById('rev-color-name');
      var rColDot = document.getElementById('rev-color-dot');
      var rConBadge = document.getElementById('rev-contrast-badge');
      if (rColName) rColName.textContent = state.color.name;
      if (rColDot) rColDot.style.backgroundColor = state.color.hex;
      if (rConBadge) {
        rConBadge.textContent = state.contrast.name.indexOf('None') !== -1 ? '(Contrast: None)' : '(Contrast: ' + state.contrast.name + ')';
      }

      var rSize = document.getElementById('rev-size-name');
      var rMText = document.getElementById('rev-measurements-text');
      if (rSize) {
        var targetFit = getActiveFitTarget();
        rSize.textContent = (state.isCustomSize ? 'Custom Tailored Fit' : 'Size ' + state.size) + ' (' + targetFit.title + ')';
      }
      if (rMText) {
        var m = state.measurements;
        var u = state.unit;
        var cfg = getActiveSizeFitConfig();
        var fList = cfg.fields || DEFAULT_ENAMELS_SIZE_FIT_CONFIG.fields;
        var mStrings = [];
        fList.forEach(function(f) {
          if (m[f.key] !== undefined) {
            var val = m[f.key];
            if (u === 'cm' && typeof val === 'number') {
              val = Math.round(val * 2.54 * 10) / 10;
            }
            mStrings.push(f.label + ': ' + val + u);
          }
        });
        rMText.textContent = mStrings.join(', ');
      }

      var rEmbName = document.getElementById('rev-emb-name');
      var rEmbFee = document.getElementById('rev-emb-fee');
      if (rEmbName) {
        var embParts = [];
        if (state.personalization.placement !== 'none' && state.personalization.line1) {
          var allLines = [state.personalization.line1];
          if (state.personalization.line2) allLines.push(state.personalization.line2);
          if (state.personalization.extraLines.length > 0) {
            allLines = allLines.concat(state.personalization.extraLines);
          }
          embParts.push('Engraving: "' + allLines.join(' | ') + '" (' + state.personalization.placement + ', ' + state.personalization.thread + ')');
        }
        if (state.personalization.logoType !== 'none') {
          if (state.personalization.logoType === 'custom_upload') {
            embParts.push('Custom Logo Uploaded: ' + (state.personalization.logoFileName || 'File attached'));
          } else {
            embParts.push(state.personalization.logoType === 'crest' ? 'Hospital Crest Emblem' : 'Silicone Logo Patch');
          }
        }
        rEmbName.textContent = embParts.length > 0 ? embParts.join(' • ') : 'None';
      }
      if (rEmbFee) rEmbFee.textContent = f.embFee > 0 ? '+PKR ' + f.embFee.toLocaleString() : '+PKR 0';

      var rSub = document.getElementById('rev-pbreak-subtotal');
      var rBase = document.getElementById('rev-pbreak-base');
      var rFabP = document.getElementById('rev-pbreak-fabric');
      var rEmbP = document.getElementById('rev-pbreak-emb');
      if (rSub) rSub.textContent = 'PKR ' + (f.productValue + f.embFee).toLocaleString();
      if (rBase) rBase.textContent = 'PKR ' + f.base.toLocaleString();
      if (rFabP) rFabP.textContent = f.fabricFee > 0 ? '+PKR ' + f.fabricFee.toLocaleString() : '+PKR 0';
      if (rEmbP) rEmbP.textContent = f.embFee > 0 ? '+PKR ' + f.embFee.toLocaleString() : '+PKR 0';

      // Step 7: Final Calculations UI
      var cBase = document.getElementById('calc-base-val');
      var cFab = document.getElementById('calc-fabric-val');
      var cEmb = document.getElementById('calc-emb-val');
      var cDiscRow = document.getElementById('calc-discount-row');
      var cDiscVal = document.getElementById('calc-discount-val');
      var cCardRow = document.getElementById('calc-card-fee-row');
      var cCardVal = document.getElementById('calc-card-fee-val');
      var cDel = document.getElementById('calc-delivery-val');
      var cTotal = document.getElementById('calc-final-total');
      var btnTotal = document.getElementById('btn-final-price-display');

      if (cBase) cBase.textContent = 'PKR ' + f.base.toLocaleString();
      if (cFab) cFab.textContent = f.fabricFee > 0 ? '+PKR ' + f.fabricFee.toLocaleString() : '+PKR 0';
      if (cEmb) cEmb.textContent = f.embFee > 0 ? '+PKR ' + f.embFee.toLocaleString() : '+PKR 0';

      if (state.paymentMethod === 'bank_transfer') {
        if (cDiscRow) cDiscRow.style.display = 'flex';
        if (cDiscVal) cDiscVal.textContent = '-PKR ' + f.onlineDiscount.toLocaleString();
        if (cCardRow) cCardRow.style.display = 'none';
      } else {
        if (cDiscRow) cDiscRow.style.display = 'none';
        if (cCardRow) cCardRow.style.display = 'flex';
        if (cCardVal) cCardVal.textContent = '+PKR ' + f.cardFee.toLocaleString();
      }

      if (cDel) cDel.textContent = '+PKR ' + f.deliveryFee.toLocaleString() + (state.deliveryDest === 'intl' ? ' (Intl)' : ' (PK Flat)');
      if (cTotal) cTotal.textContent = 'PKR ' + f.finalTotal.toLocaleString();
      if (btnTotal) btnTotal.textContent = 'PKR ' + f.finalTotal.toLocaleString();
    }

    // Step Navigation
    var STEP_TITLES = {
      1: 'Fabric Selection',
      2: 'Color & Contrast',
      3: 'Design Selection',
      4: 'Size & Fit',
      5: 'Personalization',
      6: 'Review & Checkout'
    };

    window.enamelsGoStep = function(stepNum) {
      if (stepNum < 1) stepNum = 1;
      if (stepNum > 6) stepNum = 6;
      state.currentStep = stepNum;

      var panes = document.querySelectorAll('.enamels-wizard-pane');
      panes.forEach(function(p) {
        p.classList.remove('active');
        if (p.getAttribute('data-step-index') == stepNum) {
          p.classList.add('active');
        }
      });

      var stepBtns = document.querySelectorAll('.enamels-step-btn');
      stepBtns.forEach(function(btn) {
        var b = parseInt(btn.getAttribute('data-step'), 10);
        btn.classList.remove('active', 'completed');
        if (b === stepNum) {
          btn.classList.add('active');
          if (typeof btn.scrollIntoView === 'function') {
            btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          }
        } else if (b < stepNum) {
          btn.classList.add('completed');
        }
      });

      // Update mobile step indicator
      var mobNum = document.getElementById('enamels-mob-curr-num');
      var mobTitle = document.getElementById('enamels-mob-curr-title');
      if (mobNum) mobNum.textContent = stepNum;
      if (mobTitle) mobTitle.textContent = STEP_TITLES[stepNum] || '';

      updateReviewAndPaymentUI();

      var modalBody = document.querySelector('.enamels-customizer-modal-body');
      if (modalBody) {
        modalBody.scrollTop = 0;
      }

      var root = document.getElementById('enamels-customizer-app');
      if (root && typeof root.scrollIntoView === 'function') {
        try { root.scrollIntoView({ behavior: 'smooth', block: 'start' }); } catch(e) {}
      }
    };

    // 1. Dynamic Fabric-Based Color Swatches Renderer
    function renderFabricColors(fabricId) {
      var colors = FABRIC_COLORS[fabricId] || FABRIC_COLORS['crown'];
      var track = document.getElementById('cust-swatch-circles-track');
      var contextBadge = document.getElementById('active-fabric-color-context');
      var colorLabel = document.getElementById('active-main-color-label');

      if (contextBadge) {
        var fLabel = state.fabric.name.split(' ')[0] || 'Crown';
        contextBadge.textContent = fLabel + ' Colors Only';
      }

      if (track) {
        track.innerHTML = '';
        colors.forEach(function(c, idx) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'cust-swatch-circle' + (idx === 0 ? ' active' : '');
          btn.setAttribute('data-color-name', c.name);
          btn.setAttribute('data-color-hex', c.hex);
          btn.style.setProperty('--swatch-bg', c.hex);
          btn.title = c.name;
          btn.innerHTML = '<span class="swatch-check">✓</span>';

          btn.addEventListener('click', function() {
            var allSwatches = track.querySelectorAll('.cust-swatch-circle');
            allSwatches.forEach(function(s) { s.classList.remove('active'); });
            btn.classList.add('active');
            state.color.name = c.name;
            state.color.hex = c.hex;
            if (colorLabel) colorLabel.textContent = c.name;
            updateReviewAndPaymentUI();
          });

          track.appendChild(btn);
        });

        // Pre-select first color belonging to the selected fabric
        if (colors.length > 0) {
          state.color.name = colors[0].name;
          state.color.hex = colors[0].hex;
          if (colorLabel) colorLabel.textContent = colors[0].name;
        }
      }
    }

    // 1. Fabric Selection & Next
    window.enamelsSelectFabricAndNext = function(fabricId, fabricName, fee, btnEl) {
      state.fabric.id = fabricId;
      state.fabric.name = fabricName;
      state.fabric.fee = fee || 0;

      var cards = document.querySelectorAll('.enamels-fabric-card');
      cards.forEach(function(c) {
        c.classList.remove('active');
        if (c.getAttribute('data-fabric-id') === fabricId) c.classList.add('active');
      });

      renderFabricColors(fabricId);
      window.enamelsGoStep(2);
    };

    // 2. Color & Contrast Selection
    window.enamelsSaveColorsAndNext = function() {
      if (!state.color.name) {
        alert('Please choose a garment color.');
        return;
      }
      window.enamelsGoStep(3);
    };

    // 3. Design Selection (Collection-driven)
    window.enamelsSwitchDesignCollection = function(colHandle, colTitle) {
      state.collection.handle = colHandle;
      state.collection.title = colTitle;

      var pills = document.querySelectorAll('.design-cat-pill');
      pills.forEach(function(p) {
        p.classList.remove('active');
        if (p.getAttribute('data-col-handle') === colHandle) p.classList.add('active');
      });

      var labelEl = document.getElementById('active-collection-title-display');
      if (labelEl) labelEl.textContent = colTitle;

      // Filter design cards by collection or category
      var cards = document.querySelectorAll('.enamels-design-card');
      cards.forEach(function(c) {
        var cardCol = c.getAttribute('data-col');
        var cardGender = c.getAttribute('data-gender') || 'all';
        if (colHandle === 'all') {
          c.style.display = 'flex';
        } else if (colHandle === 'male' || colHandle === 'female') {
          c.style.display = (cardGender === colHandle || cardGender === 'all') ? 'flex' : 'none';
        } else if (cardCol === colHandle) {
          c.style.display = 'flex';
        } else {
          c.style.display = 'none';
        }
      });
    };

    window.enamelsSelectDesignAndNext = function(designId, variantId, designName, price, imgUrl, btnEl) {
      if (typeof variantId === 'string' && isNaN(parseInt(variantId, 10)) && typeof designName === 'number') {
        btnEl = imgUrl;
        imgUrl = price;
        price = designName;
        designName = variantId;
        variantId = null;
      }

      state.design.id = designId;
      state.design.variantId = variantId;
      state.design.name = designName;
      state.design.basePrice = price || 6400;
      state.design.img = imgUrl || '';

      var cards = document.querySelectorAll('.enamels-design-card');
      cards.forEach(function(c) {
        c.classList.remove('active');
        if (c.getAttribute('data-design-id') === String(designId)) {
          c.classList.add('active');
          if (!state.design.variantId && c.getAttribute('data-variant-id')) {
            state.design.variantId = c.getAttribute('data-variant-id');
          }
          try {
            var varScript = c.querySelector('.design-variants-data');
            if (varScript) {
              state.design.variants = JSON.parse(varScript.textContent);
            }
          } catch(e) {}
        }
      });

      window.enamelsGoStep(4);
    };

    // =========================================================================
    // DYNAMIC SIZE & MEASUREMENTS DOM RENDERERS (OPTIMIZED INSTANT UI)
    // =========================================================================
    window.renderDynamicSizeChips = function() {
      var container = document.getElementById('wiz-size-chips-container');
      if (!container) return;
      var target = getActiveFitTarget();
      var sizes = target.sizes || ['S', 'M', 'L', 'XL', '2XL'];

      if (!state.isCustomSize && sizes.indexOf(state.size) === -1) {
        state.size = sizes[0] || 'M';
      }

      // Fast path: toggle active classes without tearing down DOM
      var existingBtns = container.querySelectorAll('.size-chip-btn');
      if (existingBtns.length > 0) {
        existingBtns.forEach(function(btn) {
          var s = btn.getAttribute('data-size');
          var isActive = (!state.isCustomSize && s === state.size) || (state.isCustomSize && s === 'Custom');
          btn.classList.toggle('active', isActive);
        });
        return;
      }

      var html = '';
      sizes.forEach(function(s) {
        var isActive = (!state.isCustomSize && state.size === s);
        html += '<button type="button" class="size-chip-btn' + (isActive ? ' active' : '') + '" data-size="' + s + '" onclick="window.enamelsSelectStandardSize(\'' + s + '\')">' + s + '</button>';
      });

      var isCustomActive = state.isCustomSize;
      html += '<button type="button" class="size-chip-btn size-chip-custom' + (isCustomActive ? ' active' : '') + '" data-size="Custom" id="size-chip-custom-btn" onclick="window.enamelsSelectCustomDirectly()">Custom Fit</button>';

      container.innerHTML = html;
    };

    window.renderDynamicMeasurementInputs = function() {
      var grid = document.getElementById('wiz-measurements-grid');
      if (!grid) return;
      var cfg = getActiveSizeFitConfig();
      var fields = cfg.fields || DEFAULT_ENAMELS_SIZE_FIT_CONFIG.fields;
      var target = getActiveFitTarget();
      var chart = (target && target.chart) ? target.chart : {};
      var sizeData = chart[state.size] || {};

      var heading = document.getElementById('m-chart-heading');
      if (heading) {
        if (state.isCustomSize) {
          heading.textContent = 'Custom Bespoke Measurements (' + target.title + ')';
        } else {
          heading.textContent = state.size + ' Standard Measurements (' + target.title + ')';
        }
      }

      // Fast path: update input values in-place without destroying DOM elements
      var existingInputs = grid.querySelectorAll('.m-input');
      if (existingInputs.length > 0) {
        fields.forEach(function(f) {
          var val = state.measurements[f.key];
          if (val === undefined || (!state.isCustomSize && sizeData[f.key] !== undefined)) {
            val = sizeData[f.key];
            state.measurements[f.key] = val;
          }
          if (val === undefined) val = '';
          var unitLbl = state.unit === 'cm' ? '(cm)' : '(in)';
          var displayVal = val;
          if (state.unit === 'cm' && typeof val === 'number') {
            displayVal = Math.round(val * 2.54 * 10) / 10;
          }
          var input = document.getElementById('wiz_m_' + f.key);
          if (input) input.value = displayVal;
          var unitSpan = input ? input.closest('.measurement-field').querySelector('.m-unit-lbl') : null;
          if (unitSpan) unitSpan.textContent = unitLbl;
        });
        return;
      }

      var html = '';
      fields.forEach(function(f) {
        var val = state.measurements[f.key];
        if (val === undefined || (!state.isCustomSize && sizeData[f.key] !== undefined)) {
          val = sizeData[f.key];
          state.measurements[f.key] = val;
        }
        if (val === undefined) val = '';

        var unitLbl = state.unit === 'cm' ? '(cm)' : '(in)';
        var displayVal = val;
        if (state.unit === 'cm' && typeof val === 'number') {
          displayVal = Math.round(val * 2.54 * 10) / 10;
        }

        html += '<div class="measurement-field">' +
          '<label class="m-label">' + f.label + ' <span class="m-unit-lbl">' + unitLbl + '</span></label>' +
          '<input type="number" step="0.5" id="wiz_m_' + f.key + '" class="m-input" value="' + displayVal + '" oninput="window.enamelsHandleMeasurementInput(\'' + f.key + '\', this.value)">' +
          '<span class="m-hint">' + (f.hint || '') + '</span>' +
        '</div>';
      });

      grid.innerHTML = html;
    };

    // 4. Gender Selection Handler
    window.enamelsSetGender = function(genderKey) {
      state.gender = genderKey;
      var btnM = document.getElementById('gender-pill-male');
      var btnF = document.getElementById('gender-pill-female');
      var femaleContainer = document.getElementById('female-fit-container');

      if (genderKey === 'female') {
        if (btnM) btnM.classList.remove('active');
        if (btnF) btnF.classList.add('active');
        if (femaleContainer) femaleContainer.style.display = 'block';
      } else {
        if (btnM) btnM.classList.add('active');
        if (btnF) btnF.classList.remove('active');
        if (femaleContainer) femaleContainer.style.display = 'none';
      }

      var target = getActiveFitTarget();
      var defaultSize = (target.sizes && target.sizes.indexOf(state.size) !== -1) ? state.size : (target.sizes[0] || 'M');
      state.size = defaultSize;
      state.isCustomSize = false;

      var alertBox = document.getElementById('auto-custom-pill-alert');
      if (alertBox) alertBox.style.display = 'none';

      var container = document.getElementById('wiz-size-chips-container');
      if (container) container.innerHTML = '';
      var grid = document.getElementById('wiz-measurements-grid');
      if (grid) grid.innerHTML = '';

      window.renderDynamicSizeChips();
      window.renderDynamicMeasurementInputs();
      updateReviewAndPaymentUI();
    };

    // 4. Female Fit Handler (Slim, Regular, Loose)
    window.enamelsSetFemaleFit = function(fitKey) {
      state.femaleFit = fitKey;
      var cards = document.querySelectorAll('.female-fit-card');
      cards.forEach(function(c) { c.classList.remove('active'); });
      var targetEl = document.getElementById('ffit-' + fitKey);
      if (targetEl) targetEl.classList.add('active');

      var target = getActiveFitTarget();
      var defaultSize = (target.sizes && target.sizes.indexOf(state.size) !== -1) ? state.size : (target.sizes[0] || 'M');
      state.size = defaultSize;
      state.isCustomSize = false;

      var alertBox = document.getElementById('auto-custom-pill-alert');
      if (alertBox) alertBox.style.display = 'none';

      var container = document.getElementById('wiz-size-chips-container');
      if (container) container.innerHTML = '';
      var grid = document.getElementById('wiz-measurements-grid');
      if (grid) grid.innerHTML = '';

      window.renderDynamicSizeChips();
      window.renderDynamicMeasurementInputs();
      updateReviewAndPaymentUI();
    };

    // 4. Size & Fit Selection (with Enamels Standard Size Chart & Auto Custom Detection)
    window.enamelsSelectStandardSize = function(sizeKey) {
      if (sizeKey === 'Custom') {
        window.enamelsSelectCustomDirectly();
        return;
      }
      state.size = sizeKey;
      state.isCustomSize = false;

      var alertBox = document.getElementById('auto-custom-pill-alert');
      if (alertBox) alertBox.style.display = 'none';

      var chart = getActiveSizeChart();
      var sizeData = chart[sizeKey] || {};

      var cfg = getActiveSizeFitConfig();
      var fields = cfg.fields || DEFAULT_ENAMELS_SIZE_FIT_CONFIG.fields;

      fields.forEach(function(f) {
        if (sizeData[f.key] !== undefined) {
          state.measurements[f.key] = sizeData[f.key];
        }
      });

      window.renderDynamicSizeChips();
      window.renderDynamicMeasurementInputs();
      updateReviewAndPaymentUI();
    };

    window.enamelsSelectCustomDirectly = function() {
      state.size = 'Custom';
      state.isCustomSize = true;

      window.renderDynamicSizeChips();

      var alertBox = document.getElementById('auto-custom-pill-alert');
      if (alertBox) alertBox.style.display = 'block';

      var heading = document.getElementById('m-chart-heading');
      var target = getActiveFitTarget();
      if (heading) heading.textContent = 'Custom Bespoke Measurements (' + target.title + ')';

      updateReviewAndPaymentUI();
    };

    window.enamelsHandleMeasurementInput = function(fieldKey, value) {
      var num = parseFloat(value);
      if (state.unit === 'cm' && !isNaN(num)) {
        state.measurements[fieldKey] = Math.round((num / 2.54) * 10) / 10;
      } else {
        state.measurements[fieldKey] = !isNaN(num) ? num : value;
      }

      if (!state.isCustomSize) {
        state.isCustomSize = true;
        state.size = 'Custom';

        window.renderDynamicSizeChips();

        var alertBox = document.getElementById('auto-custom-pill-alert');
        if (alertBox) alertBox.style.display = 'block';

        var heading = document.getElementById('m-chart-heading');
        var target = getActiveFitTarget();
        if (heading) heading.textContent = 'Custom Bespoke Measurements (' + target.title + ')';
      }

      updateReviewAndPaymentUI();
    };

    window.enamelsSetUnit = function(unit) {
      state.unit = unit;
      var unitBtns = document.querySelectorAll('.unit-btn');
      unitBtns.forEach(function(b) {
        b.classList.remove('active');
        if (b.getAttribute('data-unit') === unit) b.classList.add('active');
      });

      window.renderDynamicMeasurementInputs();
      updateReviewAndPaymentUI();
    };

    window.enamelsSaveSizeAndNext = function() {
      window.enamelsGoStep(5);
    };

    // 5. Personalization: Multi-Line Engraving & Logo
    window.enamelsSetPlacement = function(placement, fee, el) {
      state.personalization.placement = placement;
      state.personalization.fee = fee || 0;

      var pills = document.querySelectorAll('.placement-pill');
      pills.forEach(function(p) { p.classList.remove('active'); });
      if (el) el.classList.add('active');

      var fields = document.getElementById('wiz-emb-fields-wrapper');
      if (fields) {
        fields.style.display = (placement === 'none') ? 'none' : 'block';
      }

      updateReviewAndPaymentUI();
    };

    window.enamelsUpdateEmbLines = function() {
      var l1 = document.getElementById('wiz-cust-name-1');
      var l2 = document.getElementById('wiz-cust-name-2');
      state.personalization.line1 = l1 ? l1.value.trim() : '';
      state.personalization.line2 = l2 ? l2.value.trim() : '';

      // Collect any extra lines
      var extraInputs = document.querySelectorAll('.extra-emb-input');
      state.personalization.extraLines = [];
      extraInputs.forEach(function(inp) {
        if (inp.value.trim()) state.personalization.extraLines.push(inp.value.trim());
      });

      var live1 = document.getElementById('wiz-emb-live-text');
      var live2 = document.getElementById('wiz-emb-live-subtext');
      if (live1) live1.textContent = state.personalization.line1 ? state.personalization.line1.toUpperCase() : 'YOUR NAME / TITLE';
      if (live2) live2.textContent = state.personalization.line2 ? state.personalization.line2 : '';

      updateReviewAndPaymentUI();
    };

    window.enamelsAddExtraEmbLine = function() {
      var container = document.getElementById('wiz-extra-emb-lines-container');
      if (!container) return;
      var lineIdx = state.personalization.extraLines.length + 3; // Line 3, 4, etc.

      var row = document.createElement('div');
      row.className = 'extra-emb-line-row';
      row.innerHTML = '<input type="text" class="form-input extra-emb-input" placeholder="Line ' + lineIdx + ': Additional engraving (+PKR 250)" maxlength="45" oninput="window.enamelsUpdateEmbLines()">' +
                      '<button type="button" class="btn-remove-emb-line" onclick="window.enamelsRemoveExtraEmbLine(this)">✕</button>';

      container.appendChild(row);
      window.enamelsUpdateEmbLines();
    };

    window.enamelsRemoveExtraEmbLine = function(btn) {
      var row = btn.closest('.extra-emb-line-row');
      if (row) row.remove();
      window.enamelsUpdateEmbLines();
    };

    window.enamelsSetThread = function(threadName, threadHex, el) {
      state.personalization.thread = threadName;
      var chips = document.querySelectorAll('.thread-chip');
      chips.forEach(function(c) { c.classList.remove('active'); });
      if (el) el.classList.add('active');

      var liveText = document.getElementById('wiz-emb-live-text');
      var liveSub = document.getElementById('wiz-emb-live-subtext');
      if (liveText) liveText.style.color = threadHex;
      if (liveSub) liveSub.style.color = threadHex;

      updateReviewAndPaymentUI();
    };

    window.enamelsSetLogo = function(logoType, logoFee, el) {
      state.personalization.logoType = logoType;
      state.personalization.logoFee = logoFee || 0;

      var chips = document.querySelectorAll('.logo-chip');
      chips.forEach(function(c) { c.classList.remove('active'); });
      if (el) el.classList.add('active');

      var uploadBox = document.getElementById('wiz-logo-upload-box');
      if (uploadBox) {
        uploadBox.style.display = (logoType === 'custom_upload') ? 'block' : 'none';
      }

      updateReviewAndPaymentUI();
    };

    window.enamelsHandleLogoFileUpload = function(input) {
      if (!input || !input.files || input.files.length === 0) return;
      var file = input.files[0];

      // Validate size <= 10MB
      var maxBytes = 10 * 1024 * 1024;
      if (file.size > maxBytes) {
        alert('File size exceeds 10MB limit. Please upload a smaller image or vector file.');
        input.value = '';
        return;
      }

      // Validate allowed extensions
      var ext = file.name.split('.').pop().toLowerCase();
      var allowed = ['png', 'jpg', 'jpeg', 'svg', 'pdf'];
      if (allowed.indexOf(ext) === -1) {
        alert('Invalid file format. Allowed formats: PNG, JPG, SVG, PDF.');
        input.value = '';
        return;
      }

      var formattedSize = (file.size / (1024 * 1024)).toFixed(2) + ' MB';
      state.personalization.logoFileName = file.name;
      state.personalization.logoFileSize = formattedSize;

      var strip = document.getElementById('wiz-logo-file-preview-strip');
      var nameEl = document.getElementById('wiz-logo-file-name');
      var sizeEl = document.getElementById('wiz-logo-file-size');
      var thumbEl = document.getElementById('wiz-logo-thumb-preview');

      if (strip) strip.style.display = 'flex';
      if (nameEl) nameEl.textContent = file.name;
      if (sizeEl) sizeEl.textContent = formattedSize + ' • Attached successfully';

      if (thumbEl && (ext === 'png' || ext === 'jpg' || ext === 'jpeg' || ext === 'svg')) {
        var reader = new FileReader();
        reader.onload = function(e) {
          thumbEl.src = e.target.result;
          thumbEl.style.display = 'block';
          state.personalization.logoFileData = e.target.result;
        };
        reader.readAsDataURL(file);
      } else if (thumbEl) {
        thumbEl.style.display = 'none';
      }

      updateReviewAndPaymentUI();
    };

    window.enamelsSavePersonalizationAndNext = function() {
      // Validate line 1 if placement is active
      if (state.personalization.placement !== 'none' && !state.personalization.line1) {
        alert('Please fill in compulsory Line 1 (Doctor / Staff Name) or select "None" for embroidery placement.');
        var inp = document.getElementById('wiz-cust-name-1');
        if (inp) inp.focus();
        return;
      }
      window.enamelsGoStep(6);
    };

    // 7. Payment & Delivery Method Handlers
    window.enamelsSetDestination = function(destKey) {
      state.deliveryDest = destKey;
      var chips = document.querySelectorAll('.delivery-chip');
      chips.forEach(function(c) {
        c.classList.remove('active');
        var input = c.querySelector('input');
        if (input && input.value === destKey) {
          c.classList.add('active');
          input.checked = true;
        }
      });
      updateReviewAndPaymentUI();
    };

    window.enamelsSetPaymentMethod = function(pmKey) {
      state.paymentMethod = pmKey;
      var cards = document.querySelectorAll('.payment-method-card');
      cards.forEach(function(c) {
        c.classList.remove('active');
        var input = c.querySelector('input');
        if (input && input.value === pmKey) {
          c.classList.add('active');
          input.checked = true;
        }
      });
      updateReviewAndPaymentUI();
    };

    // =========================================================================
    // 8. SINGLE OFFICIAL SHOPIFY CHECKOUT ENGINE
    // =========================================================================
    window.enamelsSubmitToShopifyCheckout = function() {
      var btn = document.getElementById('btn-submit-to-checkout') || document.getElementById('btn-submit-order-final');
      var btnText = btn ? (btn.querySelector('.btn-checkout-text') || btn.querySelector('.btn-submit-text')) : null;
      var btnLoader = btn ? (btn.querySelector('.btn-checkout-loader') || btn.querySelector('.btn-submit-loader')) : null;

      if (btn) btn.disabled = true;
      if (btnText) btnText.style.display = 'none';
      if (btnLoader) btnLoader.style.display = 'inline-block';

      var f = calculateFinancials();
      var targetFit = getActiveFitTarget();

      // Collect line item properties carrying 100% complete customization specs into Shopify Checkout & Admin
      var props = {
        'Customization Type': 'Bespoke Medical Scrub',
        'Product Design': state.design.name,
        'Design Collection': state.collection.title,
        'Fabric': state.fabric.name + (state.fabric.fee > 0 ? ' (+PKR ' + state.fabric.fee + ')' : ''),
        'Main Color': state.color.name,
        'Contrast Trim': state.contrast.name,
        'Gender': state.gender === 'female' ? 'Female' : 'Male',
        'Fit Silhouette': targetFit.title,
        'Selected Size': state.isCustomSize ? 'Custom Fit' : state.size,
        'Size & Fit': (state.isCustomSize ? 'Custom Tailored Fit' : ('Size ' + state.size)) + ' (' + targetFit.title + ')',
        'Custom Sizing': state.isCustomSize ? 'Yes' : 'No'
      };

      // Add measurements dynamically from configured fields
      var cfg = getActiveSizeFitConfig();
      var fList = cfg.fields || DEFAULT_ENAMELS_SIZE_FIT_CONFIG.fields;
      var specParts = [];
      fList.forEach(function(fld) {
        if (state.measurements[fld.key] !== undefined) {
          var val = state.measurements[fld.key];
          if (state.unit === 'cm' && typeof val === 'number') {
            val = Math.round(val * 2.54 * 10) / 10;
          }
          specParts.push(fld.label + ': ' + val + state.unit);
        }
      });
      props['Custom Measurements'] = specParts.join(', ');

      // Personalization
      if (state.personalization.placement !== 'none' && state.personalization.line1) {
        props['Personalization Placement'] = state.personalization.placement;
        props['Doctor Name (Line 1)'] = state.personalization.line1;
        if (state.personalization.line2) props['Title / Dept (Line 2)'] = state.personalization.line2;
        if (state.personalization.extraLines && state.personalization.extraLines.length > 0) {
          props['Additional Engraving Lines'] = state.personalization.extraLines.join(' | ');
        }
        props['Thread Color'] = state.personalization.thread;
      }
      if (state.personalization.logoType !== 'none') {
        if (state.personalization.logoType === 'custom_upload') {
          props['Hospital Logo'] = 'Uploaded Custom Logo (' + (state.personalization.logoFileName || 'File attached') + ')';
          props['Logo File Attached'] = state.personalization.logoFileName + ' (' + state.personalization.logoFileSize + ')';
        } else {
          props['Hospital Logo'] = state.personalization.logoType === 'crest' ? 'Hospital Crest (+PKR 450)' : 'Silicone Patch (+PKR 550)';
        }
      }

      props['Advance Payment Rule'] = '100% Advance Payment Required (Card Payment or Online Bank Transfer at Checkout)';
      props['Calculated Garment Value'] = 'PKR ' + f.productValue.toLocaleString();
      if (f.embFee > 0) props['Personalization Add-on'] = '+PKR ' + f.embFee.toLocaleString();

      // Resolve matching variant ID for the selected design and selected size
      var targetVariantId = null;
      if (state.design.variants && state.design.variants.length > 0) {
        var desiredSize = (state.size || '').trim().toUpperCase();
        for (var v = 0; v < state.design.variants.length; v++) {
          var vr = state.design.variants[v];
          var vrTitle = (vr.title || '').trim().toUpperCase();
          var optValues = (vr.options || []).map(function(o) { return String(o).trim().toUpperCase(); });
          if (vrTitle === desiredSize || optValues.indexOf(desiredSize) !== -1) {
            targetVariantId = vr.id;
            break;
          }
        }
        if (!targetVariantId) {
          for (var v2 = 0; v2 < state.design.variants.length; v2++) {
            var vr2 = state.design.variants[v2];
            var vrTitle2 = (vr2.title || '').trim().toUpperCase();
            if (desiredSize === 'S' && (vrTitle2.indexOf('SMALL') !== -1 || vrTitle2 === 'S')) { targetVariantId = vr2.id; break; }
            if (desiredSize === 'M' && (vrTitle2.indexOf('MEDIUM') !== -1 || vrTitle2 === 'M')) { targetVariantId = vr2.id; break; }
            if (desiredSize === 'L' && (vrTitle2.indexOf('LARGE') !== -1 && vrTitle2.indexOf('XL') === -1)) { targetVariantId = vr2.id; break; }
            if (desiredSize === 'XL' && (vrTitle2.indexOf('XL') !== -1 || vrTitle2.indexOf('EXTRA LARGE') !== -1)) { targetVariantId = vr2.id; break; }
            if (desiredSize === '2XL' && (vrTitle2.indexOf('2XL') !== -1 || vrTitle2.indexOf('XXL') !== -1)) { targetVariantId = vr2.id; break; }
          }
        }
      }

      if (!targetVariantId) {
        targetVariantId = state.design.variantId;
      }
      if (!targetVariantId) {
        var firstCard = document.querySelector('.enamels-design-card[data-variant-id]');
        if (firstCard) targetVariantId = firstCard.getAttribute('data-variant-id');
      }

      // Record custom order docket for Admin Profile tracking
      var customOrderDocket = {
        id: 'CUST-' + Date.now().toString().slice(-6),
        orderNumber: 'CUST-' + Math.floor(100000 + Math.random() * 900000),
        createdAt: new Date().toISOString(),
        dateFormatted: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
        garment: {
          collection: state.collection.title,
          design: state.design.name,
          designId: state.design.id,
          variantId: targetVariantId,
          fabric: state.fabric.name,
          fabricFee: state.fabric.fee,
          mainColor: state.color.name,
          mainColorHex: state.color.hex,
          contrast: state.contrast.name,
          gender: state.gender === 'female' ? 'Female' : 'Male',
          femaleFit: state.femaleFit,
          fitLabel: targetFit.title,
          size: state.size,
          isCustomSize: state.isCustomSize,
          unit: state.unit,
          measurements: Object.assign({}, state.measurements)
        },
        personalization: {
          placement: state.personalization.placement,
          line1: state.personalization.line1,
          line2: state.personalization.line2,
          extraLines: (state.personalization.extraLines || []).slice(),
          thread: state.personalization.thread,
          fee: f.embFee,
          logoType: state.personalization.logoType,
          logoFileName: state.personalization.logoFileName,
          logoFileSize: state.personalization.logoFileSize
        },
        financials: {
          productValue: f.productValue,
          basePrice: f.base,
          fabricFee: f.fabricFee,
          embroideryFee: f.embFee
        },
        paymentStatus: 'Pending Verification (Shopify Checkout)',
        orderStatus: 'Production Queue',
        productionStatus: 'Awaiting Tailoring Cut',
        specsSummary: props['Custom Measurements'],
        lineItemProperties: props
      };

      try {
        var existingOrders = JSON.parse(localStorage.getItem('enamels_customize_orders') || localStorage.getItem('enamels_custom_orders') || '[]');
        if (!Array.isArray(existingOrders)) existingOrders = [];
        existingOrders.unshift(customOrderDocket);
        localStorage.setItem('enamels_customize_orders', JSON.stringify(existingOrders));
        localStorage.setItem('enamels_custom_orders', JSON.stringify(existingOrders));
        window.dispatchEvent(new CustomEvent('enamels:custom_order_created', { detail: customOrderDocket }));
      } catch(e) {}

      function postAndRedirect(varId) {
        var postData = {
          items: [{
            id: varId,
            quantity: 1,
            properties: props
          }]
        };

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(postData)
        })
        .then(function(res) {
          if (!res.ok) throw new Error('Cart add response error');
          return res.json();
        })
        .then(function() {
          if (btnLoader) btnLoader.textContent = 'Redirecting to Shopify Checkout...';
          window.location.href = '/checkout';
        })
        .catch(function(err) {
          if (btn) btn.disabled = false;
          if (btnText) btnText.style.display = '';
          if (btnLoader) btnLoader.style.display = 'none';
          alert('Could not add customized scrub to checkout. Redirecting to cart...');
          window.location.href = '/cart';
        });
      }

      if (targetVariantId) {
        postAndRedirect(targetVariantId);
      } else {
        fetch('/products.json?limit=1')
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data && data.products && data.products[0] && data.products[0].variants && data.products[0].variants[0]) {
              postAndRedirect(data.products[0].variants[0].id);
            } else {
              window.location.href = '/cart';
            }
          })
          .catch(function() {
            window.location.href = '/cart';
          });
      }
    };

    // Backward-compatible alias for any residual callers
    window.enamelsFinalizeOrderSubmission = window.enamelsSubmitToShopifyCheckout;

    // Initialize DOM handlers
    document.addEventListener('DOMContentLoaded', function() {
      // Step 2 Contrast Swatches
      var contrastSwatches = document.querySelectorAll('.contrast-swatch-circle');
      var contrastLabel = document.getElementById('active-contrast-label');
      contrastSwatches.forEach(function(cSwatch) {
        cSwatch.addEventListener('click', function() {
          contrastSwatches.forEach(function(s) { s.classList.remove('active'); });
          cSwatch.classList.add('active');
          state.contrast.name = cSwatch.getAttribute('data-contrast-name');
          state.contrast.hex = cSwatch.getAttribute('data-contrast-hex');
          if (contrastLabel) contrastLabel.textContent = state.contrast.name;
          updateReviewAndPaymentUI();
        });
      });

      // Stepper button clicks
      var stepBtns = document.querySelectorAll('.enamels-step-btn');
      stepBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var target = parseInt(btn.getAttribute('data-step'), 10);
          window.enamelsGoStep(target);
        });
      });

      // Render default fabric colors for Crown
      renderFabricColors('crown');

      // Pre-populate dynamic size chips and measurements
      if (typeof window.renderDynamicSizeChips === 'function') window.renderDynamicSizeChips();
      if (typeof window.renderDynamicMeasurementInputs === 'function') window.renderDynamicMeasurementInputs();
      window.enamelsSelectStandardSize('M');

      // Listen for Admin size configuration updates across tabs/windows
      window.addEventListener('enamels:size_config_updated', function() {
        if (typeof window.renderDynamicSizeChips === 'function') window.renderDynamicSizeChips();
        if (typeof window.renderDynamicMeasurementInputs === 'function') window.renderDynamicMeasurementInputs();
        updateReviewAndPaymentUI();
      });
    });

    if (document.readyState === 'interactive' || document.readyState === 'complete') {
      renderFabricColors('crown');
      if (typeof window.renderDynamicSizeChips === 'function') window.renderDynamicSizeChips();
      if (typeof window.renderDynamicMeasurementInputs === 'function') window.renderDynamicMeasurementInputs();
      window.enamelsSelectStandardSize('M');
      updateReviewAndPaymentUI();
    }
  })();
</script>
