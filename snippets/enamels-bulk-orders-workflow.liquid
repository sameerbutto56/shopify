    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
  }

  .btn-return-storefront {
    background: #102a43;
    color: #ffffff;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 13px;
    text-decoration: none;
  }

  /* Mobile Media Queries (Part 9) */
  @media (max-width: 768px) {
    .bulk-form-grid {
      grid-template-columns: 1fr;
    }
    .sizes-steppers-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .review-contact-grid {
      grid-template-columns: 1fr;
    }
    .bulk-tier-banner {
      grid-template-columns: 1fr;
    }
    .bulk-categories-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .bulk-categories-grid {
      grid-template-columns: 1fr;
    }
    .sizes-steppers-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .bulk-main-heading {
      font-size: 24px;
    }
  }
</style>

<script>
  (function initEnamelsBulkWorkflow() {
    var MIN_BULK_QTY = {{ min_qty }};
    var OFFICIAL_WA_NUMBER = '{{ wa_clean }}';

    // Catalog Data Definition (Scrubs, Lab Coats, Caps, Accessories)
    var CATALOG = {
      scrubs: {
        id: 'scrubs',
        title: 'Medical Scrubs',
        articles: [
          { id: 'sprinter', name: 'Sprinter 4-Way Stretch Scrub Set', spec: 'Ergonomic athletic cut, 8 pockets, anti-wrinkle moisture wicking.', image: '{{ "demo-sprinter-navy.jpg" | asset_url }}' },
          { id: 'vilora', name: 'Vilora Technical Antimicrobial Scrub Set', spec: 'ICU fluid barrier finish, modern mandarin collar, tailored silhouette.', image: '{{ "demo-velora-teal.jpg" | asset_url }}' },
          { id: 'crown', name: 'Crown Signature Tailored Scrub Set', spec: 'Executive consultant drape, hidden magnetic pocket, premium heavyweight blend.', image: '{{ "demo-crown-burgundy.jpg" | asset_url }}' },
          { id: 'classic', name: 'Classic Comfort Dual-Pocket Scrub Set', spec: 'Reinforced dual chest pockets, autoclave safe, high-durability poly-cotton.', image: '{{ "cat-men-scrubs.jpg" | asset_url }}' }
        ]
      },
      lab_coats: {
        id: 'lab_coats',
        title: 'Doctor & Lab Coats',
        articles: [
          { id: 'exec_coat', name: 'Executive Consultant Doctor Coat', spec: 'Tailored notched lapel, iPad pocket, spill-proof Teflon coating.', image: '{{ "demo-hang-labcoat-white.jpg" | asset_url }}' },
          { id: 'resident_coat', name: 'Resident Medical White Coat', spec: 'Mid-length modern fit, tablet side slits, reinforced instrument loops.', image: '{{ "cat-labcoat.jpg" | asset_url }}' },
          { id: 'lab_jacket', name: 'Clinical Barrier Lab Jacket', spec: 'Ribbed knit cuffs, high-neck snap closure, fluid-resistant finish.', image: '{{ "cat-labcoat.jpg" | asset_url }}' }
        ]
      },
      caps: {
        id: 'caps',
        title: 'Surgical Scrub Caps',
        articles: [
          { id: 'tie_back_cap', name: 'Ergonomic Tie-Back Surgical Cap', spec: 'Breathable crown panel, built-in terry cloth forehead sweatband.', image: '{{ "banner-caps.jpg" | asset_url }}' },
          { id: 'bouffant_cap', name: 'Bouffant Elastic Theatre Cap', spec: 'Generous volume for longer hair, hypoallergenic soft elastic band.', image: '{{ "banner-caps.jpg" | asset_url }}' },
          { id: 'embroidered_cap', name: 'Custom Embroidered Doctor Cap', spec: 'Includes department name & personalized doctor monogram.', image: '{{ "banner-caps.jpg" | asset_url }}' }
        ]
      },
      accessories: {
        id: 'accessories',
        title: 'Accessories & Sleeves',
        articles: [
          { id: 'arm_sleeves', name: 'Medical Compression Arm Sleeves (Pair)', spec: 'UPF 50+ cooling compression sleeves for theater and clinic.', image: '{{ "cat-clogs.jpg" | asset_url }}' },
          { id: 'theatre_clogs', name: 'Orthopedic Hospital Theatre Clogs', spec: 'Shock-absorbing EVA, slip-resistant sole, washable & autoclavable.', image: '{{ "cat-clogs.jpg" | asset_url }}' },
          { id: 'id_reels', name: 'Departmental Heavy-Duty Badge Reels', spec: 'Retractable steel cord, reinforced alligator clip, laser logo.', image: '{{ "cat-clogs.jpg" | asset_url }}' }
        ]
      }
    };

    // State
    var state = {
      currentStep: 1,
      selectedCategories: ['scrubs'],
      selectedArticles: {
        'scrubs:sprinter': {
          catId: 'scrubs',
          catTitle: 'Medical Scrubs',
          articleId: 'sprinter',
          articleName: 'Sprinter 4-Way Stretch Scrub Set',
          sizes: { xs: 0, s: 2, m: 5, l: 3, xl: 0, '2xl': 0 }
        }
      },
      contact: {
        name: '',
        hospital: '',
        phone: '',
        whatsapp: '',
        email: '',
        city: '',
        address: '',
        notes: ''
      },
      referenceId: ''
    };

    function generateRefId() {
      var chars = '0123456789ABCDEFGHJKLMNPQRSTUVWXYZ';
      var rand = '';
      for (var i = 0; i < 4; i++) {
        rand += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return 'ENM-BLK-2026-' + rand;
    }

    state.referenceId = generateRefId();

    // Calculate Totals
    function calculateTotals() {
      var grandTotal = 0;
      var catTotals = {};

      Object.keys(state.selectedArticles).forEach(function(key) {
        var item = state.selectedArticles[key];
        var itemTotal = 0;
        Object.keys(item.sizes).forEach(function(s) {
          itemTotal += (parseInt(item.sizes[s], 10) || 0);
        });
        item.totalQty = itemTotal;
        grandTotal += itemTotal;

        if (!catTotals[item.catId]) catTotals[item.catId] = 0;
        catTotals[item.catId] += itemTotal;
      });

      return {
        grandTotal: grandTotal,
        catTotals: catTotals
      };
    }

    // Update Live Meters and Tiers
    function updateLiveMeters() {
      var totals = calculateTotals();
      var countEl = document.getElementById('meter-grand-total');
      var tierEl = document.getElementById('meter-tier-badge');
      var alertEl = document.getElementById('bulk-min-qty-alert');
      var alertCur = document.getElementById('alert-current-total');
      var alertNeed = document.getElementById('alert-needed-qty');

      if (countEl) {
        countEl.textContent = totals.grandTotal + ' Units';
        countEl.className = 'meter-stat-count ' + (totals.grandTotal >= MIN_BULK_QTY ? 'valid' : '');
      }

      var tier1 = document.getElementById('tier-pill-1');
      var tier2 = document.getElementById('tier-pill-2');
      var tier3 = document.getElementById('tier-pill-3');

      if (tier1) tier1.classList.remove('active');
      if (tier2) tier2.classList.remove('active');
      if (tier3) tier3.classList.remove('active');

      if (tierEl) {
        if (totals.grandTotal < MIN_BULK_QTY) {
          tierEl.textContent = 'Minimum 10 Units Required (' + totals.grandTotal + '/' + MIN_BULK_QTY + ')';
          tierEl.className = 'meter-tier-badge badge-invalid';
          if (alertEl) alertEl.style.display = 'flex';
          if (alertCur) alertCur.textContent = totals.grandTotal;
          if (alertNeed) alertNeed.textContent = Math.max(0, MIN_BULK_QTY - totals.grandTotal);
        } else if (totals.grandTotal <= 20) {
          tierEl.textContent = '✓ Tier 1 (10–20 Units) • Standard Wholesale';
          tierEl.className = 'meter-tier-badge badge-valid';
          if (tier1) tier1.classList.add('active');
          if (alertEl) alertEl.style.display = 'none';
        } else if (totals.grandTotal <= 40) {
          tierEl.textContent = '✓ Tier 2 (21–40 Units) • Volume Priority Batch';
          tierEl.className = 'meter-tier-badge badge-valid';
          if (tier2) tier2.classList.add('active');
          if (alertEl) alertEl.style.display = 'none';
        } else {
          tierEl.textContent = '✓ Tier 3 (41+ Units) • Enterprise Tier (Free Crest)';
          tierEl.className = 'meter-tier-badge badge-valid';
          if (tier3) tier3.classList.add('active');
          if (alertEl) alertEl.style.display = 'none';
        }
      }

      // Enable / Disable next buttons on Step 3
      var btnNextToDetails = document.getElementById('btn-next-to-details');
      if (btnNextToDetails) {
        btnNextToDetails.disabled = (totals.grandTotal < MIN_BULK_QTY);
      }
    }

    // Step 1: Category Toggle
    window.enamelsToggleCategory = function(catId) {
      var idx = state.selectedCategories.indexOf(catId);
      if (idx > -1) {
        if (state.selectedCategories.length === 1) {
          alert('Please keep at least one category selected.');
          return;
        }
        state.selectedCategories.splice(idx, 1);
        // Remove articles belonging to this category
        Object.keys(state.selectedArticles).forEach(function(k) {
          if (state.selectedArticles[k].catId === catId) {
            delete state.selectedArticles[k];
          }
        });
      } else {
        state.selectedCategories.push(catId);
        // Default select first article of newly added category
        var catObj = CATALOG[catId];
        if (catObj && catObj.articles && catObj.articles.length > 0) {
          var firstArt = catObj.articles[0];
          var key = catId + ':' + firstArt.id;
          if (!state.selectedArticles[key]) {
            state.selectedArticles[key] = {
              catId: catId,
              catTitle: catObj.title,
              articleId: firstArt.id,
              articleName: firstArt.name,
              sizes: { xs: 0, s: 2, m: 4, l: 4, xl: 0, '2xl': 0 }
            };
          }
        }
      }
      renderCategoryCards();
      renderCategoryChips();
      renderArticlesStep();
      renderSizeBreakdownStep();
      updateLiveMeters();
    };

    function renderCategoryCards() {
      var cards = document.querySelectorAll('.bulk-cat-toggle-card');
      cards.forEach(function(card) {
        var cid = card.getAttribute('data-cat-id');
        var isSel = state.selectedCategories.indexOf(cid) > -1;
        card.classList.toggle('selected', isSel);
        var actSpan = card.querySelector('.cat-card-action');
        if (actSpan) {
          actSpan.textContent = isSel ? '✓ Category Selected' : '+ Click to Select';
        }
      });
    }

    function renderCategoryChips() {
      var container = document.getElementById('cat-chips-container');
      var countEl = document.getElementById('cat-chips-count');
      if (countEl) countEl.textContent = state.selectedCategories.length;
      if (!container) return;

      container.innerHTML = '';
      state.selectedCategories.forEach(function(cid) {
        var catObj = CATALOG[cid];
        if (!catObj) return;
        var chip = document.createElement('div');
        chip.className = 'cat-chip';
        chip.innerHTML = '<span>' + catObj.title + '</span><span class="cat-chip-remove" onclick="window.enamelsToggleCategory(\'' + cid + '\')">✕</span>';
        container.appendChild(chip);
      });
    }

    // Step 2: Articles Step Render
    function renderArticlesStep() {
      var supergroup = document.getElementById('category-articles-supergroup');
      var jumpTabs = document.getElementById('article-category-jump-tabs');
      if (!supergroup) return;

      supergroup.innerHTML = '';
      if (jumpTabs) jumpTabs.innerHTML = '';

      state.selectedCategories.forEach(function(cid, idx) {
        var catObj = CATALOG[cid];
        if (!catObj) return;

        // Jump tab
        if (jumpTabs) {
          var jTab = document.createElement('button');
          jTab.type = 'button';
          jTab.className = 'btn-cat-tab ' + (idx === 0 ? 'active' : '');
          jTab.textContent = catObj.title;
          jTab.onclick = function() {
            jumpTabs.querySelectorAll('.btn-cat-tab').forEach(function(t) { t.classList.remove('active'); });
            jTab.classList.add('active');
            var targetSec = document.getElementById('cat-sec-' + cid);
            if (targetSec) targetSec.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          };
          jumpTabs.appendChild(jTab);
        }

        // Category section
        var sec = document.createElement('div');
        sec.className = 'cat-articles-section';
        sec.id = 'cat-sec-' + cid;

        // Header
        var secHead = document.createElement('div');
        secHead.className = 'cat-articles-section-title';
        secHead.innerHTML = '<span>Category: ' + catObj.title + '</span><span class="cat-article-badge-count" id="badge-art-count-' + cid + '">0 Selected</span>';
        sec.appendChild(secHead);

        // Grid
        var grid = document.createElement('div');
        grid.className = 'articles-grid-sub';

        catObj.articles.forEach(function(art) {
          var key = cid + ':' + art.id;
          var isSelected = !!state.selectedArticles[key];

          var card = document.createElement('div');
          card.className = 'bulk-article-toggle-card ' + (isSelected ? 'selected' : '');
          card.id = 'art-card-' + cid + '-' + art.id;
          card.innerHTML =
            '<div class="article-thumb"><img src="' + art.image + '" alt="' + art.name + '" loading="lazy"></div>' +
            '<div class="article-body">' +
              '<h4 class="article-title">' + art.name + '</h4>' +
              '<p class="article-spec">' + art.spec + '</p>' +
              '<span class="article-toggle-btn">' + (isSelected ? '✓ Selected' : '+ Add to Enquiry') + '</span>' +
            '</div>';

          card.onclick = function() {
            window.enamelsToggleArticle(cid, art.id, art.name);
          };

          grid.appendChild(card);
        });

        sec.appendChild(grid);
        supergroup.appendChild(sec);
      });

      updateArticleCountBadges();
    }

    function updateArticleCountBadges() {
      state.selectedCategories.forEach(function(cid) {
        var count = 0;
        Object.keys(state.selectedArticles).forEach(function(k) {
          if (state.selectedArticles[k].catId === cid) count++;
        });
        var b = document.getElementById('badge-art-count-' + cid);
        if (b) b.textContent = count + ' Selected';
      });

      var btnNextSizes = document.getElementById('btn-next-to-sizes');
      if (btnNextSizes) {
        btnNextSizes.disabled = (Object.keys(state.selectedArticles).length === 0);
      }
    }

    window.enamelsToggleArticle = function(catId, artId, artName) {
      var key = catId + ':' + artId;
      if (state.selectedArticles[key]) {
        if (Object.keys(state.selectedArticles).length === 1) {
          alert('Please keep at least one article selected in your enquiry.');
          return;
        }
        delete state.selectedArticles[key];
      } else {
        var catObj = CATALOG[catId];
        state.selectedArticles[key] = {
          catId: catId,
          catTitle: catObj ? catObj.title : catId,
          articleId: artId,
          articleName: artName,
          sizes: { xs: 0, s: 2, m: 4, l: 4, xl: 0, '2xl': 0 }
        };
      }

      var card = document.getElementById('art-card-' + catId + '-' + artId);
      if (card) {
        var isSel = !!state.selectedArticles[key];
        card.classList.toggle('selected', isSel);
        var btnSpan = card.querySelector('.article-toggle-btn');
        if (btnSpan) btnSpan.textContent = isSel ? '✓ Selected' : '+ Add to Enquiry';
      }

      updateArticleCountBadges();
      renderSizeBreakdownStep();
      updateLiveMeters();
    };

    // Step 3: Size Breakdown Step Render
    function renderSizeBreakdownStep() {
      var container = document.getElementById('articles-size-breakdown-list');
      if (!container) return;

      container.innerHTML = '';
      var keys = Object.keys(state.selectedArticles);

      if (keys.length === 0) {
        container.innerHTML = '<div style="text-align:center; padding: 30px; color:#64748b;">No articles selected. Please go back to Step 2 and choose articles.</div>';
        return;
      }

      var sizesList = ['xs', 's', 'm', 'l', 'xl', '2xl'];

      keys.forEach(function(key) {
        var item = state.selectedArticles[key];
        var card = document.createElement('div');
        card.className = 'article-size-card';
        card.id = 'asc-card-' + key.replace(':', '-');

        // Header
        var head = document.createElement('div');
        head.className = 'asc-header';
        head.innerHTML =
          '<div class="asc-title-wrap">' +
            '<span class="asc-cat-tag">' + item.catTitle + '</span>' +
            '<h4 class="asc-title">' + item.articleName + '</h4>' +
          '</div>' +
          '<div class="asc-meta-right">' +
            '<span class="asc-item-total" id="ait-' + key.replace(':', '-') + '">Total: ' + (item.totalQty || 0) + ' Units</span>' +
            '<button type="button" class="btn-remove-article-breakdown" onclick="window.enamelsRemoveArticleFromBreakdown(\'' + item.catId + '\', \'' + item.articleId + '\', \'' + item.articleName + '\')">✕ Remove</button>' +
          '</div>';

        card.appendChild(head);

        // Steppers Grid
        var grid = document.createElement('div');
        grid.className = 'sizes-steppers-grid';

        sizesList.forEach(function(sz) {
          var val = item.sizes[sz] || 0;
          var cell = document.createElement('div');
          cell.className = 'size-cell-card';
          cell.innerHTML =
            '<span class="size-label">' + sz.toUpperCase() + '</span>' +
            '<div class="stepper-row">' +
              '<button type="button" class="btn-step-act" onclick="window.enamelsAdjustSize(\'' + key + '\', \'' + sz + '\', -1)">−</button>' +
              '<input type="number" min="0" max="999" class="size-qty-input" id="inp-sz-' + key.replace(':', '-') + '-' + sz + '" value="' + val + '" onchange="window.enamelsSetSizeDirect(\'' + key + '\', \'' + sz + '\', this.value)" />' +
              '<button type="button" class="btn-step-act" onclick="window.enamelsAdjustSize(\'' + key + '\', \'' + sz + '\', 1)">+</button>' +
            '</div>';
          grid.appendChild(cell);
        });

        card.appendChild(grid);
        container.appendChild(card);
      });
    }

    window.enamelsRemoveArticleFromBreakdown = function(catId, artId, artName) {
      window.enamelsToggleArticle(catId, artId, artName);
    };

    window.enamelsAdjustSize = function(key, sz, delta) {
      if (!state.selectedArticles[key]) return;
      var cur = parseInt(state.selectedArticles[key].sizes[sz], 10) || 0;
      var next = Math.max(0, cur + delta);
      state.selectedArticles[key].sizes[sz] = next;

      var inp = document.getElementById('inp-sz-' + key.replace(':', '-') + '-' + sz);
      if (inp) inp.value = next;

      var totals = calculateTotals();
      var itemTotEl = document.getElementById('ait-' + key.replace(':', '-'));
      if (itemTotEl) {
        itemTotEl.textContent = 'Total: ' + (state.selectedArticles[key].totalQty || 0) + ' Units';
      }

      updateLiveMeters();
    };

    window.enamelsSetSizeDirect = function(key, sz, valStr) {
      if (!state.selectedArticles[key]) return;
      var val = Math.max(0, parseInt(valStr, 10) || 0);
      state.selectedArticles[key].sizes[sz] = val;

      var inp = document.getElementById('inp-sz-' + key.replace(':', '-') + '-' + sz);
      if (inp) inp.value = val;

      var totals = calculateTotals();
      var itemTotEl = document.getElementById('ait-' + key.replace(':', '-'));
      if (itemTotEl) {
        itemTotEl.textContent = 'Total: ' + (state.selectedArticles[key].totalQty || 0) + ' Units';
      }

      updateLiveMeters();
    };

    // Step 5 Review Render
    function renderReviewStep() {
      var totals = calculateTotals();
      var codeEl = document.getElementById('rev-ref-id-code');
      if (codeEl) codeEl.textContent = state.referenceId;

      var tableContainer = document.getElementById('review-breakdown-table-container');
      if (tableContainer) {
        tableContainer.innerHTML = '';
        var byCat = {};
        Object.keys(state.selectedArticles).forEach(function(k) {
          var item = state.selectedArticles[k];
          if (!byCat[item.catId]) byCat[item.catId] = { title: item.catTitle, articles: [] };
          byCat[item.catId].articles.push(item);
        });

        Object.keys(byCat).forEach(function(cid) {
          var catGroup = byCat[cid];
          var catRow = document.createElement('div');
          catRow.className = 'review-cat-row';

          var linesHtml = '';
          catGroup.articles.forEach(function(art) {
            var szStr = [];
            Object.keys(art.sizes).forEach(function(s) {
              if (art.sizes[s] > 0) szStr.push(s.toUpperCase() + ': ' + art.sizes[s]);
            });
            linesHtml +=
              '<div class="rcr-article-line">' +
                '<span><strong>' + art.articleName + '</strong> (' + (szStr.length > 0 ? szStr.join(', ') : 'No sizes specified') + ')</span>' +
                '<strong>' + (art.totalQty || 0) + ' Units</strong>' +
              '</div>';
          });

          catRow.innerHTML =
            '<div class="rcr-title">' +
              '<span>Category: ' + catGroup.title + '</span>' +
              '<span>Category Subtotal: ' + (totals.catTotals[cid] || 0) + ' Units</span>' +
            '</div>' +
            linesHtml;

          tableContainer.appendChild(catRow);
        });
      }

      var grandEl = document.getElementById('rev-grand-total-units');
      if (grandEl) grandEl.textContent = totals.grandTotal + ' Units';

      // Fill customer contact fields
      var nameEl = document.getElementById('bulk-inp-name');
      var hospEl = document.getElementById('bulk-inp-hospital');
      var phoneEl = document.getElementById('bulk-inp-phone');
      var waEl = document.getElementById('bulk-inp-whatsapp');
      var cityEl = document.getElementById('bulk-inp-city');
      var emailEl = document.getElementById('bulk-inp-email');
      var addrEl = document.getElementById('bulk-inp-address');
      var notesEl = document.getElementById('bulk-inp-notes');

      state.contact.name = nameEl ? nameEl.value.trim() : '';
      state.contact.hospital = hospEl ? hospEl.value.trim() : '';
      state.contact.phone = phoneEl ? phoneEl.value.trim() : '';
      state.contact.whatsapp = waEl ? waEl.value.trim() : '';
      state.contact.city = cityEl ? cityEl.value.trim() : '';
      state.contact.email = emailEl ? emailEl.value.trim() : '';
      state.contact.address = addrEl ? addrEl.value.trim() : '';
      state.contact.notes = notesEl ? notesEl.value.trim() : '';

      var rName = document.getElementById('rev-name-val');
      var rHosp = document.getElementById('rev-hospital-val');
      var rPhone = document.getElementById('rev-phone-val');
      var rWa = document.getElementById('rev-whatsapp-val');
      var rCity = document.getElementById('rev-city-val');
      var rEmail = document.getElementById('rev-email-val');
      var rAddr = document.getElementById('rev-address-val');
      var rNotes = document.getElementById('rev-notes-val');

      if (rName) rName.textContent = state.contact.name || 'Not provided';
      if (rHosp) rHosp.textContent = state.contact.hospital || 'Not provided';
      if (rPhone) rPhone.textContent = state.contact.phone || 'Not provided';
      if (rWa) rWa.textContent = state.contact.whatsapp || state.contact.phone || 'Not provided';
      if (rCity) rCity.textContent = state.contact.city || 'Not provided';
      if (rEmail) rEmail.textContent = state.contact.email || 'None';
      if (rAddr) rAddr.textContent = state.contact.address || 'Standard Delivery';
      if (rNotes) rNotes.textContent = state.contact.notes || 'None';
    }

    // Wizard Navigation
    window.enamelsBulkGoStep = function(stepNum) {
      if (stepNum === 4) {
        var totals = calculateTotals();
        if (totals.grandTotal < MIN_BULK_QTY) {
          alert('Please enter at least ' + MIN_BULK_QTY + ' units across your selected articles to proceed.');
          return;
        }
      }

      if (stepNum === 5) {
        var name = (document.getElementById('bulk-inp-name') || {}).value || '';
        var hosp = (document.getElementById('bulk-inp-hospital') || {}).value || '';
        var phone = (document.getElementById('bulk-inp-phone') || {}).value || '';
        var city = (document.getElementById('bulk-inp-city') || {}).value || '';

        if (!name.trim() || !hosp.trim() || !phone.trim() || !city.trim()) {
          alert('Please fill in your Name, Organization, Phone, and City before proceeding to review.');
          return;
        }
        renderReviewStep();
      }

      state.currentStep = stepNum;

      for (var i = 1; i <= 5; i++) {
        var pane = document.getElementById('bulk-pane-' + i);
        var snode = document.getElementById('snode-' + i);
        if (pane) pane.classList.toggle('active', i === stepNum);
        if (snode) {
          snode.classList.toggle('active', i === stepNum);
          snode.classList.toggle('completed', i < stepNum);
        }
      }

      var wizardCard = document.getElementById('bulk-customer-wizard');
      if (wizardCard) {
        wizardCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    };

    // Final Submission (Part 7)
    window.enamelsSubmitBulkEnquiry = function() {
      var totals = calculateTotals();
      if (totals.grandTotal < MIN_BULK_QTY) {
        alert('Minimum volume of 10 units is required.');
        return;
      }

      var submitBtn = document.getElementById('btn-submit-enquiry-final');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting Enquiry...';
      }

      var enquiryRecord = {
        refId: state.referenceId,
        createdAt: new Date().toLocaleString(),
        customer: state.contact,
        selectedCategories: state.selectedCategories,
        selectedArticles: state.selectedArticles,
        totals: totals,
        status: 'New Enquiry'
      };

      // Save to localStorage enquiry storage (Part 8)
      try {
        var existing = JSON.parse(localStorage.getItem('enamels_bulk_enquiries') || '[]');
        existing.unshift(enquiryRecord);
        localStorage.setItem('enamels_bulk_enquiries', JSON.stringify(existing));
      } catch(e) {}

      // Show Success Screen
      setTimeout(function() {
        for (var i = 1; i <= 5; i++) {
          var p = document.getElementById('bulk-pane-' + i);
          if (p) p.style.display = 'none';
        }
        var meter = document.getElementById('bulk-live-meter-strip');
        if (meter) meter.style.display = 'none';

        var successPane = document.getElementById('bulk-pane-success');
        if (successPane) successPane.style.display = 'block';

        var sRef = document.getElementById('success-ref-id');
        var sTot = document.getElementById('success-total-units');
        if (sRef) sRef.textContent = state.referenceId;
        if (sTot) sTot.textContent = totals.grandTotal + ' Units';

        // Pre-fill WhatsApp link
        var waBtn = document.getElementById('success-wa-direct-btn');
        if (waBtn) {
          var waText = encodeURIComponent(
            "Hello Enamels, I have submitted Institutional Bulk Order Enquiry #" + state.referenceId +
            " for " + totals.grandTotal + " units across " + state.selectedCategories.length +
            " categories for " + (state.contact.hospital || 'our hospital') + ". Please share the wholesale quotation."
          );
          waBtn.href = "https://wa.me/" + OFFICIAL_WA_NUMBER + "?text=" + waText;
        }

        renderAdminEnquiries();
      }, 600);
    };

    window.enamelsResetBulkWorkflow = function() {
      state.referenceId = generateRefId();
      state.currentStep = 1;
      for (var i = 1; i <= 5; i++) {
        var p = document.getElementById('bulk-pane-' + i);
        if (p) {
          p.style.display = '';
          p.classList.toggle('active', i === 1);
        }
      }
      var meter = document.getElementById('bulk-live-meter-strip');
      if (meter) meter.style.display = '';

      var successPane = document.getElementById('bulk-pane-success');
      if (successPane) successPane.style.display = 'none';

      var submitBtn = document.getElementById('btn-submit-enquiry-final');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>Submit Bulk Enquiry</span><span>✓</span>';
      }

      window.enamelsBulkGoStep(1);
    };

    // =========================================================================
    // ADMIN ENQUIRY MANAGEMENT (Part 8)
    // =========================================================================
    window.enamelsToggleAdminBulkPanel = function() {
      var panel = document.getElementById('enamels-admin-enquiry-panel');
      if (!panel) return;
      var isHidden = panel.style.display === 'none' || panel.style.display === '';
      panel.style.display = isHidden ? 'block' : 'none';
      if (isHidden) {
        renderAdminEnquiries();
        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

    window.enamelsSeedSampleBulkEnquiry = function() {
      var sampleRecord = {
        refId: 'ENM-BLK-2026-9281',
        createdAt: '05 Nov 2026, 01:15 PM PKT',
        customer: {
          name: 'Dr. Usman Tariq',
          hospital: 'Shaukat Khanum Memorial Hospital (ICU Wing)',
          phone: '+92 301 5551234',
          whatsapp: '+92 301 5551234',
          email: 'usman.tariq@hospital.org.pk',
          city: 'Lahore, Punjab',
          address: 'ICU Administration Office, 2nd Floor, Main Building',
          notes: 'Requires hospital crest embroidery on left arm sleeve and department nametag on chest. Needed by 20th November.'
        },
        selectedCategories: ['scrubs', 'lab_coats'],
        selectedArticles: {
          'scrubs:sprinter': {
            catId: 'scrubs',
            catTitle: 'Medical Scrubs',
            articleId: 'sprinter',
            articleName: 'Sprinter 4-Way Stretch Scrub Set',
            sizes: { xs: 2, s: 5, m: 10, l: 8, xl: 5, '2xl': 2 },
            totalQty: 32
          },
          'lab_coats:exec_coat': {
            catId: 'lab_coats',
            catTitle: 'Doctor & Lab Coats',
            articleId: 'exec_coat',
            articleName: 'Executive Consultant Doctor Coat',
            sizes: { xs: 1, s: 2, m: 5, l: 5, xl: 3, '2xl': 1 },
            totalQty: 17
          }
        },
        totals: {
          grandTotal: 49,
          catTotals: { scrubs: 32, lab_coats: 17 }
        },
        status: 'Contact Pending'
      };

      try {
        var list = JSON.parse(localStorage.getItem('enamels_bulk_enquiries') || '[]');
        // Don't add duplicate sample
        var exists = list.some(function(e) { return e.refId === sampleRecord.refId; });
        if (!exists) {
          list.unshift(sampleRecord);
          localStorage.setItem('enamels_bulk_enquiries', JSON.stringify(list));
        }
      } catch(e) {}
      renderAdminEnquiries();
    };

    function renderAdminEnquiries(statusFilter) {
      var listEl = document.getElementById('admin-enquiries-list');
      var badgeCountEl = document.getElementById('staff-enquiry-badge-count');
      if (!listEl) return;

      var enquiries = [];
      try {
        enquiries = JSON.parse(localStorage.getItem('enamels_bulk_enquiries') || '[]');
      } catch(e) {}

      // If empty, auto-seed the realistic sample enquiry
      if (enquiries.length === 0) {
        window.enamelsSeedSampleBulkEnquiry();
        enquiries = JSON.parse(localStorage.getItem('enamels_bulk_enquiries') || '[]');
      }

      if (badgeCountEl) badgeCountEl.textContent = enquiries.length;

      var filter = statusFilter || (document.getElementById('admin-status-filter') || {}).value || 'all';

      listEl.innerHTML = '';

      var filtered = enquiries.filter(function(enq) {
        if (filter === 'all') return true;
        return enq.status === filter;
      });

      if (filtered.length === 0) {
        listEl.innerHTML = '<div style="padding: 20px; text-align: center; color:#64748b;">No enquiries found with status: ' + filter + '</div>';
        return;
      }

      var statuses = ['New Enquiry', 'Contact Pending', 'Contacted', 'Quotation Shared', 'Negotiation', 'Confirmed', 'Rejected', 'Closed'];

      filtered.forEach(function(enq, idx) {
        var card = document.createElement('div');
        card.className = 'admin-enquiry-card';

        // Format breakdown
        var breakdownHtml = '';
        Object.keys(enq.selectedArticles || {}).forEach(function(k) {
          var art = enq.selectedArticles[k];
          var szTokens = [];
          Object.keys(art.sizes || {}).forEach(function(s) {
            if (art.sizes[s] > 0) szTokens.push(s.toUpperCase() + ': ' + art.sizes[s]);
          });
          breakdownHtml +=
            '<div>• <strong>[' + (art.catTitle || art.catId) + ']</strong> ' + art.articleName +
            ' — <span style="font-family:monospace; color:#0f766e;">' + (szTokens.join(', ') || 'Sizes pending') + '</span> ' +
            '<strong>(' + (art.totalQty || 0) + ' units)</strong></div>';
        });

        // Status options
        var statusOptionsHtml = '';
        statuses.forEach(function(st) {
          statusOptionsHtml += '<option value="' + st + '" ' + (enq.status === st ? 'selected' : '') + '>' + st + '</option>';
        });

        var custPhone = (enq.customer.phone || '').replace(/[^0-9]/g, '');
        var custWa = (enq.customer.whatsapp || enq.customer.phone || '').replace(/[^0-9]/g, '');

        card.innerHTML =
          '<div class="aec-header">' +
            '<div>' +
              '<span class="aec-ref-code">' + enq.refId + '</span>' +
              '<span class="aec-date"> • Submitted: ' + enq.createdAt + '</span>' +
            '</div>' +
            '<div class="status-select-wrap">' +
              '<label style="font-size:11px; font-weight:700; color:#475569; margin-right:4px;">Status:</label>' +
              '<select onchange="window.enamelsUpdateEnquiryStatus(\'' + enq.refId + '\', this.value)">' +
                statusOptionsHtml +
              '</select>' +
            '</div>' +
          '</div>' +
          '<div class="aec-customer-info">' +
            '<strong>Customer:</strong> ' + enq.customer.name + ' (' + enq.customer.hospital + ') • <strong>City:</strong> ' + enq.customer.city + '<br>' +
            '<strong>Phone / WhatsApp:</strong> ' + (enq.customer.phone || 'N/A') + ' / ' + (enq.customer.whatsapp || 'N/A') + ' • <strong>Email:</strong> ' + (enq.customer.email || 'None') + '<br>' +
            (enq.customer.notes ? '<strong>Notes:</strong> <em>' + enq.customer.notes + '</em>' : '') +
          '</div>' +
          '<div class="aec-breakdown-box">' +
            '<div style="font-weight:700; color:#0f172a; margin-bottom:6px;">Order Specifications (Total: ' + (enq.totals.grandTotal || 0) + ' Units across ' + (enq.selectedCategories || []).length + ' Categories):</div>' +
            breakdownHtml +
          '</div>' +
          '<div class="aec-actions">' +
            '<a href="https://wa.me/' + custWa + '?text=' + encodeURIComponent('Hello ' + enq.customer.name + ', this is Enamels Institutional Uniforms Desk regarding your Bulk Order Enquiry #' + enq.refId + ' for ' + (enq.totals.grandTotal || 0) + ' units.') + '" target="_blank" class="aec-btn-wa">💬 WhatsApp Customer</a>' +
            '<a href="tel:' + custPhone + '" class="aec-btn-call">📞 Call Customer</a>' +
          '</div>';

        listEl.appendChild(card);
      });
    }

    window.enamelsUpdateEnquiryStatus = function(refId, newStatus) {
      try {
        var list = JSON.parse(localStorage.getItem('enamels_bulk_enquiries') || '[]');
        list.forEach(function(e) {
          if (e.refId === refId) {
            e.status = newStatus;
          }
        });
        localStorage.setItem('enamels_bulk_enquiries', JSON.stringify(list));
      } catch(e) {}
    };

    window.enamelsFilterAdminEnquiries = function(val) {
      renderAdminEnquiries(val);
    };

    // Initialize
    document.addEventListener('DOMContentLoaded', function() {
      renderCategoryCards();
      renderCategoryChips();
      renderArticlesStep();
      renderSizeBreakdownStep();
      updateLiveMeters();
      renderAdminEnquiries();

      // Check URL query ?admin=1
      if (window.location.search.indexOf('admin=1') > -1) {
        window.enamelsToggleAdminBulkPanel();
      }
    });

    // Also run immediately
    renderCategoryCards();
    renderCategoryChips();
    renderArticlesStep();
    renderSizeBreakdownStep();
    updateLiveMeters();
    renderAdminEnquiries();
  })();
</script>
