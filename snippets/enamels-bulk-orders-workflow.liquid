{% comment %}
  Enamels Dedicated Multi-Category & Multi-Article Institutional Bulk Orders Workflow
  Features:
  - Part 2: Pure enquiry / quotation system (Zero fake sales orders, no cart redirect, no inventory deduction)
  - Part 3: Multiple categories in one enquiry (Scrubs, Lab Coats, Caps, Accessories) with multi-select chips
  - Part 4: Multiple articles under each selected category with independent selection
  - Part 5: Independent size-wise breakdown (XS-2XL) per article with live auto-totals (article, category, grand total)
  - Part 6: Enforced 10-unit minimum with live validation alerts & volume tier perks
  - Part 7: Comprehensive customer details & review step, unique ref ID ENM-BLK-2026-XXXX, direct WhatsApp desk trigger
  - Part 8: Admin Bulk Enquiry Management Dashboard with 8-state enquiry workflow & direct WhatsApp/Call actions
  - Part 9: 100% mobile-first card layout with zero horizontal overflow
{% endcomment %}

{%- liquid
  assign min_qty = section.settings.min_order_quantity | default: 10
  assign heading = section.settings.heading | default: 'Institutional & Hospital Bulk Orders' | strip
  assign subtext = section.settings.subtext | default: 'Equip your clinic, hospital department, or medical faculty with Enamels premium tailored uniforms. Minimum order volume: 10 units across any combination of categories.' | strip
  assign max_w = section.settings.container_max_width | default: 1060
  assign raw_wa = settings.whatsapp_number | default: '923011331133'
  assign wa_clean = raw_wa | replace: '+', '' | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', ''
-%}

<div class="enamels-bulk-workflow-wrapper" id="enamels-bulk-workflow-box">
  
  <!-- Header Block -->
  <div class="bulk-workflow-header">
    <div class="bulk-badge-pill">
      <span>🏥</span> INSTITUTIONAL & CLINICAL VOLUME PROGRAM
    </div>
    <h1 class="bulk-main-heading">{{ heading }}</h1>
    <p class="bulk-subheading">{{ subtext }}</p>

    <!-- Admin / Staff Enquiry Desk Toggle -->
    <div class="bulk-staff-toggle-bar">
      <button type="button" class="btn-staff-toggle" id="btn-toggle-admin-panel" onclick="window.enamelsToggleAdminBulkPanel()">
        <span>👔 Enamels Staff: Review Logged Enquiries</span>
        <span class="staff-badge-count" id="staff-enquiry-badge-count">1</span>
      </button>
    </div>
  </div>

  <!-- =========================================================================
       ADMIN BULK ENQUIRY MANAGEMENT DASHBOARD (Part 8)
       Shown when staff toggles the button or ?admin=1 is in URL
       ========================================================================= -->
  <div class="enamels-admin-enquiry-panel" id="enamels-admin-enquiry-panel" style="display: none;">
    <div class="admin-panel-head">
      <div>
        <span class="admin-panel-tag">ENAMELS INTERNAL OPERATIONS DESK</span>
        <h3 class="admin-panel-title">Institutional Bulk Order Enquiries</h3>
        <p class="admin-panel-sub">Review incoming institutional enquiries, size breakdowns, and manage quotation follow-up status.</p>
      </div>
      <button type="button" class="btn-close-admin-panel" onclick="window.enamelsToggleAdminBulkPanel()">✕ Close Panel</button>
    </div>

    <!-- Filter Bar -->
    <div class="admin-filter-bar">
      <span class="filter-lbl">Filter by Status:</span>
      <select id="admin-status-filter" onchange="window.enamelsFilterAdminEnquiries(this.value)">
        <option value="all">All Enquiries</option>
        <option value="New Enquiry">New Enquiry</option>
        <option value="Contact Pending">Contact Pending</option>
        <option value="Contacted">Contacted</option>
        <option value="Quotation Shared">Quotation Shared</option>
        <option value="Negotiation">Negotiation</option>
        <option value="Confirmed">Confirmed</option>
        <option value="Rejected">Rejected</option>
        <option value="Closed">Closed</option>
      </select>
      <button type="button" class="btn-seed-sample" onclick="window.enamelsSeedSampleBulkEnquiry()">
        + Load Sample Enquiry
      </button>
    </div>

    <!-- Enquiry Cards List Container -->
    <div class="admin-enquiries-list" id="admin-enquiries-list">
      <!-- Dynamic enquiry cards rendered by JavaScript -->
    </div>
  </div>

  <!-- =========================================================================
       CUSTOMER 5-STEP ENQUIRY WORKFLOW WIZARD
       ========================================================================= -->
  <div class="bulk-wizard-card" id="bulk-customer-wizard">
    
    <!-- 5-Step Progress Stepper -->
    <div class="bulk-stepper-track">
      <button type="button" class="stepper-node active" id="snode-1" onclick="window.enamelsBulkGoStep(1)">
        <span class="snode-num">1</span>
        <span class="snode-text">Categories</span>
      </button>
      <div class="snode-sep"></div>

      <button type="button" class="stepper-node" id="snode-2" onclick="window.enamelsBulkGoStep(2)">
        <span class="snode-num">2</span>
        <span class="snode-text">Articles</span>
      </button>
      <div class="snode-sep"></div>

      <button type="button" class="stepper-node" id="snode-3" onclick="window.enamelsBulkGoStep(3)">
        <span class="snode-num">3</span>
        <span class="snode-text">Sizes & Quantities</span>
      </button>
      <div class="snode-sep"></div>

      <button type="button" class="stepper-node" id="snode-4" onclick="window.enamelsBulkGoStep(4)">
        <span class="snode-num">4</span>
        <span class="snode-text">Contact Details</span>
      </button>
      <div class="snode-sep"></div>

      <button type="button" class="stepper-node" id="snode-5" onclick="window.enamelsBulkGoStep(5)">
        <span class="snode-num">5</span>
        <span class="snode-text">Review & Submit</span>
      </button>
    </div>

    <!-- Live Grand Total Floating Badge -->
    <div class="bulk-live-meter-strip" id="bulk-live-meter-strip">
      <div class="meter-stat-group">
        <span class="meter-stat-label">Total Enquiry Volume:</span>
        <strong class="meter-stat-count" id="meter-grand-total">0 Units</strong>
      </div>
      <div class="meter-tier-badge" id="meter-tier-badge">
        Minimum 10 Units Required
      </div>
    </div>

    <!-- =======================================================================
         STEP 1: MULTI-CATEGORY SELECTION (Part 3)
         ======================================================================= -->
    <div class="bulk-step-pane active" id="bulk-pane-1">
      <div class="pane-headline">
        <span class="pane-tag">Step 1 of 5</span>
        <h2 class="pane-title">Select Uniform Categories</h2>
        <p class="pane-desc">You can select one, two, or multiple categories in a single bulk enquiry. Click each category to add or remove it.</p>
      </div>

      <!-- Active Selected Categories Chips Bar -->
      <div class="selected-categories-chips-wrap" id="selected-categories-chips-wrap">
        <span class="chips-label">Selected Categories (<span id="cat-chips-count">1</span>):</span>
        <div class="chips-container" id="cat-chips-container">
          <!-- Dynamic category chips -->
        </div>
      </div>

      <!-- Categories Cards Grid -->
      <div class="bulk-categories-grid">
        
        <!-- Category: Scrubs -->
        <div class="bulk-cat-toggle-card selected" data-cat-id="scrubs" onclick="window.enamelsToggleCategory('scrubs')">
          <div class="cat-card-check">✓</div>
          <div class="cat-card-media">
            <img src="{{ 'cat-men-scrubs.jpg' | asset_url }}" alt="Medical Scrubs" width="280" height="150" loading="lazy">
          </div>
          <div class="cat-card-body">
            <h3 class="cat-card-title">Medical Scrubs</h3>
            <p class="cat-card-desc">Surgical tops, joggers, and cargo scrub trousers in 4-way stretch antimicrobial fabrics.</p>
            <span class="cat-card-action">✓ Category Selected</span>
          </div>
        </div>

        <!-- Category: Lab Coats -->
        <div class="bulk-cat-toggle-card" data-cat-id="lab_coats" onclick="window.enamelsToggleCategory('lab_coats')">
          <div class="cat-card-check">✓</div>
          <div class="cat-card-media">
            <img src="{{ 'cat-labcoat.jpg' | asset_url }}" alt="Doctor & Lab Coats" width="280" height="150" loading="lazy">
          </div>
          <div class="cat-card-body">
            <h3 class="cat-card-title">Doctor & Lab Coats</h3>
            <p class="cat-card-desc">Consultant notched lapel coats, resident lab coats, and spill-resistant clinical white coats.</p>
            <span class="cat-card-action">+ Click to Select</span>
          </div>
        </div>

        <!-- Category: Caps -->
        <div class="bulk-cat-toggle-card" data-cat-id="caps" onclick="window.enamelsToggleCategory('caps')">
          <div class="cat-card-check">✓</div>
          <div class="cat-card-media">
            <img src="{{ 'banner-caps.jpg' | asset_url }}" alt="Surgical Scrub Caps" width="280" height="150" loading="lazy">
          </div>
          <div class="cat-card-body">
            <h3 class="cat-card-title">Surgical Scrub Caps</h3>
            <p class="cat-card-desc">Ergonomic tie-back and bouffant scrub caps with absorbent sweatband lining.</p>
            <span class="cat-card-action">+ Click to Select</span>
          </div>
        </div>

        <!-- Category: Accessories -->
        <div class="bulk-cat-toggle-card" data-cat-id="accessories" onclick="window.enamelsToggleCategory('accessories')">
          <div class="cat-card-check">✓</div>
          <div class="cat-card-media">
            <img src="{{ 'cat-clogs.jpg' | asset_url }}" alt="Accessories & Sleeves" width="280" height="150" loading="lazy">
          </div>
          <div class="cat-card-body">
            <h3 class="cat-card-title">Accessories & Sleeves</h3>
            <p class="cat-card-desc">Medical arm sleeves, non-slip theatre clogs, badge reels, and hospital accessories.</p>
            <span class="cat-card-action">+ Click to Select</span>
          </div>
        </div>

      </div>

      <div class="bulk-pane-actions" style="justify-content: flex-end;">
        <button type="button" class="btn-bulk-step-next" id="btn-next-to-articles" onclick="window.enamelsBulkGoStep(2)">
          <span>Next: Select Articles</span>
          <span>→</span>
        </button>
      </div>
    </div>

    <!-- =======================================================================
         STEP 2: MULTI-ARTICLE SELECTION PER CATEGORY (Part 4)
         ======================================================================= -->
    <div class="bulk-step-pane" id="bulk-pane-2">
      <div class="pane-headline">
        <span class="pane-tag">Step 2 of 5</span>
        <h2 class="pane-title">Select Articles for Each Category</h2>
        <p class="pane-desc">Select the specific garment styles you require under each chosen category. You can choose multiple articles per category.</p>
      </div>

      <!-- Category Filter Tabs for Quick Jump -->
      <div class="category-jump-tabs" id="article-category-jump-tabs">
        <!-- Dynamic tabs generated by script -->
      </div>

      <!-- Articles Container Grouped by Selected Categories -->
      <div class="category-articles-supergroup" id="category-articles-supergroup">
        <!-- Injected dynamically per selected categories -->
      </div>

      <div class="bulk-pane-actions">
        <button type="button" class="btn-bulk-step-prev" onclick="window.enamelsBulkGoStep(1)">← Back to Categories</button>
        <button type="button" class="btn-bulk-step-next" id="btn-next-to-sizes" onclick="window.enamelsBulkGoStep(3)">
          <span>Next: Sizes & Quantities</span>
          <span>→</span>
        </button>
      </div>
    </div>

    <!-- =======================================================================
         STEP 3: MULTI-QUANTITY & SIZE BREAKDOWN (Part 5 & 6)
         ======================================================================= -->
    <div class="bulk-step-pane" id="bulk-pane-3">
      <div class="pane-headline">
        <span class="pane-tag">Step 3 of 5</span>
        <h2 class="pane-title">Sizes & Volume Breakdown</h2>
        <p class="pane-desc">Specify independent quantities across XS to 2XL for every chosen article. Minimum overall enquiry volume: 10 units.</p>
      </div>

      <!-- Volume Tier Perks Banner -->
      <div class="bulk-tier-banner">
        <div class="tier-pill-card active" id="tier-pill-1">
          <span class="tp-lbl">Tier 1</span>
          <strong class="tp-range">10 – 20 Units</strong>
          <span class="tp-perk">Standard Wholesale Pricing • Departmental Packaging</span>
        </div>
        <div class="tier-pill-card" id="tier-pill-2">
          <span class="tp-lbl">Tier 2</span>
          <strong class="tp-range">21 – 40 Units</strong>
          <span class="tp-perk">Volume Discount Tier • Priority Factory Batch</span>
        </div>
        <div class="tier-pill-card" id="tier-pill-3">
          <span class="tp-lbl">Tier 3</span>
          <strong class="tp-range">41 – 50+ Units</strong>
          <span class="tp-perk">Enterprise Tier • Complimentary Custom Crest Embroidery</span>
        </div>
      </div>

      <!-- Per-Article Size Steppers Cards Container -->
      <div class="articles-size-breakdown-list" id="articles-size-breakdown-list">
        <!-- Injected dynamically for each selected article -->
      </div>

      <!-- Minimum 10 Unit Alert Message -->
      <div class="bulk-validation-alert" id="bulk-min-qty-alert" style="display: none;">
        <span class="alert-icon">⚠️</span>
        <div class="alert-text">
          <strong>Minimum Volume Notice:</strong> The total bulk enquiry must contain at least 10 units across all selected articles. Current total: <span id="alert-current-total">0</span> units (Please add <span id="alert-needed-qty">10</span> more units).
        </div>
      </div>

      <div class="bulk-pane-actions">
        <button type="button" class="btn-bulk-step-prev" onclick="window.enamelsBulkGoStep(2)">← Back to Articles</button>
        <button type="button" class="btn-bulk-step-next" id="btn-next-to-details" onclick="window.enamelsBulkGoStep(4)">
          <span>Next: Contact Details</span>
          <span>→</span>
        </button>
      </div>
    </div>

    <!-- =======================================================================
         STEP 4: CUSTOMER INFORMATION FORM (Part 7)
         ======================================================================= -->
    <div class="bulk-step-pane" id="bulk-pane-4">
      <div class="pane-headline">
        <span class="pane-tag">Step 4 of 5</span>
        <h2 class="pane-title">Institutional Contact Details</h2>
        <p class="pane-desc">Our uniforms team will use these contact details to review your specifications and send a formal wholesale quotation.</p>
      </div>

      <div class="bulk-form-grid">
        <div class="form-group">
          <label class="form-label" for="bulk-inp-name">Full Name <span class="req">*</span></label>
          <input type="text" id="bulk-inp-name" class="form-control" placeholder="Dr. Sarah Ahmed" required />
        </div>

        <div class="form-group">
          <label class="form-label" for="bulk-inp-hospital">Hospital / Clinic / Organization Name <span class="req">*</span></label>
          <input type="text" id="bulk-inp-hospital" class="form-control" placeholder="Services Hospital / Shaukat Khanum" required />
        </div>

        <div class="form-group">
          <label class="form-label" for="bulk-inp-phone">Phone Number <span class="req">*</span></label>
          <input type="tel" id="bulk-inp-phone" class="form-control" placeholder="0300 8472910" required />
        </div>

        <div class="form-group">
          <label class="form-label" for="bulk-inp-whatsapp">WhatsApp Number <span class="req">*</span></label>
          <input type="tel" id="bulk-inp-whatsapp" class="form-control" placeholder="0300 8472910 (For receiving quote)" required />
        </div>

        <div class="form-group">
          <label class="form-label" for="bulk-inp-email">Official Email Address</label>
          <input type="email" id="bulk-inp-email" class="form-control" placeholder="sarah.ahmed@hospital.org.pk" />
        </div>

        <div class="form-group">
          <label class="form-label" for="bulk-inp-city">Delivery City <span class="req">*</span></label>
          <input type="text" id="bulk-inp-city" class="form-control" placeholder="Lahore / Karachi / Islamabad / Peshawar" required />
        </div>

        <div class="form-group full-width">
          <label class="form-label" for="bulk-inp-address">Department / Delivery Address</label>
          <input type="text" id="bulk-inp-address" class="form-control" placeholder="Department of Cardiology, Main Block, 3rd Floor" />
        </div>

        <div class="form-group full-width">
          <label class="form-label" for="bulk-inp-notes">Additional Requirements / Notes</label>
          <textarea id="bulk-inp-notes" class="form-control" rows="3" placeholder="Enter custom embroidery crest preferences, specific fabric shades, delivery date constraints, or invoice requirements."></textarea>
        </div>
      </div>

      <div class="bulk-pane-actions">
        <button type="button" class="btn-bulk-step-prev" onclick="window.enamelsBulkGoStep(3)">← Back to Quantities</button>
        <button type="button" class="btn-bulk-step-next" id="btn-next-to-review" onclick="window.enamelsBulkGoStep(5)">
          <span>Next: Review & Submit</span>
          <span>→</span>
        </button>
      </div>
    </div>

    <!-- =======================================================================
         STEP 5: REVIEW & ENQUIRY SUBMISSION (Part 7)
         ======================================================================= -->
    <div class="bulk-step-pane" id="bulk-pane-5">
      <div class="pane-headline">
        <span class="pane-tag">Step 5 of 5</span>
        <h2 class="pane-title">Review Your Bulk Order Enquiry</h2>
        <p class="pane-desc">Please verify your selections. Submitting this enquiry does not charge payment or place an order.</p>
      </div>

      <!-- Enquiry Reference Card -->
      <div class="enquiry-ref-banner">
        <div>
          <span class="ref-sub-title">Generated Enquiry Reference</span>
          <strong class="ref-code" id="rev-ref-id-code">ENM-BLK-2026-XXXX</strong>
        </div>
        <div class="ref-type-tag">
          Official Institutional Quotation Request
        </div>
      </div>

      <!-- Itemized Category & Article Breakdown Table -->
      <div class="review-table-card">
        <h3 class="review-card-heading">Selected Categories & Size Quantities</h3>
        <div id="review-breakdown-table-container">
          <!-- Populated dynamically with category, article, and size rows -->
        </div>

        <!-- Grand Total Strip -->
        <div class="review-grand-total-row">
          <span>Overall Enquiry Quantity:</span>
          <strong id="rev-grand-total-units">0 Units</strong>
        </div>
      </div>

      <!-- Customer Summary Card -->
      <div class="review-contact-card">
        <h3 class="review-card-heading">Contact & Hospital Specifications</h3>
        <div class="review-contact-grid">
          <div><span class="rc-k">Full Name:</span> <strong class="rc-v" id="rev-name-val">-</strong></div>
          <div><span class="rc-k">Organization:</span> <strong class="rc-v" id="rev-hospital-val">-</strong></div>
          <div><span class="rc-k">Phone:</span> <strong class="rc-v" id="rev-phone-val">-</strong></div>
          <div><span class="rc-k">WhatsApp:</span> <strong class="rc-v" id="rev-whatsapp-val">-</strong></div>
          <div><span class="rc-k">City:</span> <strong class="rc-v" id="rev-city-val">-</strong></div>
          <div><span class="rc-k">Email:</span> <span class="rc-v" id="rev-email-val">-</span></div>
          <div class="full-col"><span class="rc-k">Address:</span> <span class="rc-v" id="rev-address-val">-</span></div>
          <div class="full-col"><span class="rc-k">Notes:</span> <span class="rc-v" id="rev-notes-val">None</span></div>
        </div>
      </div>

      <!-- Non-Binding Business Rule Notice (Part 2) -->
      <div class="zero-obligation-box">
        <div class="zo-icon">🔒</div>
        <div class="zo-text">
          <strong>Zero-Obligation Quotation Request:</strong>
          This form is an institutional enquiry, not a paid checkout order. No payment is charged and no inventory is deducted. Our sales team will contact you via phone or WhatsApp to finalize volume discounts, provide physical sample swatches if required, and confirm production delivery timelines.
        </div>
      </div>

      <div class="bulk-pane-actions">
        <button type="button" class="btn-bulk-step-prev" onclick="window.enamelsBulkGoStep(4)">← Back to Details</button>
        <button type="button" class="btn-submit-enquiry-final" id="btn-submit-enquiry-final" onclick="window.enamelsSubmitBulkEnquiry()">
          <span>Submit Bulk Enquiry</span>
          <span>✓</span>
        </button>
      </div>
    </div>

    <!-- =======================================================================
         SUCCESS SCREEN (Part 7)
         ======================================================================= -->
    <div class="bulk-step-pane" id="bulk-pane-success" style="display: none;">
      <div class="success-screen-card">
        <div class="success-emoji">🎉</div>
        <h2 class="success-title">Bulk Order Enquiry Received!</h2>
        
        <p class="success-official-msg">
          "Thank you for contacting Enamels for a bulk order. Your enquiry has been received successfully. Our team will contact you through phone or WhatsApp to discuss your requirements and finalize your order."
        </p>

        <div class="success-meta-box">
          <div class="meta-item">
            <span class="meta-k">Enquiry Reference Number:</span>
            <strong class="meta-v" id="success-ref-id">ENM-BLK-2026-XXXX</strong>
          </div>
          <div class="meta-item">
            <span class="meta-k">Total Garment Units:</span>
            <strong class="meta-v" id="success-total-units">0 Units</strong>
          </div>
          <div class="meta-item">
            <span class="meta-k">Follow-Up Channel:</span>
            <strong class="meta-v">Official Enamels WhatsApp / Phone Desk</strong>
          </div>
        </div>

        <div class="success-wa-trigger-box">
          <p class="wa-trigger-lead">
            For expedited wholesale quotation processing, you can connect directly with our institutional desk:
          </p>
          <a href="#" id="success-wa-direct-btn" target="_blank" class="btn-direct-wa-desk">
            <span>💬 Connect on WhatsApp with Reference #</span>
          </a>
        </div>

        <div class="success-back-row">
          <button type="button" class="btn-reset-workflow" onclick="window.enamelsResetBulkWorkflow()">
            + Submit Another Enquiry
          </button>
          <a href="/" class="btn-return-storefront">
            Return to Storefront
          </a>
        </div>
      </div>
    </div>

  </div>

</div>

<style>
  .enamels-bulk-workflow-wrapper {
    max-width: {{ max_w }}px;
    margin: 0 auto;
    padding: 20px 16px 60px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #102a43;
    box-sizing: border-box;
  }

  .bulk-workflow-header {
    text-align: center;
    margin-bottom: 24px;
  }

  .bulk-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(0, 135, 121, 0.08);
    color: #008779;
    border: 1px solid rgba(0, 135, 121, 0.25);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .bulk-main-heading {
    font-size: 32px;
    font-weight: 800;
    color: #102a43;
    margin: 0 0 10px;
    letter-spacing: -0.02em;
  }

  .bulk-subheading {
    font-size: 15px;
    color: #64748b;
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .bulk-staff-toggle-bar {
    margin-top: 14px;
  }

  .btn-staff-toggle {
    background: #0f172a;
    color: #f8fafc;
    border: none;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: background 0.2s;
  }

  .btn-staff-toggle:hover {
    background: #1e293b;
  }

  .staff-badge-count {
    background: #008779;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 999px;
  }

  /* Admin Panel */
  .enamels-admin-enquiry-panel {
    background: #ffffff;
    border: 2px solid #0f172a;
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 24px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
  }

  .admin-panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: 1.5px solid #e2e8f0;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .admin-panel-tag {
    font-size: 11px;
    font-weight: 800;
    color: #008779;
    letter-spacing: 0.05em;
  }

  .admin-panel-title {
    margin: 2px 0;
    font-size: 20px;
    font-weight: 800;
    color: #0f172a;
  }

  .admin-panel-sub {
    margin: 0;
    font-size: 13px;
    color: #64748b;
  }

  .btn-close-admin-panel {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    padding: 6px 12px;
    border-radius: 6px;
    font-weight: 700;
    cursor: pointer;
    font-size: 12px;
  }

  .admin-filter-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
    font-size: 13px;
  }

  .admin-filter-bar select {
    padding: 6px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
  }

  .btn-seed-sample {
    background: #f0fdfa;
    color: #008779;
    border: 1px solid #99f6e4;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }

  .admin-enquiries-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-height: 600px;
    overflow-y: auto;
  }

  .admin-enquiry-card {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 16px;
    transition: border-color 0.2s;
  }

  .admin-enquiry-card:hover {
    border-color: #008779;
  }

  .aec-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 10px;
  }

  .aec-ref-code {
    font-family: monospace;
    font-size: 15px;
    font-weight: 800;
    color: #0f172a;
  }

  .aec-date {
    font-size: 12px;
    color: #64748b;
  }

  .status-select-wrap select {
    font-size: 12px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid #cbd5e1;
  }

  .aec-customer-info {
    font-size: 13px;
    margin-bottom: 12px;
    color: #334e68;
    line-height: 1.5;
  }

  .aec-breakdown-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 10px 14px;
    font-size: 12.5px;
    margin-bottom: 12px;
  }

  .aec-actions {
    display: flex;
    gap: 10px;
  }

  .aec-btn-wa {
    background: #25d366;
    color: #ffffff;
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 6px;
  }

  .aec-btn-call {
    background: #102a43;
    color: #ffffff;
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 6px;
  }

  /* Wizard Card */
  .bulk-wizard-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    padding: 28px 24px;
  }

  /* Stepper Track */
  .bulk-stepper-track {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 16px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .bulk-stepper-track::-webkit-scrollbar { display: none; }

  .stepper-node {
    display: flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 6px 10px;
    border-radius: 8px;
    white-space: nowrap;
    transition: all 0.2s;
  }

  .snode-num {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #e2e8f0;
    color: #475569;
    font-size: 12px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stepper-node.active .snode-num,
  .stepper-node.completed .snode-num {
    background: #008779;
    color: #ffffff;
  }

  .snode-text {
    font-size: 13px;
    font-weight: 600;
    color: #64748b;
  }

  .stepper-node.active .snode-text {
    color: #008779;
    font-weight: 800;
  }

  .snode-sep {
    flex: 1;
    height: 2px;
    background: #e2e8f0;
    margin: 0 8px;
    min-width: 16px;
  }

  /* Live Meter Strip */
  .bulk-live-meter-strip {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .meter-stat-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .meter-stat-label {
    font-size: 13px;
    color: #64748b;
    font-weight: 600;
  }

  .meter-stat-count {
    font-size: 18px;
    font-weight: 800;
    color: #102a43;
  }

  .meter-stat-count.valid {
    color: #008779;
  }

  .meter-tier-badge {
    font-size: 12px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 999px;
    background: #f1f5f9;
    color: #475569;
  }

  .meter-tier-badge.badge-valid {
    background: #dcfce7;
    color: #15803d;
  }

  .meter-tier-badge.badge-invalid {
    background: #fee2e2;
    color: #b91c1c;
  }

  /* Panes */
  .bulk-step-pane {
    display: none;
  }

  .bulk-step-pane.active {
    display: block;
  }

  .pane-headline {
    margin-bottom: 20px;
  }

  .pane-tag {
    font-size: 11px;
    text-transform: uppercase;
    color: #008779;
    font-weight: 800;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 2px;
  }

  .pane-title {
    margin: 0 0 6px;
    font-size: 22px;
    font-weight: 800;
    color: #102a43;
  }

  .pane-desc {
    margin: 0;
    font-size: 14px;
    color: #64748b;
    line-height: 1.5;
  }

  /* Chips Bar */
  .selected-categories-chips-wrap {
    background: #f0fdfa;
    border: 1px solid #ccfbf1;
    border-radius: 8px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .chips-label {
    font-size: 12.5px;
    font-weight: 700;
    color: #0f766e;
  }

  .chips-container {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .cat-chip {
    background: #008779;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .cat-chip-remove {
    cursor: pointer;
    font-weight: 900;
    font-size: 11px;
    opacity: 0.8;
  }
  .cat-chip-remove:hover { opacity: 1; }

  /* Categories Cards Grid */
  .bulk-categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 28px;
  }

  .bulk-cat-toggle-card {
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    background: #ffffff;
    cursor: pointer;
    position: relative;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .bulk-cat-toggle-card:hover {
    border-color: #008779;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 135, 121, 0.12);
  }

  .bulk-cat-toggle-card.selected {
    border-color: #008779;
    background: #f0fdfa;
    box-shadow: 0 0 0 2px rgba(0, 135, 121, 0.25);
  }

  .cat-card-check {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #cbd5e1;
    color: #ffffff;
    font-size: 12px;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background 0.2s;
  }

  .bulk-cat-toggle-card.selected .cat-card-check {
    background: #008779;
  }

  .cat-card-media {
    height: 140px;
    background: #f1f5f9;
    overflow: hidden;
  }

  .cat-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cat-card-body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
  }

  .cat-card-title {
    margin: 0 0 4px;
    font-size: 16px;
    font-weight: 800;
    color: #102a43;
  }

  .cat-card-desc {
    margin: 0 0 12px;
    font-size: 12px;
    color: #64748b;
    line-height: 1.4;
  }

  .cat-card-action {
    font-size: 12px;
    font-weight: 700;
    color: #008779;
  }

  /* Articles Supergroup */
  .category-jump-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .btn-cat-tab {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    color: #475569;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s;
  }

  .btn-cat-tab.active {
    background: #008779;
    color: #ffffff;
    border-color: #008779;
  }

  .cat-articles-section {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    padding: 18px;
    margin-bottom: 24px;
  }

  .cat-articles-section-title {
    font-size: 18px;
    font-weight: 800;
    color: #102a43;
    margin: 0 0 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cat-article-badge-count {
    font-size: 12px;
    font-weight: 700;
    background: #e2e8f0;
    color: #475569;
    padding: 3px 10px;
    border-radius: 999px;
  }

  .articles-grid-sub {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 14px;
  }

  .bulk-article-toggle-card {
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    transition: all 0.2s;
  }

  .bulk-article-toggle-card:hover {
    border-color: #008779;
    box-shadow: 0 4px 12px rgba(0, 135, 121, 0.1);
  }

  .bulk-article-toggle-card.selected {
    border-color: #008779;
    background: #f0fdfa;
    box-shadow: 0 0 0 2px rgba(0, 135, 121, 0.2);
  }

  .article-thumb {
    height: 130px;
    background: #f1f5f9;
  }

  .article-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-body {
    padding: 12px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
  }

  .article-title {
    margin: 0 0 4px;
    font-size: 14px;
    font-weight: 800;
    color: #102a43;
  }

  .article-spec {
    font-size: 11.5px;
    color: #64748b;
    margin-bottom: 10px;
    line-height: 1.4;
  }

  .article-toggle-btn {
    font-size: 11.5px;
    font-weight: 700;
    color: #008779;
  }

  /* Step 3: Size breakdown */
  .bulk-tier-banner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 24px;
  }

  .tier-pill-card {
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    padding: 10px 14px;
    background: #f8fafc;
    text-align: center;
  }

  .tier-pill-card.active {
    border-color: #008779;
    background: #f0fdfa;
  }

  .tp-lbl {
    font-size: 11px;
    font-weight: 800;
    color: #64748b;
    text-transform: uppercase;
    display: block;
  }
  .tier-pill-card.active .tp-lbl { color: #008779; }

  .tp-range {
    font-size: 15px;
    font-weight: 800;
    color: #102a43;
    display: block;
  }

  .tp-perk {
    font-size: 11px;
    color: #475569;
    margin-top: 3px;
    display: block;
  }

  .article-size-card {
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 12px;
    padding: 18px;
    margin-bottom: 20px;
  }

  .asc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 10px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .asc-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .asc-cat-tag {
    font-size: 11px;
    font-weight: 800;
    color: #008779;
    text-transform: uppercase;
  }

  .asc-title {
    font-size: 16px;
    font-weight: 800;
    color: #102a43;
    margin: 0;
  }

  .asc-meta-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .asc-item-total {
    font-size: 14px;
    font-weight: 800;
    color: #102a43;
    background: #f1f5f9;
    padding: 4px 10px;
    border-radius: 6px;
  }

  .btn-remove-article-breakdown {
    background: transparent;
    border: 1px solid #fca5a5;
    color: #dc2626;
    font-size: 11.5px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    cursor: pointer;
  }
  .btn-remove-article-breakdown:hover {
    background: #fee2e2;
  }

  .sizes-steppers-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
  }

  .size-cell-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 10px 6px;
    text-align: center;
  }

  .size-label {
    font-size: 13px;
    font-weight: 800;
    color: #102a43;
    margin-bottom: 8px;
    display: block;
  }

  .stepper-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }

  .btn-step-act {
    width: 28px;
    height: 28px;
    border-radius: 4px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    font-size: 15px;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .btn-step-act:hover {
    background: #008779;
    color: #ffffff;
    border-color: #008779;
  }

  .size-qty-input {
    width: 38px;
    height: 28px;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    text-align: center;
    font-size: 13px;
    font-weight: 700;
  }

  .bulk-validation-alert {
    background: #fef2f2;
    border: 1.5px solid #fca5a5;
    border-radius: 10px;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    color: #991b1b;
    font-size: 13.5px;
  }

  .alert-icon {
    font-size: 22px;
  }

  /* Step 4 Form */
  .bulk-form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group.full-width {
    grid-column: 1 / -1;
  }

  .form-label {
    font-size: 13px;
    font-weight: 700;
    color: #102a43;
  }

  .form-label .req {
    color: #dc2626;
  }

  .form-control {
    padding: 11px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 14px;
    color: #102a43;
    background: #ffffff;
    box-sizing: border-box;
  }

  .form-control:focus {
    outline: none;
    border-color: #008779;
    box-shadow: 0 0 0 3px rgba(0, 135, 121, 0.15);
  }

  /* Step 5 Review */
  .enquiry-ref-banner {
    background: #102a43;
    color: #ffffff;
    padding: 14px 18px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ref-sub-title {
    font-size: 11.5px;
    text-transform: uppercase;
    color: #94a3b8;
    display: block;
    letter-spacing: 0.05em;
  }

  .ref-code {
    font-family: monospace;
    font-size: 18px;
    color: #38bdf8;
    letter-spacing: 0.05em;
  }

  .ref-type-tag {
    font-size: 11.5px;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.15);
    padding: 4px 10px;
    border-radius: 4px;
  }

  .review-table-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 18px;
    margin-bottom: 20px;
  }

  .review-card-heading {
    margin: 0 0 14px;
    font-size: 15px;
    font-weight: 800;
    color: #102a43;
  }

  .review-cat-row {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 12px;
  }

  .rcr-title {
    font-size: 14px;
    font-weight: 800;
    color: #008779;
    margin-bottom: 6px;
    display: flex;
    justify-content: space-between;
  }

  .rcr-article-line {
    font-size: 13px;
    padding: 4px 0;
    display: flex;
    justify-content: space-between;
    border-bottom: 1px dashed #f1f5f9;
  }
  .rcr-article-line:last-child { border-bottom: none; }

  .review-grand-total-row {
    border-top: 2px solid #cbd5e1;
    padding-top: 10px;
    margin-top: 10px;
    display: flex;
    justify-content: space-between;
    font-size: 16px;
    font-weight: 800;
    color: #102a43;
  }

  .review-contact-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 18px;
    margin-bottom: 20px;
  }

  .review-contact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 16px;
    font-size: 13px;
  }

  .review-contact-grid .full-col {
    grid-column: 1 / -1;
  }

  .rc-k {
    color: #64748b;
    font-weight: 600;
  }
  .rc-v {
    color: #102a43;
  }

  .zero-obligation-box {
    background: #f0fdfa;
    border: 1px solid #99f6e4;
    border-radius: 8px;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
    font-size: 13px;
    color: #0f766e;
    line-height: 1.5;
  }

  .zo-icon {
    font-size: 24px;
    flex-shrink: 0;
  }

  /* Actions */
  .bulk-pane-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #f1f5f9;
    padding-top: 20px;
    margin-top: 24px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .btn-bulk-step-prev {
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    color: #475569;
    padding: 11px 22px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
  }

  .btn-bulk-step-next {
    background: #008779;
    color: #ffffff;
    border: none;
    padding: 12px 28px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 4px 14px rgba(0, 135, 121, 0.25);
  }

  .btn-bulk-step-next:disabled {
    background: #cbd5e1;
    color: #94a3b8;
    cursor: not-allowed;
    box-shadow: none;
  }

  .btn-submit-enquiry-final {
    background: #102a43;
    color: #ffffff;
    border: none;
    padding: 14px 34px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 800;
    cursor: pointer;
    display: inline-flex;
