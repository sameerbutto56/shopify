    color: #ffffff;
    text-decoration: none;
    font-size: 14.5px;
    font-weight: 800;
    padding: 12px 24px;
    border-radius: 8px;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.3);
  }

  .success-back-row {
    display: flex;
    justify-content: center;
    gap: 12px;
  }

  .btn-reset-workflow {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
