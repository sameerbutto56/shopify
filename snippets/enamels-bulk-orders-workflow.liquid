    font-size: 13px;
    font-weight: 700;
    padding: 10px 18px;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .btn-success-whatsapp:hover { background: #1ebe57; }
  .btn-reset-bulk {
    background: none;
    border: none;
    color: #008779;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    text-decoration: underline;
  }
</style>

<script>
  (function initSimplifiedBulkWorkflow() {
    var selectedQtyRange = '10 – 20 Units';
    var selectedCategory = '';

    window.enamelsSetQtyRange = function(rangeKey, el) {
      selectedQtyRange = rangeKey;
      var pills = document.querySelectorAll('.qty-range-pill');
      pills.forEach(function(p) { p.classList.remove('active'); });
      if (el) {
        el.classList.add('active');
        var inp = el.querySelector('input');
        if (inp) inp.checked = true;
      }
    };

    window.enamelsUpdateBulkCategory = function(catVal) {
      selectedCategory = catVal;
    };

    window.enamelsHandleBulkSubmit = function(e) {
      e.preventDefault();
      var cat = document.getElementById('bulk-category-select').value;
      var name = document.getElementById('bulk-cust-name').value.trim();
      var org = document.getElementById('bulk-org-name').value.trim();
      var phone = document.getElementById('bulk-phone').value.trim();
      var email = document.getElementById('bulk-email').value.trim();
      var city = document.getElementById('bulk-city').value.trim();
      var notes = document.getElementById('bulk-notes').value.trim();

      if (!cat) {
        alert('Please choose a uniform category.');
        document.getElementById('bulk-category-select').focus();
        return;
      }

      var randomNum = Math.floor(1000 + Math.random() * 9000);
      var refId = 'ENM-BLK-2026-' + randomNum;

      var newEnquiry = {
        refId: refId,
        date: new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }),
        category: cat,
        qtyRange: selectedQtyRange,
        customerName: name,
        organization: org,
        phone: phone,
        email: email,
        city: city,
        notes: notes || 'Standard institutional quotation requested.',
        status: 'New Enquiry'
      };

      // Persist to localStorage for Admin Desk
      try {
        var existing = JSON.parse(localStorage.getItem('enamels_bulk_enquiries') || '[]');
        existing.unshift(newEnquiry);
        localStorage.setItem('enamels_bulk_enquiries', JSON.stringify(existing));
      } catch (err) {}

      // Update success card view
      var formEl = document.getElementById('enamels-bulk-enquiry-form');
      var successCard = document.getElementById('bulk-success-card');
      var refEl = document.getElementById('success-ref-id');
      var waRefEl = document.getElementById('wa-link-ref-id');
      var waBtn = document.getElementById('btn-success-wa-link');

      if (refEl) refEl.textContent = refId;
      if (waRefEl) waRefEl.textContent = refId;

      if (waBtn) {
        var waNum = '{{ wa_clean }}';
        var waMsg = 'Hello Enamels Institutional Desk, I have submitted Bulk Enquiry Reference ' + refId +
                    ' for ' + org + ' (' + cat + ', ' + selectedQtyRange + '). Please share quotation details.';
        waBtn.href = 'https://wa.me/' + waNum + '?text=' + encodeURIComponent(waMsg);
      }

      if (formEl) formEl.style.display = 'none';
      if (successCard) successCard.style.display = 'block';

      // Update Admin badge & render list
      renderAdminEnquiries();
      var root = document.getElementById('enamels-bulk-workflow-box');
      if (root) root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    window.enamelsResetBulkForm = function() {
      var formEl = document.getElementById('enamels-bulk-enquiry-form');
      var successCard = document.getElementById('bulk-success-card');
      if (formEl) {
        formEl.reset();
        formEl.style.display = 'block';
      }
      if (successCard) successCard.style.display = 'none';
    };

    // Admin Desk Handlers
    window.enamelsToggleAdminBulkPanel = function() {
      var panel = document.getElementById('enamels-admin-enquiry-panel');
      if (!panel) return;
      var isOpen = panel.style.display === 'block';
      panel.style.display = isOpen ? 'none' : 'block';
      if (!isOpen) {
        renderAdminEnquiries();
        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

    window.enamelsFilterAdminEnquiries = function(statusFilter) {
      renderAdminEnquiries(statusFilter);
    };

    window.enamelsSeedSampleBulkEnquiry = function() {
      var sample = {
        refId: 'ENM-BLK-2026-8812',
        date: '05 Nov 2026',
        category: 'Medical Scrubs (Sets, Tops & Cargo Trousers)',
        qtyRange: '50 – 100 Units',
        customerName: 'Prof. Dr. Tariq Mahmood',
        organization: 'Shaukat Khanum Memorial Cancer Hospital',
        phone: '+92 300 8472910',
        email: 'procurement@skm.org.pk',
        city: 'Lahore',
        notes: 'Royal Navy scrubs required with custom Hospital Crest embroidery on left sleeve. Delivery needed before December rounds.',
        status: 'Contact Pending'
      };
      try {
        var existing = JSON.parse(localStorage.getItem('enamels_bulk_enquiries') || '[]');
        existing.unshift(sample);
        localStorage.setItem('enamels_bulk_enquiries', JSON.stringify(existing));
      } catch (e) {}
      renderAdminEnquiries();
    };

    function renderAdminEnquiries(filter) {
      var container = document.getElementById('admin-enquiries-list');
      var badgeCount = document.getElementById('staff-enquiry-badge-count');
      if (!container) return;

      var enquiries = [];
      try {
        enquiries = JSON.parse(localStorage.getItem('enamels_bulk_enquiries') || '[]');
      } catch (e) {}

      // Add default sample if none
      if (enquiries.length === 0) {
        enquiries = [{
          refId: 'ENM-BLK-2026-7241',
          date: '04 Nov 2026',
          category: 'Medical Scrubs (Sets, Tops & Cargo Trousers)',
          qtyRange: '20 – 50 Units',
          customerName: 'Dr. Sarah Ahmed (Chief Administrator)',
          organization: 'Services Hospital Surgical Department',
          phone: '+92 300 1234567',
          email: 'surgical.services@punjab.gov.pk',
          city: 'Lahore',
          notes: 'Ceil Blue 4-way flex twill scrubs with doctor name embroidery.',
          status: 'New Enquiry'
        }];
        try { localStorage.setItem('enamels_bulk_enquiries', JSON.stringify(enquiries)); } catch(e) {}
      }

      if (badgeCount) badgeCount.textContent = enquiries.length;

      var filtered = enquiries.filter(function(enq) {
        if (!filter || filter === 'all') return true;
        return enq.status === filter;
      });

      if (filtered.length === 0) {
        container.innerHTML = '<p style="font-size: 13px; color: #64748b; text-align: center; padding: 20px;">No enquiries match the selected filter.</p>';
        return;
      }

      container.innerHTML = filtered.map(function(enq, idx) {
        var cleanPhone = (enq.phone || '').replace(/[^0-9]/g, '');
        var waHref = 'https://wa.me/' + cleanPhone + '?text=' + encodeURIComponent('Hello ' + enq.customerName + ', this is Enamels Institutional Desk regarding your Bulk Order Enquiry ' + enq.refId + ' for ' + enq.organization + '.');
        return '<div class="admin-enquiry-card-item">' +
                 '<div class="enq-card-head">' +
                   '<span class="enq-ref">' + enq.refId + ' • ' + enq.organization + '</span>' +
                   '<select class="enq-status-select" onchange="window.enamelsUpdateEnquiryStatus(\'' + enq.refId + '\', this.value)">' +
                     '<option value="New Enquiry"' + (enq.status === 'New Enquiry' ? ' selected' : '') + '>New Enquiry</option>' +
                     '<option value="Contact Pending"' + (enq.status === 'Contact Pending' ? ' selected' : '') + '>Contact Pending</option>' +
                     '<option value="Contacted"' + (enq.status === 'Contacted' ? ' selected' : '') + '>Contacted</option>' +
                     '<option value="Quotation Shared"' + (enq.status === 'Quotation Shared' ? ' selected' : '') + '>Quotation Shared</option>' +
                     '<option value="Negotiation"' + (enq.status === 'Negotiation' ? ' selected' : '') + '>Negotiation</option>' +
                     '<option value="Confirmed"' + (enq.status === 'Confirmed' ? ' selected' : '') + '>Confirmed</option>' +
                     '<option value="Closed"' + (enq.status === 'Closed' ? ' selected' : '') + '>Closed</option>' +
                   '</select>' +
                 '</div>' +
                 '<div class="enq-body-grid">' +
                   '<div><span class="enq-data-lbl">Contact:</span><span class="enq-data-val">' + enq.customerName + '</span></div>' +
                   '<div><span class="enq-data-lbl">Phone / WA:</span><span class="enq-data-val">' + enq.phone + '</span></div>' +
                   '<div><span class="enq-data-lbl">Email:</span><span class="enq-data-val">' + enq.email + '</span></div>' +
                   '<div><span class="enq-data-lbl">City:</span><span class="enq-data-val">' + enq.city + '</span></div>' +
                   '<div><span class="enq-data-lbl">Category:</span><span class="enq-data-val">' + enq.category + '</span></div>' +
                   '<div><span class="enq-data-lbl">Volume Tier:</span><span class="enq-data-val">' + enq.qtyRange + '</span></div>' +
                   '<div style="grid-column: 1 / -1;"><span class="enq-data-lbl">Requirements:</span><span class="enq-data-val">' + enq.notes + '</span></div>' +
                 '</div>' +
                 '<div class="enq-actions-bar">' +
                   '<a href="' + waHref + '" target="_blank" class="btn-enq-wa">💬 WhatsApp Contact</a>' +
                   '<a href="tel:' + enq.phone + '" class="btn-enq-call">📞 Call (' + enq.phone + ')</a>' +
                 '</div>' +
               '</div>';
      }).join('');
    }

    window.enamelsUpdateEnquiryStatus = function(refId, newStatus) {
      try {
        var existing = JSON.parse(localStorage.getItem('enamels_bulk_enquiries') || '[]');
        existing.forEach(function(item) {
          if (item.refId === refId) item.status = newStatus;
        });
        localStorage.setItem('enamels_bulk_enquiries', JSON.stringify(existing));
      } catch (e) {}
    };

    document.addEventListener('DOMContentLoaded', function() {
      // Check ?admin=1 in URL to open admin panel automatically
      if (window.location.search.indexOf('admin=1') !== -1) {
        window.enamelsToggleAdminBulkPanel();
      }
    });

  })();
</script>