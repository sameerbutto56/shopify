    background: #e6fffa;
    border: 1px solid #99f6e4;
    color: #008779;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 12px;
  }
  .bulk-main-heading {
    font-size: clamp(22px, 3.5vw, 32px);
    font-weight: 800;
    color: #102a43;
    line-height: 1.2;
    margin: 0 0 8px;
  }
  .bulk-subheading {
    font-size: 14px;
    color: #64748b;
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .bulk-staff-toggle-bar {
    margin-top: 16px;
  }
  .btn-staff-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    color: #334155;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .btn-staff-toggle:hover {
    background: #e2e8f0;
    color: #0f172a;
  }
  .staff-badge-count {
    background: #008779;
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 999px;
  }

  /* Admin Panel */
  .enamels-admin-enquiry-panel {
    background: #ffffff;
    border: 2px solid #008779;
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 28px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }
  .admin-panel-head {
    display: flex;
