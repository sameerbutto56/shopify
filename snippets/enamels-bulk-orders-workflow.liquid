{% comment %}
  Enamels Simplified Institutional & Hospital Bulk Orders Workflow
  Single-Page Form:
  1. Dynamic Category dropdown (Scrubs, Lab Coats, Patient Gowns, Caps, Accessories, etc.)
  2. Quantity selection ranges (10–20, 20–50, 50–100, 100–250, 250+)
  3. Note: "If you want more products, please fill in your details below."
  4. Customer contact form (Name, Organization, Phone/WhatsApp, Email, City, Notes)
  5. Pure enquiry submission: No Shopify checkout, no payment, no inventory deduction.
  6. Dedicated Bulk Orders Admin desk to review/proceed with enquiries.
{% endcomment %}

{%- liquid
  assign raw_wa = settings.whatsapp_number | default: '923011331133'
  assign wa_clean = raw_wa | replace: '+', '' | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', ''
-%}

<div class="enamels-bulk-workflow-wrapper" id="enamels-bulk-workflow-box">
  
  <!-- Header Block -->
  <div class="bulk-workflow-header">
    <div class="bulk-badge-pill">
      <span>🏥</span> INSTITUTIONAL & CLINICAL BULK PROGRAM
    </div>
    <h1 class="bulk-main-heading">Institutional & Hospital Bulk Order Enquiry</h1>
    <p class="bulk-subheading">
      Equip your clinic, hospital department, nursing faculty, or medical team with Enamels premium tailored scrubs and uniforms.
    </p>

    <!-- Admin / Staff Desk Toggle -->
    <div class="bulk-staff-toggle-bar">
      <button type="button" class="btn-staff-toggle" id="btn-toggle-admin-panel" onclick="window.enamelsToggleAdminBulkPanel()">
        <span>👔 Enamels Staff: Bulk Enquiry Management Desk</span>
        <span class="staff-badge-count" id="staff-enquiry-badge-count">1</span>
      </button>
    </div>
  </div>

  <!-- =========================================================================
       ADMIN BULK ENQUIRY MANAGEMENT DASHBOARD
       Shown when staff toggles the button or ?admin=1 is in URL
       ========================================================================= -->
  <div class="enamels-admin-enquiry-panel" id="enamels-admin-enquiry-panel" style="display: none;">
    <div class="admin-panel-head">
      <div>
        <span class="admin-panel-tag">ENAMELS INTERNAL OPERATIONS DESK</span>
        <h3 class="admin-panel-title">Institutional Bulk Order Enquiries</h3>
        <p class="admin-panel-sub">Review incoming institutional enquiries, requested volume tiers, and manage quotation follow-up status.</p>
      </div>
      <button type="button" class="btn-close-admin-panel" onclick="window.enamelsToggleAdminBulkPanel()">✕ Close Panel</button>
    </div>

    <!-- Filter Bar -->
    <div class="admin-filter-bar">
      <span class="filter-lbl">Filter by Status:</span>
      <select id="admin-status-filter" onchange="window.enamelsFilterAdminEnquiries(this.value)">
        <option value="all">All Enquiries</option>
        <option value="New Enquiry">New Enquiry</option>
        <option value="Contact Pending">Contact Pending</option>
        <option value="Contacted">Contacted</option>
        <option value="Quotation Shared">Quotation Shared</option>
        <option value="Negotiation">Negotiation</option>
        <option value="Confirmed">Confirmed</option>
        <option value="Closed">Closed</option>
      </select>
      <button type="button" class="btn-seed-sample" onclick="window.enamelsSeedSampleBulkEnquiry()">
        + Load Sample Enquiry
      </button>
    </div>

    <!-- Dynamic Enquiry Cards List -->
    <div class="admin-enquiries-list" id="admin-enquiries-list"></div>
  </div>

  <!-- =========================================================================
       CUSTOMER SINGLE-PAGE INSTITUTIONAL BULK ENQUIRY FORM
       ========================================================================= -->
  <div class="bulk-enquiry-card" id="bulk-customer-enquiry-form-card">
    
    <div class="bulk-enquiry-form-head">
      <h2 class="form-title">Institutional Quotation & Bulk Request</h2>
      <p class="form-desc">Fill in your requirements below. Our corporate relations team will prepare a formal customized quotation.</p>
    </div>

    <form id="enamels-bulk-enquiry-form" onsubmit="window.enamelsHandleBulkSubmit(event)">
      
      <!-- 1. Category Selection -->
      <div class="bulk-field-group">
        <label for="bulk-category-select" class="bulk-field-label">
          1. Select Uniform Category <span class="req-star">*</span>
        </label>
        <select id="bulk-category-select" class="bulk-form-select" required onchange="window.enamelsUpdateBulkCategory(this.value)">
          <option value="" disabled selected>— Choose Medical Apparel Category —</option>
          <option value="Medical Scrubs (Sets / Tops / Pants)">Medical Scrubs (Sets, Tops & Cargo Trousers)</option>
          <option value="Doctor & Consultant Lab Coats">Doctor & Consultant Lab Coats</option>
          <option value="Patient Gowns & OT Drapes">Patient Gowns & Operating Theatre Drapes</option>
          <option value="Surgical Scrub Caps">Surgical Scrub Caps & Headwear</option>
          <option value="Medical Arm Sleeves & Accessories">Medical Arm Sleeves, Non-Slip Clogs & Accessories</option>
          <option value="Complete Hospital Department Multi-Uniforms">Complete Hospital Department Package (Multiple Uniforms)</option>
        </select>
        <span class="field-hint">Select the primary apparel line required for your institution.</span>
      </div>

      <!-- 2. Quantity Selection Ranges -->
      <div class="bulk-field-group" style="margin-top: 22px;">
        <label class="bulk-field-label">
          2. Select Estimated Quantity Range <span class="req-star">*</span>
        </label>
        <div class="bulk-qty-pills-grid" role="radiogroup" aria-label="Quantity Range">
          <label class="qty-range-pill active" onclick="window.enamelsSetQtyRange('10 – 20 Units', this)">
            <input type="radio" name="bulk_qty_range" value="10 – 20 Units" checked>
            <strong class="qty-pill-text">10 – 20 Units</strong>
            <span class="qty-pill-sub">Clinic / Small Team</span>
          </label>
          <label class="qty-range-pill" onclick="window.enamelsSetQtyRange('20 – 50 Units', this)">
            <input type="radio" name="bulk_qty_range" value="20 – 50 Units">
            <strong class="qty-pill-text">20 – 50 Units</strong>
            <span class="qty-pill-sub">Department Ward</span>
          </label>
          <label class="qty-range-pill" onclick="window.enamelsSetQtyRange('50 – 100 Units', this)">
            <input type="radio" name="bulk_qty_range" value="50 – 100 Units">
            <strong class="qty-pill-text">50 – 100 Units</strong>
            <span class="qty-pill-sub">Specialty Hospital</span>
          </label>
          <label class="qty-range-pill" onclick="window.enamelsSetQtyRange('100 – 250 Units', this)">
            <input type="radio" name="bulk_qty_range" value="100 – 250 Units">
            <strong class="qty-pill-text">100 – 250 Units</strong>
            <span class="qty-pill-sub">Large Medical Complex</span>
          </label>
          <label class="qty-range-pill" onclick="window.enamelsSetQtyRange('250+ Units', this)">
            <input type="radio" name="bulk_qty_range" value="250+ Units">
            <strong class="qty-pill-text">250+ Units</strong>
            <span class="qty-pill-sub">Institutional Enterprise</span>
          </label>
        </div>
      </div>

      <!-- 3. Prominent Customer Note Banner -->
      <div class="bulk-friendly-note-banner">
        <span class="banner-icon">💡</span>
        <div class="banner-content">
          <strong class="banner-title">Need custom sizes, multiple colors, or more products?</strong>
          <p class="banner-text">
            If you want more products, custom color piping, hospital logos, or specific size distributions, please fill in your details below and specify them in the notes field.
          </p>
        </div>
      </div>

      <!-- 4. Customer & Institutional Details -->
      <div class="bulk-form-grid" style="margin-top: 24px;">
        <!-- Full Name -->
        <div class="bulk-field-group">
          <label for="bulk-cust-name" class="bulk-field-label">
            Contact Person Full Name <span class="req-star">*</span>
          </label>
          <input type="text" id="bulk-cust-name" class="bulk-form-input" placeholder="e.g. Dr. Muhammad Usman / Administrator" required>
        </div>

        <!-- Organization / Hospital -->
        <div class="bulk-field-group">
          <label for="bulk-org-name" class="bulk-field-label">
            Hospital / Clinic / Organization Name <span class="req-star">*</span>
          </label>
          <input type="text" id="bulk-org-name" class="bulk-form-input" placeholder="e.g. Shaukat Khanum Memorial / Doctors Hospital" required>
        </div>

        <!-- Phone / WhatsApp -->
        <div class="bulk-field-group">
          <label for="bulk-phone" class="bulk-field-label">
            Phone / WhatsApp Number <span class="req-star">*</span>
          </label>
          <input type="tel" id="bulk-phone" class="bulk-form-input" placeholder="e.g. 0300 1234567 or +92 300 1234567" required>
          <span class="field-hint">Our verification officer will contact you on this number.</span>
        </div>

        <!-- Email -->
        <div class="bulk-field-group">
          <label for="bulk-email" class="bulk-field-label">
            Email Address <span class="req-star">*</span>
          </label>
          <input type="email" id="bulk-email" class="bulk-form-input" placeholder="e.g. procurement@hospital.org.pk" required>
        </div>

        <!-- City / Location -->
        <div class="bulk-field-group" style="grid-column: 1 / -1;">
          <label for="bulk-city" class="bulk-field-label">
            City / Location <span class="req-star">*</span>
          </label>
          <input type="text" id="bulk-city" class="bulk-form-input" placeholder="e.g. Lahore, Karachi, Islamabad, Peshawar, Rawalpindi" required>
        </div>

        <!-- Additional Notes / Requirements -->
        <div class="bulk-field-group" style="grid-column: 1 / -1;">
          <label for="bulk-notes" class="bulk-field-label">
            Additional Requirements & Notes:
          </label>
          <textarea
            id="bulk-notes"
            class="bulk-form-textarea"
            rows="4"
            placeholder="Please mention any specific colors (Navy, Ceil Blue, Burgundy), fabric choices (Crown, Sprinter, Tender), hospital logo embroidery requirements, or required delivery timeline."
          ></textarea>
        </div>
      </div>

      <!-- Submit Action Button -->
      <div class="bulk-action-row" style="margin-top: 28px;">
        <button type="submit" class="btn-submit-bulk-enquiry" id="btn-submit-bulk">
          <span class="btn-text">Submit Bulk Order Enquiry →</span>
          <span class="btn-subtext">No Payment or Checkout Required • Pure Quotation Request</span>
        </button>
      </div>

    </form>

    <!-- Instant Success Confirmation Card (Hidden by default, shown on submit) -->
    <div class="bulk-success-card" id="bulk-success-card" style="display: none;">
      <div class="success-icon-badge">✓</div>
      <h3 class="success-title">Institutional Bulk Enquiry Received!</h3>
      <div class="success-ref-pill">
        Reference ID: <strong id="success-ref-id">ENM-BLK-2026-9481</strong>
      </div>
      <p class="success-body">
        Thank you for choosing Enamels! Your bulk order enquiry has been logged successfully with our institutional desk. Our corporate account manager will contact you within one working day with formal pricing, digital fabric swatches, and quotation terms.
      </p>
      
      {% if wa_clean != blank %}
        <div class="success-wa-action-box">
          <p style="font-size: 13px; color: #102a43; font-weight: 600; margin: 0 0 8px;">
            Want immediate assistance? Connect directly with our institutional desk on WhatsApp:
          </p>
          <a
            href="#"
            id="btn-success-wa-link"
            class="btn-success-whatsapp"
            target="_blank"
            rel="noopener"
          >
            💬 Chat on WhatsApp with Reference #<span id="wa-link-ref-id">ENM-BLK-2026-9481</span>
          </a>
        </div>
      {% endif %}

      <div style="margin-top: 24px;">
        <button type="button" class="btn-reset-bulk" onclick="window.enamelsResetBulkForm()">
          ← Submit Another Enquiry
        </button>
      </div>
    </div>

  </div>

</div>

<style>
