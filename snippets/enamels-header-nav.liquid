{% comment %}
  ENAMELS ONLINE — OFFICIAL HEADER & 6-CATEGORY NAVIGATION
  Preserves existing white visual identity, logo, typography, and customer service.
  Exact Category Order:
  1. Scrubs (with dropdown to Sprinter, Velora, Crown, View All)
  2. Lab Coats
  3. Caps (BunFit™)
  4. Sleeves
  5. Accessories
  6. Ready to Wear / Make Your Own Scrub
{% endcomment %}

{% liquid
  assign enable_announcement = true
  if section.settings.enable_announcement_bar == false
    assign enable_announcement = false
  endif

  assign announcement_blocks_count = 0
  for block in section.blocks
    if block.type == 'announcement'
      assign announcement_blocks_count = announcement_blocks_count | plus: 1
    endif
  endfor

  assign logo_max_width = section.settings.logo_max_width | default: 100
  assign phone_number = section.settings.phone_number
  if phone_number == blank
    assign phone_number = settings.enamels_support_phone
  endif

  assign phone_tel = section.settings.phone_tel
  if phone_tel == blank and phone_number != blank
    assign phone_tel = phone_number | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', ''
  endif

  assign show_phone = true
  if section.settings.show_phone == false
    assign show_phone = false
  endif
  if phone_number == blank
    assign show_phone = false
  endif

  assign search_placeholder = section.settings.search_placeholder | default: 'Search scrubs, lab coats, surgical caps, sleeves...'
  assign show_wishlist = true
  if section.settings.show_wishlist == false
    assign show_wishlist = false
  endif
%}

{% if enable_announcement %}
<!-- Top Announcement Bar -->
<div class="enamels-announcement-bar" id="enamels-top-announcement" style="{% if section.settings.announcement_bg != blank %}background-color: {{ section.settings.announcement_bg }};{% endif %}{% if section.settings.announcement_color != blank %}color: {{ section.settings.announcement_color }};{% endif %}">
  <div class="enamels-announcement-track" style="{% if section.settings.announcement_speed != blank %}animation-duration: {{ section.settings.announcement_speed }}s;{% endif %}">
    {% if announcement_blocks_count > 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'announcement' %}
          <span {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" style="color: inherit; text-decoration: none;">{% endif %}
            {{ block.settings.text | escape }}
            {% if block.settings.link != blank %}</a>{% endif %}
          </span>
        {% endif %}
      {% endfor %}
      {% comment %}Duplicate for seamless marquee loop{% endcomment %}
      {% for block in section.blocks %}
        {% if block.type == 'announcement' %}
          <span aria-hidden="true">
            {{ block.settings.text | escape }}
          </span>
        {% endif %}
      {% endfor %}
    {% else %}
      <span>✨ FREE NATIONWIDE DELIVERY ON ORDERS OVER RS. 7,000</span>
      <span>💵 CASH ON DELIVERY (COD) AVAILABLE ACROSS ALL CITIES IN PAKISTAN</span>
      <span>⚡ 7-DAY HASSLE-FREE SIZE EXCHANGE VIA WHATSAPP (+92 301 13 31 133)</span>
      <span>🪡 BESPOKE DOCTOR NAME EMBROIDERY & HOSPITAL CRESTS AVAILABLE</span>
      <span>✨ FREE NATIONWIDE DELIVERY ON ORDERS OVER RS. 7,000</span>
      <span>💵 CASH ON DELIVERY (COD) AVAILABLE ACROSS ALL CITIES IN PAKISTAN</span>
      <span>⚡ 7-DAY HASSLE-FREE SIZE EXCHANGE VIA WHATSAPP (+92 301 13 31 133)</span>
      <span>🪡 BESPOKE DOCTOR NAME EMBROIDERY & HOSPITAL CRESTS AVAILABLE</span>
    {% endif %}
  </div>
</div>
{% endif %}

<!-- Main White Header -->
<header class="enamels-header" id="enamels-main-header">
  <div class="page-container">
    <div class="header-top-row">
      <!-- 1. Enamels Logo -->
      <a href="{{ routes.root_url }}" class="header-logo-wrap" onclick="window.navigateToView('home'); return false;" title="Enamels Medical Apparel">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 300 }}"
            alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
            class="header-logo-img"
            style="max-width: {{ logo_max_width }}px; height: auto;"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
            loading="eager"
          />
        {% else %}
          <img src="{{ 'enamels-logo.png' | asset_url }}" alt="Enamels" class="header-logo-img" width="100" height="48" style="max-width: {{ logo_max_width }}px; height: auto;" loading="eager" />
        {% endif %}
      </a>

      <!-- 2. Interactive Search Bar -->
      <div class="header-search-wrap">
        <svg class="header-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
        </svg>
        <input
          type="search"
          class="header-search-input"
          id="enamels-header-search-input"
          placeholder="{{ search_placeholder | escape }}"
          onfocus="window.openSearchModal()"
          aria-label="Search Catalog"
        />
      </div>

      <!-- 3. Actions & Contact Info -->
      <div class="header-actions-wrap">
        {% if show_phone %}
        <a href="tel:{{ phone_tel }}" class="customer-service-badge" title="Direct Phone Support">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>{{ phone_number | escape }}</span>
        </a>
        {% endif %}

        {% if show_wishlist %}
        <!-- Wishlist Button -->
        <button type="button" class="header-action-btn" onclick="window.openWishlistModal()" aria-label="Wishlist">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <span class="cart-bubble-badge" id="enamels-wishlist-count" style="background: #102a43;">0</span>
        </button>
        {% endif %}

        <!-- Cart Button -->
        <button type="button" class="header-action-btn" onclick="window.openCartDrawer()" aria-label="Shopping Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <span class="cart-bubble-badge" id="enamels-cart-count">0</span>
        </button>

        <!-- Mobile Hamburger -->
        <button type="button" class="header-action-btn mobile-only-toggle" onclick="window.toggleMobileNavDrawer()" aria-label="Open Navigation Menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Navigation Menu Bar with Dropdowns (Fully Restored & Synchronized) -->
  <nav class="enamels-nav-bar" id="enamels-desktop-navbar" aria-label="Main Store Navigation">
    <div class="page-container enamels-nav-container">
      <ul class="enamels-nav-list">
        <!-- 1. MEN (Primary Category) -->
        <li class="enamels-nav-item" id="nav-item-men">
          <a
            href="{{ routes.collections_url }}/all?gender=men"
            class="enamels-nav-link"
            onclick="if (typeof window.navigateToGender === 'function') { window.navigateToGender('men'); return false; }"
          >
            <span class="nav-link-text">Men</span>
          </a>
        </li>

        <!-- 2. WOMEN (Primary Category) -->
        <li class="enamels-nav-item" id="nav-item-women">
          <a
            href="{{ routes.collections_url }}/all?gender=women"
            class="enamels-nav-link"
            onclick="if (typeof window.navigateToGender === 'function') { window.navigateToGender('women'); return false; }"
          >
            <span class="nav-link-text">Women</span>
          </a>
        </li>

        <!-- 3. CUSTOMIZE YOUR OWN SCRUBS (Dedicated Studio) -->
        <li class="enamels-nav-item" id="nav-item-ready-to-wear">
          <a
            href="/pages/customizer"
            class="enamels-nav-link"
            onclick="if (typeof window.openCustomizerModal === 'function') { window.openCustomizerModal(); return false; } else if (typeof window.navigateToView === 'function') { window.navigateToView('ready-to-wear'); return false; }"
          >
            <span class="nav-link-text">Customize Your Own Scrubs</span>
            <span class="nav-badge-pill badge-studio">STUDIO</span>
          </a>
        </li>

        <!-- 4. BULK ORDERS (Institutional Multi-Category Enquiries) -->
        <li class="enamels-nav-item" id="nav-item-bulk-orders">
          <a
            href="/pages/bulk-orders"
            class="enamels-nav-link"
            onclick="if (typeof window.openBulkOrdersModal === 'function') { window.openBulkOrdersModal(); return false; }"
          >
            <span class="nav-link-text">Bulk Orders</span>
            <span class="nav-badge-pill" style="background: #0284c7; color: #ffffff;">INSTITUTIONAL</span>
          </a>
        </li>

        <!-- 5. SCRUBS (with Series Dropdown) -->
        <li class="enamels-nav-item has-dropdown" id="nav-item-scrubs">
          <a
            href="{{ routes.collections_url }}/all?category=scrubs"
            class="enamels-nav-link"
            onclick="if (typeof window.navigateToView === 'function') { window.navigateToView('category-scrubs'); return false; }"
            aria-haspopup="true"
            aria-expanded="false"
          >
            <span class="nav-link-text">Scrubs</span>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="nav-arrow-icon" aria-hidden="true">
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </a>
          <div class="nav-dropdown-menu" role="menu">
            <a href="{{ routes.collections_url }}/all?category=scrubs&article=sprinter" class="dropdown-item-link" onclick="if (typeof window.navigateToBrand === 'function') { window.navigateToBrand('Sprinter'); return false; }">
              <strong>Sprinter Series</strong>
              <span>4-Way Athletic Mechanical Stretch</span>
            </a>
            <a href="{{ routes.collections_url }}/all?category=scrubs&article=vilora" class="dropdown-item-link" onclick="if (typeof window.navigateToBrand === 'function') { window.navigateToBrand('Velora'); return false; }">
              <strong>Velora Series</strong>
              <span>Luxury Tailored Micro-Drape</span>
            </a>
            <a href="{{ routes.collections_url }}/all?category=scrubs&article=crown" class="dropdown-item-link" onclick="if (typeof window.navigateToBrand === 'function') { window.navigateToBrand('Crown'); return false; }">
              <strong>Crown Series</strong>
              <span>Executive Structured Mandarin Collar</span>
            </a>
            <a href="{{ routes.collections_url }}/all?category=scrubs&article=flexwell" class="dropdown-item-link" onclick="if (typeof window.navigateToBrand === 'function') { window.navigateToBrand('Flexwell'); return false; }">
              <strong>Flexwell Series</strong>
              <span>Antimicrobial Laser-Perforated Aerocool</span>
            </a>
            <div class="nav-dropdown-divider"></div>
            <a href="{{ routes.collections_url }}/all?category=scrubs" class="dropdown-item-link dropdown-item-all" onclick="if (typeof window.navigateToView === 'function') { window.navigateToView('category-scrubs'); return false; }">
              View All Scrubs Categories →
            </a>
          </div>
        </li>

        <!-- 6. LAB COATS -->
        <li class="enamels-nav-item" id="nav-item-lab-coats">
          <a
            href="{{ routes.collections_url }}/all?category=lab-coats"
            class="enamels-nav-link"
          >
            <span class="nav-link-text">Lab Coats</span>
          </a>
        </li>

        <!-- 7. CAPS -->
        <li class="enamels-nav-item" id="nav-item-caps">
          <a
            href="{{ routes.collections_url }}/all?category=caps"
            class="enamels-nav-link"
          >
            <span class="nav-link-text">Caps</span>
          </a>
        </li>

        <!-- 8. SLEEVES -->
        <li class="enamels-nav-item" id="nav-item-sleeves">
          <a
            href="{{ routes.collections_url }}/all?category=sleeves"
            class="enamels-nav-link"
          >
            <span class="nav-link-text">Sleeves</span>
          </a>
        </li>

        <!-- 9. ACCESSORIES -->
        <li class="enamels-nav-item" id="nav-item-accessories">
          <a
            href="{{ routes.collections_url }}/all?category=accessories"
            class="enamels-nav-link"
          >
            <span class="nav-link-text">Accessories</span>
          </a>
        </li>

        <!-- 10. BOOK A HOME FITTING — LAHORE ONLY -->
        <li class="enamels-nav-item" id="nav-item-home-service">
          <a
            href="#self-service"
            class="enamels-nav-link"
            onclick="if (typeof window.navigateToView === 'function') { window.navigateToView('self-service'); return false; }"
          >
            <span class="nav-link-text">BOOK A HOME FITTING</span>
            <span class="nav-badge-pill badge-lahore">LAHORE ONLY</span>
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<!-- Mobile Navigation Drawer -->
<div class="enamels-modal-backdrop" id="mobile-nav-backdrop" onclick="if(typeof window.toggleMobileNavDrawer==='function') window.toggleMobileNavDrawer();">
  <div class="enamels-modal-card mobile-nav-drawer-card" id="mobile-nav-drawer" onclick="event.stopPropagation()">
    <div class="mobile-nav-header">
      <img src="{{ 'enamels-logo.png' | asset_url }}" alt="Enamels" class="mobile-nav-logo" width="85" height="40" loading="eager" />
      <button type="button" class="modal-close-trigger" onclick="if(typeof window.toggleMobileNavDrawer==='function') window.toggleMobileNavDrawer();" aria-label="Close Navigation Menu">✕</button>
    </div>

    <nav class="mobile-nav-body" aria-label="Mobile Navigation">
      <ul class="mobile-nav-list">
        <!-- 1. Men (Primary Category) -->
        <li class="mobile-nav-item">
          <a href="{{ routes.collections_url }}/all?gender=men" onclick="if(typeof window.navigateToGender==='function'){window.navigateToGender('men');}if(typeof window.toggleMobileNavDrawer==='function') window.toggleMobileNavDrawer();" class="mobile-nav-link">
            <span>Men</span>
          </a>
        </li>

        <!-- 2. Women (Primary Category) -->
        <li class="mobile-nav-item">
          <a href="{{ routes.collections_url }}/all?gender=women" onclick="if(typeof window.navigateToGender==='function'){window.navigateToGender('women');}if(typeof window.toggleMobileNavDrawer==='function') window.toggleMobileNavDrawer();" class="mobile-nav-link">
            <span>Women</span>
          </a>
        </li>

        <!-- 3. Customize Your Own Scrubs -->
        <li class="mobile-nav-item">
          <a href="/pages/customizer" onclick="if(typeof window.openCustomizerModal==='function'){window.openCustomizerModal();}if(typeof window.toggleMobileNavDrawer==='function') window.toggleMobileNavDrawer(); return false;" class="mobile-nav-link mobile-nav-highlight">
            <span>CUSTOMIZE YOUR OWN SCRUBS</span>
            <span class="nav-badge-pill badge-studio">STUDIO</span>
          </a>
        </li>

        <!-- 4. Bulk Orders -->
        <li class="mobile-nav-item">
          <a href="/pages/bulk-orders" onclick="if(typeof window.openBulkOrdersModal==='function'){window.openBulkOrdersModal();}if(typeof window.toggleMobileNavDrawer==='function') window.toggleMobileNavDrawer(); return false;" class="mobile-nav-link">
            <span>Bulk Orders (10+ Scrubs)</span>
            <span class="nav-badge-pill" style="background: #0284c7; color: #ffffff;">INSTITUTIONAL</span>
          </a>
        </li>

        <li class="mobile-nav-divider"></li>

        <!-- 5. Scrubs -->
        <li class="mobile-nav-item">
          <a href="{{ routes.collections_url }}/all?category=scrubs" onclick="if(typeof window.navigateToView==='function') window.navigateToView('category-scrubs'); if(typeof window.toggleMobileNavDrawer==='function') window.toggleMobileNavDrawer(); return false;" class="mobile-nav-link">
            <span>Scrubs Collection</span>
          </a>
          <div class="mobile-nav-sublist">
            <a href="{{ routes.collections_url }}/all?category=scrubs&article=sprinter" onclick="if(typeof window.navigateToBrand==='function') window.navigateToBrand('Sprinter'); if(typeof window.toggleMobileNavDrawer==='function') window.toggleMobileNavDrawer(); return false;" class="mobile-nav-sublink">↳ Sprinter Series (4-Way Stretch)</a>
            <a href="{{ routes.collections_url }}/all?category=scrubs&article=vilora" onclick="if(typeof window.navigateToBrand==='function') window.navigateToBrand('Velora'); if(typeof window.toggleMobileNavDrawer==='function') window.toggleMobileNavDrawer(); return false;" class="mobile-nav-sublink">↳ Velora Series (Micro-Drape)</a>
            <a href="{{ routes.collections_url }}/all?category=scrubs&article=crown" onclick="if(typeof window.navigateToBrand==='function') window.navigateToBrand('Crown'); if(typeof window.toggleMobileNavDrawer==='function') window.toggleMobileNavDrawer(); return false;" class="mobile-nav-sublink">↳ Crown Series (Mandarin Collar)</a>
            <a href="{{ routes.collections_url }}/all?category=scrubs&article=flexwell" onclick="if(typeof window.navigateToBrand==='function') window.navigateToBrand('Flexwell'); if(typeof window.toggleMobileNavDrawer==='function') window.toggleMobileNavDrawer(); return false;" class="mobile-nav-sublink">↳ Flexwell Series (Aerocool Flex)</a>
          </div>
        </li>

        <!-- 6. Lab Coats -->
        <li class="mobile-nav-item">
          <a href="{{ routes.collections_url }}/all?category=lab-coats" onclick="if(typeof window.navigateToCollection==='function') window.navigateToCollection('lab-coat', 'category'); if(typeof window.toggleMobileNavDrawer==='function') window.toggleMobileNavDrawer(); return false;" class="mobile-nav-link">
            <span>Lab Coats</span>
          </a>
        </li>

        <!-- 7. Caps -->
        <li class="mobile-nav-item">
          <a href="{{ routes.collections_url }}/all?category=caps" onclick="if(typeof window.navigateToCollection==='function') window.navigateToCollection('caps', 'category'); if(typeof window.toggleMobileNavDrawer==='function') window.toggleMobileNavDrawer(); return false;" class="mobile-nav-link">
            <span>Caps (BunFit™)</span>
          </a>
        </li>

        <!-- 8. Sleeves -->
        <li class="mobile-nav-item">
          <a href="{{ routes.collections_url }}/all?category=sleeves" onclick="if(typeof window.navigateToCollection==='function') window.navigateToCollection('sleeves', 'feature'); if(typeof window.toggleMobileNavDrawer==='function') window.toggleMobileNavDrawer(); return false;" class="mobile-nav-link">
            <span>Sleeves</span>
          </a>
        </li>

        <!-- 9. Accessories -->
        <li class="mobile-nav-item">
          <a href="{{ routes.collections_url }}/all?category=accessories" onclick="if(typeof window.navigateToAccessories==='function') window.navigateToAccessories(); if(typeof window.toggleMobileNavDrawer==='function') window.toggleMobileNavDrawer(); return false;" class="mobile-nav-link">
            <span>Accessories</span>
          </a>
        </li>

        <!-- 10. Book a Home Fitting -->
        <li class="mobile-nav-item">
          <a href="#self-service" onclick="if(typeof window.navigateToView==='function') window.navigateToView('self-service'); if(typeof window.toggleMobileNavDrawer==='function') window.toggleMobileNavDrawer(); return false;" class="mobile-nav-link mobile-nav-highlight">
            <span>BOOK A HOME FITTING</span>
            <span class="nav-badge-pill badge-lahore">LAHORE ONLY</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="mobile-nav-footer">
      {% if show_phone or settings.whatsapp_number != blank %}
        <p class="mobile-support-title">Direct Support:</p>
      {% endif %}
      {% if show_phone %}
      <a href="tel:{{ phone_tel }}" class="mobile-support-tel">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>{{ phone_number | escape }}</span>
      </a>
      {% endif %}
      {% assign whatsapp_clean = settings.whatsapp_number | default: '' | replace: '+', '' | replace: ' ', '' | replace: '-', '' %}
      {% if whatsapp_clean != blank %}
      <a href="https://wa.me/{{ whatsapp_clean }}" target="_blank" rel="noopener" class="mobile-whatsapp-btn">
        💬 WhatsApp Official Support
      </a>
      {% endif %}
    </div>
  </div>
</div>
