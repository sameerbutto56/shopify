{% comment %}
  ENAMELS ONLINE — OFFICIAL HEADER & 6-CATEGORY NAVIGATION
  Preserves existing white visual identity, logo, typography, and customer service.
  Exact Category Order:
  1. Scrubs (with dropdown to Sprinter, Velora, Crown, View All)
  2. Lab Coats
  3. Caps (BunFit™)
  4. Sleeves
  5. Accessories
  6. Ready to Wear / Make Your Own Scrub
{% endcomment %}

<!-- Top Announcement Bar -->
<div class="enamels-announcement-bar" id="enamels-top-announcement">
  <div class="enamels-announcement-track">
    <span>✨ FREE NATIONWIDE DELIVERY ON ORDERS OVER RS. 7,000</span>
    <span>💵 CASH ON DELIVERY (COD) AVAILABLE ACROSS ALL CITIES IN PAKISTAN</span>
    <span>⚡ 7-DAY HASSLE-FREE SIZE EXCHANGE VIA WHATSAPP (+92 301 13 31 133)</span>
    <span>🪡 BESPOKE DOCTOR NAME EMBROIDERY & HOSPITAL CRESTS AVAILABLE</span>
    <span>✨ FREE NATIONWIDE DELIVERY ON ORDERS OVER RS. 7,000</span>
    <span>💵 CASH ON DELIVERY (COD) AVAILABLE ACROSS ALL CITIES IN PAKISTAN</span>
    <span>⚡ 7-DAY HASSLE-FREE SIZE EXCHANGE VIA WHATSAPP (+92 301 13 31 133)</span>
    <span>🪡 BESPOKE DOCTOR NAME EMBROIDERY & HOSPITAL CRESTS AVAILABLE</span>
  </div>
</div>

<!-- Main White Header -->
<header class="enamels-header" id="enamels-main-header">
  <div class="page-container">
    <div class="header-top-row">
      <!-- 1. Enamels Logo -->
      <a href="{{ routes.root_url }}" class="header-logo-wrap" onclick="window.navigateToView('home'); return false;" title="Enamels Medical Apparel">
        <img src="{{ 'enamels-logo.png' | asset_url }}" alt="Enamels" class="header-logo-img" width="100" height="48" loading="eager" />
      </a>

      <!-- 2. Interactive Search Bar -->
      <div class="header-search-wrap">
        <svg class="header-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
        </svg>
        <input
          type="search"
          class="header-search-input"
          id="enamels-header-search-input"
          placeholder="Search scrubs, lab coats, surgical caps, sleeves..."
          onfocus="window.openSearchModal()"
          aria-label="Search Catalog"
        />
      </div>

      <!-- 3. Actions & Contact Info -->
      <div class="header-actions-wrap">
        <a href="tel:+923011331133" class="customer-service-badge" title="Direct Phone Support">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>+92 301 13 31 133</span>
        </a>

        <!-- Wishlist Button -->
        <button type="button" class="header-action-btn" onclick="window.openWishlistModal()" aria-label="Wishlist">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <span class="cart-bubble-badge" id="enamels-wishlist-count" style="background: #102a43;">0</span>
        </button>

        <!-- Cart Button -->
        <button type="button" class="header-action-btn" onclick="window.openCartDrawer()" aria-label="Shopping Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <span class="cart-bubble-badge" id="enamels-cart-count">0</span>
        </button>

        <!-- Mobile Hamburger -->
        <button type="button" class="header-action-btn mobile-only-toggle" onclick="window.toggleMobileNavDrawer()" aria-label="Open Navigation Menu" style="display: none;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Primary 6-Category Navigation Bar -->
  <nav class="enamels-nav-bar" aria-label="Main Category Navigation">
    <div class="page-container">
      <ul class="enamels-nav-list">
        <!-- 1. Scrubs (with Dropdown) -->
        <li class="enamels-nav-item" id="nav-item-scrubs">
          <a href="#category-scrubs" class="enamels-nav-link" onclick="window.navigateToView('category-scrubs'); return false;">
            <span>Scrubs</span>
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </a>
          <div class="enamels-nav-dropdown">
            <a href="#collection-sprinter" class="dropdown-item-link" onclick="window.navigateToCollection('Sprinter'); return false;">
              <strong>Sprinter Series</strong>
              <span>4-Way Athletic Mechanical Stretch</span>
            </a>
            <a href="#collection-velora" class="dropdown-item-link" onclick="window.navigateToCollection('Velora'); return false;">
              <strong>Velora Series</strong>
              <span>Luxury Tailored Micro-Drape</span>
            </a>
            <a href="#collection-crown" class="dropdown-item-link" onclick="window.navigateToCollection('Crown'); return false;">
              <strong>Crown Series</strong>
              <span>Executive Structured Mandarin Collar</span>
            </a>
            <a href="#collection-flexfit" class="dropdown-item-link" onclick="window.navigateToCollection('FlexFit'); return false;">
              <strong>FlexFit Series</strong>
              <span>Antimicrobial Laser-Perforated Weave</span>
            </a>
            <div style="height: 1px; background: #e2e8f0; margin: 6px 0;"></div>
            <a href="#category-scrubs" class="dropdown-item-link" onclick="window.navigateToView('category-scrubs'); return false;" style="color: #00b8a9; font-weight: 700;">
              View All Scrubs Categories →
            </a>
          </div>
        </li>

        <!-- 2. Lab Coats -->
        <li class="enamels-nav-item" id="nav-item-lab-coats">
          <a href="#collection-lab-coats" class="enamels-nav-link" onclick="window.navigateToCollection('lab-coat', 'category'); return false;">
            <span>Lab Coats</span>
          </a>
        </li>

        <!-- 3. Caps -->
        <li class="enamels-nav-item" id="nav-item-caps">
          <a href="#collection-caps" class="enamels-nav-link" onclick="window.navigateToCollection('caps', 'category'); return false;">
            <span>Caps</span>
            <span class="nav-tag-badge">BunFit™</span>
          </a>
        </li>

        <!-- 4. Sleeves -->
        <li class="enamels-nav-item" id="nav-item-sleeves">
          <a href="#collection-sleeves" class="enamels-nav-link" onclick="window.navigateToCollection('sleeves', 'feature'); return false;">
            <span>Sleeves</span>
          </a>
        </li>

        <!-- 5. Accessories -->
        <li class="enamels-nav-item" id="nav-item-accessories">
          <a href="#collection-accessories" class="enamels-nav-link" onclick="window.navigateToCollection('accessories', 'category'); return false;">
            <span>Accessories</span>
          </a>
        </li>

        <!-- 6. Ready to Wear / Make Your Own Scrub -->
        <li class="enamels-nav-item" id="nav-item-ready-to-wear">
          <a href="#ready-to-wear" class="enamels-nav-link" onclick="window.navigateToView('ready-to-wear'); return false;" style="color: #102a43; font-weight: 700;">
            <span>Ready to Wear / Make Your Own Scrub</span>
            <span class="nav-tag-highlight">STUDIO</span>
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<!-- Mobile Navigation Drawer -->
<div class="enamels-modal-backdrop" id="mobile-nav-backdrop" onclick="window.toggleMobileNavDrawer()">
  <div class="enamels-modal-card" style="max-width: 340px; margin-left: 0; height: 100vh; max-height: 100vh; border-radius: 0;" onclick="event.stopPropagation()">
    <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #e2e8f0; padding-bottom: 14px; margin-bottom: 16px;">
      <img src="{{ 'enamels-logo.png' | asset_url }}" alt="Enamels" width="75" height="36" />
      <button type="button" class="modal-close-trigger" onclick="window.toggleMobileNavDrawer()" style="position: static;">✕</button>
    </div>
    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
      <li>
        <a href="#category-scrubs" onclick="window.navigateToView('category-scrubs'); window.toggleMobileNavDrawer(); return false;" class="dropdown-item-link" style="font-size: 14px; font-weight: 700;">
          1. Scrubs Collection
        </a>
        <div style="padding-left: 14px; display: flex; flex-direction: column; gap: 4px; margin-top: 4px;">
          <a href="#sprinter" onclick="window.navigateToCollection('Sprinter'); window.toggleMobileNavDrawer(); return false;" class="dropdown-item-link" style="font-size: 12px;">↳ Sprinter Series</a>
          <a href="#velora" onclick="window.navigateToCollection('Velora'); window.toggleMobileNavDrawer(); return false;" class="dropdown-item-link" style="font-size: 12px;">↳ Velora Series</a>
          <a href="#crown" onclick="window.navigateToCollection('Crown'); window.toggleMobileNavDrawer(); return false;" class="dropdown-item-link" style="font-size: 12px;">↳ Crown Series</a>
        </div>
      </li>
      <li>
        <a href="#lab-coats" onclick="window.navigateToCollection('lab-coat', 'category'); window.toggleMobileNavDrawer(); return false;" class="dropdown-item-link" style="font-size: 14px; font-weight: 700;">
          2. Lab Coats
        </a>
      </li>
      <li>
        <a href="#caps" onclick="window.navigateToCollection('caps', 'category'); window.toggleMobileNavDrawer(); return false;" class="dropdown-item-link" style="font-size: 14px; font-weight: 700;">
          3. Caps (BunFit™)
        </a>
      </li>
      <li>
        <a href="#sleeves" onclick="window.navigateToCollection('sleeves', 'feature'); window.toggleMobileNavDrawer(); return false;" class="dropdown-item-link" style="font-size: 14px; font-weight: 700;">
          4. Sleeves
        </a>
      </li>
      <li>
        <a href="#accessories" onclick="window.navigateToCollection('accessories', 'category'); window.toggleMobileNavDrawer(); return false;" class="dropdown-item-link" style="font-size: 14px; font-weight: 700;">
          5. Accessories
        </a>
      </li>
      <li>
        <a href="#ready-to-wear" onclick="window.navigateToView('ready-to-wear'); window.toggleMobileNavDrawer(); return false;" class="dropdown-item-link" style="font-size: 14px; font-weight: 700; color: #102a43; background: #f1f5f9;">
          6. Ready to Wear / Make Your Own Scrub ✨
        </a>
      </li>
    </ul>

    <div style="margin-top: 30px; border-top: 1px solid #e2e8f0; padding-top: 16px;">
      <p style="font-size: 12px; color: #64748b; margin-bottom: 8px;">Direct Support:</p>
      <a href="tel:+923011331133" style="font-size: 13px; font-weight: 700; color: #102a43; text-decoration: none; display: flex; align-items: center; gap: 6px;">
        📞 +92 301 13 31 133
      </a>
      <a href="https://wa.me/923011331133" target="_blank" rel="noopener" style="display: block; margin-top: 12px; background: #25d366; color: #ffffff; text-align: center; padding: 10px; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: 700;">
        Chat on WhatsApp
      </a>
    </div>
  </div>
</div>
