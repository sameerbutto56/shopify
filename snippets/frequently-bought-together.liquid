{% doc %}
  Frequently Bought Together Bundle Block for Product Page
{% enddoc %}

{%- liquid
  assign recommendations_to_show = product.metafields.custom.frequently_bought_together.value | default: recommendations.products
  if recommendations_to_show == blank or recommendations_to_show.size == 0
    assign bundle_collection = collections[product.collections.first.handle] | default: collections.all
    assign recommendations_to_show = bundle_collection.products
  endif
-%}

<div class="fbt-bundle-container" data-main-product-id="{{ product.id }}">
  <div class="fbt-header">
    <h3 class="fbt-title h4">Frequently Bought Together</h3>
    <p class="fbt-subtitle">Complete your look with these perfectly paired essentials</p>
  </div>

  <div class="fbt-content">
    <div class="fbt-items-row">
      <!-- Main Product -->
      <div class="fbt-item" data-price="{{ product.price }}" data-variant-id="{{ product.selected_or_first_available_variant.id }}">
        <div class="fbt-item-image">
          <img src="{{ product.featured_image | image_url: width: 160 }}" alt="{{ product.title | escape }}" loading="lazy" width="70" height="70">
        </div>
        <div class="fbt-item-info">
          <span class="fbt-item-badge">This item:</span>
          <span class="fbt-item-name">{{ product.title | truncate: 25 }}</span>
          <span class="fbt-item-price">{{ product.price | money }}</span>
        </div>
        <input type="checkbox" class="fbt-checkbox" checked disabled data-variant-id="{{ product.selected_or_first_available_variant.id }}" data-price="{{ product.price }}">
      </div>

      <div class="fbt-plus-sign">+</div>

      <!-- Complementary Product 1 -->
      {% assign comp_count = 0 %}
      {% for comp_product in recommendations_to_show %}
        {% if comp_product.id != product.id and comp_product.available and comp_count < 1 %}
          {% assign comp_count = comp_count | plus: 1 %}
          <div class="fbt-item" data-price="{{ comp_product.price }}" data-variant-id="{{ comp_product.selected_or_first_available_variant.id }}">
            <div class="fbt-item-image">
              <img src="{{ comp_product.featured_image | image_url: width: 160 }}" alt="{{ comp_product.title | escape }}" loading="lazy" width="70" height="70">
            </div>
            <div class="fbt-item-info">
              <a href="{{ comp_product.url }}" class="fbt-item-name">{{ comp_product.title | truncate: 25 }}</a>
              <span class="fbt-item-price">{{ comp_product.price | money }}</span>
            </div>
            <input type="checkbox" class="fbt-checkbox" checked data-variant-id="{{ comp_product.selected_or_first_available_variant.id }}" data-price="{{ comp_product.price }}">
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Bundle Action Summary -->
    <div class="fbt-action-summary">
      <div class="fbt-pricing">
        <span class="fbt-price-label">Bundle Price:</span>
        <span class="fbt-total-price" id="fbt-bundle-total-price">{{ product.price | money }}</span>
      </div>
      <button type="button" class="fbt-add-bundle-button button" id="fbt-bundle-add-btn">
        Add Bundle to Cart
      </button>
    </div>
  </div>
</div>

<style>
  .fbt-bundle-container {
    margin: 32px 0;
    padding: 24px;
    background: #fafafa;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
  }
  .fbt-header {
    margin-bottom: 20px;
  }
  .fbt-title {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    color: #111827;
  }
  .fbt-subtitle {
    margin: 4px 0 0;
    font-size: 13px;
    color: #6b7280;
  }
  .fbt-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .fbt-items-row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .fbt-item {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 10px 14px;
    flex: 1;
    min-width: 200px;
  }
  .fbt-item-image img {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 6px;
  }
  .fbt-item-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }
  .fbt-item-badge {
    font-size: 11px;
    font-weight: 600;
    color: #4b5563;
    text-transform: uppercase;
  }
  .fbt-item-name {
    font-size: 13px;
    font-weight: 600;
    color: #111827;
    text-decoration: none;
  }
  .fbt-item-price {
    font-size: 13px;
    font-weight: 700;
    color: #059669;
  }
  .fbt-plus-sign {
    font-size: 20px;
    font-weight: 700;
    color: #9ca3af;
  }
  .fbt-checkbox {
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: #111827;
  }
  .fbt-action-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid #e5e7eb;
    flex-wrap: wrap;
    gap: 12px;
  }
  .fbt-pricing {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .fbt-price-label {
    font-size: 13px;
    color: #6b7280;
  }
  .fbt-total-price {
    font-size: 18px;
    font-weight: 700;
    color: #111827;
  }
  .fbt-add-bundle-button {
    background: #111827;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 8px;
    cursor: pointer;
    border: none;
    transition: background 0.2s ease;
  }
  .fbt-add-bundle-button:hover {
    background: #27272a;
  }
</style>

<script>
  (function() {
    function initFBT() {
      const container = document.querySelector('.fbt-bundle-container');
      if (!container) return;
      const checkboxes = container.querySelectorAll('.fbt-checkbox');
      const addBtn = document.getElementById('fbt-bundle-add-btn');

      async function addBundle() {
        if (!addBtn) return;
        addBtn.disabled = true;
        addBtn.textContent = 'Adding Bundle...';

        const itemsToAdd = [];
        checkboxes.forEach(cb => {
          if (cb.checked) {
            itemsToAdd.push({
              id: parseInt(cb.dataset.variantId),
              quantity: 1
            });
          }
        });

        if (itemsToAdd.length === 0) {
          addBtn.disabled = false;
          addBtn.textContent = 'Add Bundle to Cart';
          return;
        }

        try {
          const res = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: itemsToAdd })
          });
          if (res.ok) {
            addBtn.textContent = 'Bundle Added!';
            addBtn.style.background = '#059669';
            // Open cart drawer or refresh
            window.location.reload();
          } else {
            addBtn.textContent = 'Error Adding';
            addBtn.disabled = false;
          }
        } catch(e) {
          addBtn.textContent = 'Add Bundle to Cart';
          addBtn.disabled = false;
        }
      }

      if (addBtn) {
        addBtn.addEventListener('click', addBundle);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFBT);
    } else {
      initFBT();
    }
  })();
</script>
