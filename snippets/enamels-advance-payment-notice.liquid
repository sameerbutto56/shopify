{% comment %}
  Enamels Advance Payment Notice Component
  Displays formatted, professional, customer-facing advance payment instructions
  for customized orders in customization wizard, cart drawer, and checkout triggers.
  - Fully responsive on desktop, tablet, and mobile.
  - Completely editable through Shopify Theme Editor (Studio).
  - Clear typography, appropriate spacing, alignment, and visual hierarchy.
{% endcomment %}

{%- liquid
  assign show_notice = settings.customizer_advance_pay_show
  if show_notice == nil
    assign show_notice = true
  endif

  assign heading = settings.customizer_advance_pay_heading | default: 'Advance Payment Policy & Verification Instructions'
  assign badge = settings.customizer_advance_pay_badge | default: '100% ADVANCE PAYMENT'
  
  assign line1_title = settings.customizer_advance_pay_line1_title | default: '1. Bespoke Tailoring Requirement'
  assign line1_desc = settings.customizer_advance_pay_line1_desc | default: 'Customized scrubs are crafted specifically to your personal measurements, personalized embroidery, and hospital insignia. Cash on Delivery (COD) is strictly unavailable.'

  assign line2_title = settings.customizer_advance_pay_line2_title | default: '2. Available Payment Gateways'
  assign line2_desc = settings.customizer_advance_pay_line2_desc | default: 'Pay seamlessly through Shopify official checkout via Credit/Debit Card or Online Bank Transfer. Enjoy an instant 2% discount on subtotal when paying via Online Bank Transfer.'

  assign line3_title = settings.customizer_advance_pay_line3_title | default: '3. Verification & Tailoring Timeline'
  assign line3_desc = settings.customizer_advance_pay_line3_desc | default: 'For Online Bank Transfer orders, please send your payment transaction screenshot/receipt with your Order # to our official WhatsApp (+92 300 0000000). Tailoring begins immediately once payment is verified.'

  assign line4_title = settings.customizer_advance_pay_line4_title | default: '4. Mixed Cart Policy'
  assign line4_desc = settings.customizer_advance_pay_line4_desc | default: 'If your order combines customized scrubs with standard ready-to-wear apparel, 100% advance payment applies to the entire order.'
-%}

{%- if show_notice -%}
<div class="enamels-advance-payment-card" role="region" aria-label="{{ heading | escape }}">
  <!-- Card Header -->
  <div class="eap-header">
    <div class="eap-header-left">
      <span class="eap-shield-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>
      </span>
      <h4 class="eap-title">{{ heading | escape }}</h4>
    </div>
    {%- if badge != blank -%}
      <span class="eap-badge">{{ badge | escape }}</span>
    {%- endif -%}
  </div>

  <!-- Instruction Rows Grid -->
  <div class="eap-grid">
    <!-- Row 1: Bespoke Requirement -->
    <div class="eap-row">
      <div class="eap-icon-bubble" aria-hidden="true">🔒</div>
      <div class="eap-row-content">
        <strong class="eap-row-title">{{ line1_title | escape }}</strong>
        <p class="eap-row-desc">{{ line1_desc | escape }}</p>
      </div>
    </div>

    <!-- Row 2: Payment Gateways -->
    <div class="eap-row">
      <div class="eap-icon-bubble" aria-hidden="true">💳</div>
      <div class="eap-row-content">
        <strong class="eap-row-title">{{ line2_title | escape }}</strong>
        <p class="eap-row-desc">{{ line2_desc | escape }}</p>
      </div>
    </div>

    <!-- Row 3: Verification Protocol -->
    <div class="eap-row">
      <div class="eap-icon-bubble" aria-hidden="true">⚡</div>
      <div class="eap-row-content">
        <strong class="eap-row-title">{{ line3_title | escape }}</strong>
        <p class="eap-row-desc">{{ line3_desc | escape }}</p>
      </div>
    </div>

    <!-- Row 4: Mixed Cart Policy -->
    {%- if line4_title != blank and line4_desc != blank -%}
    <div class="eap-row">
      <div class="eap-icon-bubble" aria-hidden="true">📦</div>
      <div class="eap-row-content">
        <strong class="eap-row-title">{{ line4_title | escape }}</strong>
        <p class="eap-row-desc">{{ line4_desc | escape }}</p>
      </div>
    </div>
    {%- endif -%}
  </div>
</div>

<style>
  .enamels-advance-payment-card {
    background: #ffffff;
    border: 1.5px solid #0d9488;
    border-radius: 12px;
    padding: 16px 18px;
    margin: 18px 0;
    box-shadow: 0 4px 14px rgba(13, 148, 136, 0.08);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .eap-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom: 1px solid #ccfbf1;
    flex-wrap: wrap;
    gap: 8px;
  }

  .eap-header-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .eap-shield-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #0f766e;
    background: #f0fdfa;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid #99f6e4;
  }

  .eap-title {
    font-size: 13.5px;
    font-weight: 800;
    color: #0f766e;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .eap-badge {
    display: inline-block;
    background: #0f766e;
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 3px 8px;
    border-radius: 999px;
    text-transform: uppercase;
  }

  .eap-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .eap-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 10px 12px;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .eap-row:hover {
    background: #f1f5f9;
    border-color: #cbd5e1;
  }

  .eap-icon-bubble {
    font-size: 16px;
    line-height: 1.2;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .eap-row-content {
    flex: 1;
    min-width: 0;
  }

  .eap-row-title {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 2px;
  }

  .eap-row-desc {
    font-size: 11.5px;
    color: #475569;
    line-height: 1.45;
    margin: 0;
  }

  @media (max-width: 767px) {
    .enamels-advance-payment-card {
      padding: 12px 14px;
      margin: 14px 0;
    }
    .eap-title {
      font-size: 12.5px;
    }
    .eap-row {
      padding: 8px 10px;
      gap: 8px;
    }
    .eap-row-title {
      font-size: 11.5px;
    }
    .eap-row-desc {
      font-size: 11px;
    }
  }
</style>
{%- endif -%}
