{% comment %}
  Enamels Modular Customizer Studio Banner Section
  Provides promotional showcase for 'Make Your Own Scrubs' with custom measurements,
  embroidery details, image upload, and direct link into the interactive customizer.
{% endcomment %}

{%- liquid
  assign enable_section = section.settings.enable_section
  assign badge_text = section.settings.badge | strip
  assign tag_text = section.settings.tag | strip
  assign title_text = section.settings.title | strip
  assign desc_text = section.settings.description | strip
  assign button_label = section.settings.button_label | strip
  assign button_link = section.settings.button_link | default: '#ready-to-wear'
  assign section_bg = section.settings.section_bg | default: '#ffffff'
  assign pad_top = section.settings.padding_top | default: 48
  assign pad_bottom = section.settings.padding_bottom | default: 24
-%}

{% if enable_section %}
<section class="page-container enamels-homepage-modular-section" style="background-color: {{ section_bg }}; padding: {{ pad_top }}px 0 {{ pad_bottom }}px;" id="homepage-customizer-banner" aria-label="Make Your Own Scrubs Bespoke Studio">
  <div class="customizer-editorial-banner">
    <div class="customizer-banner-media">
      {% if badge_text != blank %}
        <span class="customizer-banner-badge">{{ badge_text | escape }}</span>
      {% endif %}
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 800 }}"
          alt="{{ section.settings.image.alt | default: title_text | default: 'Make Your Own Scrubs Custom Studio' | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        />
      {% else %}
        <div class="customizer-banner-placeholder" style="background: #f1f5f9; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; min-height: 280px;">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
            <path d="M20.38 3.46L16 2a4 4 0 01-8 0L3.62 3.46a2 2 0 00-1.34 2.23l.58 3.47a1 1 0 00.99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 002-2V10h2.15a1 1 0 00.99-.84l.58-3.47a2 2 0 00-1.34-2.23z"/>
          </svg>
        </div>
      {% endif %}
    </div>
    <div class="customizer-banner-content">
      {% if tag_text != blank %}
        <span class="categories-section-tag" style="margin-bottom: 8px;">{{ tag_text | escape }}</span>
      {% endif %}
      {% if title_text != blank %}
        <h2 class="customizer-banner-title">{{ title_text | escape }}</h2>
      {% endif %}
      {% if desc_text != blank %}
        <p class="customizer-banner-desc">{{ desc_text | escape }}</p>
      {% endif %}
      {% if section.settings.feat1_text != blank or section.settings.feat2_text != blank or section.settings.feat3_text != blank or section.settings.feat4_text != blank %}
        <div class="customizer-banner-features">
          {% if section.settings.feat1_text != blank %}
            <div class="customizer-feat-item">
              {% if section.settings.feat1_icon != blank %}<span class="feat-icon">{{ section.settings.feat1_icon }}</span>{% endif %}
              <span>{{ section.settings.feat1_text | escape }}</span>
            </div>
          {% endif %}
          {% if section.settings.feat2_text != blank %}
            <div class="customizer-feat-item">
              {% if section.settings.feat2_icon != blank %}<span class="feat-icon">{{ section.settings.feat2_icon }}</span>{% endif %}
              <span>{{ section.settings.feat2_text | escape }}</span>
            </div>
          {% endif %}
          {% if section.settings.feat3_text != blank %}
            <div class="customizer-feat-item">
              {% if section.settings.feat3_icon != blank %}<span class="feat-icon">{{ section.settings.feat3_icon }}</span>{% endif %}
              <span>{{ section.settings.feat3_text | escape }}</span>
            </div>
          {% endif %}
          {% if section.settings.feat4_text != blank %}
            <div class="customizer-feat-item">
              {% if section.settings.feat4_icon != blank %}<span class="feat-icon">{{ section.settings.feat4_icon }}</span>{% endif %}
              <span>{{ section.settings.feat4_text | escape }}</span>
            </div>
          {% endif %}
        </div>
      {% endif %}
      {% if button_label != blank %}
        <div style="margin-top: 24px;">
          <button
            type="button"
            class="btn-hero-primary"
            onclick="if (typeof window.navigateToView === 'function') { window.navigateToView('ready-to-wear'); } else { window.location.href = '{{ button_link }}'; }"
            style="padding: 14px 28px; font-size: 14px;"
          >
            {{ button_label | escape }}
          </button>
        </div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Customizer Studio Banner",
  "class": "enamels-customizer-banner-wrapper",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Section",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Media Badge",
      "default": "BESPOKE CUSTOM STUDIO"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Header Tag",
      "default": "TAILORED CLINICAL PRECISION"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Banner Title",
      "default": "Make Your Own Scrubs"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Banner Description",
      "default": "Experience our interactive customization studio. Select proprietary medical fabrics, approved hospital shades, custom measurements in inches or cm, size auto-fill, C (Custom) fit, and personalized doctor title & hospital crest embroidery."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Launch Customizer Studio →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Fallback Button Link"
    },
    {
      "type": "header",
      "content": "Feature Highlights"
    },
    {
      "type": "text",
      "id": "feat1_icon",
      "label": "Feature 1 Icon/Emoji",
      "default": "📏"
    },
    {
      "type": "text",
      "id": "feat1_text",
      "label": "Feature 1 Text",
      "default": "Custom Measurements (Inches / CM)"
    },
    {
      "type": "text",
      "id": "feat2_icon",
      "label": "Feature 2 Icon/Emoji",
      "default": "🎨"
    },
    {
      "type": "text",
      "id": "feat2_text",
      "label": "Feature 2 Text",
      "default": "Proprietary Fabrics & Hospital Shades"
    },
    {
      "type": "text",
      "id": "feat3_icon",
      "label": "Feature 3 Icon/Emoji",
      "default": "🪡"
    },
    {
      "type": "text",
      "id": "feat3_text",
      "label": "Feature 3 Text",
      "default": "Doctor Name & Department Crest Embroidery"
    },
    {
      "type": "text",
      "id": "feat4_icon",
      "label": "Feature 4 Icon/Emoji",
      "default": "⚡"
    },
    {
      "type": "text",
      "id": "feat4_text",
      "label": "Feature 4 Text",
      "default": "Direct Shopify Cart & Checkout Integration"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Customizer Studio Banner"
    }
  ]
}
{% endschema %}
