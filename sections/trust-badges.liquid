{% doc %}
  Trust Badges / Value Propositions Section for Pakistan E-Commerce
{% enddoc %}

<div class="trust-badges-section section-padding" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="page-width">
    <div class="trust-badges-grid">
      {% for block in section.blocks %}
        <div class="trust-badge-item" {{ block.shopify_attributes }}>
          <div class="trust-badge-icon">
            {% case block.settings.icon %}
              {% when 'truck' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="1" y="3" width="15" height="13"></rect>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
              {% when 'cash' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="6" width="20" height="12" rx="2"></rect>
                  <circle cx="12" cy="12" r="2"></circle>
                  <path d="M6 12h.01M18 12h.01"></path>
                </svg>
              {% when 'repeat' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                  <path d="M3 3v5h5"></path>
                </svg>
              {% when 'shield' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <polyline points="9 12 11 14 15 10"></polyline>
                </svg>
              {% when 'chat' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
            {% endcase %}
          </div>
          <div class="trust-badge-content">
            <h4 class="trust-badge-title">{{ block.settings.title | escape }}</h4>
            <p class="trust-badge-subtitle">{{ block.settings.subtitle | escape }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .trust-badges-section {
    border-top: 1px solid var(--color-border, #e5e7eb);
    border-bottom: 1px solid var(--color-border, #e5e7eb);
    padding: 24px 0;
  }
  .trust-badges-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    align-items: center;
  }
  .trust-badge-item {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .trust-badge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #f4f4f5;
    color: #111827;
    flex-shrink: 0;
  }
  .trust-badge-title {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.25;
    color: inherit;
    letter-spacing: -0.01em;
  }
  .trust-badge-subtitle {
    margin: 4px 0 0;
    font-size: 12px;
    color: #6b7280;
    line-height: 1.3;
  }
  @media screen and (max-width: 989px) {
    .trust-badges-grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 20px;
    }
  }
  @media screen and (max-width: 640px) {
    .trust-badges-grid {
      grid-template-columns: 1fr;
      row-gap: 16px;
    }
    .trust-badge-item {
      justify-content: flex-start;
    }
  }
</style>

{% schema %}
{
  "name": "Trust Badges & Perks",
  "tag": "section",
  "class": "section-trust-badges",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111827"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Perk Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery Truck" },
            { "value": "cash", "label": "Cash on Delivery" },
            { "value": "repeat", "label": "Easy Returns" },
            { "value": "shield", "label": "100% Original Guarantee" },
            { "value": "chat", "label": "Support Chat" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Nationwide Delivery"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subheading",
          "default": "Fast shipping across Pakistan"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges & Perks",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "truck",
            "title": "Nationwide Delivery",
            "subtitle": "Fast 3-5 days delivery in Pakistan"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "cash",
            "title": "Cash on Delivery",
            "subtitle": "Pay cash at your doorstep"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "repeat",
            "title": "7-Day Easy Exchange",
            "subtitle": "Hassle-free size & style exchange"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "shield",
            "title": "100% Original Quality",
            "subtitle": "Premium fabric & tailored stitching"
          }
        }
      ]
    }
  ]
}
{% endschema %}
