{% comment %}
  ENAMELS ONLINE — MODULAR HEADER & NAVIGATION SECTION
  Compatible with Shopify Online Store 2.0 Theme Editor.
  Supports custom logo, desktop/mobile logo sizes, Shopify linklists menu,
  customer support phone badge, announcement ticker, and cart drawer launcher.
{% endcomment %}

<div class="enamels-header-section-wrapper" id="Header-{{ section.id }}" data-section-id="{{ section.id }}">
  <!-- Top Announcement Bar -->
  {% if section.settings.show_announcement %}
    <div class="enamels-announcement-bar" style="background-color: {{ section.settings.announcement_bg }}; color: {{ section.settings.announcement_color }};">
      <div class="enamels-announcement-track">
        <span>{{ section.settings.announcement_text_1 | default: '✨ FREE NATIONWIDE DELIVERY ON ORDERS OVER RS. 7,000' | escape }}</span>
        <span>{{ section.settings.announcement_text_2 | default: '💵 CASH ON DELIVERY (COD) AVAILABLE ACROSS ALL CITIES IN PAKISTAN' | escape }}</span>
        <span>{{ section.settings.announcement_text_3 | default: '⚡ 7-DAY HASSLE-FREE SIZE EXCHANGE VIA WHATSAPP' | escape }}</span>
        <span>{{ section.settings.announcement_text_4 | default: '🪡 BESPOKE DOCTOR NAME EMBROIDERY & HOSPITAL CRESTS AVAILABLE' | escape }}</span>
        <span>{{ section.settings.announcement_text_1 | default: '✨ FREE NATIONWIDE DELIVERY ON ORDERS OVER RS. 7,000' | escape }}</span>
        <span>{{ section.settings.announcement_text_2 | default: '💵 CASH ON DELIVERY (COD) AVAILABLE ACROSS ALL CITIES IN PAKISTAN' | escape }}</span>
      </div>
    </div>
  {% endif %}

  <!-- Main White Header -->
  <header class="enamels-header" style="background-color: {{ section.settings.header_bg | default: '#ffffff' }}; border-bottom: 1px solid {{ section.settings.header_border | default: '#e2e8f0' }};">
    <div class="page-container">
      <div class="header-top-row">
        <!-- 1. Brand Logo -->
        <a href="{{ routes.root_url }}" class="header-logo-wrap" title="{{ shop.name | escape }}">
          {% if section.settings.logo != blank %}
            {{ section.settings.logo | image_url: width: 300 | image_tag:
              loading: 'eager',
              class: 'header-logo-img',
              style: 'max-width: ' | append: section.settings.logo_width | append: 'px; height: auto;'
            }}
          {% elsif settings.logo != blank %}
            {{ settings.logo | image_url: width: 300 | image_tag:
              loading: 'eager',
              class: 'header-logo-img',
              style: 'max-width: ' | append: section.settings.logo_width | append: 'px; height: auto;'
            }}
          {% else %}
            <img
              src="{{ 'enamels-logo.png' | asset_url }}"
              alt="{{ shop.name | escape }}"
              class="header-logo-img"
              width="{{ section.settings.logo_width | default: 100 }}"
              height="48"
              loading="eager"
            />
          {% endif %}
        </a>

        <!-- 2. Search Bar -->
        {% if section.settings.show_search %}
          <div class="header-search-wrap">
            <svg class="header-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
            </svg>
            <input
              type="search"
              class="header-search-input"
              id="enamels-header-search-input-{{ section.id }}"
              placeholder="{{ section.settings.search_placeholder | default: 'Search scrubs, lab coats, surgical caps, sleeves...' | escape }}"
              onfocus="if(window.openSearchModal){window.openSearchModal();}"
              aria-label="Search Catalog"
            />
          </div>
        {% endif %}

        <!-- 3. Actions & Contact Info -->
        <div class="header-actions-wrap">
          {% if section.settings.show_phone and section.settings.phone_number != blank %}
            <a href="tel:{{ section.settings.phone_number | replace: ' ', '' }}" class="customer-service-badge" title="Customer Support">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>{{ section.settings.phone_number | escape }}</span>
            </a>
          {% endif %}

          <!-- Wishlist Button -->
          <button type="button" class="header-action-btn" onclick="if(window.openWishlistModal){window.openWishlistModal();}" aria-label="Wishlist">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            <span class="cart-bubble-badge" id="enamels-wishlist-count-{{ section.id }}" style="background: #102a43;">0</span>
          </button>

          <!-- Cart Button -->
          <button type="button" class="header-action-btn" onclick="if(window.openCartDrawer){window.openCartDrawer();}" aria-label="Shopping Cart">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
            <span class="cart-bubble-badge" id="enamels-cart-count-{{ section.id }}">0</span>
          </button>

          <!-- Mobile Hamburger -->
          <button type="button" class="header-action-btn mobile-only-toggle" onclick="if(window.toggleMobileNavDrawer){window.toggleMobileNavDrawer();}" aria-label="Open Navigation Menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Category Navigation Bar -->
    <nav class="enamels-nav-bar" aria-label="Main Category Navigation">
      <div class="page-container">
        <ul class="enamels-nav-list">
          {% if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 %}
            {% for link in linklists[section.settings.menu].links %}
              <li class="enamels-nav-item">
                <a href="{{ link.url }}" class="enamels-nav-link">
                  <span>{{ link.title | escape }}</span>
                  {% if link.links.size > 0 %}
                    <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                  {% endif %}
                </a>
                {% if link.links.size > 0 %}
                  <div class="enamels-nav-dropdown">
                    {% for childlink in link.links %}
                      <a href="{{ childlink.url }}" class="dropdown-item-link">
                        <strong>{{ childlink.title | escape }}</strong>
                      </a>
                    {% endfor %}
                  </div>
                {% endif %}
              </li>
            {% endfor %}
          {% else %}
            <!-- Default Enamels 6-Category Navigation -->
            <li class="enamels-nav-item" id="nav-item-scrubs">
              <a href="#category-scrubs" class="enamels-nav-link" onclick="if(window.navigateToView){window.navigateToView('category-scrubs'); return false;}">
                <span>Scrubs</span>
                <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </a>
              <div class="enamels-nav-dropdown">
                <a href="#collection-sprinter" class="dropdown-item-link" onclick="if(window.navigateToCollection){window.navigateToCollection('Sprinter'); return false;}">
                  <strong>Sprinter Series</strong>
                  <span>4-Way Athletic Mechanical Stretch</span>
                </a>
                <a href="#collection-velora" class="dropdown-item-link" onclick="if(window.navigateToCollection){window.navigateToCollection('Velora'); return false;}">
                  <strong>Velora Series</strong>
                  <span>Luxury Tailored Micro-Drape</span>
                </a>
                <a href="#collection-crown" class="dropdown-item-link" onclick="if(window.navigateToCollection){window.navigateToCollection('Crown'); return false;}">
                  <strong>Crown Series</strong>
                  <span>Executive Structured Mandarin Collar</span>
                </a>
                <a href="#collection-flexfit" class="dropdown-item-link" onclick="if(window.navigateToCollection){window.navigateToCollection('FlexFit'); return false;}">
                  <strong>FlexFit Series</strong>
                  <span>Antimicrobial Laser-Perforated Weave</span>
                </a>
              </div>
            </li>
            <li class="enamels-nav-item">
              <a href="#collection-lab-coats" class="enamels-nav-link" onclick="if(window.navigateToCollection){window.navigateToCollection('lab-coat', 'category'); return false;}">
                <span>Lab Coats</span>
              </a>
            </li>
            <li class="enamels-nav-item">
              <a href="#collection-caps" class="enamels-nav-link" onclick="if(window.navigateToCollection){window.navigateToCollection('caps', 'category'); return false;}">
                <span>Caps</span>
                <span class="nav-tag-badge">BunFit™</span>
              </a>
            </li>
            <li class="enamels-nav-item">
              <a href="#collection-sleeves" class="enamels-nav-link" onclick="if(window.navigateToCollection){window.navigateToCollection('sleeves', 'feature'); return false;}">
                <span>Sleeves</span>
              </a>
            </li>
            <li class="enamels-nav-item">
              <a href="#collection-accessories" class="enamels-nav-link" onclick="if(window.navigateToCollection){window.navigateToCollection('accessories', 'category'); return false;}">
                <span>Accessories</span>
              </a>
            </li>
            <li class="enamels-nav-item">
              <a href="#ready-to-wear" class="enamels-nav-link" onclick="if(window.navigateToView){window.navigateToView('ready-to-wear'); return false;}" style="color: #102a43; font-weight: 700;">
                <span>Ready to Wear / Make Your Own Scrub</span>
                <span class="nav-tag-highlight">STUDIO</span>
              </a>
            </li>
          {% endif %}
        </ul>
      </div>
    </nav>
  </header>
</div>

{% schema %}
{
  "name": "Enamels Header",
  "tag": "section",
  "class": "section-enamels-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Brand Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Max Width (Desktop)",
      "min": 50,
      "max": 250,
      "step": 5,
      "unit": "px",
      "default": 105
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "info": "Leave blank to display the default Enamels 6-Category Navigation bar."
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Input",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder Text",
      "default": "Search scrubs, lab coats, surgical caps, sleeves..."
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show Customer Service Phone Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Customer Support Phone",
      "default": "+92 301 13 31 133"
    },
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Enable Announcement Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text_1",
      "label": "Announcement 1",
      "default": "✨ FREE NATIONWIDE DELIVERY ON ORDERS OVER RS. 7,000"
    },
    {
      "type": "text",
      "id": "announcement_text_2",
      "label": "Announcement 2",
      "default": "💵 CASH ON DELIVERY (COD) AVAILABLE ACROSS ALL CITIES IN PAKISTAN"
    },
    {
      "type": "text",
      "id": "announcement_text_3",
      "label": "Announcement 3",
      "default": "⚡ 7-DAY HASSLE-FREE SIZE EXCHANGE VIA WHATSAPP"
    },
    {
      "type": "text",
      "id": "announcement_text_4",
      "label": "Announcement 4",
      "default": "🪡 BESPOKE DOCTOR NAME EMBROIDERY & HOSPITAL CRESTS AVAILABLE"
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Announcement Background",
      "default": "#102a43"
    },
    {
      "type": "color",
      "id": "announcement_color",
      "label": "Announcement Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "header_bg",
      "label": "Header Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "header_border",
      "label": "Header Border Color",
      "default": "#e2e8f0"
    }
  ],
  "presets": [
    {
      "name": "Enamels Header"
    }
  ]
}
{% endschema %}
