{% comment %}
  Section contract: Shop by Series
  Interactive 3D-tilt showcase for Enamels signature scrub lines (Sprinter, Velora, Crown, BunFit).
  @example
  <!-- Included in templates/index.json -->
{% endcomment %}

<div class="shop-by-series-section section-padding" style="background-color: {{ section.settings.bg_color | default: '#ffffff' }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="series-section-header" style="max-width: 760px; margin: 0 auto 48px auto; text-align: center;">
      {% if section.settings.badge != blank %}
        <span class="series-section-badge" style="display: inline-block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: #0d9488; background: #f0fdfa; border: 1px solid #ccfbf1; padding: 4px 14px; border-radius: 999px; margin-bottom: 12px;">
          {{ section.settings.badge | escape }}
        </span>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="series-section-title" style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 800; color: #0f172a; margin: 0 0 14px 0; letter-spacing: -0.02em;">
          {{ section.settings.title | escape }}
        </h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="series-section-subtitle" style="font-size: 1.05rem; color: #64748b; line-height: 1.6; margin: 0;">
          {{ section.settings.subtitle | escape }}
        </p>
      {% endif %}
    </div>

    <div class="series-cards-grid">
      {% for block in section.blocks %}
        {%- liquid
          assign card_title = block.settings.title | strip
          assign card_subtitle = block.settings.subtitle | strip
          assign card_price = block.settings.price_text | strip
          assign card_desc = block.settings.description | strip
          assign card_features = block.settings.features | strip
          assign card_colors = block.settings.colors | strip
          assign card_btn_label = block.settings.button_label | strip
          assign card_link = block.settings.link

          assign has_series_body = false
          if card_title != blank or card_subtitle != blank or card_price != blank or card_desc != blank or card_features != blank or card_colors != blank or card_btn_label != blank
            assign has_series_body = true
          endif
        -%}
        <div class="series-card enamels-3d-card{% unless has_series_body %} is-image-only{% endunless %}" {{ block.shopify_attributes }}>
          <div class="series-card-inner">
            <div class="series-card-media-wrapper">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'series-card-img', alt: card_title }}
              {% else %}
                <div class="series-card-placeholder-bg" style="background: linear-gradient(135deg, {{ block.settings.accent_color | default: '#0f172a' }} 0%, #1e293b 100%);">
                  <div class="series-placeholder-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.7)" stroke-width="1.5">
                      <path d="M20.38 3.46L16 2a4 4 0 01-8 0L3.62 3.46a2 2 0 00-1.34 2.23l.58 3.47a1 1 0 00.99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 002-2V10h2.15a1 1 0 00.99-.84l.58-3.47a2 2 0 00-1.34-2.23z"/>
                    </svg>
                  </div>
                </div>
              {% endif %}

              {% if block.settings.tag != blank %}
                <span class="series-card-tag" style="background-color: {{ block.settings.tag_bg | default: '#0f172a' }}; color: #ffffff;">
                  {{ block.settings.tag | escape }}
                </span>
              {% endif %}
            </div>

            {% if has_series_body %}
            <div class="series-card-body">
              {% if card_title != blank or card_subtitle != blank or card_price != blank %}
              <div class="series-card-header-row">
                <div>
                  {% if card_title != blank %}
                    <h3 class="series-card-title">{{ card_title | escape }}</h3>
                  {% endif %}
                  {% if card_subtitle != blank %}
                    <span class="series-card-type">{{ card_subtitle | escape }}</span>
                  {% endif %}
                </div>
                {% if card_price != blank %}
                  <div class="series-card-price-pill">
                    {{ card_price | escape }}
                  </div>
                {% endif %}
              </div>
              {% endif %}

              {% if card_desc != blank %}
                <p class="series-card-desc">{{ card_desc | escape }}</p>
              {% endif %}

              {% if card_features != blank %}
                <div class="series-card-features">
                  {% assign feature_list = card_features | split: '•' %}
                  {% for feat in feature_list %}
                    {% assign feat_clean = feat | strip %}
                    {% if feat_clean != blank %}
                      <span class="series-feature-chip">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="3">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        {{ feat_clean }}
                      </span>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              <!-- Color Palette Dots Preview -->
              {% if card_colors != blank %}
                <div class="series-swatches-preview">
                  <span class="series-swatch-label">Available Colors:</span>
                  <div class="series-swatch-dots">
                    {% assign color_list = card_colors | split: ',' %}
                    {% for hex in color_list %}
                      {% assign hex_clean = hex | strip %}
                      {% if hex_clean != blank %}
                        <span class="series-swatch-dot" style="background-color: {{ hex_clean }};" title="{{ hex_clean }}"></span>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              {% endif %}

              {% if card_btn_label != blank %}
              <div class="series-card-footer">
                <a href="{{ card_link | default: '/collections/all' }}" class="series-explore-btn">
                  <span>{{ card_btn_label | escape }}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
              {% endif %}
            </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .series-card.is-image-only {
    height: fit-content;
  }
  .series-card.is-image-only .series-card-inner {
    height: auto;
  }
  .series-card.is-image-only .series-card-body,
  .series-card-body:empty {
    display: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  #shopify-section-{{ section.id }} .series-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax({{ section.settings.card_width_desktop | default: 280 }}px, 1fr));
    gap: {{ section.settings.grid_gap_desktop | default: 28 }}px;
  }

  #shopify-section-{{ section.id }} .series-card {
    background: #ffffff;
    border-radius: {{ section.settings.card_border_radius | default: 16 }}px;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.05);
  }

  #shopify-section-{{ section.id }} .series-card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .series-card-media-wrapper {
    position: relative;
    width: 100%;
    border-radius: {{ section.settings.card_border_radius | default: 16 }}px {{ section.settings.card_border_radius | default: 16 }}px 0 0;
    overflow: hidden;
    background: #f1f5f9;
    {% if section.settings.image_aspect_ratio == 'custom' %}
      height: {{ section.settings.media_height_desktop | default: 300 }}px;
      aspect-ratio: unset;
    {% elsif section.settings.image_aspect_ratio == '1_1' %}
      aspect-ratio: 1 / 1;
      height: auto;
    {% elsif section.settings.image_aspect_ratio == '3_4' %}
      aspect-ratio: 3 / 4;
      height: auto;
    {% elsif section.settings.image_aspect_ratio == '16_9' %}
      aspect-ratio: 16 / 9;
      height: auto;
    {% elsif section.settings.image_aspect_ratio == 'natural' %}
      aspect-ratio: auto;
      height: auto;
    {% else %}
      aspect-ratio: 4 / 3;
      height: auto;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .series-card.is-image-only .series-card-media-wrapper {
    border-radius: {{ section.settings.card_border_radius | default: 16 }}px;
  }

  #shopify-section-{{ section.id }} .series-card-img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit_mode | default: 'cover' }};
    object-position: {{ section.settings.image_pos_x | default: 'center' }} {{ section.settings.image_pos_y | default: 'center' }};
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  #shopify-section-{{ section.id }} .series-card-body {
    padding: {{ section.settings.body_padding | default: 24 }}px;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .series-cards-grid {
      grid-template-columns: repeat(auto-fill, minmax({{ section.settings.card_width_mobile | default: 240 }}px, 1fr));
      gap: {{ section.settings.grid_gap_mobile | default: 16 }}px;
    }
    {% if section.settings.image_aspect_ratio == 'custom' %}
      #shopify-section-{{ section.id }} .series-card-media-wrapper {
        height: {{ section.settings.media_height_mobile | default: 220 }}px;
      }
    {% endif %}
  }

  .series-card:hover .series-card-img {
    transform: scale(1.05);
  }

  .series-card-placeholder-bg {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .series-card-tag {
    position: absolute;
    top: 14px;
    left: 14px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 6px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  .series-card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .series-card-header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .series-card-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .series-card-type {
    display: block;
    font-size: 0.82rem;
    color: #0d9488;
    font-weight: 600;
    margin-top: 2px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .series-card-price-pill {
    font-size: 0.82rem;
    font-weight: 700;
    color: #0f172a;
    background: #f1f5f9;
    padding: 4px 10px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .series-card-desc {
    font-size: 0.92rem;
    color: #64748b;
    line-height: 1.5;
    margin: 0 0 16px 0;
    flex-grow: 1;
  }

  .series-card-features {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }

  .series-feature-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #334155;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .series-swatches-preview {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    padding-top: 12px;
    border-top: 1px dashed #e2e8f0;
  }

  .series-swatch-label {
    font-size: 0.75rem;
    color: #64748b;
    font-weight: 500;
  }

  .series-swatch-dots {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .series-swatch-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.15);
    display: inline-block;
  }

  .series-card-footer {
    margin-top: auto;
  }

  .series-explore-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 12px 20px;
    background: #0f172a;
    color: #ffffff;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .series-explore-btn:hover {
    background: #0d9488;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(13, 148, 136, 0.3);
  }

  .series-explore-btn svg {
    transition: transform 0.2s ease;
  }

  .series-explore-btn:hover svg {
    transform: translateX(3px);
  }
</style>

{% schema %}
{
  "name": "Shop by Series",
  "tag": "section",
  "class": "section-shop-by-series",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge text",
      "default": "Signature Apparel Lines"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Engineered Series for Every Clinical Demand"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "From dynamic ER shifts to executive consultation rounds, explore Enamels' purpose-built scrub lines crafted with technical fabrics."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Thumbnail & Card Dimensions"
    },
    {
      "type": "range",
      "id": "card_width_desktop",
      "label": "Card Min Width Desktop (px)",
      "min": 200,
      "max": 450,
      "step": 5,
      "default": 280,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_width_mobile",
      "label": "Card Min Width Mobile (px)",
      "min": 150,
      "max": 320,
      "step": 5,
      "default": 240,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "media_height_desktop",
      "label": "Media Height Desktop (px)",
      "min": 160,
      "max": 550,
      "step": 5,
      "default": 300,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "media_height_mobile",
      "label": "Media Height Mobile (px)",
      "min": 140,
      "max": 380,
      "step": 5,
      "default": 220,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "custom", "label": "Custom (Use Height Above)" },
        { "value": "1_1", "label": "1:1 Square" },
        { "value": "4_3", "label": "4:3 Classic" },
        { "value": "3_4", "label": "3:4 Portrait" },
        { "value": "16_9", "label": "16:9 Widescreen" },
        { "value": "natural", "label": "Natural / Auto" }
      ],
      "default": "4_3"
    },
    {
      "type": "select",
      "id": "image_fit_mode",
      "label": "Image Fit Mode",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "image_pos_x",
      "label": "Horizontal Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "image_pos_y",
      "label": "Vertical Image Position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card Border Radius (px)",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "grid_gap_desktop",
      "label": "Grid Gap Desktop (px)",
      "min": 12,
      "max": 48,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "label": "Grid Gap Mobile (px)",
      "min": 8,
      "max": 32,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_padding",
      "label": "Card Body Padding (px)",
      "min": 10,
      "max": 36,
      "step": 2,
      "default": 24,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "series_card",
      "name": "Series Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Series Name",
          "default": "Sprinter Series"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / Category",
          "default": "High-Mobility Athletic Scrubs"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Badge Tag",
          "default": "Best Seller"
        },
        {
          "type": "color",
          "id": "tag_bg",
          "label": "Tag Background",
          "default": "#0d9488"
        },
        {
          "type": "color",
          "id": "accent_color",
          "label": "Placeholder Color",
          "default": "#0f172a"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Series Image"
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Price Tag",
          "default": "From Rs. 5,150"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Engineered for doctors on the move. Features 4-way mechanical stretch, raglan sleeve mobility, and moisture-wicking technology."
        },
        {
          "type": "text",
          "id": "features",
          "label": "Key Features (separated by •)",
          "default": "4-Way Stretch • Moisture Wicking • Fade Resistant"
        },
        {
          "type": "text",
          "id": "colors",
          "label": "Color Swatches (Hex codes separated by comma)",
          "default": "#581c87,#0f172a,#3f4e3b,#6ba4b8,#14532d"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Series Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop Sprinter Series"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Series",
      "blocks": [
        {
          "type": "series_card",
          "settings": {
            "title": "Sprinter Series",
            "subtitle": "High-Mobility Athletic Scrubs",
            "tag": "Most Popular",
            "tag_bg": "#0d9488",
            "price_text": "From Rs. 5,150",
            "description": "Engineered for active surgical and ER shifts. 4-way mechanical stretch, athletic raglan sleeves, and deep cargo utility pockets.",
            "features": "4-Way Stretch • Moisture-Wicking • Anti-Static",
            "colors": "#581c87,#0f172a,#3f4e3b,#6ba4b8,#14532d",
            "button_label": "Shop Sprinter Series"
          }
        },
        {
          "type": "series_card",
          "settings": {
            "title": "Velora Series",
            "subtitle": "Refined Elegance & Comfort",
            "tag": "Signature",
            "tag_bg": "#581c87",
            "price_text": "From Rs. 5,500",
            "description": "Ultra-soft touch with graceful fluid drape. Available in Summit top and tailored Wide-Leg cuts for elevated clinical style.",
            "features": "Ultra-Soft Touch • Fluid Drape • Wrinkle-Resistant",
            "colors": "#581c87,#0f172a,#3f4e3b,#18181b,#64748b",
            "button_label": "Shop Velora Series"
          }
        },
        {
          "type": "series_card",
          "settings": {
            "title": "Crown Series",
            "subtitle": "Executive Tailored Fit",
            "tag": "Premium",
            "tag_bg": "#0f172a",
            "price_text": "From Rs. 6,200",
            "description": "Structured executive presence designed for hospital consultants and department heads with clean notch lapels and tailored lines.",
            "features": "Structured Collar • Anti-Microbial • Executive Cut",
            "colors": "#0f172a,#18181b,#334155",
            "button_label": "Shop Crown Series"
          }
        },
        {
          "type": "series_card",
          "settings": {
            "title": "BunFit™ & Headwear",
            "subtitle": "Extra-Volume Surgical Caps",
            "tag": "Essential",
            "tag_bg": "#0284c7",
            "price_text": "From Rs. 620",
            "description": "Patented expandable pleating accommodating all hair volumes and buns, integrated sweatband, and matching Sprinter fabric tones.",
            "features": "Hair Volume Pleating • Sweatband Lining • Matching Colors",
            "colors": "#581c87,#0f172a,#3f4e3b,#6ba4b8,#14532d",
            "button_label": "Shop Surgical Caps"
          }
        }
      ]
    }
  ]
}
{% endschema %}
