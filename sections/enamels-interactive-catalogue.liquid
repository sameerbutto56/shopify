{% comment %}
  Enamels Interactive Demo Catalogue & End-to-End Shopping Experience Section
  Renders 35 populated demo products across all categories with real 3D card tilt,
  multi-criteria filters, sorting, PDP customizer modal, embroidery simulator,
  and demo checkout flow.
{% endcomment %}

<script src="{{ 'enamels-catalogue-data.js' | asset_url }}" defer></script>

<section class="enamels-catalogue-section page-width" id="enamels-catalogue-root">
  <div class="catalogue-header">
    <div class="catalogue-badge-group">
      <span class="catalogue-pill">🏥 CLINICAL APPAREL CATALOGUE</span>
      <span class="catalogue-counter" id="catalogue-count-badge">35 Products Available</span>
    </div>
    <h2 class="catalogue-title">Engineered Medical Scrubs, Caps & Technical Gear</h2>
    <p class="catalogue-subtitle">Explore the complete Enamels product lineup. Filter by medical department, series, fabric elasticity, or tailor your uniform with certified hospital embroidery.</p>
  </div>

  <!-- Main Filter Bar & Controls -->
  <div class="catalogue-controls-bar">
    <!-- Category Tabs -->
    <div class="catalogue-tabs" id="category-tabs" role="tablist">
      <button type="button" class="cat-tab active" data-category="all" role="tab">All Products (35)</button>
      <button type="button" class="cat-tab" data-category="scrub-set" role="tab">Scrub Sets</button>
      <button type="button" class="cat-tab" data-category="scrub-top" role="tab">Tops</button>
      <button type="button" class="cat-tab" data-category="scrub-pants" role="tab">Pants</button>
      <button type="button" class="cat-tab" data-category="caps" role="tab">Surgical Caps</button>
      <button type="button" class="cat-tab" data-category="lab-coat" role="tab">Lab Coats</button>
      <button type="button" class="cat-tab" data-category="accessories" role="tab">Accessories</button>
      <button type="button" class="cat-tab" data-category="bundles" role="tab">Bundles & Sets</button>
    </div>

    <!-- Secondary Filter & Sort Bar -->
    <div class="catalogue-filters-row">
      <div class="filters-dropdowns">
        <!-- Gender Filter -->
        <div class="filter-select-wrapper">
          <label for="filter-gender" class="visually-hidden">Gender</label>
          <select id="filter-gender" class="catalogue-select">
            <option value="all">All Genders</option>
            <option value="men">Men's Apparel</option>
            <option value="women">Women's Apparel</option>
            <option value="unisex">Unisex Cuts</option>
          </select>
        </div>

        <!-- Series Filter -->
        <div class="filter-select-wrapper">
          <label for="filter-series" class="visually-hidden">Series</label>
          <select id="filter-series" class="catalogue-select">
            <option value="all">All Series</option>
            <option value="Sprinter">Sprinter Series (Athletic)</option>
            <option value="Velora">Velora Series (Soft Drape)</option>
            <option value="Crown">Crown Series (Executive)</option>
            <option value="BunFit">BunFit™ Surgical Caps</option>
            <option value="Helium">Helium Lab Coats</option>
          </select>
        </div>

        <!-- Color Filter -->
        <div class="filter-select-wrapper">
          <label for="filter-color" class="visually-hidden">Color</label>
          <select id="filter-color" class="catalogue-select">
            <option value="all">All Colors</option>
            <option value="navy">Deep Navy</option>
            <option value="teal">Clinical Teal</option>
            <option value="burgundy">Burgundy Maroon</option>
            <option value="royal">Royal Blue</option>
            <option value="ceil">Ceil Blue</option>
            <option value="olive">Olive Shine</option>
            <option value="green">Hunter Green</option>
            <option value="black">Obsidian Black</option>
            <option value="grey">Heather Grey</option>
            <option value="white">Optic White</option>
            <option value="lilac">Lilac / Lavender</option>
          </select>
        </div>

        <!-- Price Range Filter -->
        <div class="filter-select-wrapper">
          <label for="filter-price" class="visually-hidden">Price</label>
          <select id="filter-price" class="catalogue-select">
            <option value="all">All Prices</option>
            <option value="under-3000">Under Rs. 3,000</option>
            <option value="3000-6000">Rs. 3,000 – Rs. 6,000</option>
            <option value="above-6000">Above Rs. 6,000</option>
          </select>
        </div>
      </div>

      <!-- Sorting Select -->
      <div class="sort-select-wrapper">
        <label for="sort-by" class="sort-label">Sort by:</label>
        <select id="sort-by" class="catalogue-select sort-select">
          <option value="featured">Featured & Best Sellers</option>
          <option value="price-low">Price: Low to High</option>
          <option value="price-high">Price: High to Low</option>
          <option value="name">Product Name (A-Z)</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Product Grid -->
  <div class="catalogue-grid" id="catalogue-products-grid" aria-live="polite">
    <!-- Rendered dynamically by JavaScript from EnamelsCatalogue -->
    <div class="catalogue-loading-state">
      <div class="catalogue-spinner"></div>
      <p>Loading Enamels Clinical Catalogue...</p>
    </div>
  </div>

  <!-- Empty State (if filters match 0) -->
  <div class="catalogue-empty-state" id="catalogue-empty" style="display: none;">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <h3>No matching products found</h3>
    <p>Try resetting your filters to view the complete Enamels scrub and accessory collection.</p>
    <button type="button" class="btn-reset-filters" id="btn-reset-filters">Reset All Filters</button>
  </div>
</section>

<!-- ========================================== -->
<!-- INTERACTIVE PRODUCT DETAIL MODAL (PDP SIMULATOR) -->
<!-- ========================================== -->
<div class="pdp-modal-backdrop" id="pdp-modal" role="dialog" aria-modal="true" style="display: none;">
  <div class="pdp-modal-container">
    <button type="button" class="pdp-close-btn" id="pdp-close-trigger" aria-label="Close Product Details">&times;</button>
    
    <div class="pdp-modal-content" id="pdp-modal-body">
      <!-- Injected dynamically on click -->
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- INTERACTIVE SIZE CHART MODAL -->
<!-- ========================================== -->
<div class="size-modal-backdrop" id="size-chart-modal" style="display: none;">
  <div class="size-modal-container">
    <div class="size-modal-header">
      <h3>Enamels Clinical Size & Measurement Guide</h3>
      <button type="button" class="size-close-btn" id="size-modal-close">&times;</button>
    </div>
    <div class="size-modal-body">
      <p class="size-guide-tip"><strong>💡 Pro Tip:</strong> If you are between sizes, we recommend sizing down for an athletic fit, or sizing up for a traditional relaxed ward fit.</p>
      
      <div class="size-unit-toggle">
        <button type="button" class="unit-btn active" data-unit="in">Inches (in)</button>
        <button type="button" class="unit-btn" data-unit="cm">Centimeters (cm)</button>
      </div>

      <div class="size-table-wrapper" id="size-table-in">
        <table class="size-table">
          <thead>
            <tr>
              <th>Size</th>
              <th>Chest</th>
              <th>Waist</th>
              <th>Hips</th>
              <th>Inseam (Jogger)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td><strong>XS</strong></td><td>33 - 35"</td><td>26 - 28"</td><td>34 - 36"</td><td>28"</td></tr>
            <tr><td><strong>S</strong></td><td>36 - 38"</td><td>29 - 31"</td><td>37 - 39"</td><td>28.5"</td></tr>
            <tr><td><strong>M</strong></td><td>39 - 41"</td><td>32 - 34"</td><td>40 - 42"</td><td>29"</td></tr>
            <tr><td><strong>L</strong></td><td>42 - 44"</td><td>35 - 37"</td><td>43 - 45"</td><td>29.5"</td></tr>
            <tr><td><strong>XL</strong></td><td>45 - 47"</td><td>38 - 40"</td><td>46 - 48"</td><td>30"</td></tr>
            <tr><td><strong>2XL</strong></td><td>48 - 50"</td><td>41 - 43"</td><td>49 - 51"</td><td>30.5"</td></tr>
          </tbody>
        </table>
      </div>

      <div class="size-table-wrapper" id="size-table-cm" style="display: none;">
        <table class="size-table">
          <thead>
            <tr>
              <th>Size</th>
              <th>Chest</th>
              <th>Waist</th>
              <th>Hips</th>
              <th>Inseam (Jogger)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td><strong>XS</strong></td><td>84 - 89 cm</td><td>66 - 71 cm</td><td>86 - 91 cm</td><td>71 cm</td></tr>
            <tr><td><strong>S</strong></td><td>91 - 96 cm</td><td>74 - 79 cm</td><td>94 - 99 cm</td><td>72 cm</td></tr>
            <tr><td><strong>M</strong></td><td>99 - 104 cm</td><td>81 - 86 cm</td><td>102 - 107 cm</td><td>74 cm</td></tr>
            <tr><td><strong>L</strong></td><td>107 - 112 cm</td><td>89 - 94 cm</td><td>109 - 114 cm</td><td>75 cm</td></tr>
            <tr><td><strong>XL</strong></td><td>114 - 119 cm</td><td>96 - 102 cm</td><td>117 - 122 cm</td><td>76 cm</td></tr>
            <tr><td><strong>2XL</strong></td><td>122 - 127 cm</td><td>104 - 109 cm</td><td>124 - 130 cm</td><td>77 cm</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- INTERACTIVE DEMO CHECKOUT MODAL -->
<!-- ========================================== -->
<div class="checkout-modal-backdrop" id="demo-checkout-modal" style="display: none;">
  <div class="checkout-modal-container">
    <div class="checkout-modal-header">
      <div class="checkout-title-group">
        <span class="checkout-badge">🔒 ISOLATED TEST CHECKOUT</span>
        <h3>Enamels Clinical Order Confirmation</h3>
      </div>
      <button type="button" class="checkout-close-btn" id="checkout-modal-close">&times;</button>
    </div>

    <div class="checkout-modal-body" id="checkout-modal-content">
      <!-- Checkout Form or Order Success Receipt -->
    </div>
  </div>
</div>

<!-- STYLES -->
<style>
  .enamels-catalogue-section {
    padding-block: 60px 80px;
  }

  .catalogue-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 36px;
  }

  .catalogue-badge-group {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }

  .catalogue-pill {
    background: rgba(0, 184, 169, 0.1);
    color: #00b8a9;
    border: 1px solid rgba(0, 184, 169, 0.25);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .catalogue-counter {
    background: rgba(16, 42, 67, 0.06);
    color: #102a43;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .catalogue-title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: #102a43;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .catalogue-subtitle {
    font-size: 1.05rem;
    color: #475569;
    line-height: 1.6;
  }

  /* Filter Tabs */
  .catalogue-tabs {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 12px;
    margin-bottom: 18px;
    scrollbar-width: thin;
  }

  .cat-tab {
    padding: 8px 18px;
    border-radius: 24px;
    border: 1px solid rgba(16, 42, 67, 0.12);
    background: #ffffff;
    color: #334155;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .cat-tab:hover {
    border-color: #00b8a9;
    color: #00b8a9;
  }

  .cat-tab.active {
    background: #102a43;
    color: #ffffff;
    border-color: #102a43;
    box-shadow: 0 4px 12px rgba(16, 42, 67, 0.2);
  }

  /* Filters row */
  .catalogue-filters-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding: 14px 18px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    margin-bottom: 30px;
  }

  .filters-dropdowns {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .catalogue-select {
    padding: 8px 14px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    background: #f8fafc;
    color: #102a43;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s;
  }

  .catalogue-select:focus {
    border-color: #00b8a9;
  }

  .sort-select-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sort-label {
    font-size: 0.85rem;
    color: #64748b;
    font-weight: 600;
  }

  /* Products Grid */
  .catalogue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 26px;
  }

  /* 3D Product Card */
  .demo-product-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 16px rgba(16, 42, 67, 0.04);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
    cursor: pointer;
    position: relative;
  }

  .demo-product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 32px rgba(16, 42, 67, 0.12), 0 0 16px rgba(0, 184, 169, 0.15);
    border-color: rgba(0, 184, 169, 0.4);
  }

  .card-image-box {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    background: #f1f5f9;
    overflow: hidden;
  }

  .card-image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .demo-product-card:hover .card-image-box img {
    transform: scale(1.04);
  }

  .card-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(16, 42, 67, 0.85);
    color: #ffffff;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    backdrop-filter: blur(6px);
    z-index: 2;
  }

  [dir="rtl"] .card-badge {
    left: auto;
    right: 12px;
  }

  .card-fabric-pill {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    background: rgba(255, 255, 255, 0.92);
    color: #102a43;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    backdrop-filter: blur(4px);
    z-index: 2;
  }

  .card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-sku {
    font-size: 0.72rem;
    color: #94a3b8;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .card-title {
    font-size: 0.98rem;
    font-weight: 700;
    color: #102a43;
    line-height: 1.4;
    margin-bottom: 8px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-colors {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 12px;
  }

  .color-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.15);
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid #f1f5f9;
  }

  .card-price-group {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .card-price {
    font-size: 1.1rem;
    font-weight: 800;
    color: #102a43;
  }

  .card-compare {
    font-size: 0.85rem;
    color: #94a3b8;
    text-decoration: line-through;
  }

  .card-btn {
    background: #00b8a9;
    color: #ffffff;
    border: none;
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
  }

  .card-btn:hover {
    background: #00988c;
  }

  /* PDP Modal */
  .pdp-modal-backdrop,
  .size-modal-backdrop,
  .checkout-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(16, 42, 67, 0.65);
    backdrop-filter: blur(6px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    overflow-y: auto;
  }

  .pdp-modal-container {
    background: #ffffff;
    border-radius: 20px;
    width: 100%;
    max-width: 960px;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 25px 50px -12px rgba(16, 42, 67, 0.25);
  }

  .pdp-close-btn,
  .size-close-btn,
  .checkout-close-btn {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    font-size: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.2s;
  }

  [dir="rtl"] .pdp-close-btn,
  [dir="rtl"] .size-close-btn,
  [dir="rtl"] .checkout-close-btn {
    right: auto;
    left: 16px;
  }

  .pdp-close-btn:hover {
    background: #f1f5f9;
  }

  /* PDP Content Layout */
  .pdp-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    padding: 32px;
  }

  @media (max-width: 768px) {
    .pdp-layout {
      grid-template-columns: 1fr;
      padding: 20px;
      gap: 20px;
    }
  }

  .pdp-gallery-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pdp-main-image {
    width: 100%;
    aspect-ratio: 3 / 4;
    background: #f8fafc;
    border-radius: 14px;
    overflow: hidden;
    position: relative;
  }

  .pdp-main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pdp-thumbnails {
    display: flex;
    gap: 8px;
  }

  .pdp-thumb {
    width: 60px;
    height: 70px;
    border-radius: 8px;
    border: 2px solid transparent;
    cursor: pointer;
    overflow: hidden;
    opacity: 0.7;
    transition: all 0.2s;
  }

  .pdp-thumb.active {
    border-color: #00b8a9;
    opacity: 1;
  }

  .pdp-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pdp-details-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .pdp-badge {
    align-self: flex-start;
    background: rgba(0, 184, 169, 0.1);
    color: #00b8a9;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .pdp-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: #102a43;
    line-height: 1.3;
  }

  .pdp-pricing {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .pdp-price {
    font-size: 1.5rem;
    font-weight: 800;
    color: #102a43;
  }

  .pdp-compare {
    font-size: 1rem;
    color: #94a3b8;
    text-decoration: line-through;
  }

  .pdp-description {
    font-size: 0.92rem;
    color: #475569;
    line-height: 1.6;
  }

  /* Color selection */
  .pdp-option-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pdp-option-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pdp-option-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: #102a43;
  }

  .pdp-swatches {
    display: flex;
    gap: 8px;
  }

  .pdp-swatch-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 600;
    color: #334155;
    transition: all 0.2s;
  }

  .pdp-swatch-btn.active {
    border-color: #00b8a9;
    background: #e6fffa;
    color: #00b8a9;
  }

  /* Size selection */
  .pdp-size-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pdp-size-btn {
    min-width: 44px;
    height: 40px;
    padding: 0 12px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #102a43;
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .pdp-size-btn.active {
    border-color: #102a43;
    background: #102a43;
    color: #ffffff;
  }

  .pdp-size-guide-btn {
    background: none;
    border: none;
    color: #00b8a9;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
  }

  /* Customization box */
  .pdp-customization-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
