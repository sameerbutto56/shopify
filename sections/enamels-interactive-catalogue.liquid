    cursor: pointer;
  }
</style>

<!-- JAVASCRIPT LOGIC -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    initCatalogue();
  });

  // Re-init if dynamically injected
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setTimeout(initCatalogue, 100);
  }

  function initCatalogue() {
    const grid = document.getElementById('catalogue-products-grid');
    if (!grid || grid.dataset.initialized === 'true') return;
    grid.dataset.initialized = 'true';

    let activeCategory = 'all';
    let activeGender = 'all';
    let activeSeries = 'all';
    let activeColor = 'all';
    let activePrice = 'all';
    let activeSort = 'featured';

    const catalogueData = window.EnamelsCatalogue || [];

    // Filter Listeners
    document.querySelectorAll('.cat-tab').forEach(tab => {
      tab.addEventListener('click', function() {
        document.querySelectorAll('.cat-tab').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        activeCategory = this.dataset.category;
        renderFilteredCatalogue();
      });
    });

    const filterGender = document.getElementById('filter-gender');
    if (filterGender) filterGender.addEventListener('change', e => { activeGender = e.target.value; renderFilteredCatalogue(); });

    const filterSeries = document.getElementById('filter-series');
    if (filterSeries) filterSeries.addEventListener('change', e => { activeSeries = e.target.value; renderFilteredCatalogue(); });

    const filterColor = document.getElementById('filter-color');
    if (filterColor) filterColor.addEventListener('change', e => { activeColor = e.target.value; renderFilteredCatalogue(); });

    const filterPrice = document.getElementById('filter-price');
    if (filterPrice) filterPrice.addEventListener('change', e => { activePrice = e.target.value; renderFilteredCatalogue(); });

    const sortBy = document.getElementById('sort-by');
    if (sortBy) sortBy.addEventListener('change', e => { activeSort = e.target.value; renderFilteredCatalogue(); });

    const resetBtn = document.getElementById('btn-reset-filters');
    if (resetBtn) resetBtn.addEventListener('click', () => {
      document.querySelectorAll('.cat-tab').forEach(t => t.classList.toggle('active', t.dataset.category === 'all'));
      activeCategory = 'all';
      if (filterGender) filterGender.value = 'all'; activeGender = 'all';
      if (filterSeries) filterSeries.value = 'all'; activeSeries = 'all';
      if (filterColor) filterColor.value = 'all'; activeColor = 'all';
      if (filterPrice) filterPrice.value = 'all'; activePrice = 'all';
      if (sortBy) sortBy.value = 'featured'; activeSort = 'featured';
      renderFilteredCatalogue();
    });

    function renderFilteredCatalogue() {
      let filtered = catalogueData.filter(item => {
        if (activeCategory !== 'all' && item.category !== activeCategory) return false;
        if (activeGender !== 'all' && item.gender !== activeGender && item.gender !== 'unisex') return false;
        if (activeSeries !== 'all' && item.series !== activeSeries) return false;
        if (activeColor !== 'all') {
          const hasColor = item.colors.some(c => c.name.toLowerCase().includes(activeColor));
          if (!hasColor) return false;
        }
        if (activePrice === 'under-3000' && item.basePrice >= 3000) return false;
        if (activePrice === '3000-6000' && (item.basePrice < 3000 || item.basePrice > 6000)) return false;
        if (activePrice === 'above-6000' && item.basePrice <= 6000) return false;
        return true;
      });

      // Sorting
      if (activeSort === 'price-low') {
        filtered.sort((a, b) => a.basePrice - b.basePrice);
      } else if (activeSort === 'price-high') {
        filtered.sort((a, b) => b.basePrice - a.basePrice);
      } else if (activeSort === 'name') {
        filtered.sort((a, b) => a.title.localeCompare(b.title));
      }

      // Update counter badge
      const countBadge = document.getElementById('catalogue-count-badge');
      if (countBadge) countBadge.textContent = `${filtered.length} Products Available`;

      const emptyBox = document.getElementById('catalogue-empty');

      if (filtered.length === 0) {
        grid.innerHTML = '';
        if (emptyBox) emptyBox.style.display = 'block';
        return;
      }

      if (emptyBox) emptyBox.style.display = 'none';

      // Render cards
      grid.innerHTML = filtered.map(item => `
        <div class="demo-product-card enamels-3d-card" data-id="${item.id}" onclick="window.openEnamelsPdpModal('${item.id}')">
          <div class="card-image-box">
            ${item.badge ? `<span class="card-badge">${item.badge}</span>` : ''}
            <img src="${getAssetUrl(item.image)}" alt="${item.title}" loading="lazy" />
            <span class="card-fabric-pill">${item.fabric}</span>
          </div>
          <div class="card-body">
            <span class="card-sku">${item.sku}</span>
            <h4 class="card-title">${item.title}</h4>
            <div class="card-colors">
              ${item.colors.map(c => `
                <span class="color-dot" style="background-color: ${c.hex};" title="${c.name}"></span>
              `).join('')}
            </div>
            <div class="card-footer">
              <div class="card-price-group">
                <span class="card-price">Rs. ${item.basePrice.toLocaleString()}</span>
                ${item.comparePrice ? `<span class="card-compare">Rs. ${item.comparePrice.toLocaleString()}</span>` : ''}
              </div>
              <button type="button" class="card-btn">Customize & Fit</button>
            </div>
          </div>
        </div>
      `).join('');
    }

    // Initial render
    renderFilteredCatalogue();
  }

  function getAssetUrl(filename) {
    if (filename.startsWith('http')) return filename;
    return `{{ '' | asset_url }}` + filename;
  }

  // ==========================================
  // PDP MODAL INTERACTIVE CONFIGURATOR
  // ==========================================
  window.openEnamelsPdpModal = function(productId) {
    const product = (window.EnamelsCatalogue || []).find(p => p.id === productId);
    if (!product) return;

    const modal = document.getElementById('pdp-modal');
    const body = document.getElementById('pdp-modal-body');
    if (!modal || !body) return;

    let selectedColor = product.colors[0];
    let selectedSize = product.sizes[0];
    let selectedCustomization = 'none'; // 'none', 'embroidery', 'patch', 'logo'
    let embroideryLine1 = 'Dr. Sarah Khan';
    let embroideryLine2 = 'Cardiology';
    let threadColor = '#ffffff';
    let includeCompanion = false;

    function renderPdp() {
      let customFee = 0;
      if (selectedCustomization === 'embroidery') customFee = 450;
      if (selectedCustomization === 'patch') customFee = 350;
      if (selectedCustomization === 'logo') customFee = 650;

      let companionFee = 0;
      let companionItem = null;
      if (product.companionIds && product.companionIds.length > 0) {
        companionItem = (window.EnamelsCatalogue || []).find(p => p.id === product.companionIds[0]);
      }
      if (includeCompanion && companionItem) {
        companionFee = companionItem.basePrice;
      }

      const totalPrice = product.basePrice + customFee + companionFee;

      body.innerHTML = `
        <div class="pdp-layout">
          <!-- Gallery Column -->
          <div class="pdp-gallery-col">
            <div class="pdp-main-image">
              <img id="pdp-active-img" src="${getAssetUrl(selectedColor.image || product.image)}" alt="${product.title}" />
            </div>
            <div class="pdp-thumbnails">
              <div class="pdp-thumb active" onclick="window.switchPdpImage('${getAssetUrl(product.image)}')">
                <img src="${getAssetUrl(product.image)}" alt="Front View" />
              </div>
              ${product.colors.map(c => `
                <div class="pdp-thumb" onclick="window.switchPdpImage('${getAssetUrl(c.image || product.image)}')">
                  <img src="${getAssetUrl(c.image || product.image)}" alt="${c.name}" />
                </div>
              `).join('')}
            </div>
          </div>

          <!-- Product Details Column -->
          <div class="pdp-details-col">
            ${product.badge ? `<span class="pdp-badge">${product.badge}</span>` : ''}
            <h3 class="pdp-title">${product.title}</h3>
            
            <div class="pdp-pricing">
              <span class="pdp-price">Rs. ${totalPrice.toLocaleString()}</span>
              ${product.comparePrice ? `<span class="pdp-compare">Rs. ${product.comparePrice.toLocaleString()}</span>` : ''}
            </div>

            <p class="pdp-description">${product.description}</p>

            <!-- Color Options -->
            <div class="pdp-option-group">
              <div class="pdp-option-header">
                <span class="pdp-option-label">Color: <strong>${selectedColor.name}</strong></span>
              </div>
              <div class="pdp-swatches">
                ${product.colors.map(c => `
                  <button type="button" class="pdp-swatch-btn ${c.name === selectedColor.name ? 'active' : ''}" onclick="window.selectPdpColor('${c.name}')">
                    <span class="color-dot" style="background-color: ${c.hex};"></span>
                    <span>${c.name}</span>
                  </button>
                `).join('')}
              </div>
            </div>

            <!-- Size Options -->
            <div class="pdp-option-group">
              <div class="pdp-option-header">
                <span class="pdp-option-label">Size: <strong>${selectedSize}</strong></span>
                <button type="button" class="pdp-size-guide-btn" onclick="document.getElementById('size-chart-modal').style.display='flex'">📏 View Size Guide</button>
              </div>
              <div class="pdp-size-pills">
                ${product.sizes.map(s => `
                  <button type="button" class="pdp-size-btn ${s === selectedSize ? 'active' : ''}" onclick="window.selectPdpSize('${s}')">${s}</button>
                `).join('')}
              </div>
            </div>

            <!-- Personalization Options -->
            ${product.supportsCustomization ? `
              <div class="pdp-customization-box">
                <span class="pdp-customization-title">🪡 Chest Embroidery & Customization</span>
                
                <div class="custom-radio-group">
                  <label class="custom-radio-label">
                    <input type="radio" name="pdp-custom" value="none" ${selectedCustomization === 'none' ? 'checked' : ''} onchange="window.selectPdpCustom('none')">
                    <span>Plain Uniform (No Personalization)</span>
                  </label>
                  <label class="custom-radio-label">
                    <input type="radio" name="pdp-custom" value="embroidery" ${selectedCustomization === 'embroidery' ? 'checked' : ''} onchange="window.selectPdpCustom('embroidery')">
                    <span>Direct Name Embroidery (+Rs. 450)</span>
                  </label>
                  <label class="custom-radio-label">
                    <input type="radio" name="pdp-custom" value="patch" ${selectedCustomization === 'patch' ? 'checked' : ''} onchange="window.selectPdpCustom('patch')">
                    <span>Removable Velcro Name Patch (+Rs. 350)</span>
                  </label>
                  <label class="custom-radio-label">
                    <input type="radio" name="pdp-custom" value="logo" ${selectedCustomization === 'logo' ? 'checked' : ''} onchange="window.selectPdpCustom('logo')">
                    <span>Hospital / Institutional Logo Patch (+Rs. 650)</span>
                  </label>
                </div>

                ${selectedCustomization === 'embroidery' ? `
                  <div class="embroidery-inputs" style="display:flex; flex-direction:column; gap:8px; margin-top:8px;">
                    <input type="text" id="emb-name-input" class="catalogue-select" placeholder="Doctor Name / Title (e.g. Dr. Sarah Khan)" value="${embroideryLine1}" oninput="window.updateEmbroideryPreview(this.value, null)">
                    <input type="text" id="emb-dept-input" class="catalogue-select" placeholder="Hospital / Department (e.g. Cardiology)" value="${embroideryLine2}" oninput="window.updateEmbroideryPreview(null, this.value)">
                    
                    <div class="pocket-embroidery-canvas" style="background-color: ${selectedColor.hex};">
                      <div class="pocket-embroidery-line1" style="color: ${threadColor};" id="pocket-preview-1">${embroideryLine1}</div>
                      <div class="pocket-embroidery-line2" style="color: ${threadColor};" id="pocket-preview-2">${embroideryLine2}</div>
                    </div>
                  </div>
                ` : ''}

                ${selectedCustomization === 'logo' ? `
                  <div class="logo-upload-box" onclick="alert('Demo File Selector: In production, customers can upload PNG/JPG/PDF logo artwork. Demo crest preview active.')">
                    <span>📁 Click to Upload Hospital Logo (Demo Artwork Active)</span>
                  </div>
                ` : ''}
              </div>
            ` : ''}

            <!-- Companion Cross-Sell -->
            ${companionItem ? `
              <div class="pdp-companion-box">
                <div class="companion-info">
                  <h5>Add Matching Companion: ${companionItem.title}</h5>
                  <p>Recommended pairing for complete clinical styling (+Rs. ${companionItem.basePrice.toLocaleString()})</p>
                </div>
                <label style="display:flex; align-items:center; gap:6px; font-weight:700; cursor:pointer;">
                  <input type="checkbox" ${includeCompanion ? 'checked' : ''} onchange="window.toggleCompanion(this.checked)">
                  <span>Add</span>
                </label>
              </div>
            ` : ''}

            <!-- Add to Cart Action -->
            <button type="button" class="pdp-action-btn" onclick="window.addPdpToCart('${product.id}')">
              Add Tailored Uniform to Cart • Rs. ${totalPrice.toLocaleString()}
            </button>
          </div>
        </div>
      `;
    }

    window.switchPdpImage = function(src) {
      const activeImg = document.getElementById('pdp-active-img');
      if (activeImg) activeImg.src = src;
    };

    window.selectPdpColor = function(colorName) {
      const found = product.colors.find(c => c.name === colorName);
      if (found) {
        selectedColor = found;
        renderPdp();
      }
    };

    window.selectPdpSize = function(size) {
      selectedSize = size;
      renderPdp();
    };

    window.selectPdpCustom = function(type) {
      selectedCustomization = type;
      renderPdp();
    };

    window.updateEmbroideryPreview = function(line1, line2) {
      if (line1 !== null) embroideryLine1 = line1;
      if (line2 !== null) embroideryLine2 = line2;
      const p1 = document.getElementById('pocket-preview-1');
      const p2 = document.getElementById('pocket-preview-2');
      if (p1) p1.textContent = embroideryLine1;
      if (p2) p2.textContent = embroideryLine2;
    };

    window.toggleCompanion = function(checked) {
      includeCompanion = checked;
      renderPdp();
    };

    window.addPdpToCart = function() {
      // Add to demo cart
      const cartItem = {
        id: product.id,
        sku: product.sku,
        title: product.title,
        color: selectedColor.name,
        size: selectedSize,
        customization: selectedCustomization,
        embroideryLine1: selectedCustomization === 'embroidery' ? embroideryLine1 : '',
        embroideryLine2: selectedCustomization === 'embroidery' ? embroideryLine2 : '',
        price: product.basePrice + (selectedCustomization === 'embroidery' ? 450 : selectedCustomization === 'patch' ? 350 : selectedCustomization === 'logo' ? 650 : 0),
        image: selectedColor.image || product.image,
        quantity: 1
      };

      const demoCart = JSON.parse(localStorage.getItem('enamels_demo_cart') || '[]');
      demoCart.push(cartItem);

      if (includeCompanion && product.companionIds && product.companionIds.length > 0) {
        const comp = (window.EnamelsCatalogue || []).find(p => p.id === product.companionIds[0]);
        if (comp) {
          demoCart.push({
            id: comp.id,
            sku: comp.sku,
            title: comp.title,
            color: 'Standard',
            size: 'Standard',
            customization: 'none',
            price: comp.basePrice,
            image: comp.image,
            quantity: 1
          });
        }
      }

      localStorage.setItem('enamels_demo_cart', JSON.stringify(demoCart));
      modal.style.display = 'none';

      // Open checkout simulator or update cart counter
      window.openDemoCheckoutModal();
    };

    renderPdp();
    modal.style.display = 'flex';
  };

  // Close modals
  document.addEventListener('click', function(e) {
    if (e.target.id === 'pdp-close-trigger' || e.target.id === 'pdp-modal') {
      const modal = document.getElementById('pdp-modal');
      if (modal) modal.style.display = 'none';
    }
    if (e.target.id === 'size-modal-close' || e.target.id === 'size-chart-modal') {
      const sizeModal = document.getElementById('size-chart-modal');
      if (sizeModal) sizeModal.style.display = 'none';
    }
    if (e.target.id === 'checkout-modal-close' || e.target.id === 'demo-checkout-modal') {
      const chkModal = document.getElementById('demo-checkout-modal');
      if (chkModal) chkModal.style.display = 'none';
    }
  });

  // Size unit switcher
  document.querySelectorAll('.unit-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.unit-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      const unit = this.dataset.unit;
      const tIn = document.getElementById('size-table-in');
      const tCm = document.getElementById('size-table-cm');
      if (unit === 'in') {
        if (tIn) tIn.style.display = 'block';
        if (tCm) tCm.style.display = 'none';
      } else {
        if (tIn) tIn.style.display = 'none';
        if (tCm) tCm.style.display = 'block';
      }
    });
  });

  // ==========================================
  // DEMO CHECKOUT SIMULATOR MODAL
  // ==========================================
  window.openDemoCheckoutModal = function() {
    const chkModal = document.getElementById('demo-checkout-modal');
    const content = document.getElementById('checkout-modal-content');
    if (!chkModal || !content) return;

    const cart = JSON.parse(localStorage.getItem('enamels_demo_cart') || '[]');
    if (cart.length === 0) {
      alert('Your demo cart is empty! Please select a scrub or accessory first.');
      return;
    }

    const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    const shipping = subtotal >= 7000 ? 0 : 250;
    const total = subtotal + shipping;

    content.innerHTML = `
      <div class="checkout-summary-box">
        <h4 style="margin: 0 0 10px; color: #102a43;">Order Summary (${cart.length} Items)</h4>
        ${cart.map((item, idx) => `
          <div class="checkout-row">
            <span><strong>${item.title}</strong> (${item.size}, ${item.color}) ${item.embroideryLine1 ? `— <em>"${item.embroideryLine1}"</em>` : ''}</span>
            <span>Rs. ${(item.price * item.quantity).toLocaleString()}</span>
          </div>
        `).join('')}
        
        <div class="checkout-row" style="margin-top: 10px;">
          <span>Subtotal</span>
          <span>Rs. ${subtotal.toLocaleString()}</span>
        </div>
        <div class="checkout-row">
          <span>Nationwide Shipping (${subtotal >= 7000 ? 'Free Delivery Threshold' : 'Standard Delivery'})</span>
          <span>${shipping === 0 ? '<strong style="color:#00b8a9;">FREE</strong>' : `Rs. ${shipping}`}</span>
        </div>
        <div class="checkout-row total">
          <span>Total PKR</span>
          <span>Rs. ${total.toLocaleString()}</span>
        </div>
      </div>

      <h4 style="margin: 0 0 10px; color: #102a43;">Clinical Delivery Details</h4>
      <div class="checkout-form-grid">
        <input type="text" class="checkout-input" id="chk-name" placeholder="Doctor Full Name" value="Dr. Sarah Khan">
        <input type="text" class="checkout-input" id="chk-phone" placeholder="Mobile Number (e.g. 0300-1234567)" value="0300-1234567">
        <input type="text" class="checkout-input checkout-form-full" id="chk-hospital" placeholder="Hospital / Clinical Institute" value="Aga Khan University Hospital (AKUH)">
        <input type="text" class="checkout-input checkout-form-full" id="chk-address" placeholder="Delivery Street Address & Ward" value="Stadium Road, Department of Cardiology">
        <select class="checkout-input checkout-form-full" id="chk-city">
          <option value="Karachi">Karachi</option>
          <option value="Lahore">Lahore</option>
          <option value="Islamabad">Islamabad / Rawalpindi</option>
          <option value="Peshawar">Peshawar</option>
          <option value="Faisalabad">Faisalabad</option>
          <option value="Multan">Multan</option>
          <option value="Quetta">Quetta</option>
        </select>
      </div>

      <div style="background: #f1f5f9; padding: 12px; border-radius: 8px; margin-bottom: 16px; font-size: 0.85rem; color: #334155;">
        <span><strong>Payment Method:</strong> 💵 Cash on Delivery (COD) — Inspect your uniform upon arrival at your hospital/clinic door before paying.</span>
      </div>

      <button type="button" class="checkout-confirm-btn" onclick="window.completeDemoOrder()">
        Confirm Demo Order (Rs. ${total.toLocaleString()})
      </button>
    `;

    chkModal.style.display = 'flex';
  };

  window.completeDemoOrder = function() {
    const content = document.getElementById('checkout-modal-content');
    if (!content) return;

    const orderNumber = 'ENM-DEMO-' + Math.floor(10000 + Math.random() * 90000);
    const cart = JSON.parse(localStorage.getItem('enamels_demo_cart') || '[]');
    const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);

    content.innerHTML = `
      <div style="text-align: center; padding: 20px 0;">
        <div style="width: 60px; height: 60px; background: #e6fffa; color: #00b8a9; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; margin: 0 auto 16px;">
          ✓
        </div>
        <h3 style="color: #102a43; margin-bottom: 6px;">Test Order Confirmed!</h3>
        <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 16px;">Your simulated medical order has been processed in our isolated QA environment.</p>
        
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; text-align: left; margin-bottom: 20px;">
          <div style="display:flex; justify-content:space-between; margin-bottom: 8px;">
            <span style="color:#64748b; font-size:0.85rem;">Order Number:</span>
            <strong style="color:#102a43;">#${orderNumber}</strong>
          </div>
          <div style="display:flex; justify-content:space-between; margin-bottom: 8px;">
            <span style="color:#64748b; font-size:0.85rem;">Status:</span>
            <span style="color:#00b8a9; font-weight:700;">Simulated COD Order Placed</span>
          </div>
          <div style="display:flex; justify-content:space-between; margin-bottom: 8px;">
            <span style="color:#64748b; font-size:0.85rem;">Items:</span>
            <span>${cart.length} Pieces</span>
          </div>
          <div style="display:flex; justify-content:space-between; border-top:1px solid #e2e8f0; padding-top:8px;">
            <span style="font-weight:700; color:#102a43;">Total Order Value:</span>
            <strong style="color:#102a43;">Rs. ${(subtotal >= 7000 ? subtotal : subtotal + 250).toLocaleString()}</strong>
          </div>
        </div>

        <p style="font-size: 0.8rem; color: #94a3b8; margin-bottom: 18px;">
          🔒 <strong>Safety Assurance:</strong> Zero real credit cards or customer payments were charged. Live store orders remain 100% untouched.
        </p>

        <button type="button" class="checkout-confirm-btn" style="background:#00b8a9;" onclick="localStorage.removeItem('enamels_demo_cart'); document.getElementById('demo-checkout-modal').style.display='none';">
          Continue Exploring Enamels Catalogue
        </button>
      </div>
    `;
  };
</script>

