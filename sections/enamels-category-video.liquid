{% comment %}
  Enamels Modular Category Thumbnails & Brand Video Section
  Provides category discovery tiles (Men, Women, Scrubs, Lab Coats, Caps, Accessories, Sleeves)
  with independently editable titles, images, descriptions, links, and visibility toggles,
  alongside customizable aspect ratio, text alignment, spacing, colors, and cinematic brand video.
{% endcomment %}

{%- liquid
  assign enable_section = section.settings.enable_section
  assign section_alignment = section.settings.section_alignment | default: 'center'
  assign section_max_width = section.settings.section_max_width | default: 1320
  assign columns_vertical_align = section.settings.columns_vertical_align | default: 'start'

  assign show_column_tag = section.settings.show_column_tag
  if show_column_tag == nil
    assign show_column_tag = true
  endif
  assign col_tag = section.settings.column_tag | strip

  assign show_column_title = section.settings.show_column_title
  if show_column_title == nil
    assign show_column_title = true
  endif
  assign col_title = section.settings.column_title | strip

  assign show_column_sub = section.settings.show_column_sub
  if show_column_sub == nil
    assign show_column_sub = true
  endif
  assign col_sub = section.settings.column_sub | strip

  assign header_alignment = section.settings.header_alignment | default: 'left'
  assign thumbnails_alignment = section.settings.thumbnails_alignment | default: 'center'
  
  assign aspect_ratio = section.settings.aspect_ratio | default: '1_1'
  assign text_align = section.settings.text_align | default: 'left'
  assign pad_top = section.settings.padding_top | default: 48
  assign pad_bottom = section.settings.padding_bottom | default: 48
  assign section_bg = section.settings.section_bg | default: '#ffffff'
  assign card_bg = section.settings.card_bg | default: '#ffffff'
  assign card_text_color = section.settings.card_text_color | default: '#102a43'
  assign meta_color = section.settings.meta_color | default: '#008779'

  assign shopify_video = section.settings.video
  assign video_url = section.settings.brand_video_url

  assign video_horizontal_align = section.settings.video_horizontal_align | default: 'center'
  assign video_offset_top_desktop = section.settings.video_offset_top_desktop | default: 20
  assign video_offset_top_mobile = section.settings.video_offset_top_mobile | default: 0
  assign video_offset_x_desktop = section.settings.video_offset_x_desktop | default: 0
  assign video_max_width = section.settings.video_max_width | default: 560
  assign video_aspect_ratio = section.settings.video_aspect_ratio | default: '16_9'
  assign video_height_desktop = section.settings.video_height_desktop | default: 420
  assign video_height_mobile = section.settings.video_height_mobile | default: 260
  assign video_object_fit = section.settings.video_object_fit | default: 'cover'
  assign video_object_pos_x = section.settings.video_object_pos_x | default: 'center'
  assign video_object_pos_y = section.settings.video_object_pos_y | default: 'center'

  assign show_pause_button = section.settings.show_pause_button
  if show_pause_button == nil
    assign show_pause_button = true
  endif

  assign show_video_overlay = section.settings.show_video_overlay
  if show_video_overlay == nil
    assign show_video_overlay = true
  endif

  assign show_video_badge = section.settings.show_video_badge
  if show_video_badge == nil
    assign show_video_badge = true
  endif
  assign video_badge = section.settings.video_badge | strip

  assign show_video_title = section.settings.show_video_title
  if show_video_title == nil
    assign show_video_title = true
  endif
  assign video_title = section.settings.video_title | strip

  assign show_video_desc = section.settings.show_video_desc
  if show_video_desc == nil
    assign show_video_desc = true
  endif
  assign video_desc = section.settings.video_desc | strip

  assign show_video_cta = section.settings.show_video_cta
  if show_video_cta == nil
    assign show_video_cta = true
  endif
  assign video_cta_link = section.settings.video_cta_link
  assign video_cta_label = section.settings.video_cta_label | default: 'Explore Collection →'

  assign video_autoplay = section.settings.video_autoplay
  if video_autoplay == nil
    assign video_autoplay = true
  endif

  assign video_loop = section.settings.video_loop
  if video_loop == nil
    assign video_loop = true
  endif

  assign video_muted = section.settings.video_muted
  if video_muted == nil
    assign video_muted = true
  endif

  assign video_controls = section.settings.video_controls
  if video_controls == nil
    assign video_controls = false
  endif

  if section.settings.brand_video_poster != blank
    assign brand_poster = section.settings.brand_video_poster | image_url: width: 900
  elsif shopify_video != blank and shopify_video.preview_image != blank
    assign brand_poster = shopify_video.preview_image | image_url: width: 900
  else
    assign brand_poster = ''
  endif
-%}

{% if enable_section %}
{%- style -%}
  #shopify-section-{{ section.id }} .split-cat-video-section {
    max-width: {{ section_max_width }}px;
    {% if section_alignment == 'left' %}
      margin-left: 0;
      margin-right: auto;
    {% elsif section_alignment == 'right' %}
      margin-left: auto;
      margin-right: 0;
    {% else %}
      margin-left: auto;
      margin-right: auto;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .split-cat-video-grid {
    align-items: {{ columns_vertical_align }};
  }

  #shopify-section-{{ section.id }} .split-thumbnails-column {
    justify-content: flex-start;
  }

  #shopify-section-{{ section.id }} .split-column-header {
    text-align: {{ header_alignment }};
    display: flex;
    flex-direction: column;
    align-items: {% if header_alignment == 'center' %}center{% elsif header_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
    margin-bottom: {{ section.settings.header_margin_bottom | default: 20 }}px;
  }

  #shopify-section-{{ section.id }} .split-thumbnails-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax({{ section.settings.thumb_width_desktop | default: 140 }}px, {{ section.settings.thumb_width_desktop | default: 140 }}px));
    justify-content: {% if thumbnails_alignment == 'left' %}flex-start{% elsif thumbnails_alignment == 'right' %}flex-end{% else %}center{% endif %};
    justify-items: center;
    gap: {{ section.settings.thumb_spacing | default: 12 }}px;
    align-content: start;
    align-items: start;
    flex: none;
    margin-top: {{ section.settings.thumbnail_margin_top | default: 0 }}px;
    margin-bottom: {{ section.settings.thumbnail_margin_bottom | default: 0 }}px;
  }

  #shopify-section-{{ section.id }} .split-category-tile {
    border-radius: {{ section.settings.card_border_radius | default: 12 }}px;
    padding: 0;
    overflow: hidden;
    height: fit-content;
    width: 100%;
    max-width: {{ section.settings.thumb_width_desktop | default: 140 }}px;
    align-self: start;
    background-color: {{ card_bg }};
  }
  #shopify-section-{{ section.id }} .split-category-tile.is-image-only {
    height: fit-content !important;
    align-self: start !important;
  }
  #shopify-section-{{ section.id }} .split-category-thumb {
    width: 100%;
    position: relative;
    overflow: hidden;
    background-color: {{ section.settings.thumbnail_media_bg | default: '#ffffff' }};
    border-radius: {% if aspect_ratio == 'round' %}50%{% else %}{{ section.settings.card_border_radius | default: 12 }}px {{ section.settings.card_border_radius | default: 12 }}px 0 0{% endif %};
    {% if aspect_ratio == 'custom' %}
      height: {{ section.settings.thumb_height_desktop | default: 160 }}px;
      aspect-ratio: auto;
    {% elsif aspect_ratio == '1_1' or aspect_ratio == 'round' %}
      aspect-ratio: 1 / 1;
      height: auto;
    {% elsif aspect_ratio == '4_5' %}
      aspect-ratio: 4 / 5;
      height: auto;
    {% elsif aspect_ratio == '16_9' %}
      aspect-ratio: 16 / 9;
      height: auto;
    {% elsif aspect_ratio == 'natural' %}
      aspect-ratio: auto;
      height: auto;
    {% else %}
      aspect-ratio: 1 / 1;
      height: auto;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .split-category-tile.is-image-only .split-category-thumb {
    border-radius: {% if aspect_ratio == 'round' %}50%{% else %}{{ section.settings.card_border_radius | default: 12 }}px{% endif %} !important;
    margin: 0 !important;
    width: 100% !important;
  }
  #shopify-section-{{ section.id }} .split-category-tile.is-image-only .split-category-info,
  #shopify-section-{{ section.id }} .split-category-info:empty {
    display: none !important;
    padding: 0 !important;
    margin: 0 !important;
    height: 0 !important;
    min-height: 0 !important;
  }

  {% if section.settings.image_fit_mode == 'contain' %}
    #shopify-section-{{ section.id }} .split-category-img {
      object-fit: contain !important;
      object-position: {{ section.settings.image_pos_x | default: 'center' }} {{ section.settings.image_pos_y | default: 'center' }} !important;
      transform: none !important;
      width: 100%;
      height: 100%;
      display: block;
      transition: none !important;
    }
    #shopify-section-{{ section.id }} .split-category-tile:hover .split-category-img {
      transform: none !important;
    }
  {% else %}
    #shopify-section-{{ section.id }} .split-category-img {
      object-fit: cover !important;
      object-position: {{ section.settings.image_pos_x | default: 'center' }} {{ section.settings.image_pos_y | default: 'center' }} !important;
      {% if section.settings.image_zoom and section.settings.image_zoom != 100 %}
        transform: scale({{ section.settings.image_zoom | divided_by: 100.0 }});
        transform-origin: {{ section.settings.image_pos_x | default: 'center' }} {{ section.settings.image_pos_y | default: 'center' }};
      {% else %}
        transform: none;
      {% endif %}
      width: 100%;
      height: 100%;
      display: block;
      transition: transform 0.35s ease;
    }
    #shopify-section-{{ section.id }} .split-category-tile:hover .split-category-img {
      transform: scale({{ section.settings.image_zoom | default: 100 | times: 1.05 | divided_by: 100.0 }});
    }
  {% endif %}

  {% if aspect_ratio == 'natural' %}
    #shopify-section-{{ section.id }} .split-category-thumb {
      height: auto !important;
      aspect-ratio: auto !important;
    }
    #shopify-section-{{ section.id }} .split-category-img {
      width: 100% !important;
      height: auto !important;
      max-height: {{ section.settings.thumb_height_desktop | default: 360 }}px;
      object-fit: contain !important;
      display: block;
    }
  {% endif %}

  #shopify-section-{{ section.id }} .split-category-info {
    padding: {{ section.settings.caption_spacing | default: 10 }}px;
  }

  /* Video Showcase Column Positioning */
  #shopify-section-{{ section.id }} .split-video-column {
    display: flex;
    flex-direction: column;
    align-items: {% if video_horizontal_align == 'left' %}flex-start{% elsif video_horizontal_align == 'right' %}flex-end{% else %}center{% endif %};
    margin-top: {{ video_offset_top_desktop }}px;
    {% if video_offset_x_desktop != 0 %}
      transform: translateX({{ video_offset_x_desktop }}px);
    {% endif %}
  }

  #shopify-section-{{ section.id }} .brand-video-card-container {
    max-width: {{ video_max_width }}px;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .brand-video-wrapper {
    {% if video_aspect_ratio == 'custom' %}
      height: {{ video_height_desktop }}px;
      min-height: {{ video_height_desktop }}px;
      aspect-ratio: auto;
    {% elsif video_aspect_ratio == '4_3' %}
      aspect-ratio: 4 / 3;
      min-height: 0;
      height: auto;
    {% elsif video_aspect_ratio == '1_1' %}
      aspect-ratio: 1 / 1;
      min-height: 0;
      height: auto;
    {% elsif video_aspect_ratio == '4_5' %}
      aspect-ratio: 4 / 5;
      min-height: 0;
      height: auto;
    {% else %}
      aspect-ratio: 16 / 9;
      min-height: 0;
      height: auto;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .brand-promo-video-element {
    object-fit: {{ video_object_fit }};
    object-position: {{ video_object_pos_x }} {{ video_object_pos_y }};
  }

  #shopify-section-{{ section.id }} .brand-video-toggle-btn {
    {% unless show_pause_button %}
      display: none !important;
    {% endunless %}
  }

  #shopify-section-{{ section.id }} .brand-video-overlay-banner {
    {% unless show_video_overlay %}
      display: none !important;
    {% endunless %}
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .split-thumbnails-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: {{ section.settings.thumb_spacing_mobile | default: 10 }}px;
      justify-content: stretch;
      width: 100%;
    }
    #shopify-section-{{ section.id }} .split-category-tile {
      max-width: 100% !important;
      width: 100% !important;
    }
    #shopify-section-{{ section.id }} .split-video-column {
      margin-top: {{ video_offset_top_mobile }}px;
      transform: none;
      align-items: center;
      width: 100%;
    }
    #shopify-section-{{ section.id }} .brand-video-card-container {
      max-width: 100% !important;
    }
    {% if aspect_ratio == 'custom' %}
      #shopify-section-{{ section.id }} .split-category-thumb {
        height: auto;
        aspect-ratio: 1 / 1;
      }
    {% endif %}
    {% if video_aspect_ratio == 'custom' %}
      #shopify-section-{{ section.id }} .brand-video-wrapper {
        height: {{ video_height_mobile }}px;
        min-height: {{ video_height_mobile }}px;
      }
    {% endif %}
  }
  @media (max-width: 480px) {
    #shopify-section-{{ section.id }} .split-category-info {
      padding: 8px 10px !important;
    }
    #shopify-section-{{ section.id }} .split-category-name {
      font-size: 13px !important;
      line-height: 1.25 !important;
    }
    #shopify-section-{{ section.id }} .split-category-meta {
      font-size: 11px !important;
    }
  }
{%- endstyle -%}
<section
  class="split-cat-video-section page-container enamels-homepage-modular-section"
  id="homepage-category-video-split"
  aria-label="Category Selection and Brand Showcase"
  style="background-color: {{ section_bg }}; padding-top: {{ pad_top }}px; padding-bottom: {{ pad_bottom }}px;"
>
  <div class="split-cat-video-grid">
    <!-- Left: Small Category Thumbnails -->
    <div class="split-thumbnails-column">
      {% if col_tag != blank or col_title != blank or col_sub != blank %}
        <div class="split-column-header">
          {% if show_column_tag and col_tag != blank %}<span class="categories-section-tag">{{ col_tag | escape }}</span>{% endif %}
          {% if show_column_title and col_title != blank %}<h2 class="split-column-title" style="color: {{ card_text_color }};">{{ col_title | escape }}</h2>{% endif %}
          {% if show_column_sub and col_sub != blank %}<p class="split-column-sub">{{ col_sub | escape }}</p>{% endif %}
        </div>
      {% endif %}

      <div class="split-thumbnails-grid">
        {% for block in section.blocks %}
            {% if block.type == 'category' %}
              {%- liquid
                assign is_visible = true
                if block.settings.visible == false
                  assign is_visible = false
                endif
              -%}

              {% if is_visible %}
                {%- liquid
                  assign cat_name = block.settings.title | strip
                  assign cat_meta = block.settings.description | default: block.settings.meta | strip
                  assign cat_link = block.settings.link
                  assign cat_name_lower = cat_name | downcase
                  assign badge_txt = block.settings.badge_text | strip
                  assign badge_col = block.settings.badge_color | default: '#008779'

                  assign has_info = false
                  if cat_name != blank or cat_meta != blank
                    assign has_info = true
                  endif

                  # Category Image (Merchant Image > Asset Fallback > Icon Placeholder)
                  assign tile_img_src = ''
                  if block.settings.image != blank
                    assign tile_img_src = block.settings.image | image_url: width: 400
                  elsif cat_name_lower == 'men'
                    assign tile_img_src = 'cat-men-scrubs.jpg' | asset_url
                  elsif cat_name_lower == 'women'
                    assign tile_img_src = 'cat-women-scrubs.jpg' | asset_url
                  elsif cat_name_lower contains 'sale'
                    assign tile_img_src = 'cat-sale.jpg' | asset_url
                  elsif cat_name_lower contains 'bulk'
                    assign tile_img_src = 'cat-bulk-orders.jpg' | asset_url
                  elsif cat_name_lower contains 'home service' or cat_name_lower contains 'fitting'
                    assign tile_img_src = 'cat-home-service.jpg' | asset_url
                  elsif cat_name_lower contains 'make your own' or cat_name_lower contains 'custom'
                    assign tile_img_src = 'cat-customizer.jpg' | asset_url
                  elsif cat_name_lower contains 'scrub'
                    assign tile_img_src = 'cat-sprinter.jpg' | asset_url
                  elsif cat_name_lower contains 'lab'
                    assign tile_img_src = 'cat-labcoat.jpg' | asset_url
                  elsif cat_name_lower contains 'cap'
                    assign tile_img_src = 'cat-caps.jpg' | asset_url
                  elsif cat_name_lower contains 'access' or cat_name_lower contains 'sleeve'
                    assign tile_img_src = 'cat-flexfit.jpg' | asset_url
                  endif

                  # Smart Navigation & In-Page View Router
                  assign cat_onclick = ""
                  if cat_link contains '#men'
                    assign cat_onclick = "if (typeof window.navigateToGender === 'function') { window.navigateToGender('men'); return false; }"
                  elsif cat_name_lower == 'men' and cat_link == blank
                    assign cat_onclick = "if (typeof window.navigateToGender === 'function') { window.navigateToGender('men'); return false; }"
                  elsif cat_link contains '#women'
                    assign cat_onclick = "if (typeof window.navigateToGender === 'function') { window.navigateToGender('women'); return false; }"
                  elsif cat_name_lower == 'women' and cat_link == blank
                    assign cat_onclick = "if (typeof window.navigateToGender === 'function') { window.navigateToGender('women'); return false; }"
                  elsif cat_link contains 'home-service' or cat_link contains 'self-service' or cat_name_lower contains 'home service' or cat_name_lower contains 'home fitting'
                    assign cat_onclick = "if (typeof window.navigateToView === 'function' && document.getElementById('view-self-service')) { window.navigateToView('self-service'); return false; }"
                  elsif cat_link contains 'customizer' or cat_link contains 'ready-to-wear' or cat_name_lower contains 'make your own' or cat_name_lower contains 'custom'
                    assign cat_onclick = "if (typeof window.navigateToView === 'function' && document.getElementById('view-ready-to-wear')) { window.navigateToView('ready-to-wear'); return false; }"
                  elsif cat_link contains '#sale'
                    assign cat_onclick = "if (typeof window.filterCollectionByTag === 'function') { window.filterCollectionByTag('sale-active'); return false; }"
                  elsif cat_link contains 'scrub' and cat_link contains '#'
                    assign cat_onclick = "if (typeof window.selectProductCategory === 'function') { window.selectProductCategory('scrubs'); return false; }"
                  elsif cat_link contains 'lab' and cat_link contains '#'
                    assign cat_onclick = "if (typeof window.selectProductCategory === 'function') { window.selectProductCategory('lab-coat'); return false; }"
                  elsif cat_name_lower contains 'lab' and cat_link contains '#'
                    assign cat_onclick = "if (typeof window.selectProductCategory === 'function') { window.selectProductCategory('lab-coat'); return false; }"
                  elsif cat_link contains 'cap' and cat_link contains '#'
                    assign cat_onclick = "if (typeof window.selectProductCategory === 'function') { window.selectProductCategory('caps'); return false; }"
                  elsif cat_name_lower contains 'cap' and cat_link contains '#'
                    assign cat_onclick = "if (typeof window.selectProductCategory === 'function') { window.selectProductCategory('caps'); return false; }"
                  elsif cat_link contains 'access' and cat_link contains '#'
                    assign cat_onclick = "if (typeof window.navigateToAccessories === 'function') { window.navigateToAccessories(); return false; }"
                  elsif cat_name_lower contains 'access' and cat_link contains '#'
                    assign cat_onclick = "if (typeof window.navigateToAccessories === 'function') { window.navigateToAccessories(); return false; }"
                  endif
                -%}
                <a
                  href="{% if cat_link != blank %}{{ cat_link }}{% elsif cat_name != blank %}#category-{{ cat_name | handleize }}{% else %}#{% endif %}"
                  class="split-category-tile{% unless has_info %} is-image-only{% endunless %}"
                  id="shopify-block-{{ block.id }}"
                  data-category-name="{{ cat_name | escape }}"
                  aria-label="{% if cat_name != blank %}Shop {{ cat_name | escape }}{% elsif badge_txt != blank %}{{ badge_txt | escape }}{% else %}Category Thumbnail{% endif %}"
                  style="background-color: {{ card_bg }}; text-align: {{ text_align }};"
                  {% if cat_onclick != blank %}onclick="{{ cat_onclick }}"{% endif %}
                  {{ block.shopify_attributes }}
                >
                  <div class="split-category-thumb{% if section.settings.image_fit_mode == 'contain' %} is-contain{% endif %}">
                    {% if badge_txt != blank %}
                      <span class="customizer-banner-badge" style="background: {{ badge_col }}; color: #ffffff; font-size: 10px; padding: 2px 6px; top: 8px; left: 8px;">
                        {{ badge_txt | escape }}
                      </span>
                    {% endif %}
                    {% if tile_img_src != blank %}
                      <img
                        src="{{ tile_img_src }}"
                        alt="{{ cat_name | default: block.settings.image.alt | default: 'Category Thumbnail' | escape }}"
                        class="split-category-img"
                        data-fit="{{ section.settings.image_fit_mode | default: 'cover' }}"
                        width="200"
                        height="200"
                        loading="lazy"
                      />
                    {% else %}
                      <div class="split-category-placeholder" style="background: #f1f5f9; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; min-height: 120px;">
                        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                          <path d="M20.38 3.46L16 2a4 4 0 01-8 0L3.62 3.46a2 2 0 00-1.34 2.23l.58 3.47a1 1 0 00.99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 002-2V10h2.15a1 1 0 00.99-.84l.58-3.47a2 2 0 00-1.34-2.23z"/>
                        </svg>
                      </div>
                    {% endif %}
                  </div>
                  {% if has_info %}
                  <div class="split-category-info" style="text-align: {{ text_align }};">
                    {% if cat_name != blank %}
                      <h3 class="split-category-name" style="color: {{ card_text_color }};">{{ cat_name | escape }}</h3>
                    {% endif %}
                    {% if cat_meta != blank %}
                      <span class="split-category-meta" style="color: {{ meta_color }};">{{ cat_meta | escape }}</span>
                    {% endif %}
                  </div>
                  {% endif %}
                </a>
              {% endif %}
            {% endif %}
          {% endfor %}
      </div>
    </div>

    <!-- Right: Large Brand Video Showcase -->
    <div class="split-video-column">
      <div class="brand-video-card-container">
        <div class="brand-video-wrapper">
          {% if shopify_video != blank %}
            {{
              shopify_video
              | video_tag:
                id: 'enamels-brand-promo-video',
                class: 'brand-promo-video-element',
                image_size: '900x',
                poster: brand_poster,
                autoplay: video_autoplay,
                loop: video_loop,
                muted: video_muted,
                controls: video_controls,
                playsinline: true,
                preload: 'metadata',
                aria-label: 'Enamels Medical Performance Brand Showcase Video'
            }}
          {% elsif video_url != blank %}
            <video
              id="enamels-brand-promo-video"
              class="brand-promo-video-element"
              poster="{{ brand_poster }}"
              {% if video_autoplay %}autoplay{% endif %}
              {% if video_muted %}muted{% endif %}
              {% if video_loop %}loop{% endif %}
              {% if video_controls %}controls{% endif %}
              playsinline
              preload="metadata"
              aria-label="Enamels Medical Performance Brand Showcase Video"
            >
              <source src="{{ video_url }}" type="video/mp4">
            </video>
          {% elsif brand_poster != blank %}
            <div class="brand-video-placeholder-wrap">
              <img
                src="{{ brand_poster }}"
                alt="{{ video_title | default: 'Brand Video Poster' | escape }}"
                class="brand-promo-video-element"
                width="900"
                height="600"
                loading="lazy"
              >
            </div>
          {% endif %}

          <!-- Video Overlay Card with Controls -->
          {% if show_video_overlay %}
          <div class="brand-video-overlay-banner">
            {% if video_badge != blank or video_title != blank or video_desc != blank %}
              <div class="brand-video-info">
                {% if show_video_badge and video_badge != blank %}
                  <span class="brand-video-badge">{{ video_badge | escape }}</span>
                {% endif %}
                {% if show_video_title and video_title != blank %}
                  <h3 class="brand-video-title">{{ video_title | escape }}</h3>
                {% endif %}
                {% if show_video_desc and video_desc != blank %}
                  <p class="brand-video-desc">{{ video_desc | escape }}</p>
                {% endif %}
              </div>
            {% endif %}
            <div class="brand-video-controls">
              {% if show_video_cta and video_cta_link != blank and video_cta_label != blank %}
                <a
                  href="{{ video_cta_link }}"
                  class="brand-video-cta-link-btn"
                  aria-label="{{ video_cta_label | escape }}"
                >
                  {{ video_cta_label | escape }}
                </a>
              {% endif %}
              {% if show_pause_button %}
              <button
                type="button"
                class="brand-video-toggle-btn"
                id="brand-video-play-pause-btn"
                onclick="if (typeof window.toggleBrandPromoVideo === 'function') { window.toggleBrandPromoVideo(event); }"
                aria-label="Pause Promotional Video"
              >
                <span id="brand-video-btn-icon">⏸</span>
                <span id="brand-video-btn-label">Pause</span>
              </button>
              {% endif %}
            </div>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Configuration Bridge Exporting Theme Editor Categories to JS -->
<script id="enamels-categories-config" type="application/json">
[
  {% assign exported_count = 0 %}
  {% for block in section.blocks %}
    {% if block.type == 'category' %}
      {% if exported_count > 0 %},{% endif %}
      {
        "id": {{ block.id | json }},
        "name": {{ block.settings.title | json }},
        "meta": {{ block.settings.meta | json }},
        "link": {{ block.settings.link | json }},
        "visible": {% if block.settings.visible == false %}false{% else %}true{% endif %}
      }
      {% assign exported_count = exported_count | plus: 1 %}
    {% endif %}
  {% endfor %}
]
</script>
<script>
  (function() {
    try {
      const cfgEl = document.getElementById('enamels-categories-config');
      if (cfgEl) {
        window.EnamelsThemeCategories = JSON.parse(cfgEl.textContent || '[]');
      }
    } catch (e) {
      console.warn('[Enamels] Could not parse category configuration bridge:', e);
    }
  })();
</script>
<script>
  (function() {
    function setupBrandPromoVideo() {
      const vid = document.getElementById('enamels-brand-promo-video');
      const btn = document.getElementById('brand-video-play-pause-btn');
      const icon = document.getElementById('brand-video-btn-icon');
      const label = document.getElementById('brand-video-btn-label');
      if (!vid) return;

      function updatePlayState() {
        if (!icon || !label || !btn) return;
        if (vid.paused) {
          icon.textContent = '▶';
          label.textContent = 'Play';
          btn.setAttribute('aria-label', 'Play Promotional Video');
        } else {
          icon.textContent = '⏸';
          label.textContent = 'Pause';
          btn.setAttribute('aria-label', 'Pause Promotional Video');
        }
      }

      vid.removeEventListener('play', updatePlayState);
      vid.removeEventListener('pause', updatePlayState);
      vid.addEventListener('play', updatePlayState);
      vid.addEventListener('pause', updatePlayState);
      updatePlayState();

      window.toggleBrandPromoVideo = function(evt) {
        if (evt) {
          evt.stopPropagation();
          if (evt.preventDefault) evt.preventDefault();
        }
        const v = document.getElementById('enamels-brand-promo-video');
        if (!v) return;
        if (v.paused) {
          v.play().catch(function(err) {
            console.warn('[Enamels Video] Play prevented:', err);
          });
        } else {
          v.pause();
        }
      };

      if (btn) {
        btn.onclick = function(e) {
          window.toggleBrandPromoVideo(e);
        };
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupBrandPromoVideo);
    } else {
      setupBrandPromoVideo();
    }
    document.addEventListener('shopify:section:load', setupBrandPromoVideo);
  })();
</script>
{% endif %}

