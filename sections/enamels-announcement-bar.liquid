{% comment %}
  Enamels Modular Announcement Bar Section
  Provides marquee scrolling ticker with customizable message blocks, speed, and colors.
{% endcomment %}

{%- liquid
  assign enable_bar = section.settings.enable_announcement_bar
  assign bg_color = section.settings.announcement_bg | default: '#008779'
  assign text_color = section.settings.announcement_color | default: '#ffffff'
  assign speed = section.settings.announcement_speed | default: 28
-%}

{% if enable_bar and section.blocks.size > 0 %}
<div class="enamels-announcement-bar" id="enamels-announcement-{{ section.id }}" style="background-color: {{ bg_color }}; color: {{ text_color }};">
  <div class="enamels-announcement-track" style="animation-duration: {{ speed }}s;">
    {% for block in section.blocks %}
      <span {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" style="color: inherit; text-decoration: none;">
        {% endif %}
        {{ block.settings.text | escape }}
        {% if block.settings.link != blank %}
          </a>
        {% endif %}
      </span>
    {% endfor %}
    {% comment %}Duplicate for seamless infinite marquee loop{% endcomment %}
    {% for block in section.blocks %}
      <span aria-hidden="true">
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" style="color: inherit; text-decoration: none;" tabindex="-1">
        {% endif %}
        {{ block.settings.text | escape }}
        {% if block.settings.link != blank %}
          </a>
        {% endif %}
      </span>
    {% endfor %}
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Announcement Bar",
  "class": "enamels-announcement-section-wrapper",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_announcement_bar",
      "label": "Enable Announcement Bar",
      "default": true
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Background Color",
      "default": "#008779"
    },
    {
      "type": "color",
      "id": "announcement_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "announcement_speed",
      "label": "Scroll Animation Duration (Seconds)",
      "min": 15,
      "max": 60,
      "step": 1,
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Announcement Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}
