        var waHref = 'https://wa.me/' + item.phone.replace(/[^0-9]/g, '') + '?text=Hello%20' + encodeURIComponent(item.customerName) + '%2C%20this%20is%20Enamels%20Institutional%20Desk%20regarding%20Bulk%20Order%20Enquiry%20%23' + item.refId + '.';

        return '<div class="bulk-inquiry-card">' +
          '<div class="bulk-inquiry-header">' +
            '<div>' +
              '<span style="font-size: 11px; font-weight: 800; color: #008779; text-transform: uppercase;">' + item.refId + ' • Submitted ' + item.date + '</span>' +
              '<h3 class="bulk-org-title">' + item.organization + '</h3>' +
              '<span style="font-size: 13px; color: #64748b;">Contact: ' + item.customerName + ' • ' + item.city + '</span>' +
            '</div>' +
            '<div>' +
              '<span style="background: #f1f5f9; color: #102a43; font-weight: 800; font-size: 12px; padding: 4px 10px; border-radius: 4px; border: 1px solid #cbd5e1;">' +
                'Volume: ' + item.qtyRange +
              '</span>' +
            '</div>' +
          '</div>' +

          '<div class="bulk-inquiry-body">' +
            '<div>' +
              '<strong style="display: block; font-size: 11px; text-transform: uppercase; color: #64748b;">Product Category</strong>' +
              '<span style="font-weight: 700; color: #102a43;">' + item.category + '</span>' +
            '</div>' +
            '<div>' +
              '<strong style="display: block; font-size: 11px; text-transform: uppercase; color: #64748b;">Contact Channel</strong>' +
              '<span>' + item.phone + '<br>' + item.email + '</span>' +
            '</div>' +
            '<div>' +
              '<strong style="display: block; font-size: 11px; text-transform: uppercase; color: #64748b;">Institutional Specs & Notes</strong>' +
              '<span style="font-size: 12px; color: #334155;">' + item.notes + '</span>' +
            '</div>' +
          '</div>' +

          '<div class="bulk-actions-row">' +
            '<div style="display: flex; align-items: center; gap: 8px;">' +
              '<span style="font-size: 12px; font-weight: 700; color: #64748b;">Update Status:</span>' +
              '<select class="status-select-inline" onchange="window.updateBulkStatus(\'' + item.refId + '\', this.value)">' +
                '<option value="New Enquiry"' + (item.status === 'New Enquiry' ? ' selected' : '') + '>New Enquiry</option>' +
                '<option value="Contact Pending"' + (item.status === 'Contact Pending' ? ' selected' : '') + '>Contact Pending</option>' +
                '<option value="Quotation Sent"' + (item.status === 'Quotation Sent' ? ' selected' : '') + '>Quotation Sent</option>' +
                '<option value="In Production"' + (item.status === 'In Production' ? ' selected' : '') + '>In Production</option>' +
                '<option value="Completed"' + (item.status === 'Completed' ? ' selected' : '') + '>Completed</option>' +
              '</select>' +
            '</div>' +

            '<div style="display: flex; gap: 8px;">' +
              '<a href="' + waHref + '" target="_blank" class="btn-dock-wa">💬 WhatsApp Officer</a>' +
              '<a href="tel:' + item.phone + '" class="btn-outline-sm">📞 Call</a>' +
              '<a href="mailto:' + item.email + '?subject=Enamels%20Wholesale%20Quotation%20' + item.refId + '" class="btn-outline-sm">✉️ Email</a>' +
            '</div>' +
          '</div>' +
        '</div>';
      }).join('');
    };

    window.filterBulkQueries = function(status, btn) {
      document.querySelectorAll('#content-bulk-enquiries .filter-chip').forEach(function(c) { c.classList.remove('active'); });
      if (btn) btn.classList.add('active');
      window.renderProfileBulkQueries(status);
    };

    window.updateBulkStatus = function(refId, newStatus) {
      var list = getBulkQueries();
      list.forEach(function(i) {
        if (i.refId === refId) i.status = newStatus;
      });
      try {
        localStorage.setItem('enamels_bulk_enquiries', JSON.stringify(list));
      } catch (e) {}
      window.renderProfileBulkQueries();
    };

    window.unlockAdminProfile = function(e) {
      if (e) e.preventDefault();
      var input = document.getElementById('admin-security-pin');
      var pin = (input ? input.value : '').trim();
      var err = document.getElementById('admin-auth-error');

      // Valid security keys for Enamels staff/admin
      if (pin === 'enamels2026' || pin === 'admin@enamels' || pin === 'enamels@admin' || pin === '1331133') {
        sessionStorage.setItem('enamels_admin_auth', '1');
        if (err) err.style.display = 'none';
        initAdminProfile();
      } else {
        if (err) {
          err.textContent = 'Invalid administrator security key. Please check credentials or sign in with staff account.';
          err.style.display = 'block';
        }
      }
    };

    window.lockAdminProfile = function() {
      sessionStorage.removeItem('enamels_admin_auth');
      initAdminProfile();
    };

    function checkAdminAuth() {
      var isServerAdmin = {{ is_server_admin | json }};
      var isSessionAdmin = sessionStorage.getItem('enamels_admin_auth') === '1';
      var gateEl = document.getElementById('admin-auth-gate');
      var contentEl = document.getElementById('admin-protected-content');

      if (isServerAdmin || isSessionAdmin) {
        if (gateEl) gateEl.style.display = 'none';
        if (contentEl) contentEl.style.display = 'block';
        return true;
      } else {
        if (gateEl) gateEl.style.display = 'block';
        if (contentEl) contentEl.style.display = 'none';
        return false;
      }
    }

    function initAdminProfile() {
      var authorized = checkAdminAuth();
      if (!authorized) return;

      window.renderProfileCustomOrders();
      window.renderProfileBulkQueries();

      var hash = (window.location.hash || '').replace('#', '');
      if (hash === 'customize-orders' || hash === 'custom-orders') {
        window.switchProfileTab('customize-orders');
      } else if (hash === 'bulk-enquiries' || hash === 'bulk-orders' || hash === 'bulk-queries') {
        window.switchProfileTab('bulk-enquiries');
      } else if (hash === 'account-details' || hash === 'addresses') {
        window.switchProfileTab('account-details');
      } else if (hash === 'regular-orders') {
        window.switchProfileTab('regular-orders');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAdminProfile);
    } else {
      initAdminProfile();
    }

    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        initAdminProfile();
      }
    });

  })();
</script>

{% schema %}
{
  "name": "Admin Operations Profile",
  "settings": []
}
{% endschema %}
