{% comment %}
  ENAMELS ONLINE — MODULAR READY TO WEAR / BESPOKE SCRUB WIZARD SECTION
  7-Step Interactive Medical Uniform Tailoring Engine for Shopify OS 2.0.
  Can be placed on the homepage, dedicated pages, or product templates.
{% endcomment %}

<section
  class="enamels-rtw-section section-padding"
  id="ReadyToWear-{{ section.id }}"
  data-section-id="{{ section.id }}"
  style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0; background-color: {{ section.settings.bg_color }};"
>
  <div class="page-container">
    {% if section.settings.show_header %}
      <div class="section-header-wrap" style="text-align: {{ section.settings.header_alignment }}; margin-bottom: 28px;">
        {% if section.settings.badge != blank %}
          <span class="section-tag-sub">{{ section.settings.badge | escape }}</span>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="section-title-main" style="color: {{ section.settings.heading_color }};">
            {{ section.settings.title | escape }}
          </h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="section-title-desc" style="color: {{ section.settings.text_color }};">
            {{ section.settings.subtitle | escape }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <!-- Render the 7-Step Ready to Wear Configurator Engine -->
    <div class="rtw-standalone-embed">
      {% render 'enamels-ready-to-wear' %}
    </div>
  </div>
</section>

<style>
  #ReadyToWear-{{ section.id }} .chroma-view-panel#view-ready-to-wear {
    display: block !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }
  #ReadyToWear-{{ section.id }} .rtw-wizard-container {
    max-width: 100%;
    padding: 0;
  }
</style>

{% schema %}
{
  "name": "Ready to Wear Studio",
  "tag": "section",
  "class": "section-enamels-ready-to-wear",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show Section Header",
      "default": false
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Section Tag Badge",
      "default": "BESPOKE CLINICAL TAILORING"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Ready to Wear / Make Your Own Scrub"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Architectural medical uniform configurator. Select technical fabric, hospital shade, article series, and tailoring fit."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#102a43"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#64748b"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Ready to Wear Studio"
    }
  ]
}
{% endschema %}
