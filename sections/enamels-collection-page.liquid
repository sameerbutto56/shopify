    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Full-Size Thumbnail Pill (fills the entire card box) */
  .enamels-cat-card--full-image {
    padding: 0 !important;
    position: relative !important;
    overflow: hidden !important;
    display: block !important;
    height: var(--cat-pill-h, 56px) !important;
    min-height: var(--cat-pill-h, 56px) !important;
    max-height: var(--cat-pill-h, 56px) !important;
    width: var(--cat-pill-w, 170px) !important;
    min-width: var(--cat-pill-w, 170px) !important;
    flex: 0 0 var(--cat-pill-w, 170px) !important;
    border-radius: var(--cat-pill-radius, 8px) !important;
    box-sizing: border-box !important;
    border: 2px solid transparent !important;
    transition: transform 0.2s cubic-bezier(0.2, 0, 0.2, 1), box-shadow 0.2s ease, border-color 0.2s ease !important;
  }

  @media (max-width: 767px) {
    .enamels-cat-card--full-image {
      height: var(--cat-pill-h-mob, 52px) !important;
      min-height: var(--cat-pill-h-mob, 52px) !important;
      max-height: var(--cat-pill-h-mob, 52px) !important;
      width: var(--cat-pill-w-mob, 150px) !important;
      min-width: var(--cat-pill-w-mob, 150px) !important;
      flex: 0 0 var(--cat-pill-w-mob, 150px) !important;
    }
  }

  .enamels-cat-card--full-image .enamels-cat-full-image {
    width: 100% !important;
    height: 100% !important;
    min-width: 100% !important;
    min-height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: var(--cat-pill-img-fit, cover) !important;
    object-position: var(--cat-pill-img-pos, center) !important;
    display: block !important;
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    border-radius: var(--cat-pill-radius, 8px) !important;
    transition: transform 0.3s cubic-bezier(0.2, 0, 0.2, 1) !important;
  }

  .enamels-cat-card--full-image:hover .enamels-cat-full-image {
    transform: scale(1.04);
  }

  .enamels-cat-card--full-image.is-active {
    border-color: var(--cat-pill-active-border, #102a43) !important;
    box-shadow: 0 0 0 2px var(--cat-pill-active-border, #102a43), 0 4px 14px rgba(16, 42, 67, 0.2) !important;
    outline: none !important;
  }

  .enamels-cat-card--full-image .enamels-cat-advance-tag {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
  }

  .enamels-cat-card--full-image .enamels-cat-card__badge {
    position: absolute;
    top: 6px;
    left: 8px;
    background: #111111;
    color: #ffffff;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 4px;
    z-index: 10;
  }

  .enamels-cat-card--full-image .enamels-cat-card__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.75) 100%);
    padding: 12px 10px 6px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }

  .enamels-cat-card--full-image .enamels-cat-card__overlay-title {
    font-size: 11px;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .enamels-cat-card--full-image .enamels-cat-card__overlay-subtitle {
    font-size: 9px;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 1px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .enamels-cat-card__media {
    flex: 0 0 54px !important;
    height: 100% !important;
    max-height: var(--cat-pill-h, 56px) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    position: relative !important;
    background: transparent !important;
    width: auto !important;
  }

  .enamels-cat-card__media img {
    height: 100% !important;
    width: 100% !important;
    max-height: var(--cat-pill-h, 56px) !important;
    object-fit: var(--cat-pill-img-fit, cover) !important;
    object-position: var(--cat-pill-img-pos, center) !important;
    display: block !important;
    transition: transform 0.3s ease;
    border-radius: 4px;
  }

  .enamels-cat-card:hover .enamels-cat-card__media img {
    transform: scale(1.05);
  }

  .enamels-cat-pill-btn__placeholder,
  .enamels-all-grid-icon {
    font-size: 16px;
    color: #64748b;
  }

  /* 4. Article Sub-Filter Bar */
  .enamels-article-filters {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
    padding: 10px 14px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-sizing: border-box;
  }

  .enamels-article-filters.style-clean {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    margin-bottom: 16px !important;
  }

  .enamels-article-filters__label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #64748b;
    text-transform: uppercase;
    margin-right: 4px;
  }

  .enamels-article-filters__list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .enamels-article-pill {
    padding: 5px 12px;
    border-radius: 6px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    font-size: 11px;
    font-weight: 600;
    color: #334155;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .enamels-article-pill:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
  }

  .enamels-article-pill.is-active {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }

  /* 5. Head Row & Active Product Counter */
  .enamels-cat-page__head-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 20px;
  }
  .enamels-cat-page__head-row.align-center {
    justify-content: center;
    text-align: center;
  }
  .enamels-cat-page__head-row.align-right {
    justify-content: flex-end;
    text-align: right;
  }

  .enamels-cat-page__head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .enamels-cat-page__title {
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.2;
  }

  .enamels-cat-page__desc {
    font-size: 14px;
    color: #64748b;
    max-width: 700px;
    line-height: 1.5;
    margin-top: 4px;
  }

  .enamels-cat-page__counter {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    margin: 0;
  }

  .enamels-cat-clear-btn {
    padding: 6px 12px;
    border-radius: 6px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    font-size: 11px;
    font-weight: 700;
    color: #ef4444;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .enamels-cat-clear-btn:hover {
    background: #fef2f2;
    border-color: #fca5a5;
  }

  /* 6. Product Cards Grid */
  .enamels-cat-page__grid {
    display: grid;
    grid-template-columns: repeat(var(--cat-grid-cols-desk, 6), minmax(0, 1fr));
    gap: var(--cat-grid-gap-desk, 12px);
    width: 100%;
  }

  @media (max-width: 1024px) {
    .enamels-cat-page__grid {
      grid-template-columns: repeat(var(--cat-grid-cols-tab, 3), minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .enamels-cat-page__grid {
      grid-template-columns: repeat(var(--cat-grid-cols-mob, 2), minmax(0, 1fr));
      gap: var(--cat-grid-gap-mob, 10px);
    }
  }

  .enamels-col-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease;
  }

  .enamels-col-card__link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .enamels-col-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--cat-card-aspect, 2 / 3);
    border-radius: var(--cat-card-radius, 8px);
    overflow: hidden;
    background-color: var(--cat-card-bg, #f8fafc);
  }

  .enamels-col-card__primary-img,
  .enamels-col-card__secondary-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: var(--cat-card-fit, contain);
    object-position: var(--cat-card-pos, center);
    transition: opacity 0.3s ease, transform 0.4s ease;
  }

  .enamels-col-card__secondary-img {
    opacity: 0;
    z-index: 1;
  }

  .enamels-col-card:hover .enamels-col-card__secondary-img {
    opacity: 1;
  }

  .enamels-col-card:hover .enamels-col-card__primary-img {
    transform: scale(1.02);
  }

  .enamels-col-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: #94a3b8;
    font-size: 14px;
    letter-spacing: 0.05em;
  }

  .enamels-col-card__badge-sale {
    position: absolute;
    top: 6px;
    left: 6px;
    background: #dc2626;
    color: #ffffff;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.04em;
    padding: 2px 6px;
    border-radius: 4px;
    z-index: 2;
  }

  .enamels-col-card__info {
    padding-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .enamels-col-card__series {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #008779;
    line-height: 1.2;
  }
  .enamels-col-card__series--empty {
    visibility: hidden;
  }

  .enamels-col-card__title {
    font-size: var(--cat-title-size-desk, 12px);
    font-weight: 600;
    color: #0f172a;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .enamels-col-card__title {
      font-size: var(--cat-title-size-mob, 11px);
    }
  }

  .enamels-col-card__price-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: 1px;
  }

  .enamels-col-card__price {
    font-size: var(--cat-price-size-desk, 12px);
    font-weight: 700;
    color: #0f172a;
  }

  @media (max-width: 640px) {
    .enamels-col-card__price {
      font-size: var(--cat-price-size-mob, 11px);
    }
  }

  .enamels-col-card__compare-price {
    font-size: calc(var(--cat-price-size-desk, 12px) * 0.9);
    color: #94a3b8;
    text-decoration: line-through;
    font-weight: 500;
  }

  .enamels-col-card__swatches {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
  }

  .enamels-swatch-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.15);
    display: inline-block;
  }

  .enamels-swatch-more {
    font-size: 9px;
    color: #64748b;
    font-weight: 600;
    margin-left: 2px;
  }

  .enamels-cat-empty {
    padding: 60px 16px;
    text-align: center;
  }

  .enamels-cat-empty__box {
    max-width: 400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .enamels-cat-empty__icon {
    font-size: 36px;
  }

  .enamels-cat-empty__title {
    font-size: 18px;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
  }

  .enamels-cat-empty__text {
    font-size: 13px;
    color: #64748b;
    margin: 0;
    line-height: 1.5;
  }

  .enamels-cat-empty__btn {
    margin-top: 8px;
    padding: 10px 20px;
    background: #102a43;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .enamels-cat-empty__btn:hover {
    background: #1e3a5f;
  }
</style>

