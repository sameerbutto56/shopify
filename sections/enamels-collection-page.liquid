{% comment %}
  Enamels Dedicated Category / Collection Page Template Section
  Complete Category Navigation Flow & Genuine Product Browsing Engine
  1. Top Hero Category Banner (Fully editable, desktop & mobile images, text overlay, CTAs, zero fallbacks)
  2. Reusable Category Pills Carousel (Exact homepage pill design, custom thumbnails, collection mapping)
  3. Dynamic Article Sub-Filter Bar (Under Scrubs: All Scrubs, Crown, Velora, Sprinter, Flexwell)
  4. Real Shopify Product Loop (Standard 2:3 portrait cards, clinical color swatches, full layout controls)
  5. Strict Gender Isolation (Men -> Men products only; Women -> Women products only)
  6. Full Shopify Studio Editor Customization Controls
{% endcomment %}

{%- liquid
  # 1. Target Collection Resolution
  assign target_col = collection
  if target_col == blank
    if section.settings.collection != blank
      assign target_col = collections[section.settings.collection]
    endif
  endif
  if target_col == blank
    assign target_col = collections['all']
  endif

  assign is_specific_col = false
  if collection != blank and collection.handle != 'all' and collection.handle != blank
    assign is_specific_col = true
  endif

  # 2. Gender Context Resolution
  assign initial_gender = section.settings.gender_filter | default: 'auto'
  assign query_str = request.path | append: '?' | append: request.query_string | downcase

  if initial_gender == 'auto'
    if query_str contains 'gender=men' or query_str contains 'category=men' or collection.handle contains 'male' or collection.handle contains 'men' or request.path contains '/men' or request.path contains '/male-scrubs'
      assign current_gender = 'men'
    elsif query_str contains 'gender=women' or query_str contains 'category=women' or collection.handle contains 'female' or collection.handle contains 'women' or request.path contains '/women' or request.path contains '/female-scrubs'
      assign current_gender = 'women'
    else
      assign current_gender = 'all'
    endif
  else
    assign current_gender = initial_gender
  endif

  # 3. Category & Article Initial Context
  assign current_cat = 'all'
  if query_str contains 'category=scrubs'
    assign current_cat = 'scrubs'
  elsif query_str contains 'category=white-coats'
    assign current_cat = 'white-coats'
  elsif query_str contains 'category=lab-coats' or query_str contains 'category=lab'
    assign current_cat = 'lab-coats'
  elsif query_str contains 'category=caps'
    assign current_cat = 'caps'
  elsif query_str contains 'category=accessories'
    assign current_cat = 'accessories'
  elsif query_str contains 'category=sleeves'
    assign current_cat = 'sleeves'
  endif

  assign current_article = 'all'
  if query_str contains 'article=sprinter'
    assign current_article = 'sprinter'
  elsif query_str contains 'article=vilora' or query_str contains 'article=velora'
    assign current_article = 'vilora'
  elsif query_str contains 'article=crown'
    assign current_article = 'crown'
  elsif query_str contains 'article=flexwell'
    assign current_article = 'flexwell'
  endif

  # 4. Banner Sizing & Image Resolution (Matches Homepage Hero Banner Dimensions)
  assign show_banner = section.settings.show_banner
  if show_banner == nil
    assign show_banner = true
  endif

  assign banner_img = section.settings.banner_image
  assign banner_img_mob = section.settings.banner_image_mobile
  assign use_col_img = section.settings.use_collection_image
  if use_col_img == nil
    assign use_col_img = true
  endif

  if banner_img == blank and use_col_img and target_col != blank and target_col.image != blank
    assign banner_img = target_col.image
  endif
  if banner_img_mob == blank and banner_img != blank
    assign banner_img_mob = banner_img
  endif

  assign banner_sizing_mode = section.settings.banner_sizing_mode | default: 'aspect_ratio'
  assign banner_aspect = section.settings.banner_aspect_ratio | default: '2000 / 767'
  assign banner_aspect_mob = section.settings.banner_aspect_ratio_mobile | default: 'same'
  if banner_aspect_mob == 'same' or banner_aspect_mob == blank
    assign banner_aspect_mob = banner_aspect
  endif

  assign banner_w_desk = section.settings.banner_width_desktop | default: 2000
  assign banner_h_desk = section.settings.banner_height_desktop | default: 770
  assign banner_h_tab = section.settings.banner_height_tablet | default: 520
  assign banner_h_mob = section.settings.banner_height_mobile | default: 320

  assign banner_radius = section.settings.banner_radius | default: 0
  assign banner_bg = section.settings.banner_bg | default: '#e8e8e8'
  assign banner_width = section.settings.banner_width | default: 'container'
  assign banner_img_fit = section.settings.banner_img_fit | default: 'contain'
  assign banner_img_pos = section.settings.banner_img_pos | default: 'center'
  assign banner_overlay_color = section.settings.banner_overlay_color | default: '#000000'
  assign banner_overlay_opacity = section.settings.banner_overlay_opacity | default: 0

  # Banner Text Content (Default: OFF / No forced overlay text)
  assign show_banner_text = false
  if section.settings.show_banner_text == true
    assign show_banner_text = true
  endif

  # Only use explicitly entered custom heading and description - NEVER force collection title or description
  assign b_heading = section.settings.banner_heading | strip
  if section.settings.auto_collection_title and b_heading == blank and target_col != blank
    assign b_heading = target_col.title
  endif

  assign b_desc = section.settings.banner_description | strip
  if section.settings.auto_collection_description and b_desc == blank and target_col != blank
    assign b_desc = target_col.description
  endif

  assign b_eyebrow = section.settings.banner_eyebrow | strip
  assign b_btn_text = section.settings.banner_button_text | strip
  assign b_btn_link = section.settings.banner_button_link

  assign b_head_color = section.settings.banner_heading_color | default: '#ffffff'
  assign b_head_size_desk = section.settings.banner_heading_size_desk | default: 32
  assign b_head_size_mob = section.settings.banner_heading_size_mob | default: 22
  assign b_head_weight = section.settings.banner_heading_weight | default: '800'
  assign b_desc_color = section.settings.banner_desc_color | default: '#f1f5f9'
  assign b_desc_size = section.settings.banner_desc_size | default: 15
  assign b_text_align = section.settings.banner_text_align | default: 'center'
  assign b_text_valign = section.settings.banner_text_valign | default: 'center'

  # 5. Category Carousel Heading & Settings
  assign show_category_carousel = section.settings.show_category_carousel
  if show_category_carousel == nil
    assign show_category_carousel = true
  endif

  assign show_carousel_heading = section.settings.show_carousel_heading
  if show_carousel_heading == nil
    assign show_carousel_heading = true
  endif

  assign carousel_title = section.settings.carousel_title
  assign carousel_subtitle = section.settings.carousel_subtitle
  assign carousel_head_align = section.settings.carousel_head_align | default: 'left'
  assign carousel_title_size_desk = section.settings.carousel_title_size_desk | default: 20
  assign carousel_title_size_mob = section.settings.carousel_title_size_mob | default: 16
  assign carousel_title_color = section.settings.carousel_title_color | default: '#111111'
  assign carousel_title_weight = section.settings.carousel_title_weight | default: '700'

  # 6. Collection Header & Section Title
  assign show_collection_header = section.settings.show_collection_header
  if show_collection_header == nil
    assign show_collection_header = true
  endif

  assign head_source = section.settings.heading_source | default: 'collection_title'
  assign title_text = section.settings.title
  if head_source == 'collection_title'
    if target_col != blank and target_col.title != blank and target_col.handle != 'all'
      assign title_text = target_col.title
    elsif current_gender == 'men'
      assign title_text = "Men's Collection"
    elsif current_gender == 'women'
      assign title_text = "Women's Collection"
    else
      assign title_text = "All Products"
    endif
  endif

  assign show_collection_desc = section.settings.show_collection_description
  if show_collection_desc == nil
    assign show_collection_desc = true
  endif

  assign sec_desc = section.settings.custom_description
  if section.settings.desc_source == 'collection_description' and target_col != blank and target_col.description != blank
    assign sec_desc = target_col.description
  endif

  # 7. Grid & Product Card Sizing Settings
  assign container_max_w = section.settings.container_max_width | default: 1320
  assign cols_desk = section.settings.grid_cols_desktop | default: 6
  assign cols_tab = section.settings.grid_cols_tablet | default: 3
  assign cols_mob = section.settings.grid_cols_mobile | default: 2
  assign gap_desk = section.settings.grid_gap_desktop | default: 12
  assign gap_mob = section.settings.grid_gap_mobile | default: 10
  assign prods_per_page = section.settings.products_per_page | default: 48

  capture card_aspect
    render 'product-thumb-ratio', choice: section.settings.card_aspect_ratio
  endcapture
  assign card_aspect = card_aspect | strip
  if card_aspect == blank or card_aspect == 'auto' or card_aspect == 'natural'
    assign card_aspect = '2 / 3'
  endif

  assign card_fit = section.settings.card_image_fit
  if card_fit == blank or card_fit == 'inherit'
    assign card_fit = settings.product_card_image_fit | default: 'contain'
  endif
  assign card_pos = section.settings.card_image_position
  if card_pos == blank or card_pos == 'inherit'
    assign card_pos = settings.product_card_image_position | default: 'center'
  endif
  assign card_bg = section.settings.card_image_bg | default: '#f8fafc'
  assign card_rad = section.settings.card_radius | default: 8
  assign pad_top_desk = section.settings.padding_top_desktop | default: 16
  assign pad_top_mob = section.settings.padding_top_mobile | default: 12
  assign pad_bot_desk = section.settings.padding_bottom_desktop | default: 48
  assign pad_bot_mob = section.settings.padding_bottom_mobile | default: 30
  assign heading_size_desk = section.settings.heading_size_desktop | default: 22
  assign heading_size_mob = section.settings.heading_size_mobile | default: 18
  assign heading_align = section.settings.heading_alignment | default: 'left'
  assign heading_color = section.settings.heading_color | default: '#0f172a'

  assign show_article_filter = true
  if section.settings.show_article_filter == false
    assign show_article_filter = false
  endif

  assign show_article_heading = true
  if section.settings.show_article_heading == false
    assign show_article_heading = false
  endif

  assign article_heading_text = section.settings.article_heading_text
  if section.settings.article_heading_text == nil
    assign article_heading_text = 'SERIES / ARTICLE:'
  endif

  assign article_all_lbl = section.settings.article_all_label | default: 'All Scrubs'
  assign article_box_style = section.settings.article_filter_style | default: 'boxed'
  assign show_swatches = section.settings.show_color_swatches
  if show_swatches == nil
    assign show_swatches = true
  endif
  assign show_gender_tabs = section.settings.show_gender_tabs
  if show_gender_tabs == nil
    assign show_gender_tabs = true
  endif
  assign show_prod_title = section.settings.show_product_title
  if show_prod_title == nil
    assign show_prod_title = true
  endif
  assign show_prod_price = section.settings.show_product_price
  if show_prod_price == nil
    assign show_prod_price = true
  endif
  assign show_sale_badges = section.settings.show_sale_badges
  if show_sale_badges == nil
    assign show_sale_badges = true
  endif
  assign show_secondary_img = section.settings.show_secondary_image
  if show_secondary_img == nil
    assign show_secondary_img = true
  endif
-%}

<div
  class="enamels-cat-page"
  id="enamels-cat-page-{{ section.id }}"
  data-initial-gender="{{ current_gender }}"
  data-initial-category="{{ current_cat }}"
  data-initial-article="{{ current_article }}"
  data-is-specific-collection="{% if is_specific_col %}true{% else %}false{% endif %}"
  style="
    --cat-page-max-w: {{ container_max_w }}px;
    --cat-page-pad-top-desk: {{ pad_top_desk }}px;
    --cat-page-pad-top-mob: {{ pad_top_mob }}px;
    --cat-page-pad-bot-desk: {{ pad_bot_desk }}px;
    --cat-page-pad-bot-mob: {{ pad_bot_mob }}px;
    --cat-grid-cols-desk: {{ cols_desk }};
    --cat-grid-cols-tab: {{ cols_tab }};
    --cat-grid-cols-mob: {{ cols_mob }};
    --cat-grid-gap-desk: {{ gap_desk }}px;
    --cat-grid-gap-mob: {{ gap_mob }}px;
    --cat-card-aspect: {{ card_aspect }};
    --cat-card-fit: {{ card_fit }};
    --cat-card-pos: {{ card_pos }};
    --cat-card-bg: {{ card_bg }};
    --cat-card-radius: {{ card_rad }}px;
    --cat-head-size-desk: {{ heading_size_desk }}px;
    --cat-head-size-mob: {{ heading_size_mob }}px;
    --cat-head-align: {{ heading_align }};
    --cat-head-color: {{ heading_color }};
    --cat-pill-w: {{ section.settings.pill_width | default: 170 }}px;
    --cat-pill-w-mob: {{ section.settings.pill_width_mobile | default: 150 }}px;
    --cat-pill-h: {{ section.settings.pill_height | default: 56 }}px;
    --cat-pill-h-mob: {{ section.settings.pill_height_mobile | default: 52 }}px;
    --cat-pill-radius: {{ section.settings.pill_radius | default: 8 }}px;
    --cat-pill-bg: {{ section.settings.pill_bg | default: '#dfdfdf' }};
    --cat-pill-active-bg: {{ section.settings.pill_active_bg | default: '#ffffff' }};
    --cat-pill-active-border: {{ section.settings.pill_active_border | default: '#102a43' }};
    --cat-pill-img-fit: {{ section.settings.pill_image_fit | default: 'cover' }};
    --cat-pill-img-pos: {{ section.settings.pill_image_position | default: 'center' }};
    --cat-title-size-desk: {{ section.settings.card_title_size_desktop | default: 12 }}px;
    --cat-title-size-mob: {{ section.settings.card_title_size_mobile | default: 11 }}px;
    --cat-price-size-desk: {{ section.settings.card_price_size_desktop | default: 12 }}px;
    --cat-price-size-mob: {{ section.settings.card_price_size_mobile | default: 11 }}px;
  "
>
  <div class="enamels-cat-page__container">

    <!-- 1. Top Hero Category Banner (Fully studio-editable, zero hardcoded fallback assets) -->
    {%- if show_banner -%}
      {%- assign has_banner_media = false -%}
      {%- if banner_img != blank -%}{%- assign has_banner_media = true -%}{%- endif -%}
      {%- assign has_banner_content = false -%}
      {%- if show_banner_text -%}
        {%- if b_heading != blank or b_desc != blank or b_eyebrow != blank or b_btn_text != blank -%}
          {%- assign has_banner_content = true -%}
        {%- endif -%}
      {%- endif -%}

      {%- if has_banner_media or has_banner_content -%}
        <div
          class="enamels-cat-page__banner-wrapper banner-width-{{ banner_width }}"
        >
          <div
            class="enamels-cat-page__banner sizing-{{ banner_sizing_mode }}"
            style="
              --banner-w-desk: {{ banner_w_desk }}px;
              --banner-h-desk: {{ banner_h_desk }}px;
              --banner-h-tab: {{ banner_h_tab }}px;
              --banner-h-mob: {{ banner_h_mob }}px;
              --banner-aspect: {{ banner_aspect }};
              --banner-aspect-mob: {{ banner_aspect_mob }};
              --banner-radius: {{ banner_radius }}px;
              --banner-bg: {{ banner_bg }};
              --banner-img-fit: {{ banner_img_fit }};
              --banner-img-pos: {{ banner_img_pos }};
            "
          >
            {%- if has_banner_media -%}
              <picture class="enamels-cat-page__banner-picture">
                {%- if banner_img_mob != blank -%}
                  <source media="(max-width: 767px)" srcset="{{ banner_img_mob | image_url: width: 900 }}">
                {%- endif -%}
                <img
                  src="{{ banner_img | image_url: width: 2000 }}"
                  alt="{{ b_heading | default: target_col.title | escape }}"
                  class="enamels-cat-page__banner-img"
                  style="object-fit: var(--banner-img-fit, {{ banner_img_fit }}) !important; object-position: var(--banner-img-pos, {{ banner_img_pos }}) !important;"
                  loading="eager"
                  fetchpriority="high"
                  width="1400"
                  height="500"
                >
              </picture>
            {%- endif -%}

            {%- if banner_overlay_opacity > 0 and has_banner_content -%}
              <div
                class="enamels-cat-page__banner-overlay"
                style="background-color: {{ banner_overlay_color }}; opacity: {{ banner_overlay_opacity | divided_by: 100.0 }};"
                aria-hidden="true"
              ></div>
            {%- endif -%}

            {%- if has_banner_content -%}
              <div
                class="enamels-cat-page__banner-content text-align-{{ b_text_align }} valign-{{ b_text_valign }}"
              >
                {%- if b_eyebrow != blank -%}
                  <span
                    class="enamels-cat-banner-eyebrow"
                    style="background: {{ section.settings.banner_eyebrow_bg | default: 'rgba(255,255,255,0.2)' }}; color: {{ section.settings.banner_eyebrow_color | default: '#ffffff' }};"
                  >
                    {{ b_eyebrow | escape }}
                  </span>
                {%- endif -%}

                {%- if b_heading != blank -%}
                  <h1
                    class="enamels-cat-banner-title"
                    style="color: {{ b_head_color }}; font-size: {{ b_head_size_desk }}px; font-weight: {{ b_head_weight }};"
                  >
                    {{ b_heading }}
                  </h1>
                {%- endif -%}

                {%- if b_desc != blank -%}
                  <div
                    class="enamels-cat-banner-desc"
                    style="color: {{ b_desc_color }}; font-size: {{ b_desc_size }}px;"
                  >
                    {{ b_desc }}
                  </div>
                {%- endif -%}

                {%- if b_btn_text != blank -%}
                  <a
                    href="{{ b_btn_link | default: '#' }}"
                    class="enamels-cat-banner-btn"
                    style="background: {{ section.settings.banner_button_bg | default: '#ffffff' }}; color: {{ section.settings.banner_button_color | default: '#0f172a' }}; border-radius: {{ section.settings.banner_button_radius | default: 8 }}px;"
                  >
                    {{ b_btn_text | escape }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

    <!-- 2. Gender Tab Bar (Quick Switcher) -->
    {%- if show_gender_tabs -%}
      <div class="enamels-gender-tabs">
        <div class="enamels-gender-tabs__track">
          <button
            type="button"
            class="enamels-gender-tab{% if current_gender == 'men' %} is-active{% endif %}"
            data-gender-target="men"
            aria-label="Filter by Men's Medical Apparel"
          >
            <span class="enamels-gender-tab__indicator"></span>
            <span class="enamels-gender-tab__label">MEN</span>
          </button>
          <button
            type="button"
            class="enamels-gender-tab{% if current_gender == 'women' %} is-active{% endif %}"
            data-gender-target="women"
            aria-label="Filter by Women's Medical Apparel"
          >
            <span class="enamels-gender-tab__indicator"></span>
            <span class="enamels-gender-tab__label">WOMEN</span>
          </button>
          <button
            type="button"
            class="enamels-gender-tab{% if current_gender == 'all' %} is-active{% endif %}"
            data-gender-target="all"
            aria-label="Show All Medical Apparel"
          >
            <span class="enamels-gender-tab__indicator"></span>
            <span class="enamels-gender-tab__label">ALL</span>
          </button>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%}
      Dynamic Article Discovery across Products:
      Scan all products for series tags, metafields, or titles (Crown, Velora, Sprinter, Flexwell, etc.)
    {%- endcomment -%}
    {%- assign detected_series_string = '' -%}
    {%- if target_col.products.size > 0 -%}
      {%- for p in target_col.products -%}
        {%- assign p_title_down = p.title | downcase -%}
        {%- assign p_tags_down = p.tags | join: ' ' | downcase -%}
        
        {%- for tag in p.tags -%}
          {%- assign tag_down = tag | downcase -%}
          {%- if tag_down contains 'series:' -%}
            {%- assign s_name = tag | split: ':' | last | strip -%}
            {%- unless detected_series_string contains s_name -%}
              {%- assign detected_series_string = detected_series_string | append: s_name | append: '::' -%}
            {%- endunless -%}
          {%- elsif tag_down contains 'article:' -%}
            {%- assign s_name = tag | split: ':' | last | strip -%}
            {%- unless detected_series_string contains s_name -%}
              {%- assign detected_series_string = detected_series_string | append: s_name | append: '::' -%}
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if p_title_down contains 'crown' or p_tags_down contains 'crown' -%}
          {%- unless detected_series_string contains 'Crown' -%}
            {%- assign detected_series_string = detected_series_string | append: 'Crown::' -%}
          {%- endunless -%}
        {%- endif -%}
        {%- if p_title_down contains 'velora' or p_title_down contains 'vilora' or p_tags_down contains 'velora' or p_tags_down contains 'vilora' -%}
          {%- unless detected_series_string contains 'Velora' -%}
            {%- assign detected_series_string = detected_series_string | append: 'Velora::' -%}
          {%- endunless -%}
        {%- endif -%}
        {%- if p_title_down contains 'sprinter' or p_tags_down contains 'sprinter' -%}
          {%- unless detected_series_string contains 'Sprinter' -%}
            {%- assign detected_series_string = detected_series_string | append: 'Sprinter::' -%}
          {%- endunless -%}
        {%- endif -%}
        {%- if p_title_down contains 'flexwell' or p_tags_down contains 'flexwell' -%}
          {%- unless detected_series_string contains 'Flexwell' -%}
            {%- assign detected_series_string = detected_series_string | append: 'Flexwell::' -%}
          {%- endunless -%}
        {%- endif -%}
        {%- if p_title_down contains 'basic' or p_tags_down contains 'basic' -%}
          {%- unless detected_series_string contains 'Basic' -%}
            {%- assign detected_series_string = detected_series_string | append: 'Basic::' -%}
          {%- endunless -%}
        {%- endif -%}
        {%- if p.metafields.custom.series != blank -%}
          {%- assign mf_series = p.metafields.custom.series.value | default: p.metafields.custom.series -%}
          {%- unless detected_series_string contains mf_series -%}
            {%- assign detected_series_string = detected_series_string | append: mf_series | append: '::' -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- assign detected_series_list = detected_series_string | split: '::' -%}

    <!-- 3. Reusable Category Navigation Pills (Exact Homepage Design) -->
    {%- if show_category_carousel -%}
    <div class="enamels-cat-carousel-wrap">
      
      <!-- Proper Heading Replacing "Select Category" (Fully Editable, Clearable, Removable) -->
      {%- assign has_carousel_head = false -%}
      {%- if show_carousel_heading -%}
        {%- if carousel_title != blank or carousel_subtitle != blank -%}
          {%- assign has_carousel_head = true -%}
        {%- endif -%}
      {%- endif -%}

      {%- if has_carousel_head -%}
        <div class="enamels-cat-carousel-header align-{{ carousel_head_align }}">
          <div class="enamels-cat-carousel-title-group">
            {%- if carousel_title != blank -%}
              <h2
                class="enamels-cat-carousel-title"
                style="color: {{ carousel_title_color }}; font-size: {{ carousel_title_size_desk }}px; font-weight: {{ carousel_title_weight }};"
              >
                {{ carousel_title | escape }}
              </h2>
            {%- endif -%}
            {%- if carousel_subtitle != blank -%}
              <p class="enamels-cat-carousel-subtitle">{{ carousel_subtitle | escape }}</p>
            {%- endif -%}
          </div>
          <div class="enamels-cat-carousel-arrows">
            <button type="button" class="enamels-carousel-btn prev-btn" aria-label="Previous Categories">‹</button>
            <button type="button" class="enamels-carousel-btn next-btn" aria-label="Next Categories">›</button>
          </div>
        </div>
      {%- else -%}
        <div class="enamels-cat-carousel-header-controls">
          <div class="enamels-cat-carousel-arrows">
            <button type="button" class="enamels-carousel-btn prev-btn" aria-label="Previous Categories">‹</button>
            <button type="button" class="enamels-carousel-btn next-btn" aria-label="Next Categories">›</button>
          </div>
        </div>
      {%- endif -%}

      <div class="enamels-cat-carousel enamels-cats-track" id="enamels-cat-carousel">
        {%- assign rendered_cat_pills = 0 -%}

        {%- comment -%} Numerical Sorting of Blocks via display_order {%- endcomment -%}
        {%- assign cat_pill_sort_string = '' -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'category_pill' or block.type == 'category_filter' -%}
            {%- if block.settings.show_pill != false -%}
              {%- assign b_order = block.settings.display_order | default: forloop.index -%}
              {%- if b_order < 10 -%}
                {%- assign pad_order = '0000' | append: b_order -%}
              {%- elsif b_order < 100 -%}
                {%- assign pad_order = '000' | append: b_order -%}
              {%- elsif b_order < 1000 -%}
                {%- assign pad_order = '00' | append: b_order -%}
              {%- else -%}
                {%- assign pad_order = b_order -%}
              {%- endif -%}
              {%- assign item_entry = pad_order | append: ':::' | append: block.id -%}
              {%- if cat_pill_sort_string == '' -%}
                {%- assign cat_pill_sort_string = item_entry -%}
              {%- else -%}
                {%- assign cat_pill_sort_string = cat_pill_sort_string | append: '|||' | append: item_entry -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if cat_pill_sort_string != '' -%}
          {%- assign sorted_cat_pill_items = cat_pill_sort_string | split: '|||' | sort -%}
          {%- for sort_item in sorted_cat_pill_items -%}
            {%- assign target_block_id = sort_item | split: ':::' | last -%}
            {%- assign cur_block = nil -%}
            {%- for b in section.blocks -%}
              {%- if b.id == target_block_id -%}
                {%- assign cur_block = b -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if cur_block != nil -%}
              {%- liquid
                assign pill_col = cur_block.settings.collection
                assign pill_name = cur_block.settings.title
                if pill_name == blank and pill_col != blank
                  assign pill_name = pill_col.title
                endif
                if pill_name == blank
                  assign pill_name = 'Category'
                endif

                assign pill_col_handle = ''
                if pill_col != blank
                  assign pill_col_handle = pill_col.handle | downcase
                endif
                assign pill_name_down = pill_name | downcase
                assign current_col_handle = target_col.handle | downcase

                # Collection Scope Isolation
                assign cur_scope = cur_block.settings.collection_scope | default: 'auto'
                assign should_render_pill = true

                if cur_block.settings.show_pill == false
                  assign should_render_pill = false
                elsif cur_scope == 'men_only'
                  unless current_col_handle == 'male-scrubs' or current_gender == 'men' or current_col_handle contains 'men'
                    assign should_render_pill = false
                  endunless
                elsif cur_scope == 'women_only'
                  unless current_col_handle == 'female-scrubs' or current_gender == 'women' or current_col_handle contains 'women'
                    assign should_render_pill = false
                  endunless
                elsif cur_scope == 'labcoats_only'
                  unless current_col_handle == 'labcoat' or current_col_handle contains 'lab'
                    assign should_render_pill = false
                  endunless
                elsif cur_scope == 'caps_only'
                  unless current_col_handle == 'surgical-caps' or current_col_handle contains 'cap'
                    assign should_render_pill = false
                  endunless
                elsif cur_scope == 'accessories_only'
                  unless current_col_handle == 'accessories' or current_col_handle == 'accessories-1' or current_col_handle == 'clogs' or current_col_handle == 'socks' or current_col_handle == 'sleeves'
                    assign should_render_pill = false
                  endunless
                elsif cur_scope == 'specific'
                  assign spec_handle = cur_block.settings.specific_collection_handle | downcase | strip
                  if spec_handle != blank and spec_handle != current_col_handle
                    assign should_render_pill = false
                  endif
                elsif cur_scope == 'auto'
                  # Smart Auto-Detection: Prevent cross-contamination
                  if current_col_handle == 'male-scrubs' or current_gender == 'men'
                    if pill_col_handle == 'female-scrubs' or pill_name_down contains 'women'
                      assign should_render_pill = false
                    endif
                  elsif current_col_handle == 'female-scrubs' or current_gender == 'women'
                    if pill_col_handle == 'male-scrubs' or pill_name_down contains 'men'
                      assign should_render_pill = false
                    endif
                  elsif current_col_handle == 'labcoat' or current_col_handle contains 'lab'
                    if pill_col_handle == 'male-scrubs' or pill_col_handle == 'female-scrubs' or pill_name_down contains 'scrub'
                      assign should_render_pill = false
                    endif
                  elsif current_col_handle == 'accessories' or current_col_handle == 'accessories-1' or current_col_handle == 'clogs' or current_col_handle == 'socks'
                    if pill_col_handle == 'male-scrubs' or pill_col_handle == 'female-scrubs' or pill_col_handle == 'labcoat'
                      assign should_render_pill = false
                    endif
                  elsif current_col_handle == 'surgical-caps'
                    if pill_col_handle == 'male-scrubs' or pill_col_handle == 'female-scrubs' or pill_col_handle == 'labcoat'
                      assign should_render_pill = false
                    endif
                  endif
                endif
              -%}

              {%- if should_render_pill -%}
                {%- liquid
                  assign pill_dest_url = cur_block.settings.link
                  if pill_dest_url == blank and pill_col != blank
                    assign pill_dest_url = pill_col.url
                  endif
                  if pill_dest_url == blank
                    assign pill_dest_url = routes.all_products_collection_url
                  endif

                  assign pill_sub = cur_block.settings.subtitle
                  
                  # Independent Custom Thumbnail (Never overridden by first product image!)
                  assign pill_img = cur_block.settings.image
                  if pill_img == blank and pill_col.featured_image != blank
                    assign pill_img = pill_col.featured_image
                  endif

                  assign pill_key = cur_block.settings.category_key
                  if pill_key == blank and pill_col != blank
                    assign pill_key = pill_col.handle
                  endif
                  if pill_key == blank
                    assign pill_key = pill_name | handleize
                  endif

                  assign is_active = false
                  if pill_col != blank and target_col != blank and target_col.handle == pill_col.handle
                    assign is_active = true
                  elsif request.path == pill_dest_url
                    assign is_active = true
                  endif

                  assign rendered_cat_pills = rendered_cat_pills | plus: 1

                # Advance payment tag text
                assign tag_text = cur_block.settings.advance_payment_tag_text | strip
                assign show_tag = false
                if cur_block.settings.show_advance_tag and tag_text != blank
                  assign show_tag = true
                elsif cur_block.settings.badge_text != blank
                  assign tag_text = cur_block.settings.badge_text | strip
                  assign show_tag = true
                endif

                # Display mode: image_cover (full-fill thumbnail), image_with_overlay, or text_with_thumb
                assign cur_mode = cur_block.settings.display_mode | default: 'default'
                if cur_mode == 'default' or cur_mode == blank
                  assign cur_mode = section.settings.pill_display_mode | default: 'image_cover'
                endif

                assign is_full_img_pill = false
                if cur_mode != 'text_with_thumb' and pill_img != blank
                  assign is_full_img_pill = true
                endif

                assign cur_img_fit = cur_block.settings.image_fit | default: 'inherit'
                if cur_img_fit == 'inherit' or cur_img_fit == blank
                  assign cur_img_fit = section.settings.pill_image_fit | default: 'cover'
                endif

                assign cur_img_pos = cur_block.settings.image_position | default: 'inherit'
                if cur_img_pos == 'inherit' or cur_img_pos == blank
                  assign cur_img_pos = section.settings.pill_image_position | default: 'center'
                endif
              -%}

              {%- if is_full_img_pill -%}
                <a
                  href="{{ pill_dest_url }}"
                  class="enamels-cat-card enamels-cat-card--carousel enamels-cat-card--full-image{% if is_active %} is-active{% endif %}"
                  data-category-target="{{ pill_key }}"
                  style="{% if cur_block.settings.card_bg != blank %}background-color: {{ cur_block.settings.card_bg }} !important;{% endif %}"
                  title="{{ pill_name | escape }}"
                  {{ cur_block.shopify_attributes }}
                >
                  {%- if show_tag -%}
                    <span class="enamels-cat-advance-tag" aria-label="{{ tag_text | escape }}">
                      {{ tag_text }}
                    </span>
                  {%- elsif cur_block.settings.badge_text != blank -%}
                    <span class="enamels-cat-card__badge">{{ cur_block.settings.badge_text }}</span>
                  {%- endif -%}

                  <img
                    src="{{ pill_img | image_url: width: 600 }}"
                    alt="{{ pill_name | escape }}"
                    class="enamels-cat-full-image"
                    loading="lazy"
                    width="240"
                    height="120"
                    style="object-fit: {{ cur_img_fit }} !important; object-position: {{ cur_img_pos }} !important;"
                  >

                  {%- if cur_mode == 'image_with_overlay' -%}
                    <div class="enamels-cat-card__overlay">
                      <span class="enamels-cat-card__overlay-title">{{ pill_name }}</span>
                      {%- if pill_sub != blank -%}
                        <span class="enamels-cat-card__overlay-subtitle">{{ pill_sub }}</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </a>
              {%- else -%}
                <a
                  href="{{ pill_dest_url }}"
                  class="enamels-cat-card enamels-cat-card--carousel{% if is_active %} is-active{% endif %}"
                  data-category-target="{{ pill_key }}"
                  style="{% if cur_block.settings.card_bg != blank %}background-color: {{ cur_block.settings.card_bg }} !important;{% endif %}"
                  title="{{ pill_name | escape }}"
                  {{ cur_block.shopify_attributes }}
                >
                  {%- if show_tag -%}
                    <span class="enamels-cat-advance-tag" aria-label="{{ tag_text | escape }}">
                      {{ tag_text }}
                    </span>
                  {%- elsif cur_block.settings.badge_text != blank -%}
                    <span class="enamels-cat-card__badge">{{ cur_block.settings.badge_text }}</span>
                  {%- endif -%}

                  <div class="enamels-cat-card__content">
                    <span class="enamels-cat-card__title">{{ pill_name }}</span>
                    {%- if pill_sub != blank -%}
                      <span class="enamels-cat-card__subtitle">{{ pill_sub }}</span>
                    {%- endif -%}
                  </div>

                  <div class="enamels-cat-card__media">
                    {%- if pill_img != blank -%}
                      <img
                        src="{{ pill_img | image_url: width: 320 }}"
                        alt="{{ pill_name | escape }}"
                        width="120"
                        height="70"
                        loading="lazy"
                        style="object-fit: {{ cur_img_fit }} !important; object-position: {{ cur_img_pos }} !important;"
                      >
                    {%- else -%}
                      <span class="enamels-cat-pill-btn__placeholder">🩺</span>
                    {%- endif -%}
                  </div>
                </a>
              {%- endif -%}
            {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- comment -%} Fallback to Custom Category Collections List {%- endcomment -%}
        {%- if rendered_cat_pills == 0 and section.settings.category_collections != blank -%}
          {%- for col in section.settings.category_collections -%}
            {%- assign cat_name = col.title -%}
            {%- assign cat_key = col.handle -%}
            {%- assign is_active = false -%}
            {%- if target_col != blank and target_col.handle == col.handle -%}
              {%- assign is_active = true -%}
            {%- endif -%}
            {%- assign rendered_cat_pills = rendered_cat_pills | plus: 1 -%}
            {%- assign fb_is_full = false -%}
            {%- if section.settings.pill_display_mode != 'text_with_thumb' and col.featured_image != blank -%}
              {%- assign fb_is_full = true -%}
            {%- endif -%}

            {%- if fb_is_full -%}
              <a
                href="{{ col.url }}"
                class="enamels-cat-card enamels-cat-card--carousel enamels-cat-card--full-image{% if is_active %} is-active{% endif %}"
                data-category-target="{{ cat_key }}"
                title="{{ cat_name | escape }}"
              >
                <img
                  src="{{ col.featured_image | image_url: width: 600 }}"
                  alt="{{ cat_name | escape }}"
                  class="enamels-cat-full-image"
                  width="240"
                  height="120"
                  loading="lazy"
                  style="object-fit: {{ section.settings.pill_image_fit | default: 'cover' }} !important; object-position: {{ section.settings.pill_image_position | default: 'center' }} !important;"
                >
              </a>
            {%- else -%}
              <a
                href="{{ col.url }}"
                class="enamels-cat-card enamels-cat-card--carousel{% if is_active %} is-active{% endif %}"
                data-category-target="{{ cat_key }}"
              >
                <div class="enamels-cat-card__content">
                  <span class="enamels-cat-card__title">{{ cat_name }}</span>
                  <span class="enamels-cat-card__subtitle">Collection</span>
                </div>
                <div class="enamels-cat-card__media">
                  {%- if col.featured_image != blank -%}
                    <img src="{{ col.featured_image | image_url: width: 320 }}" alt="{{ cat_name | escape }}" width="120" height="70" loading="lazy">
                  {%- else -%}
                    <span class="enamels-cat-pill-btn__placeholder">🩺</span>
                  {%- endif -%}
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if section.settings.show_view_all_pill -%}
          <!-- Universal "View All" Pill -->
          <a
            href="/collections/all"
            class="enamels-cat-card enamels-cat-card--carousel{% if current_cat == 'all' and is_specific_col == false and request.path == '/collections/all' %} is-active{% endif %}"
            data-category-target="all"
          >
            <div class="enamels-cat-card__content">
              <span class="enamels-cat-card__title">ALL APPAREL</span>
              <span class="enamels-cat-card__subtitle">Complete Store</span>
            </div>
            <div class="enamels-cat-card__media enamels-view-all-thumb">
              <span class="enamels-all-grid-icon">▦</span>
            </div>
          </a>
        {%- endif -%}
      </div>
    </div>
    {%- endif -%}

    <!-- 4. Dynamic Article Sub-Filter Bar (Under Scrubs) -->
    {%- if show_article_filter and detected_series_list.size > 0 -%}
      <div class="enamels-article-filters style-{{ article_box_style }}" id="enamels-article-filters">
        {%- if show_article_heading and article_heading_text != blank -%}
          <span class="enamels-article-filters__label">
            {{ article_heading_text }}
          </span>
        {%- endif -%}
        <div class="enamels-article-filters__list">
          <button
            type="button"
            class="enamels-article-pill{% if current_article == 'all' %} is-active{% endif %}"
            data-article-target="all"
          >
            {{ article_all_lbl }}
          </button>
          {%- for s in detected_series_list -%}
            {%- if s != blank -%}
              {%- assign s_clean = s | strip -%}
              {%- assign s_handle = s_clean | downcase | replace: ' ', '-' -%}
              <button
                type="button"
                class="enamels-article-pill{% if current_article == s_handle %} is-active{% endif %}"
                data-article-target="{{ s_handle }}"
              >
                {{ s_clean }} Series
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <!-- 5. Collection Heading & Active Counter Bar (Fully Editable) -->
    {%- if show_collection_header -%}
      <div class="enamels-cat-page__head-row align-{{ heading_align }}">
        <div class="enamels-cat-page__head">
          {%- if title_text != blank -%}
            <h1
              class="enamels-cat-page__title"
              id="enamels-cat-page-title"
              style="font-size: {{ heading_size_desk }}px; color: {{ heading_color }};"
            >
              {{ title_text }}
            </h1>
          {%- endif -%}
          {%- if show_collection_desc and sec_desc != blank -%}
            <div class="enamels-cat-page__desc">
              {{ sec_desc }}
            </div>
          {%- endif -%}
          {%- if section.settings.show_product_count -%}
            <p class="enamels-cat-page__counter" id="enamels-cat-product-counter">Showing products</p>
          {%- endif -%}
        </div>
        <button type="button" class="enamels-cat-clear-btn" id="enamels-clear-filter-btn" style="display: none;">
          Clear Filters ✕
        </button>
      </div>
    {%- endif -%}

    <!-- 6. Real Product Cards Grid (Fully Editable Layout) -->
    <div class="enamels-cat-page__grid" id="enamels-cat-product-grid">

      {%- assign rendered_count = 0 -%}
      {%- paginate target_col.products by prods_per_page -%}
        {%- if target_col.products.size > 0 -%}
          {%- for prod in target_col.products -%}
            {%- liquid
              assign rendered_count = rendered_count | plus: 1
              assign prod_title_lower = prod.title | downcase
              assign prod_type_lower = prod.type | downcase
              assign prod_tags_string = prod.tags | join: ' ' | downcase
              assign prod_vendor_lower = prod.vendor | downcase

              # Gender Detection via Genuine Collection Membership & Metadata
              assign is_men = false
              assign is_women = false
              assign is_unisex = false

              for col_item in prod.collections
                if col_item.handle contains 'male' or col_item.handle contains 'men'
                  assign is_men = true
                elsif col_item.handle contains 'female' or col_item.handle contains 'women'
                  assign is_women = true
                endif
              endfor

              if prod_tags_string contains 'unisex' or prod_title_lower contains 'unisex'
                assign is_unisex = true
              endif

              if is_men == false
                assign cleaned_tags_men = prod_tags_string | replace: 'women', ''
                assign cleaned_title_men = prod_title_lower | replace: 'women', ''
                if cleaned_tags_men contains 'men' or cleaned_title_men contains 'men' or prod_tags_string contains 'male' or prod_title_lower contains 'male'
                  assign is_men = true
                endif
              endif

              if is_women == false
                if prod_tags_string contains 'women' or prod_title_lower contains 'women' or prod_tags_string contains 'female' or prod_title_lower contains 'female' or prod_tags_string contains 'ladies' or prod_title_lower contains 'ladies'
                  assign is_women = true
                endif
              endif

              if collection.handle contains 'male' or collection.handle contains 'men'
                assign is_men = true
                assign is_women = false
                assign is_unisex = false
              elsif collection.handle contains 'female' or collection.handle contains 'women'
                assign is_women = true
                assign is_men = false
                assign is_unisex = false
              elsif is_men == false and is_women == false
                assign is_unisex = true
              endif

              # Category Detection
              assign prod_cat = 'scrubs'
              if prod_type_lower contains 'lab' or prod_tags_string contains 'lab coat' or prod_title_lower contains 'lab coat'
                assign prod_cat = 'lab-coats'
              elsif prod_type_lower contains 'white' or prod_tags_string contains 'white coat' or prod_title_lower contains 'white coat'
                assign prod_cat = 'white-coats'
              elsif prod_type_lower contains 'cap' or prod_tags_string contains 'cap' or prod_title_lower contains 'cap' or prod_title_lower contains 'bunfit'
                assign prod_cat = 'caps'
              elsif prod_type_lower contains 'sleeve' or prod_tags_string contains 'sleeve' or prod_title_lower contains 'sleeve'
                assign prod_cat = 'sleeves'
              elsif prod_type_lower contains 'access' or prod_tags_string contains 'accessory' or prod_tags_string contains 'accessories' or prod_title_lower contains 'clog' or prod_title_lower contains 'mask' or prod_title_lower contains 'badge'
                assign prod_cat = 'accessories'
              endif

              # Article / Series Detection
              assign prod_article = 'other'
              assign prod_series_display = ''
              for s in detected_series_list
                if s != blank
                  assign s_clean = s | strip
                  assign s_h = s_clean | downcase | replace: ' ', '-'
                  assign s_down = s_clean | downcase
                  if prod_title_lower contains s_down or prod_tags_string contains s_down
                    assign prod_article = s_h
                    assign prod_series_display = s_clean | append: ' Series'
                    break
                  endif
                endif
              endfor

              # Color Options & Swatches
              assign color_values = ''
              for option in prod.options_with_values
                assign opt_name_lower = option.name | downcase
                if opt_name_lower contains 'color' or opt_name_lower contains 'colour'
                  assign color_values = option.values
                  break
                endif
              endfor
            -%}

            <div
              class="enamels-col-card"
              data-product-id="{{ prod.id }}"
              data-gender="{% if is_unisex %}unisex{% elsif is_men and is_women %}unisex{% elsif is_men %}men{% elsif is_women %}women{% else %}unisex{% endif %}"
              data-category="{{ prod_cat }}"
              data-article="{{ prod_article }}"
              data-title="{{ prod.title | escape }}"
              data-price="{{ prod.price }}"
            >
              <a href="{{ prod.url }}" class="enamels-col-card__link">
                <!-- Standardized 1200x1800 (2:3 Portrait) Media Frame -->
                <div class="enamels-col-card__media">
                  {% if prod.featured_media != blank %}
                    <img
                      src="{{ prod.featured_media | image_url: width: 600 }}"
                      srcset="{{ prod.featured_media | image_url: width: 360 }} 360w, {{ prod.featured_media | image_url: width: 600 }} 600w, {{ prod.featured_media | image_url: width: 900 }} 900w"
                      sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 16vw"
                      alt="{{ prod.featured_media.alt | default: prod.title | escape }}"
                      loading="lazy"
                      width="300"
                      height="450"
                      class="enamels-col-card__primary-img"
                    >
                    {% if show_secondary_img and prod.media.size > 1 %}
                      <img
                        src="{{ prod.media[1] | image_url: width: 600 }}"
                        alt="{{ prod.title | escape }}"
                        loading="lazy"
                        width="300"
                        height="450"
                        class="enamels-col-card__secondary-img"
                      >
                    {% endif %}
                  {% else %}
                    <div class="enamels-col-card__placeholder">
                      <span>Enamels</span>
                    </div>
                  {% endif %}

                  {% if show_sale_badges and prod.compare_at_price > prod.price %}
                    {% assign discount_pct = prod.compare_at_price | minus: prod.price | times: 100.0 | divided_by: prod.compare_at_price | round %}
                    <span class="enamels-col-card__badge-sale">SAVE {{ discount_pct }}%</span>
                  {% endif %}
                </div>

                <div class="enamels-col-card__info">
                  {% if prod_series_display != blank %}
                    <span class="enamels-col-card__series">
                      {{ prod_series_display }}
                    </span>
                  {% else %}
                    <span class="enamels-col-card__series enamels-col-card__series--empty">&nbsp;</span>
                  {% endif %}

                  {% if show_prod_title %}
                    <span class="enamels-col-card__title">{{ prod.title | escape }}</span>
                  {% endif %}

                  {% if show_prod_price %}
                    <div class="enamels-col-card__price-row">
                      <span class="enamels-col-card__price">{{ prod.price | money_without_trailing_zeros }}</span>
                      {% if prod.compare_at_price > prod.price %}
                        <span class="enamels-col-card__compare-price">{{ prod.compare_at_price | money_without_trailing_zeros }}</span>
                      {% endif %}
                    </div>
                  {% endif %}

                  {% if show_swatches and color_values != blank and color_values.size > 0 %}
                    <div class="enamels-col-card__swatches" title="{{ color_values.size }} colors available">
                      {% for color in color_values limit: 5 %}
                        {%- liquid
                          assign c_lower = color | downcase
                          assign hex = '#0f172a'
                          if c_lower contains 'navy' or c_lower contains 'dark blue'
                            assign hex = '#0f172a'
                          elsif c_lower contains 'royal' or c_lower contains 'blue'
                            assign hex = '#1d4ed8'
                          elsif c_lower contains 'ceil' or c_lower contains 'sky' or c_lower contains 'light blue'
                            assign hex = '#7dd3fc'
                          elsif c_lower contains 'caribbean' or c_lower contains 'aqua'
                            assign hex = '#0284c7'
                          elsif c_lower contains 'black'
                            assign hex = '#18181b'
                          elsif c_lower contains 'white'
                            assign hex = '#ffffff'
                          elsif c_lower contains 'grey' or c_lower contains 'gray' or c_lower contains 'heather'
                            assign hex = '#64748b'
                          elsif c_lower contains 'burgundy' or c_lower contains 'maroon' or c_lower contains 'wine'
                            assign hex = '#831843'
                          elsif c_lower contains 'hunter' or c_lower contains 'forest' or c_lower contains 'dark green'
                            assign hex = '#14532d'
                          elsif c_lower contains 'olive'
                            assign hex = '#4d7c0f'
                          elsif c_lower contains 'teal' or c_lower contains 'peacock'
                            assign hex = '#0f766e'
                          elsif c_lower contains 'sage' or c_lower contains 'sea green'
                            assign hex = '#10b981'
                          elsif c_lower contains 'purple' or c_lower contains 'plum'
                            assign hex = '#581c87'
                          elsif c_lower contains 'pink' or c_lower contains 'rose'
                            assign hex = '#f43f5e'
                          elsif c_lower contains 'rust' or c_lower contains 'terracotta'
                            assign hex = '#c2410c'
                          elsif c_lower contains 'sand' or c_lower contains 'khaki' or c_lower contains 'beige'
                            assign hex = '#d97706'
                          endif
                        -%}
                        <span class="enamels-swatch-dot" style="background-color: {{ hex }};" title="{{ color | escape }}"></span>
                      {% endfor %}
                      {% if color_values.size > 5 %}
                        <span class="enamels-swatch-more">+{{ color_values.size | minus: 5 }}</span>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </a>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="enamels-cat-empty-wrap" style="grid-column: 1 / -1; padding: 48px 16px; text-align: center;">
            <p style="font-size: 16px; color: #64748b; margin-bottom: 16px;">No products found in this collection.</p>
            <a href="/collections/all" class="enamels-cat-empty__btn" style="display: inline-block; padding: 10px 24px; background: #102a43; color: #fff; border-radius: 8px; text-decoration: none; font-weight: 700;">Explore All Apparel</a>
          </div>
        {%- endif -%}

        <!-- Filter-Specific Zero Results Notice -->
        <div class="enamels-cat-empty" id="enamels-cat-empty-notice" style="display: none; grid-column: 1 / -1;">
          <div class="enamels-cat-empty__box">
            <span class="enamels-cat-empty__icon">🩺</span>
            <h3 class="enamels-cat-empty__title">No Medical Apparel Found</h3>
            <p class="enamels-cat-empty__text">We couldn't find products matching your exact filter combination.</p>
            <button type="button" class="enamels-cat-empty__btn" id="enamels-cat-reset-btn">Reset All Filters</button>
          </div>
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="enamels-cat-pagination" style="grid-column: 1 / -1; margin-top: 32px; display: flex; justify-content: center;">
            {{ paginate | default_pagination }}
          </div>
        {%- endif -%}

      {%- endpaginate -%}

    </div>

  </div>
</div>

<script>
  (function initEnamelsCategoryBrowsingFlow() {
    var container = document.getElementById('enamels-cat-page-{{ section.id }}');
    if (!container) return;

    var state = {
      gender: container.getAttribute('data-initial-gender') || 'all',
      category: container.getAttribute('data-initial-category') || 'all',
      article: container.getAttribute('data-initial-article') || 'all'
    };

    function readUrlParams() {
      try {
        var params = new URLSearchParams(window.location.search);
        var g = params.get('gender') || params.get('category');
        if (g && (g === 'men' || g === 'women')) {
          state.gender = g;
        } else if (window.location.pathname.indexOf('men') !== -1 && window.location.pathname.indexOf('women') === -1) {
          state.gender = 'men';
        } else if (window.location.pathname.indexOf('women') !== -1) {
          state.gender = 'women';
        }

        var cat = params.get('cat');
        if (cat) {
          state.category = cat;
        }

        var art = params.get('article');
        if (art) {
          state.article = art;
        }
      } catch(e) {}
    }

    function updateUrlState() {
      try {
        var params = new URLSearchParams(window.location.search);
        if (state.gender && state.gender !== 'all') {
          params.set('gender', state.gender);
        } else {
          params.delete('gender');
        }

        if (state.category && state.category !== 'all') {
          params.set('cat', state.category);
        } else {
          params.delete('cat');
        }

        if (state.article && state.article !== 'all') {
          params.set('article', state.article);
        } else {
          params.delete('article');
        }

        var newUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
        window.history.replaceState({ ...state }, '', newUrl);
      } catch(e) {}
    }

    function renderFilterUI() {
      // 1. Gender Tabs UI
      var genderTabs = container.querySelectorAll('.enamels-gender-tab');
      genderTabs.forEach(function(tab) {
        var target = tab.getAttribute('data-gender-target');
        if (target === state.gender) {
          tab.classList.add('is-active');
        } else {
          tab.classList.remove('is-active');
        }
      });

      // 2. Article Sub-Filter Bar Visibility & Active State
      var articleBar = container.querySelector('#enamels-article-filters');
      if (articleBar) {
        if (state.category === 'scrubs' || state.category === 'all') {
          articleBar.style.display = 'flex';
          var pills = articleBar.querySelectorAll('.enamels-article-pill');
          pills.forEach(function(pill) {
            var target = pill.getAttribute('data-article-target');
            if (target === state.article) {
              pill.classList.add('is-active');
            } else {
              pill.classList.remove('is-active');
            }
          });
        } else {
          articleBar.style.display = 'none';
        }
      }

      // 3. Filter Product Cards if on general page with article filters
      var cards = container.querySelectorAll('.enamels-col-card');
      var isSpecificCollection = container.getAttribute('data-is-specific-collection') === 'true';
      var visibleCount = 0;

      cards.forEach(function(card) {
        var cardGender = card.getAttribute('data-gender') || 'unisex';
        var cardCategory = card.getAttribute('data-category') || 'scrubs';
        var cardArticle = card.getAttribute('data-article') || 'other';

        var matchGender = true;
        if (!isSpecificCollection) {
          if (state.gender === 'all') {
            matchGender = true;
          } else if (state.gender === 'men') {
            matchGender = (cardGender === 'men');
          } else if (state.gender === 'women') {
            matchGender = (cardGender === 'women');
          }
        }

        var matchCat = true;
        if (state.category !== 'all' && cardCategory !== state.category) {
          matchCat = false;
        }

        var matchArticle = true;
        if (state.article !== 'all' && cardArticle !== state.article) {
          matchArticle = false;
        }

        if (matchGender && matchCat && matchArticle) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      var counterEl = container.querySelector('#enamels-cat-product-counter');
      if (counterEl) {
        counterEl.textContent = 'Showing ' + visibleCount + ' ' + (visibleCount === 1 ? 'product' : 'products');
      }

      var emptyEl = container.querySelector('#enamels-cat-empty-notice');
      if (emptyEl) {
        emptyEl.style.display = (visibleCount === 0) ? 'block' : 'none';
      }

      var clearBtn = container.querySelector('#enamels-clear-filter-btn');
      var hasFilter = (state.gender !== 'all' || state.category !== 'all' || state.article !== 'all');
      if (clearBtn) {
        clearBtn.style.display = hasFilter ? 'inline-flex' : 'none';
      }
    }

    function setupEventListeners() {
      // Gender tabs
      var genderTabs = container.querySelectorAll('.enamels-gender-tab');
      genderTabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          var targetGender = tab.getAttribute('data-gender-target') || 'all';
          if (targetGender === 'men' && !window.location.pathname.includes('/male-scrubs')) {
            window.location.href = '/collections/male-scrubs';
            return;
          } else if (targetGender === 'women' && !window.location.pathname.includes('/female-scrubs')) {
            window.location.href = '/collections/female-scrubs';
            return;
          } else if (targetGender === 'all' && window.location.pathname !== '/collections/all') {
            window.location.href = '/collections/all';
            return;
          }
          state.gender = targetGender;
          updateUrlState();
          renderFilterUI();
        });
      });

      // Article pills
      var pills = container.querySelectorAll('.enamels-article-pill');
      pills.forEach(function(pill) {
        pill.addEventListener('click', function() {
          state.article = pill.getAttribute('data-article-target') || 'all';
          updateUrlState();
          renderFilterUI();
        });
      });

      // Clear filter button & empty reset button
      var clearBtn = container.querySelector('#enamels-clear-filter-btn');
      var resetBtn = container.querySelector('#enamels-cat-reset-btn');
      function resetAllFilters() {
        state.category = 'all';
        state.article = 'all';
        updateUrlState();
        renderFilterUI();
      }
      if (clearBtn) clearBtn.addEventListener('click', resetAllFilters);
      if (resetBtn) resetBtn.addEventListener('click', resetAllFilters);

      // Category carousel arrow scrolling
      var carousel = container.querySelector('#enamels-cat-carousel');
      var prevBtn = container.querySelector('.enamels-carousel-btn.prev-btn');
      var nextBtn = container.querySelector('.enamels-carousel-btn.next-btn');

      if (carousel) {
        if (prevBtn) {
          prevBtn.addEventListener('click', function() {
            carousel.scrollBy({ left: -260, behavior: 'smooth' });
          });
        }
        if (nextBtn) {
          nextBtn.addEventListener('click', function() {
            carousel.scrollBy({ left: 260, behavior: 'smooth' });
          });
        }

        // Mouse Drag to Scroll
        var isDown = false;
        var startX = 0;
        var scrollStart = 0;
        var hasMoved = false;

        carousel.addEventListener('mousedown', function(e) {
          if (e.button !== 0) return;
          isDown = true;
          hasMoved = false;
          startX = e.pageX - carousel.offsetLeft;
          scrollStart = carousel.scrollLeft;
          carousel.style.cursor = 'grabbing';
          carousel.style.userSelect = 'none';
        });

        var stopDrag = function() {
          if (!isDown) return;
          isDown = false;
          carousel.style.cursor = 'grab';
          carousel.style.userSelect = '';
          setTimeout(function() { hasMoved = false; }, 100);
        };

        window.addEventListener('mouseup', stopDrag);
        carousel.addEventListener('mouseleave', stopDrag);

        carousel.addEventListener('mousemove', function(e) {
          if (!isDown) return;
          var currentX = e.pageX - carousel.offsetLeft;
          var walk = (currentX - startX) * 1.3;
          if (Math.abs(walk) > 4) {
            hasMoved = true;
          }
          carousel.scrollLeft = scrollStart - walk;
        });

        carousel.addEventListener('click', function(e) {
          if (hasMoved) {
            e.preventDefault();
            e.stopPropagation();
            return false;
          }
        }, true);
      }
    }

    readUrlParams();
    setupEventListeners();
    renderFilterUI();

    window.addEventListener('popstate', function() {
      readUrlParams();
      renderFilterUI();
    });
  })();
</script>

