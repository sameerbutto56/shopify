      const activeFabLabel = document.getElementById('rtw-active-fabric-label');
      if (activeFabLabel) activeFabLabel.textContent = name;

      // Refresh available colors for this fabric
      renderRtwColorsForFabric(id);
      window.jumpRtwStep(2);
