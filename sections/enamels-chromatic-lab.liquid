      STATE.pdpCompletedSteps.add('size');

      renderPdpStepper();
      recalculatePdpSummary();

      const unit = STATE.pdpCustomMeasurements.unit;
      alert(`Custom measurements confirmed: Chest ${chest}${unit}, Waist ${waist}${unit}, Hips ${hips}${unit}, Inseam ${inseam}${unit}`);
