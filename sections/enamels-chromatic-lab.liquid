<!-- ============================================================ -->
<!-- 9. SCRIPT ENGINE (PHASES 1 TO 5 COMPLETE INTERACTIVE LOGIC)  -->
<!-- ============================================================ -->
<script>
  (function() {
    // --- STATE MANAGEMENT ---
    let currentSlide = 0;
    let slideTimer = null;
    let slidePaused = false;
    const totalSlides = 5;

    let pdpCurrentProduct = null;
    let pdpSelectedColor = { name: 'Deep Midnight Navy', hex: '#0B1224', image: 'demo-sprinter-navy.jpg' };
    let pdpSelectedSize = 'M';
    let pdpIsCustomSize = false;
    let pdpCustomMeasurements = { chest: 40, waist: 34, hips: 41, shoulder: 18, sleeve: 9, topLength: 29, inseam: 31, trouserWaist: 33, unit: 'in' };
    let pdpCustomTier = 'none';
    let pdpDoctorName = 'Dr. Sarah Khan, MD';
    let pdpDoctorDept = 'Department of Cardiology';
    let pdpThreadColor = '#FFFFFF';
    let pdpPlacement = 'Left Chest Pocket';
    let pdpStudioQty = 1;

    // --- INITIALIZATION ---
    document.addEventListener('DOMContentLoaded', initChromaticStorefront);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(initChromaticStorefront, 50);
    }

    function initChromaticStorefront() {
      initSlideshow();
      renderHomeChromaGrid();
      updateHeaderBadges();
      handleHashNavigation();
      window.addEventListener('hashchange', handleHashNavigation);
    }

    // --- 1. SLIDESHOW BANNER CONTROLLER ---
    function initSlideshow() {
      startSlideTimer();
    }

    function startSlideTimer() {
      if (slideTimer) clearInterval(slideTimer);
      slideTimer = setInterval(() => {
        if (!slidePaused) {
          window.nextSlide();
        }
      }, 5500);
    }

    window.goToSlide = function(idx) {
      const slides = document.querySelectorAll('.slide-item');
      const dots = document.querySelectorAll('.dot-btn');
      if (!slides.length) return;

      currentSlide = (idx + totalSlides) % totalSlides;
      slides.forEach((s, i) => s.classList.toggle('active', i === currentSlide));
      dots.forEach((d, i) => d.classList.toggle('active', i === currentSlide));
    };

    window.nextSlide = function() { window.goToSlide(currentSlide + 1); };
    window.prevSlide = function() { window.goToSlide(currentSlide - 1); };

    window.toggleSlidePause = function() {
      slidePaused = !slidePaused;
      const btn = document.getElementById('slide-pause-btn');
      if (btn) btn.textContent = slidePaused ? '▶' : '⏸';
    };

    // --- 2. ROUTING & VIEW NAVIGATION ---
    window.navigateToView = function(viewId) {
      document.querySelectorAll('.chroma-view-panel').forEach(p => p.classList.remove('active'));
      const target = document.getElementById(`view-${viewId}`);
      if (target) {
        target.classList.add('active');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    };

    window.navigateToCollection = function(seriesOrCat, type = 'series') {
      window.navigateToView('collection');
      const titleEl = document.getElementById('collection-view-title');
      const descEl = document.getElementById('collection-view-desc');
      const breadEl = document.getElementById('collection-view-breadcrumb');
      const badgeEl = document.getElementById('collection-view-badge');

      if (type === 'series') {
        if (titleEl) titleEl.textContent = `${seriesOrCat} Series Scrubs`;
        if (breadEl) breadEl.textContent = `${seriesOrCat} Series`;
        if (badgeEl) badgeEl.textContent = `PROPRIETARY ${seriesOrCat.toUpperCase()} ARCHITECTURE`;
      } else if (type === 'category') {
        const catName = seriesOrCat === 'caps' ? 'Surgical Caps (BunFit™)' : seriesOrCat === 'lab-coat' ? 'Medical Lab Coats' : 'Accessories';
        if (titleEl) titleEl.textContent = catName;
        if (breadEl) breadEl.textContent = catName;
        if (badgeEl) badgeEl.textContent = 'CLINICAL SPECIFICATION';
      } else if (type === 'feature') {
        if (titleEl) titleEl.textContent = seriesOrCat === 'wrinkle-free' ? 'Wrinkle-Free Technical Series' : 'Medical Compression Sleeves';
        if (breadEl) breadEl.textContent = seriesOrCat === 'wrinkle-free' ? 'Wrinkle Free' : 'Sleeves';
        if (badgeEl) badgeEl.textContent = 'HIGH-PERFORMANCE TEXTILES';
      }

      window.currentFilterSeries = seriesOrCat;
      window.currentFilterType = type;
      renderCollectionView();
    };

    function handleHashNavigation() {
      const hash = window.location.hash;
      if (hash === '#category-scrubs') {
        window.navigateToView('category-scrubs');
      } else if (hash.startsWith('#collection-')) {
        const target = hash.replace('#collection-', '');
        if (['sprinter', 'velora', 'crown'].includes(target)) {
          window.navigateToCollection(target.charAt(0).toUpperCase() + target.slice(1), 'series');
        } else if (['caps', 'lab-coats', 'accessories'].includes(target)) {
          window.navigateToCollection(target === 'lab-coats' ? 'lab-coat' : target, 'category');
        } else {
          window.navigateToCollection(target, 'feature');
        }
      } else if (hash.startsWith('#product-')) {
        const prodId = hash.replace('#product-', '');
        window.openEnamelsPdpModal(prodId);
      }
    }

    // --- 3. PRODUCT DETAIL & CONFIGURATOR STUDIO (PHASES 3 & 4) ---
    window.openEnamelsPdpModal = function(productId, focusTab = 'all') {
      const catalogue = window.EnamelsCatalogue || [];
      const item = catalogue.find(p => p.id === productId) || catalogue[0];
      if (!item) return;

      pdpCurrentProduct = item;
      pdpSelectedColor = item.colors[0] || { name: 'Deep Midnight Navy', hex: '#0B1224', image: item.image };
      pdpSelectedSize = item.sizes[0] || 'M';
      pdpIsCustomSize = false;
      pdpCustomTier = 'none';
      pdpStudioQty = 1;

      // Populate text fields
      const titleEl = document.getElementById('pdp-title-display');
      const skuEl = document.getElementById('pdp-sku-display');
      const priceEl = document.getElementById('pdp-base-price-display');
      const descEl = document.getElementById('pdp-desc-display');
      const breadEl = document.getElementById('pdp-breadcrumb-title');

      if (titleEl) titleEl.textContent = item.title;
      if (skuEl) skuEl.textContent = `SKU: ${item.sku}`;
      if (priceEl) priceEl.textContent = `Rs. ${item.basePrice.toLocaleString()}`;
      if (descEl) descEl.textContent = item.description;
      if (breadEl) breadEl.textContent = item.title;

      // Reset image and stage
      window.setPdpImage(item.image);
      window.selectPdpColor(pdpSelectedColor.hex, pdpSelectedColor.name, item.image);

      // Open View
      window.navigateToView('product-studio');

      if (focusTab === 'custom') {
        const radio = document.querySelector('input[name="custom_type"][value="direct_embroidery"]');
        if (radio) { radio.checked = true; window.updateCustomizationTier('direct_embroidery'); }
      } else if (focusTab === 'color') {
        const colorCard = document.querySelector('.pdp-chroma-swatches-grid');
        if (colorCard) colorCard.scrollIntoView({ behavior: 'smooth' });
      }

      recalculateStudioTotals();
    };

    window.setPdpImage = function(imgName) {
      const photoEl = document.getElementById('pdp-active-photo');
      if (photoEl) photoEl.src = `{{ '' | asset_url }}${imgName}`;
    };

    // Color Selection
    window.selectPdpColor = function(hex, name, img) {
      pdpSelectedColor = { name, hex, image: img };
      const badge = document.getElementById('pdp-active-color-badge');
      const title = document.getElementById('pdp-selected-color-title');
      const pocketBg = document.getElementById('pocket-canvas-bg');

      if (badge) {
        badge.textContent = name;
        badge.style.backgroundColor = hex;
        badge.style.color = (hex === '#0B1224' || hex === '#18181B' || hex === '#581C87') ? '#FFFFFF' : '#0B1224';
      }
      if (title) title.textContent = name;
      if (pocketBg) pocketBg.style.backgroundColor = hex;

      document.querySelectorAll('.pdp-swatch-chip').forEach(c => {
        c.classList.toggle('active', c.dataset.name === name);
      });
      window.setPdpImage(img);
    };

    // Standard Size Selection
    window.selectStandardSize = function(size) {
      pdpSelectedSize = size;
      pdpIsCustomSize = false;
      document.querySelectorAll('.size-pill').forEach(b => b.classList.toggle('active', b.textContent.trim() === size));
      const customPanel = document.getElementById('custom-size-studio-panel');
      if (customPanel) customPanel.style.display = 'none';
      recalculateStudioTotals();
    };

    // Custom Size Studio Toggle
    window.toggleCustomSizePanel = function() {
      const panel = document.getElementById('custom-size-studio-panel');
      if (!panel) return;
      const isVisible = panel.style.display !== 'none';
      panel.style.display = isVisible ? 'none' : 'block';
      pdpIsCustomSize = !isVisible;
      if (pdpIsCustomSize) {
        document.querySelectorAll('.size-pill').forEach(b => b.classList.remove('active'));
      }
      recalculateStudioTotals();
    };

    window.switchSizeTab = function(tabId) {
      document.querySelectorAll('.size-tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.size-tab-content').forEach(c => c.style.display = 'none');
      const activeBtn = document.getElementById(`tab-btn-${tabId}`);
      const activeContent = document.getElementById(`size-tab-${tabId}`);
      if (activeBtn) activeBtn.classList.add('active');
      if (activeContent) activeContent.style.display = 'block';
    };

    window.updateMeasurementUnit = function(unit) {
      pdpCustomMeasurements.unit = unit;
      document.querySelectorAll('.unit-label').forEach(el => el.textContent = unit);
    };

    window.validateMeasurements = function() {
      const chest = parseFloat(document.getElementById('meas-chest')?.value) || 0;
      const waist = parseFloat(document.getElementById('meas-waist')?.value) || 0;
      const inseam = parseFloat(document.getElementById('meas-inseam')?.value) || 0;

      let valid = true;
      const errChest = document.getElementById('err-meas-chest');
      const errWaist = document.getElementById('err-meas-waist');
      const errInseam = document.getElementById('err-meas-inseam');

      if (chest < 28 || chest > 65) { if (errChest) errChest.textContent = 'Chest must be between 28-65'; valid = false; } else if (errChest) errChest.textContent = '';
      if (waist < 22 || waist > 60) { if (errWaist) errWaist.textContent = 'Waist must be between 22-60'; valid = false; } else if (errWaist) errWaist.textContent = '';
      if (inseam < 20 || inseam > 40) { if (errInseam) errInseam.textContent = 'Inseam must be between 20-40'; valid = false; } else if (errInseam) errInseam.textContent = '';

      return valid;
    };

    window.confirmCustomMeasurements = function() {
      if (window.validateMeasurements()) {
        pdpIsCustomSize = true;
        pdpCustomMeasurements.chest = parseFloat(document.getElementById('meas-chest').value);
        pdpCustomMeasurements.waist = parseFloat(document.getElementById('meas-waist').value);
        pdpCustomMeasurements.hips = parseFloat(document.getElementById('meas-hips').value);
        pdpCustomMeasurements.inseam = parseFloat(document.getElementById('meas-inseam').value);
        alert('Custom measurements validated and saved for this scrub set!');
        recalculateStudioTotals();
      }
    };

    // Customization Tier Update
    window.updateCustomizationTier = function(tier) {
      pdpCustomTier = tier;
      document.querySelectorAll('.custom-radio-card').forEach(c => {
        const input = c.querySelector('input');
        c.classList.toggle('active', input && input.value === tier);
      });

      const inputsBox = document.getElementById('custom-inputs-box');
      const pocketBox = document.getElementById('pocket-preview-box');

      if (tier === 'none') {
        if (inputsBox) inputsBox.style.display = 'none';
        if (pocketBox) pocketBox.style.display = 'none';
      } else {
        if (inputsBox) inputsBox.style.display = 'block';
        if (pocketBox) pocketBox.style.display = 'block';
      }

      recalculateStudioTotals();
    };

    window.updatePocketPreviewText = function() {
      const name = document.getElementById('input-doctor-name')?.value || 'DR. SARAH KHAN, MD';
      const dept = document.getElementById('input-doctor-dept')?.value || 'DEPARTMENT OF CARDIOLOGY';
      pdpDoctorName = name;
      pdpDoctorDept = dept;
      pdpPlacement = document.getElementById('select-embroidery-placement')?.value || 'Left Chest Pocket';

      const nameEl = document.getElementById('pocket-doctor-name');
      const deptEl = document.getElementById('pocket-doctor-dept');
      if (nameEl) nameEl.textContent = name.toUpperCase();
      if (deptEl) deptEl.textContent = dept.toUpperCase();
    };

    window.updateThreadColor = function(color) {
      pdpThreadColor = color;
      const nameEl = document.getElementById('pocket-doctor-name');
      const deptEl = document.getElementById('pocket-doctor-dept');
      const ind = document.getElementById('pocket-thread-indicator');

      if (nameEl) nameEl.style.color = color;
      if (deptEl) deptEl.style.color = color;
      if (ind) ind.textContent = `Thread: ${color === '#FFFFFF' ? 'White' : color === '#D4AF37' ? 'Gold' : color === '#C0C0C0' ? 'Silver' : 'Cyan'}`;
    };

    window.stepStudioQty = function(delta) {
      pdpStudioQty = Math.max(1, pdpStudioQty + delta);
      const input = document.getElementById('studio-qty-input');
      if (input) input.value = pdpStudioQty;
      recalculateStudioTotals();
    };

    function recalculateStudioTotals() {
      if (!pdpCurrentProduct) return;
      const base = pdpCurrentProduct.basePrice;
      let customSizeFee = pdpIsCustomSize ? 750 : 0;
      let customizationFee = 0;

      if (pdpCustomTier === 'direct_embroidery') customizationFee = 450;
      else if (pdpCustomTier === 'name_patch') customizationFee = 350;
      else if (pdpCustomTier === 'logo_patch') customizationFee = 650;
      else if (pdpCustomTier === 'alterations') customizationFee = 500;

      const singleUnitTotal = base + customSizeFee + customizationFee;
      const grandTotal = singleUnitTotal * pdpStudioQty;

      // Update Breakdown Table
      const rowBase = document.getElementById('price-row-base');
      const rowCustomSizeBox = document.getElementById('price-row-custom-size-box');
      const rowCustomBox = document.getElementById('price-row-custom-box');
      const rowCustomLabel = document.getElementById('price-row-custom-label');
      const rowCustom = document.getElementById('price-row-custom');
      const totalEl = document.getElementById('studio-total-price');

      if (rowBase) rowBase.textContent = `Rs. ${base.toLocaleString()}`;
      if (rowCustomSizeBox) rowCustomSizeBox.style.display = pdpIsCustomSize ? 'flex' : 'none';
      if (rowCustomBox) {
        rowCustomBox.style.display = pdpCustomTier !== 'none' ? 'flex' : 'none';
        if (rowCustomLabel) rowCustomLabel.textContent = pdpCustomTier === 'direct_embroidery' ? 'Direct Embroidery:' : pdpCustomTier === 'name_patch' ? 'Name Patch:' : pdpCustomTier === 'logo_patch' ? 'Logo Patch:' : 'Alterations:';
        if (rowCustom) rowCustom.textContent = `+Rs. ${customizationFee.toLocaleString()}`;
      }
      if (totalEl) totalEl.textContent = `Rs. ${grandTotal.toLocaleString()}`;
    }

    // --- 4. CART & LINE ITEM PROPERTIES PRESERVATION (PHASE 5) ---
    window.addConfiguredScrubToCart = function() {
      if (!pdpCurrentProduct) return;

      const cartItem = {
        id: `cart-${Date.now()}`,
        productId: pdpCurrentProduct.id,
        sku: pdpCurrentProduct.sku,
        title: pdpCurrentProduct.title,
        color: pdpSelectedColor.name,
        colorHex: pdpSelectedColor.hex,
        image: pdpSelectedColor.image || pdpCurrentProduct.image,
        isCustomSize: pdpIsCustomSize,
        size: pdpIsCustomSize ? `Custom Size (${pdpCustomMeasurements.chest}" Ch, ${pdpCustomMeasurements.waist}" W, ${pdpCustomMeasurements.inseam}" In)` : pdpSelectedSize,
        customMeasurements: pdpIsCustomSize ? pdpCustomMeasurements : null,
        customizationTier: pdpCustomTier,
        doctorName: pdpCustomTier !== 'none' ? pdpDoctorName : null,
        doctorDept: pdpCustomTier !== 'none' ? pdpDoctorDept : null,
        placement: pdpCustomTier !== 'none' ? pdpPlacement : null,
        threadColor: pdpCustomTier !== 'none' ? pdpThreadColor : null,
        unitPrice: (pdpCurrentProduct.basePrice + (pdpIsCustomSize ? 750 : 0) + (pdpCustomTier === 'direct_embroidery' ? 450 : pdpCustomTier === 'name_patch' ? 350 : pdpCustomTier === 'logo_patch' ? 650 : pdpCustomTier === 'alterations' ? 500 : 0)),
        quantity: pdpStudioQty
      };

      const cart = JSON.parse(localStorage.getItem('enamels_demo_cart') || '[]');
      cart.push(cartItem);
      localStorage.setItem('enamels_demo_cart', JSON.stringify(cart));

      updateHeaderBadges();
      window.openCartDrawer();
    };

    window.addDuoBundleToCart = function() {
      const cart = JSON.parse(localStorage.getItem('enamels_demo_cart') || '[]');
      cart.push({
        id: `bundle-${Date.now()}`,
        productId: 'demo-bundle-shift-duo',
        sku: 'ENM-BND-SHF-DUO',
        title: 'DEMO — Sprinter Shift Duo Kit (Scrub Set + BunFit Cap + Sleeves)',
        color: 'Deep Midnight Navy',
        colorHex: '#0B1224',
        image: 'demo-sprinter-navy.jpg',
        isCustomSize: false,
        size: 'M',
        customizationTier: 'none',
        unitPrice: 6850,
        quantity: 1
      });
      localStorage.setItem('enamels_demo_cart', JSON.stringify(cart));
      updateHeaderBadges();
      window.openCartDrawer();
    };

    window.addCrossSellCap = function() {
      const cart = JSON.parse(localStorage.getItem('enamels_demo_cart') || '[]');
      cart.push({
        id: `cap-${Date.now()}`,
        productId: 'demo-cap-bunfit-navy',
        sku: 'ENM-CAP-BNF-NVY',
        title: 'DEMO — BunFit™ Scrub Cap (Deep Navy)',
        color: 'Deep Navy',
        colorHex: '#0B1224',
        image: 'demo-sprinter-navy.jpg',
        isCustomSize: false,
        size: 'One Size',
        customizationTier: 'none',
        unitPrice: 650,
        quantity: 1
      });
      localStorage.setItem('enamels_demo_cart', JSON.stringify(cart));
      updateHeaderBadges();
      renderCartDrawer();
    };

    window.openCartDrawer = function() {
      renderCartDrawer();
      document.getElementById('cart-drawer-panel')?.classList.add('active');
      document.getElementById('cart-drawer-overlay')?.classList.add('active');
    };

    window.closeCartDrawer = function() {
      document.getElementById('cart-drawer-panel')?.classList.remove('active');
      document.getElementById('cart-drawer-overlay')?.classList.remove('active');
    };

    function renderCartDrawer() {
      const cart = JSON.parse(localStorage.getItem('enamels_demo_cart') || '[]');
      const container = document.getElementById('cart-items-container');
      const badge = document.getElementById('cart-drawer-count-badge');
      if (badge) badge.textContent = `${cart.length} Items`;

      let subtotal = 0;

      if (!container) return;

      if (cart.length === 0) {
        container.innerHTML = `
          <div style="text-align: center; padding: 48px 0; color: #94A3B8;">
            <div style="font-size: 3rem; margin-bottom: 12px;">🛍️</div>
            <h4>Your Shopping Bag is Empty</h4>
            <p style="font-size: 0.85rem;">Discover our 4-way mechanical stretch scrubs and customize your fit.</p>
            <button type="button" class="btn-chromatic-primary" onclick="window.closeCartDrawer(); window.navigateToView('home');" style="margin-top: 16px;">
              Start Shopping →
            </button>
          </div>
        `;
      } else {
        container.innerHTML = cart.map((item, idx) => {
          const itemTotal = item.unitPrice * item.quantity;
          subtotal += itemTotal;

          return `
            <div class="cart-item-card">
              <img src="{{ '' | asset_url }}${item.image}" alt="${item.title}" class="cart-item-img" />
              <div class="cart-item-body">
                <h4>${item.title}</h4>
                <div class="cart-item-props">
                  <div>Color: <strong>${item.color}</strong></div>
                  <div>Size: <strong>${item.size}</strong></div>
                  ${item.doctorName ? `<div>Embroidery: <strong>${item.doctorName}</strong> (${item.placement})</div>` : ''}
                </div>
                <div class="cart-item-actions">
                  <div class="cart-qty-ctrl">
                    <button type="button" onclick="window.updateCartQty(${idx}, -1)">-</button>
                    <span>${item.quantity}</span>
                    <button type="button" onclick="window.updateCartQty(${idx}, 1)">+</button>
                  </div>
                  <span class="cart-item-price">Rs. ${itemTotal.toLocaleString()}</span>
                  <button type="button" class="cart-remove-btn" onclick="window.removeCartItem(${idx})">Remove</button>
                </div>
              </div>
            </div>
          `;
        }).join('');
      }

      // Update Shipping Threshold
      const freeThreshold = 7000;
      const diff = freeThreshold - subtotal;
      const fillPercent = Math.min(100, (subtotal / freeThreshold) * 100);
      const thresholdLabel = document.getElementById('threshold-label');
      const thresholdFill = document.getElementById('threshold-fill');

      if (thresholdLabel) {
        thresholdLabel.textContent = diff <= 0 ? '🎉 You qualify for FREE Nationwide Delivery in Pakistan!' : `Add Rs. ${diff.toLocaleString()} more for FREE Nationwide Delivery`;
      }
      if (thresholdFill) thresholdFill.style.width = `${fillPercent}%`;

      // Update Totals
      const subtotalEl = document.getElementById('cart-subtotal-display');
      const grandTotalEl = document.getElementById('cart-grand-total-display');
      if (subtotalEl) subtotalEl.textContent = `Rs. ${subtotal.toLocaleString()}`;
      if (grandTotalEl) grandTotalEl.textContent = `Rs. ${subtotal.toLocaleString()}`;
    }

    window.updateCartQty = function(idx, delta) {
      const cart = JSON.parse(localStorage.getItem('enamels_demo_cart') || '[]');
      if (cart[idx]) {
        cart[idx].quantity += delta;
        if (cart[idx].quantity <= 0) cart.splice(idx, 1);
        localStorage.setItem('enamels_demo_cart', JSON.stringify(cart));
        updateHeaderBadges();
        renderCartDrawer();
      }
    };

    window.removeCartItem = function(idx) {
      const cart = JSON.parse(localStorage.getItem('enamels_demo_cart') || '[]');
      cart.splice(idx, 1);
      localStorage.setItem('enamels_demo_cart', JSON.stringify(cart));
      updateHeaderBadges();
      renderCartDrawer();
    };

    function updateHeaderBadges() {
      const cart = JSON.parse(localStorage.getItem('enamels_demo_cart') || '[]');
      const badge = document.getElementById('header-cart-counter');
      if (badge) badge.textContent = cart.reduce((sum, i) => sum + i.quantity, 0);
    }

    // --- 5. DEMO CHECKOUT SIMULATOR ---
    window.openDemoCheckoutModal = function() {
      window.closeCartDrawer();
      const cart = JSON.parse(localStorage.getItem('enamels_demo_cart') || '[]');
      const subtotal = cart.reduce((sum, i) => sum + (i.unitPrice * i.quantity), 0);

      const subtotalEl = document.getElementById('demo-checkout-subtotal');
      const totalEl = document.getElementById('demo-checkout-total');
      if (subtotalEl) subtotalEl.textContent = `Rs. ${subtotal.toLocaleString()}`;
      if (totalEl) totalEl.textContent = `Rs. ${subtotal.toLocaleString()}`;

      const modal = document.getElementById('demo-checkout-modal');
      if (modal) modal.style.display = 'flex';
    };

    window.closeDemoCheckoutModal = function() {
      const modal = document.getElementById('demo-checkout-modal');
      if (modal) modal.style.display = 'none';
    };

    window.handleDemoOrderPlacement = function(e) {
      e.preventDefault();
      const orderNum = `ENM-DEMO-${Math.floor(100000 + Math.random() * 900000)}`;
      alert(`🎉 DEMO ORDER SUCCESSFUL!\n\nOrder Reference: ${orderNum}\nThank you for testing the Enamels Chromatic Scrub Lab experience.\n\nNote: This was a simulated checkout. No real payment was charged.`);
      localStorage.removeItem('enamels_demo_cart');
      updateHeaderBadges();
      window.closeDemoCheckoutModal();
      window.navigateToView('home');
    };

    // --- 6. CATALOGUE RENDERING (HOMEPAGE & DEDICATED COLLECTION VIEW) ---
    function renderHomeChromaGrid() {
      const grid = document.getElementById('chroma-grid');
      if (!grid) return;
      const items = window.EnamelsCatalogue || [];
      renderProductsIntoGrid(grid, items);
      const counter = document.getElementById('main-product-counter');
      if (counter) counter.textContent = `Showing ${items.length} Products`;
    }

    function renderCollectionView() {
      const grid = document.getElementById('collection-products-grid');
      if (!grid) return;
      let items = window.EnamelsCatalogue || [];

      // Filter by current series / category
      if (window.currentFilterType === 'series' && window.currentFilterSeries) {
        items = items.filter(i => i.series === window.currentFilterSeries);
      } else if (window.currentFilterType === 'category' && window.currentFilterSeries) {
        items = items.filter(i => i.category === window.currentFilterSeries);
      }

      renderProductsIntoGrid(grid, items);
      const countEl = document.getElementById('collection-product-count');
      if (countEl) countEl.textContent = `Showing ${items.length} Products in Collection`;
    }

    function renderProductsIntoGrid(gridElement, items) {
      gridElement.innerHTML = items.map(item => `
        <div class="demo-product-card enamels-3d-card" onclick="window.openEnamelsPdpModal('${item.id}')">
          <div class="card-image-box">
            ${item.badge ? `<span class="card-badge" style="background:var(--teal-electric); color:var(--navy-midnight);">${item.badge}</span>` : ''}
            <img src="{{ '' | asset_url }}${item.image}" alt="${item.title}" loading="lazy" width="400" height="500" />
            <span class="card-fabric-pill" style="background:rgba(11,18,36,0.85); color:#ffffff;">${item.fabric}</span>
          </div>
          <div class="card-body">
            <span class="card-sku" style="color:var(--teal-electric);">${item.sku}</span>
            <h4 class="card-title" style="color:#ffffff;">${item.title}</h4>
            <div class="card-colors">
              ${item.colors.map(c => `
                <span class="color-dot" style="background-color: ${c.hex};" title="${c.name}"></span>
              `).join('')}
            </div>
            <div class="card-footer">
              <div class="card-price-group">
                <span class="card-price" style="color:#ffffff;">Rs. ${item.basePrice.toLocaleString()}</span>
                ${item.comparePrice ? `<span class="card-compare">Rs. ${item.comparePrice.toLocaleString()}</span>` : ''}
              </div>
              <button type="button" class="card-btn" style="background:var(--teal-electric); color:var(--navy-midnight);">Customise & Fit</button>
            </div>
          </div>
        </div>
      `).join('');
    }

    // --- 7. MODALS & UTILITIES ---
    window.openSizeGuideModal = function() {
      const modal = document.getElementById('size-guide-modal');
      if (modal) modal.style.display = 'flex';
    };
    window.closeSizeGuideModal = function() {
      const modal = document.getElementById('size-guide-modal');
      if (modal) modal.style.display = 'none';
    };

    window.toggleSearchModal = function() {
      const overlay = document.getElementById('search-modal-overlay');
      if (overlay) {
        const isHidden = overlay.style.display === 'none';
        overlay.style.display = isHidden ? 'flex' : 'none';
        if (isHidden) {
          const input = document.getElementById('live-search-input');
          if (input) { input.focus(); window.handleLiveSearch(''); }
        }
      }
    };

    window.handleLiveSearch = function(query) {
      const list = document.getElementById('search-results-list');
      if (!list) return;
      const q = (query || '').toLowerCase().trim();
      const items = (window.EnamelsCatalogue || []).filter(i => {
        if (!q) return true;
        return i.title.toLowerCase().includes(q) || i.series.toLowerCase().includes(q) || i.category.toLowerCase().includes(q);
      }).slice(0, 8);

      list.innerHTML = items.map(item => `
        <div class="search-item" onclick="window.toggleSearchModal(); window.openEnamelsPdpModal('${item.id}');">
          <img src="{{ '' | asset_url }}${item.image}" alt="${item.title}" width="50" height="60" />
          <div class="search-item-info">
            <strong>${item.title}</strong>
            <span>Rs. ${item.basePrice.toLocaleString()} • ${item.series} Series</span>
          </div>
        </div>
      `).join('');
    };

    window.toggleWishlistModal = function() {
      alert('Wishlist feature: Save and organize your preferred clinical scrub sets for quick re-ordering.');
    };

    window.toggleMobileMenu = function() {
      const drawer = document.getElementById('mobile-nav-drawer');
      if (drawer) {
        const isShown = drawer.style.display === 'block';
        drawer.style.display = isShown ? 'none' : 'block';
      }
    };

    window.scrollToSection = function(secId) {
      const el = document.getElementById(secId);
      if (el) el.scrollIntoView({ behavior: 'smooth' });
    };

    window.switchLanguage = function(lang) {
      const root = document.getElementById('chromatic-lab-root');
      if (!root) return;
      if (['ur', 'ar', 'ps'].includes(lang)) {
        root.setAttribute('dir', 'rtl');
      } else {
        root.removeAttribute('dir');
      }
    };

    window.handleBulkQuote = function(e) {
      e.preventDefault();
      alert('Thank you! Your institutional scrub quote request has been received. Our clinical uniform specialist will reach out to you on WhatsApp within 2 hours.');
      e.target.reset();
    };
  })();
</script>

