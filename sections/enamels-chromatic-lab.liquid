    window.handleSelfServiceCityChange = function(city) {
      const alertBox = document.getElementById('ss-out-of-area-alert');
      const lahoreCheck = document.getElementById('ss-confirm-lahore');

      if (city !== 'Lahore') {
        if (alertBox) alertBox.style.display = 'block';
        if (lahoreCheck) lahoreCheck.checked = false;
      } else {
        if (alertBox) alertBox.style.display = 'none';
        if (lahoreCheck) lahoreCheck.checked = true;
      }
    };

    window.nextSelfServiceStep = function(currentStep) {
      const errBanner = document.getElementById('ss-form-error-banner');
      const showErr = (msg) => {
        if (errBanner) {
          errBanner.textContent = msg;
          errBanner.style.display = 'block';
          errBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          alert(msg);
        }
      };

      if (currentStep === 1) {
        const name = document.getElementById('ss-input-name')?.value.trim();
        const phone = document.getElementById('ss-input-phone')?.value.trim();
        const wa = document.getElementById('ss-input-whatsapp')?.value.trim();

        if (!name) return showErr('Please enter your full name and title.');
        if (!phone || phone.length < 9) return showErr('Please enter a valid mobile number (e.g. 0300-1234567).');
        if (!wa || wa.length < 9) return showErr('Please enter a valid WhatsApp number for visit coordination.');

        window.goToSelfServiceStep(2);
      } else if (currentStep === 2) {
        const city = document.getElementById('ss-input-city')?.value;
        const area = document.getElementById('ss-input-area')?.value;
        const street = document.getElementById('ss-input-street')?.value.trim();
        const isLahoreConfirmed = document.getElementById('ss-confirm-lahore')?.checked;

        if (city === 'Lahore') {
          if (!area) return showErr('Please select your area or sector in Lahore.');
          if (!street) return showErr('Please provide your complete street / hospital address.');
          if (!isLahoreConfirmed) return showErr('Please confirm that the visit location is within Lahore district.');
        } else {
          if (!street) return showErr('Please provide your delivery/clinic address for the expansion waitlist.');
        }

        window.goToSelfServiceStep(3);
      } else if (currentStep === 3) {
        const selectedNeeds = Array.from(document.querySelectorAll('input[name="ss_need"]:checked')).map(el => el.value);
        if (selectedNeeds.length === 0) {
          return showErr('Please select at least one item or service you need assistance with.');
        }

        window.goToSelfServiceStep(4);
      } else if (currentStep === 4) {
        const date = document.getElementById('ss-input-date')?.value;
        const timeslot = document.getElementById('ss-input-timeslot')?.value;

        if (!date) return showErr('Please select your preferred visit date.');
        if (!timeslot) return showErr('Please select your preferred visit time window.');

        renderSelfServiceRecap();
        window.goToSelfServiceStep(5);
      }
    };

