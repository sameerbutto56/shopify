    // Recalculates order summary table and advance payment alert
    function recalculatePdpSummary() {
      const item = STATE.pdpProduct;
      if (!item) return;

      const basePrice = item.basePrice || 5150;
      let alterationsCharge = STATE.pdpAlterations ? 350 : 0;
      let engravingCharge = 0;
      if (STATE.pdpEngravingType === 'direct') engravingCharge = 450;
      if (STATE.pdpEngravingType === 'patch') engravingCharge = 350;
      let logoCharge = STATE.pdpLogoEnabled ? 650 : 0;

      let addonsTotal = STATE.pdpCompanionAddons.reduce((sum, a) => sum + a.price, 0);

      const singleUnitTotal = basePrice + alterationsCharge + engravingCharge + logoCharge;
      const subtotal = (singleUnitTotal * STATE.pdpQty) + addonsTotal;

      const requiresAdvance = STATE.pdpAlterations || STATE.pdpEngravingType !== 'none' || STATE.pdpLogoEnabled || STATE.pdpIsCustomSize;

      // Update summary table
      const sumBase = document.getElementById('summary-base-price');
      const sumColorSize = document.getElementById('summary-color-size');
      const rowAlt = document.getElementById('summary-row-alterations');
      const rowEng = document.getElementById('summary-row-engraving');
      const lblEng = document.getElementById('summary-engraving-label');
      const prcEng = document.getElementById('summary-engraving-price');
      const rowLogo = document.getElementById('summary-row-logo');
      const rowAddons = document.getElementById('summary-row-addons');
      const prcAddons = document.getElementById('summary-addons-price');
      const sumTotal = document.getElementById('summary-grand-total');
      const sumAdvanceDisclaimer = document.getElementById('summary-advance-disclaimer');

      if (sumBase) sumBase.textContent = `Rs. ${basePrice.toLocaleString()}`;
      if (sumColorSize) {
        const sizeLabel = STATE.pdpIsCustomSize ? 'Custom Tailored' : STATE.pdpSize;
        sumColorSize.textContent = `${STATE.pdpColor.name} / ${sizeLabel}`;
      }

      if (rowAlt) rowAlt.style.display = STATE.pdpAlterations ? 'table-row' : 'none';
      if (rowEng) {
        rowEng.style.display = STATE.pdpEngravingType !== 'none' ? 'table-row' : 'none';
        if (lblEng) lblEng.textContent = STATE.pdpEngravingType === 'patch' ? 'Stitched Patch Engraving:' : 'Direct Embroidery:';
        if (prcEng) prcEng.textContent = `+Rs. ${engravingCharge.toLocaleString()}`;
      }
      if (rowLogo) rowLogo.style.display = STATE.pdpLogoEnabled ? 'table-row' : 'none';
      if (rowAddons) {
        rowAddons.style.display = STATE.pdpCompanionAddons.length > 0 ? 'table-row' : 'none';
        if (prcAddons) prcAddons.textContent = `+Rs. ${addonsTotal.toLocaleString()}`;
      }
      if (sumTotal) sumTotal.textContent = `Rs. ${subtotal.toLocaleString()}`;

      // Advance payment disclaimer visible check (Section 9)
      if (sumAdvanceDisclaimer) {
        sumAdvanceDisclaimer.style.display = requiresAdvance ? 'flex' : 'none';
      }
    }

    // Add configured scrub to cart with strict validation
    window.addConfiguredScrubToCart = function() {
      withCartDebounce(() => {
        const item = STATE.pdpProduct;
        if (!item) return;

        // Ensure all required steps are satisfied
        if (STATE.pdpIsCustomSize) {
          if (!STATE.pdpCustomMeasurements.chest || !STATE.pdpCustomMeasurements.waist) {
            window.goToPdpStep('size', false);
            showStepError('size', 'Please confirm your custom measurements before adding to cart.');
            return;
          }
        }

        if (STATE.pdpEngravingType !== 'none') {
          if (!STATE.pdpEngravingLines.line1) {
            window.goToPdpStep('engraving', false);
            showStepError('engraving', 'Please enter your Full Name & Title for embroidery, or select "No Personalization".');
            return;
          }
        }

        const basePrice = item.basePrice || 5150;
        let alterationsCharge = STATE.pdpAlterations ? 350 : 0;
        let engravingCharge = STATE.pdpEngravingType === 'direct' ? 450 : STATE.pdpEngravingType === 'patch' ? 350 : 0;
        let logoCharge = STATE.pdpLogoEnabled ? 650 : 0;
        const unitPrice = basePrice + alterationsCharge + engravingCharge + logoCharge;

        const requiresAdvance = STATE.pdpAlterations || STATE.pdpEngravingType !== 'none' || STATE.pdpLogoEnabled || STATE.pdpIsCustomSize;

        const cartItem = {
          id: `${item.id}-${Date.now()}`,
          productId: item.id,
          title: item.title.replace('DEMO — ', ''),
          series: item.series || 'Clinical',
          image: item.image,
          color: STATE.pdpColor.name,
          colorHex: STATE.pdpColor.hex,
          size: STATE.pdpIsCustomSize ? 'Custom Tailored' : STATE.pdpSize,
          customMeasurements: STATE.pdpIsCustomSize ? STATE.pdpCustomMeasurements : null,
          alterations: STATE.pdpAlterations ? STATE.pdpAlterationDetails : null,
          engraving: STATE.pdpEngravingType !== 'none' ? {
            type: STATE.pdpEngravingType,
            lines: STATE.pdpEngravingLines,
            threadColor: STATE.pdpThreadColor.name,
            font: 'Times New Roman'
          } : null,
          logo: STATE.pdpLogoEnabled ? STATE.pdpLogo : null,
          quantity: STATE.pdpQty,
          unitPrice: unitPrice,
          lineTotal: unitPrice * STATE.pdpQty,
          requiresAdvancePayment: requiresAdvance
        };

        const cart = getStoredCart();
        cart.push(cartItem);

        // Add companion add-ons
        STATE.pdpCompanionAddons.forEach((addon, idx) => {
          cart.push({
            id: `companion-${Date.now()}-${idx}`,
            productId: 'companion-addon',
            title: addon.title,
            series: 'Addon',
            image: 'cat-caps.jpg',
            color: 'Standard',
            size: 'Standard',
            quantity: 1,
            unitPrice: addon.price,
            lineTotal: addon.price,
            requiresAdvancePayment: false
          });
        });

        saveCart(cart);
        updateCartBadge();
        window.openCartDrawer();
      });
    };

    // ------------------------------------------------------------
    // 7. READY TO WEAR / MAKE YOUR OWN SCRUB WIZARD (SECTIONS 11 & 12)
    // ------------------------------------------------------------
    window.jumpRtwStep = function(stepNum) {
      STATE.rtwStep = stepNum;
      document.querySelectorAll('.rtw-step-pane').forEach((pane, idx) => {
        const isCurrent = (idx + 1) === stepNum;
        pane.classList.toggle('active', isCurrent);
        pane.style.display = isCurrent ? 'block' : 'none';
      });
      document.querySelectorAll('.rtw-nav-step').forEach((nav, idx) => {
        const cur = idx + 1;
        nav.classList.toggle('active', cur === stepNum);
        nav.classList.toggle('completed', cur < stepNum);
      });

      if (stepNum === 2) {
        renderRtwColorsForFabric(STATE.rtwFabric?.id || 'sprinter-twill');
      } else if (stepNum === 4) {
        renderRtwDesignsForArticle(STATE.rtwArticle?.id || 'Sprinter');
      } else if (stepNum === 7) {
        renderRtwReview();
      }
      window.scrollTo({ top: 120, behavior: 'smooth' });
    };

