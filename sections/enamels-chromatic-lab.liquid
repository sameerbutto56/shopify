    window.setRtwThreadColor = function(hex) {
      const colorNames = {
        '#FFFFFF': 'Silk White',
        '#D4AF37': 'Metallic Gold',
        '#00B8A9': 'Clinical Cyan',
        '#C0C0C0': 'Platinum Silver',
        '#18181B': 'Midnight Black'
      };
      const name = colorNames[hex] || 'Silk White';
      STATE.rtwThreadColor = { hex, name };

      document.querySelectorAll('.thread-swatch-card').forEach(c => {
        const id = c.id;
        if (hex === '#FFFFFF') c.classList.toggle('active', id === 'rtw-th-white');
        else if (hex === '#D4AF37') c.classList.toggle('active', id === 'rtw-th-gold');
        else if (hex === '#00B8A9') c.classList.toggle('active', id === 'rtw-th-cyan');
        else if (hex === '#C0C0C0') c.classList.toggle('active', id === 'rtw-th-silver');
        else if (hex === '#18181B') c.classList.toggle('active', id === 'rtw-th-black');
      });

      const line1 = document.getElementById('rtw-sim-line-1');
      const line2 = document.getElementById('rtw-sim-line-2');
      const line3 = document.getElementById('rtw-sim-line-3');
      const garmentLine = document.getElementById('rtw-garment-sim-line');
      const threadLabel = document.getElementById('rtw-thread-spec-label');

      if (line1) line1.style.color = hex;
      if (line2) line2.style.color = hex;
      if (line3) line3.style.color = hex;
      if (garmentLine) garmentLine.style.color = hex;
      if (threadLabel) threadLabel.textContent = `Madeira ${name}`;
