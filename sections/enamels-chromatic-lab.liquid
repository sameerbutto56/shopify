    function renderBrandCardsForCategory(gender, catKey) {
      const container = document.getElementById('category-brands-cards-grid');
      if (!container) return;

      const catalogue = (typeof window.getStorefrontCatalogue === 'function') ? window.getStorefrontCatalogue() : (window.EnamelsCatalogue || []);
      const genderItems = catalogue.filter(item => {
        const matchesGender = (gender === 'all') || (item.gender === gender || item.gender === 'unisex');
        if (!matchesGender) return false;
        if (catKey === 'all') return true;
        if (catKey === 'accessories') {
          const topCat = getTopCategory(item);
          return topCat === 'accessories' || topCat === 'caps' || topCat === 'sleeves';
        }
        return getTopCategory(item) === catKey;
      });

      let brandKeys = [];
      if (catKey === 'scrubs') {
        brandKeys = (gender === 'women')
          ? ['Vilora', 'Sprinter', 'Crown', 'Ground']
          : ['Sprinter', 'Crown', 'Ground'];
      } else if (catKey === 'lab-coat') {
        brandKeys = ['Helium', 'Suiting'];
      } else if (catKey === 'caps') {
        brandKeys = ['BunFit'];
      } else if (catKey === 'sleeves') {
        brandKeys = ['Accessories'];
      } else if (catKey === 'accessories') {
        brandKeys = ['BunFit', 'Accessories'];
      } else {
        brandKeys = ['Sprinter', 'Crown', 'Ground', 'Vilora'];
      }

      const validBrands = brandKeys.filter(bKey => {
        const canonical = canonicalizeBrand(bKey);
        return genderItems.some(item => canonicalizeBrand(item.series) === canonical);
      });

      let cardsHtml = validBrands.map((bKey, index) => {
        const canonical = canonicalizeBrand(bKey);
        const meta = BRAND_CARDS_METADATA[canonical] || {
          name: bKey,
          tagline: 'Signature clinical collection',
          badge: 'SIGNATURE LINE',
          image: 'cat-sprinter.jpg'
        };
        const count = genderItems.filter(item => canonicalizeBrand(item.series) === canonical).length;
        const imgUrl = window.ShopifyThemeAssets?.[meta.image] || meta.image;
        const animDelay = index * 70;

        return `
          <div class="collection-category-card-3d-wrap" style="animation-delay: ${animDelay}ms;">
            <div
              class="collection-category-card"
              data-brand="${canonical}"
              onclick="window.navigateToArticleSeries('${gender}', '${catKey}', '${canonical}')"
              role="button"
              tabindex="0"
