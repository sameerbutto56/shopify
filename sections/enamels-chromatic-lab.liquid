        if (count === 0) return '';
        const meta = CATEGORY_META[catKey];
        const isActive = activeCat === catKey;
        const imgUrl = window.ShopifyThemeAssets?.[meta.image] || meta.image;
        const animDelay = index * 70;

        return `
