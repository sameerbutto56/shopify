    window.goToSelfServiceStep = function(step) {
      selfServiceCurrentStep = step;
      const stepLabels = {
        1: { name: 'Customer Details', sub: 'Enter your personal contact details' },
        2: { name: 'Lahore Service Address', sub: 'Confirm your address in Lahore' },
        3: { name: 'Shopping Requirements', sub: 'Choose products & services needed' },
        4: { name: 'Visit Schedule Preferences', sub: 'Select preferred date & time window' },
        5: { name: 'Review Charges & Confirmation', sub: 'Final review and request submission' }
      };

      // Update badge and status message
      const badgeText = document.getElementById('ss-step-badge-text');
      const remText = document.getElementById('ss-step-remaining-text');
      const statusMsg = document.getElementById('ss-stepper-status-msg');
      const fillBar = document.getElementById('ss-progress-fill');

      if (badgeText) badgeText.textContent = `Step ${step} of 5: ${stepLabels[step].name}`;
      if (remText) remText.textContent = step === 5 ? 'Final Step' : `${5 - step} steps remaining`;
      if (statusMsg) statusMsg.textContent = stepLabels[step].sub;
      if (fillBar) fillBar.style.width = `${(step / 5) * 100}%`;

      // Update Stepper Navigation Buttons
      const stepMap = [
        { id: 'ss-nav-btn-contact', subId: 'ss-sub-contact', label: 'Contact', defaultSub: 'Required' },
        { id: 'ss-nav-btn-address', subId: 'ss-sub-address', label: 'Lahore Address', defaultSub: 'Required' },
        { id: 'ss-nav-btn-needs', subId: 'ss-sub-needs', label: 'Requirements', defaultSub: 'Select Items' },
        { id: 'ss-nav-btn-time', subId: 'ss-sub-time', label: 'Visit Time', defaultSub: 'Preference' },
        { id: 'ss-nav-btn-confirm', subId: 'ss-sub-confirm', label: 'Review & Submit', defaultSub: 'Finalize' }
      ];

      stepMap.forEach((item, index) => {
        const btn = document.getElementById(item.id);
        const sub = document.getElementById(item.subId);
        const sIndex = index + 1;
        if (!btn) return;
        btn.classList.remove('active', 'completed', 'upcoming');
        if (sIndex < step) {
          btn.classList.add('completed');
          if (sub) sub.textContent = 'Completed ✓';
        } else if (sIndex === step) {
          btn.classList.add('active');
          if (sub) sub.textContent = 'In Progress';
        } else {
          btn.classList.add('upcoming');
          if (sub) sub.textContent = item.defaultSub;
        }
      });

      // Switch Panes
      document.querySelectorAll('.self-service-pane').forEach(p => p.classList.remove('active'));
      const activePane = document.getElementById(`ss-pane-${step}`);
      if (activePane) activePane.classList.add('active');

      // Clear error banner
      const errBanner = document.getElementById('ss-form-error-banner');
      if (errBanner) {
        errBanner.style.display = 'none';
        errBanner.textContent = '';
      }

      // Smooth scroll to card
      const card = document.getElementById('self-service-booking-card');
      if (card) {
        card.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

