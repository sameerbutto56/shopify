    window.setMeasurementUnit = function(unit) {
      const oldUnit = STATE.pdpCustomMeasurements?.unit || 'in';
      STATE.pdpCustomMeasurements.unit = unit;
      const btnIn = document.getElementById('meas-unit-in');
      const btnCm = document.getElementById('meas-unit-cm');
      if (btnIn) btnIn.classList.toggle('active', unit === 'in');
      if (btnCm) btnCm.classList.toggle('active', unit === 'cm');
      document.querySelectorAll('.unit-label').forEach(el => el.textContent = unit);

      if (!STATE.pdpIsCustomSize) {
        window.selectStandardSize(STATE.pdpSize);
      } else {
        const fields = ['meas-input-chest', 'meas-input-waist', 'meas-input-hips', 'meas-input-top', 'meas-input-inseam'];
        fields.forEach(id => {
          const input = document.getElementById(id);
          if (input && input.value) {
            const num = parseFloat(input.value);
            if (!isNaN(num)) {
              if (unit === 'cm' && oldUnit === 'in') {
                input.value = Math.round(num * 2.54);
              } else if (unit === 'in' && oldUnit === 'cm') {
                input.value = Math.round((num / 2.54) * 2) / 2;
              }
            }
          }
        });
        window.handlePdpMeasurementChange();
      }
    };

