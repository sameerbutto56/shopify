      if (cChip) cChip.classList.remove('active');

      const statusWrap = document.getElementById('pdp-size-status-indicator');
      const statusIcon = document.getElementById('pdp-size-status-icon');
      const statusText = document.getElementById('pdp-size-status-text');
      if (statusWrap) {
        statusWrap.style.background = '#f0fdfa';
        statusWrap.style.color = '#008779';
        statusWrap.style.borderColor = '#99f6e4';
      }
      if (statusIcon) statusIcon.textContent = '📐';
      if (statusText) statusText.textContent = `Standard Preset Active: Size ${size} — All measurements auto-populated (${unit.toUpperCase()})`;

      recalculatePdpSummary();
      updateRepCustomOptionsPreview();
    };

    window.handlePdpMeasurementChange = function(inputEl) {
      const unit = STATE.pdpCustomMeasurements?.unit || 'in';
      const baseSize = STATE.pdpSelectedPresetSize || 'M';
      const presets = (window.ENAMELS_RTW_SIZE_PRESETS && window.ENAMELS_RTW_SIZE_PRESETS[unit]) || {
        'XS':  { chest: 34, waist: 28, hips: 36, shoulder: 16, shirt: 26, inseam: 38 },
        'S':   { chest: 37, waist: 30, hips: 38, shoulder: 17, shirt: 27, inseam: 39 },
        'M':   { chest: 40, waist: 33, hips: 41, shoulder: 18, shirt: 28, inseam: 40 },
        'L':   { chest: 43, waist: 36, hips: 44, shoulder: 19, shirt: 29, inseam: 41 },
        'XL':  { chest: 46, waist: 39, hips: 47, shoulder: 20, shirt: 30, inseam: 42 },
        '2XL': { chest: 49, waist: 42, hips: 50, shoulder: 21, shirt: 31, inseam: 42.5 }
      };
      const preset = presets[baseSize] || presets['M'];

      const fieldMap = [
        { id: 'meas-input-chest', tag: 'tag-pdp-chest', key: 'chest', presetVal: preset.chest },
        { id: 'meas-input-waist', tag: 'tag-pdp-waist', key: 'waist', presetVal: preset.waist },
        { id: 'meas-input-hips', tag: 'tag-pdp-hips', key: 'hips', presetVal: preset.hips },
        { id: 'meas-input-top', tag: 'tag-pdp-top', key: 'top', presetVal: preset.shirt },
        { id: 'meas-input-inseam', tag: 'tag-pdp-inseam', key: 'inseam', presetVal: preset.inseam }
      ];

      let anyDeviated = false;
      const currentValues = {};

      fieldMap.forEach(f => {
        const input = document.getElementById(f.id);
        const tag = document.getElementById(f.tag);
        const val = input ? parseFloat(input.value) : NaN;
        currentValues[f.key] = isNaN(val) ? '' : val;

        if (!isNaN(val) && Math.abs(val - f.presetVal) > 0.001) {
          anyDeviated = true;
          if (input) input.classList.add('field-edited');
          if (tag) {
            tag.textContent = 'Edited';
            tag.classList.add('active');
          }
        } else {
          if (input) input.classList.remove('field-edited');
          if (tag) {
            tag.textContent = '';
            tag.classList.remove('active');
          }
        }
      });

      currentValues.unit = unit;
      STATE.pdpCustomMeasurements = currentValues;

      const statusWrap = document.getElementById('pdp-size-status-indicator');
      const statusIcon = document.getElementById('pdp-size-status-icon');
      const statusText = document.getElementById('pdp-size-status-text');

      if (anyDeviated) {
        STATE.pdpSize = 'C';
        STATE.pdpIsCustomSize = true;

        document.querySelectorAll('#pdp-sizes-grid .pdp-size-chip').forEach(c => {
          const s = c.getAttribute('data-size') || c.textContent.trim();
          c.classList.toggle('active', s === 'C');
        });

        if (statusWrap) {
          statusWrap.style.background = '#fffbeb';
          statusWrap.style.color = '#b45309';
          statusWrap.style.borderColor = '#fde68a';
        }
        if (statusIcon) statusIcon.textContent = '✏️';
        if (statusText) statusText.innerHTML = `<strong>Custom Size (C) Active</strong> — Sizing deviation detected`;
      } else {
        STATE.pdpSize = baseSize;
        STATE.pdpIsCustomSize = false;

        document.querySelectorAll('#pdp-sizes-grid .pdp-size-chip').forEach(c => {
          const s = c.getAttribute('data-size') || c.textContent.trim();
          c.classList.toggle('active', s === baseSize);
        });

        if (statusWrap) {
          statusWrap.style.background = '#f0fdfa';
          statusWrap.style.color = '#008779';
          statusWrap.style.borderColor = '#99f6e4';
        }
        if (statusIcon) statusIcon.textContent = '📐';
        if (statusText) statusText.textContent = `Standard Preset Active: Size ${baseSize} — All measurements match preset (${unit.toUpperCase()})`;
      }

      recalculatePdpSummary();
      updateRepCustomOptionsPreview();
    };

