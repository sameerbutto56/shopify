{% comment %}
  ENAMELS ONLINE — MASTER CHROMATIC LAB & CUSTOM ORDERING SYSTEM
  Sections 1 to 18 Complete Implementation.
  Preserves authentic white visual identity, Poppins typography, branding,
  original 5-slide banner slideshow, and exact 6-category navigation.
{% endcomment %}

{% liquid
  assign dynamic_slide_count = 0
  for block in section.blocks
    if block.type == 'slide'
      assign dynamic_slide_count = dynamic_slide_count | plus: 1
    endif
  endfor
  if dynamic_slide_count == 0
    assign dynamic_slide_count = 5
  endif
%}

<div class="enamels-theme-root" id="enamels-app-root">
  {% unless section.settings.hide_inline_homepage %}
    <!-- Top Announcement Bar, Header & Exact 6-Category Navigation -->
    {% render 'enamels-header-nav', section: section %}
  {% endunless %}

  <!-- Main Storefront Views Container -->
  <main id="enamels-main-content">
    {% unless section.settings.hide_inline_homepage %}
      <!-- View 1: Homepage & 5-Slide Banner Slideshow -->
      {% render 'enamels-homepage', section: section %}
    {% endunless %}

    <!-- View 2: Scrubs Collection with Gender Filter & Article Tabs -->
    {% render 'enamels-scrubs-collection', section: section %}

    <!-- View 3: Single-Page Customization Studio & Self-Service Representative Visit -->
    {% render 'enamels-product-detail', section: section %}

    <!-- View 4: Ready to Wear / Make Your Own Scrub Configurator -->
    {% render 'enamels-ready-to-wear', section: section %}

    <!-- View 5: Dedicated Home Service Representative Visit Booking Portal -->
    {% render 'enamels-self-service', section: section %}
  </main>

  <!-- Slide-out Cart Drawer, Checkout Modals, Simple Product Modal & Size Guide -->
  {% render 'enamels-cart-checkout', section: section %}
</div>

<!-- ============================================================ -->
<!-- UNIFIED JAVASCRIPT CONTROLLER FOR ENAMELS ONLINE STOREFRONT -->
<!-- ============================================================ -->
<script>
  window.ShopifyThemeAssets = {
    'demo-hang-scrub-navy.jpg': {{ 'demo-hang-scrub-navy.jpg' | asset_url | json }},
    'demo-hang-scrub-burgundy.jpg': {{ 'demo-hang-scrub-burgundy.jpg' | asset_url | json }},
    'demo-hang-scrub-teal.jpg': {{ 'demo-hang-scrub-teal.jpg' | asset_url | json }},
    'demo-hang-scrub-black.jpg': {{ 'demo-hang-scrub-black.jpg' | asset_url | json }},
    'demo-hang-scrub-olive.jpg': {{ 'demo-hang-scrub-olive.jpg' | asset_url | json }},
    'demo-hang-labcoat-white.jpg': {{ 'demo-hang-labcoat-white.jpg' | asset_url | json }},
    'demo-hang-scrub-navy.png': {{ 'demo-hang-scrub-navy.png' | asset_url | json }},
    'demo-hang-scrub-burgundy.png': {{ 'demo-hang-scrub-burgundy.png' | asset_url | json }},
    'demo-hang-scrub-teal.png': {{ 'demo-hang-scrub-teal.png' | asset_url | json }},
    'demo-hang-scrub-black.png': {{ 'demo-hang-scrub-black.png' | asset_url | json }},
    'demo-hang-scrub-olive.png': {{ 'demo-hang-scrub-olive.png' | asset_url | json }},
    'demo-hang-labcoat-white.png': {{ 'demo-hang-labcoat-white.png' | asset_url | json }},
    'demo-sprinter-navy.jpg': {{ 'demo-sprinter-navy.jpg' | asset_url | json }},
    'demo-velora-teal.jpg': {{ 'demo-velora-teal.jpg' | asset_url | json }},
    'demo-crown-burgundy.jpg': {{ 'demo-crown-burgundy.jpg' | asset_url | json }},
    'cat-sprinter.jpg': {{ 'cat-sprinter.jpg' | asset_url | json }},
    'cat-men-scrubs.jpg': {{ 'cat-men-scrubs.jpg' | asset_url | json }},
    'cat-women-scrubs.jpg': {{ 'cat-women-scrubs.jpg' | asset_url | json }},
    'cat-crown.jpg': {{ 'cat-crown.jpg' | asset_url | json }},
    'cat-labcoat.jpg': {{ 'cat-labcoat.jpg' | asset_url | json }},
    'cat-caps.jpg': {{ 'cat-caps.jpg' | asset_url | json }},
    'cat-velora.jpg': {{ 'cat-velora.jpg' | asset_url | json }},
    'cat-clogs.jpg': {{ 'cat-clogs.jpg' | asset_url | json }},
    'cat-flexfit.jpg': {{ 'cat-flexfit.jpg' | asset_url | json }},
    'banner-abbotabad.jpg': {{ 'banner-abbotabad.jpg' | asset_url | json }}
  };

  window.ThemeSettings = {
    enable_card_hover_slideshow: {{ section.settings.enable_card_hover_slideshow | default: true | json }},
    card_hover_interval: {{ section.settings.card_hover_interval | default: 1400 | json }},
    card_image_aspect_ratio: {{ section.settings.card_image_aspect_ratio | default: '2/3' | json }},
    show_card_image_dots: {{ section.settings.show_card_image_dots | default: true | json }},
    card_transition_style: {{ section.settings.card_transition_style | default: 'crossfade' | json }}
  };

  window.ShopifyLiveProducts = [
    {% for product in collections.all.products %}
      {
        id: {{ product.id | json }},
        title: {{ product.title | json }},
        handle: {{ product.handle | json }},
        description: {{ product.description | strip_html | json }},
        price: {{ product.price }},
        compare_at_price: {{ product.compare_at_price | default: 'null' }},
        featured_image: {% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %},
        images: [
          {% for img in product.images %}
            {
              src: {% if img %}{{ img | image_url: width: 800 | json }}{% else %}null{% endif %},
              alt: {{ img.alt | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ],
        tags: {{ product.tags | json }},
        options: {{ product.options | json }},
        variants: [
          {% for variant in product.variants %}
            {
              id: {{ variant.id }},
              title: {{ variant.title | json }},
              price: {{ variant.price }},
              compare_at_price: {{ variant.compare_at_price | default: 'null' }},
              available: {{ variant.available | json }},
              options: {{ variant.options | json }},
              featured_image: {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  (function() {
    'use strict';

    // ------------------------------------------------------------
    // 1. APPLICATION STATE
    // ------------------------------------------------------------
    const STATE = {
      // Slideshow
      slideIndex: 0,
      slideCount: {{ dynamic_slide_count }},
      slideTimer: null,
      slidePaused: false,

      // Scrubs Collection Filter & Multi-Level Browsing Hierarchy
      genderFilter: 'men', // 'all' | 'men' | 'women'
      productCategoryFilter: 'all', // 'all' | 'scrubs' | 'lab-coat' | 'caps' | 'accessories' | 'sleeves'
      articleFilter: 'all', // 'all' | 'Sprinter' | 'Crown' | 'Velora' | 'Flexwell' | 'Helium' | 'BunFit' | etc.
      viewMode: 'gender', // 'gender' | 'brand' | 'accessories' | 'category'
      activeBrand: 'all', // 'all' | 'Velora' | 'Sprinter' | 'Crown' | 'Flexwell' | 'Helium' | 'BunFit'
      brandGender: 'all', // 'all' | 'men' | 'women'
      seasonFilter: null, // null | 'summer' | 'winter'
      sortOrder: 'featured',
      activeCardColors: {}, // map of productId -> selected colorName

      // Product Detail Page (PDP) Customizer
      pdpProduct: null,
      pdpCurrentStep: 'design',
      pdpCompletedSteps: new Set(['design']),
      pdpSkippedSteps: new Set(),
      pdpColor: { name: 'Deep Navy', hex: '#102A43', image: '' },
      pdpSize: 'M',
      pdpIsCustomSize: false,
      pdpCustomMeasurements: { chest: '', waist: '', hips: '', inseam: '', unit: 'in' },
      pdpCustomColor: null,
      pdpAlterations: false,
      pdpAlterationDetails: { shirtLength: 'Standard', trouserLength: 'Standard', sleeveLength: 'Half Sleeve (Standard)', notes: '' },
      pdpEngravingType: 'none', // 'none' | 'direct' | 'patch'
      pdpEngravingLines: { line1: '', line2: '', line3: '' },
      pdpThreadColor: { name: 'Silk White', hex: '#FFFFFF' },
      pdpLogoEnabled: false,
      pdpLogo: { id: 'akuh', name: 'Aga Khan University Hospital', placement: 'Right Chest' },
      pdpCompanionAddons: [],
      pdpQty: 1,

      // Ready to Wear Configurator Wizard
      rtwStep: 1,
      rtwFabric: { id: 'sprinter-twill', name: 'Sprinter Performance Twill', price: 0, desc: '4-Way Mechanical Stretch (72% Poly, 21% Rayon, 7% Spandex)' },
      rtwColor: { name: 'Deep Navy', hex: '#102A43' },
      rtwArticle: { id: 'Sprinter', name: 'Sprinter Series' },
      rtwDesign: { id: 'sprinter-athletic-set', name: 'Sprinter Athletic V-Neck Scrub Set', price: 5150, image: 'demo-sprinter-navy.jpg' },
      rtwSizeMode: 'standard', // 'standard' | 'custom'
      rtwStandardSize: 'M',
      rtwUnit: 'in',
      rtwCustomMeasurements: { chest: '', waist: '', hips: '', shoulder: '', sleeve: '', topLength: '', trouserWaist: '', trouserLength: '', inseam: '' },
      rtwAlterations: false,
      rtwAlterationDetails: { shirtLength: 'Standard', trouserLength: 'Standard', sleeveLength: 'Half Sleeve (Standard)', notes: '' },
      rtwEngravingType: 'none',
      rtwEngravingLines: { line1: '', line2: '', line3: '' },
      rtwThreadColor: { name: 'Silk White', hex: '#FFFFFF' },
      rtwLogoEnabled: false,
      rtwLogo: { id: 'akuh', name: 'Aga Khan University Hospital', placement: 'Right Chest' },

      // Simple Product Modal (Non-custom items)
      simpleProduct: null,
      simpleColor: 'Deep Navy',
      simpleQty: 1
    };

    window.STATE = STATE;

    // ------------------------------------------------------------
    // UNIFIED PRODUCT DATA NORMALIZATION & SHOPIFY CATALOGUE SYNC
    // ------------------------------------------------------------
    window.isTouchDevice = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0) || (navigator.msMaxTouchPoints > 0);

    const CLINICAL_COLOR_MAP = {
      'deep navy': { name: 'Deep Navy', hex: '#102A43' },
      'navy': { name: 'Deep Navy', hex: '#102A43' },
      'royal blue': { name: 'Royal Blue', hex: '#1e40af' },
      'royal': { name: 'Royal Blue', hex: '#1e40af' },
      'ceil blue': { name: 'Ceil Blue', hex: '#6ba4b8' },
      'ceil': { name: 'Ceil Blue', hex: '#6ba4b8' },
      'burgundy maroon': { name: 'Burgundy Maroon', hex: '#581c87' },
      'burgundy': { name: 'Burgundy Maroon', hex: '#581c87' },
      'maroon': { name: 'Burgundy Maroon', hex: '#581c87' },
      'olive shine': { name: 'Olive Shine', hex: '#3f4e3b' },
      'olive': { name: 'Olive Shine', hex: '#3f4e3b' },
      'hunter green': { name: 'Hunter Green', hex: '#14532d' },
      'green': { name: 'Hunter Green', hex: '#14532d' },
      'obsidian black': { name: 'Obsidian Black', hex: '#18181b' },
      'black': { name: 'Obsidian Black', hex: '#18181b' },
      'heather grey': { name: 'Heather Grey', hex: '#64748b' },
      'grey': { name: 'Heather Grey', hex: '#64748b' },
      'gray': { name: 'Heather Grey', hex: '#64748b' },
      'clinical teal': { name: 'Clinical Teal', hex: '#00b8a9' },
      'teal': { name: 'Clinical Teal', hex: '#00b8a9' },
      'lilac lavender': { name: 'Lilac Lavender', hex: '#a855f7' },
      'lilac': { name: 'Lilac Lavender', hex: '#a855f7' },
      'lavender': { name: 'Lilac Lavender', hex: '#a855f7' },
      'optic white': { name: 'Optic White', hex: '#ffffff' },
      'white': { name: 'Optic White', hex: '#ffffff' }
    };

    function findColorMeta(rawName) {
      if (!rawName) return { name: 'Standard Clinical', hex: '#102A43' };
      const lower = rawName.toLowerCase().trim();
      if (CLINICAL_COLOR_MAP[lower]) return CLINICAL_COLOR_MAP[lower];
      for (const key in CLINICAL_COLOR_MAP) {
        if (lower.includes(key) || key.includes(lower)) return CLINICAL_COLOR_MAP[key];
      }
      return { name: rawName, hex: '#102A43' };
    }

    function adaptShopifyProduct(sp) {
      if (!sp) return null;
      const title = sp.title || 'Enamels Medical Apparel';
      const cleanTitle = title.replace(/^DEMO\s*[—–-]\s*/i, '');
      const id = String(sp.id || sp.handle || `shopify-${Date.now()}`);
      const handle = sp.handle || id;
      const rawPrice = sp.price || (sp.variants && sp.variants[0]?.price) || 0;
      const basePrice = typeof rawPrice === 'string' ? Math.round(parseFloat(rawPrice)) : (rawPrice > 10000 && rawPrice % 100 === 0 ? rawPrice / 100 : rawPrice);
      const rawCompare = sp.compare_at_price || (sp.variants && sp.variants[0]?.compare_at_price);
      const comparePrice = rawCompare ? (typeof rawCompare === 'string' ? Math.round(parseFloat(rawCompare)) : (rawCompare > 10000 && rawCompare % 100 === 0 ? rawCompare / 100 : rawCompare)) : null;

      const rawImages = sp.images || [];
      const images = rawImages.map(img => {
        if (typeof img === 'string') return { src: img, alt: '' };
        return { src: img.src || img.url || '', alt: (img.alt || '').trim() };
      });
      const primaryImg = (sp.featured_image ? (typeof sp.featured_image === 'string' ? sp.featured_image : sp.featured_image.src || sp.featured_image.url) : (images[0]?.src || ''));

      // 1. Structured tag parsing (both prefix colon tags and simple tags)
      const tags = Array.isArray(sp.tags) ? sp.tags : (typeof sp.tags === 'string' ? sp.tags.split(',').map(t => t.trim()) : []);
      const tagsLower = tags.map(t => t.toLowerCase());
      const tagKeyMap = {};
      tags.forEach(t => {
        if (t.includes(':')) {
          const parts = t.split(':');
          const k = parts[0].trim().toLowerCase();
          const v = parts.slice(1).join(':').trim().toLowerCase();
          tagKeyMap[k] = v;
        }
      });

      // 2. Category classification: supports category:tag, sp.product_type, simple tags, and title keywords
      const rawProductType = (sp.product_type || '').toLowerCase();
      const catTag = tagKeyMap['category'] || '';
      let category = 'scrub-set';
      if (catTag.includes('cap') || rawProductType.includes('cap')) {
        category = 'caps';
      } else if (catTag.includes('lab') || rawProductType.includes('lab')) {
        category = 'lab-coat';
      } else if (catTag.includes('sleeve') || rawProductType.includes('sleeve')) {
        category = 'sleeves';
      } else if (catTag.includes('acc') || catTag.includes('clog') || rawProductType.includes('acc') || rawProductType.includes('clog') || rawProductType.includes('footwear')) {
        category = 'accessories';
      } else if (catTag === 'scrub-top' || catTag === 'scrub_top') {
        category = 'scrub-top';
      } else if (catTag === 'scrub-pants' || catTag === 'scrub_pants' || catTag === 'jogger') {
        category = 'scrub-pants';
      } else if (catTag.includes('scrub') || rawProductType.includes('scrub')) {
        category = 'scrub-set';
      } else if (tagsLower.includes('caps') || tagsLower.includes('scrub cap') || tagsLower.includes('surgical cap') || cleanTitle.toLowerCase().includes('cap')) {
        category = 'caps';
      } else if (tagsLower.includes('lab-coat') || tagsLower.includes('lab coat') || cleanTitle.toLowerCase().includes('lab coat')) {
        category = 'lab-coat';
      } else if (tagsLower.includes('sleeves') || cleanTitle.toLowerCase().includes('sleeves')) {
        category = 'sleeves';
      } else if (tagsLower.includes('accessories') || tagsLower.includes('clogs') || cleanTitle.toLowerCase().includes('clog')) {
        category = 'accessories';
      } else if (cleanTitle.toLowerCase().includes('top')) {
        category = 'scrub-top';
      } else if (cleanTitle.toLowerCase().includes('pant') || cleanTitle.toLowerCase().includes('jogger')) {
        category = 'scrub-pants';
      } else if (tagsLower.includes('scrubs') || tagsLower.includes('scrub set')) {
        category = 'scrub-set';
      }

      // 3. Gender classification: supports gender:tag, simple tags, and title keywords
      const genderTag = tagKeyMap['gender'] || '';
      let gender = 'unisex';
      if (genderTag === 'men' || genderTag === 'male' || tagsLower.includes('men') || tagsLower.includes("men's") || cleanTitle.toLowerCase().includes("men's") || cleanTitle.toLowerCase().includes("men ")) {
        gender = 'men';
      } else if (genderTag === 'women' || genderTag === 'female' || tagsLower.includes('women') || tagsLower.includes("women's") || cleanTitle.toLowerCase().includes("women's") || cleanTitle.toLowerCase().includes("women ")) {
        gender = 'women';
      }

      // 4. Series / Brand classification: supports brand:tag, series:tag, sp.vendor, simple tags, and title keywords
      const brandTag = tagKeyMap['brand'] || tagKeyMap['series'] || '';
      const rawVendor = (sp.vendor || '').toLowerCase();
      let series = sp.vendor || 'Enamels';
      if (brandTag.includes('vilora') || brandTag.includes('velora') || rawVendor.includes('vilora') || tagsLower.includes('velora') || cleanTitle.toLowerCase().includes('velora') || tagsLower.includes('vilora') || cleanTitle.toLowerCase().includes('vilora')) series = 'Vilora';
      else if (brandTag.includes('crown') || rawVendor.includes('crown') || tagsLower.includes('crown') || cleanTitle.toLowerCase().includes('crown')) series = 'Crown';
      else if (brandTag.includes('ground') || rawVendor.includes('ground') || tagsLower.includes('ground') || cleanTitle.toLowerCase().includes('ground')) series = 'Ground';
      else if (brandTag.includes('flexfit') || rawVendor.includes('flexfit') || tagsLower.includes('flexfit') || tagsLower.includes('flexwell') || cleanTitle.toLowerCase().includes('flex')) series = 'FlexFit';
      else if (brandTag.includes('suiting') || rawVendor.includes('suiting') || tagsLower.includes('suiting') || cleanTitle.toLowerCase().includes('suiting')) series = 'Suiting';
      else if (brandTag.includes('helium') || rawVendor.includes('helium') || tagsLower.includes('helium') || cleanTitle.toLowerCase().includes('helium')) series = 'Helium';
      else if (brandTag.includes('bunfit') || rawVendor.includes('bunfit') || tagsLower.includes('bunfit') || cleanTitle.toLowerCase().includes('bunfit')) series = 'BunFit';
      else if (brandTag.includes('sprinter') || brandTag.includes('splender') || rawVendor.includes('sprinter') || tagsLower.includes('splender') || cleanTitle.toLowerCase().includes('splender') || tagsLower.includes('sprinter') || cleanTitle.toLowerCase().includes('sprinter')) series = 'Sprinter';
      else if (category === 'lab-coat') series = 'Helium';
      else if (category === 'caps') series = 'BunFit';
      else if (category === 'sleeves') series = 'FlexFit';

      // 5. Article & Fabric & Features
      const fabricTag = tagKeyMap['fabric'] || '';
      const customFabric = fabricTag ? fabricTag.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) : (tagsLower.find(t => t.includes('stretch') || t.includes('twill') || t.includes('poly')) || '');

      const featureTag = tagKeyMap['feature'] || tagKeyMap['badge'] || '';
      let badge = '';
      if (featureTag.includes('best') || tagsLower.includes('best seller') || tagsLower.includes('bestseller')) badge = 'BEST SELLER';
      else if (featureTag.includes('new') || tagsLower.includes('new arrival') || tagsLower.includes('new')) badge = 'NEW ARRIVAL';
      else if (featureTag.includes('stretch')) badge = '4-WAY STRETCH';

      const isCustomizable = tagKeyMap['customizable'] === 'true' || tagKeyMap['feature'] === 'customizable' || tagsLower.includes('customizable') || category === 'scrub-set' || category === 'scrub-top' || category === 'lab-coat';

      const variants = sp.variants || [];
      const colorsMap = new Map();

      variants.forEach(v => {
        let colorVal = null;
        if (v.options && Array.isArray(v.options)) {
          for (const opt of v.options) {
            if (opt && opt !== 'Default Title') {
              const meta = findColorMeta(opt);
              if (meta) { colorVal = opt; break; }
            }
          }
        }
        if (!colorVal && v.title && v.title !== 'Default Title') {
          colorVal = v.title;
        }
        if (!colorVal) colorVal = 'Deep Navy';

        const colorMeta = findColorMeta(colorVal);
        if (!colorsMap.has(colorMeta.name)) {
          const varImg = (v.featured_image ? (typeof v.featured_image === 'string' ? v.featured_image : v.featured_image.src || v.featured_image.url) : null);
          const matchedImages = images.filter(img => img.alt && img.alt.toLowerCase().includes(colorMeta.name.toLowerCase())).map(img => img.src);
          const finalImages = matchedImages.length ? matchedImages : (varImg ? [varImg] : (primaryImg ? [primaryImg] : []));

          colorsMap.set(colorMeta.name, {
            name: colorMeta.name,
            hex: colorMeta.hex,
            image: varImg || finalImages[0] || primaryImg,
            images: finalImages,
            variantId: v.id
          });
        }
      });

      const colors = colorsMap.size ? Array.from(colorsMap.values()) : (
        primaryImg ? [{ name: 'Default', hex: '#1e293b', image: primaryImg, images: images.map(i => i.src) }] : []
      );

      const sizesSet = new Set();
      variants.forEach(v => {
        if (v.options && Array.isArray(v.options)) {
          v.options.forEach(opt => {
            if (['XS', 'S', 'M', 'L', 'XL', '2XL', '3XL'].includes((opt || '').toUpperCase())) {
              sizesSet.add((opt || '').toUpperCase());
            }
          });
        }
      });
      const sizes = Array.from(sizesSet);

      return {
        id: id,
        handle: handle,
        sku: variants[0]?.sku || `ENM-${id.slice(-6)}`,
        title: title,
        cleanTitle: cleanTitle,
        category: category,
        gender: gender,
        series: series,
        basePrice: basePrice,
        comparePrice: comparePrice,
        badge: badge,
        fabric: customFabric,
        description: sp.description || sp.body_html?.replace(/<[^>]+>/g, '') || '',
        image: primaryImg,
        images: images,
        colors: colors,
        sizes: sizes,
        variants: variants,
        variantId: variants[0]?.id || null,
        supportsCustomization: isCustomizable,
        companionIds: []
      };
    }

    window.getStorefrontCatalogue = function() {
      const rawLive = window.ShopifyLiveProducts || [];
      const liveAdapted = rawLive.map(adaptShopifyProduct).filter(Boolean);
      return liveAdapted;
    };

    window.syncLiveShopifyProducts = function() {
      fetch('/products.json', { cache: 'no-cache' })
        .then(res => {
          if (!res.ok) throw new Error('Live products fetch failed');
          return res.json();
        })
        .then(data => {
          if (data && Array.isArray(data.products) && data.products.length) {
            window.ShopifyLiveProducts = data.products;
            if (typeof renderScrubsGrid === 'function') renderScrubsGrid();
            if (typeof window.renderHomepageTrending === 'function') window.renderHomepageTrending();
            if (typeof window.renderHomepageLiveGrid === 'function') window.renderHomepageLiveGrid();
          }
        })
        .catch(err => {
          console.warn('Live products API notice:', err.message);
        });
    };

    // ------------------------------------------------------------
    // HOVER SLIDESHOW & COLOUR-SPECIFIC IMAGE ENGINE
    // ------------------------------------------------------------
    window.activeHoverTimers = {};
    window.cardImageIndices = {};

    window.getCardActiveImages = function(productId) {
      const catalogue = window.getStorefrontCatalogue();
      const item = catalogue.find(p => String(p.id) === String(productId));
      if (!item) return [];

      const activeColorName = STATE.activeCardColors[productId] || (item.colors?.[0]?.name) || 'Deep Navy';
      const activeColorLower = activeColorName.toLowerCase();

      // 1. Color object specific images (populated during adaptation)
      if (item.colors && item.colors.length) {
        const colObj = item.colors.find(c => {
          const cNameLower = c.name.toLowerCase();
          return cNameLower === activeColorLower || cNameLower.includes(activeColorLower) || activeColorLower.includes(cNameLower);
        });
        if (colObj && colObj.images && colObj.images.length > 0) {
          return colObj.images.map(img => window.ShopifyThemeAssets?.[img] || img);
        }
        if (colObj && colObj.image) {
          const colImg = window.ShopifyThemeAssets?.[colObj.image] || colObj.image;
          // Check if there are other images with this color's alt text
          if (item.images && item.images.length) {
            const matches = item.images.filter(img => img.alt && img.alt.toLowerCase().includes(activeColorLower));
            if (matches.length > 0) {
              return matches.map(img => window.ShopifyThemeAssets?.[img.src] || img.src);
            }
          }
          return [colImg];
        }
      }

      // 2. Filter item.images by alt text matching the active colour name
      if (item.images && item.images.length) {
        const colorMatches = item.images.filter(img => img.alt && (
          img.alt.toLowerCase().includes(activeColorLower) ||
          activeColorLower.split(' ').some(part => part.length > 3 && img.alt.toLowerCase().includes(part))
        ));
        if (colorMatches.length > 0) {
          return colorMatches.map(img => window.ShopifyThemeAssets?.[img.src] || img.src);
        }
      }

      // 3. Fallback: if product has multiple generic images without colour tags
      if (item.images && item.images.length > 1) {
        return item.images.map(img => window.ShopifyThemeAssets?.[img.src || img] || img.src || img);
      }

      return item.image ? [window.ShopifyThemeAssets?.[item.image] || item.image] : [];
    };

    window.handleCardHoverEnter = function(cardEl, productId) {
      if (!cardEl) return;
      if (window.isTouchDevice) return;
      if (window.ThemeSettings?.enable_card_hover_slideshow === false) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const images = window.getCardActiveImages(productId);
      if (!images || images.length <= 1) return;

      if (window.activeHoverTimers[productId]) {
        clearInterval(window.activeHoverTimers[productId]);
      }

      const interval = parseInt(window.ThemeSettings?.card_hover_interval, 10) || 1400;
      const imgEl = cardEl.querySelector('.card-img');
      const dotsBar = cardEl.querySelector('.card-image-dots-bar');
      if (!imgEl) return;

      // Preload image urls
      images.forEach(src => {
        const pImg = new Image();
        pImg.src = src;
      });

      let currentIndex = window.cardImageIndices[productId] || 0;

      window.activeHoverTimers[productId] = setInterval(() => {
        currentIndex = (currentIndex + 1) % images.length;
        window.cardImageIndices[productId] = currentIndex;

        imgEl.src = images[currentIndex];

        if (dotsBar) {
          const dots = dotsBar.querySelectorAll('.card-image-dot');
          dots.forEach((dot, idx) => {
            dot.classList.toggle('active', idx === currentIndex);
          });
        }
      }, interval);
    };

    window.handleCardHoverLeave = function(cardEl, productId) {
      if (!cardEl) return;
      if (window.activeHoverTimers[productId]) {
        clearInterval(window.activeHoverTimers[productId]);
        delete window.activeHoverTimers[productId];
      }
      window.cardImageIndices[productId] = 0;

      const images = window.getCardActiveImages(productId);
      const imgEl = cardEl.querySelector('.card-img');
      const dotsBar = cardEl.querySelector('.card-image-dots-bar');
      if (imgEl && images && images.length) {
        imgEl.src = images[0];
      }
      if (dotsBar) {
        const dots = dotsBar.querySelectorAll('.card-image-dot');
        dots.forEach((dot, idx) => {
          dot.classList.toggle('active', idx === 0);
        });
      }
    };

