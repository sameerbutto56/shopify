      STATE.pdpCompletedSteps.add('colour');

      const title = document.getElementById('pdp-selected-color-title');
      if (title) title.textContent = `Custom Dye: ${name}`;
      const paneName = document.getElementById('pdp-pane-colour-name');
      if (paneName) paneName.textContent = `Custom Dye: ${name}`;

      document.querySelectorAll('#pdp-bottom-swatches-grid .pdp-swatch-item, #pdp-pane-swatches-grid .pdp-swatch-item').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('#pdp-custom-color-swatches .pdp-swatch-item').forEach(btn => {
        btn.classList.toggle('active', btn.textContent.trim() === name);
      });

      renderPdpStepper();
      recalculatePdpSummary();
