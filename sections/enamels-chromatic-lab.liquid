    // Save custom measurements
    window.saveCustomMeasurements = function() {
      const chest = document.getElementById('meas-input-chest')?.value?.trim();
      const waist = document.getElementById('meas-input-waist')?.value?.trim();
      const hips = document.getElementById('meas-input-hips')?.value?.trim() || '40';
