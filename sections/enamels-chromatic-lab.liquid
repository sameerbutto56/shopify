{% comment %}
  ENAMELS CHROMATIC SCRUB LAB — MASTER STOREFRONT SYSTEM (PHASES 1 TO 5)
  Full Interactive Experience:
  Phase 1: Header Navigation (6 exact categories), 5-Slide Animated Slideshow, Homepage Sections.
  Phase 2: Scrubs Category Landing, Dynamic Collection Page with full filtering & sorting.
  Phase 3: Product Detail View, MAKE YOUR OWN COLOR with live garment canvas, Standard Sizing.
  Phase 4: CUSTOM SIZE Two-Panel Studio (Reference Size Chart + Enter My Measurements),
           Customization & Alteration options with live chest pocket embroidery preview canvas.
  Phase 5: Cart Drawer with full line-item properties preservation & Safe Simulated COD Demo Checkout.
{% endcomment %}

<script src="{{ 'enamels-catalogue-data.js' | asset_url }}" defer></script>

<div class="chromatic-lab-wrapper" id="chromatic-lab-root">

  <!-- ============================================================ -->
  <!-- 1. TOP ANNOUNCEMENT TICKER STRIP                             -->
  <!-- ============================================================ -->
  <div class="chroma-announcement-bar">
    <div class="announcement-track">
      <span>✨ FREE NATIONWIDE DELIVERY IN PAKISTAN OVER RS. 7,000</span>
      <span>💵 CASH ON DELIVERY AVAILABLE ACROSS ALL CITIES</span>
      <span>⚡ 7-DAY HASSLE-FREE SIZE EXCHANGE VIA WHATSAPP</span>
      <span>🪡 HOSPITAL NAME EMBROIDERY & BESPOKE TAILORING AVAILABLE</span>
      <span>✨ FREE NATIONWIDE DELIVERY IN PAKISTAN OVER RS. 7,000</span>
      <span>💵 CASH ON DELIVERY AVAILABLE ACROSS ALL CITIES</span>
      <span>⚡ 7-DAY HASSLE-FREE SIZE EXCHANGE VIA WHATSAPP</span>
      <span>🪡 HOSPITAL NAME EMBROIDERY & BESPOKE TAILORING AVAILABLE</span>
    </div>
  </div>

  <!-- ============================================================ -->
  <!-- 2. PHASE 1A: TOP HEADER & EXACT 6-CATEGORY NAVIGATION        -->
  <!-- ============================================================ -->
  <header class="chroma-header" id="chroma-main-header">
    <div class="header-inner page-width">
      <!-- Logo Branding -->
      <a href="#" class="header-logo-link" onclick="window.navigateToView('home'); return false;">
        <span class="logo-mark">E</span>
        <div class="logo-text-group">
          <span class="logo-brand">ENAMELS</span>
          <span class="logo-tag">MEDICAL COUTURE</span>
        </div>
      </a>

      <!-- Exact 6-Category Navigation Bar -->
      <nav class="header-nav-main" aria-label="Main Category Navigation">
        <ul class="nav-links-list">
          <!-- Category 1: Scrubs (with subcollection dropdown) -->
          <li class="nav-item has-dropdown">
            <a href="#category-scrubs" class="nav-link" onclick="window.navigateToView('category-scrubs'); return false;">
              <span>Scrubs</span>
              <svg class="dropdown-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </a>
            <div class="nav-dropdown-menu">
              <a href="#collection-sprinter" onclick="window.navigateToCollection('Sprinter'); return false;">
                <strong>Sprinter Series</strong>
                <span>4-Way Athletic Stretch</span>
              </a>
              <a href="#collection-velora" onclick="window.navigateToCollection('Velora'); return false;">
                <strong>Velora Series</strong>
                <span>Tailored Micro-Drape</span>
              </a>
              <a href="#collection-crown" onclick="window.navigateToCollection('Crown'); return false;">
                <strong>Crown Series</strong>
                <span>Executive Mandarin Collar</span>
              </a>
              <div class="dropdown-divider"></div>
              <a href="#category-scrubs" onclick="window.navigateToView('category-scrubs'); return false;" class="view-all-link">
                View All Scrubs Categories →
              </a>
            </div>
          </li>

          <!-- Category 2: Caps -->
          <li class="nav-item">
            <a href="#collection-caps" class="nav-link" onclick="window.navigateToCollection('caps', 'category'); return false;">
              <span>Caps</span>
              <span class="nav-mini-badge">BunFit™</span>
            </a>
          </li>

          <!-- Category 3: Lab Coats -->
          <li class="nav-item">
            <a href="#collection-lab-coats" class="nav-link" onclick="window.navigateToCollection('lab-coat', 'category'); return false;">
              <span>Lab Coats</span>
            </a>
          </li>

          <!-- Category 4: Wrinkle Free -->
          <li class="nav-item">
            <a href="#collection-wrinkle-free" class="nav-link" onclick="window.navigateToCollection('wrinkle-free', 'feature'); return false;">
              <span>Wrinkle Free</span>
            </a>
          </li>

          <!-- Category 5: Accessories -->
          <li class="nav-item">
            <a href="#collection-accessories" class="nav-link" onclick="window.navigateToCollection('accessories', 'category'); return false;">
              <span>Accessories</span>
            </a>
          </li>

          <!-- Category 6: Sleeves -->
          <li class="nav-item">
            <a href="#collection-sleeves" class="nav-link" onclick="window.navigateToCollection('sleeves', 'feature'); return false;">
              <span>Sleeves</span>
            </a>
          </li>
        </ul>
      </nav>

      <!-- Header Action Controls -->
      <div class="header-actions">
        <!-- Live Product Search -->
        <button type="button" class="header-action-btn search-trigger" onclick="window.toggleSearchModal()" aria-label="Search Catalog">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        </button>

        <!-- Wishlist Toggle -->
        <button type="button" class="header-action-btn wishlist-trigger" onclick="window.toggleWishlistModal()" aria-label="Wishlist">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          <span class="action-counter" id="wishlist-counter">0</span>
        </button>

        <!-- Language Selector -->
        <div class="lang-selector-group">
          <select id="chroma-lang-select" onchange="window.switchLanguage(this.value)" aria-label="Language">
            <option value="en">EN</option>
            <option value="ur">اردو</option>
            <option value="ar">العربية</option>
            <option value="ps">پښتو</option>
            <option value="pa">پنجابی</option>
          </select>
        </div>

        <!-- Live Cart Icon -->
        <button type="button" class="header-action-btn cart-trigger" onclick="window.openCartDrawer()" aria-label="Shopping Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <span class="action-counter cart-badge" id="header-cart-counter">0</span>
        </button>

        <!-- Mobile Menu Hamburger -->
        <button type="button" class="header-action-btn mobile-hamburger" onclick="window.toggleMobileMenu()" aria-label="Toggle Menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div class="mobile-nav-drawer" id="mobile-nav-drawer">
      <div class="mobile-drawer-inner">
        <div class="drawer-header">
          <span class="drawer-title">CATEGORIES</span>
          <button type="button" class="drawer-close-btn" onclick="window.toggleMobileMenu()">✕</button>
        </div>
        <ul class="mobile-links-list">
          <li><a href="#category-scrubs" onclick="window.navigateToView('category-scrubs'); window.toggleMobileMenu();">🩺 Scrubs Collection</a></li>
          <li class="mobile-sub-link"><a href="#collection-sprinter" onclick="window.navigateToCollection('Sprinter'); window.toggleMobileMenu();">↳ Sprinter 4-Way Stretch</a></li>
          <li class="mobile-sub-link"><a href="#collection-velora" onclick="window.navigateToCollection('Velora'); window.toggleMobileMenu();">↳ Velora Tailored Drape</a></li>
          <li class="mobile-sub-link"><a href="#collection-crown" onclick="window.navigateToCollection('Crown'); window.toggleMobileMenu();">↳ Crown Executive Mandarin</a></li>
          <li><a href="#collection-caps" onclick="window.navigateToCollection('caps', 'category'); window.toggleMobileMenu();">🧢 Surgical Caps (BunFit™)</a></li>
          <li><a href="#collection-lab-coats" onclick="window.navigateToCollection('lab-coat', 'category'); window.toggleMobileMenu();">🥼 Lab Coats & Overcoats</a></li>
          <li><a href="#collection-wrinkle-free" onclick="window.navigateToCollection('wrinkle-free', 'feature'); window.toggleMobileMenu();">⚡ Wrinkle-Free Clinical Series</a></li>
          <li><a href="#collection-accessories" onclick="window.navigateToCollection('accessories', 'category'); window.toggleMobileMenu();">🩺 Accessories & Badge Reels</a></li>
          <li><a href="#collection-sleeves" onclick="window.navigateToCollection('sleeves', 'feature'); window.toggleMobileMenu();">💪 Compression Arm Sleeves</a></li>
        </ul>
      </div>
    </div>
  </header>

  <!-- ============================================================ -->
  <!-- 3. MAIN DYNAMIC VIEW CONTAINER                               -->
  <!-- ============================================================ -->
  <main class="chroma-main-content">

    <!-- ========================================================== -->
    <!-- VIEW A: HOMEPAGE VIEW (Default)                            -->
    <!-- ========================================================== -->
    <div class="chroma-view-panel active" id="view-home">

      <!-- PHASE 1B: ANIMATED SLIDESHOW BANNER (5 SLIDES) -->
      <section class="chroma-slideshow-section" id="hero-slideshow" aria-label="Campaign Slideshow">
        <div class="slideshow-container">
          
          <!-- Slide 1: Sprinter Athletic Scrubs -->
          <div class="slide-item active" data-slide="0" style="--slide-accent: #00D6C9;">
            <div class="slide-bg-overlay"></div>
            <div class="slide-content-grid page-width">
              <div class="slide-copy">
                <span class="slide-tag">SPRINTER ATHLETIC SERIES • 2026</span>
                <h2 class="slide-title">COLOUR YOUR<br><span class="highlight-text" style="color: #00D6C9;">CALLING.</span></h2>
                <p class="slide-desc">4-Way mechanical stretch engineered for 36-hour surgical & emergency calls. Saturated in Deep Midnight Navy.</p>
                <div class="slide-btn-row">
                  <button type="button" class="btn-slide-primary" onclick="window.navigateToCollection('Sprinter')">
                    Explore Sprinter Scrubs →
                  </button>
                  <button type="button" class="btn-slide-secondary" onclick="window.openEnamelsPdpModal('demo-sprinter-mens-navy')">
                    Build Your Look (3D Studio)
                  </button>
                </div>
              </div>
              <div class="slide-media">
                <div class="slide-img-frame enamels-3d-card">
                  <img src="{{ 'demo-sprinter-navy.jpg' | asset_url }}" alt="Sprinter Scrub Set" class="slide-photo" width="700" height="850" loading="eager" />
                  <div class="slide-badge badge-top">✦ 4-WAY STRETCH</div>
                  <div class="slide-badge badge-bottom">Rs. 5,150 • DEEP NAVY</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Slide 2: The Colour Lab / 10 Clinical Shades -->
          <div class="slide-item" data-slide="1" style="--slide-accent: #4263FF;">
            <div class="slide-bg-overlay"></div>
            <div class="slide-content-grid page-width">
              <div class="slide-copy">
                <span class="slide-tag">CHROMATIC COLOR LABORATORY</span>
                <h2 class="slide-title">SATURATE YOUR<br><span class="highlight-text" style="color: #4263FF;">SHIFT.</span></h2>
                <p class="slide-desc">Move away from plain clinical white. Discover 10 rich hospital-approved chromatic shades designed to resist bleach, stains, and autoclave heat.</p>
                <div class="slide-btn-row">
                  <a href="#colour-lab" class="btn-slide-primary" onclick="window.scrollToSection('colour-lab')">
                    Enter The Colour Lab →
                  </a>
                  <button type="button" class="btn-slide-secondary" onclick="window.openEnamelsPdpModal('demo-sprinter-mens-navy', 'color')">
                    Make Your Own Color
                  </button>
                </div>
              </div>
              <div class="slide-media">
                <div class="slide-img-frame enamels-3d-card">
                  <img src="{{ 'demo-velora-teal.jpg' | asset_url }}" alt="Velora Scrub in Teal" class="slide-photo" width="700" height="850" loading="lazy" />
                  <div class="slide-badge badge-top">✦ 10 CHROMATIC SHADES</div>
                  <div class="slide-badge badge-bottom">CLINICAL TEAL • BLEACH PROOF</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Slide 3: Velora Series Tailored Drape -->
          <div class="slide-item" data-slide="2" style="--slide-accent: #FF6B6B;">
            <div class="slide-bg-overlay"></div>
            <div class="slide-content-grid page-width">
              <div class="slide-copy">
                <span class="slide-tag">SIGNATURE LUXURY WEAVE</span>
                <h2 class="slide-title">REFINED CLINICAL<br><span class="highlight-text" style="color: #FF6B6B;">DRAPE.</span></h2>
                <p class="slide-desc">Silky-soft liquid drape finish with curved v-neck, contour princess seams, and high-waisted fluid drape trousers.</p>
                <div class="slide-btn-row">
                  <button type="button" class="btn-slide-primary" onclick="window.navigateToCollection('Velora')">
                    Shop Velora Series →
                  </button>
                  <button type="button" class="btn-slide-secondary" onclick="window.openSizeGuideModal()">
                    View Size Guide
                  </button>
                </div>
              </div>
              <div class="slide-media">
                <div class="slide-img-frame enamels-3d-card">
                  <img src="{{ 'demo-crown-burgundy.jpg' | asset_url }}" alt="Crown Executive Scrub" class="slide-photo" width="700" height="850" loading="lazy" />
                  <div class="slide-badge badge-top">✦ FLUID MICRO-DRAPE</div>
                  <div class="slide-badge badge-bottom">Rs. 5,500 • CROWN BURGUNDY</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Slide 4: BunFit™ Expandable Caps -->
          <div class="slide-item" data-slide="3" style="--slide-accent: #D9FF70;">
            <div class="slide-bg-overlay"></div>
            <div class="slide-content-grid page-width">
              <div class="slide-copy">
                <span class="slide-tag">PATENTED HEADWEAR ERGONOMICS</span>
                <h2 class="slide-title">SURGICAL CAPS<br><span class="highlight-text" style="color: #D9FF70;">PERFECTED.</span></h2>
                <p class="slide-desc">Patented expandable BunFit™ pleating comfortably accommodates hair buns, braids, and curls with built-in terry cloth forehead sweatbands.</p>
                <div class="slide-btn-row">
                  <button type="button" class="btn-slide-primary" onclick="window.navigateToCollection('caps', 'category')">
                    Shop Surgical Caps →
                  </button>
                  <button type="button" class="btn-slide-secondary" onclick="window.addDuoBundleToCart()">
                    Shift Duo Kit (Save Rs. 500)
                  </button>
                </div>
              </div>
              <div class="slide-media">
                <div class="slide-img-frame enamels-3d-card">
                  <img src="{{ 'demo-velora-teal.jpg' | asset_url }}" alt="BunFit Surgical Cap" class="slide-photo" width="700" height="850" loading="lazy" />
                  <div class="slide-badge badge-top">✦ BUNFIT™ EXPANDABLE</div>
                  <div class="slide-badge badge-bottom">Rs. 1,450 • MASK BUTTONS</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Slide 5: Custom Embroidery & Bespoke Fit -->
          <div class="slide-item" data-slide="4" style="--slide-accent: #C9B7FF;">
            <div class="slide-bg-overlay"></div>
            <div class="slide-content-grid page-width">
              <div class="slide-copy">
                <span class="slide-tag">BESPOKE CLINICAL ATELIER</span>
                <h2 class="slide-title">PRECISION<br><span class="highlight-text" style="color: #C9B7FF;">EMBROIDERY.</span></h2>
                <p class="slide-desc">High-precision certified doctor name embroidery, department insignias, hospital crests, and custom alterations tailored to your exact measurements.</p>
                <div class="slide-btn-row">
                  <button type="button" class="btn-slide-primary" onclick="window.openEnamelsPdpModal('demo-sprinter-mens-navy', 'custom')">
                    Start Customising →
                  </button>
                  <a href="#team-orders" class="btn-slide-secondary" onclick="window.scrollToSection('team-orders')">
                    Team & Hospital Orders
                  </a>
                </div>
              </div>
              <div class="slide-media">
                <div class="slide-img-frame enamels-3d-card">
                  <img src="{{ 'demo-sprinter-navy.jpg' | asset_url }}" alt="Custom Embroidery Scrub" class="slide-photo" width="700" height="850" loading="lazy" />
                  <div class="slide-badge badge-top">✦ DIGITAL EMBROIDERY</div>
                  <div class="slide-badge badge-bottom">+RS. 450 • LIVE POCKET CANVAS</div>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- Slideshow Navigation Controls -->
        <div class="slideshow-controls page-width">
          <div class="controls-left">
            <button type="button" class="slide-nav-btn prev-btn" onclick="window.prevSlide()" aria-label="Previous Slide">←</button>
            <button type="button" class="slide-nav-btn next-btn" onclick="window.nextSlide()" aria-label="Next Slide">→</button>
            <button type="button" class="slide-pause-btn" id="slide-pause-btn" onclick="window.toggleSlidePause()" aria-label="Pause Auto-Play">⏸</button>
          </div>
          <!-- Indicator Dots & Progress Bar -->
          <div class="slide-dots-container">
            <button type="button" class="dot-btn active" onclick="window.goToSlide(0)"><span class="dot-fill"></span></button>
            <button type="button" class="dot-btn" onclick="window.goToSlide(1)"><span class="dot-fill"></span></button>
            <button type="button" class="dot-btn" onclick="window.goToSlide(2)"><span class="dot-fill"></span></button>
            <button type="button" class="dot-btn" onclick="window.goToSlide(3)"><span class="dot-fill"></span></button>
            <button type="button" class="dot-btn" onclick="window.goToSlide(4)"><span class="dot-fill"></span></button>
          </div>
        </div>
      </section>

      <!-- PHASE 1C: SHOP BY MAIN CATEGORY (EXACT 6 CATEGORIES) -->
      <section class="chromatic-section category-showcase-section" id="main-categories">
        <div class="page-width">
          <div class="section-title-wrap">
            <span class="section-accent-tag">PRODUCT TAXONOMY</span>
            <h2 class="section-heading">Shop by Main Category</h2>
            <p class="section-subheading">Engineered medical apparel and accessories built for high-demand clinical environments.</p>
          </div>

          <div class="main-categories-grid">
            <!-- 1. Scrubs -->
            <div class="category-card enamels-3d-card" onclick="window.navigateToView('category-scrubs')">
              <div class="cat-card-media">
                <img src="{{ 'demo-sprinter-navy.jpg' | asset_url }}" alt="Scrubs Collection" width="400" height="500" loading="lazy" />
                <span class="cat-pill">CORE APPAREL</span>
              </div>
              <div class="cat-card-body">
                <h3>1. Scrubs</h3>
                <p>Sprinter, Velora & Crown Sets (26 Designs)</p>
                <span class="cat-card-cta">Explore Scrub Series →</span>
              </div>
            </div>

            <!-- 2. Caps -->
            <div class="category-card enamels-3d-card" onclick="window.navigateToCollection('caps', 'category')">
              <div class="cat-card-media">
                <img src="{{ 'demo-velora-teal.jpg' | asset_url }}" alt="Caps Collection" width="400" height="500" loading="lazy" />
                <span class="cat-pill" style="background:#00D6C9; color:#0B1224;">BUNFIT™ TECH</span>
              </div>
              <div class="cat-card-body">
                <h3>2. Caps</h3>
                <p>Volume Hair Pleating & Sweatbands (6 Designs)</p>
                <span class="cat-card-cta">Explore Surgical Caps →</span>
              </div>
            </div>

            <!-- 3. Lab Coats -->
            <div class="category-card enamels-3d-card" onclick="window.navigateToCollection('lab-coat', 'category')">
              <div class="cat-card-media">
                <img src="{{ 'demo-crown-burgundy.jpg' | asset_url }}" alt="Lab Coats Collection" width="400" height="500" loading="lazy" />
                <span class="cat-pill" style="background:#4263FF; color:#ffffff;">EXECUTIVE CUT</span>
              </div>
              <div class="cat-card-body">
                <h3>3. Lab Coats</h3>
                <p>Consultant & Specialist Notch Lapels (3 Designs)</p>
                <span class="cat-card-cta">Explore Lab Coats →</span>
              </div>
            </div>

            <!-- 4. Wrinkle Free -->
            <div class="category-card enamels-3d-card" onclick="window.navigateToCollection('wrinkle-free', 'feature')">
              <div class="cat-card-media">
                <img src="{{ 'demo-sprinter-navy.jpg' | asset_url }}" alt="Wrinkle Free Collection" width="400" height="500" loading="lazy" />
                <span class="cat-pill" style="background:#D9FF70; color:#0B1224;">ZERO IRONING</span>
              </div>
              <div class="cat-card-body">
                <h3>4. Wrinkle Free</h3>
                <p>High-Density Technical Gabardine Weave</p>
                <span class="cat-card-cta">Explore Wrinkle Free →</span>
              </div>
            </div>

            <!-- 5. Accessories -->
            <div class="category-card enamels-3d-card" onclick="window.navigateToCollection('accessories', 'category')">
              <div class="cat-card-media">
                <img src="{{ 'demo-velora-teal.jpg' | asset_url }}" alt="Accessories Collection" width="400" height="500" loading="lazy" />
                <span class="cat-pill" style="background:#FF6B6B; color:#ffffff;">ESSENTIALS</span>
              </div>
              <div class="cat-card-body">
                <h3>5. Accessories</h3>
                <p>Badge Reels, Stethoscope Charms & Eyewear</p>
                <span class="cat-card-cta">Explore Accessories →</span>
              </div>
            </div>

            <!-- 6. Sleeves -->
            <div class="category-card enamels-3d-card" onclick="window.navigateToCollection('sleeves', 'feature')">
              <div class="cat-card-media">
                <img src="{{ 'demo-crown-burgundy.jpg' | asset_url }}" alt="Sleeves Collection" width="400" height="500" loading="lazy" />
                <span class="cat-pill" style="background:#C9B7FF; color:#0B1224;">COMPRESSION</span>
              </div>
              <div class="cat-card-body">
                <h3>6. Sleeves</h3>
                <p>Gradient Muscle Support & Antimicrobial Nylon</p>
                <span class="cat-card-cta">Explore Medical Sleeves →</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- FEATURED COLLECTIONS: SPRINTER • VELORA • CROWN -->
      <section class="chromatic-section collections-spotlight-section" id="featured-collections">
        <div class="page-width">
          <div class="section-title-wrap">
            <span class="section-accent-tag">PROPRIETARY SERIES</span>
            <h2 class="section-heading">Signature Scrub Series</h2>
            <p class="section-subheading">Three proprietary architectural lines crafted for distinct clinical roles.</p>
          </div>

          <div class="series-trio-grid">
            <!-- Sprinter Series -->
            <div class="series-card enamels-3d-card">
              <div class="series-image-wrap">
                <span class="series-badge">ATHLETIC 4-WAY STRETCH</span>
                <img src="{{ 'demo-sprinter-navy.jpg' | asset_url }}" alt="Sprinter Series" width="600" height="750" loading="lazy" />
              </div>
              <div class="series-body">
                <h3 class="series-title">Sprinter Series</h3>
                <p class="series-tagline">Engineered for Rapid Response Shifts</p>
                <ul class="series-features">
                  <li>✦ 72% Poly / 21% Rayon / 7% Spandex</li>
                  <li>✦ Ergonomic raglan sleeve mobility</li>
                  <li>✦ 6-pocket cargo tactical joggers</li>
