    function renderCategoryCardsForGender(gender, activeCat = 'all') {
      const container = document.getElementById('collection-category-cards-grid');
      if (!container) return;

      const categoriesOrder = ['scrubs', 'lab-coat', 'caps', 'accessories'];

      const cardsHtml = categoriesOrder.map((catKey, index) => {
        const count = getCategoryCount(gender, catKey);
        if (count === 0) return '';
        const meta = CATEGORY_META[catKey];
        const isActive = activeCat === catKey;
        const imgUrl = window.ShopifyThemeAssets?.[meta.image] || meta.image;
        const animDelay = index * 70;

        return `
          <div class="collection-category-card-3d-wrap" style="animation-delay: ${animDelay}ms;">
            <div
              class="collection-category-card ${isActive ? 'active' : ''}"
              data-cat="${catKey}"
              onclick="window.selectProductCategory('${catKey}')"
              role="button"
              tabindex="0"
              aria-label="${gender === 'women' ? "Women's" : "Men's"} ${meta.name} (${count} Designs)"
            >
