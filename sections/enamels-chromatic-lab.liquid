    function handleHashRouting() {
      const searchParams = new URLSearchParams(window.location.search);
      const genderQuery = (searchParams.get('gender') || '').toLowerCase();
      const categoryQuery = (searchParams.get('category') || searchParams.get('cat') || '').toLowerCase();
      const brandQuery = (searchParams.get('brand') || searchParams.get('series') || '').toLowerCase();
      const viewQuery = (searchParams.get('view') || '').toLowerCase();
      const colorQuery = (searchParams.get('color') || searchParams.get('shade') || '').toLowerCase();
      const searchQuery = (searchParams.get('q') || searchParams.get('query') || searchParams.get('search') || '').toLowerCase();

      if (searchQuery && typeof window.searchStorefrontCatalogue === 'function') {
        window.searchStorefrontCatalogue(searchQuery);
        return;
      }
      if (colorQuery && typeof window.filterCatalogueByColor === 'function') {
