    };

    // Real Shopify Checkout Bridge & Cart Synchronization
    window.proceedToShopifyCheckout = async function() {
      const cart = getStoredCart();
      if (!cart || !cart.length) {
        alert('Your cart is empty. Please select a product first.');
        return;
      }

      const checkoutBtn = document.getElementById('btn-cart-shopify-checkout');
      if (checkoutBtn) {
        checkoutBtn.disabled = true;
        checkoutBtn.innerHTML = 'Connecting to Shopify Checkout...';
      }

      try {
        // Clear Shopify cart first
        await fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } });

        // Build item payloads with customizer line-item properties
        const fallbackVariantId = window.ShopifyLiveProducts?.[0]?.variants?.[0]?.id || null;
        const itemsPayload = cart.map(item => {
          const props = { ...(item.properties || {}) };
          if (!props['Article']) props['Article'] = item.title;
          if (item.color && !props['Colour']) props['Colour'] = item.color;
          if (item.size && !props['Size']) props['Size'] = item.size;
          if (item.isCustomSize && !props['Tailoring Specification']) {
            props['Tailoring Specification'] = 'Custom Tailored Specification (C)';
          }

          const variantId = item.variantId || item.variant_id || fallbackVariantId;
          if (!variantId) return null;
          return {
            id: variantId,
            quantity: item.quantity || 1,
            properties: props
          };
        }).filter(Boolean);

        if (!itemsPayload.length) {
          alert('No valid product variant selected. Please choose an in-stock variant.');
          return;
        }

        const addRes = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: itemsPayload })
        });

        if (!addRes.ok) {
          throw new Error(`Cart add failed with status ${addRes.status}`);
        }

        // Synchronize destination and shipping rate attributes before redirecting
        if (typeof window.calculateShippingCharges === 'function') {
          try {
            const destCountry = (typeof window.getActiveShippingCountry === 'function')
              ? window.getActiveShippingCountry()
              : (localStorage.getItem('enamels_delivery_country') || 'Pakistan');
            const subtotal = cart.reduce((sum, it) => sum + ((it.unitPrice || it.price || 0) * (it.quantity || 1)), 0);
            const comp = typeof window.analyzeCartComposition === 'function'
              ? window.analyzeCartComposition(cart)
              : { Q: cart.length, A: 0 };
            const shipResult = window.calculateShippingCharges(destCountry, subtotal, cart);
            const isDom = !destCountry || destCountry.toLowerCase() === 'pk' || destCountry.toLowerCase().includes('pak');

            await fetch('/cart/update.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                attributes: {
                  'Delivery Country Code': isDom ? 'PK' : destCountry,
                  'Delivery Destination': isDom ? 'Pakistan' : destCountry,
                  'Scrub Units (Q)': comp.Q,
                  'Chargeable Add-on Units (A)': comp.A,
                  'Estimated Shipping (PKR)': shipResult.shippingFee,
                  'Shipping Rate Calculation': shipResult.formulaText
                }
              })
            });
          } catch (shipErr) {
            console.warn('Shipping attributes sync warning:', shipErr);
          }
        }

        window.location.href = '/checkout';
      } catch (err) {
        console.error('Shopify checkout sync error:', err);
        window.location.href = '/checkout';
      } finally {
        if (checkoutBtn) {
          checkoutBtn.disabled = false;
          checkoutBtn.innerHTML = 'Proceed to Shopify Checkout <span aria-hidden="true">→</span>';
        }
      }
    };

    window.submitBankOrder = async function() {
      withCartDebounce(async () => {
        const name = document.getElementById('bank-order-name')?.value;
        const phone = document.getElementById('bank-order-phone')?.value;
        const addr = document.getElementById('bank-order-address')?.value;

        if (!name || !phone || !addr) {
          alert('Please provide your Name, WhatsApp/Phone, and Delivery Address to receive your reference number.');
          return;
        }

        const refNumber = `ENM-2026-${Math.floor(10000 + Math.random() * 90000)}`;

        // Sync items to Shopify cart in background so checkout is populated
        try {
          const cart = getStoredCart();
          if (cart && cart.length) {
            await fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
            const fallbackVariantId = window.ShopifyLiveProducts?.[0]?.variants?.[0]?.id || null;
            const itemsPayload = cart.map(item => {
              const variantId = item.variantId || item.variant_id || fallbackVariantId;
              if (!variantId) return null;
              return {
                id: variantId,
                quantity: item.quantity || 1,
                properties: {
                  ...(item.properties || {}),
                  'Order Reference': refNumber,
                  'Customer Name': name,
                  'Customer Phone': phone
                }
              };
            }).filter(Boolean);
            if (itemsPayload.length) {
              await fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items: itemsPayload })
              });
            }
            let shippingAttrs = {};
            if (typeof window.calculateShippingCharges === 'function') {
              try {
                const destCountry = (typeof window.getActiveShippingCountry === 'function')
                  ? window.getActiveShippingCountry()
                  : (localStorage.getItem('enamels_delivery_country') || 'Pakistan');
                const isDom = !destCountry || destCountry.toLowerCase() === 'pk' || destCountry.toLowerCase().includes('pak');
                const subtotal = cart.reduce((sum, it) => sum + ((it.unitPrice || it.price || 0) * (it.quantity || 1)), 0);
                const comp = typeof window.analyzeCartComposition === 'function' ? window.analyzeCartComposition(cart) : { Q: cart.length, A: 0 };
                const shipResult = window.calculateShippingCharges(destCountry, subtotal, cart);
                shippingAttrs = {
                  'Delivery Country Code': isDom ? 'PK' : destCountry,
                  'Delivery Destination': isDom ? 'Pakistan' : destCountry,
                  'Scrub Units (Q)': comp.Q,
                  'Chargeable Add-on Units (A)': comp.A,
                  'Estimated Shipping (PKR)': shipResult.shippingFee,
                  'Shipping Rate Calculation': shipResult.formulaText
                };
              } catch (e) {}
            }

            await fetch('/cart/update.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                note: `Bank Transfer Order ${refNumber} - ${name} (${phone}) - Delivery: ${addr}`,
                attributes: {
                  'Enamels Reference': refNumber,
                  'Customer Name': name,
                  'Customer Phone': phone,
                  'Delivery Address': addr,
