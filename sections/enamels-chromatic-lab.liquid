        `;
      }).filter(Boolean).join('');

      container.innerHTML = cardsHtml;
      initCategoryCards3DTilt(container);
    }

    function initCategoryCards3DTilt(container) {
      if (!container) return;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isTouch = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
      if (prefersReducedMotion || isTouch) return;

      const wraps = container.querySelectorAll('.collection-category-card-3d-wrap');
      wraps.forEach(wrap => {
        const card = wrap.querySelector('.collection-category-card');
        const glare = wrap.querySelector('.category-card-glare');
        if (!card) return;

        let rect = null;
        let rafId = null;

        function onMouseEnter() {
          rect = wrap.getBoundingClientRect();
          card.style.transition = 'transform 0.1s ease-out, box-shadow 0.3s ease, border-color 0.3s ease';
          if (glare) glare.style.opacity = '1';
        }

        function onMouseMove(e) {
          if (!rect) rect = wrap.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;

          const rotateX = ((centerY - y) / centerY) * 5;
          const rotateY = ((x - centerX) / centerX) * 5;

          if (glare) {
            const glareX = (x / rect.width) * 100;
            const glareY = (y / rect.height) * 100;
            glare.style.background = `radial-gradient(circle at ${glareX}% ${glareY}%, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0) 65%)`;
          }

          if (rafId) cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(() => {
            card.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) translateZ(6px)`;
          });
        }

        function onMouseLeave() {
          if (rafId) cancelAnimationFrame(rafId);
          rect = null;
          card.style.transition = 'transform 0.5s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.4s ease, border-color 0.3s ease';
          card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(0px)';
          if (glare) glare.style.opacity = '0';
        }

        wrap.addEventListener('mouseenter', onMouseEnter, { passive: true });
        wrap.addEventListener('mousemove', onMouseMove, { passive: true });
        wrap.addEventListener('mouseleave', onMouseLeave, { passive: true });
      });
    }

    function renderArticleFilterPills(gender, catKey, activeArticle = 'all') {
      const container = document.getElementById('article-filter-pills-container');
      if (!container) return;

      const catalogue = (typeof window.getStorefrontCatalogue === 'function') ? window.getStorefrontCatalogue() : (window.EnamelsCatalogue || []);
      const matchingItems = catalogue.filter(item => {
        const matchesGender = (gender === 'all') || (item.gender === gender || item.gender === 'unisex');
        if (!matchesGender) return false;
        if (catKey === 'all') return true;
        if (catKey === 'accessories') {
          const topCat = getTopCategory(item);
          return topCat === 'accessories' || topCat === 'caps' || topCat === 'sleeves';
        }
        return getTopCategory(item) === catKey;
      });

      const totalCount = matchingItems.length;

      let baseList;
      if (catKey === 'all') {
        baseList = ['Sprinter', 'Crown', 'Ground', 'Vilora', 'Helium', 'Suiting', 'BunFit', 'Accessories'];
      } else {
        const seriesOrderMap = {
          'scrubs': gender === 'women' ? ['Vilora', 'Sprinter', 'Crown', 'Ground'] : ['Sprinter', 'Crown', 'Ground'],
          'lab-coat': ['Helium', 'Suiting'],
          'caps': ['BunFit'],
          'sleeves': ['Accessories'],
          'accessories': ['BunFit', 'Accessories']
        };
        baseList = [...(seriesOrderMap[catKey] || ['Sprinter', 'Crown', 'Ground', 'Vilora'])];
      }

      // Add other series if found in catalogue
      matchingItems.forEach(item => {
        const disp = getDisplayBrandName(item.series);
        if (disp && !baseList.includes(disp)) {
          baseList.push(disp);
        }
      });

      // Filter to brands that actually have matching items
      const availableBrands = baseList.filter(bName => {
        const can = canonicalizeBrand(bName);
        return matchingItems.some(item => canonicalizeBrand(item.series) === can);
      });

      const activeCan = canonicalizeBrand(activeArticle);
      const isAllActive = (activeArticle === 'all' || !activeArticle || activeCan === 'all');
      const allLabel = (catKey === 'all') ? 'All Brands' : 'All';

      let pillsHtml = `
        <button
          type="button"
          class="filter-pill-btn ${isAllActive ? 'active' : ''}"
          id="filter-pill-all"
          onclick="window.setArticleFilter('all')"
          aria-label="${allLabel} (${totalCount})"
        >
          <span class="filter-pill-text">${allLabel}</span>
          <span class="filter-pill-count">${totalCount}</span>
        </button>
      `;

      availableBrands.forEach(bName => {
        const can = canonicalizeBrand(bName);
        const brandCount = matchingItems.filter(item => canonicalizeBrand(item.series) === can).length;
        const isActive = (activeCan === can);
        const pillId = `filter-pill-${bName.toLowerCase().replace(/[^a-z0-9]/g, '')}`;
        pillsHtml += `
          <button
            type="button"
            class="filter-pill-btn ${isActive ? 'active' : ''}"
            id="${pillId}"
            onclick="window.setArticleFilter('${bName}')"
            aria-label="${bName} collection (${brandCount})"
          >
            <span class="filter-pill-text">${bName}</span>
            <span class="filter-pill-count">${brandCount}</span>
          </button>
        `;
      });

      container.innerHTML = pillsHtml;
    }

    window.setGenderFilter = function(gender) {
      window.navigateToGender(gender, STATE.productCategoryFilter || 'all', STATE.articleFilter || 'all');
    };

    window.sortScrubsCatalogue = function(val) {
      STATE.sortOrder = val;
      renderScrubsGrid();
    };

    function getFilteredCatalogue() {
      const catalogue = (typeof window.getStorefrontCatalogue === 'function') ? window.getStorefrontCatalogue() : (window.EnamelsCatalogue || []);
      return catalogue.filter(item => {
        // Seasonal collection filter
        if (STATE.seasonFilter) {
          if (item.season !== STATE.seasonFilter && !item.season?.includes(STATE.seasonFilter)) {
            return false;
          }
        }

        // View Mode: Brand Collection Page (e.g. Vilora, Splender, Ground, FlexFit, Helium, BunFit)
        if (STATE.viewMode === 'brand' && STATE.activeBrand && STATE.activeBrand !== 'all') {
          const itemSeries = canonicalizeBrand(item.series);
          const activeSeries = canonicalizeBrand(STATE.activeBrand);
          if (itemSeries !== activeSeries) return false;

          // Gender filter within Brand Collection (All / Men / Women)
          if (STATE.brandGender && STATE.brandGender !== 'all') {
            if (item.gender !== STATE.brandGender && item.gender !== 'unisex') return false;
          }
          return true;
        }

        // Gender filter for Men's, Women's, or All
        if (STATE.genderFilter && STATE.genderFilter !== 'all') {
          if (item.gender !== STATE.genderFilter && item.gender !== 'unisex') return false;
        }

        // Product Category filter
        if (STATE.productCategoryFilter && STATE.productCategoryFilter !== 'all') {
          const topCat = getTopCategory(item);
          if (STATE.productCategoryFilter === 'accessories') {
            if (topCat !== 'accessories' && topCat !== 'caps' && topCat !== 'sleeves') return false;
          } else {
            if (topCat !== STATE.productCategoryFilter) return false;
          }
        }

        // Article/Series/Brand filter within Gender or Category
        if (STATE.articleFilter && STATE.articleFilter !== 'all') {
          const itemSeries = canonicalizeBrand(item.series);
          const targetSeries = canonicalizeBrand(STATE.articleFilter);
          if (itemSeries !== targetSeries) return false;
        }

        return true;
      });
    }

    function renderCategoryOnly(cat) {
      window.selectProductCategory(cat);
    }

    function renderScrubsGrid() {
      const items = getFilteredCatalogue();
      renderGridWithItems(items);
    }
    window.getFilteredCatalogue = getFilteredCatalogue;
    window.renderScrubsGrid = renderScrubsGrid;

    // LEVEL 5: INTERACTIVE COLOR SELECTION & MULTI-IMAGE CARDS
    window.setProductCardColor = function(productId, colorName) {
      if (window.activeHoverTimers[productId]) {
        clearInterval(window.activeHoverTimers[productId]);
        delete window.activeHoverTimers[productId];
      }
      window.cardImageIndices[productId] = 0;

      STATE.activeCardColors[productId] = colorName;

      document.querySelectorAll(`.card-color-label-${productId}`).forEach(lbl => {
        lbl.innerHTML = `Colour: <strong>${colorName}</strong>`;
      });
      const singleLbl = document.getElementById(`card-color-label-${productId}`);
      if (singleLbl) singleLbl.innerHTML = `Colour: <strong>${colorName}</strong>`;

      const cards = document.querySelectorAll(`.product-preview-card[data-product-id="${productId}"]`);
      const activeImages = window.getCardActiveImages(productId);

      cards.forEach(card => {
        card.querySelectorAll('.card-color-dot-btn').forEach(btn => {
          btn.classList.toggle('active', btn.getAttribute('title') === colorName);
        });

        const imgEl = card.querySelector('.card-img');
        if (imgEl && activeImages && activeImages.length) {
          imgEl.src = activeImages[0];
        }

        const dotsBar = card.querySelector('.card-image-dots-bar');
        if (dotsBar) {
          if (activeImages.length > 1 && window.ThemeSettings?.show_card_image_dots !== false) {
            dotsBar.style.display = 'flex';
            dotsBar.innerHTML = activeImages.map((_, idx) => `<span class="card-image-dot ${idx === 0 ? 'active' : ''}"></span>`).join('');
          } else {
            dotsBar.style.display = 'none';
          }
        }
      });
    };

    window.getProductCardColor = function(productId) {
      if (STATE.activeCardColors[productId]) return STATE.activeCardColors[productId];
      const catalogue = (typeof window.getStorefrontCatalogue === 'function') ? window.getStorefrontCatalogue() : (window.EnamelsCatalogue || []);
      const item = catalogue.find(p => p.id === productId);
      return (item && item.colors && item.colors[0]) ? item.colors[0].name : 'Deep Navy';
    };

    window.renderProductCardHtml = function(item, idx = 0, customClass = '') {
      const cleanTitle = (item.title || '').replace('DEMO — ', '');
      const colors = item.colors || [];
      const activeColorName = window.getProductCardColor(item.id);
      const activeImages = window.getCardActiveImages(item.id);
      const activeImg = activeImages[0] || (window.ShopifyThemeAssets?.[item.image] || item.image);
      const displayImg = window.ShopifyThemeAssets?.[activeImg] || activeImg;
      const animDelay = Math.min(idx * 35, 280);
      const aspectRatio = window.ThemeSettings?.card_image_aspect_ratio || '2/3';

      const colorsHtml = colors.map(c => {
        const isSelected = c.name === activeColorName;
        const escapedName = c.name.replace(/'/g, "\\'");
        return `
          <button
            type="button"
            class="card-color-dot-btn ${isSelected ? 'active' : ''}"
            style="background-color: ${c.hex};"
            title="${c.name}"
            onclick="event.stopPropagation(); window.setProductCardColor('${item.id}', '${escapedName}')"
            aria-label="${c.name} color swatch"
          ></button>
        `;
      }).join('');

      const isSimple = item.category === 'caps' || item.category === 'sleeves' || item.category === 'accessories';
      const actionBtn = isSimple
        ? `<button type="button" class="btn-card-action" onclick="window.openSimpleProductModal('${item.id}')">Quick Add</button>`
        : `<button type="button" class="btn-card-action" onclick="window.openProductStudio('${item.id}', window.getProductCardColor('${item.id}'))">Customize & Select</button>`;

      const showDots = (activeImages.length > 1 && window.ThemeSettings?.show_card_image_dots !== false);

      return `
        <div
          class="product-preview-card ${customClass}"
          data-product-id="${item.id}"
          data-aspect="${aspectRatio}"
          onmouseenter="window.handleCardHoverEnter(this, '${item.id}')"
          onmouseleave="window.handleCardHoverLeave(this, '${item.id}')"
          style="animation-delay: ${animDelay}ms;"
        >
          <div class="card-thumb-wrap" data-aspect="${aspectRatio}" onclick="window.openProductStudio('${item.id}', window.getProductCardColor('${item.id}'))">
            <img
              src="${displayImg}"
              alt="${cleanTitle}"
              class="card-img"
              id="card-img-${item.id}"
              onerror="this.src='{{ 'cat-sprinter.jpg' | asset_url }}'"
              loading="lazy"
            />
            ${item.badge ? `<span class="card-pill-tag">${item.badge}</span>` : ''}
            <div class="card-image-dots-bar" style="${showDots ? 'display:flex;' : 'display:none;'}">
              ${activeImages.map((_, dIdx) => `<span class="card-image-dot ${dIdx === 0 ? 'active' : ''}"></span>`).join('')}
            </div>
          </div>
          <div class="card-body-wrap">
            <span class="card-series-tag">${item.series ? item.series.toUpperCase() + ' SERIES' : (getTopCategory(item).toUpperCase())}</span>
            <h3 class="card-title-text" onclick="window.openProductStudio('${item.id}', window.getProductCardColor('${item.id}'))">${cleanTitle}</h3>
            <div class="card-pricing-row">
              <span class="card-current-price">Rs. ${item.basePrice.toLocaleString()}</span>
              ${item.comparePrice ? `<span class="card-compare-price">Rs. ${item.comparePrice.toLocaleString()}</span>` : ''}
            </div>
            <div class="card-active-color-label card-color-label-${item.id}" id="card-color-label-${item.id}">
              Colour: <strong>${activeColorName}</strong>
            </div>
            <div class="card-color-swatches-wrap" onclick="event.stopPropagation();">
              ${colorsHtml}
            </div>
            ${actionBtn}
          </div>
        </div>
      `;
    };

    function renderGridWithItems(items) {
      const grid = document.getElementById('scrubs-products-grid');
      const countEl = document.getElementById('scrubs-visible-count');
      if (!grid) return;

      if (countEl) countEl.textContent = items.length;

      // Sort items
      const sorted = [...items];
      if (STATE.sortOrder === 'price-low') {
        sorted.sort((a, b) => a.basePrice - b.basePrice);
      } else if (STATE.sortOrder === 'price-high') {
        sorted.sort((a, b) => b.basePrice - a.basePrice);
      } else if (STATE.sortOrder === 'name') {
        sorted.sort((a, b) => a.title.localeCompare(b.title));
      }

      const emptyStateBox = document.getElementById('brand-empty-state-box');
      const emptyTitle = document.getElementById('empty-state-title');
      const emptyMsg = document.getElementById('empty-state-message');

      if (!sorted.length) {
        if (emptyStateBox) {
          if (STATE.viewMode === 'brand') {
            const bName = getDisplayBrandName(STATE.activeBrand);
            const genderLabel = STATE.brandGender === 'men' ? "Men's" : STATE.brandGender === 'women' ? "Women's" : "Selected";
            if (emptyTitle) emptyTitle.textContent = `No ${bName} Products in ${genderLabel} Collection`;
            if (emptyMsg) emptyMsg.textContent = `We currently do not have any ${STATE.brandGender !== 'all' ? (STATE.brandGender === 'men' ? "men's" : "women's") : ''} articles in the ${bName} line. Try selecting another filter or exploring our complete catalogue.`;
          } else {
            if (emptyTitle) emptyTitle.textContent = 'No Matching Products Found';
            if (emptyMsg) emptyMsg.textContent = 'No products match the selected filters. Try choosing "All" or a different brand.';
          }
          emptyStateBox.style.display = 'block';
          grid.innerHTML = '';
          const railMount = document.getElementById('enamels-hanging-rail-mount');
          if (railMount) railMount.innerHTML = '';
        } else {
          grid.innerHTML = `
            <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; background: #f8fafc; border-radius: 12px; border: 1.5px dashed #cbd5e1;">
              <div style="font-size: 36px; margin-bottom: 10px;">🩺</div>
              <h3 style="font-size: 17px; font-weight: 700; color: #102a43; margin-bottom: 6px;">No Products Found</h3>
              <p style="font-size: 13px; color: #64748b; margin-bottom: 18px;">No designs match the selected filter in this category.</p>
              <button type="button" class="filter-pill-btn active" onclick="window.resetBrandFilters();">Reset Filters</button>
            </div>
          `;
        }
        return;
      }

      if (emptyStateBox) emptyStateBox.style.display = 'none';
      grid.innerHTML = sorted.map((item, idx) => window.renderProductCardHtml(item, idx)).join('');

      // Update Boutique Hanging Rail
      const railMount = document.getElementById('enamels-hanging-rail-mount');
      if (railMount && typeof window.renderHangingRailHtml === 'function') {
        railMount.innerHTML = window.renderHangingRailHtml(sorted);
        if (typeof window.initHangingRail === 'function') {
          window.initHangingRail();
        }
      }

      // Respect active view mode
      const activeMode = window.EnamelsRailState?.viewMode || 'rail';
      if (railMount) railMount.style.display = (activeMode === 'rail') ? 'block' : 'none';
      grid.style.display = (activeMode === 'grid') ? 'grid' : 'none';
    }
    window.renderGridWithItems = renderGridWithItems;

    window.filterCatalogueByColor = function(hexCode, colorName) {
      STATE.viewMode = 'gender';
      STATE.genderFilter = 'all';
      STATE.productCategoryFilter = 'all';
      STATE.articleFilter = 'all';
      window.navigateToView('category-scrubs');

      const landingView = document.getElementById('subview-category-landing');
      const listingView = document.getElementById('subview-product-listing');
      const filterBar = document.getElementById('product-listing-filter-bar');
      const brandGenderBar = document.getElementById('brand-gender-filter-bar');
      if (landingView) landingView.style.display = 'none';
      if (listingView) listingView.style.display = 'block';
      if (brandGenderBar) brandGenderBar.style.display = 'none';
      if (filterBar) filterBar.style.display = 'block';

      const listingCatTag = document.getElementById('product-listing-category-tag');
      if (listingCatTag) listingCatTag.textContent = `HOSPITAL SHADE: ${colorName.toUpperCase()}`;

      const listingCatTitle = document.getElementById('product-listing-category-title');
      if (listingCatTitle) listingCatTitle.textContent = `${colorName} Clinical Scrubs`;

      const listingCatDesc = document.getElementById('product-listing-category-desc');
      if (listingCatDesc) listingCatDesc.textContent = `Official ${colorName} hospital-approved uniform shades and clinical coordinates.`;

      const catalogue = (typeof window.getStorefrontCatalogue === 'function') ? window.getStorefrontCatalogue() : (window.EnamelsCatalogue || []);
      const lowerColor = (colorName || '').toLowerCase();

      catalogue.forEach(item => {
        if (item.colors && item.colors.some(c => c.name.toLowerCase().includes(lowerColor) || lowerColor.includes(c.name.toLowerCase()))) {
          STATE.activeCardColors[item.id] = colorName;
        }
      });

      const matched = catalogue.filter(item => {
        return (item.colors || []).some(c => c.name.toLowerCase().includes(lowerColor) || lowerColor.includes(c.name.toLowerCase()));
      });

      renderGridWithItems(matched.length ? matched : catalogue);
      safeUpdateUrlHash(`#color-${encodeURIComponent(colorName.toLowerCase())}`);
    };

    window.searchStorefrontCatalogue = function(term) {
      if (!term || !term.trim()) return;
      const lower = term.toLowerCase().trim();
      STATE.viewMode = 'gender';
      STATE.genderFilter = 'all';
      STATE.productCategoryFilter = 'all';
      STATE.articleFilter = 'all';
      window.navigateToView('category-scrubs');

      const landingView = document.getElementById('subview-category-landing');
      const listingView = document.getElementById('subview-product-listing');
      const filterBar = document.getElementById('product-listing-filter-bar');
      const brandGenderBar = document.getElementById('brand-gender-filter-bar');
      if (landingView) landingView.style.display = 'none';
      if (listingView) listingView.style.display = 'block';
      if (brandGenderBar) brandGenderBar.style.display = 'none';
      if (filterBar) filterBar.style.display = 'block';

      const listingCatTag = document.getElementById('product-listing-category-tag');
      if (listingCatTag) listingCatTag.textContent = `SEARCH RESULTS FOR "${term.toUpperCase()}"`;

      const listingCatTitle = document.getElementById('product-listing-category-title');
      if (listingCatTitle) listingCatTitle.textContent = `Search: "${term}"`;

      const listingCatDesc = document.getElementById('product-listing-category-desc');
      if (listingCatDesc) listingCatDesc.textContent = `Showing all products matching your query "${term}".`;

      const catalogue = (typeof window.getStorefrontCatalogue === 'function') ? window.getStorefrontCatalogue() : (window.EnamelsCatalogue || []);
      const matched = catalogue.filter(p => {
        const t = (p.title || '').toLowerCase();
        const s = (p.series || '').toLowerCase();
        const c = (p.category || '').toLowerCase();
        const f = (p.fabric || '').toLowerCase();
        const d = (p.description || '').toLowerCase();
        const col = (p.colors || []).map(x => (x.name || '').toLowerCase()).join(' ');
        return t.includes(lower) || s.includes(lower) || c.includes(lower) || f.includes(lower) || d.includes(lower) || col.includes(lower);
      });

      renderGridWithItems(matched);
      safeUpdateUrlHash(`#search-${encodeURIComponent(lower)}`);
    };

    // ------------------------------------------------------------
    // HOMEPAGE EDITORIAL & LIVE CATALOGUE CONTROLLERS
    // ------------------------------------------------------------
    let homepageCatFilter = 'all';
    let homepageSortOrder = 'featured';

    window.filterHomepageGrid = function(catKey) {
      homepageCatFilter = catKey;
      document.querySelectorAll('#homepage-category-filter-pills .filter-pill-btn').forEach(btn => {
        btn.classList.toggle('active', btn.id === `hp-filter-${catKey}`);
      });
      window.renderHomepageLiveGrid();
    };

    window.sortHomepageGrid = function(val) {
      homepageSortOrder = val;
      window.renderHomepageLiveGrid();
    };

    window.renderHomepageLiveGrid = function() {
      const grid = document.getElementById('homepage-live-products-grid');
      if (!grid) return;

      const catalogue = (typeof window.getStorefrontCatalogue === 'function') ? window.getStorefrontCatalogue() : (window.EnamelsCatalogue || []);
      const filtered = catalogue.filter(item => {
        if (homepageCatFilter === 'all') return true;
        return getTopCategory(item) === homepageCatFilter;
      });

      const sorted = [...filtered];
      if (homepageSortOrder === 'price-low') {
        sorted.sort((a, b) => a.basePrice - b.basePrice);
      } else if (homepageSortOrder === 'price-high') {
        sorted.sort((a, b) => b.basePrice - a.basePrice);
      } else if (homepageSortOrder === 'name') {
        sorted.sort((a, b) => a.title.localeCompare(b.title));
      }

      if (!sorted.length) {
        grid.innerHTML = `
          <div style="grid-column: 1 / -1; text-align: center; padding: 48px 20px; background: #f8fafc; border-radius: 12px; border: 1px dashed #cbd5e1;">
            <p style="font-size: 14px; color: #64748b; margin-bottom: 12px;">No products found in this category.</p>
            <button type="button" class="filter-pill-btn active" onclick="window.filterHomepageGrid('all')">View All Products</button>
          </div>
        `;
        return;
      }

      grid.innerHTML = sorted.map((item, idx) => window.renderProductCardHtml(item, idx)).join('');
    };

    window.renderHomepageTrending = function() {
      const grid = document.getElementById('homepage-trending-products-grid');
      if (!grid) return;

      const catalogue = (typeof window.getStorefrontCatalogue === 'function') ? window.getStorefrontCatalogue() : (window.EnamelsCatalogue || []);
      const trending = catalogue.filter(item => item.category === 'scrubs' || getTopCategory(item) === 'scrubs').slice(0, 4);
      const itemsToRender = trending.length ? trending : catalogue.slice(0, 4);
      if (!itemsToRender.length) {
        grid.innerHTML = '<p class="homepage-trending-empty" style="grid-column: 1 / -1; text-align: center; color: var(--color-foreground-muted, #71717a); padding: 40px 0;">No featured products available at this time.</p>';
        return;
      }
      grid.innerHTML = itemsToRender.map((item, idx) => window.renderProductCardHtml(item, idx)).join('');
    };

    // ------------------------------------------------------------
    // 6. SINGLE-PAGE PRODUCT STUDIO & CUSTOMIZATION ENGINE
    // ------------------------------------------------------------
    window.openProductStudio = function(productId, initialColorName = null) {
      const catalogue = (typeof window.getStorefrontCatalogue === 'function') ? window.getStorefrontCatalogue() : (window.EnamelsCatalogue || []);
      const item = productId ? catalogue.find(p => p.id === productId) : STATE.pdpProduct;

      const validView = document.getElementById('pdp-valid-studio-view');
      const invalidView = document.getElementById('pdp-invalid-article-view');

      // Requirement 2: Handle missing or invalid article safely
      if (!item) {
        if (validView) validView.style.display = 'none';
        if (invalidView) invalidView.style.display = 'block';
        window.navigateToView('product-studio');
        return;
      }

      if (validView) validView.style.display = 'block';
      if (invalidView) invalidView.style.display = 'none';

      // Simple products (caps, accessories, sleeves) use simple modal
      if (item.category === 'caps' || item.category === 'accessories' || item.category === 'sleeves') {
        window.openSimpleProductModal(item.id);
        return;
      }

      // Selected article is the single source of truth
      STATE.pdpProduct = item;

      // Select initial color: from card swatch if passed, else first available color for this specific article
      let chosenColor = item.colors?.[0] || { name: 'Deep Navy', hex: '#102A43', image: item.image };
      if (initialColorName) {
        const found = (item.colors || []).find(c => c.name.toLowerCase() === initialColorName.toLowerCase());
        if (found) chosenColor = found;
      }
      STATE.pdpColor = chosenColor;

      STATE.pdpSize = item.sizes?.[0] || 'M';
      STATE.pdpIsCustomSize = false;
      STATE.pdpCustomMeasurements = { chest: '', waist: '', hips: '', inseam: '', unit: 'in' };
      STATE.pdpCustomColor = null;
      STATE.pdpAlterations = false;
      STATE.pdpAlterationDetails = { shirtLength: 'Standard', trouserLength: 'Standard', sleeveLength: 'Half Sleeve (Standard)', notes: '' };
      STATE.pdpEngravingType = 'none';
      STATE.pdpEngravingLines = { line1: '', line2: '', line3: '' };
      STATE.pdpThreadColor = { name: 'Silk White', hex: '#FFFFFF' };
      STATE.pdpLogoEnabled = false;
      STATE.pdpLogo = { id: 'akuh', name: 'Aga Khan University Hospital', placement: 'Right Chest' };
      STATE.pdpCompanionAddons = [];
      STATE.pdpQty = 1;

      // Populate PDP texts
      const cleanTitle = item.title.replace('DEMO — ', '');
      const titleEl = document.getElementById('pdp-title-display');
      const skuEl = document.getElementById('pdp-sku-display');
      const priceEl = document.getElementById('pdp-base-price-display');
      const compPriceEl = document.getElementById('pdp-compare-price-display');
      const descEl = document.getElementById('pdp-desc-display');
      const badgeEl = document.getElementById('pdp-series-badge');
      const genderBadgeEl = document.getElementById('pdp-gender-badge');
      const photoEl = document.getElementById('pdp-active-photo');
      const fabricTag = document.getElementById('pdp-active-fabric-tag');

      if (titleEl) titleEl.textContent = cleanTitle;
      if (skuEl) skuEl.textContent = `SKU: ${item.sku}`;
      if (priceEl) priceEl.textContent = `Rs. ${item.basePrice.toLocaleString()}`;
      if (compPriceEl) compPriceEl.textContent = item.comparePrice ? `Rs. ${item.comparePrice.toLocaleString()}` : '';
      if (descEl) descEl.textContent = item.description;
      if (badgeEl) badgeEl.textContent = `${(item.series || 'CLINICAL').toUpperCase()} SERIES`;
      if (genderBadgeEl) {
        const gName = item.gender === 'women' ? "WOMEN'S" : item.gender === 'unisex' ? "UNISEX" : "MEN'S";
        genderBadgeEl.textContent = `${gName} COLLECTION`;
      }
      if (fabricTag && item.fabric) fabricTag.textContent = item.fabric;

      // Dynamic Breadcrumbs
      const breadGender = document.getElementById('pdp-breadcrumb-gender');
      const breadCat = document.getElementById('pdp-breadcrumb-cat');
      const breadSeries = document.getElementById('pdp-breadcrumb-series');
      const breadSeriesSep = document.getElementById('pdp-breadcrumb-series-sep');
      const breadTitle = document.getElementById('pdp-breadcrumb-title');

      if (breadGender) breadGender.textContent = item.gender === 'women' ? "Women's" : "Men's";
      if (breadCat) {
        const catMap = {
          'scrubs': 'Scrubs',
          'scrub-set': 'Scrubs',
          'scrub-top': 'Scrubs',
          'scrub-pants': 'Scrubs',
          'lab-coat': 'Lab Coats',
          'caps': 'Caps',
          'sleeves': 'Sleeves',
          'accessories': 'Accessories'
        };
        breadCat.textContent = catMap[item.category] || 'Scrubs';
      }
      if (breadSeries && breadSeriesSep) {
        if (item.series) {
          breadSeries.textContent = item.series;
          breadSeries.style.display = 'inline';
          breadSeriesSep.style.display = 'inline';
        } else {
          breadSeries.style.display = 'none';
          breadSeriesSep.style.display = 'none';
        }
      }
      if (breadTitle) breadTitle.textContent = cleanTitle;

      const activeImg = (STATE.pdpColor && STATE.pdpColor.image) ? STATE.pdpColor.image : item.image;
      if (photoEl && activeImg) {
        photoEl.src = window.ShopifyThemeAssets?.[activeImg] || activeImg;
        photoEl.onerror = () => { photoEl.src = '{{ 'demo-sprinter-navy.jpg' | asset_url }}'; };
      }

      // Populate multi-image PDP thumbnail strip
      if (typeof renderPdpThumbnails === 'function') {
        renderPdpThumbnails(item, chosenColor?.name);
      }

      // MAKE YOUR OWN COLOR STRICT RULE: Exclusively for Ready to Wear
      const customColorSection = document.getElementById('pdp-make-your-own-color-section');
      if (customColorSection) {
        customColorSection.style.display = 'none';
      }

      // Render colors directly for this article into Step 1 cards and left bottom swatches
      renderPdpColors(item.colors || []);

      // Render available standard sizes
      renderPdpSizes(item.sizes || ['XS', 'S', 'M', 'L', 'XL', '2XL']);
      window.selectStandardSize(STATE.pdpSize || 'M');

      // Reset controls in DOM
      const altCheck = document.getElementById('pdp-enable-alterations');
      if (altCheck) altCheck.checked = false;
