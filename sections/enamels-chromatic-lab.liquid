{% comment %}
  ENAMELS ONLINE — MASTER CHROMATIC LAB & CUSTOM ORDERING SYSTEM
  Sections 1 to 18 Complete Implementation.
  Preserves authentic white visual identity, Poppins typography, branding,
  original 5-slide banner slideshow, and exact 6-category navigation.
{% endcomment %}

<div class="enamels-theme-root" id="enamels-app-root">
  <!-- Top Announcement Bar, Header & Exact 6-Category Navigation -->
  {% render 'enamels-header-nav' %}

  <!-- Main Storefront Views Container -->
  <main id="enamels-main-content">
    <!-- View 1: Homepage & 5-Slide Banner Slideshow -->
    {% render 'enamels-homepage' %}

    <!-- View 2: Scrubs Collection with Gender Filter & Article Tabs -->
    {% render 'enamels-scrubs-collection' %}

    <!-- View 3: Product Detail Page & 8-Step Customization Studio -->
    {% render 'enamels-product-detail' %}

    <!-- View 4: Ready to Wear / Make Your Own Scrub Configurator -->
    {% render 'enamels-ready-to-wear' %}
  </main>

  <!-- Slide-out Cart Drawer, Checkout Modals, Simple Product Modal & Size Guide -->
  {% render 'enamels-cart-checkout' %}
</div>

<!-- ============================================================ -->
<!-- UNIFIED JAVASCRIPT CONTROLLER FOR ENAMELS ONLINE STOREFRONT -->
<!-- ============================================================ -->
<script>
  window.ShopifyThemeAssets = {
    'demo-sprinter-navy.jpg': {{ 'demo-sprinter-navy.jpg' | asset_url | json }},
    'demo-velora-teal.jpg': {{ 'demo-velora-teal.jpg' | asset_url | json }},
    'demo-crown-burgundy.jpg': {{ 'demo-crown-burgundy.jpg' | asset_url | json }},
    'cat-sprinter.jpg': {{ 'cat-sprinter.jpg' | asset_url | json }},
    'cat-men-scrubs.jpg': {{ 'cat-men-scrubs.jpg' | asset_url | json }},
    'cat-women-scrubs.jpg': {{ 'cat-women-scrubs.jpg' | asset_url | json }},
    'cat-crown.jpg': {{ 'cat-crown.jpg' | asset_url | json }},
    'cat-labcoat.jpg': {{ 'cat-labcoat.jpg' | asset_url | json }},
    'cat-caps.jpg': {{ 'cat-caps.jpg' | asset_url | json }},
    'cat-velora.jpg': {{ 'cat-velora.jpg' | asset_url | json }},
    'cat-clogs.jpg': {{ 'cat-clogs.jpg' | asset_url | json }},
    'cat-flexfit.jpg': {{ 'cat-flexfit.jpg' | asset_url | json }}
  };

  (function() {
    'use strict';

    // ------------------------------------------------------------
    // 1. APPLICATION STATE
    // ------------------------------------------------------------
    const STATE = {
      // Slideshow
      slideIndex: 0,
      slideCount: 5,
      slideTimer: null,
      slidePaused: false,

      // Scrubs Collection Filter
      genderFilter: 'all', // 'all' | 'men' | 'women'
      articleFilter: 'all', // 'all' | 'Sprinter' | 'Crown' | 'Velora' | 'FlexFit'
      sortOrder: 'featured',

      // Product Detail Page (PDP) Customizer
      pdpProduct: null,
      pdpColor: { name: 'Deep Navy', hex: '#102A43', image: '' },
      pdpSize: 'M',
      pdpIsCustomSize: false,
      pdpCustomMeasurements: { chest: '', waist: '', hips: '', inseam: '', unit: 'in' },
      pdpCustomColor: null,
      pdpAlterations: false,
      pdpAlterationDetails: { shirtLength: 'Standard', trouserLength: 'Standard', sleeveLength: 'Half Sleeve (Standard)', notes: '' },
      pdpEngravingType: 'none', // 'none' | 'direct' | 'patch'
      pdpEngravingLines: { line1: '', line2: '', line3: '' },
      pdpThreadColor: { name: 'Silk White', hex: '#FFFFFF' },
      pdpLogoEnabled: false,
      pdpLogo: { id: 'akuh', name: 'Aga Khan University Hospital', placement: 'Right Chest' },
      pdpCompanionAddons: [],
      pdpQty: 1,

      // Ready to Wear Configurator Wizard
      rtwStep: 1,
      rtwFabric: { id: 'sprinter-twill', name: 'Sprinter Performance Twill', price: 0, desc: '4-Way Mechanical Stretch (72% Poly, 21% Rayon, 7% Spandex)' },
      rtwColor: { name: 'Deep Navy', hex: '#102A43' },
      rtwArticle: { id: 'Sprinter', name: 'Sprinter Series' },
      rtwDesign: { id: 'sprinter-athletic-set', name: 'Sprinter Athletic V-Neck Scrub Set', price: 5150, image: 'demo-sprinter-navy.jpg' },
      rtwSizeMode: 'standard', // 'standard' | 'custom'
      rtwStandardSize: 'M',
      rtwUnit: 'in',
      rtwCustomMeasurements: { chest: '', waist: '', hips: '', shoulder: '', sleeve: '', topLength: '', trouserWaist: '', trouserLength: '', inseam: '' },
      rtwAlterations: false,
      rtwAlterationDetails: { shirtLength: 'Standard', trouserLength: 'Standard', sleeveLength: 'Half Sleeve (Standard)', notes: '' },
      rtwEngravingType: 'none',
      rtwEngravingLines: { line1: '', line2: '', line3: '' },
      rtwThreadColor: { name: 'Silk White', hex: '#FFFFFF' },
      rtwLogoEnabled: false,
      rtwLogo: { id: 'akuh', name: 'Aga Khan University Hospital', placement: 'Right Chest' },

      // Simple Product Modal (Non-custom items)
      simpleProduct: null,
      simpleColor: 'Deep Navy',
      simpleQty: 1
    };

    // ------------------------------------------------------------
    // 2. INITIALIZATION
    // ------------------------------------------------------------
    document.addEventListener('DOMContentLoaded', initEnamelsApp);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(initEnamelsApp, 50);
    }

    function initEnamelsApp() {
      initSlideshow();
      renderScrubsGrid();
      updateCartBadge();
      renderRtwColorsForFabric('sprinter-twill');
      renderRtwDesignsForArticle('Sprinter');
      handleHashRouting();
      window.addEventListener('hashchange', handleHashRouting);
    }

    // ------------------------------------------------------------
    // 3. NAVIGATION ROUTING
    // ------------------------------------------------------------
    window.navigateToView = function(viewId) {
      document.querySelectorAll('.chroma-view-panel').forEach(p => p.classList.remove('active'));
      const target = document.getElementById(`view-${viewId}`);
      if (target) {
        target.classList.add('active');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      if (viewId === 'ready-to-wear') {
        window.jumpRtwStep(1);
      }

      // Update URL hash without jumping
      if (history.pushState) {
        history.pushState(null, null, `#${viewId}`);
      } else {
        location.hash = `#${viewId}`;
      }
    };

    window.navigateToCollection = function(seriesOrCat, type = 'series') {
      window.navigateToView('category-scrubs');
      const breadTitle = document.getElementById('collection-breadcrumb-title');

      if (type === 'series') {
        window.setArticleFilter(seriesOrCat);
        window.setGenderFilter('all');
        if (breadTitle) breadTitle.textContent = `${seriesOrCat} Series Scrubs`;
      } else if (type === 'category') {
        const catMap = {
          'caps': 'Surgical Caps (BunFit™)',
          'lab-coat': 'Medical Lab Coats',
          'accessories': 'Clinical Accessories',
          'clogs': 'Clinical Clogs & Footwear'
        };
        if (breadTitle) breadTitle.textContent = catMap[seriesOrCat] || seriesOrCat;
        renderCategoryOnly(seriesOrCat);
      } else if (type === 'feature') {
        if (breadTitle) breadTitle.textContent = 'Medical Compression Sleeves';
        renderCategoryOnly('sleeves');
      }
    };

    function handleHashRouting() {
      const hash = window.location.hash;
      if (!hash || hash === '#home') {
        window.navigateToView('home');
      } else if (hash === '#category-scrubs') {
        window.navigateToView('category-scrubs');
      } else if (hash === '#ready-to-wear') {
        window.navigateToView('ready-to-wear');
      } else if (hash.startsWith('#collection-')) {
        const target = hash.replace('#collection-', '');
        if (['sprinter', 'velora', 'crown', 'flexfit'].includes(target.toLowerCase())) {
          const capSeries = target.charAt(0).toUpperCase() + target.slice(1);
          window.navigateToCollection(capSeries, 'series');
        } else {
          window.navigateToCollection(target, 'category');
        }
      } else if (hash.startsWith('#product-')) {
        const prodId = hash.replace('#product-', '');
        window.openProductStudio(prodId);
      }
    }

    // ------------------------------------------------------------
    // 4. SLIDESHOW BANNER CONTROLLER (SECTION 3)
    // ------------------------------------------------------------
    function initSlideshow() {
      updateBannerSlidePositions();
      startSlideAutoplay();

      const container = document.getElementById('enamels-hero-slideshow');
      if (container) {
        container.addEventListener('mouseenter', () => { STATE.slidePaused = true; });
        container.addEventListener('mouseleave', () => { STATE.slidePaused = false; });
      }
    }

    function startSlideAutoplay() {
      if (STATE.slideTimer) clearInterval(STATE.slideTimer);
      STATE.slideTimer = setInterval(() => {
        if (!STATE.slidePaused) {
          window.stepBannerSlide(1);
        }
      }, 5500);
    }

    window.stepBannerSlide = function(direction) {
      STATE.slideIndex = (STATE.slideIndex + direction + STATE.slideCount) % STATE.slideCount;
      updateBannerSlidePositions();
    };

    window.jumpToBannerSlide = function(idx) {
      STATE.slideIndex = (idx + STATE.slideCount) % STATE.slideCount;
      updateBannerSlidePositions();
    };

    function updateBannerSlidePositions() {
      const track = document.getElementById('enamels-slideshow-track');
      if (track) {
        track.style.transform = `translateX(-${STATE.slideIndex * 100}%)`;
      }
      const dots = document.querySelectorAll('.slideshow-dot');
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === STATE.slideIndex);
      });
    }

    // ------------------------------------------------------------
    // 5. SCRUBS COLLECTION & GENDER FILTER ENGINE (SECTION 4)
    // ------------------------------------------------------------
    window.setGenderFilter = function(gender) {
      STATE.genderFilter = gender;
      document.querySelectorAll('.gender-pill-btn').forEach(b => b.classList.remove('active'));
      const activeBtn = document.getElementById(`gender-filter-${gender}`);
      if (activeBtn) activeBtn.classList.add('active');
      renderScrubsGrid();
    };

    window.setArticleFilter = function(article) {
      STATE.articleFilter = article;
      document.querySelectorAll('.series-tab-btn').forEach(b => b.classList.remove('active'));
      const tabId = article === 'all' ? 'series-tab-all' : `series-tab-${article.toLowerCase()}`;
      const activeTab = document.getElementById(tabId);
      if (activeTab) activeTab.classList.add('active');
      renderScrubsGrid();
    };

    window.sortScrubsCatalogue = function(val) {
      STATE.sortOrder = val;
      renderScrubsGrid();
    };

    function getFilteredCatalogue() {
      const catalogue = window.EnamelsCatalogue || [];
      return catalogue.filter(item => {
        // Gender filter
        if (STATE.genderFilter !== 'all') {
          if (item.gender !== STATE.genderFilter && item.gender !== 'unisex') return false;
        }
        // Article/Series filter
        if (STATE.articleFilter !== 'all') {
          if (item.series !== STATE.articleFilter) return false;
        }
        return true;
      });
    }

    function renderCategoryOnly(cat) {
      const catalogue = window.EnamelsCatalogue || [];
      const filtered = catalogue.filter(item => {
        if (cat === 'caps') return item.category === 'caps';
        if (cat === 'lab-coat') return item.category === 'lab-coat';
        if (cat === 'sleeves') return item.category === 'sleeves';
        if (cat === 'accessories') return item.category === 'accessories';
        if (cat === 'clogs') return item.category === 'accessories';
        return true;
      });
      renderGridWithItems(filtered);
    }

    function renderScrubsGrid() {
      const items = getFilteredCatalogue();
      renderGridWithItems(items);
    }

    function renderGridWithItems(items) {
      const grid = document.getElementById('scrubs-products-grid');
      const countEl = document.getElementById('scrubs-visible-count');
      if (!grid) return;

      if (countEl) countEl.textContent = items.length;

      // Sort items
      const sorted = [...items];
      if (STATE.sortOrder === 'price-low') {
        sorted.sort((a, b) => a.basePrice - b.basePrice);
      } else if (STATE.sortOrder === 'price-high') {
        sorted.sort((a, b) => b.basePrice - a.basePrice);
      } else if (STATE.sortOrder === 'name') {
        sorted.sort((a, b) => a.title.localeCompare(b.title));
      }

      if (!sorted.length) {
        grid.innerHTML = `
          <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; background: #f8fafc; border-radius: 8px;">
            <div style="font-size: 32px; margin-bottom: 8px;">🩺</div>
            <h3 style="font-size: 16px; font-weight: 700; color: #102a43;">No Products Found</h3>
            <p style="font-size: 13px; color: #64748b; margin-bottom: 16px;">Try adjusting your gender or scrub article filters.</p>
            <button type="button" class="gender-pill-btn active" onclick="window.setGenderFilter('all'); window.setArticleFilter('all');">Reset Filters</button>
          </div>
        `;
        return;
      }

      grid.innerHTML = sorted.map(item => {
        const cleanTitle = item.title.replace('DEMO — ', '');
        const colorsHtml = (item.colors || []).map(c => `
          <span class="pdp-swatch-color-dot" style="background: ${c.hex}; width: 14px; height: 14px;" title="${c.name}"></span>
        `).join('');

        const isSimple = item.category === 'caps' || item.category === 'sleeves' || item.category === 'accessories';
        const actionBtn = isSimple
          ? `<button type="button" class="btn-card-action" onclick="window.openSimpleProductModal('${item.id}')">Quick Add</button>`
          : `<button type="button" class="btn-card-action" onclick="window.openProductStudio('${item.id}')">Customize & Select</button>`;

        return `
          <div class="product-preview-card">
            <div class="card-thumb-wrap" onclick="window.openProductStudio('${item.id}')">
              <img src="${item.image ? (window.ShopifyThemeAssets?.[item.image] || item.image) : ''}" alt="${cleanTitle}" class="card-img" onerror="this.src='{{ 'cat-sprinter.jpg' | asset_url }}'" />
              ${item.badge ? `<span class="card-pill-tag">${item.badge}</span>` : ''}
            </div>
            <div class="card-body-wrap">
              <span class="card-series-tag">${item.series ? item.series.toUpperCase() + ' SERIES' : item.category.toUpperCase()}</span>
              <h3 class="card-title-text" onclick="window.openProductStudio('${item.id}')">${cleanTitle}</h3>
              <div class="card-pricing-row">
                <span class="card-current-price">Rs. ${item.basePrice.toLocaleString()}</span>
                ${item.comparePrice ? `<span class="card-compare-price">Rs. ${item.comparePrice.toLocaleString()}</span>` : ''}
              </div>
              <div style="display: flex; gap: 4px; align-items: center; margin-bottom: 12px;">
                ${colorsHtml}
              </div>
              ${actionBtn}
            </div>
          </div>
        `;
      }).join('');
    }

    // ------------------------------------------------------------
    // 6. PRODUCT DETAIL PAGE (PDP) CUSTOMIZER (SECTIONS 5 - 10)
    // ------------------------------------------------------------
    window.openProductStudio = function(productId) {
      const catalogue = window.EnamelsCatalogue || [];
      const item = catalogue.find(p => p.id === productId) || catalogue[0];
      if (!item) return;

      // Simple products redirect to simple modal if needed
      if (item.category === 'caps' || item.category === 'accessories' || item.category === 'sleeves') {
        window.openSimpleProductModal(item.id);
        return;
      }

      STATE.pdpProduct = item;
      STATE.pdpColor = item.colors?.[0] || { name: 'Deep Navy', hex: '#102A43', image: item.image };
      STATE.pdpSize = item.sizes?.[0] || 'M';
      STATE.pdpIsCustomSize = false;
      STATE.pdpCustomMeasurements = { chest: '', waist: '', hips: '', inseam: '', unit: 'in' };
      STATE.pdpCustomColor = null;
      STATE.pdpAlterations = false;
      STATE.pdpAlterationDetails = { shirtLength: 'Standard', trouserLength: 'Standard', sleeveLength: 'Half Sleeve (Standard)', notes: '' };
      STATE.pdpEngravingType = 'none';
      STATE.pdpEngravingLines = { line1: '', line2: '', line3: '' };
      STATE.pdpThreadColor = { name: 'Silk White', hex: '#FFFFFF' };
      STATE.pdpLogoEnabled = false;
      STATE.pdpLogo = { id: 'akuh', name: 'Aga Khan University Hospital', placement: 'Right Chest' };
      STATE.pdpCompanionAddons = [];
      STATE.pdpQty = 1;

      // Populate PDP texts
      const cleanTitle = item.title.replace('DEMO — ', '');
      const titleEl = document.getElementById('pdp-title-display');
      const skuEl = document.getElementById('pdp-sku-display');
      const priceEl = document.getElementById('pdp-base-price-display');
      const compPriceEl = document.getElementById('pdp-compare-price-display');
      const descEl = document.getElementById('pdp-desc-display');
      const badgeEl = document.getElementById('pdp-series-badge');
      const breadEl = document.getElementById('pdp-breadcrumb-title');
      const photoEl = document.getElementById('pdp-active-photo');

      if (titleEl) titleEl.textContent = cleanTitle;
      if (skuEl) skuEl.textContent = `SKU: ${item.sku}`;
      if (priceEl) priceEl.textContent = `Rs. ${item.basePrice.toLocaleString()}`;
      if (compPriceEl) compPriceEl.textContent = item.comparePrice ? `Rs. ${item.comparePrice.toLocaleString()}` : '';
      if (descEl) descEl.textContent = item.description;
      if (badgeEl) badgeEl.textContent = `${(item.series || 'CLINICAL').toUpperCase()} SERIES`;
      if (breadEl) breadEl.textContent = cleanTitle;

      if (photoEl && item.image) {
        photoEl.src = window.ShopifyThemeAssets?.[item.image] || item.image;
        photoEl.onerror = () => { photoEl.src = '{{ 'demo-sprinter-navy.jpg' | asset_url }}'; };
      }

      // MAKE YOUR OWN COLOR STRICT RULE (SECTION 5):
      // Sprinter series strictly HIDDEN! Crown/Velora shown only if supportsMakeYourOwnColor === true.
      const customColorSection = document.getElementById('pdp-make-your-own-color-section');
      if (customColorSection) {
        if (item.series === 'Sprinter' || item.supportsMakeYourOwnColor === false) {
          customColorSection.style.display = 'none';
        } else {
          customColorSection.style.display = 'block';
        }
      }

      // Render color swatches directly beneath image
      renderPdpBottomSwatches(item.colors || []);

      // Render available standard sizes
      renderPdpSizes(item.sizes || ['XS', 'S', 'M', 'L', 'XL', '2XL']);

      // Reset controls in DOM
      const altCheck = document.getElementById('pdp-enable-alterations');
      if (altCheck) altCheck.checked = false;
      const altBox = document.getElementById('pdp-alterations-box');
      if (altBox) altBox.style.display = 'none';

      const customSizeCheck = document.getElementById('toggle-custom-measurements-check');
      if (customSizeCheck) customSizeCheck.checked = false;
      const customMeasPanel = document.getElementById('pdp-custom-measurements-panel');
      if (customMeasPanel) customMeasPanel.style.display = 'none';

      const engNoneRadio = document.querySelector('input[name="pdp_engraving_type"][value="none"]');
      if (engNoneRadio) engNoneRadio.checked = true;
      const engBox = document.getElementById('pdp-engraving-inputs-box');
      if (engBox) engBox.style.display = 'none';
      const pocketSim = document.getElementById('pocket-sim-overlay');
      if (pocketSim) pocketSim.style.display = 'none';
      const simPill = document.getElementById('embroidery-disclaimer-pill');
      if (simPill) simPill.style.display = 'none';

      const logoCheck = document.getElementById('pdp-enable-logo');
      if (logoCheck) logoCheck.checked = false;
      const logoBox = document.getElementById('pdp-logo-options-box');
      if (logoBox) logoBox.style.display = 'none';

      const qtyInput = document.getElementById('pdp-qty-input');
      if (qtyInput) qtyInput.value = '1';

      recalculatePdpSummary();
      window.navigateToView('product-studio');
    };

    function renderPdpBottomSwatches(colors) {
      const grid = document.getElementById('pdp-bottom-swatches-grid');
      const title = document.getElementById('pdp-selected-color-title');
      if (!grid) return;

      if (!colors.length) {
        grid.innerHTML = '<span style="font-size: 12px; color: #64748b;">Standard Hospital Navy</span>';
        return;
      }

      if (title && STATE.pdpColor) title.textContent = STATE.pdpColor.name;

      grid.innerHTML = colors.map((c, i) => `
        <button type="button" class="pdp-swatch-item ${i === 0 ? 'active' : ''}" onclick="window.selectPdpColor('${c.hex}', '${c.name}', '${c.image || ''}')" title="${c.name}">
          <span class="pdp-swatch-color-dot" style="background: ${c.hex};"></span>
          <span>${c.name}</span>
        </button>
      `).join('');
    }

    function renderPdpSizes(sizes) {
      const grid = document.getElementById('pdp-sizes-grid');
      if (!grid) return;

      grid.innerHTML = sizes.map((s, i) => `
        <button type="button" class="pdp-size-chip ${s === STATE.pdpSize ? 'active' : ''}" onclick="window.selectStandardSize('${s}')">${s}</button>
      `).join('');
    }

    window.selectPdpColor = function(hex, name, img) {
      STATE.pdpColor = { name, hex, image: img };
      STATE.pdpCustomColor = null;

      const title = document.getElementById('pdp-selected-color-title');
      if (title) title.textContent = name;

      document.querySelectorAll('#pdp-bottom-swatches-grid .pdp-swatch-item').forEach(btn => {
        btn.classList.toggle('active', btn.textContent.trim() === name);
      });
      document.querySelectorAll('#pdp-custom-color-swatches .pdp-swatch-item').forEach(btn => btn.classList.remove('active'));

      const photoEl = document.getElementById('pdp-active-photo');
      if (photoEl) {
        if (img) {
          photoEl.src = window.ShopifyThemeAssets?.[img] || img;
        } else {
          // Honest preview: subtle tint filter
          photoEl.style.filter = `drop-shadow(0 0 1px ${hex})`;
        }
      }

      recalculatePdpSummary();
    };

    window.selectCustomColor = function(hex, name) {
      STATE.pdpCustomColor = { name, hex };
      STATE.pdpColor = { name: `Custom Dye: ${name}`, hex, image: '' };

      const title = document.getElementById('pdp-selected-color-title');
      if (title) title.textContent = `Custom Dye: ${name}`;

      document.querySelectorAll('#pdp-bottom-swatches-grid .pdp-swatch-item').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('#pdp-custom-color-swatches .pdp-swatch-item').forEach(btn => {
        btn.classList.toggle('active', btn.textContent.trim() === name);
      });

      recalculatePdpSummary();
    };

    window.selectStandardSize = function(size) {
      STATE.pdpSize = size;
      STATE.pdpIsCustomSize = false;

      document.querySelectorAll('#pdp-sizes-grid .pdp-size-chip').forEach(c => {
        c.classList.toggle('active', c.textContent.trim() === size);
      });

      const customCheck = document.getElementById('toggle-custom-measurements-check');
      if (customCheck) customCheck.checked = false;
      const customPanel = document.getElementById('pdp-custom-measurements-panel');
      if (customPanel) customPanel.style.display = 'none';

      recalculatePdpSummary();
    };

    window.toggleCustomMeasurementsForm = function(checked) {
      STATE.pdpIsCustomSize = checked;
      const panel = document.getElementById('pdp-custom-measurements-panel');
      if (panel) panel.style.display = checked ? 'block' : 'none';

      if (checked) {
        document.querySelectorAll('#pdp-sizes-grid .pdp-size-chip').forEach(c => c.classList.remove('active'));
      } else {
        window.selectStandardSize('M');
      }
      recalculatePdpSummary();
    };

    window.setMeasurementUnit = function(unit) {
      STATE.pdpCustomMeasurements.unit = unit;
      const btnIn = document.getElementById('meas-unit-in');
      const btnCm = document.getElementById('meas-unit-cm');
      if (btnIn) btnIn.classList.toggle('active', unit === 'in');
      if (btnCm) btnCm.classList.toggle('active', unit === 'cm');
      document.querySelectorAll('.unit-label').forEach(el => el.textContent = unit);
    };

    window.saveCustomMeasurements = function() {
      const chest = document.getElementById('meas-input-chest')?.value || '38';
      const waist = document.getElementById('meas-input-waist')?.value || '32';
      const hips = document.getElementById('meas-input-hips')?.value || '40';
      const inseam = document.getElementById('meas-input-inseam')?.value || '30';

      STATE.pdpCustomMeasurements = {
        chest, waist, hips, inseam,
        unit: STATE.pdpCustomMeasurements.unit || 'in'
      };
      STATE.pdpIsCustomSize = true;

      alert(`Custom measurements saved: Chest ${chest}${STATE.pdpCustomMeasurements.unit}, Waist ${waist}${STATE.pdpCustomMeasurements.unit}, Hips ${hips}${STATE.pdpCustomMeasurements.unit}, Inseam ${inseam}${STATE.pdpCustomMeasurements.unit}`);
      recalculatePdpSummary();
    };

    window.toggleAlterations = function(checked) {
      STATE.pdpAlterations = checked;
      const box = document.getElementById('pdp-alterations-box');
