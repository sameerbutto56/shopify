    window.goToSelfServiceStep = function(step) {
      selfServiceCurrentStep = step;
      const stepLabels = {
        1: { name: 'Customer Information & Visit Preferences', sub: 'Enter clinician contact details & visit preferences' },
        2: { name: 'Select Approved Lahore Address', sub: 'Choose approved healthcare zone in Lahore' },
        3: { name: 'Review Booking & Advance Deposit Policy', sub: `Review details & PKR ${REQUIRED_HOME_SERVICE_ADVANCE.toLocaleString()} adjustable deposit` }
      };

      const badgeText = document.getElementById('ss-step-badge-text');
      const remText = document.getElementById('ss-step-remaining-text');
      const statusMsg = document.getElementById('ss-stepper-status-msg');
      const fillBar = document.getElementById('ss-progress-fill');

      if (badgeText) badgeText.textContent = `Step ${step} of 3: ${stepLabels[step].name}`;
      if (remText) remText.textContent = step === 3 ? 'Final Step' : `${3 - step} step${3 - step > 1 ? 's' : ''} remaining`;
      if (statusMsg) statusMsg.textContent = stepLabels[step].sub;
      if (fillBar) fillBar.style.width = step === 1 ? '33.3%' : (step === 2 ? '66.6%' : '100%');

      const stepMap = [
        { id: 'ss-nav-btn-contact', subId: 'ss-sub-contact', label: 'Contact & Visit', defaultSub: 'Required' },
        { id: 'ss-nav-btn-address', subId: 'ss-sub-address', label: 'Lahore Area', defaultSub: 'Select Zone' },
        { id: 'ss-nav-btn-review', subId: 'ss-sub-review', label: 'Review & Deposit', defaultSub: `PKR ${REQUIRED_HOME_SERVICE_ADVANCE.toLocaleString()} Advance` }
      ];

      stepMap.forEach((item, index) => {
        const btn = document.getElementById(item.id);
        const sub = document.getElementById(item.subId);
        const sIndex = index + 1;
        if (!btn) return;
        btn.classList.remove('active', 'completed', 'upcoming');
        if (sIndex < step) {
          btn.classList.add('completed');
          if (sub) sub.textContent = 'Completed ✓';
        } else if (sIndex === step) {
          btn.classList.add('active');
          if (sub) sub.textContent = 'In Progress';
        } else {
          btn.classList.add('upcoming');
          if (sub) sub.textContent = item.defaultSub;
        }
      });

      document.querySelectorAll('.self-service-pane').forEach(p => p.classList.remove('active'));
      const activePane = document.getElementById(`ss-pane-${step}`);
      if (activePane) activePane.classList.add('active');

      const errBanner = document.getElementById('ss-form-error-banner');
      if (errBanner) {
        errBanner.style.display = 'none';
        errBanner.textContent = '';
      }

      if (step === 3) {
        renderSelfServiceRecap();
      }

      const card = document.getElementById('self-service-booking-card');
      if (card) {
        card.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

