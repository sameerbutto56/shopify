    function getTopCategory(item) {
      if (!item) return 'accessories';
      const cat = (item.category || '').toLowerCase();
      if (['scrub-set', 'scrub-top', 'scrub-pants'].includes(cat)) return 'scrubs';
      if (cat === 'lab-coat') return 'lab-coat';
      if (cat === 'caps') return 'caps';
      if (['accessories', 'patches', 'bundles', 'sleeves', 'clogs'].includes(cat)) return 'accessories';
      return 'accessories';
    }

    function getCategoryCount(gender, catKey) {
      const catalogue = window.EnamelsCatalogue || [];
      return catalogue.filter(item => {
        const matchesGender = (gender === 'all') || (item.gender === gender || item.gender === 'unisex');
        if (!matchesGender) return false;
        if (catKey === 'all') return true;
        return getTopCategory(item) === catKey;
      }).length;
    }

