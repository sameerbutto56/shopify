        if (!raw) {
          localStorage.setItem(SS_STORAGE_KEY, JSON.stringify(INITIAL_SAMPLE_BOOKINGS));
          return INITIAL_SAMPLE_BOOKINGS;
        }
        return JSON.parse(raw) || [];
      } catch (e) {
        return INITIAL_SAMPLE_BOOKINGS;
      }
    }

    function saveStoredBookings(bookings) {
      try {
        localStorage.setItem(SS_STORAGE_KEY, JSON.stringify(bookings));
      } catch (e) {
        console.warn('Failed to save bookings to localStorage', e);
      }
