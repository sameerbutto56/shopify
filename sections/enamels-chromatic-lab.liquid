    function showOrderConfirmation(refId, statusText, paymentMode) {
      const bankView = document.getElementById('checkout-view-bank');
      const repView = document.getElementById('checkout-view-rep');
      const confView = document.getElementById('checkout-view-confirmation');
      const refEl = document.getElementById('conf-reference-id');
      const statusEl = document.getElementById('conf-status-badge');
      const msgEl = document.getElementById('conf-message');

      if (bankView) bankView.style.display = 'none';
      if (repView) repView.style.display = 'none';
      if (confView) confView.style.display = 'block';

