    // ------------------------------------------------------------
    // INTERACTIVE STEPPER NAVIGATION & VALIDATION ENGINE
    // ------------------------------------------------------------

    function showStepError(stepId, message) {
      const banner = document.getElementById(`pdp-error-pane-${stepId}`);
      if (banner) {
        banner.textContent = `⚠️ ${message}`;
        banner.style.display = 'block';
        banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        alert(message);
      }
    }

    function clearStepError(stepId) {
      const banner = document.getElementById(`pdp-error-pane-${stepId}`);
      if (banner) {
        banner.textContent = '';
        banner.style.display = 'none';
      }
    }

    // Validates the current step before advancing or adding to cart
    function validateCurrentPdpStep() {
      const current = STATE.pdpCurrentStep;
      clearStepError(current);

      if (current === 'size') {
        if (STATE.pdpIsCustomSize) {
          const chest = document.getElementById('meas-input-chest')?.value?.trim();
          const waist = document.getElementById('meas-input-waist')?.value?.trim();
          if (!chest || !waist || Number(chest) <= 0 || Number(waist) <= 0) {
            showStepError('size', 'Please enter your Chest and Waist measurements before continuing, or uncheck "Need Custom Tailored Measurements" to select standard sizing.');
            return false;
          }
          STATE.pdpCustomMeasurements = {
            chest,
            waist,
            hips: document.getElementById('meas-input-hips')?.value?.trim() || '',
            inseam: document.getElementById('meas-input-inseam')?.value?.trim() || '',
            unit: STATE.pdpCustomMeasurements.unit || 'in'
          };
        }
      }

      if (current === 'engraving') {
        if (STATE.pdpEngravingType !== 'none') {
          const line1 = document.getElementById('engraving-line-1')?.value?.trim();
          if (!line1) {
            showStepError('engraving', 'Please enter your Full Name & Title for embroidery (Line 1 is required), or choose "No Personalization".');
            return false;
          }
          STATE.pdpEngravingLines.line1 = line1;
          STATE.pdpEngravingLines.line2 = document.getElementById('engraving-line-2')?.value?.trim() || '';
          STATE.pdpEngravingLines.line3 = document.getElementById('engraving-line-3')?.value?.trim() || '';
        }
      }

      return true;
    }

    // Renders the horizontal visual stepper track and header counter
    function renderPdpStepper() {
      const steps = getPdpApplicableSteps(STATE.pdpProduct);
      const track = document.getElementById('pdp-dynamic-stepper-track');
      const progressFill = document.getElementById('pdp-stepper-progress-fill');
      const badgeText = document.getElementById('pdp-step-badge-text');
      const remainingText = document.getElementById('pdp-step-remaining-text');
      const statusMsg = document.getElementById('pdp-stepper-status-msg');

      if (!steps.length || !track) return;

      const total = steps.length;
      let currentIndex = steps.findIndex(s => s.id === STATE.pdpCurrentStep);
      if (currentIndex === -1) currentIndex = 0;
      const currentStep = steps[currentIndex];

      // Progress bar fill percentage
      const progressPercent = total > 1 ? Math.round((currentIndex / (total - 1)) * 100) : 100;
      if (progressFill) {
        progressFill.style.width = `${Math.max(12, Math.min(100, progressPercent))}%`;
      }

      // Step Counter Badge
      if (badgeText) {
        badgeText.textContent = `Step ${currentIndex + 1} of ${total}: ${currentStep.title}`;
      }

      // Steps Remaining Counter
      if (remainingText) {
        const stepsLeft = total - 1 - currentIndex;
        if (stepsLeft === 0) {
          remainingText.textContent = 'Ready to review your order';
        } else if (stepsLeft === 1) {
          remainingText.textContent = 'Almost there — 1 step left';
        } else {
          remainingText.textContent = `${stepsLeft} steps remaining`;
        }
      }

      // Contextual status hint
      if (statusMsg) {
        const hints = {
          design: 'Review scrub series specifications & cut details',
          colour: 'Select clinical uniform color or custom dye',
          size: 'Select standard sizing or enter custom body measurements',
          alterations: 'Optional garment tailoring for top, sleeves & inseam',
          engraving: 'Optional doctor name & department chest embroidery',
          logo: 'Optional official hospital emblem placement',
          review: 'Confirm itemized details and proceed to checkout'
        };
        statusMsg.textContent = hints[currentStep.id] || 'Configure uniform customization';
      }

      // Render Step Buttons with Active / Completed / Upcoming states
      track.innerHTML = steps.map((step, idx) => {
        const isActive = (step.id === STATE.pdpCurrentStep);
        const isCompleted = STATE.pdpCompletedSteps.has(step.id);
        const isSkipped = STATE.pdpSkippedSteps.has(step.id);
        const isAccessible = (idx <= currentIndex || isCompleted || idx === currentIndex + 1);

        let stateClass = 'upcoming';
        if (isActive) stateClass = 'active';
        else if (isCompleted) stateClass = 'completed';
        else if (!isAccessible) stateClass = 'upcoming disabled';

        // Dynamic sub-text under circle
        let valText = '';
        if (step.id === 'design') {
          valText = (STATE.pdpProduct?.series || 'Selected');
        } else if (step.id === 'colour') {
          valText = STATE.pdpColor ? STATE.pdpColor.name.replace('Custom Dye: ', '') : 'Navy';
        } else if (step.id === 'size') {
          valText = STATE.pdpIsCustomSize ? 'Custom' : (STATE.pdpSize || 'M');
        } else if (step.id === 'alterations') {
          if (isSkipped) valText = 'Skipped';
          else if (STATE.pdpAlterations) valText = '+Rs. 350';
          else if (isCompleted) valText = 'Standard';
          else valText = 'Optional';
        } else if (step.id === 'engraving') {
          if (isSkipped) valText = 'Skipped';
          else if (STATE.pdpEngravingType === 'direct') valText = 'Direct';
          else if (STATE.pdpEngravingType === 'patch') valText = 'Patch';
          else if (isCompleted) valText = 'None';
          else valText = 'Optional';
        } else if (step.id === 'logo') {
          if (isSkipped) valText = 'Skipped';
          else if (STATE.pdpLogoEnabled) valText = (STATE.pdpLogo?.id?.toUpperCase() || '+Rs. 650');
          else if (isCompleted) valText = 'None';
          else valText = 'Optional';
        } else if (step.id === 'review') {
          valText = isCompleted ? 'Ready' : 'Review';
        }

        return `
          <button type="button" 
            class="pdp-step-btn ${stateClass}" 
            onclick="window.handleStepperClick('${step.id}')"
            aria-label="Step ${idx + 1}: ${step.title} (${stateClass})"
            id="pdp-step-nav-btn-${step.id}">
            <div class="pdp-step-circle">
              <span class="step-num">${idx + 1}</span>
              <span class="step-check">✓</span>
            </div>
            <div class="pdp-step-text">
              <span class="pdp-step-label">${step.short || step.title}</span>
              <span class="pdp-step-state-text" title="${valText}">${valText}</span>
            </div>
          </button>
        `;
      }).join('');

      // Auto scroll active button on mobile
      const activeBtn = track.querySelector('.pdp-step-btn.active');
      if (activeBtn && track.scrollWidth > track.clientWidth) {
        activeBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }

      // Update button on size step pane if last step before review
      const sizeNextBtn = document.getElementById('pdp-size-next-btn');
      if (sizeNextBtn) {
        const isCustomizable = (STATE.pdpProduct?.supportsCustomization !== false);
        sizeNextBtn.textContent = isCustomizable ? 'Continue to Alterations →' : 'Continue to Review →';
      }
    }

    // Direct navigation to a specific step pane
    window.goToPdpStep = function(stepId, validateCurrent = true) {
      const steps = getPdpApplicableSteps(STATE.pdpProduct);
      const targetStep = steps.find(s => s.id === stepId);
      if (!targetStep) return false;

      // Validate current step before leaving (unless navigating backward or explicitly bypassing)
      if (validateCurrent && STATE.pdpCurrentStep !== stepId) {
        const isValid = validateCurrentPdpStep();
        if (!isValid) return false;
      }

      // Mark current step completed if valid
      if (STATE.pdpCurrentStep) {
        STATE.pdpCompletedSteps.add(STATE.pdpCurrentStep);
      }

      STATE.pdpCurrentStep = stepId;

      // Switch step panes
      document.querySelectorAll('.pdp-step-pane').forEach(pane => {
        pane.classList.remove('active');
      });
      const activePane = document.getElementById(`pdp-pane-${stepId}`);
      if (activePane) {
        activePane.classList.add('active');
      }

      // Specific pane updates
      if (stepId === 'colour') {
        renderPdpPaneSwatches(STATE.pdpProduct?.colors || []);
      } else if (stepId === 'size') {
        renderPdpSizes(STATE.pdpProduct?.sizes || ['XS', 'S', 'M', 'L', 'XL', '2XL']);
      } else if (stepId === 'review') {
        renderPdpReviewRecap();
        recalculatePdpSummary();
      }

      renderPdpStepper();
      return true;
    };

    // Continue / Next Button action
    window.continuePdpStep = function() {
      const isValid = validateCurrentPdpStep();
      if (!isValid) return;

      STATE.pdpCompletedSteps.add(STATE.pdpCurrentStep);

      const steps = getPdpApplicableSteps(STATE.pdpProduct);
      const currentIndex = steps.findIndex(s => s.id === STATE.pdpCurrentStep);

      if (currentIndex === steps.length - 1) {
        // Final step Continue triggers Add to Cart
        window.addConfiguredScrubToCart();
        return;
      }

      const nextStep = steps[currentIndex + 1];
      if (nextStep) {
        window.goToPdpStep(nextStep.id, false);
      }
    };

    // Back Button action
    window.previousPdpStep = function() {
      const steps = getPdpApplicableSteps(STATE.pdpProduct);
      const currentIndex = steps.findIndex(s => s.id === STATE.pdpCurrentStep);

      if (currentIndex > 0) {
        const prevStep = steps[currentIndex - 1];
        window.goToPdpStep(prevStep.id, false);
      } else {
        window.navigateToView('category-scrubs');
      }
    };

    // Skip optional step action
    window.skipPdpStep = function(stepId) {
      STATE.pdpSkippedSteps.add(stepId);
      STATE.pdpCompletedSteps.add(stepId);

      if (stepId === 'alterations') {
        STATE.pdpAlterations = false;
        const chk = document.getElementById('pdp-enable-alterations');
        if (chk) chk.checked = false;
        const box = document.getElementById('pdp-alterations-box');
        if (box) box.style.display = 'none';
      } else if (stepId === 'engraving') {
        window.setEngravingType('none');
      } else if (stepId === 'logo') {
        STATE.pdpLogoEnabled = false;
        const chk = document.getElementById('pdp-enable-logo');
        if (chk) chk.checked = false;
        const box = document.getElementById('pdp-logo-options-box');
        if (box) box.style.display = 'none';
        const logoWrap = document.getElementById('sim-logo-preview-wrap');
        if (logoWrap) logoWrap.style.display = 'none';
      }

      recalculatePdpSummary();

      // Advance to next step
      const steps = getPdpApplicableSteps(STATE.pdpProduct);
      const currentIndex = steps.findIndex(s => s.id === stepId);
      if (currentIndex >= 0 && currentIndex < steps.length - 1) {
        window.goToPdpStep(steps[currentIndex + 1].id, false);
      }
    };

    // Click handler for horizontal stepper buttons
    window.handleStepperClick = function(targetStepId) {
      if (targetStepId === STATE.pdpCurrentStep) return;

      const steps = getPdpApplicableSteps(STATE.pdpProduct);
      const targetIndex = steps.findIndex(s => s.id === targetStepId);
      const currentIndex = steps.findIndex(s => s.id === STATE.pdpCurrentStep);
      if (targetIndex === -1) return;

      // Navigating backwards or to any completed step is always permitted without losing data!
      if (targetIndex < currentIndex || STATE.pdpCompletedSteps.has(targetStepId)) {
        window.goToPdpStep(targetStepId, false);
        return;
      }

      // If jumping forward, validate current step first
      const isValid = validateCurrentPdpStep();
      if (!isValid) return;

      // If jumping ahead, verify intervening required steps are fulfilled
      let canJump = true;
      for (let i = currentIndex; i < targetIndex; i++) {
        const s = steps[i];
        if (!s.optional && !STATE.pdpCompletedSteps.has(s.id) && s.id !== STATE.pdpCurrentStep) {
          canJump = false;
          showStepError(STATE.pdpCurrentStep, `Please complete Step ${i + 1}: ${s.title} before navigating to ${steps[targetIndex].title}.`);
          break;
        }
      }

      if (canJump) {
        window.goToPdpStep(targetStepId, false);
      }
    };

