    function isColorLight(hex) {
      if (!hex || !hex.startsWith('#')) return false;
      const c = hex.substring(1);
      const rgb = parseInt(c.length === 3 ? c.split('').map(x => x + x).join('') : c, 16);
      const r = (rgb >> 16) & 0xff;
      const g = (rgb >> 8) & 0xff;
      const b = rgb & 0xff;
      const luma = 0.2126 * r + 0.7152 * g + 0.0722 * b;
      return luma > 185;
    }

    function renderPdpColors(colors) {
      const configGrid = document.getElementById('pdp-config-color-cards-grid');
      const bottomGrid = document.getElementById('pdp-bottom-swatches-grid');
      const nameEl = document.getElementById('pdp-config-selected-color-name');
      const bottomTitle = document.getElementById('pdp-selected-color-title');
      const dotEl = document.getElementById('pdp-color-indicator-dot');
      const countTag = document.getElementById('pdp-color-count-tag');

      if (!colors || !colors.length) {
        colors = [{ name: 'Standard Clinical Tone', hex: '#102A43' }];
      }

      const activeColor = STATE.pdpColor || colors[0];
      if (nameEl) nameEl.textContent = activeColor.name;
      if (bottomTitle) bottomTitle.textContent = activeColor.name;
      if (dotEl) dotEl.style.background = activeColor.hex;
      if (countTag) {
        countTag.textContent = `${colors.length} ${colors.length === 1 ? 'Colour' : 'Colours'} Available`;
      }

      // Step 1: Tactile cards in right column
      if (configGrid) {
        configGrid.innerHTML = colors.map((c, i) => {
          const isActive = activeColor.name.toLowerCase() === c.name.toLowerCase();
          const light = isColorLight(c.hex);
          const checkColor = light ? '#102a43' : '#ffffff';
          const escapedName = c.name.replace(/'/g, "\\'");
          return `
            <button
              type="button"
              class="pdp-color-card-chip ${isActive ? 'active' : ''}"
              onclick="window.selectPdpColor('${c.hex}', '${escapedName}', '${c.image || ''}')"
              title="${c.name}"
              aria-label="${c.name} colour swatch"
            >
              <span class="pdp-color-circle-preview" style="background: ${c.hex};">
                ${isActive ? `<span class="pdp-color-check-icon" style="color: ${checkColor};">✓</span>` : ''}
              </span>
              <div class="pdp-color-chip-meta">
                <span class="pdp-color-chip-title">${c.name}</span>
                <span class="pdp-color-chip-status">${isActive ? 'Selected' : 'Available'}</span>
              </div>
            </button>
          `;
        }).join('');
      }

      // Swatches beneath main photo in left column
      if (bottomGrid) {
        bottomGrid.innerHTML = colors.map((c, i) => {
          const isActive = activeColor.name.toLowerCase() === c.name.toLowerCase();
          const escapedName = c.name.replace(/'/g, "\\'");
          return `
            <button
              type="button"
              class="pdp-swatch-item ${isActive ? 'active' : ''}"
              onclick="window.selectPdpColor('${c.hex}', '${escapedName}', '${c.image || ''}')"
              title="${c.name}"
            >
              <span class="pdp-swatch-color-dot" style="background: ${c.hex};"></span>
              <span>${c.name}</span>
            </button>
          `;
        }).join('');
      }
    }

    function renderPdpSizes(sizes) {
      const grid = document.getElementById('pdp-sizes-grid');
      if (!grid) return;

      grid.innerHTML = sizes.map((s, i) => `
