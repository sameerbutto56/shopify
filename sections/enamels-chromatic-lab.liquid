        const logoFee = STATE.rtwLogoEnabled ? 650 : 0;
        const unitPrice = basePrice + customDyeFee + customSizeFee + embFee + logoFee;

        const requiresAdvance = isCustomSize || (embFee > 0) || (logoFee > 0) || (customDyeFee > 0);

        const m = STATE.rtwCustomMeasurements || {};
        const sizeTitle = isCustomSize ? 'C (Custom)' : `Standard Size ${STATE.rtwStandardSize}`;
        const properties = {
          'Size': sizeTitle,
          'Chest': `${m.chest} ${m.unit}`,
          'Waist': `${m.waist} ${m.unit}`,
          'Hips': `${m.hips} ${m.unit}`,
          'Shoulder Width': `${m.shoulder} ${m.unit}`,
          'Top / Shirt Length': `${m.shirt} ${m.unit}`,
          'Trouser / Inseam Length': `${m.inseam} ${m.unit}`,
          'Tailoring Specification': isCustomSize ? 'Custom Tailored Specification (C)' : 'Standard Hospital Fit'
        };

        if (STATE.rtwFabric?.name) properties['Fabric'] = STATE.rtwFabric.name;
        if (STATE.rtwColor?.name) properties['Colour'] = STATE.rtwColor.name;
        if (STATE.rtwColor?.isCustomDye) properties['Dye Formula'] = 'Bespoke Laboratory Dye';
        if (STATE.rtwEngravingType !== 'none' && STATE.rtwEngravingLines?.line1) {
          properties['Embroidery Line 1'] = STATE.rtwEngravingLines.line1;
          if (STATE.rtwEngravingLines.line2) properties['Embroidery Line 2'] = STATE.rtwEngravingLines.line2;
          properties['Thread Color'] = STATE.rtwThreadColor?.name || 'Silk White';
        }
        if (STATE.rtwLogoEnabled && STATE.rtwLogo?.name) {
          properties['Hospital Crest'] = STATE.rtwLogo.name;
        }

        const cartItem = {
          id: `rtw-${Date.now()}`,
          productId: STATE.rtwDesign?.id || 'rtw-custom',
          title: `Make Your Own Scrubs — ${STATE.rtwDesign?.name || 'Custom Medical Scrub'}`,
          series: STATE.rtwArticle?.name || 'Bespoke Series',
          image: STATE.rtwDesign?.image || 'cat-sprinter.jpg',
          fabric: STATE.rtwFabric?.name || 'Sprinter Performance Twill',
          color: STATE.rtwColor?.name || 'Deep Navy',
          colorHex: STATE.rtwColor?.hex || '#102A43',
          customDye: STATE.rtwColor?.isCustomDye ? 'Bespoke Laboratory Dye (+Rs. 500)' : 'Standard Shade',
          size: sizeTitle,
          standardSize: isCustomSize ? 'C' : STATE.rtwStandardSize,
          isCustomSize: isCustomSize,
          customMeasurements: {
            chest: `${m.chest} ${m.unit}`,
            waist: `${m.waist} ${m.unit}`,
            hips: `${m.hips} ${m.unit}`,
            shoulder: `${m.shoulder} ${m.unit}`,
            shirt: `${m.shirt} ${m.unit}`,
            inseam: `${m.inseam} ${m.unit}`,
            unit: m.unit
          },
          properties: properties,
          engraving: STATE.rtwEngravingType !== 'none' ? {
            type: 'direct',
            lines: STATE.rtwEngravingLines,
            threadColor: STATE.rtwThreadColor?.name || 'White',
            font: 'Times New Roman'
          } : null,
          logo: STATE.rtwLogoEnabled ? STATE.rtwLogo : null,
          quantity: 1,
          unitPrice: unitPrice,
          lineTotal: unitPrice,
          requiresAdvancePayment: requiresAdvance
        };

        const cart = getStoredCart();
        cart.push(cartItem);
        saveCart(cart);
        updateCartBadge();
