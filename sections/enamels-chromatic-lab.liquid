        window.openComingSoonModal('self-service');
      } else if (hash === '#bulk-order') {
        window.openComingSoonModal('bulk-order');
      } else if (hash === '#men') {
        window.navigateToGender('men', 'all', 'all');
      } else if (hash === '#women') {
        window.navigateToGender('women', 'all', 'all');
      } else if (hash === '#men-scrubs') {
        window.navigateToGender('men', 'scrubs', 'all');
      } else if (hash === '#women-scrubs') {
        window.navigateToGender('women', 'scrubs', 'all');
      } else if (hash === '#men-lab-coat') {
        window.navigateToGender('men', 'lab-coat', 'all');
      } else if (hash === '#women-lab-coat') {
        window.navigateToGender('women', 'lab-coat', 'all');
      } else if (hash === '#men-caps') {
        window.navigateToGender('men', 'caps', 'all');
      } else if (hash === '#women-caps') {
        window.navigateToGender('women', 'caps', 'all');
      } else if (hash === '#men-accessories') {
        window.navigateToGender('men', 'accessories', 'all');
      } else if (hash === '#women-accessories') {
        window.navigateToGender('women', 'accessories', 'all');
      } else if (hash.startsWith('#men-')) {
        const rest = rawHash.replace(/#men-/i, '');
        if (['scrubs', 'lab-coat', 'caps', 'accessories'].includes(rest.toLowerCase())) {
          window.navigateToGender('men', rest.toLowerCase(), 'all');
        } else {
          const cap = rest.toLowerCase() === 'flexfit' ? 'Flexwell' : (rest.charAt(0).toUpperCase() + rest.slice(1));
          window.navigateToGender('men', 'scrubs', cap);
        }
      } else if (hash.startsWith('#women-')) {
        const rest = rawHash.replace(/#women-/i, '');
        if (['scrubs', 'lab-coat', 'caps', 'accessories'].includes(rest.toLowerCase())) {
          window.navigateToGender('women', rest.toLowerCase(), 'all');
        } else {
          const cap = rest.toLowerCase() === 'flexfit' ? 'Flexwell' : (rest.charAt(0).toUpperCase() + rest.slice(1));
          window.navigateToGender('women', 'scrubs', cap);
        }
      } else if (hash === '#summer-collection') {
        window.navigateToSeasonalCollection('summer');
      } else if (hash === '#winter-collection') {
        window.navigateToSeasonalCollection('winter');
      } else if (hash === '#category-scrubs') {
        window.navigateToGender(STATE.genderFilter || 'men', 'all', 'all');
      } else if (hash === '#ready-to-wear') {
        window.navigateToView('ready-to-wear');
      } else if (hash === '#self-service' || hash === '#self-service-booking' || hash === '#representative-visit-section') {
        window.navigateToView('self-service');
      } else if (hash === '#self-service-admin') {
        window.navigateToView('self-service');
        if (typeof window.openSelfServiceAdminModal === 'function') {
          setTimeout(() => window.openSelfServiceAdminModal(), 200);
        }
      } else if (hash === '#product-studio') {
        if (STATE.pdpProduct) {
          window.openProductStudio(STATE.pdpProduct.id);
        } else {
          window.openProductStudio(null);
        }
      } else if (hash.startsWith('#collection-')) {
        const target = rawHash.replace(/#collection-/i, '');
        if (['sprinter', 'velora', 'crown', 'flexwell', 'flexfit'].includes(target.toLowerCase())) {
          const capSeries = target.toLowerCase() === 'flexfit' ? 'Flexwell' : (target.charAt(0).toUpperCase() + target.slice(1));
          window.navigateToGender(STATE.genderFilter || 'men', 'scrubs', capSeries);
        } else if (['caps', 'lab-coat', 'accessories', 'clogs'].includes(target.toLowerCase())) {
          const catKey = target.toLowerCase() === 'clogs' ? 'accessories' : target.toLowerCase();
          window.navigateToGender(STATE.genderFilter || 'men', catKey, 'all');
        } else {
          window.navigateToCollection(target, 'category');
        }
      } else if (hash.startsWith('#product-')) {
        const prodId = rawHash.replace(/#product-/i, '');
        window.openProductStudio(prodId);
      }
    }

    // ------------------------------------------------------------
    // 4. SLIDESHOW BANNER CONTROLLER (SECTION 3)
    // ------------------------------------------------------------
    function initSlideshow() {
      updateBannerSlidePositions();
      startSlideAutoplay();

      const container = document.getElementById('enamels-hero-slideshow');
      if (container) {
        container.addEventListener('mouseenter', () => { STATE.slidePaused = true; });
        container.addEventListener('mouseleave', () => { STATE.slidePaused = false; });
      }
    }

    function startSlideAutoplay() {
      const isAutoplay = {{ section.settings.slideshow_autoplay | default: true | json }};
      if (isAutoplay === false) return;
      if (STATE.slideTimer) clearInterval(STATE.slideTimer);
      const speedSetting = Number({{ section.settings.slideshow_speed | default: 5 | json }});
      const slideDelayMs = (isNaN(speedSetting) || speedSetting <= 0 ? 5 : speedSetting) * 1000;
      STATE.slideTimer = setInterval(() => {
        if (!STATE.slidePaused) {
          window.stepBannerSlide(1);
        }
      }, slideDelayMs);
    }

    window.stepBannerSlide = function(direction) {
      STATE.slideIndex = (STATE.slideIndex + direction + STATE.slideCount) % STATE.slideCount;
      updateBannerSlidePositions();
    };

    window.jumpToBannerSlide = function(idx) {
      STATE.slideIndex = (idx + STATE.slideCount) % STATE.slideCount;
      updateBannerSlidePositions();
    };

    function updateBannerSlidePositions() {
      const track = document.getElementById('enamels-slideshow-track');
      if (track) {
        track.style.transform = `translateX(-${STATE.slideIndex * 100}%)`;
      }
      const dots = document.querySelectorAll('.slideshow-dot');
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === STATE.slideIndex);
      });
    }

    // ------------------------------------------------------------
    // 4b. 3D CATEGORY CARDS CONTROLLER (SECTION 2 - 3D REDESIGN)
    // ------------------------------------------------------------
    function init3DCategoryCards() {
      const cards = document.querySelectorAll('.category-card-3d-wrap');
      if (!cards.length) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isTouch = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0) || window.innerWidth <= 768;

      // IntersectionObserver for staggered entrance in-view trigger
      if ('IntersectionObserver' in window && !prefersReducedMotion) {
        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              obs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });

        cards.forEach(c => observer.observe(c));
      }

      // If user prefers reduced motion or is on mobile touch, skip 3D pointer tilt
      if (prefersReducedMotion || isTouch) return;

      cards.forEach(wrap => {
        const card = wrap.querySelector('.category-card-3d');
        const glare = wrap.querySelector('.category-card-glare');
        if (!card) return;

        let rect = null;
        let rafId = null;

        function onMouseEnter() {
          rect = wrap.getBoundingClientRect();
          card.style.transition = 'transform 0.1s ease-out, box-shadow 0.3s ease, border-color 0.3s ease';
          if (glare) glare.style.opacity = '1';
        }

        function onMouseMove(e) {
          if (!rect) rect = wrap.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;

          const centerX = rect.width / 2;
          const centerY = rect.height / 2;

          // Subtle, elegant tilt: max ±6 degrees
          const rotateX = ((centerY - y) / centerY) * 6;
          const rotateY = ((x - centerX) / centerX) * 6;

          // Radial glare position
          if (glare) {
            const glareX = (x / rect.width) * 100;
            const glareY = (y / rect.height) * 100;
            glare.style.background = `radial-gradient(circle at ${glareX}% ${glareY}%, rgba(255, 255, 255, 0.45) 0%, rgba(255, 255, 255, 0) 65%)`;
          }

          if (rafId) cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(() => {
            card.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) translateZ(8px)`;
          });
        }

        function onMouseLeave() {
          if (rafId) cancelAnimationFrame(rafId);
          rect = null;
          card.style.transition = 'transform 0.5s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.4s ease, border-color 0.3s ease';
          card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(0px)';
          if (glare) {
            glare.style.opacity = '0';
          }
        }

        wrap.addEventListener('mouseenter', onMouseEnter, { passive: true });
        wrap.addEventListener('mousemove', onMouseMove, { passive: true });
        wrap.addEventListener('mouseleave', onMouseLeave, { passive: true });
      });
    }

