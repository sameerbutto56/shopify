<!-- CHROMATIC JAVASCRIPT ENGINE -->
<script>
  (function() {
    window.currentChromaColor = 'navy';

    document.addEventListener('DOMContentLoaded', initChromaticLab);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(initChromaticLab, 80);
    }

    function initChromaticLab() {
      // 1. 3D Mouse Parallax on Hero Card
      const heroStage = document.getElementById('hero-3d-stage');
      const heroCard = document.getElementById('hero-interactive-card');

      if (heroStage && heroCard && window.innerWidth > 990) {
        heroStage.addEventListener('mousemove', function(e) {
          const rect = heroStage.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;
          const rotateX = (-y / rect.height) * 15;
          const rotateY = (x / rect.width) * 15;
          heroCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
        });

        heroStage.addEventListener('mouseleave', function() {
          heroCard.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
        });
      }

      // 2. The Colour Lab Swatch Switching
      const swatches = document.querySelectorAll('.chroma-swatch-btn');
      swatches.forEach(btn => {
        btn.addEventListener('click', function() {
          swatches.forEach(b => b.classList.remove('active'));
          this.classList.add('active');

          const colorKey = this.dataset.color;
          window.currentChromaColor = colorKey;
          const title = this.dataset.title;
          const dept = this.dataset.dept;
          const img = this.dataset.img;

          const titleEl = document.getElementById('stage-color-title');
          const deptEl = document.getElementById('stage-dept-text');
          const imgEl = document.getElementById('stage-active-img');

          if (titleEl) titleEl.textContent = title;
          if (deptEl) deptEl.textContent = dept;
          if (imgEl && img) imgEl.src = img;
        });
      });

      // 3. Studio Customizer Live Inputs
      const inputName = document.getElementById('studio-input-name');
      const inputDept = document.getElementById('studio-input-dept');
      const prev1 = document.getElementById('studio-emb-preview1');
      const prev2 = document.getElementById('studio-emb-preview2');

      if (inputName && prev1) {
        inputName.addEventListener('input', function() {
          prev1.textContent = this.value || 'Dr. Full Name';
        });
      }

      if (inputDept && prev2) {
        inputDept.addEventListener('input', function() {
          prev2.textContent = this.value || 'Department / Specialty';
        });
      }

      // Thread swatches
      document.querySelectorAll('.thread-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          document.querySelectorAll('.thread-btn').forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          const hex = this.dataset.hex;
          if (prev1) prev1.style.color = hex;
          if (prev2) prev2.style.color = hex;
        });
      });

      // Studio tier radio switches
      document.querySelectorAll('input[name="studio-tier"]').forEach(radio => {
        radio.addEventListener('change', function() {
          document.querySelectorAll('.tier-radio-card').forEach(c => c.classList.remove('active'));
          this.closest('.tier-radio-card').classList.add('active');
          updateStudioPrice();
        });
      });

      // Garment select switch
      const garmentSel = document.getElementById('studio-garment-select');
      if (garmentSel) {
        garmentSel.addEventListener('change', updateStudioPrice);
      }

      function updateStudioPrice() {
        const sel = document.getElementById('studio-garment-select');
        const opt = sel ? sel.options[sel.selectedIndex] : null;
        const base = opt ? parseInt(opt.dataset.price) : 5150;

        const tier = document.querySelector('input[name="studio-tier"]:checked')?.value || 'embroidery';
        let customFee = 0;
        if (tier === 'embroidery') customFee = 450;
        if (tier === 'patch') customFee = 350;
        if (tier === 'logo') customFee = 650;

        const total = base + customFee;
        const totalEl = document.getElementById('studio-total-price');
        if (totalEl) totalEl.textContent = `Rs. ${total.toLocaleString()}`;
      }

      // Studio Size Buttons
      document.querySelectorAll('.studio-size-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          document.querySelectorAll('.studio-size-btn').forEach(b => b.classList.remove('active'));
          this.classList.add('active');
        });
      });

      // 4. Render Main Catalogue Grid
      renderChromaGrid();
    }

    // Grid rendering from window.EnamelsCatalogue
    let activeChromaCat = 'all';
    let activeChromaGender = 'all';
    let activeChromaSeries = 'all';
    let activeChromaPrice = 'all';
    let activeChromaSort = 'featured';

    function renderChromaGrid() {
      const grid = document.getElementById('chroma-grid');
      if (!grid) return;

      const items = window.EnamelsCatalogue || [];
      let filtered = items.filter(item => {
        if (activeChromaCat !== 'all' && item.category !== activeChromaCat) return false;
        if (activeChromaGender !== 'all' && item.gender !== activeChromaGender && item.gender !== 'unisex') return false;
        if (activeChromaSeries !== 'all' && item.series !== activeChromaSeries) return false;
        if (activeChromaPrice === 'under-3000' && item.basePrice >= 3000) return false;
        if (activeChromaPrice === '3000-6000' && (item.basePrice < 3000 || item.basePrice > 6000)) return false;
        if (activeChromaPrice === 'above-6000' && item.basePrice <= 6000) return false;
        return true;
      });

      if (activeChromaSort === 'price-low') {
        filtered.sort((a, b) => a.basePrice - b.basePrice);
      } else if (activeChromaSort === 'price-high') {
        filtered.sort((a, b) => b.basePrice - a.basePrice);
      } else if (activeChromaSort === 'name') {
        filtered.sort((a, b) => a.title.localeCompare(b.title));
      }

      const counter = document.getElementById('main-product-counter');
      if (counter) counter.textContent = `${filtered.length} Products Loaded`;

      grid.innerHTML = filtered.map(item => `
        <div class="demo-product-card enamels-3d-card" style="background:#1E293B; border-color: rgba(255,255,255,0.1);" onclick="window.openEnamelsPdpModal('${item.id}')">
          <div class="card-image-box" style="background:#0B1224;">
            ${item.badge ? `<span class="card-badge" style="background:var(--teal-electric); color:var(--navy-midnight);">${item.badge}</span>` : ''}
            <img src="{{ '' | asset_url }}${item.image}" alt="${item.title}" loading="lazy" />
            <span class="card-fabric-pill" style="background:rgba(11,18,36,0.85); color:#ffffff;">${item.fabric}</span>
          </div>
          <div class="card-body">
            <span class="card-sku" style="color:var(--teal-electric);">${item.sku}</span>
            <h4 class="card-title" style="color:#ffffff;">${item.title}</h4>
            <div class="card-colors">
              ${item.colors.map(c => `
                <span class="color-dot" style="background-color: ${c.hex};" title="${c.name}"></span>
              `).join('')}
            </div>
            <div class="card-footer" style="border-top-color: rgba(255,255,255,0.1);">
              <div class="card-price-group">
                <span class="card-price" style="color:#ffffff;">Rs. ${item.basePrice.toLocaleString()}</span>
                ${item.comparePrice ? `<span class="card-compare">Rs. ${item.comparePrice.toLocaleString()}</span>` : ''}
              </div>
              <button type="button" class="card-btn" style="background:var(--teal-electric); color:var(--navy-midnight);">Customize & Fit</button>
            </div>
          </div>
        </div>
      `).join('');
    }

    // Category Tabs Listener
    document.addEventListener('click', function(e) {
      if (e.target.classList.contains('chroma-tab-btn')) {
        document.querySelectorAll('.chroma-tab-btn').forEach(b => b.classList.remove('active'));
        e.target.classList.add('active');
        activeChromaCat = e.target.dataset.cat;
        renderChromaGrid();
      }
    });

    // Filter Listeners
    document.addEventListener('change', function(e) {
      if (e.target.id === 'chroma-filter-gender') { activeChromaGender = e.target.value; renderChromaGrid(); }
      if (e.target.id === 'chroma-filter-series') { activeChromaSeries = e.target.value; renderChromaGrid(); }
      if (e.target.id === 'chroma-filter-price') { activeChromaPrice = e.target.value; renderChromaGrid(); }
      if (e.target.id === 'chroma-sort') { activeChromaSort = e.target.value; renderChromaGrid(); }
    });

    // Public Window Helpers
    window.scrollToCustomizer = function() {
      const el = document.getElementById('interactive-studio');
      if (el) el.scrollIntoView({ behavior: 'smooth' });
    };

    window.filterByGender = function(gender) {
      const gSel = document.getElementById('chroma-filter-gender');
      if (gSel) gSel.value = gender;
      activeChromaGender = gender;
      renderChromaGrid();
      const catSec = document.getElementById('catalogue-section');
      if (catSec) catSec.scrollIntoView({ behavior: 'smooth' });
    };

    window.filterBySeries = function(series) {
      const sSel = document.getElementById('chroma-filter-series');
      if (sSel) sSel.value = series;
      activeChromaSeries = series;
      renderChromaGrid();
      const catSec = document.getElementById('catalogue-section');
      if (catSec) catSec.scrollIntoView({ behavior: 'smooth' });
    };

    window.filterCatalogueByColour = function(colorKey) {
      const catSec = document.getElementById('catalogue-section');
      if (catSec) catSec.scrollIntoView({ behavior: 'smooth' });
    };

    window.addStudioItemToCart = function() {
      const sel = document.getElementById('studio-garment-select');
      const opt = sel ? sel.options[sel.selectedIndex] : null;
      const base = opt ? parseInt(opt.dataset.price) : 5150;
      const title = opt ? opt.textContent.split('(')[0].trim() : 'Custom Scrub';

      const tier = document.querySelector('input[name="studio-tier"]:checked')?.value || 'embroidery';
      let customFee = 0;
      if (tier === 'embroidery') customFee = 450;
      if (tier === 'patch') customFee = 350;
      if (tier === 'logo') customFee = 650;

      const size = document.querySelector('.studio-size-btn.active')?.dataset.size || 'M';
      const name = document.getElementById('studio-input-name')?.value || 'Dr. Full Name';
      const dept = document.getElementById('studio-input-dept')?.value || 'Clinical Ward';

      const cartItem = {
        id: 'studio-custom-' + Date.now(),
        sku: 'ENM-STUDIO-CST',
        title: title,
        color: 'Deep Midnight Navy',
        size: size,
        customization: tier,
        embroideryLine1: tier === 'embroidery' ? name : '',
        embroideryLine2: tier === 'embroidery' ? dept : '',
        price: base + customFee,
        image: 'demo-sprinter-navy.jpg',
        quantity: 1
      };

      const cart = JSON.parse(localStorage.getItem('enamels_demo_cart') || '[]');
      cart.push(cartItem);
      localStorage.setItem('enamels_demo_cart', JSON.stringify(cart));

      window.openDemoCheckoutModal();
    };

    window.addDuoBundleToCart = function() {
      const cart = JSON.parse(localStorage.getItem('enamels_demo_cart') || '[]');
      cart.push({
        id: 'demo-bnd-shift-duo',
        sku: 'ENM-BND-SHF-DUO',
        title: "DEMO — Sprinter Shift Duo Kit (Scrub Set + BunFit Cap + Med Sleeves)",
        color: 'Deep Midnight Navy',
        size: 'M',
        customization: 'none',
        price: 6850,
        image: 'demo-sprinter-navy.jpg',
        quantity: 1
      });
      localStorage.setItem('enamels_demo_cart', JSON.stringify(cart));
      window.openDemoCheckoutModal();
    };
  })();
</script>

