          size: STATE.rtwSizeMode === 'standard' ? `Standard Size ${STATE.rtwStandardSize}` : 'Custom Tailored Measurements',
          customMeasurements: STATE.rtwSizeMode === 'custom' ? STATE.rtwCustomMeasurements : null,
          engraving: STATE.rtwEngravingType !== 'none' ? {
            type: 'direct',
            lines: STATE.rtwEngravingLines,
            threadColor: STATE.rtwThreadColor?.name || 'White',
