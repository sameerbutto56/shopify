                  loading="lazy"
                />
                <span class="article-card-badge" style="position: absolute; top: 10px; left: 10px; background: rgba(16, 42, 67, 0.85); color: #ffffff; padding: 2px 8px; border-radius: 4px; font-size: 9px; font-weight: 700; text-transform: uppercase;">${meta.badge}</span>
              </div>
              <div class="collection-category-info">
                <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 4px; margin-bottom: 2px;">
                  <h3 class="collection-category-title">${meta.name}</h3>
                  <span class="article-card-count" style="font-size: 11px; font-weight: 700; color: #008779;">${count} ${count === 1 ? 'Design' : 'Designs'}</span>
                </div>
