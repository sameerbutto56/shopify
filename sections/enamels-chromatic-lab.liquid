                  <span class="article-card-count" style="font-size: 11px; font-weight: 700; color: #008779;">${count} ${count === 1 ? 'Article' : 'Articles'}</span>
                </div>
                <p class="collection-category-desc">${meta.tagline}</p>
                <div class="collection-category-action">
                  <span>Browse ${meta.name} Articles</span>
                  <span class="category-arrow-icon">→</span>
                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');

      const totalCount = genderItems.length;
      const catMeta = CATEGORY_META[catKey] || { name: 'Category' };
      const allAnimDelay = validBrands.length * 70;
      cardsHtml += `
        <div class="collection-category-card-3d-wrap" style="animation-delay: ${allAnimDelay}ms;">
