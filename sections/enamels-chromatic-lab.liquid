    window.toggleRtwLogo = function(checked) {
      STATE.rtwLogoEnabled = checked;
      const wrap = document.getElementById('rtw-logo-select-wrap');
      if (wrap) wrap.style.display = checked ? 'block' : 'none';
      const emblem = document.getElementById('rtw-crest-emblem');
      if (emblem) emblem.style.display = checked ? 'flex' : 'none';
      window.updateRtwSim();
    };

    window.updateRtwSim = function() {
      const nameInput = document.getElementById('rtw-embroidery-name');
      const deptInput = document.getElementById('rtw-embroidery-dept');
      const hospInput = document.getElementById('rtw-embroidery-hosp');

      const nameVal = nameInput?.value?.trim() || '';
      const deptVal = deptInput?.value?.trim() || '';
      const hospVal = hospInput?.value?.trim() || '';

      // Update character counters
      const count1 = document.getElementById('rtw-count-1');
      const count2 = document.getElementById('rtw-count-2');
      const count3 = document.getElementById('rtw-count-3');
      if (count1 && nameInput) count1.textContent = `${nameInput.value.length} / 28`;
      if (count2 && deptInput) count2.textContent = `${deptInput.value.length} / 32`;
      if (count3 && hospInput) count3.textContent = `${hospInput.value.length} / 35`;

      STATE.rtwEngravingLines = { line1: nameVal, line2: deptVal, line3: hospVal };
      if (!STATE.rtwEngravingType || STATE.rtwEngravingType === 'none') {
        if (nameVal || deptVal) STATE.rtwEngravingType = 'direct';
      }

      const line1 = document.getElementById('rtw-sim-line-1');
      const line2 = document.getElementById('rtw-sim-line-2');
      const line3 = document.getElementById('rtw-sim-line-3');
      const garmentLine = document.getElementById('rtw-garment-sim-line');

      if (line1) line1.textContent = nameVal ? nameVal.toUpperCase() : 'DR. AYESHA MALIK';
      if (line2) line2.textContent = deptVal ? deptVal.toUpperCase() : 'CARDIOLOGY';
      if (line3) {
        if (hospVal) {
          line3.textContent = hospVal.toUpperCase();
          line3.style.display = 'block';
        } else {
          line3.style.display = 'none';
        }
      }
      if (garmentLine) garmentLine.textContent = nameVal ? nameVal.toUpperCase() : 'DR. AYESHA MALIK';

      // Update Hospital Crest
      const emblem = document.getElementById('rtw-crest-emblem');
      const crestCode = document.getElementById('rtw-crest-code');
      if (STATE.rtwLogoEnabled) {
        const logoSelect = document.getElementById('rtw-logo-select');
        const code = logoSelect ? logoSelect.value : 'AKUH';
        if (crestCode) crestCode.textContent = code;
        if (emblem) emblem.style.display = 'flex';
        STATE.rtwLogo = {
          code: code,
          name: logoSelect ? (logoSelect.options[logoSelect.selectedIndex]?.text || code) : 'Hospital Crest'
        };
      } else {
        if (emblem) emblem.style.display = 'none';
      }

      // Ensure macro stage fabric color matches selected shade
      const stage = document.getElementById('rtw-macro-stage');
      if (stage && STATE.rtwColor?.hex) {
        stage.style.setProperty('--rtw-preview-fabric', STATE.rtwColor.hex);
      }
    };

    function renderRtwReview() {
      const fabricEl = document.getElementById('rtw-rev-fabric');
      const colorEl = document.getElementById('rtw-rev-color');
      const articleEl = document.getElementById('rtw-rev-article');
      const sizeEl = document.getElementById('rtw-rev-size');
      const embRow = document.getElementById('rtw-rev-emb-row');
      const embEl = document.getElementById('rtw-rev-emb');
      const logoRow = document.getElementById('rtw-rev-logo-row');
      const logoEl = document.getElementById('rtw-rev-logo');
      const totalEl = document.getElementById('rtw-rev-total');
      const advAlert = document.getElementById('rtw-advance-alert');

      if (fabricEl) fabricEl.textContent = STATE.rtwFabric?.name || 'Sprinter Performance Twill';
      if (colorEl) {
        colorEl.innerHTML = `<span class="pdp-swatch-color-dot" style="background: ${STATE.rtwColor?.hex || '#102A43'}; width: 10px; height: 10px; display: inline-block; vertical-align: middle; margin-right: 4px;"></span><strong>${STATE.rtwColor?.name || 'Deep Navy'}</strong>`;
      }
      if (articleEl) {
        articleEl.textContent = `${STATE.rtwArticle?.name || 'Sprinter Series'} — ${STATE.rtwDesign?.name || 'Scrub Set'}`;
      }
      if (sizeEl) {
        if (STATE.rtwSizeMode === 'custom') {
          const m = STATE.rtwCustomMeasurements;
          const details = [
            m.chest ? `Chest: ${m.chest}${m.unit}` : '',
            m.waist ? `Waist: ${m.waist}${m.unit}` : '',
            m.hips ? `Hips: ${m.hips}${m.unit}` : ''
          ].filter(Boolean).join(', ');
          sizeEl.textContent = `Custom Tailored (${details || STATE.rtwUnit})`;
        } else {
          sizeEl.textContent = `Standard Size ${STATE.rtwStandardSize}`;
        }
      }

      const basePrice = (STATE.rtwDesign?.price || 5150) + (STATE.rtwFabric?.price || 0);
      const customSizeFee = STATE.rtwSizeMode === 'custom' ? 750 : 0;
      const embFee = (STATE.rtwEngravingType !== 'none') ? 450 : 0;
      const logoFee = STATE.rtwLogoEnabled ? 650 : 0;
      const total = basePrice + customSizeFee + embFee + logoFee;

      if (embRow) {
        embRow.style.display = embFee > 0 ? 'table-row' : 'none';
        if (embEl) embEl.textContent = `+Rs. 450 (${STATE.rtwEngravingLines.line1 || 'Times New Roman'})`;
      }
      if (logoRow) {
        logoRow.style.display = logoFee > 0 ? 'table-row' : 'none';
        if (logoEl) logoEl.textContent = `+Rs. 650 (${STATE.rtwLogo?.name || 'Hospital Crest'})`;
      }
      if (totalEl) {
        totalEl.textContent = `Rs. ${total.toLocaleString()}`;
      }

      const requiresAdvance = (STATE.rtwSizeMode === 'custom') || (embFee > 0) || (logoFee > 0);
      if (advAlert) {
        advAlert.style.display = requiresAdvance ? 'flex' : 'none';
      }
    }

