    function getTopCategory(item) {
      if (!item) return 'accessories';
      const cat = (item.category || '').toLowerCase();
      if (['scrub-set', 'scrub-top', 'scrub-pants'].includes(cat)) return 'scrubs';
      if (cat === 'lab-coat') return 'lab-coat';
      if (cat === 'caps') return 'caps';
      if (cat === 'sleeves') return 'sleeves';
      if (['accessories', 'patches', 'bundles', 'clogs'].includes(cat)) return 'accessories';
      return 'accessories';
    }

    function canonicalizeBrand(name) {
      if (!name || name === 'all') return 'all';
      const lower = name.toLowerCase().trim();
      if (lower === 'vilora' || lower === 'velora') return 'Vilora';
      if (lower === 'splender' || lower === 'sprinter') return 'Sprinter';
      if (lower === 'crown') return 'Crown';
      if (lower === 'ground') return 'Ground';
      if (lower === 'flexfit' || lower === 'flexwell') return 'FlexFit';
      if (lower === 'helium') return 'Helium';
      if (lower === 'suiting') return 'Suiting';
      if (lower === 'bunfit') return 'BunFit';
      if (lower === 'accessories' || lower === 'sleeves') return 'Accessories';
      return name.charAt(0).toUpperCase() + name.slice(1);
    }

    function getDisplayBrandName(name) {
      if (!name || name === 'all') return 'All Brands';
      return canonicalizeBrand(name);
