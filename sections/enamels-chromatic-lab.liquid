{% comment %}
  Enamels Chromatic Scrub Lab — Master Medical Fashion Storefront Experience
  Radical Visual Redesign: Deep Midnight Navy (#0B1224), Electric Teal (#00D6C9),
  Vivid Cobalt (#4263FF), Acid Lime (#D9FF70), Soft Lilac (#C9B7FF), Warm Off-White (#F4F1EB).
  Features full-bleed cinematic hero, 3D cursor parallax, interactive Colour Lab,
  35-product 3D catalogue, split-screen PDP studio, and demo checkout flow.
{% endcomment %}

<script src="{{ 'enamels-catalogue-data.js' | asset_url }}" defer></script>

<div class="chromatic-lab-wrapper" id="chromatic-lab-root">
  <!-- ============================================================ -->
  <!-- 1. CINEMATIC HERO CAMPAIGN: "COLOUR YOUR CALLING"            -->
  <!-- ============================================================ -->
  <section class="chromatic-hero" id="hero-campaign">
    <!-- Ambient layered mesh backgrounds -->
    <div class="hero-ambient-mesh">
      <div class="mesh-orb orb-teal"></div>
      <div class="mesh-orb orb-cobalt"></div>
      <div class="mesh-orb orb-coral"></div>
    </div>

    <div class="hero-content-grid page-width">
      <!-- Left Column: Typography & CTAs -->
      <div class="hero-text-block">
        <div class="hero-eyebrow-pill">
          <span class="pulse-dot"></span>
          <span>CHROMATIC MEDICAL COUTURE • 2026</span>
        </div>

        <h1 class="hero-headline">
          COLOUR YOUR<br>
          <span class="gradient-text">CALLING.</span>
        </h1>

        <p class="hero-subtext">
          Medical wear designed for the people who make a difference. Crafted from proprietary 4-way stretch fabrics, tailored with architectural precision, and saturated in clinical colour.
        </p>

        <div class="hero-cta-group">
          <a href="#catalogue-section" class="btn-chromatic-primary">
            <span>Explore Scrubs</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <button type="button" class="btn-chromatic-secondary" onclick="window.scrollToCustomizer()">
            <span>Build Your Look</span>
            <span class="btn-tag">3D Studio</span>
          </button>
        </div>

        <!-- Micro stats strip -->
        <div class="hero-stats-strip">
          <div class="stat-pill">
            <strong>4-Way</strong>
            <span>Mechanical Stretch</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-pill">
            <strong>100+</strong>
            <span>Autoclave Washes</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-pill">
            <strong>Rs. 7,000+</strong>
            <span>Free Shipping PK</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Layered 3D Garment Stage -->
      <div class="hero-stage-block" id="hero-3d-stage">
        <div class="hero-card-frame enamels-3d-card" id="hero-interactive-card">
          <!-- Floating glass badge 1 -->
          <div class="floating-badge badge-top-right">
            <span class="badge-icon">⚡</span>
            <div>
              <strong>Sprinter Series</strong>
              <span>Deep Midnight Navy</span>
            </div>
          </div>

          <!-- Main photography image -->
          <div class="hero-photo-wrapper">
            <img 
              id="hero-main-photo"
              src="{{ 'demo-sprinter-navy.jpg' | asset_url }}" 
              alt="Enamels Sprinter Medical Scrub Set in Deep Midnight Navy" 
              class="hero-photo-img"
              loading="eager"
              width="800"
              height="1000"
            />
          </div>

          <!-- Floating glass badge 2 -->
          <div class="floating-badge badge-bottom-left">
            <span class="badge-icon">🪡</span>
            <div>
              <strong>Custom Embroidery</strong>
              <span>Certified Hospital Digits</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- HORIZONTAL TICKER MARQUEE -->
    <div class="chromatic-ticker">
      <div class="ticker-track">
        <span>✦ 4-WAY MECHANICAL STRETCH</span>
        <span>✦ FLUID-REPELLENT SHIELD</span>
        <span>✦ ANTIMICROBIAL SILVADUR™</span>
        <span>✦ ENGINEERED FOR 24H SHIFTS</span>
        <span>✦ FREE NATIONWIDE DELIVERY OVER RS. 7,000</span>
        <span>✦ CASH ON DELIVERY AVAILABLE ACROSS PAKISTAN</span>
        <span>✦ 7-DAY HASSLE-FREE SIZE EXCHANGE</span>
        <span>✦ 4-WAY MECHANICAL STRETCH</span>
        <span>✦ FLUID-REPELLENT SHIELD</span>
        <span>✦ ANTIMICROBIAL SILVADUR™</span>
        <span>✦ ENGINEERED FOR 24H SHIFTS</span>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 2. SHOP BY YOUR STYLE: ASYMMETRIC EDITORIAL CARDS            -->
  <!-- ============================================================ -->
  <section class="chromatic-section style-section" id="shop-style">
    <div class="page-width">
      <div class="section-title-wrap">
        <span class="section-accent-tag">CATEGORY ARCHITECTURE</span>
        <h2 class="section-heading">Engineered for Your Specialty</h2>
        <p class="section-subheading">From high-tempo ER shifts to executive consultation rounds, select your purpose-built clinical fit.</p>
      </div>

      <div class="style-cards-grid">
        <!-- Men's Card -->
        <div class="style-card card-men enamels-3d-card" onclick="window.filterByGender('men')">
          <div class="style-card-image">
            <img src="{{ 'demo-sprinter-navy.jpg' | asset_url }}" alt="Men's Athletic Scrubs" loading="lazy" width="600" height="750" />
          </div>
          <div class="style-card-overlay">
            <span class="style-pill">ATHLETIC MOBILITY</span>
            <h3 class="style-card-title">Men's Scrubs</h3>
            <p class="style-card-desc">Raglan sleeve construction, 6-pocket cargo utility, and ribbed ankle joggers.</p>
            <span class="style-link">Explore Men's (From Rs. 5,150) →</span>
          </div>
        </div>

        <!-- Women's Card -->
        <div class="style-card card-women enamels-3d-card" onclick="window.filterByGender('women')">
          <div class="style-card-image">
            <img src="{{ 'demo-velora-teal.jpg' | asset_url }}" alt="Women's Tailored Scrubs" loading="lazy" width="600" height="750" />
          </div>
          <div class="style-card-overlay">
            <span class="style-pill" style="background:#00D6C9; color:#0B1224;">TAILORED DRAPE</span>
            <h3 class="style-card-title">Women's Scrubs</h3>
            <p class="style-card-desc">Feminine curved v-neck, princess seams, and high-waisted fluid drape pants.</p>
            <span class="style-link">Explore Women's (From Rs. 5,500) →</span>
          </div>
        </div>

        <!-- Unisex / Executive Card -->
        <div class="style-card card-unisex enamels-3d-card" onclick="window.filterByGender('unisex')">
          <div class="style-card-image">
            <img src="{{ 'demo-crown-burgundy.jpg' | asset_url }}" alt="Unisex Executive Scrubs" loading="lazy" width="600" height="750" />
          </div>
          <div class="style-card-overlay">
            <span class="style-pill" style="background:#4263FF; color:#ffffff;">EXECUTIVE MANDARIN</span>
            <h3 class="style-card-title">Unisex & Executive</h3>
            <p class="style-card-desc">Structured standing collar, concealed magnetic zip placket, and luxury drape.</p>
            <span class="style-link">Explore Executive (From Rs. 6,200) →</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 3. THE COLOUR LAB: INTERACTIVE CHROMATIC PALETTE STUDIO      -->
  <!-- ============================================================ -->
  <section class="chromatic-section colour-lab-section" id="colour-lab">
    <div class="page-width">
      <div class="section-title-wrap text-center">
        <span class="section-accent-tag" style="background: rgba(0, 214, 201, 0.15); color: #00D6C9;">INTERACTIVE COLOUR STUDIO</span>
        <h2 class="section-heading text-white">The Enamels Colour Lab</h2>
        <p class="section-subheading text-slate-300">Every shade is calibrated to official hospital specialty codes. Select a swatch to preview the garment and inspect matching scrubs.</p>
      </div>

      <!-- Color swatches bar -->
      <div class="chromatic-swatches-strip" id="colour-lab-swatches">
        <button type="button" class="chroma-swatch-btn active" data-color="navy" data-hex="#0B1224" data-title="Deep Midnight Navy" data-dept="Emergency, ICU & Critical Care" data-img="{{ 'demo-sprinter-navy.jpg' | asset_url }}">
          <span class="swatch-bubble" style="background-color: #0B1224; border: 2px solid #00D6C9;"></span>
          <span class="swatch-name">Midnight Navy</span>
        </button>

        <button type="button" class="chroma-swatch-btn" data-color="teal" data-hex="#00D6C9" data-title="Electric Teal" data-dept="Operating Theatre & Surgery" data-img="{{ 'demo-velora-teal.jpg' | asset_url }}">
          <span class="swatch-bubble" style="background-color: #00D6C9;"></span>
          <span class="swatch-name">Electric Teal</span>
        </button>

        <button type="button" class="chroma-swatch-btn" data-color="burgundy" data-hex="#581C87" data-title="Burgundy Maroon" data-dept="Cardiology & OB-GYN" data-img="{{ 'demo-crown-burgundy.jpg' | asset_url }}">
          <span class="swatch-bubble" style="background-color: #581C87;"></span>
          <span class="swatch-name">Burgundy</span>
        </button>

        <button type="button" class="chroma-swatch-btn" data-color="royal" data-hex="#1D4ED8" data-title="Vivid Royal Blue" data-dept="Internal Medicine & General Wards" data-img="{{ 'demo-sprinter-navy.jpg' | asset_url }}">
          <span class="swatch-bubble" style="background-color: #1D4ED8;"></span>
          <span class="swatch-name">Royal Blue</span>
        </button>

        <button type="button" class="chroma-swatch-btn" data-color="ceil" data-hex="#6BA4B8" data-title="Clinical Ceil Blue" data-dept="Anaesthesia & Day Surgery" data-img="{{ 'demo-velora-teal.jpg' | asset_url }}">
          <span class="swatch-bubble" style="background-color: #6BA4B8;"></span>
          <span class="swatch-name">Ceil Blue</span>
        </button>

        <button type="button" class="chroma-swatch-btn" data-color="olive" data-hex="#3F4E3B" data-title="Tactical Olive Shine" data-dept="Trauma Services & Paramedics" data-img="{{ 'demo-sprinter-navy.jpg' | asset_url }}">
          <span class="swatch-bubble" style="background-color: #3F4E3B;"></span>
          <span class="swatch-name">Olive Shine</span>
        </button>

        <button type="button" class="chroma-swatch-btn" data-color="lilac" data-hex="#C9B7FF" data-title="Soft Lilac Lavender" data-dept="Pediatrics & Dermatology" data-img="{{ 'demo-velora-teal.jpg' | asset_url }}">
          <span class="swatch-bubble" style="background-color: #C9B7FF;"></span>
          <span class="swatch-name">Soft Lilac</span>
        </button>

        <button type="button" class="chroma-swatch-btn" data-color="coral" data-hex="#FF6B6B" data-title="Warm Blush Coral" data-dept="Dental & Aesthetic Medicine" data-img="{{ 'demo-velora-teal.jpg' | asset_url }}">
          <span class="swatch-bubble" style="background-color: #FF6B6B;"></span>
          <span class="swatch-name">Blush Coral</span>
        </button>
      </div>

      <!-- Live Color Showcase Stage -->
      <div class="colour-stage-display">
        <div class="stage-garment-view">
          <img id="stage-active-img" src="{{ 'demo-sprinter-navy.jpg' | asset_url }}" alt="Featured Chromatic Scrub" width="600" height="750" />
        </div>
        <div class="stage-info-view">
          <span class="stage-dept-tag" id="stage-dept-text">Emergency, ICU & Critical Care</span>
          <h3 class="stage-color-title" id="stage-color-title">Deep Midnight Navy</h3>
          <p class="stage-desc" id="stage-desc">
            Saturated dark clinical navy. Resists hospital stains and maintains razor-sharp contrast under operating room fluorescent lamps. 100% colorfast through hospital autoclave cycles.
          </p>
          <div class="stage-actions">
            <button type="button" class="btn-chromatic-primary" onclick="window.filterCatalogueByColour(window.currentChromaColor)">
              <span>View Available Pieces in this Shade</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 4. SIGNATURE COLLECTIONS: SPRINTER • CROWN • VELORA          -->
  <!-- ============================================================ -->
  <section class="chromatic-section collections-section" id="signature-collections">
    <div class="page-width">
      <div class="section-title-wrap">
        <span class="section-accent-tag">PROPRIETARY TEXTILE SERIES</span>
        <h2 class="section-heading">Signature Scrub Series</h2>
        <p class="section-subheading">Engineered from the molecule up. Three distinct architectural fits built for unique clinical demands.</p>
      </div>

      <div class="series-trio-grid">
        <!-- Sprinter Series -->
        <div class="series-card enamels-3d-card">
          <div class="series-image-wrap">
            <span class="series-badge">ATHLETIC 4-WAY STRETCH</span>
            <img src="{{ 'demo-sprinter-navy.jpg' | asset_url }}" alt="Sprinter Series" loading="lazy" width="600" height="750" />
          </div>
          <div class="series-body">
            <h3 class="series-title">Sprinter Series</h3>
            <p class="series-tagline">Engineered for Rapid Response Shifts</p>
            <ul class="series-features">
              <li>✦ 72% Poly / 21% Rayon / 7% Spandex</li>
              <li>✦ Ergonomic raglan sleeve mobility</li>
              <li>✦ 6-pocket cargo tactical joggers</li>
            </ul>
            <div class="series-card-footer">
              <span class="series-price">From Rs. 5,150</span>
              <button type="button" class="btn-outline-glow" onclick="window.filterBySeries('Sprinter')">Shop Sprinter →</button>
            </div>
          </div>
        </div>

        <!-- Velora Series -->
        <div class="series-card enamels-3d-card">
          <div class="series-image-wrap">
            <span class="series-badge" style="background:#00D6C9; color:#0B1224;">LUXURY MICRO-DRAPE</span>
            <img src="{{ 'demo-velora-teal.jpg' | asset_url }}" alt="Velora Series" loading="lazy" width="600" height="750" />
          </div>
          <div class="series-body">
            <h3 class="series-title">Velora Series</h3>
            <p class="series-tagline">Silky-Soft Touch with Contoured Tailoring</p>
            <ul class="series-features">
              <li>✦ Ultra-soft liquid drape finish</li>
              <li>✦ Feminine curved v-neck & princess seams</li>
              <li>✦ High-waisted tummy-flattering band</li>
            </ul>
            <div class="series-card-footer">
              <span class="series-price">From Rs. 5,500</span>
              <button type="button" class="btn-outline-glow" onclick="window.filterBySeries('Velora')">Shop Velora →</button>
            </div>
          </div>
        </div>

        <!-- Crown Series -->
        <div class="series-card enamels-3d-card">
          <div class="series-image-wrap">
            <span class="series-badge" style="background:#4263FF; color:#ffffff;">EXECUTIVE MANDARIN</span>
            <img src="{{ 'demo-crown-burgundy.jpg' | asset_url }}" alt="Crown Series" loading="lazy" width="600" height="750" />
          </div>
          <div class="series-body">
            <h3 class="series-title">Crown Series</h3>
            <p class="series-tagline">Consultant Elegance with Mandarin Collar</p>
            <ul class="series-features">
              <li>✦ Structured standing collar & pen slot</li>
              <li>✦ Concealed magnetic zip front closure</li>
              <li>✦ Wrinkle-free high-density gabardine</li>
            </ul>
            <div class="series-card-footer">
              <span class="series-price">From Rs. 6,200</span>
              <button type="button" class="btn-outline-glow" onclick="window.filterBySeries('Crown')">Shop Crown →</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 5. INTERACTIVE 35-PRODUCT CATALOGUE GRID & FILTERS           -->
  <!-- ============================================================ -->
  <section class="chromatic-section catalogue-main-section" id="catalogue-section">
    <div class="page-width">
      <div class="section-title-wrap">
        <div class="title-with-counter">
          <div>
            <span class="section-accent-tag">FULL CLINICAL LINEUP</span>
            <h2 class="section-heading">Browse 35 Demo Pieces</h2>
          </div>
          <div class="catalogue-live-counter" id="main-product-counter">35 Products Loaded</div>
        </div>
        <p class="section-subheading">Filter by category, gender, series, hospital color, or price. Click any item to customize with certified chest embroidery.</p>
      </div>

      <!-- Category Filter Tabs -->
      <div class="chroma-tabs-scroller">
        <button type="button" class="chroma-tab-btn active" data-cat="all">All Products (35)</button>
        <button type="button" class="chroma-tab-btn" data-cat="scrub-set">Scrub Sets</button>
        <button type="button" class="chroma-tab-btn" data-cat="scrub-top">Tops</button>
        <button type="button" class="chroma-tab-btn" data-cat="scrub-pants">Pants</button>
        <button type="button" class="chroma-tab-btn" data-cat="caps">Surgical Caps</button>
        <button type="button" class="chroma-tab-btn" data-cat="lab-coat">Lab Coats</button>
        <button type="button" class="chroma-tab-btn" data-cat="accessories">Accessories</button>
        <button type="button" class="chroma-tab-btn" data-cat="bundles">Bundles & Sets</button>
      </div>

      <!-- Filters & Sorting Control Strip -->
      <div class="chroma-controls-strip">
        <div class="controls-left">
          <select id="chroma-filter-gender" class="chroma-select">
            <option value="all">All Genders</option>
            <option value="men">Men's Apparel</option>
            <option value="women">Women's Apparel</option>
            <option value="unisex">Unisex Cuts</option>
          </select>

          <select id="chroma-filter-series" class="chroma-select">
            <option value="all">All Series</option>
            <option value="Sprinter">Sprinter Series</option>
            <option value="Velora">Velora Series</option>
            <option value="Crown">Crown Series</option>
            <option value="BunFit">BunFit™ Caps</option>
            <option value="Helium">Helium Lab Coats</option>
          </select>

          <select id="chroma-filter-price" class="chroma-select">
            <option value="all">All Prices</option>
            <option value="under-3000">Under Rs. 3,000</option>
            <option value="3000-6000">Rs. 3,000 – 6,000</option>
            <option value="above-6000">Above Rs. 6,000</option>
          </select>
        </div>

        <div class="controls-right">
          <label for="chroma-sort" class="sort-tag">Sort:</label>
          <select id="chroma-sort" class="chroma-select">
            <option value="featured">Featured & Best Sellers</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
            <option value="name">Name (A-Z)</option>
          </select>
        </div>
      </div>

      <!-- Dynamic Product Cards Grid -->
      <div class="chroma-products-grid" id="chroma-grid">
        <!-- Rendered dynamically by JavaScript -->
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 6. BUILT FOR EVERY SHIFT: TECHNICAL PERFORMANCE PANELS       -->
  <!-- ============================================================ -->
  <section class="chromatic-section tech-story-section" id="tech-story">
    <div class="page-width">
      <div class="section-title-wrap text-center">
        <span class="section-accent-tag">CLINICAL TEXTILE SCIENCE</span>
        <h2 class="section-heading text-white">Built for Every Shift</h2>
        <p class="section-subheading text-slate-300">Verified textile engineering developed for the demanding realities of Pakistani hospitals.</p>
      </div>

      <div class="tech-quad-grid">
        <div class="tech-card">
          <div class="tech-card-icon">⚡</div>
          <h3 class="tech-card-title">4-Way Mechanical Stretch</h3>
          <p class="tech-card-desc">7% Spandex core woven into high-tenacity microfibers allows unrestricted squatting, reaching, and patient lifting without seam strain.</p>
        </div>

        <div class="tech-card">
          <div class="tech-card-icon">🛡️</div>
          <h3 class="tech-card-title">Fluid-Repellent Barrier</h3>
          <p class="tech-card-desc">Hydrophobic nanotechnology finish causes biological fluids, saline, and water to bead and roll off without soaking the fabric.</p>
        </div>

        <div class="tech-card">
          <div class="tech-card-icon">🩻</div>
          <h3 class="tech-card-title">6 Ergonomic Storage Pockets</h3>
          <p class="tech-card-desc">Deep cargo pockets fit a mini-tablet, dedicated pen welts keep needles secure, and hidden inner zipper secures your smartphone.</p>
        </div>

        <div class="tech-card">
          <div class="tech-card-icon">🧼</div>
          <h3 class="tech-card-title">100+ Autoclave Wash Durability</h3>
          <p class="tech-card-desc">Reinforced triple-needle flatlock seams and vat-dyed colour pigments maintain vibrancy and fit through over 100 commercial high-temp washes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 7. MAKE IT YOURS: INTERACTIVE PRODUCT STUDIO                 -->
  <!-- ============================================================ -->
  <section class="chromatic-section customizer-studio-section" id="interactive-studio">
    <div class="page-width">
      <div class="section-title-wrap">
        <span class="section-accent-tag" style="background:#00D6C9; color:#0B1224;">3D PRODUCT CONFIGURATOR</span>
        <h2 class="section-heading">Make It Yours: Studio Customizer</h2>
        <p class="section-subheading">Personalize your scrubs with computerized doctor name embroidery, department titles, or institutional crest patches.</p>
      </div>

      <div class="studio-split-layout">
        <!-- Left: Live Visual Pocket Canvas Simulator -->
        <div class="studio-canvas-stage">
          <div class="pocket-fabric-preview" id="studio-pocket-bg">
            <div class="pocket-stitch-border">
              <div class="pocket-monogram-badge">ENAMELS CLINICAL</div>
              <div class="pocket-embroidery-render">
                <div class="emb-render-line1" id="studio-emb-preview1">Dr. Sarah Khan</div>
                <div class="emb-render-line2" id="studio-emb-preview2">Cardiology & ICU</div>
              </div>
            </div>
          </div>
          <div class="pocket-canvas-caption">
            <span>✨ Live Computerized Chest Pocket Simulation</span>
          </div>
        </div>

        <!-- Right: Studio Controls Panel -->
        <div class="studio-controls-panel">
          <h3 class="studio-panel-title">Custom Uniform Configuration</h3>

          <!-- Step 1: Base Scrub -->
          <div class="studio-step-box">
            <label class="studio-label">1. Select Scrub Garment:</label>
            <select id="studio-garment-select" class="chroma-select full-width">
              <option value="demo-sprinter-mens-navy" data-price="5150">Sprinter Men's Scrub Set (Rs. 5,150)</option>
              <option value="demo-velora-womens-teal" data-price="5500">Velora Women's Tailored Scrub Set (Rs. 5,500)</option>
              <option value="demo-crown-unisex-burgundy" data-price="6200">Crown Unisex Executive Scrub Set (Rs. 6,200)</option>
              <option value="demo-helium-womens-fitted-lab-coat" data-price="2950">Helium Series Women's Lab Coat (Rs. 2,950)</option>
            </select>
          </div>

          <!-- Step 2: Sizing -->
          <div class="studio-step-box">
            <div class="label-with-guide">
              <label class="studio-label">2. Select Size:</label>
              <button type="button" class="btn-text-guide" onclick="document.getElementById('size-chart-modal').style.display='flex'">📏 Size Guide</button>
            </div>
            <div class="studio-size-pills" id="studio-size-group">
              <button type="button" class="studio-size-btn" data-size="XS">XS</button>
              <button type="button" class="studio-size-btn" data-size="S">S</button>
