    window.renderAdminBookingList = function() {
      const tbody = document.getElementById('ss-admin-bookings-tbody');
      const countEl = document.getElementById('ss-admin-bookings-count');
      const searchInput = document.getElementById('ss-admin-search-input')?.value.toLowerCase().trim() || '';
      const statusFilter = document.getElementById('ss-admin-status-filter')?.value || 'all';

      if (!tbody) return;

      const bookings = getStoredBookings();
      const filtered = bookings.filter(b => {
        if (statusFilter !== 'all' && b.status !== statusFilter) return false;
        if (!searchInput) return true;
        const searchStr = `${b.id} ${b.fullName} ${b.phone} ${b.whatsapp} ${b.area} ${b.city} ${b.shopifyOrderId || ''}`.toLowerCase();
        return searchStr.includes(searchInput);
      });

      if (countEl) countEl.textContent = `${filtered.length} Requests`;

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; padding: 24px; color: #64748b;">No matching representative visit requests found.</td></tr>`;
        return;
      }

      const getStatusClass = (status) => {
        switch (status) {
          case 'New Request': return 'status-new';
          case 'Under Review': return 'status-review';
          case 'Contact Required': return 'status-contact';
          case 'Visit Proposed': return 'status-proposed';
          case 'Confirmed': return 'status-confirmed';
          case 'Representative Assigned': return 'status-assigned';
          case 'Visit Completed': return 'status-completed';
          case 'Order Created': return 'status-order-created';
          case 'Cancelled': return 'status-cancelled';
          default: return 'status-review';
        }
      };

      tbody.innerHTML = filtered.map(b => {
        const formattedDate = new Date(b.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        const repName = b.assignedRep ? escapeHtml(b.assignedRep.split(' ')[0] + ' ' + (b.assignedRep.split(' ')[1] || '')) : '<em style="color:#94a3b8;">Unassigned</em>';
        const needsSummary = (b.selectedNeeds || []).slice(0, 2).map(n => `<span style="font-size:10px; background:#f1f5f9; padding:1px 6px; border-radius:3px; margin-right:3px;">${escapeHtml(n)}</span>`).join('');
        const extraNeeds = (b.selectedNeeds || []).length > 2 ? `<span style="font-size:10px; color:#64748b;">+${(b.selectedNeeds || []).length - 2}</span>` : '';

        return `
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="font-weight: 700; color: #102a43; font-family: monospace;">
              <a href="#" onclick="window.openAdminBookingDetail('${b.id}'); return false;" style="color: #008779; text-decoration: underline;">
                ${escapeHtml(b.id)}
              </a>
            </td>
            <td style="color: #64748b; white-space: nowrap;">${formattedDate}</td>
            <td>
              <strong style="color: #102a43;">${escapeHtml(b.fullName)}</strong><br>
              <span style="color: #64748b; font-size: 11px;">${escapeHtml(b.phone)}</span>
            </td>
            <td>
              <span style="font-weight: 600; color: #102a43;">${escapeHtml(b.city)}</span><br>
              <span style="color: #64748b; font-size: 11px;">${escapeHtml(b.area || '-')}</span>
            </td>
            <td>${needsSummary}${extraNeeds}</td>
            <td>
              <span class="self-service-status-pill ${getStatusClass(b.status)}">
                ${escapeHtml(b.status)}
              </span>
            </td>
            <td>${repName}</td>
            <td style="text-align: right;">
              <button type="button" class="gender-pill-btn" onclick="window.openAdminBookingDetail('${b.id}')" style="padding: 4px 10px; font-size: 11px;">
                Manage
              </button>
            </td>
          </tr>
        `;
      }).join('');
    };

    window.openAdminBookingDetail = function(bookingId) {
      const bookings = getStoredBookings();
      const booking = bookings.find(b => b.id === bookingId);
      if (!booking) return;

      currentAdminDetailBookingId = bookingId;
      const pane = document.getElementById('ss-admin-detail-pane');
      if (!pane) return;
      pane.style.display = 'block';

      const titleEl = document.getElementById('ss-admin-detail-title');
      const custEl = document.getElementById('ss-admin-detail-customer');
      const addrEl = document.getElementById('ss-admin-detail-address');
      const needsEl = document.getElementById('ss-admin-detail-needs');
      const feeEl = document.getElementById('ss-admin-detail-fee');
      const statusSelect = document.getElementById('ss-admin-detail-status-select');
      const repSelect = document.getElementById('ss-admin-detail-rep-select');
      const orderIdInput = document.getElementById('ss-admin-detail-order-id');

      if (titleEl) titleEl.textContent = `Request Detail: ${booking.id} (${booking.status})`;
      if (custEl) custEl.innerHTML = `<strong>${escapeHtml(booking.fullName)}</strong><br>Phone: ${escapeHtml(booking.phone)} | WA: ${escapeHtml(booking.whatsapp)}<br>Email: ${escapeHtml(booking.email || 'None')}<br>Preferred Channel: ${escapeHtml(booking.contactMethod)}`;
      if (addrEl) addrEl.innerHTML = `<strong>${escapeHtml(booking.city)}</strong> — ${escapeHtml(booking.area)}<br>${escapeHtml(booking.street)}<br>Facility: ${escapeHtml(booking.building || 'N/A')}<br>Note: ${escapeHtml(booking.landmark || 'N/A')}`;
      if (needsEl) needsEl.innerHTML = `Items: <strong>${(booking.selectedNeeds || []).map(n => escapeHtml(n)).join(', ')}</strong><br>Preferred Series: ${escapeHtml(booking.preferredSeries)} | Qty: ${escapeHtml(booking.estimatedQty)}<br>Preferred Date: <strong>${escapeHtml(booking.preferredDate)} (${escapeHtml(booking.preferredTimeWindow)})</strong><br>Customer Note: <em>${escapeHtml(booking.specialNotes || 'None')}</em>`;
      if (feeEl) feeEl.innerHTML = `Service Fee: <strong>Rs. ${booking.serviceFee}</strong> (Adjustable &gt; Rs. ${booking.feeAdjustableThreshold})<br>Payment: Payable during visit or Bank Transfer<br>Shopify Order: <strong>${booking.shopifyOrderId ? escapeHtml(booking.shopifyOrderId) : '<span style="color:#64748b;">Not yet linked</span>'}</strong>`;

      if (statusSelect) statusSelect.value = booking.status || 'New Request';
      if (repSelect) repSelect.value = booking.assignedRep || '';
      if (orderIdInput) orderIdInput.value = booking.shopifyOrderId || '';

      renderAdminDetailLogs(booking);
      pane.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    function renderAdminDetailLogs(booking) {
      const historyLog = document.getElementById('ss-admin-notes-history-log');
      if (!historyLog) return;

      const notesHtml = (booking.adminNotes || []).map(n => `
        <div style="margin-bottom: 4px; padding-bottom: 4px; border-bottom: 1px dashed #e2e8f0;">
          <strong style="color: #102a43;">[Note - ${new Date(n.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}]</strong>
          <span>${escapeHtml(n.note)}</span>
          <span style="color: #64748b; font-size: 10px;">(${escapeHtml(n.author)})</span>
        </div>
      `).join('');

      const historyHtml = (booking.statusHistory || []).map(h => `
        <div style="margin-bottom: 3px; color: #475569;">
          <span style="color: #0369a1; font-weight: 600;">[Lifecycle: ${escapeHtml(h.toStatus)}]</span>
          <span>${escapeHtml(h.note)}</span>
          <span style="color: #94a3b8; font-size: 10px;">— ${new Date(h.timestamp).toLocaleDateString()} (${escapeHtml(h.updatedBy)})</span>
        </div>
      `).join('');

      historyLog.innerHTML = notesHtml + historyHtml || '<em>No notes or history recorded yet.</em>';
    }

    window.addAdminBookingNote = function() {
      if (!currentAdminDetailBookingId) return;
      const noteInput = document.getElementById('ss-admin-new-note');
      const text = noteInput?.value.trim();
      if (!text) return;

      const bookings = getStoredBookings();
      const booking = bookings.find(b => b.id === currentAdminDetailBookingId);
      if (!booking) return;

      if (!booking.adminNotes) booking.adminNotes = [];
      booking.adminNotes.unshift({
        timestamp: new Date().toISOString(),
        note: text,
        author: 'Concierge Staff'
      });
      booking.updatedAt = new Date().toISOString();

      saveStoredBookings(bookings);
      if (noteInput) noteInput.value = '';
      renderAdminDetailLogs(booking);
    };

    window.saveAdminBookingChanges = function() {
      if (!currentAdminDetailBookingId) return;
      const statusSelect = document.getElementById('ss-admin-detail-status-select');
      const repSelect = document.getElementById('ss-admin-detail-rep-select');
      const orderIdInput = document.getElementById('ss-admin-detail-order-id');

      const newStatus = statusSelect?.value || 'New Request';
      const newRep = repSelect?.value || '';
      const newOrderId = orderIdInput?.value.trim() || '';

      const bookings = getStoredBookings();
      const booking = bookings.find(b => b.id === currentAdminDetailBookingId);
      if (!booking) return;

      const nowIso = new Date().toISOString();
      if (booking.status !== newStatus) {
        if (!booking.statusHistory) booking.statusHistory = [];
        booking.statusHistory.unshift({
          timestamp: nowIso,
          fromStatus: booking.status,
          toStatus: newStatus,
          note: `Status changed from ${booking.status} to ${newStatus}`,
          updatedBy: 'Admin Representative'
        });
        booking.status = newStatus;
      }

      booking.assignedRep = newRep;
      booking.shopifyOrderId = newOrderId;
      booking.updatedAt = nowIso;

      saveStoredBookings(bookings);
      window.renderAdminBookingList();
      window.openAdminBookingDetail(currentAdminDetailBookingId);
      alert(`Booking ${currentAdminDetailBookingId} updated successfully.`);
    };

    window.createOrderFromBooking = function() {
      if (!currentAdminDetailBookingId) return;
      const bookings = getStoredBookings();
      const booking = bookings.find(b => b.id === currentAdminDetailBookingId);
      if (!booking) return;

      // Close modal and open Product Studio
      window.closeSelfServiceAdminModal();
      window.openProductStudio('sprinter-athletic-set');

      alert(`Product Studio opened for ${booking.fullName}.\n\nRequirements:\n- Preferred Series: ${booking.preferredSeries}\n- Needs: ${(booking.selectedNeeds || []).join(', ')}\n- Notes: ${booking.specialNotes || 'Standard'}\n\nRepresentative may now choose colours, confirm sizes, alterations and add to cart.`);
    };

  })();
</script>

