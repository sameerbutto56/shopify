    window.jumpRtwStep = function(stepNum) {
      STATE.rtwStep = stepNum;
      document.querySelectorAll('.rtw-step-pane').forEach((pane, idx) => {
        const isCurrent = (idx + 1) === stepNum;
        pane.classList.toggle('active', isCurrent);
        pane.style.display = isCurrent ? 'block' : 'none';
      });
      document.querySelectorAll('.rtw-nav-step').forEach((nav, idx) => {
        const cur = idx + 1;
        nav.classList.toggle('active', cur === stepNum);
        nav.classList.toggle('completed', cur < stepNum);
      });

      if (stepNum === 2) {
        renderRtwColorsForFabric(STATE.rtwFabric?.id || 'sprinter-twill');
      } else if (stepNum === 4) {
        renderRtwDesignsForArticle(STATE.rtwArticle?.id || 'Sprinter');
      } else if (stepNum === 7) {
        renderRtwReview();
      }
      window.scrollTo({ top: 120, behavior: 'smooth' });
    };

