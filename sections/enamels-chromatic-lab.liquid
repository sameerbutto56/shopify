      const phone = document.getElementById('ss-input-phone')?.value.trim() || '';
      const wa = document.getElementById('ss-input-whatsapp')?.value.trim() || phone;
      const email = document.getElementById('ss-input-email')?.value.trim() || '';
      const contactMethod = document.querySelector('input[name="ss_contact_method"]:checked')?.value || 'WhatsApp';
      const visitWindow = document.getElementById('ss-input-visit-window')?.value || 'Flexible';
      const preferredDate = document.getElementById('ss-input-preferred-date')?.value || '';
      const landmark = document.getElementById('ss-input-landmark')?.value.trim() || '';
      const notes = document.getElementById('ss-input-notes')?.value.trim() || '';

      const selectedAddr = window.EnamelsApprovedLahoreAddresses.find(a => a.id === hsSelectedAddressId) || window.EnamelsApprovedLahoreAddresses[0];
      const addressSnapshot = {
        id: selectedAddr.id,
        area: selectedAddr.area,
        zoneTag: selectedAddr.zoneTag,
        fullAddress: selectedAddr.fullAddress,
        landmark: landmark
      };

      const paymentMethodRadio = document.querySelector('input[name="ss_payment_method"]:checked')?.value || 'shopify_checkout';
      const trxRef = document.getElementById('ss-input-trx-ref')?.value.trim() || '';

      if (paymentMethodRadio === 'bank_transfer' && !trxRef) {
        alert('Please enter your Bank / JazzCash transaction reference or deposit slip ID.');
        return;
      }

      const submitBtn = document.getElementById('ss-submit-booking-btn');
      if (submitBtn) {
        if (submitBtn.disabled) return; // Prevent duplicate clicks
        submitBtn.disabled = true;
        submitBtn.innerHTML = '⏳ Submitting Request...';
      }

      const bookingId = 'HS-ENM-2026-' + Math.floor(1000 + Math.random() * 9000);
      const nowIso = new Date().toISOString();
      const isShopify = paymentMethodRadio === 'shopify_checkout';

      const newBooking = {
        id: bookingId,
        orderType: 'HOME SERVICE',
        createdAt: nowIso,
        updatedAt: nowIso,
        fullName: name,
        phone: phone,
        whatsapp: wa,
        email: email,
        contactMethod: contactMethod,
        preferredVisitWindow: visitWindow,
        preferredDate: preferredDate,
        customerNotes: notes,
        addressSnapshot: addressSnapshot,
        advanceRequired: REQUIRED_HOME_SERVICE_ADVANCE,
        advancePaymentStatus: isShopify ? 'Awaiting Advance Payment Verification' : 'Awaiting Advance Payment',
        verifiedAmountReceived: 0,
        paymentMethod: isShopify ? 'Shopify Checkout (PKR 3,000 Booking Deposit)' : 'Bank Transfer / JazzCash',
        trxRef: isShopify ? ('DEP-' + Math.floor(100000 + Math.random() * 900000)) : trxRef,
        representativeName: 'Unassigned',
        visitTime: 'Pending Customer Care Scheduling',
        agreedRequirements: 'To be collected during visit',
        confirmedOrderTotal: null,
        linkedShopifyOrderId: '',
        remainingBalance: null,
        lifecycleStatus: isShopify ? 'Awaiting Customer Care' : 'Awaiting Advance Payment',
        adminNotes: [
          {
            timestamp: nowIso,
            note: isShopify
              ? 'Home Service request submitted via Shopify Checkout deposit. Awaiting Customer Care visit coordination.'
              : `Home Service request submitted via manual bank transfer. Transaction Ref: ${trxRef}. Awaiting verification.`,
            author: 'System (Online Request)'
          }
        ],
        statusHistory: [
          {
            timestamp: nowIso,
            fromStatus: 'None',
            toStatus: isShopify ? 'Awaiting Customer Care' : 'Awaiting Advance Payment',
            note: 'Home Service consultation request submitted online (No products selected online)',
            updatedBy: 'Customer (Online)'
          }
        ]
      };

      const existing = getStoredBookings();
      existing.unshift(newBooking);
      saveStoredBookings(existing);

      // If Shopify Checkout mode, record the deposit line-item in cart safely
      if (isShopify && typeof fetch === 'function') {
        const lineProps = {
          '_order_type': 'Home Service',
          'Booking Reference': bookingId,
          'Customer Name': name,
          'Customer Phone': phone,
          'Customer WhatsApp': wa,
          'Approved Lahore Address': addressSnapshot.fullAddress,
          'Deposit Amount': `PKR ${REQUIRED_HOME_SERVICE_ADVANCE.toLocaleString()} (Adjustable against final order)`,
          'Minimum Qualifying Order': `PKR ${MINIMUM_HOME_SERVICE_ORDER_VALUE.toLocaleString()}`
        };

        const serviceVariantId = window.ShopifyLiveProducts?.[0]?.variants?.[0]?.id || null;
        if (serviceVariantId) {
          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              items: [{
                id: serviceVariantId,
                quantity: 1,
                properties: lineProps
              }]
            })
          }).catch(() => {});
        }
      }

      // Display Success Confirmation View (Step 4)
      const bookingCard = document.getElementById('self-service-booking-card');
      const successView = document.getElementById('self-service-success-view');
      if (bookingCard) bookingCard.style.display = 'none';
      if (successView) successView.style.display = 'block';

      const refEl = document.getElementById('ss-success-ref-id');
      const nameEl = document.getElementById('ss-success-name');
      const contactEl = document.getElementById('ss-success-contact');
      const locEl = document.getElementById('ss-success-location');
      const visitEl = document.getElementById('ss-success-visit-window');
      const payStatusEl = document.getElementById('ss-success-payment-status');
      const totalEl = document.getElementById('ss-success-total');
      const advEl = document.getElementById('ss-success-advance');
      const balEl = document.getElementById('ss-success-balance');
      const waLink = document.getElementById('ss-whatsapp-direct-link');

      if (refEl) refEl.textContent = bookingId;
      if (nameEl) nameEl.textContent = name;
      if (contactEl) contactEl.textContent = `${phone} (Preferred: ${contactMethod})`;
      if (locEl) locEl.textContent = `${addressSnapshot.area} — ${addressSnapshot.fullAddress}`;
      if (visitEl) visitEl.textContent = `${visitWindow}${preferredDate ? ' on ' + preferredDate : ''}`;
      if (payStatusEl) {
        payStatusEl.textContent = isShopify ? 'Pending Payment Verification (Shopify Checkout)' : 'Awaiting Advance Payment Verification (Bank Deposit Slip)';
        payStatusEl.style.color = '#92400e';
      }
      if (totalEl) totalEl.textContent = 'To be determined during representative consultation';
      if (advEl) advEl.textContent = `PKR ${REQUIRED_HOME_SERVICE_ADVANCE.toLocaleString()} (Adjustable Booking Deposit)`;
      if (balEl) balEl.textContent = 'Calculated upon final order creation';

      if (waLink) {
        const waMsg = encodeURIComponent(`Hello Enamels Customer Care! I have requested Home Service in Lahore.\nBooking Reference: ${bookingId}\nName: ${name}\nLocation: ${addressSnapshot.area}\nDeposit: PKR 3,000 (Adjustable against PKR 25,000 min order)`);
        waLink.href = `https://wa.me/923011331133?text=${waMsg}`;
      }

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '🔒 Request Home Service & Submit Booking';
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    window.resetSelfServiceForm = function() {
      hsSelectedAddressId = 'lhr-shadman';

      const formIds = ['ss-input-name', 'ss-input-phone', 'ss-input-whatsapp', 'ss-input-email', 'ss-input-preferred-date', 'ss-input-landmark', 'ss-input-notes', 'ss-input-trx-ref'];
      formIds.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = '';
      });

      const sameWa = document.getElementById('ss-same-whatsapp');
      if (sameWa) sameWa.checked = false;

      const windowSelect = document.getElementById('ss-input-visit-window');
      if (windowSelect) windowSelect.selectedIndex = 0;

      const bookingCard = document.getElementById('self-service-booking-card');
      const successView = document.getElementById('self-service-success-view');
      if (bookingCard) bookingCard.style.display = 'block';
      if (successView) successView.style.display = 'none';

      window.initHomeServicePortal();
      window.goToSelfServiceStep(1);
    };

    // ------------------------------------------------------------
    // ADMIN HOME SERVICE ORDER MANAGEMENT WORKFLOW
    // ------------------------------------------------------------
    window.openSelfServiceAdminModal = function() {
      const modal = document.getElementById('self-service-admin-modal');
      if (modal) {
        modal.classList.add('active');
        modal.style.display = 'flex';
        window.renderAdminBookingList();
      }
    };
    window.openAdminSelfServiceModal = window.openSelfServiceAdminModal;

    window.closeSelfServiceAdminModal = function() {
      const modal = document.getElementById('self-service-admin-modal');
      if (modal) {
        modal.classList.remove('active');
        modal.style.display = 'none';
      }
    };

    window.renderAdminBookingList = function() {
      const tbody = document.getElementById('ss-admin-table-body');
      const countEl = document.getElementById('ss-admin-bookings-count');
      const searchInput = document.getElementById('ss-admin-search-input')?.value.toLowerCase().trim() || '';
      const statusFilter = document.getElementById('ss-admin-status-filter')?.value || 'ALL';

      if (!tbody) return;

      const bookings = getStoredBookings();
      const filtered = bookings.filter(b => {
        if (statusFilter !== 'ALL' && b.lifecycleStatus !== statusFilter && b.advancePaymentStatus !== statusFilter) return false;
        if (!searchInput) return true;
        const searchStr = `${b.id} ${b.fullName} ${b.phone} ${b.whatsapp} ${b.addressSnapshot?.area || ''} ${b.addressSnapshot?.fullAddress || ''} ${b.representativeName || ''} ${b.linkedShopifyOrderId || ''}`.toLowerCase();
        return searchStr.includes(searchInput);
      });

      if (countEl) countEl.textContent = `${filtered.length} Home Service Orders`;

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="9" style="text-align: center; padding: 24px; color: #64748b;">No matching Home Service bookings found.</td></tr>`;
        return;
      }

      tbody.innerHTML = filtered.map(b => {
        const formattedDate = new Date(b.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        const isPaid = b.advancePaymentStatus === 'Advance Paid';
        const advStatusBadge = isPaid
          ? `<span style="font-size:10px; font-weight:700; background:#dcfce7; color:#166534; padding:2px 8px; border-radius:4px;">PAID (PKR 3k)</span>`
          : `<span style="font-size:10px; font-weight:700; background:#fef3c7; color:#92400e; padding:2px 8px; border-radius:4px;">AWAITING ADV</span>`;

        const totalDisplay = b.confirmedOrderTotal ? `PKR ${b.confirmedOrderTotal.toLocaleString()}` : `<span style="color:#64748b; font-style:italic;">Pending Visit</span>`;
        const dueDisplay = b.remainingBalance !== null && b.remainingBalance !== undefined ? `PKR ${b.remainingBalance.toLocaleString()}` : `<span style="color:#64748b; font-style:italic;">Pending Order</span>`;

        return `
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="font-weight: 700; color: #102a43; font-family: monospace;">
              <a href="#" onclick="window.openAdminBookingDetail('${b.id}'); return false;" style="color: #008779; text-decoration: underline;">
                ${escapeHtml(b.id)}
              </a>
              <div style="font-size: 10px; color: #64748b; font-family: sans-serif;">${formattedDate}</div>
            </td>
            <td>
              <strong style="color: #102a43;">${escapeHtml(b.fullName)}</strong><br>
              <span style="color: #64748b; font-size: 11px;">${escapeHtml(b.phone)}</span>
            </td>
            <td>
              <span style="font-weight: 600; color: #102a43;">${escapeHtml(b.addressSnapshot?.area || '-')}</span><br>
              <span style="color: #64748b; font-size: 10px;">${escapeHtml(b.addressSnapshot?.zoneTag || '')}</span>
            </td>
            <td>
              <span style="font-size: 11px; color: #102a43;">${escapeHtml(b.preferredVisitWindow || 'Flexible')}</span>
            </td>
            <td style="text-align: right;">
              ${advStatusBadge}
            </td>
            <td style="text-align: right; font-weight: 700; color: #102a43;">
              ${totalDisplay}
            </td>
            <td style="text-align: right; font-weight: 700; color: #008779;">
              ${dueDisplay}
            </td>
            <td>
              <span style="font-size: 10px; font-weight: 700; background: #e0f2fe; color: #0369a1; padding: 2px 6px; border-radius: 4px;">
                ${escapeHtml(b.lifecycleStatus || 'New Request')}
              </span>
            </td>
            <td style="text-align: right;">
              <button type="button" class="gender-pill-btn" onclick="window.openAdminBookingDetail('${b.id}')" style="padding: 4px 10px; font-size: 11px; font-weight: 700;">
                Manage
              </button>
            </td>
          </tr>
        `;
      }).join('');
    };

    window.openAdminBookingDetail = function(bookingId) {
      const bookings = getStoredBookings();
      const booking = bookings.find(b => b.id === bookingId);
      if (!booking) return;

      currentAdminDetailBookingId = bookingId;
      const pane = document.getElementById('ss-admin-detail-pane');
      if (!pane) return;
      pane.style.display = 'block';

      const titleEl = document.getElementById('ss-admin-detail-title');
      const custEl = document.getElementById('ss-admin-detail-customer');
      const addrEl = document.getElementById('ss-admin-detail-address');
      const notesEl = document.getElementById('ss-admin-detail-notes');
      const accEl = document.getElementById('ss-admin-detail-accounting');

      const repInput = document.getElementById('ss-admin-rep-name');
      const visitInput = document.getElementById('ss-admin-visit-time');
      const reqsInput = document.getElementById('ss-admin-agreed-reqs');
      const confirmedTotalInput = document.getElementById('ss-admin-detail-confirmed-total');
      const linkedOrderInput = document.getElementById('ss-admin-linked-order');

      const statusSelect = document.getElementById('ss-admin-detail-status-select');
      const advStatusSelect = document.getElementById('ss-admin-detail-adv-status-select');

      if (titleEl) titleEl.textContent = `Home Service Order: ${booking.id} (${booking.lifecycleStatus})`;
      if (custEl) custEl.innerHTML = `<strong>${escapeHtml(booking.fullName)}</strong><br>Phone: ${escapeHtml(booking.phone)} | WhatsApp: ${escapeHtml(booking.whatsapp)}<br>Email: ${escapeHtml(booking.email || 'None')}<br>Preferred Channel: <strong>${escapeHtml(booking.contactMethod)}</strong>`;
      
      const addr = booking.addressSnapshot || {};
      if (addrEl) addrEl.innerHTML = `<strong>${escapeHtml(addr.area || 'Lahore')}</strong> (${escapeHtml(addr.zoneTag || '')})<br>${escapeHtml(addr.fullAddress || '')}<br><span style="color:#64748b; font-size:11px;">Landmark: ${escapeHtml(addr.landmark || 'None')}</span>`;
      
      if (notesEl) notesEl.innerHTML = `Preferred Window: <strong>${escapeHtml(booking.preferredVisitWindow || 'Flexible')}</strong><br>${booking.preferredDate ? 'Specific Date: <strong>' + escapeHtml(booking.preferredDate) + '</strong><br>' : ''}Customer Notes: <em>${escapeHtml(booking.customerNotes || 'None')}</em>`;

      const totalVal = booking.confirmedOrderTotal;
      const verifiedVal = booking.verifiedAmountReceived || (booking.advancePaymentStatus === 'Advance Paid' ? 3000 : 0);
      const remainingVal = totalVal ? Math.max(0, totalVal - verifiedVal) : null;

      if (accEl) {
        if (totalVal) {
          accEl.innerHTML = `
            Confirmed Order Total: <strong>PKR ${totalVal.toLocaleString()}</strong><br>
            Advance Status: <strong>${escapeHtml(booking.advancePaymentStatus)}</strong> (Verified: PKR ${verifiedVal.toLocaleString()})<br>
            <span style="color:#008779; font-weight:700;">Remaining Balance Due: PKR ${remainingVal.toLocaleString()}</span><br>
            <span style="font-size:10px; color:#64748b;">Formula: Confirmed Total (${totalVal.toLocaleString()}) − Verified Deposit (${verifiedVal.toLocaleString()})</span>
          `;
        } else {
          accEl.innerHTML = `
            Confirmed Order Total: <span style="color:#64748b; font-style:italic;">Pending In-Person Visit (Min. PKR 25,000)</span><br>
            Advance Status: <strong>${escapeHtml(booking.advancePaymentStatus)}</strong> (Verified: PKR ${verifiedVal.toLocaleString()})<br>
            <span style="color:#008779; font-weight:700;">Remaining Balance: Calculated upon final order creation</span><br>
            <span style="font-size:10px; color:#64748b;">The PKR 3,000 advance will be credited toward the final order total.</span>
          `;
        }
      }

      if (repInput) repInput.value = booking.representativeName || '';
      if (visitInput) visitInput.value = booking.visitTime || '';
      if (reqsInput) reqsInput.value = booking.agreedRequirements || '';
      if (confirmedTotalInput) confirmedTotalInput.value = booking.confirmedOrderTotal || '';
      if (linkedOrderInput) linkedOrderInput.value = booking.linkedShopifyOrderId || '';

      if (statusSelect) statusSelect.value = booking.lifecycleStatus || 'New Request';
      if (advStatusSelect) advStatusSelect.value = booking.advancePaymentStatus || 'Awaiting Advance Payment';

      renderAdminDetailLogs(booking);
      pane.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    window.handleAdminAdvStatusChange = function(newStatus) {
      if (!currentAdminDetailBookingId) return;
      const confirmedTotalInput = document.getElementById('ss-admin-detail-confirmed-total');
      const total = Number(confirmedTotalInput?.value) || 0;
      const verified = newStatus === 'Advance Paid' ? 3000 : 0;
      const accEl = document.getElementById('ss-admin-detail-accounting');

      if (accEl) {
        if (total > 0) {
          const remaining = Math.max(0, total - verified);
          accEl.innerHTML = `
            Confirmed Order Total: <strong>PKR ${total.toLocaleString()}</strong><br>
            Advance Status: <strong>${escapeHtml(newStatus)}</strong> (Verified: PKR ${verified.toLocaleString()})<br>
            <span style="color:#008779; font-weight:700;">Remaining Balance Due: PKR ${remaining.toLocaleString()}</span><br>
            <span style="font-size:10px; color:#64748b;">Formula: Confirmed Total (${total.toLocaleString()}) − Verified Deposit (${verified.toLocaleString()})</span>
          `;
        } else {
          accEl.innerHTML = `
            Confirmed Order Total: <span style="color:#64748b; font-style:italic;">Pending In-Person Visit (Min. PKR 25,000)</span><br>
            Advance Status: <strong>${escapeHtml(newStatus)}</strong> (Verified: PKR ${verified.toLocaleString()})<br>
            <span style="color:#008779; font-weight:700;">Remaining Balance: Calculated upon final order creation</span>
          `;
        }
      }
    };

    window.handleAdminTotalChange = function(newTotalStr) {
      if (!currentAdminDetailBookingId) return;
      const advStatusSelect = document.getElementById('ss-admin-detail-adv-status-select');
      const total = Number(newTotalStr) || 0;
      const verified = advStatusSelect?.value === 'Advance Paid' ? 3000 : 0;
      const accEl = document.getElementById('ss-admin-detail-accounting');

      if (accEl) {
        if (total > 0) {
          const remaining = Math.max(0, total - verified);
          accEl.innerHTML = `
            Confirmed Order Total: <strong>PKR ${total.toLocaleString()}</strong><br>
            Advance Status: <strong>${escapeHtml(advStatusSelect?.value || 'Awaiting Advance Payment')}</strong> (Verified: PKR ${verified.toLocaleString()})<br>
            <span style="color:#008779; font-weight:700;">Remaining Balance Due: PKR ${remaining.toLocaleString()}</span><br>
            <span style="font-size:10px; color:#64748b;">Formula: Confirmed Total (${total.toLocaleString()}) − Verified Deposit (${verified.toLocaleString()})</span>
          `;
        } else {
          accEl.innerHTML = `
            Confirmed Order Total: <span style="color:#64748b; font-style:italic;">Pending In-Person Visit (Min. PKR 25,000)</span><br>
            Advance Status: <strong>${escapeHtml(advStatusSelect?.value || 'Awaiting Advance Payment')}</strong> (Verified: PKR ${verified.toLocaleString()})<br>
            <span style="color:#008779; font-weight:700;">Remaining Balance: Calculated upon final order creation</span>
          `;
        }
      }
    };

    function renderAdminDetailLogs(booking) {
      const historyLog = document.getElementById('ss-admin-notes-history-log');
      if (!historyLog) return;

      const notesHtml = (booking.adminNotes || []).map(n => `
        <div style="margin-bottom: 4px; padding-bottom: 4px; border-bottom: 1px dashed #e2e8f0;">
          <strong style="color: #102a43;">[Note - ${new Date(n.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}]</strong>
          <span>${escapeHtml(n.note)}</span>
          <span style="color: #64748b; font-size: 10px;">(${escapeHtml(n.author)})</span>
        </div>
      `).join('');

      const historyHtml = (booking.statusHistory || []).map(h => `
        <div style="margin-bottom: 3px; color: #475569;">
          <span style="color: #0369a1; font-weight: 600;">[Lifecycle: ${escapeHtml(h.toStatus)}]</span>
          <span>${escapeHtml(h.note)}</span>
          <span style="color: #94a3b8; font-size: 10px;">— ${new Date(h.timestamp).toLocaleDateString()} (${escapeHtml(h.updatedBy)})</span>
        </div>
      `).join('');

      historyLog.innerHTML = notesHtml + historyHtml || '<em>No notes or history recorded yet.</em>';
    }

    window.addAdminBookingNote = function() {
      if (!currentAdminDetailBookingId) return;
      const noteInput = document.getElementById('ss-admin-new-note');
      const text = noteInput?.value.trim();
      if (!text) return;

      const bookings = getStoredBookings();
      const booking = bookings.find(b => b.id === currentAdminDetailBookingId);
      if (!booking) return;

      if (!booking.adminNotes) booking.adminNotes = [];
      booking.adminNotes.unshift({
        timestamp: new Date().toISOString(),
        note: text,
        author: 'Staff Concierge'
      });
      booking.updatedAt = new Date().toISOString();

      saveStoredBookings(bookings);
      if (noteInput) noteInput.value = '';
      renderAdminDetailLogs(booking);
    };

    window.saveAdminBookingChanges = function() {
      if (!currentAdminDetailBookingId) return;
      const statusSelect = document.getElementById('ss-admin-detail-status-select');
      const advStatusSelect = document.getElementById('ss-admin-detail-adv-status-select');
      const confirmedTotalInput = document.getElementById('ss-admin-detail-confirmed-total');
      const repInput = document.getElementById('ss-admin-rep-name');
      const visitInput = document.getElementById('ss-admin-visit-time');
      const reqsInput = document.getElementById('ss-admin-agreed-reqs');
      const linkedOrderInput = document.getElementById('ss-admin-linked-order');

      const newStatus = statusSelect?.value || 'New Request';
      const newAdvStatus = advStatusSelect?.value || 'Awaiting Advance Payment';
      const newTotal = confirmedTotalInput?.value ? Number(confirmedTotalInput.value) : null;
      const newVerified = newAdvStatus === 'Advance Paid' ? 3000 : 0;
      const newBalance = newTotal ? Math.max(0, newTotal - newVerified) : null;

      const bookings = getStoredBookings();
      const booking = bookings.find(b => b.id === currentAdminDetailBookingId);
      if (!booking) return;

      const nowIso = new Date().toISOString();
      if (booking.lifecycleStatus !== newStatus || booking.advancePaymentStatus !== newAdvStatus) {
        if (!booking.statusHistory) booking.statusHistory = [];
        booking.statusHistory.unshift({
          timestamp: nowIso,
          fromStatus: `${booking.lifecycleStatus} / ${booking.advancePaymentStatus}`,
          toStatus: `${newStatus} / ${newAdvStatus}`,
          note: `Status updated. Confirmed total: ${newTotal ? 'PKR ' + newTotal.toLocaleString() : 'Pending'}, Remaining: ${newBalance !== null ? 'PKR ' + newBalance.toLocaleString() : 'Pending'}`,
          updatedBy: 'Admin Representative'
        });
      }

      booking.lifecycleStatus = newStatus;
      booking.advancePaymentStatus = newAdvStatus;
      booking.verifiedAmountReceived = newVerified;
      booking.representativeName = repInput?.value.trim() || '';
      booking.visitTime = visitInput?.value.trim() || '';
      booking.agreedRequirements = reqsInput?.value.trim() || '';
      booking.confirmedOrderTotal = newTotal;
      booking.linkedShopifyOrderId = linkedOrderInput?.value.trim() || '';
      booking.remainingBalance = newBalance;
      booking.updatedAt = nowIso;

      saveStoredBookings(bookings);
      window.renderAdminBookingList();
      window.openAdminBookingDetail(currentAdminDetailBookingId);
      alert(`Home Service order ${currentAdminDetailBookingId} updated successfully.\nLifecycle: ${newStatus}\nRemaining Balance: ${newBalance !== null ? 'PKR ' + newBalance.toLocaleString() : 'Pending final order creation'}`);
    };

    // Auto-init Home Service on document load if view is present
    if (typeof document !== 'undefined') {
      document.addEventListener('DOMContentLoaded', () => {
        const portal = document.getElementById('view-self-service');
        if (portal) {
          window.initHomeServicePortal();
        }
      });
    }

  })();
</script>

{% schema %}
{
  "name": "Enamels Experience Studio",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "hide_inline_homepage",
      "label": "Modular Mode: Hide Monolithic Header & Homepage",
      "info": "Enable when using separate modular sections for header, slideshow, and homepage sections.",
      "default": false
    },
    {
      "type": "header",
      "content": "Top Announcement Ticker"
    },
    {
      "type": "checkbox",
      "id": "enable_announcement_bar",
      "label": "Show Announcement Bar",
