            <div
              class="collection-category-card ${isActive ? 'active' : ''}"
              data-cat="${catKey}"
              onclick="window.selectProductCategory('${catKey}')"
              role="button"
              tabindex="0"
              aria-label="${gender === 'women' ? "Women's" : "Men's"} ${meta.name} (${count} Designs)"
            >
