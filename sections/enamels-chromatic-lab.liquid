      const nameInput = document.getElementById('rtw-embroidery-name');
      const deptInput = document.getElementById('rtw-embroidery-dept');
      const hospInput = document.getElementById('rtw-embroidery-hosp');

      const nameVal = nameInput?.value?.trim() || '';
      const deptVal = deptInput?.value?.trim() || '';
      const hospVal = hospInput?.value?.trim() || '';

      // Update character counters
      const count1 = document.getElementById('rtw-count-1');
      const count2 = document.getElementById('rtw-count-2');
      const count3 = document.getElementById('rtw-count-3');
      if (count1 && nameInput) count1.textContent = `${nameInput.value.length} / 28`;
      if (count2 && deptInput) count2.textContent = `${deptInput.value.length} / 32`;
      if (count3 && hospInput) count3.textContent = `${hospInput.value.length} / 35`;

      STATE.rtwEngravingLines = { line1: nameVal, line2: deptVal, line3: hospVal };
      if (!STATE.rtwEngravingType || STATE.rtwEngravingType === 'none') {
        if (nameVal || deptVal) STATE.rtwEngravingType = 'direct';
      }

      const line1 = document.getElementById('rtw-sim-line-1');
      const line2 = document.getElementById('rtw-sim-line-2');
      const line3 = document.getElementById('rtw-sim-line-3');
      const garmentLine = document.getElementById('rtw-garment-sim-line');

      if (line1) line1.textContent = nameVal ? nameVal.toUpperCase() : 'DR. AYESHA MALIK';
      if (line2) line2.textContent = deptVal ? deptVal.toUpperCase() : 'CARDIOLOGY';
      if (line3) {
        if (hospVal) {
          line3.textContent = hospVal.toUpperCase();
          line3.style.display = 'block';
        } else {
          line3.style.display = 'none';
        }
      }
      if (garmentLine) garmentLine.textContent = nameVal ? nameVal.toUpperCase() : 'DR. AYESHA MALIK';

      // Update Hospital Crest
      const emblem = document.getElementById('rtw-crest-emblem');
      const crestCode = document.getElementById('rtw-crest-code');
      if (STATE.rtwLogoEnabled) {
        const logoSelect = document.getElementById('rtw-logo-select');
        const code = logoSelect ? logoSelect.value : 'AKUH';
        if (crestCode) crestCode.textContent = code;
        if (emblem) emblem.style.display = 'flex';
        STATE.rtwLogo = {
          code: code,
          name: logoSelect ? (logoSelect.options[logoSelect.selectedIndex]?.text || code) : 'Hospital Crest'
        };
      } else {
        if (emblem) emblem.style.display = 'none';
      }

      // Ensure macro stage fabric color matches selected shade
      const stage = document.getElementById('rtw-macro-stage');
      if (stage && STATE.rtwColor?.hex) {
        stage.style.setProperty('--rtw-preview-fabric', STATE.rtwColor.hex);
      }
    };

    function renderRtwReview() {
      const fabricEl = document.getElementById('rtw-rev-fabric');
      const colorEl = document.getElementById('rtw-rev-color');
      const articleEl = document.getElementById('rtw-rev-article');
      const sizeEl = document.getElementById('rtw-rev-size');
      const embRow = document.getElementById('rtw-rev-emb-row');
      const embEl = document.getElementById('rtw-rev-emb');
      const logoRow = document.getElementById('rtw-rev-logo-row');
      const logoEl = document.getElementById('rtw-rev-logo');
      const totalEl = document.getElementById('rtw-rev-total');
      const advAlert = document.getElementById('rtw-advance-alert');

      if (fabricEl) fabricEl.textContent = STATE.rtwFabric?.name || 'Sprinter Performance Twill';
      if (colorEl) {
        colorEl.innerHTML = `<span class="pdp-swatch-color-dot" style="background: ${STATE.rtwColor?.hex || '#102A43'}; width: 10px; height: 10px; display: inline-block; vertical-align: middle; margin-right: 4px;"></span><strong>${STATE.rtwColor?.name || 'Deep Navy'}</strong>`;
      }
      if (articleEl) {
        articleEl.textContent = `${STATE.rtwArticle?.name || 'Sprinter Series'} — ${STATE.rtwDesign?.name || 'Scrub Set'}`;
      }
      if (sizeEl) {
        if (STATE.rtwSizeMode === 'custom') {
          const m = STATE.rtwCustomMeasurements;
          const details = [
            m.chest ? `Chest: ${m.chest}${m.unit}` : '',
            m.waist ? `Waist: ${m.waist}${m.unit}` : '',
            m.hips ? `Hips: ${m.hips}${m.unit}` : ''
          ].filter(Boolean).join(', ');
          sizeEl.textContent = `Custom Tailored (${details || STATE.rtwUnit})`;
        } else {
          sizeEl.textContent = `Standard Size ${STATE.rtwStandardSize}`;
        }
      }

      const basePrice = (STATE.rtwDesign?.price || 5150) + (STATE.rtwFabric?.price || 0);
      const customSizeFee = STATE.rtwSizeMode === 'custom' ? 750 : 0;
      const embFee = (STATE.rtwEngravingType !== 'none') ? 450 : 0;
      const logoFee = STATE.rtwLogoEnabled ? 650 : 0;
      const total = basePrice + customSizeFee + embFee + logoFee;

      if (embRow) {
        embRow.style.display = embFee > 0 ? 'table-row' : 'none';
        if (embEl) embEl.textContent = `+Rs. 450 (${STATE.rtwEngravingLines.line1 || 'Times New Roman'})`;
      }
      if (logoRow) {
        logoRow.style.display = logoFee > 0 ? 'table-row' : 'none';
        if (logoEl) logoEl.textContent = `+Rs. 650 (${STATE.rtwLogo?.name || 'Hospital Crest'})`;
      }
      if (totalEl) {
        totalEl.textContent = `Rs. ${total.toLocaleString()}`;
      }

      const requiresAdvance = (STATE.rtwSizeMode === 'custom') || (embFee > 0) || (logoFee > 0);
      if (advAlert) {
        advAlert.style.display = requiresAdvance ? 'flex' : 'none';
      }
    }

    window.addRtwToCart = function() {
      const basePrice = (STATE.rtwDesign?.price || 5150) + (STATE.rtwFabric?.price || 0);
      const customSizeFee = STATE.rtwSizeMode === 'custom' ? 750 : 0;
      const embFee = (STATE.rtwEngravingType !== 'none') ? 450 : 0;
      const logoFee = STATE.rtwLogoEnabled ? 650 : 0;
      const unitPrice = basePrice + customSizeFee + embFee + logoFee;

      const requiresAdvance = (STATE.rtwSizeMode === 'custom') || (embFee > 0) || (logoFee > 0);

      const cartItem = {
        id: `rtw-${Date.now()}`,
        productId: STATE.rtwDesign?.id || 'rtw-custom',
        title: `RTW Bespoke — ${STATE.rtwDesign?.name || 'Medical Scrub'}`,
        series: STATE.rtwArticle?.name || 'Sprinter Series',
        image: STATE.rtwDesign?.image || 'cat-sprinter.jpg',
        fabric: STATE.rtwFabric?.name || 'Sprinter Performance Twill',
        color: STATE.rtwColor?.name || 'Deep Navy',
        colorHex: STATE.rtwColor?.hex || '#102A43',
        size: STATE.rtwSizeMode === 'standard' ? `Standard Size ${STATE.rtwStandardSize}` : 'Custom Tailored Measurements',
        customMeasurements: STATE.rtwSizeMode === 'custom' ? STATE.rtwCustomMeasurements : null,
        engraving: STATE.rtwEngravingType !== 'none' ? {
          type: 'direct',
          lines: STATE.rtwEngravingLines,
          threadColor: STATE.rtwThreadColor?.name || 'White',
          font: 'Times New Roman'
        } : null,
        logo: STATE.rtwLogoEnabled ? STATE.rtwLogo : null,
        quantity: 1,
        unitPrice: unitPrice,
        lineTotal: unitPrice,
        requiresAdvancePayment: requiresAdvance
      };

      const cart = getStoredCart();
      cart.push(cartItem);
      saveCart(cart);
      updateCartBadge();
      window.openCartDrawer();
    };

    // Option 3 Self Service modal architecture (Section 12)
    window.openSelfServiceModal = function() {
      const modal = document.getElementById('self-service-modal');
      if (modal) modal.style.display = 'flex';
    };
    window.closeSelfServiceModal = function() {
      const modal = document.getElementById('self-service-modal');
      if (modal) modal.style.display = 'none';
    };

    // ------------------------------------------------------------
    // 8. SIMPLE PURCHASE MODAL FOR NON-CUSTOM ITEMS (SECTION 13)
    // ------------------------------------------------------------
    window.openSimpleProductModal = function(productId) {
      const catalogue = window.EnamelsCatalogue || [];
      const item = catalogue.find(p => p.id === productId) || catalogue[0];
      if (!item) return;

      STATE.simpleProduct = item;
      STATE.simpleColor = item.colors?.[0]?.name || 'Standard';
      STATE.simpleQty = 1;

      const titleEl = document.getElementById('simple-prod-title');
      const catEl = document.getElementById('simple-prod-category');
      const priceEl = document.getElementById('simple-prod-price');
      const imgEl = document.getElementById('simple-prod-img');
      const qtyInput = document.getElementById('simple-qty-input');
      const selectColor = document.getElementById('simple-select-color');

      if (titleEl) titleEl.textContent = item.title.replace('DEMO — ', '');
      if (catEl) catEl.textContent = (item.category || 'CLINICAL').toUpperCase();
      if (priceEl) priceEl.textContent = `Rs. ${item.basePrice.toLocaleString()}`;
      if (imgEl && item.image) {
        imgEl.src = window.ShopifyThemeAssets?.[item.image] || item.image;
        imgEl.onerror = () => { imgEl.src = '{{ 'cat-caps.jpg' | asset_url }}'; };
      }
      if (qtyInput) qtyInput.value = '1';

      if (selectColor) {
        selectColor.innerHTML = (item.colors || [{ name: 'Standard' }]).map(c => `
          <option value="${c.name}">${c.name}</option>
        `).join('');
      }

      const modal = document.getElementById('simple-product-modal');
      if (modal) modal.style.display = 'flex';
    };

    window.closeSimpleProductModal = function() {
      const modal = document.getElementById('simple-product-modal');
      if (modal) modal.style.display = 'none';
    };

    window.updateSimpleProductColor = function(cName) {
      STATE.simpleColor = cName;
    };

    window.stepSimpleQty = function(delta) {
      STATE.simpleQty = Math.max(1, STATE.simpleQty + delta);
      const input = document.getElementById('simple-qty-input');
      if (input) input.value = STATE.simpleQty;
    };

    window.addSimpleProductToCart = function() {
      const item = STATE.simpleProduct;
      if (!item) return;

      const cartItem = {
        id: `simple-${item.id}-${Date.now()}`,
        productId: item.id,
        title: item.title.replace('DEMO — ', ''),
        series: item.category,
        image: item.image,
        color: STATE.simpleColor,
        size: 'Standard',
        quantity: STATE.simpleQty,
        unitPrice: item.basePrice,
        lineTotal: item.basePrice * STATE.simpleQty,
        requiresAdvancePayment: false
      };

      const cart = getStoredCart();
      cart.push(cartItem);
      saveCart(cart);
      updateCartBadge();
      window.closeSimpleProductModal();
      window.openCartDrawer();
    };

    // ------------------------------------------------------------
    // 9. CART DRAWER & PERSISTENCE (SECTION 14)
    // ------------------------------------------------------------
    function getStoredCart() {
      try {
        const raw = localStorage.getItem('enamels_demo_cart');
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    }

    function saveCart(cart) {
      try {
        localStorage.setItem('enamels_demo_cart', JSON.stringify(cart));
      } catch (e) {}
    }

    function updateCartBadge() {
      const cart = getStoredCart();
      const count = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);

      const navBadge = document.getElementById('enamels-cart-count');
      const drawerBadge = document.getElementById('cart-drawer-count-badge');

      if (navBadge) navBadge.textContent = count;
      if (drawerBadge) drawerBadge.textContent = count;
    }

    window.openCartDrawer = function() {
      renderCartDrawerItems();
      const drawer = document.getElementById('cart-drawer');
      const overlay = document.getElementById('cart-drawer-overlay');
      if (drawer) drawer.classList.add('open');
      if (overlay) overlay.classList.add('open');
    };

    window.closeCartDrawer = function() {
      const drawer = document.getElementById('cart-drawer');
      const overlay = document.getElementById('cart-drawer-overlay');
      if (drawer) drawer.classList.remove('open');
      if (overlay) overlay.classList.remove('open');
    };

    function renderCartDrawerItems() {
      const cart = getStoredCart();
      const container = document.getElementById('cart-items-container');
      const subtotalEl = document.getElementById('cart-drawer-subtotal');
      const advanceAlert = document.getElementById('cart-advance-payment-warning');
      const freeShipProg = document.getElementById('free-shipping-progress');
      const freeShipStatus = document.getElementById('free-shipping-status');

      if (!container) return;

      if (!cart.length) {
        container.innerHTML = `
          <div style="text-align: center; padding: 60px 20px; color: #64748b;">
            <div style="font-size: 36px; margin-bottom: 12px;">🛒</div>
            <p style="font-weight: 700; color: #102a43; margin-bottom: 4px;">Your Cart is Empty</p>
            <p style="font-size: 12px; margin-bottom: 20px;">Explore our scrub collections and technical medical apparel.</p>
            <button type="button" class="btn-card-action" onclick="window.closeCartDrawer(); window.navigateToView('category-scrubs');" style="width: auto; padding: 10px 20px;">
              Browse Scrubs Collection
            </button>
          </div>
        `;
        if (subtotalEl) subtotalEl.textContent = 'Rs. 0';
        if (advanceAlert) advanceAlert.style.display = 'none';
        if (freeShipProg) freeShipProg.style.width = '0%';
        if (freeShipStatus) freeShipStatus.textContent = 'Rs. 7,000 remaining';
        return;
      }

      let subtotal = 0;
      let hasAdvanceItem = false;

      container.innerHTML = cart.map((item, idx) => {
        const itemLineTotal = (item.unitPrice || 0) * (item.quantity || 1);
        subtotal += itemLineTotal;
        if (item.requiresAdvancePayment) hasAdvanceItem = true;

        // Structured properties display
        let propsHtml = '';
        if (item.color) propsHtml += `<div>Colour: <strong>${item.color}</strong></div>`;
        if (item.size) propsHtml += `<div>Size: <strong>${item.size}</strong></div>`;
        if (item.alterations) {
          propsHtml += `<div style="color: #00b8a9;">↳ Alterations: ${item.alterations.shirtLength} Top, ${item.alterations.trouserLength} Trouser</div>`;
        }
        if (item.engraving) {
          propsHtml += `<div style="color: #102a43;">↳ Engraving (${item.engraving.font}): "${item.engraving.lines.line1}" [${item.engraving.threadColor}]</div>`;
        }
        if (item.logo) {
          propsHtml += `<div style="color: #102a43;">↳ Crest: ${item.logo.name} (${item.logo.placement})</div>`;
        }
        if (item.requiresAdvancePayment) {
          propsHtml += `<span class="cart-advance-tag">⚠️ ADVANCE PAYMENT REQUIRED</span>`;
        }

        return `
          <div class="cart-item-card">
            <img src="${item.image ? (window.ShopifyThemeAssets?.[item.image] || item.image) : ''}" alt="${item.title}" class="cart-item-thumb" onerror="this.src='{{ 'cat-sprinter.jpg' | asset_url }}'" />
            <div class="cart-item-meta">
              <h4 class="cart-item-title">${item.title}</h4>
              <div class="cart-item-props">${propsHtml}</div>
              <div class="cart-item-actions">
                <div class="cart-item-qty-row">
                  <button type="button" class="qty-btn" onclick="window.updateCartItemQty(${idx}, -1)">-</button>
                  <span style="font-size: 12px; font-weight: 700; width: 20px; text-align: center;">${item.quantity || 1}</span>
                  <button type="button" class="qty-btn" onclick="window.updateCartItemQty(${idx}, 1)">+</button>
                </div>
                <button type="button" class="cart-item-remove-link" onclick="window.removeCartItem(${idx})">Remove</button>
              </div>
            </div>
            <div class="cart-item-price-col">
              Rs. ${itemLineTotal.toLocaleString()}
            </div>
          </div>
        `;
      }).join('');

      if (subtotalEl) subtotalEl.textContent = `Rs. ${subtotal.toLocaleString()}`;
      if (advanceAlert) advanceAlert.style.display = hasAdvanceItem ? 'flex' : 'none';

      // Free shipping progress calculation (Rs. 7,000 threshold)
      const threshold = 7000;
      const progress = Math.min(100, (subtotal / threshold) * 100);
      const remaining = Math.max(0, threshold - subtotal);

      if (freeShipProg) freeShipProg.style.width = `${progress}%`;
      if (freeShipStatus) {
        freeShipStatus.textContent = remaining === 0
          ? '🎉 Free Shipping Unlocked!'
          : `Rs. ${remaining.toLocaleString()} remaining`;
      }
    }

    window.updateCartItemQty = function(idx, delta) {
      const cart = getStoredCart();
      if (!cart[idx]) return;

      cart[idx].quantity = (cart[idx].quantity || 1) + delta;
      if (cart[idx].quantity <= 0) {
        cart.splice(idx, 1);
      } else {
        cart[idx].lineTotal = cart[idx].unitPrice * cart[idx].quantity;
      }

      saveCart(cart);
      updateCartBadge();
      renderCartDrawerItems();
    };

    window.removeCartItem = function(idx) {
      const cart = getStoredCart();
      cart.splice(idx, 1);
      saveCart(cart);
      updateCartBadge();
      renderCartDrawerItems();
    };

    // ------------------------------------------------------------
    // 10. CHECKOUT WORKFLOWS (SECTION 15)
    // ------------------------------------------------------------
    window.openCheckoutModal = function(mode) {
      const cart = getStoredCart();
      if (!cart.length) {
        alert('Your cart is empty. Please select a product first.');
        return;
      }

      window.closeCartDrawer();
      const modal = document.getElementById('checkout-options-modal');
      const bankView = document.getElementById('checkout-view-bank');
      const repView = document.getElementById('checkout-view-rep');
      const confView = document.getElementById('checkout-view-confirmation');

      if (modal) modal.style.display = 'flex';
      if (bankView) bankView.style.display = mode === 'bank' ? 'block' : 'none';
      if (repView) repView.style.display = mode === 'rep' ? 'block' : 'none';
      if (confView) confView.style.display = 'none';
    };

    window.closeCheckoutModal = function() {
      const modal = document.getElementById('checkout-options-modal');
      if (modal) modal.style.display = 'none';
    };

    window.submitBankOrder = function() {
      const name = document.getElementById('bank-order-name')?.value;
      const phone = document.getElementById('bank-order-phone')?.value;
      const addr = document.getElementById('bank-order-address')?.value;

      if (!name || !phone || !addr) {
        alert('Please provide your Name, WhatsApp/Phone, and Delivery Address to receive your reference number.');
        return;
      }

      const refNumber = `ENM-2026-${Math.floor(10000 + Math.random() * 90000)}`;
      showOrderConfirmation(refNumber, 'Payment Pending Verification (Unpaid)', 'Direct Manual Bank Transfer (Meezan Bank)');
    };

    window.submitRepOrder = function() {
      const name = document.getElementById('rep-order-name')?.value;
      const phone = document.getElementById('rep-order-phone')?.value;

      if (!name || !phone) {
        alert('Please enter your Name and WhatsApp contact number so our sizing concierge can assist you.');
        return;
      }

      const refNumber = `ENM-REQ-${Math.floor(10000 + Math.random() * 90000)}`;
      showOrderConfirmation(refNumber, 'Concierge Sizing Request Received', 'Customer Representative Assisted Order');
    };

    function showOrderConfirmation(refId, statusText, paymentMode) {
      const bankView = document.getElementById('checkout-view-bank');
      const repView = document.getElementById('checkout-view-rep');
      const confView = document.getElementById('checkout-view-confirmation');
      const refEl = document.getElementById('conf-reference-id');
      const statusEl = document.getElementById('conf-status-badge');
      const msgEl = document.getElementById('conf-message');

      if (bankView) bankView.style.display = 'none';
      if (repView) repView.style.display = 'none';
      if (confView) confView.style.display = 'block';

      if (refEl) refEl.textContent = `#${refId}`;
      if (statusEl) statusEl.textContent = `Status: ${statusText}`;
      if (msgEl) msgEl.textContent = `Your order via ${paymentMode} has been logged. Please share payment receipt on WhatsApp (+92 301 13 31 133).`;

      // Clear demo cart
      localStorage.removeItem('enamels_demo_cart');
      updateCartBadge();
    }

    // ------------------------------------------------------------
    // 11. AUXILIARY MODALS & HELPERS
    // ------------------------------------------------------------
    window.openSizeGuideModal = function() {
      const modal = document.getElementById('size-guide-modal');
      if (modal) modal.style.display = 'flex';
    };

    window.closeSizeGuideModal = function() {
      const modal = document.getElementById('size-guide-modal');
      if (modal) modal.style.display = 'none';
    };

    window.openWishlistModal = function() {
      alert('Enamels Wishlist: Save your preferred scrub sets and department styles for fast seasonal reorders.');
    };

    window.openSearchModal = function() {
      const term = prompt('Search Enamels Catalogue (e.g. Sprinter, Crown, Velora, Caps, Lab Coats):');
      if (term) {
        window.navigateToView('category-scrubs');
        const catalogue = window.EnamelsCatalogue || [];
        const lower = term.toLowerCase();
        const matched = catalogue.filter(p => p.title.toLowerCase().includes(lower) || p.series?.toLowerCase().includes(lower) || p.category?.toLowerCase().includes(lower));
        renderGridWithItems(matched);
      }
    };

    window.toggleMobileNavDrawer = function() {
      const backdrop = document.getElementById('mobile-nav-backdrop');
      if (backdrop) {
        const isShown = backdrop.style.display === 'flex';
        backdrop.style.display = isShown ? 'none' : 'flex';
      }
    };

  })();
</script>

