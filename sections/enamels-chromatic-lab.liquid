        { id: 'meas-input-inseam', tag: 'tag-pdp-inseam', val: preset.inseam }
      ];

      fields.forEach(f => {
        const input = document.getElementById(f.id);
        if (input) {
          input.value = f.val;
          input.classList.remove('field-edited');
        }
        const tag = document.getElementById(f.tag);
        if (tag) {
          tag.textContent = '';
          tag.classList.remove('active');
        }
      });

      STATE.pdpCustomMeasurements = {
        chest: preset.chest,
        waist: preset.waist,
        hips: preset.hips,
        top: preset.shirt,
        inseam: preset.inseam,
        unit: unit
      };

      document.querySelectorAll('#pdp-sizes-grid .pdp-size-chip').forEach(c => {
        const s = c.getAttribute('data-size') || c.textContent.trim();
        c.classList.toggle('active', s === size);
