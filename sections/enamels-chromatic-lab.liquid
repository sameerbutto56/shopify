{% comment %}
  ENAMELS ONLINE — MASTER CHROMATIC LAB & CUSTOM ORDERING SYSTEM
  Sections 1 to 18 Complete Implementation.
  Preserves authentic white visual identity, Poppins typography, branding,
  original 5-slide banner slideshow, and exact 6-category navigation.
{% endcomment %}

{% liquid
  assign dynamic_slide_count = 0
  for block in section.blocks
    if block.type == 'slide'
      assign dynamic_slide_count = dynamic_slide_count | plus: 1
    endif
  endfor
  if dynamic_slide_count == 0
    assign dynamic_slide_count = 5
  endif
%}

<div class="enamels-theme-root" id="enamels-app-root">
  <!-- Top Announcement Bar, Header & Exact 6-Category Navigation -->
  {% render 'enamels-header-nav', section: section %}

  <!-- Main Storefront Views Container -->
  <main id="enamels-main-content">
    <!-- View 1: Homepage & 5-Slide Banner Slideshow -->
    {% render 'enamels-homepage', section: section %}

    <!-- View 2: Scrubs Collection with Gender Filter & Article Tabs -->
    {% render 'enamels-scrubs-collection', section: section %}

    <!-- View 3: Single-Page Customization Studio & Self-Service Representative Visit -->
    {% render 'enamels-product-detail', section: section %}

    <!-- View 4: Ready to Wear / Make Your Own Scrub Configurator -->
    {% render 'enamels-ready-to-wear', section: section %}

    <!-- View 5: Dedicated Home Service Representative Visit Booking Portal -->
    {% render 'enamels-self-service', section: section %}
  </main>

  <!-- Slide-out Cart Drawer, Checkout Modals, Simple Product Modal & Size Guide -->
  {% render 'enamels-cart-checkout', section: section %}
</div>

<!-- ============================================================ -->
<!-- UNIFIED JAVASCRIPT CONTROLLER FOR ENAMELS ONLINE STOREFRONT -->
<!-- ============================================================ -->
<script>
  window.ShopifyThemeAssets = {
    'demo-sprinter-navy.jpg': {{ 'demo-sprinter-navy.jpg' | asset_url | json }},
    'demo-velora-teal.jpg': {{ 'demo-velora-teal.jpg' | asset_url | json }},
    'demo-crown-burgundy.jpg': {{ 'demo-crown-burgundy.jpg' | asset_url | json }},
    'cat-sprinter.jpg': {{ 'cat-sprinter.jpg' | asset_url | json }},
    'cat-men-scrubs.jpg': {{ 'cat-men-scrubs.jpg' | asset_url | json }},
    'cat-women-scrubs.jpg': {{ 'cat-women-scrubs.jpg' | asset_url | json }},
    'cat-crown.jpg': {{ 'cat-crown.jpg' | asset_url | json }},
    'cat-labcoat.jpg': {{ 'cat-labcoat.jpg' | asset_url | json }},
    'cat-caps.jpg': {{ 'cat-caps.jpg' | asset_url | json }},
    'cat-velora.jpg': {{ 'cat-velora.jpg' | asset_url | json }},
    'cat-clogs.jpg': {{ 'cat-clogs.jpg' | asset_url | json }},
    'cat-flexfit.jpg': {{ 'cat-flexfit.jpg' | asset_url | json }},
    'banner-abbotabad.jpg': {{ 'banner-abbotabad.jpg' | asset_url | json }}
  };

  (function() {
    'use strict';

    // ------------------------------------------------------------
    // 1. APPLICATION STATE
    // ------------------------------------------------------------
    const STATE = {
      // Slideshow
      slideIndex: 0,
      slideCount: {{ dynamic_slide_count }},
      slideTimer: null,
      slidePaused: false,

      // Scrubs Collection Filter & Multi-Level Browsing Hierarchy
      genderFilter: 'men', // 'all' | 'men' | 'women'
      productCategoryFilter: 'all', // 'all' | 'scrubs' | 'lab-coat' | 'caps' | 'accessories'
      articleFilter: 'all', // 'all' | 'Sprinter' | 'Crown' | 'Velora' | 'Flexwell' | 'Helium' | 'BunFit' | etc.
      seasonFilter: null, // null | 'summer' | 'winter'
      sortOrder: 'featured',
      activeCardColors: {}, // map of productId -> selected colorName

      // Product Detail Page (PDP) Customizer
      pdpProduct: null,
      pdpCurrentStep: 'design',
      pdpCompletedSteps: new Set(['design']),
      pdpSkippedSteps: new Set(),
      pdpColor: { name: 'Deep Navy', hex: '#102A43', image: '' },
      pdpSize: 'M',
      pdpIsCustomSize: false,
      pdpCustomMeasurements: { chest: '', waist: '', hips: '', inseam: '', unit: 'in' },
      pdpCustomColor: null,
      pdpAlterations: false,
      pdpAlterationDetails: { shirtLength: 'Standard', trouserLength: 'Standard', sleeveLength: 'Half Sleeve (Standard)', notes: '' },
      pdpEngravingType: 'none', // 'none' | 'direct' | 'patch'
      pdpEngravingLines: { line1: '', line2: '', line3: '' },
      pdpThreadColor: { name: 'Silk White', hex: '#FFFFFF' },
      pdpLogoEnabled: false,
      pdpLogo: { id: 'akuh', name: 'Aga Khan University Hospital', placement: 'Right Chest' },
      pdpCompanionAddons: [],
      pdpQty: 1,

      // Ready to Wear Configurator Wizard
      rtwStep: 1,
      rtwFabric: { id: 'sprinter-twill', name: 'Sprinter Performance Twill', price: 0, desc: '4-Way Mechanical Stretch (72% Poly, 21% Rayon, 7% Spandex)' },
      rtwColor: { name: 'Deep Navy', hex: '#102A43' },
      rtwArticle: { id: 'Sprinter', name: 'Sprinter Series' },
      rtwDesign: { id: 'sprinter-athletic-set', name: 'Sprinter Athletic V-Neck Scrub Set', price: 5150, image: 'demo-sprinter-navy.jpg' },
      rtwSizeMode: 'standard', // 'standard' | 'custom'
      rtwStandardSize: 'M',
      rtwUnit: 'in',
      rtwCustomMeasurements: { chest: '', waist: '', hips: '', shoulder: '', sleeve: '', topLength: '', trouserWaist: '', trouserLength: '', inseam: '' },
      rtwAlterations: false,
      rtwAlterationDetails: { shirtLength: 'Standard', trouserLength: 'Standard', sleeveLength: 'Half Sleeve (Standard)', notes: '' },
      rtwEngravingType: 'none',
      rtwEngravingLines: { line1: '', line2: '', line3: '' },
      rtwThreadColor: { name: 'Silk White', hex: '#FFFFFF' },
      rtwLogoEnabled: false,
      rtwLogo: { id: 'akuh', name: 'Aga Khan University Hospital', placement: 'Right Chest' },

      // Simple Product Modal (Non-custom items)
      simpleProduct: null,
      simpleColor: 'Deep Navy',
      simpleQty: 1
    };

    window.STATE = STATE;

    // ------------------------------------------------------------
    // ENAMELS MASTER SIZING PRESETS (FINISHED GARMENT DIMENSIONS)
    // ------------------------------------------------------------
    const ENAMELS_RTW_SIZE_PRESETS = {
      in: {
        'XS':  { chest: 34, waist: 28, hips: 36, shoulder: 16, shirt: 26, inseam: 38 },
        'S':   { chest: 37, waist: 30, hips: 38, shoulder: 17, shirt: 27, inseam: 39 },
        'M':   { chest: 40, waist: 33, hips: 41, shoulder: 18, shirt: 28, inseam: 40 },
        'L':   { chest: 43, waist: 36, hips: 44, shoulder: 19, shirt: 29, inseam: 41 },
        'XL':  { chest: 46, waist: 39, hips: 47, shoulder: 20, shirt: 30, inseam: 42 },
        '2XL': { chest: 49, waist: 42, hips: 50, shoulder: 21, shirt: 31, inseam: 42.5 }
      },
      cm: {
        'XS':  { chest: 86,  waist: 71,  hips: 91,  shoulder: 41, shirt: 66, inseam: 96 },
        'S':   { chest: 94,  waist: 76,  hips: 96,  shoulder: 43, shirt: 68, inseam: 99 },
        'M':   { chest: 102, waist: 84,  hips: 104, shoulder: 46, shirt: 71, inseam: 102 },
        'L':   { chest: 109, waist: 91,  hips: 112, shoulder: 48, shirt: 74, inseam: 104 },
        'XL':  { chest: 117, waist: 99,  hips: 119, shoulder: 51, shirt: 76, inseam: 107 },
        '2XL': { chest: 124, waist: 107, hips: 127, shoulder: 53, shirt: 79, inseam: 108 }
      }
    };
    window.ENAMELS_RTW_SIZE_PRESETS = ENAMELS_RTW_SIZE_PRESETS;

    function selectRtwStdSize(size) {
      STATE.rtwSizeMode = 'standard';
      STATE.rtwStandardSize = size;
      STATE.rtwSelectedPresetSize = size;
      STATE.rtwIsExplicitCustom = false;

      const unit = STATE.rtwUnit || 'in';
      const presets = ENAMELS_RTW_SIZE_PRESETS[unit] || ENAMELS_RTW_SIZE_PRESETS['in'];
      const preset = presets[size] || presets['M'];

      // Populate every measurement field with the saved preset
      const fields = ['chest', 'waist', 'hips', 'shoulder', 'shirt', 'inseam'];
      fields.forEach(f => {
        const input = document.getElementById(`rtw-meas-${f}`);
        if (input) {
          input.value = preset[f];
          input.classList.remove('field-edited');
        }
        const tag = document.getElementById(`tag-rtw-meas-${f}`);
        if (tag) {
          tag.textContent = '';
          tag.classList.remove('active');
        }
      });

      // Synchronize in STATE
      STATE.rtwCustomMeasurements = {
        chest: preset.chest,
        waist: preset.waist,
        hips: preset.hips,
        shoulder: preset.shoulder,
        shirt: preset.shirt,
        inseam: preset.inseam,
        unit: unit
      };

      // Update size chips
      document.querySelectorAll('#rtw-sizes-chips-grid .pdp-size-chip').forEach(c => {
        const s = c.getAttribute('data-size') || c.textContent.trim();
        c.classList.toggle('active', s === size);
      });
      const cChip = document.getElementById('rtw-chip-custom');
      if (cChip) cChip.classList.remove('active');

      // Update dynamic status banner
      const statusWrap = document.getElementById('rtw-size-status-indicator');
      const statusIcon = document.getElementById('rtw-size-status-icon');
      const statusText = document.getElementById('rtw-size-status-text');
      if (statusWrap) {
        statusWrap.style.background = '#f0fdfa';
        statusWrap.style.color = '#008779';
        statusWrap.style.borderColor = '#99f6e4';
      }
      if (statusIcon) statusIcon.textContent = '📐';
      if (statusText) statusText.textContent = `Standard Preset Active: Size ${size} — All measurements auto-filled (${unit.toUpperCase()})`;

      const stdBox = document.getElementById('rtw-box-std-size');
      const cstBox = document.getElementById('rtw-box-custom-size');
      if (stdBox) { stdBox.style.borderColor = '#00b8a9'; stdBox.style.background = '#ffffff'; }
      if (cstBox) { cstBox.style.borderColor = '#e2e8f0'; cstBox.style.background = '#ffffff'; }
    }
    window.selectRtwStdSize = selectRtwStdSize;
    window.selectRtwStandardSize = selectRtwStdSize;

    function handleRtwMeasurementChange(inputEl) {
      const unit = STATE.rtwUnit || 'in';
      const baseSize = STATE.rtwSelectedPresetSize || 'M';
      const presets = ENAMELS_RTW_SIZE_PRESETS[unit] || ENAMELS_RTW_SIZE_PRESETS['in'];
      const preset = presets[baseSize] || presets['M'];

      const fields = ['chest', 'waist', 'hips', 'shoulder', 'shirt', 'inseam'];
      let anyDeviated = false;
      const currentValues = {};

      fields.forEach(f => {
        const input = document.getElementById(`rtw-meas-${f}`);
        const tag = document.getElementById(`tag-rtw-meas-${f}`);
        const rawVal = input ? String(input.value !== undefined && input.value !== null ? input.value : '').trim() : '';
        const val = parseFloat(rawVal);
        const presetVal = parseFloat(preset[f]);

        currentValues[f] = isNaN(val) ? '' : val;

        const isDeviated = rawVal === '' || isNaN(val) || Math.abs(val - presetVal) > 0.001;

        if (isDeviated) {
          anyDeviated = true;
          if (input) input.classList.add('field-edited');
          if (tag) {
            tag.textContent = 'Edited';
            tag.classList.add('active');
          }
        } else {
          if (input) input.classList.remove('field-edited');
          if (tag) {
            tag.textContent = '';
            tag.classList.remove('active');
          }
        }
      });

      currentValues.unit = unit;
      STATE.rtwCustomMeasurements = currentValues;

      const statusWrap = document.getElementById('rtw-size-status-indicator');
      const statusIcon = document.getElementById('rtw-size-status-icon');
      const statusText = document.getElementById('rtw-size-status-text');

      if (anyDeviated) {
        // AUTOMATIC CONVERSION TO C
        STATE.rtwSizeMode = 'custom';
        STATE.rtwStandardSize = 'C';

        document.querySelectorAll('#rtw-sizes-chips-grid .pdp-size-chip').forEach(c => {
          const s = c.getAttribute('data-size') || c.textContent.trim();
          c.classList.toggle('active', s === 'C');
        });

        if (statusWrap) {
          statusWrap.style.background = '#fffbeb';
          statusWrap.style.color = '#b45309';
          statusWrap.style.borderColor = '#fde68a';
        }
        if (statusIcon) statusIcon.textContent = '✏️';
        if (statusText) statusText.innerHTML = `<strong>Custom Size (C) Active</strong> — Sizing deviation detected (+Rs. 750 custom pattern cutting fee)`;

        const cstBox = document.getElementById('rtw-box-custom-size');
        if (cstBox) cstBox.style.borderColor = '#f59e0b';
      } else {
        // All measurements match original preset
        if (!STATE.rtwIsExplicitCustom) {
          STATE.rtwSizeMode = 'standard';
          STATE.rtwStandardSize = baseSize;

          document.querySelectorAll('#rtw-sizes-chips-grid .pdp-size-chip').forEach(c => {
            const s = c.getAttribute('data-size') || c.textContent.trim();
            c.classList.toggle('active', s === baseSize);
          });

          if (statusWrap) {
            statusWrap.style.background = '#f0fdfa';
            statusWrap.style.color = '#008779';
            statusWrap.style.borderColor = '#99f6e4';
          }
          if (statusIcon) statusIcon.textContent = '📐';
          if (statusText) statusText.textContent = `Standard Preset Active: Size ${baseSize} — All measurements match preset (${unit.toUpperCase()})`;

          const cstBox = document.getElementById('rtw-box-custom-size');
          if (cstBox) cstBox.style.borderColor = '#e2e8f0';
        }
      }
    }
    window.handleRtwMeasurementChange = handleRtwMeasurementChange;

    function selectRtwCustomExplicit() {
      STATE.rtwSizeMode = 'custom';
      STATE.rtwStandardSize = 'C';
      STATE.rtwIsExplicitCustom = true;

      document.querySelectorAll('#rtw-sizes-chips-grid .pdp-size-chip').forEach(c => {
        const s = c.getAttribute('data-size') || c.textContent.trim();
        c.classList.toggle('active', s === 'C');
      });

      const statusWrap = document.getElementById('rtw-size-status-indicator');
      const statusIcon = document.getElementById('rtw-size-status-icon');
      const statusText = document.getElementById('rtw-size-status-text');
      if (statusWrap) {
        statusWrap.style.background = '#fffbeb';
        statusWrap.style.color = '#b45309';
        statusWrap.style.borderColor = '#fde68a';
      }
      if (statusIcon) statusIcon.textContent = '✏️';
      if (statusText) statusText.innerHTML = `<strong>Custom Size (C) Active</strong> — Enter your bespoke tailoring measurements (+Rs. 750 pattern cutting fee)`;

      const cstBox = document.getElementById('rtw-box-custom-size');
      if (cstBox) cstBox.style.borderColor = '#00b8a9';
    }
    window.selectRtwCustomExplicit = selectRtwCustomExplicit;

    function setRtwMeasurementUnit(newUnit) {
      if (STATE.rtwUnit === newUnit) return;
      const oldUnit = STATE.rtwUnit || 'in';
      STATE.rtwUnit = newUnit;

      const bIn = document.getElementById('rtw-meas-unit-in');
      const bCm = document.getElementById('rtw-meas-unit-cm');
      if (bIn) bIn.classList.toggle('active', newUnit === 'in');
      if (bCm) bCm.classList.toggle('active', newUnit === 'cm');
      document.querySelectorAll('.rtw-unit-label').forEach(el => el.textContent = newUnit);

      if (STATE.rtwSizeMode === 'standard' && STATE.rtwStandardSize !== 'C') {
        selectRtwStdSize(STATE.rtwStandardSize);
      } else {
        const fields = ['chest', 'waist', 'hips', 'shoulder', 'shirt', 'inseam'];
        fields.forEach(f => {
          const input = document.getElementById(`rtw-meas-${f}`);
          if (input && input.value) {
            const num = parseFloat(input.value);
            if (!isNaN(num)) {
              if (newUnit === 'cm' && oldUnit === 'in') {
                input.value = Math.round(num * 2.54);
              } else if (newUnit === 'in' && oldUnit === 'cm') {
                input.value = Math.round((num / 2.54) * 2) / 2;
              }
            }
          }
        });
        handleRtwMeasurementChange();
      }
    }
    window.setRtwMeasurementUnit = setRtwMeasurementUnit;
    window.setRtwUnit = setRtwMeasurementUnit;

    function saveRtwCustomMeasurements() {
      const fields = ['chest', 'waist', 'hips', 'shoulder', 'shirt', 'inseam'];
      const values = {};
      fields.forEach(f => {
        const input = document.getElementById(`rtw-meas-${f}`);
        values[f] = input ? (parseFloat(input.value) || input.value) : '';
      });
      values.unit = STATE.rtwUnit || 'in';
      STATE.rtwCustomMeasurements = values;

      const btn = document.querySelector('#rtw-box-custom-size .btn-card-action');
      if (btn) {
        const origText = btn.textContent;
        btn.textContent = '✓ Measurements Confirmed & Locked';
        btn.style.background = '#008779';
        setTimeout(() => {
          btn.textContent = origText;
          btn.style.background = '';
        }, 2000);
      }
    }
    window.saveRtwCustomMeasurements = saveRtwCustomMeasurements;

    function syncRtwSizeInputsFromState() {
      const m = STATE.rtwCustomMeasurements;
      if (!m) return;
      const fields = ['chest', 'waist', 'hips', 'shoulder', 'shirt', 'inseam'];
      fields.forEach(f => {
        const input = document.getElementById(`rtw-meas-${f}`);
        if (input && m[f] !== undefined && m[f] !== '') {
          input.value = m[f];
        }
      });
      if (STATE.rtwStandardSize === 'C' || STATE.rtwSizeMode === 'custom') {
        handleRtwMeasurementChange();
      }
    }
    window.syncRtwSizeInputsFromState = syncRtwSizeInputsFromState;

    // ------------------------------------------------------------
    // 2. INITIALIZATION (PROTECTED AGAINST DUPLICATE EXECUTION)
    // ------------------------------------------------------------
    let isEnamelsAppInitialized = false;
    document.addEventListener('DOMContentLoaded', initEnamelsApp);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(initEnamelsApp, 50);
    }

    function initEnamelsApp() {
      if (isEnamelsAppInitialized) return;
      isEnamelsAppInitialized = true;
      initSlideshow();
      init3DCategoryCards();
      renderScrubsGrid();
      updateCartBadge();
      renderRtwColorsForFabric('sprinter-twill');
      renderRtwDesignsForArticle('Sprinter');
      selectRtwStdSize('M');
      handleHashRouting();
      window.addEventListener('hashchange', handleHashRouting);
    }

    // Debounce guard for cart and checkout submissions
    let isCartSubmissionBusy = false;
    function withCartDebounce(callback) {
      if (isCartSubmissionBusy) return;
      isCartSubmissionBusy = true;
      try {
        callback();
      } finally {
        setTimeout(() => { isCartSubmissionBusy = false; }, 400);
      }
    }

    // ------------------------------------------------------------
    // 3. NAVIGATION ROUTING
    // ------------------------------------------------------------
    window.navigateToView = function(viewId) {
      document.querySelectorAll('.chroma-view-panel').forEach(p => p.classList.remove('active'));

      if (viewId === 'self-service') {
        const dedicatedPortal = document.getElementById('view-self-service');
        if (dedicatedPortal) {
          dedicatedPortal.classList.add('active');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          const studio = document.getElementById('view-product-studio');
          if (studio) {
            studio.classList.add('active');
            if (!STATE.pdpProduct) {
              window.openProductStudio('demo-sprinter-mens-navy');
            }
            setTimeout(() => {
              window.scrollToRepVisitSection();
              if (typeof window.updateRepCustomOptionsPreview === 'function') {
                window.updateRepCustomOptionsPreview();
              }
            }, 100);
          }
        }
      } else {
        const target = document.getElementById(`view-${viewId}`);
        if (target) {
          target.classList.add('active');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      }

      if (viewId === 'ready-to-wear') {
        window.jumpRtwStep(1);
      }

      // Update URL hash without jumping
      if (history.pushState) {
        history.pushState(null, null, `#${viewId}`);
      } else {
        location.hash = `#${viewId}`;
      }
    };

    window.scrollToRepVisitSection = function() {
      const sec = document.getElementById('representative-visit-section');
      if (sec) {
        sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

    window.scrollToPdpBox = function(boxId) {
      const box = document.getElementById(boxId);
      if (box) {
        box.scrollIntoView({ behavior: 'smooth', block: 'start' });
        box.style.transition = 'box-shadow 0.3s ease, border-color 0.3s ease';
        box.style.borderColor = '#00b8a9';
        box.style.boxShadow = '0 0 0 3px rgba(0, 184, 169, 0.2)';
        setTimeout(() => {
          box.style.borderColor = '#e2e8f0';
          box.style.boxShadow = 'none';
        }, 1500);
      }
    };

    window.navigateToCollection = function(seriesOrCat, type = 'series') {
      if (type === 'series') {
        window.navigateToArticle(seriesOrCat);
      } else if (type === 'category') {
        window.navigateToView('category-scrubs');
        const catMap = {
          'caps': 'Surgical Caps (BunFit™)',
          'lab-coat': 'Medical Lab Coats',
          'accessories': 'Clinical Accessories',
          'clogs': 'Clinical Clogs & Footwear'
        };
        const mainHeading = document.getElementById('collection-main-heading');
        if (mainHeading) mainHeading.textContent = catMap[seriesOrCat] || seriesOrCat;
        renderCategoryOnly(seriesOrCat);
      } else if (type === 'feature') {
        window.navigateToView('category-scrubs');
        const mainHeading = document.getElementById('collection-main-heading');
        if (mainHeading) mainHeading.textContent = 'Medical Compression Sleeves';
        renderCategoryOnly('sleeves');
      }
    };

    // ------------------------------------------------------------
    // COMING SOON MODAL CONTROLLER (FOR SELF-SERVICE & BULK ORDER)
    // ------------------------------------------------------------
    window.openComingSoonModal = function(type) {
      const modal = document.getElementById('coming-soon-modal');
      if (!modal) return;

      const iconEl = document.getElementById('coming-soon-icon');
      const badgeEl = document.getElementById('coming-soon-badge');
      const titleEl = document.getElementById('coming-soon-title');
      const descEl = document.getElementById('coming-soon-desc');
      const boxTitleEl = document.getElementById('coming-soon-box-title');
      const boxTextEl = document.getElementById('coming-soon-box-text');

      if (type === 'self-service') {
        if (iconEl) iconEl.textContent = '⚡';
        if (badgeEl) badgeEl.textContent = 'DIGITAL SELF-SERVICE PORTAL';
        if (titleEl) titleEl.textContent = 'Self-Service Portal — Coming Soon';
        if (descEl) descEl.textContent = 'We are actively engineering an express self-ordering digital portal allowing clinicians to manage tailored sizing profiles, view saved measurements, and place rapid 1-click department reorders.';
        if (boxTitleEl) boxTitleEl.textContent = 'Need a Custom Scrub Today?';
        if (boxTextEl) boxTextEl.textContent = 'You can book our in-person Lahore Home Service visit for Rs. 500, or launch our interactive Make Your Own Scrubs bespoke studio right now.';
      } else if (type === 'bulk-order') {
        if (iconEl) iconEl.textContent = '🏥';
        if (badgeEl) badgeEl.textContent = 'INSTITUTIONAL & WARD PROCUREMENT';
        if (titleEl) titleEl.textContent = 'Bulk Order Management — Coming Soon';
        if (descEl) descEl.textContent = 'Our automated procurement system for large-scale hospital orders, medical colleges, and surgical ward scrubs is currently in active development.';
        if (boxTitleEl) boxTitleEl.textContent = 'Placing an Institutional Order Today?';
        if (boxTextEl) boxTextEl.textContent = 'Our institutional concierge team provides tiered corporate volume discounts, custom hospital crest embroidery, and departmental measurement sessions:';
      }

      modal.classList.add('open');
      modal.style.display = 'flex';
    };

    window.closeComingSoonModal = function() {
      const modal = document.getElementById('coming-soon-modal');
      if (modal) {
        modal.classList.remove('open');
        modal.style.display = 'none';
      }
    };

    function handleHashRouting() {
      const rawHash = window.location.hash || '';
      const hash = rawHash.toLowerCase();
      const path = (window.location.pathname || '').toLowerCase();

      if (path.includes('/pages/home-service') || path.includes('/pages/representative-visit')) {
        window.navigateToView('self-service');
      } else if (path.includes('/pages/customizer') || path.includes('/pages/make-your-own-scrubs')) {
        window.navigateToView('ready-to-wear');
      } else if (path.includes('/pages/men')) {
        window.navigateToGender('men', 'all', 'all');
      } else if (path.includes('/pages/women')) {
        window.navigateToGender('women', 'all', 'all');
