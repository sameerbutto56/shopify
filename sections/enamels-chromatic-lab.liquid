      } else {
        if (alertBox) alertBox.style.display = 'none';
        if (lahoreCheck) lahoreCheck.checked = true;
      }
    };

    window.nextSelfServiceStep = function(currentStep) {
      const errBanner = document.getElementById('ss-form-error-banner');
      const showErr = (msg) => {
        if (errBanner) {
          errBanner.textContent = msg;
          errBanner.style.display = 'block';
          errBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          alert(msg);
        }
      };

      if (currentStep === 1) {
        const name = document.getElementById('ss-input-name')?.value.trim();
        const phone = document.getElementById('ss-input-phone')?.value.trim();
        const wa = document.getElementById('ss-input-whatsapp')?.value.trim();

        if (!name) return showErr('Please enter your full name and title.');
        if (!phone || phone.length < 9) return showErr('Please enter a valid mobile number (e.g. 0300-1234567).');
        if (!wa || wa.length < 9) return showErr('Please enter a valid WhatsApp number for visit coordination.');

        window.goToSelfServiceStep(2);
      } else if (currentStep === 2) {
        const city = document.getElementById('ss-input-city')?.value;
        const area = document.getElementById('ss-input-area')?.value;
        const street = document.getElementById('ss-input-street')?.value.trim();
        const isLahoreConfirmed = document.getElementById('ss-confirm-lahore')?.checked;

        if (city === 'Lahore') {
          if (!area) return showErr('Please select your area or sector in Lahore.');
          if (!street) return showErr('Please provide your complete street / hospital address.');
          if (!isLahoreConfirmed) return showErr('Please confirm that the visit location is within Lahore district.');
        } else {
          if (!street) return showErr('Please provide your delivery/clinic address for the expansion waitlist.');
        }

        window.goToSelfServiceStep(3);
      } else if (currentStep === 3) {
        const selectedNeeds = Array.from(document.querySelectorAll('input[name="ss_need"]:checked')).map(el => el.value);
        if (selectedNeeds.length === 0) {
          return showErr('Please select at least one item or service you need assistance with.');
        }

        window.goToSelfServiceStep(4);
      } else if (currentStep === 4) {
        const date = document.getElementById('ss-input-date')?.value;
        const timeslot = document.getElementById('ss-input-timeslot')?.value;

        if (!date) return showErr('Please select your preferred visit date.');
        if (!timeslot) return showErr('Please select your preferred visit time window.');

        renderSelfServiceRecap();
        window.goToSelfServiceStep(5);
      }
    };

    function renderSelfServiceRecap() {
      const recapGrid = document.getElementById('ss-review-recap-grid');
      if (!recapGrid) return;

      const name = document.getElementById('ss-input-name')?.value.trim() || '-';
      const phone = document.getElementById('ss-input-phone')?.value.trim() || '-';
      const wa = document.getElementById('ss-input-whatsapp')?.value.trim() || '-';
      const email = document.getElementById('ss-input-email')?.value.trim() || 'Not supplied';
      const contactMethod = document.querySelector('input[name="ss_contact_method"]:checked')?.value || 'WhatsApp';

      const city = document.getElementById('ss-input-city')?.value || 'Lahore';
      const area = document.getElementById('ss-input-area')?.value || '-';
      const street = document.getElementById('ss-input-street')?.value.trim() || '-';
      const building = document.getElementById('ss-input-building')?.value.trim() || 'N/A';
      const landmark = document.getElementById('ss-input-landmark')?.value.trim() || 'N/A';

      const selectedNeeds = Array.from(document.querySelectorAll('input[name="ss_need"]:checked')).map(el => el.value);
      const series = document.getElementById('ss-input-series')?.value || 'Sprinter Series';
      const qty = document.getElementById('ss-input-qty')?.value || '1-2 Sets';
      const notes = document.getElementById('ss-input-notes')?.value.trim() || 'None';

      const date = document.getElementById('ss-input-date')?.value || '-';
      const timeslot = document.getElementById('ss-input-timeslot')?.value || '-';
      const setting = document.querySelector('input[name="ss_setting"]:checked')?.value || 'Hospital Ward';

      const isWaitlist = city !== 'Lahore';

      recapGrid.innerHTML = `
        <div class="self-service-recap-box">
          <div class="self-service-recap-title">👤 Contact Information</div>
          <div class="self-service-recap-val">
            <strong>${escapeHtml(name)}</strong><br>
            Mobile: ${escapeHtml(phone)} | WhatsApp: ${escapeHtml(wa)}<br>
            Email: ${escapeHtml(email)}<br>
            Preferred Channel: <span style="color: #00b8a9; font-weight: 600;">${escapeHtml(contactMethod)}</span>
          </div>
        </div>

        <div class="self-service-recap-box">
          <div class="self-service-recap-title">📍 Service Location (${isWaitlist ? 'Waitlist' : 'Lahore'})</div>
          <div class="self-service-recap-val">
            <strong>${escapeHtml(city)}</strong> — ${escapeHtml(area)}<br>
            Street: ${escapeHtml(street)}<br>
            Facility: ${escapeHtml(building)} | Instructions: ${escapeHtml(landmark)}
          </div>
        </div>

        <div class="self-service-recap-box">
          <div class="self-service-recap-title">🩺 Requirements & Preferences</div>
          <div class="self-service-recap-val">
            Services: <strong>${selectedNeeds.map(n => escapeHtml(n)).join(', ')}</strong><br>
            Preferred Series: ${escapeHtml(series)} | Est. Quantity: ${escapeHtml(qty)}<br>
            Notes: <em>${escapeHtml(notes)}</em>
          </div>
        </div>

        <div class="self-service-recap-box">
          <div class="self-service-recap-title">📅 Preferred Appointment Window</div>
          <div class="self-service-recap-val">
            Date: <strong>${escapeHtml(date)}</strong><br>
            Window: ${escapeHtml(timeslot)}<br>
            Setting: ${escapeHtml(setting)}<br>
            <span style="font-size: 11px; color: #64748b;">(Preference subject to confirmation by representative)</span>
          </div>
        </div>
      `;
    }

    function escapeHtml(text) {
      if (!text) return '';
      return String(text).replace(/[&<>"']/g, function(m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
      });
    }

    window.submitSelfServiceBooking = function() {
      const termsAccepted = document.getElementById('ss-confirm-terms')?.checked;
      if (!termsAccepted) {
        const errBanner = document.getElementById('ss-form-error-banner');
        if (errBanner) {
          errBanner.textContent = 'Please check the acknowledgement box before submitting.';
          errBanner.style.display = 'block';
        } else {
          alert('Please check the acknowledgement box before submitting.');
        }
        return;
      }

      const submitBtn = document.getElementById('ss-submit-booking-btn');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '⏳ Submitting Request...';
      }

      setTimeout(() => {
        const name = document.getElementById('ss-input-name')?.value.trim() || 'Valued Customer';
        const phone = document.getElementById('ss-input-phone')?.value.trim() || '';
        const wa = document.getElementById('ss-input-whatsapp')?.value.trim() || phone;
        const email = document.getElementById('ss-input-email')?.value.trim() || '';
        const contactMethod = document.querySelector('input[name="ss_contact_method"]:checked')?.value || 'WhatsApp';

        const city = document.getElementById('ss-input-city')?.value || 'Lahore';
        const area = document.getElementById('ss-input-area')?.value || 'Lahore Area';
        const street = document.getElementById('ss-input-street')?.value.trim() || '';
        const building = document.getElementById('ss-input-building')?.value.trim() || '';
        const landmark = document.getElementById('ss-input-landmark')?.value.trim() || '';
        const isLahoreConfirmed = document.getElementById('ss-confirm-lahore')?.checked || false;

        const selectedNeeds = Array.from(document.querySelectorAll('input[name="ss_need"]:checked')).map(el => el.value);
        const series = document.getElementById('ss-input-series')?.value || 'Sprinter Series';
        const qty = document.getElementById('ss-input-qty')?.value || '1-2 Sets';
        const notes = document.getElementById('ss-input-notes')?.value.trim() || '';

        const date = document.getElementById('ss-input-date')?.value || new Date().toISOString().split('T')[0];
        const timeslot = document.getElementById('ss-input-timeslot')?.value || 'Afternoon (2:00 PM – 5:00 PM)';
        const setting = document.querySelector('input[name="ss_setting"]:checked')?.value || 'Hospital Ward / Duty Room';

        const isWaitlist = city !== 'Lahore';
        const bookingId = 'ENM-VISIT-2026-' + Math.floor(1000 + Math.random() * 9000);
        const nowIso = new Date().toISOString();

        const newBooking = {
          id: bookingId,
          createdAt: nowIso,
          updatedAt: nowIso,
          fullName: name,
          phone: phone,
          whatsapp: wa,
          email: email,
          contactMethod: contactMethod,
          city: city,
          area: area,
          street: street,
          building: building,
          landmark: landmark,
          isLahoreConfirmed: isLahoreConfirmed,
          isWaitlist: isWaitlist,
          selectedNeeds: selectedNeeds,
          preferredSeries: series,
          estimatedQty: qty,
          specialNotes: notes,
          preferredDate: date,
          preferredTimeWindow: timeslot,
          setting: setting,
          serviceFee: 500,
          feeAdjustableThreshold: 10000,
          feePolicy: '100% adjustable against qualifying uniform orders over Rs. 10,000.',
          status: isWaitlist ? 'New Request (Waitlist)' : 'New Request',
          assignedRep: '',
          shopifyOrderId: '',
          consentTerms: true,
          adminNotes: [],
          statusHistory: [
            {
              timestamp: nowIso,
              fromStatus: 'None',
              toStatus: isWaitlist ? 'New Request (Waitlist)' : 'New Request',
              note: isWaitlist ? 'Submitted for expansion waitlist outside Lahore' : 'Submitted by customer for Lahore concierge visit',
              updatedBy: 'Customer (Online)'
            }
          ]
        };

        const existing = getStoredBookings();
        existing.unshift(newBooking);
        saveStoredBookings(existing);

        // Display Success View
        const bookingCard = document.getElementById('self-service-booking-card');
        const successView = document.getElementById('self-service-success-view');
        if (bookingCard) bookingCard.style.display = 'none';
        if (successView) successView.style.display = 'block';

        const refEl = document.getElementById('ss-success-ref-id');
        const cityEl = document.getElementById('ss-success-city-area');
        const phoneEl = document.getElementById('ss-success-contact-phone');
        const waLink = document.getElementById('ss-whatsapp-direct-link');

        if (refEl) refEl.textContent = bookingId;
        if (cityEl) cityEl.textContent = `${city} (${area})`;
        if (phoneEl) phoneEl.textContent = `${wa} (${name})`;
        if (waLink) {
          const waMsg = encodeURIComponent(`Hello Enamels Concierge! I have submitted a Self-Service visit request.\nReference ID: ${bookingId}\nName: ${name}\nLocation: ${city} (${area})\nPreferred Date: ${date} (${timeslot})`);
          waLink.href = `https://wa.me/923011331133?text=${waMsg}`;
        }

        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '📩 Submit Visit Request';
        }

        window.scrollTo({ top: 0, behavior: 'smooth' });
      }, 400);
    };

    window.resetSelfServiceForm = function() {
      const formIds = ['ss-input-name', 'ss-input-phone', 'ss-input-whatsapp', 'ss-input-email', 'ss-input-street', 'ss-input-building', 'ss-input-landmark', 'ss-input-notes', 'ss-input-date'];
      formIds.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = '';
      });

      const sameWa = document.getElementById('ss-same-whatsapp');
      if (sameWa) sameWa.checked = false;

      const citySelect = document.getElementById('ss-input-city');
      if (citySelect) {
        citySelect.value = 'Lahore';
        window.handleSelfServiceCityChange('Lahore');
      }

      const bookingCard = document.getElementById('self-service-booking-card');
      const successView = document.getElementById('self-service-success-view');
      if (bookingCard) bookingCard.style.display = 'block';
      if (successView) successView.style.display = 'none';

      window.goToSelfServiceStep(1);
    };

    // ------------------------------------------------------------
    // ADMIN / REPRESENTATIVE PORTAL WORKFLOW
    // ------------------------------------------------------------
    window.openSelfServiceAdminModal = function() {
      const modal = document.getElementById('self-service-admin-modal');
      if (modal) {
        modal.style.display = 'flex';
        window.renderAdminBookingList();
      }
    };

    window.closeSelfServiceAdminModal = function() {
      const modal = document.getElementById('self-service-admin-modal');
      if (modal) modal.style.display = 'none';
    };

    window.renderAdminBookingList = function() {
      const tbody = document.getElementById('ss-admin-bookings-tbody');
      const countEl = document.getElementById('ss-admin-bookings-count');
      const searchInput = document.getElementById('ss-admin-search-input')?.value.toLowerCase().trim() || '';
      const statusFilter = document.getElementById('ss-admin-status-filter')?.value || 'all';

      if (!tbody) return;

      const bookings = getStoredBookings();
      const filtered = bookings.filter(b => {
        if (statusFilter !== 'all' && b.status !== statusFilter) return false;
        if (!searchInput) return true;
        const searchStr = `${b.id} ${b.fullName} ${b.phone} ${b.whatsapp} ${b.area} ${b.city} ${b.shopifyOrderId || ''}`.toLowerCase();
        return searchStr.includes(searchInput);
      });

      if (countEl) countEl.textContent = `${filtered.length} Requests`;

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; padding: 24px; color: #64748b;">No matching representative visit requests found.</td></tr>`;
        return;
      }

      const getStatusClass = (status) => {
        switch (status) {
          case 'New Request': return 'status-new';
          case 'Under Review': return 'status-review';
          case 'Contact Required': return 'status-contact';
          case 'Visit Proposed': return 'status-proposed';
          case 'Confirmed': return 'status-confirmed';
          case 'Representative Assigned': return 'status-assigned';
          case 'Visit Completed': return 'status-completed';
          case 'Order Created': return 'status-order-created';
          case 'Cancelled': return 'status-cancelled';
          default: return 'status-review';
        }
      };

      tbody.innerHTML = filtered.map(b => {
        const formattedDate = new Date(b.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        const repName = b.assignedRep ? escapeHtml(b.assignedRep.split(' ')[0] + ' ' + (b.assignedRep.split(' ')[1] || '')) : '<em style="color:#94a3b8;">Unassigned</em>';
        const needsSummary = (b.selectedNeeds || []).slice(0, 2).map(n => `<span style="font-size:10px; background:#f1f5f9; padding:1px 6px; border-radius:3px; margin-right:3px;">${escapeHtml(n)}</span>`).join('');
        const extraNeeds = (b.selectedNeeds || []).length > 2 ? `<span style="font-size:10px; color:#64748b;">+${(b.selectedNeeds || []).length - 2}</span>` : '';

        return `
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="font-weight: 700; color: #102a43; font-family: monospace;">
              <a href="#" onclick="window.openAdminBookingDetail('${b.id}'); return false;" style="color: #008779; text-decoration: underline;">
                ${escapeHtml(b.id)}
              </a>
            </td>
            <td style="color: #64748b; white-space: nowrap;">${formattedDate}</td>
            <td>
              <strong style="color: #102a43;">${escapeHtml(b.fullName)}</strong><br>
              <span style="color: #64748b; font-size: 11px;">${escapeHtml(b.phone)}</span>
            </td>
            <td>
              <span style="font-weight: 600; color: #102a43;">${escapeHtml(b.city)}</span><br>
              <span style="color: #64748b; font-size: 11px;">${escapeHtml(b.area || '-')}</span>
            </td>
            <td>${needsSummary}${extraNeeds}</td>
            <td>
              <span class="self-service-status-pill ${getStatusClass(b.status)}">
                ${escapeHtml(b.status)}
              </span>
            </td>
            <td>${repName}</td>
            <td style="text-align: right;">
              <button type="button" class="gender-pill-btn" onclick="window.openAdminBookingDetail('${b.id}')" style="padding: 4px 10px; font-size: 11px;">
                Manage
              </button>
            </td>
          </tr>
        `;
      }).join('');
    };

    window.openAdminBookingDetail = function(bookingId) {
      const bookings = getStoredBookings();
      const booking = bookings.find(b => b.id === bookingId);
      if (!booking) return;

      currentAdminDetailBookingId = bookingId;
      const pane = document.getElementById('ss-admin-detail-pane');
      if (!pane) return;
      pane.style.display = 'block';

      const titleEl = document.getElementById('ss-admin-detail-title');
      const custEl = document.getElementById('ss-admin-detail-customer');
      const addrEl = document.getElementById('ss-admin-detail-address');
      const needsEl = document.getElementById('ss-admin-detail-needs');
      const feeEl = document.getElementById('ss-admin-detail-fee');
      const statusSelect = document.getElementById('ss-admin-detail-status-select');
      const repSelect = document.getElementById('ss-admin-detail-rep-select');
      const orderIdInput = document.getElementById('ss-admin-detail-order-id');

      if (titleEl) titleEl.textContent = `Request Detail: ${booking.id} (${booking.status})`;
      if (custEl) custEl.innerHTML = `<strong>${escapeHtml(booking.fullName)}</strong><br>Phone: ${escapeHtml(booking.phone)} | WA: ${escapeHtml(booking.whatsapp)}<br>Email: ${escapeHtml(booking.email || 'None')}<br>Preferred Channel: ${escapeHtml(booking.contactMethod)}`;
      if (addrEl) addrEl.innerHTML = `<strong>${escapeHtml(booking.city)}</strong> — ${escapeHtml(booking.area)}<br>${escapeHtml(booking.street)}<br>Facility: ${escapeHtml(booking.building || 'N/A')}<br>Note: ${escapeHtml(booking.landmark || 'N/A')}`;
      if (needsEl) needsEl.innerHTML = `Items: <strong>${(booking.selectedNeeds || []).map(n => escapeHtml(n)).join(', ')}</strong><br>Preferred Series: ${escapeHtml(booking.preferredSeries)} | Qty: ${escapeHtml(booking.estimatedQty)}<br>Preferred Date: <strong>${escapeHtml(booking.preferredDate)} (${escapeHtml(booking.preferredTimeWindow)})</strong><br>Customer Note: <em>${escapeHtml(booking.specialNotes || 'None')}</em>`;
      if (feeEl) feeEl.innerHTML = `Service Fee: <strong>Rs. ${booking.serviceFee}</strong> (Adjustable &gt; Rs. ${booking.feeAdjustableThreshold})<br>Payment: Payable during visit or Bank Transfer<br>Shopify Order: <strong>${booking.shopifyOrderId ? escapeHtml(booking.shopifyOrderId) : '<span style="color:#64748b;">Not yet linked</span>'}</strong>`;

      if (statusSelect) statusSelect.value = booking.status || 'New Request';
      if (repSelect) repSelect.value = booking.assignedRep || '';
      if (orderIdInput) orderIdInput.value = booking.shopifyOrderId || '';

      renderAdminDetailLogs(booking);
      pane.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    function renderAdminDetailLogs(booking) {
      const historyLog = document.getElementById('ss-admin-notes-history-log');
      if (!historyLog) return;

      const notesHtml = (booking.adminNotes || []).map(n => `
        <div style="margin-bottom: 4px; padding-bottom: 4px; border-bottom: 1px dashed #e2e8f0;">
          <strong style="color: #102a43;">[Note - ${new Date(n.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}]</strong>
          <span>${escapeHtml(n.note)}</span>
          <span style="color: #64748b; font-size: 10px;">(${escapeHtml(n.author)})</span>
        </div>
      `).join('');

      const historyHtml = (booking.statusHistory || []).map(h => `
        <div style="margin-bottom: 3px; color: #475569;">
          <span style="color: #0369a1; font-weight: 600;">[Lifecycle: ${escapeHtml(h.toStatus)}]</span>
          <span>${escapeHtml(h.note)}</span>
          <span style="color: #94a3b8; font-size: 10px;">— ${new Date(h.timestamp).toLocaleDateString()} (${escapeHtml(h.updatedBy)})</span>
        </div>
      `).join('');

      historyLog.innerHTML = notesHtml + historyHtml || '<em>No notes or history recorded yet.</em>';
    }

    window.addAdminBookingNote = function() {
      if (!currentAdminDetailBookingId) return;
      const noteInput = document.getElementById('ss-admin-new-note');
      const text = noteInput?.value.trim();
      if (!text) return;

      const bookings = getStoredBookings();
      const booking = bookings.find(b => b.id === currentAdminDetailBookingId);
      if (!booking) return;

      if (!booking.adminNotes) booking.adminNotes = [];
      booking.adminNotes.unshift({
        timestamp: new Date().toISOString(),
        note: text,
        author: 'Concierge Staff'
      });
      booking.updatedAt = new Date().toISOString();

      saveStoredBookings(bookings);
      if (noteInput) noteInput.value = '';
      renderAdminDetailLogs(booking);
    };

    window.saveAdminBookingChanges = function() {
      if (!currentAdminDetailBookingId) return;
      const statusSelect = document.getElementById('ss-admin-detail-status-select');
      const repSelect = document.getElementById('ss-admin-detail-rep-select');
      const orderIdInput = document.getElementById('ss-admin-detail-order-id');

      const newStatus = statusSelect?.value || 'New Request';
      const newRep = repSelect?.value || '';
      const newOrderId = orderIdInput?.value.trim() || '';

      const bookings = getStoredBookings();
      const booking = bookings.find(b => b.id === currentAdminDetailBookingId);
      if (!booking) return;

      const nowIso = new Date().toISOString();
      if (booking.status !== newStatus) {
        if (!booking.statusHistory) booking.statusHistory = [];
        booking.statusHistory.unshift({
          timestamp: nowIso,
          fromStatus: booking.status,
          toStatus: newStatus,
          note: `Status changed from ${booking.status} to ${newStatus}`,
          updatedBy: 'Admin Representative'
        });
        booking.status = newStatus;
      }

      booking.assignedRep = newRep;
      booking.shopifyOrderId = newOrderId;
      booking.updatedAt = nowIso;

      saveStoredBookings(bookings);
      window.renderAdminBookingList();
      window.openAdminBookingDetail(currentAdminDetailBookingId);
      alert(`Booking ${currentAdminDetailBookingId} updated successfully.`);
    };

    window.createOrderFromBooking = function() {
      if (!currentAdminDetailBookingId) return;
      const bookings = getStoredBookings();
      const booking = bookings.find(b => b.id === currentAdminDetailBookingId);
      if (!booking) return;

      // Close modal and open Product Studio
      window.closeSelfServiceAdminModal();
      window.openProductStudio('sprinter-athletic-set');

      alert(`Product Studio opened for ${booking.fullName}.\n\nRequirements:\n- Preferred Series: ${booking.preferredSeries}\n- Needs: ${(booking.selectedNeeds || []).join(', ')}\n- Notes: ${booking.specialNotes || 'Standard'}\n\nRepresentative may now choose colours, confirm sizes, alterations and add to cart.`);
    };

  })();
</script>

