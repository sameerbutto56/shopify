    function safeUpdateUrlHash(hash, replace = false) {
      try {
        if (window.Shopify && window.Shopify.designMode) {
          return;
        }
        if (replace && window.history && window.history.replaceState) {
          window.history.replaceState(null, '', hash);
        } else if (window.history && window.history.pushState) {
          window.history.pushState(null, '', hash);
        } else if (typeof window !== 'undefined' && window.location) {
          window.location.hash = hash;
        }
      } catch (e) {
        console.warn('URL hash update bypassed:', e);
      }
    }
    window.safeUpdateUrlHash = safeUpdateUrlHash;

    window.navigateToView = function(viewId) {
      if (typeof document !== 'undefined' && document.body && document.body.dataset) {
        document.body.dataset.activeView = viewId;
      }
      document.querySelectorAll('.chroma-view-panel').forEach(p => p.classList.remove('active'));

      if (viewId === 'home') {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        safeUpdateUrlHash('#home');
        return;
      }

      if (viewId === 'self-service') {
        const dedicatedPortal = document.getElementById('view-self-service');
        if (dedicatedPortal) {
          dedicatedPortal.classList.add('active');
          window.scrollTo({ top: 0, behavior: 'smooth' });
          if (typeof window.initHomeServicePortal === 'function') {
            window.initHomeServicePortal();
          }
        } else {
          const studio = document.getElementById('view-product-studio');
          if (studio) {
            studio.classList.add('active');
            if (!STATE.pdpProduct) {
              const catalogue = window.getStorefrontCatalogue();
              if (catalogue && catalogue.length) {
                window.openProductStudio(catalogue[0].id);
