    window.submitCodOrder = async function() {
      withCartDebounce(async () => {
        const name = document.getElementById('cod-order-name')?.value;
        const phone = document.getElementById('cod-order-phone')?.value;
        const city = document.getElementById('cod-order-city')?.value;
        const addr = document.getElementById('cod-order-address')?.value;
        const notes = document.getElementById('cod-order-notes')?.value || '';

        if (!name || !phone || !addr || !city) {
          alert('Please enter your Full Name, Phone / WhatsApp, City, and Delivery Address for Cash on Delivery.');
          return;
        }

        const refNumber = `ENM-COD-${Math.floor(10000 + Math.random() * 90000)}`;

        try {
          const cart = getStoredCart();
          if (cart && cart.length) {
            await fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
            const fallbackVariantId = window.ShopifyLiveProducts?.[0]?.variants?.[0]?.id || null;
            const itemsPayload = cart.map(item => {
              const variantId = item.variantId || item.variant_id || fallbackVariantId;
              if (!variantId) return null;
              return {
                id: variantId,
                quantity: item.quantity || 1,
                properties: {
                  ...(item.properties || {}),
                  'Payment Method': 'Cash on Delivery (COD)',
                  'Order Reference': refNumber,
                  'Customer Name': name,
                  'Customer Phone': phone,
                  'Delivery City': city
                }
              };
            }).filter(Boolean);
            if (itemsPayload.length) {
              await fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items: itemsPayload })
              });
            }

            const subtotal = cart.reduce((sum, it) => sum + ((it.unitPrice || it.price || 0) * (it.quantity || 1)), 0);
            const comp = typeof window.analyzeCartComposition === 'function' ? window.analyzeCartComposition(cart) : { Q: cart.length, A: 0 };
            const shipResult = typeof window.calculateShippingCharges === 'function'
              ? window.calculateShippingCharges('Pakistan', subtotal, cart)
              : { shippingFee: subtotal > 7000 ? 0 : 250, formulaText: subtotal > 7000 ? 'Free Nationwide Delivery (Order > PKR 7,000)' : 'Standard Courier (PKR 250)' };

            await fetch('/cart/update.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                note: `COD Order ${refNumber} - ${name} (${phone}) - ${city} - Address: ${addr} ${notes ? '(' + notes + ')' : ''}`,
                attributes: {
                  'Enamels Reference': refNumber,
                  'Customer Name': name,
                  'Customer Phone': phone,
                  'Delivery City': city,
                  'Delivery Address': addr,
                  'Delivery Destination': 'Pakistan',
                  'Delivery Country Code': 'PK',
                  'Payment Method': 'Cash on Delivery (COD)',
                  'Payment Status': 'Pending Cash Collection on Delivery (Unpaid)',
                  'Scrub Units (Q)': comp.Q,
                  'Chargeable Add-on Units (A)': comp.A,
                  'Estimated Shipping (PKR)': shipResult.shippingFee,
                  'Shipping Rate Calculation': shipResult.formulaText
                }
              })
            });
          }
        } catch (e) {
          console.warn('COD order cart sync error:', e);
        }

        showOrderConfirmation(refNumber, 'Pending Cash Collection on Delivery (Unpaid)', 'Cash on Delivery (COD - TCS / Trax)');
      });
    };

