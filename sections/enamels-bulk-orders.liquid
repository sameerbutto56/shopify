{% comment %}
  Enamels Dedicated 5-Step Institutional Bulk Orders Section
{% endcomment %}

{% render "enamels-bulk-orders-workflow" %}

{% schema %}
{
  "name": "Enamels Bulk Orders Form",
  "class": "enamels-bulk-orders-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Page Header & Messaging"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Institutional & Hospital Bulk Orders"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 20,
      "max": 52,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size (Desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size (Mobile)",
      "default": 24
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Supporting Subtitle",
      "default": "Equip your medical team, clinic, or hospital department with Enamels premium medical wear. Minimum order volume: 10 units."
    },
    {
      "type": "range",
      "id": "subtitle_size_desktop",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Font Size (Desktop)",
      "default": 15
    },
    {
      "type": "range",
      "id": "subtitle_size_mobile",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Font Size (Mobile)",
      "default": 13
    },
    {
      "type": "number",
      "id": "min_order_quantity",
      "label": "Minimum Bulk Order Quantity",
      "default": 10
    },
    {
      "type": "header",
      "content": "Sizing & Layout"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 800,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Max Container Width",
      "default": 1020
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Card Corner Radius",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Enamels Bulk Orders Form"
    }
  ]
}
{% endschema %}
