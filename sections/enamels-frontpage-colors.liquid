{% comment %}
  Enamels Frontpage Colors Section — Rebuilt & Enlarged with Expandable View All
  Features:
  - Genuine Shopify Collection Navigation (opens assigned collection page directly)
  - Safe fallbacks to prevent 404 pages if collection is not assigned
  - In Theme Editor (design_mode), flags swatches missing collection assignment
  - Noticeably larger circular color swatches with rich fabric textures
  - Horizontal scrolling carousel with desktop arrows & mobile touch swipe
  - Expandable "View All" / "Show Less" grid revealing all configured hospital shades
  - Full Theme Editor customization (colors, fonts, sizes, padding, alignment)
{% endcomment %}

{%- liquid
  # Robust Numerical Sorting of Color Blocks via Admin display_order
  assign sort_keys = ''
  for block in section.blocks
    assign ord = block.settings.display_order
    if ord == blank or ord == null
      assign ord = forloop.index
    endif
    assign ord_num = ord | plus: 0
    if ord_num <= 0
      assign ord_num = 9999 | plus: forloop.index
    endif
    assign ord_padded = ord_num | prepend: '000000' | slice: -6, 6
    assign idx_padded = forloop.index | prepend: '000000' | slice: -6, 6
    assign item_key = ord_padded | append: '_' | append: idx_padded | append: ':::' | append: block.id
    if sort_keys == ''
      assign sort_keys = item_key
    else
      assign sort_keys = sort_keys | append: '|||' | append: item_key
    endif
  endfor
  assign sorted_color_items = sort_keys | split: '|||' | sort

  assign sec_bg = section.settings.section_bg | default: '#ffffff'
  assign title_text = section.settings.title | default: 'Shop by colors'
  assign subtitle_text = section.settings.subtitle
  assign title_color = section.settings.title_color | default: '#102a43'
  assign subtitle_color = section.settings.subtitle_color | default: '#64748b'
  assign text_align = section.settings.text_alignment | default: 'left'
  assign p_top = section.settings.padding_top | default: 16
  assign p_bottom = section.settings.padding_bottom | default: 32
-%}

<section
  class="enamels-colors-section"
  id="enamels-colors-{{ section.id }}"
  data-section-id="{{ section.id }}"
  style="background-color: {{ sec_bg }}; padding-top: {{ p_top }}px; padding-bottom: {{ p_bottom }}px;"
>
  <div class="enamels-colors__container">
    <!-- Header -->
    <div class="enamels-section-head" style="text-align: {{ text_align }};">
      <div class="enamels-section-head__title-group">
        {% if title_text != blank %}
          <h2 class="enamels-section-head__title" style="color: {{ title_color }};">
            {{ title_text | escape }}
          </h2>
        {% endif %}
        {% if subtitle_text != blank %}
          <p class="enamels-section-head__subtitle" style="color: {{ subtitle_color }};">
            {{ subtitle_text | escape }}
          </p>
        {% endif %}
      </div>

      <!-- View All / Show Less Toggle Button -->
      {% if section.settings.enable_view_all and section.blocks.size > 0 %}
        <button
          type="button"
          class="enamels-cat-toggle-btn enamels-color-toggle-btn"
          aria-expanded="false"
          aria-controls="enamels-colors-drawer-{{ section.id }}"
          data-color-toggle
        >
          <span
            class="enamels-cat-toggle-btn__label"
            data-label-collapsed="{{ section.settings.view_all_label | default: 'View all' | escape }}"
            data-label-expanded="{{ section.settings.show_less_label | default: 'Show less' | escape }}"
          >
            {{ section.settings.view_all_label | default: 'View all' }}
          </span>
          <span class="enamels-cat-toggle-btn__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </button>
      {% endif %}
    </div>

    <!-- 1. Initial Horizontal Carousel with Large Swatches -->
    <div class="enamels-color-carousel-wrap" data-color-carousel>
      <button
        type="button"
        class="enamels-cat-arrow enamels-cat-arrow--left"
        aria-label="Previous colors"
        data-color-prev
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="enamels-color-track" data-color-track tabindex="0" role="region" aria-label="Color carousel">
        {% for set_idx in (1..4) %}
          {% assign is_primary = false %}
          {% if set_idx == 2 %}
            {% assign is_primary = true %}
          {% endif %}
          {% for item_key in sorted_color_items %}
            {% assign target_block_id = item_key | split: ':::' | last %}
            {% for block in section.blocks %}
              {% if block.id == target_block_id %}
                {%- liquid
                  assign col = block.settings.collection
                  assign swatch_title = block.settings.title
                  if swatch_title == blank and col != blank
                    assign swatch_title = col.title
                  endif
                  if swatch_title == blank
                    assign swatch_title = 'Clinical Color'
                  endif

                  assign swatch_img = block.settings.image
                  assign swatch_fallback = block.settings.fallback_asset

                  # Robust Collection Navigation Resolution:
                  # 1. Assigned Shopify collection picker
                  # 2. Custom valid link (excluding deprecated /collections/scrubs)
                  # 3. Collection matching handle
                  # 4. Safe fallback to /collections/all with color filter (never 404)
                  assign swatch_link = ''
                  assign has_assigned_col = false

                  if col != blank and col.url != blank
                    assign swatch_link = col.url
                    assign has_assigned_col = true
                  elsif block.settings.link != blank and block.settings.link != '/collections/scrubs'
                    assign swatch_link = block.settings.link
                    assign has_assigned_col = true
                  else
                    assign col_slug = swatch_title | handleize
                    if collections[col_slug] != blank and collections[col_slug].url != blank
                      assign swatch_link = collections[col_slug].url
                      assign has_assigned_col = true
                    else
                      assign swatch_link = routes.all_products_collection_url | append: '?filter.v.option.color=' | append: swatch_title
                    endif
                  endif
                -%}

                <a
                  href="{{ swatch_link }}"
                  class="enamels-swatch-card enamels-swatch-card--carousel"
                  data-block-id="{{ block.id }}"
                  data-set-index="{{ set_idx }}"
                  {% if is_primary %}{{ block.shopify_attributes }}{% endif %}
                >
                  <div
                    class="enamels-swatch-circle"
                    style="{% if block.settings.color_code != blank %}background-color: {{ block.settings.color_code }};{% endif %}"
                  >
                    {% if swatch_img != blank %}
                      <img
                        src="{{ swatch_img | image_url: width: 200 }}"
                        alt="{{ swatch_title | escape }}"
                        loading="lazy"
                        width="90"
                        height="90"
                      >
                    {% elsif swatch_fallback != blank %}
                      <img
                        src="{{ swatch_fallback | asset_url }}"
                        alt="{{ swatch_title | escape }}"
                        loading="lazy"
                        width="90"
                        height="90"
                      >
                    {% endif %}
                  </div>
                  <span class="enamels-swatch-name">{{ swatch_title }}</span>
                  {% if request.design_mode and has_assigned_col == false and is_primary %}
                    <span class="enamels-unassigned-col-pill" title="Assign a Shopify Collection in the Theme Editor">⚠️ Pick Collection</span>
                  {% endif %}
                </a>
                {% break %}
              {% endif %}
            {% endfor %}
          {% endfor %}
        {% endfor %}
      </div>

      <button
        type="button"
        class="enamels-cat-arrow enamels-cat-arrow--right"
        aria-label="Next colors"
        data-color-next
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <!-- 2. Expandable Full Color Palette Drawer -->
    <div
      id="enamels-colors-drawer-{{ section.id }}"
      class="enamels-cats-drawer enamels-colors-drawer"
      data-color-drawer
      aria-hidden="true"
    >
      <div class="enamels-cats-drawer__inner">
        <div class="enamels-cats-drawer__header">
          <span class="enamels-cats-drawer__count">{{ section.blocks.size }} Hospital Shades Available</span>
          <span class="enamels-cats-drawer__hint">Select any clinical color to view matching scrubs</span>
        </div>

        <div class="enamels-colors-grid enamels-colors-grid--desktop-{{ section.settings.grid_cols_desktop | default: 8 }} enamels-colors-grid--mobile-{{ section.settings.grid_cols_mobile | default: 4 }}">
          {% for item_key in sorted_color_items %}
            {% assign target_block_id = item_key | split: ':::' | last %}
            {% for block in section.blocks %}
              {% if block.id == target_block_id %}
                {%- liquid
                  assign col = block.settings.collection
                  assign swatch_title = block.settings.title
                  if swatch_title == blank and col != blank
                    assign swatch_title = col.title
                  endif
                  if swatch_title == blank
                    assign swatch_title = 'Clinical Color'
                  endif

                  assign swatch_img = block.settings.image
                  assign swatch_fallback = block.settings.fallback_asset

                  assign swatch_link = ''
                  assign has_assigned_col = false

                  if col != blank and col.url != blank
                    assign swatch_link = col.url
                    assign has_assigned_col = true
                  elsif block.settings.link != blank and block.settings.link != '/collections/scrubs'
                    assign swatch_link = block.settings.link
                    assign has_assigned_col = true
                  else
                    assign col_slug = swatch_title | handleize
                    if collections[col_slug] != blank and collections[col_slug].url != blank
                      assign swatch_link = collections[col_slug].url
                      assign has_assigned_col = true
                    else
                      assign swatch_link = routes.all_products_collection_url | append: '?filter.v.option.color=' | append: swatch_title
                    endif
                  endif
                -%}

                <a
                  href="{{ swatch_link }}"
                  class="enamels-swatch-card enamels-swatch-card--grid"
                  style="--stagger-index: {{ forloop.index }};"
                  {{ block.shopify_attributes }}
                >
                  <div
                    class="enamels-swatch-circle"
                    style="{% if block.settings.color_code != blank %}background-color: {{ block.settings.color_code }};{% endif %}"
                  >
                    {% if swatch_img != blank %}
                      <img
                        src="{{ swatch_img | image_url: width: 200 }}"
                        alt="{{ swatch_title | escape }}"
                        loading="lazy"
                        width="90"
                        height="90"
                      >
                    {% elsif swatch_fallback != blank %}
                      <img
                        src="{{ swatch_fallback | asset_url }}"
                        alt="{{ swatch_title | escape }}"
                        loading="lazy"
                        width="90"
                        height="90"
                      >
                    {% endif %}
                  </div>
                  <span class="enamels-swatch-name">{{ swatch_title }}</span>
                  {% if request.design_mode and has_assigned_col == false %}
                    <span class="enamels-unassigned-col-pill" title="Assign a Shopify Collection in the Theme Editor">⚠️ Pick Collection</span>
                  {% endif %}
                </a>
                {% break %}
              {% endif %}
            {% endfor %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .enamels-colors-section {
    position: relative;
    overflow: hidden;
  }

  .enamels-colors__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 16px;
  }

  @media (min-width: 768px) {
    .enamels-colors__container {
      padding: 0 32px;
    }
  }

  .enamels-section-head__title {
    font-size: {{ section.settings.title_size_desktop | default: 26 }}px;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 4px;
  }

  @media (max-width: 640px) {
    .enamels-section-head__title {
      font-size: {{ section.settings.title_size_mobile | default: 20 }}px;
    }
  }

  .enamels-color-carousel-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .enamels-color-carousel-wrap .enamels-cat-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.12);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
    color: #111111;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 8;
    padding: 0;
    transition: background-color 0.2s ease, transform 0.2s ease, opacity 0.2s ease, box-shadow 0.2s ease;
    opacity: 1;
    outline: none;
  }

  .enamels-color-carousel-wrap .enamels-cat-arrow:hover {
    background-color: #f7f7f7;
    opacity: 1;
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.16);
  }

  .enamels-color-carousel-wrap .enamels-cat-arrow--left {
    left: -14px;
  }

  .enamels-color-carousel-wrap .enamels-cat-arrow--right {
    right: -14px;
  }

  @media (max-width: 768px) {
    .enamels-color-carousel-wrap .enamels-cat-arrow {
      display: none;
    }
  }

  .enamels-color-track {
    display: flex;
    gap: {{ section.settings.card_gap_desktop | default: 20 }}px;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding: 12px 4px;
    width: 100%;
    cursor: grab;
    touch-action: pan-x pan-y;
  }

  .enamels-color-track::-webkit-scrollbar {
    display: none;
  }

  .enamels-swatch-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .enamels-swatch-card:hover {
    transform: translateY(-4px);
  }

  .enamels-swatch-circle {
    width: {{ section.settings.circle_size_desktop | default: 86 }}px;
    height: {{ section.settings.circle_size_desktop | default: 86 }}px;
    border-radius: 50%;
    overflow: hidden;
    border: 2.5px solid #ffffff;
    box-shadow: 0 4px 14px rgba(16, 42, 67, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e2e8f0;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .enamels-swatch-card:hover .enamels-swatch-circle {
    border-color: #008779;
    box-shadow: 0 6px 20px rgba(0, 135, 121, 0.25);
  }

  .enamels-swatch-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .enamels-swatch-name {
    margin-top: 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #102a43;
    text-align: center;
    max-width: 100px;
    line-height: 1.25;
  }

  .enamels-unassigned-col-pill {
    display: inline-block;
    font-size: 9px;
    font-weight: 800;
    color: #b45309;
    background: #fef3c7;
    border: 1px solid #fde68a;
    border-radius: 4px;
    padding: 2px 6px;
    margin-top: 4px;
    text-align: center;
    line-height: 1.2;
    white-space: nowrap;
  }

  /* Expandable Grid Styles */
  .enamels-colors-grid {
    display: grid;
    gap: 20px 14px;
    padding: 24px 0;
  }

  .enamels-colors-grid--desktop-6 { grid-template-columns: repeat(6, 1fr); }
  .enamels-colors-grid--desktop-8 { grid-template-columns: repeat(8, 1fr); }
  .enamels-colors-grid--desktop-10 { grid-template-columns: repeat(10, 1fr); }

  @media (max-width: 768px) {
    .enamels-color-track {
      gap: {{ section.settings.card_gap_mobile | default: 14 }}px;
    }

    .enamels-swatch-circle {
      width: {{ section.settings.circle_size_mobile | default: 76 }}px;
      height: {{ section.settings.circle_size_mobile | default: 76 }}px;
    }

    .enamels-swatch-name {
      font-size: 11px;
    }

    .enamels-colors-grid--mobile-3 { grid-template-columns: repeat(3, 1fr); }
    .enamels-colors-grid--mobile-4 { grid-template-columns: repeat(4, 1fr); }
    .enamels-colors-grid--mobile-5 { grid-template-columns: repeat(5, 1fr); }
  }
</style>

<script>
  (function () {
    function initColorsSection(sec) {
      if (!sec) return;

      const toggleBtn = sec.querySelector('[data-color-toggle]');
      const drawer = sec.querySelector('[data-color-drawer]');
      const labelSpan = toggleBtn ? toggleBtn.querySelector('.enamels-cat-toggle-btn__label') : null;
      const track = sec.querySelector('[data-color-track]');
      const prevBtn = sec.querySelector('[data-color-prev]');
      const nextBtn = sec.querySelector('[data-color-next]');

      const singleSetCount = {{ sorted_color_items.size | default: 8 }};

      if (track && singleSetCount > 1) {
        let setDistance = 0;
        let isAdjusting = false;

        const updateMetrics = () => {
          if (!track || track.children.length < singleSetCount * 2) return;
          const first = track.children[0];
          const secondSetFirst = track.children[singleSetCount];
          if (first && secondSetFirst) {
            const dist = secondSetFirst.offsetLeft - first.offsetLeft;
            if (dist > 0) {
              if (setDistance > 0 && track.scrollLeft > 0) {
                const ratio = track.scrollLeft / setDistance;
                setDistance = dist;
                track.scrollLeft = ratio * setDistance;
              } else {
                setDistance = dist;
                track.scrollLeft = setDistance * 1.5;
              }
            }
          }
        };

        const handleLoop = () => {
          if (isAdjusting || !setDistance || setDistance <= 0) return;
          const current = track.scrollLeft;
          if (current >= setDistance * 2.5) {
            isAdjusting = true;
            track.scrollLeft = current - setDistance;
            requestAnimationFrame(() => { isAdjusting = false; });
          } else if (current <= setDistance * 0.5) {
            isAdjusting = true;
            track.scrollLeft = current + setDistance;
            requestAnimationFrame(() => { isAdjusting = false; });
          }
        };

        track.addEventListener('scroll', handleLoop, { passive: true });
        window.addEventListener('resize', updateMetrics, { passive: true });

        // Initialize position on load
        updateMetrics();
        setTimeout(updateMetrics, 50);
        setTimeout(updateMetrics, 200);
        setTimeout(updateMetrics, 600);

        // Arrow Navigation - Infinite Smooth Cycling
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const scrollStep = () => track.clientWidth * 0.65;

        if (prevBtn) {
          prevBtn.style.opacity = '1';
          prevBtn.style.pointerEvents = 'auto';
          prevBtn.onclick = function (e) {
            e.preventDefault();
            e.stopPropagation();
            track.scrollBy({ left: -scrollStep(), behavior: prefersReduced ? 'auto' : 'smooth' });
          };
        }

        if (nextBtn) {
          nextBtn.style.opacity = '1';
          nextBtn.style.pointerEvents = 'auto';
          nextBtn.onclick = function (e) {
            e.preventDefault();
            e.stopPropagation();
            track.scrollBy({ left: scrollStep(), behavior: prefersReduced ? 'auto' : 'smooth' });
          };
        }

        // Prevent native HTML5 link drag which kills mouse dragging
        track.addEventListener('dragstart', (e) => {
          e.preventDefault();
        });

        // Mouse Drag to Scroll
        let isDown = false;
        let startX = 0;
        let hasMoved = false;

        track.addEventListener('mousedown', (e) => {
          if (e.button !== 0) return;
          isDown = true;
          hasMoved = false;
          startX = e.pageX - track.offsetLeft;
          track.style.cursor = 'grabbing';
          track.style.userSelect = 'none';
        });

        const stopDrag = () => {
          if (!isDown) return;
          isDown = false;
          track.style.cursor = 'grab';
          track.style.userSelect = '';
          setTimeout(() => { hasMoved = false; }, 80);
        };

        window.addEventListener('mouseup', stopDrag);
        track.addEventListener('mouseleave', stopDrag);

        track.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          const currentX = e.pageX - track.offsetLeft;
          const dx = currentX - startX;
          if (Math.abs(dx) > 3) {
            hasMoved = true;
          }
          track.scrollLeft -= dx;
          startX = currentX;
          handleLoop();
        });

        // Mobile Touch Swiping Tracking (prevents accidental swatch clicks during swipe)
        let touchStartX = 0;
        let touchStartY = 0;

        track.addEventListener('touchstart', (e) => {
          if (e.touches && e.touches[0]) {
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
            hasMoved = false;
          }
        }, { passive: true });

        track.addEventListener('touchmove', (e) => {
          if (e.touches && e.touches[0]) {
            const dx = e.touches[0].clientX - touchStartX;
            const dy = e.touches[0].clientY - touchStartY;
            if (Math.abs(dx) > 6 || Math.abs(dy) > 6) {
              hasMoved = true;
            }
          }
        }, { passive: true });

        track.addEventListener('touchend', () => {
          setTimeout(() => { hasMoved = false; }, 80);
        }, { passive: true });

        // Suppress accidental card clicks if user was actively dragging/swiping
        track.addEventListener('click', (e) => {
          if (hasMoved) {
            e.preventDefault();
            e.stopPropagation();
            return false;
          }
        }, true);

        // Native Trackpad & Smooth Mouse Wheel
        track.addEventListener('wheel', (e) => {
          if (Math.abs(e.deltaX) > 3) {
            handleLoop();
            return;
          }
          if (Math.abs(e.deltaY) > 0 && !e.shiftKey) {
            track.scrollLeft += e.deltaY * 1.2;
            handleLoop();
          }
        }, { passive: true });
      }

      // Expand / Collapse View All
      if (toggleBtn && drawer && labelSpan) {
        const labelCollapsed = labelSpan.getAttribute('data-label-collapsed') || 'View all';
        const labelExpanded = labelSpan.getAttribute('data-label-expanded') || 'Show less';

        toggleBtn.onclick = function () {
          const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';

          if (!isExpanded) {
            toggleBtn.setAttribute('aria-expanded', 'true');
            drawer.setAttribute('aria-hidden', 'false');
            drawer.removeAttribute('hidden');
            labelSpan.textContent = labelExpanded;
          } else {
            toggleBtn.setAttribute('aria-expanded', 'false');
            drawer.setAttribute('aria-hidden', 'true');
            drawer.setAttribute('hidden', '');
            labelSpan.textContent = labelCollapsed;

            const rect = sec.getBoundingClientRect();
            if (rect.top < 0) {
              sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        };
      }
    }

    // Initialize on DOM load
    document.addEventListener('DOMContentLoaded', function() {
      const sectionEl = document.getElementById('enamels-colors-{{ section.id }}');
      initColorsSection(sectionEl);
    });

    // Theme Editor Live Lifecycle Support
    document.addEventListener('shopify:section:load', function(e) {
      if (e.target.id === 'enamels-colors-{{ section.id }}' || e.target.querySelector('#enamels-colors-{{ section.id }}')) {
        const sec = document.getElementById('enamels-colors-{{ section.id }}');
        initColorsSection(sec);
      }
    });
    document.addEventListener('shopify:section:select', function(e) {
      if (e.target.id === 'enamels-colors-{{ section.id }}' || e.target.querySelector('#enamels-colors-{{ section.id }}')) {
        const sec = document.getElementById('enamels-colors-{{ section.id }}');
        initColorsSection(sec);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Enamels Shop By Colors",
  "tag": "section",
  "class": "enamels-colors-section-wrapper",
  "settings": [
    {
      "type": "color",
      "id": "section_bg",
