{% comment %}
  Enamels Modular Brand & Signature Articles Gallery
  Provides customizable brand cards (Vilora, Splender, Ground, FlexFit, Helium, etc.)
  with drag-and-drop thumbnail uploads, custom badges, descriptions, and collection links.
{% endcomment %}

{%- liquid
  assign enable_section = section.settings.enable_section
  assign tag_text = section.settings.brands_tag | strip
  assign title_text = section.settings.brands_title | strip
  assign subtitle_text = section.settings.brands_subtitle | strip
  assign blocks_count = section.blocks.size
-%}

{% if enable_section %}
{%- style -%}
  #shopify-section-{{ section.id }} .frubs-brands-section {
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;
    background-color: {{ section.settings.section_bg | default: '#ffffff' }};
  }
  #shopify-section-{{ section.id }} .categories-section-header {
    margin-bottom: {{ section.settings.header_margin_bottom | default: 16 }}px;
  }
  #shopify-section-{{ section.id }} .frubs-brands-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax({{ section.settings.thumbnail_width_desktop | default: 240 }}px, 1fr));
    gap: {{ section.settings.thumbnail_spacing | default: 18 }}px;
    margin-top: {{ section.settings.thumbnail_margin_top | default: 0 }}px;
    margin-bottom: {{ section.settings.thumbnail_margin_bottom | default: 0 }}px;
  }
  #shopify-section-{{ section.id }} .frubs-brand-tile {
    border-radius: {{ section.settings.card_border_radius | default: 12 }}px;
    background-color: {{ section.settings.card_bg | default: '#f8fafc' }};
  }
  #shopify-section-{{ section.id }} .frubs-brand-tile-media {
    border-radius: {{ section.settings.card_border_radius | default: 12 }}px {{ section.settings.card_border_radius | default: 12 }}px 0 0;
    background-color: {{ section.settings.thumbnail_media_bg | default: '#ffffff' }};
    padding-top: {{ section.settings.thumbnail_pad_top | default: 0 }}px;
    padding-bottom: {{ section.settings.thumbnail_pad_bottom | default: 0 }}px;
    box-sizing: border-box;
    overflow: hidden;
    position: relative;
    {% if section.settings.image_aspect_ratio == 'custom' %}
      height: {{ section.settings.thumbnail_height_desktop | default: 320 }}px;
      aspect-ratio: unset;
    {% elsif section.settings.image_aspect_ratio == '1_1' %}
      aspect-ratio: 1 / 1;
      height: auto;
    {% elsif section.settings.image_aspect_ratio == '4_3' %}
      aspect-ratio: 4 / 3;
      height: auto;
    {% elsif section.settings.image_aspect_ratio == '16_9' %}
      aspect-ratio: 16 / 9;
      height: auto;
    {% elsif section.settings.image_aspect_ratio == 'natural' %}
      aspect-ratio: auto;
      height: auto;
    {% else %}
      aspect-ratio: 3 / 4;
      height: auto;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .frubs-brand-tile.is-image-only .frubs-brand-tile-media {
    border-radius: {{ section.settings.card_border_radius | default: 12 }}px;
  }
  #shopify-section-{{ section.id }} .frubs-brand-tile-media img {
    object-fit: {{ section.settings.image_fit_mode | default: 'cover' }};
    object-position: {{ section.settings.image_pos_x | default: 'center' }} {{ section.settings.image_pos_y | default: 'center' }};
    transform: scale({{ section.settings.image_zoom | default: 100 | divided_by: 100.0 }});
    transform-origin: center center;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #shopify-section-{{ section.id }} .frubs-brand-tile:hover .frubs-brand-tile-media img {
    transform: scale({{ section.settings.image_zoom | default: 100 | times: 1.04 | divided_by: 100.0 }});
  }
  #shopify-section-{{ section.id }} .frubs-brand-tile-body {
    padding: {{ section.settings.caption_spacing | default: 14 }}px;
  }
  #shopify-section-{{ section.id }} .frubs-brand-tile-cta {
    margin-top: {{ section.settings.button_margin_top | default: 8 }}px;
    margin-bottom: {{ section.settings.button_margin_bottom | default: 0 }}px;
  }
  #shopify-section-{{ section.id }} .frubs-btn-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #008779;
    color: #ffffff !important;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  #shopify-section-{{ section.id }} .frubs-btn-pill:hover {
    background: #006b60;
  }
  #shopify-section-{{ section.id }} .frubs-btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: #008779 !important;
    border: 1.5px solid #008779;
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  #shopify-section-{{ section.id }} .frubs-btn-outline:hover {
    background: #f0fdfa;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .frubs-brands-section {
      padding-top: {{ section.settings.padding_top | default: 48 | times: 0.7 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 48 | times: 0.7 | round }}px;
    }
    #shopify-section-{{ section.id }} .frubs-brands-grid {
      grid-template-columns: repeat(auto-fill, minmax({{ section.settings.thumbnail_width_mobile | default: 160 }}px, 1fr));
      gap: {{ section.settings.thumbnail_spacing_mobile | default: 12 }}px;
    }
    {% if section.settings.image_aspect_ratio == 'custom' %}
      #shopify-section-{{ section.id }} .frubs-brand-tile-media {
        height: {{ section.settings.thumbnail_height_mobile | default: 210 }}px;
      }
    {% endif %}
  }
{%- endstyle -%}
<section class="frubs-brands-section page-container enamels-homepage-modular-section" id="homepage-featured-articles" aria-label="Explore Our Brands and Signature Articles">
  {% if tag_text != blank or title_text != blank or subtitle_text != blank %}
    <div class="categories-section-header" style="margin-bottom: {{ section.settings.header_margin_bottom | default: 16 }}px;">
      {% if tag_text != blank %}
        <span class="categories-section-tag">{{ tag_text | escape }}</span>
      {% endif %}
      {% if title_text != blank %}
        <h2 class="categories-section-title">{{ title_text | escape }}</h2>
      {% endif %}
      {% if subtitle_text != blank %}
        <p class="categories-section-subtitle">{{ subtitle_text | escape }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="frubs-brands-grid">
    {% if blocks_count > 0 %}
      {% for block in section.blocks %}
        {%- liquid
          assign brand_name = block.settings.title | strip
          assign badge_text = block.settings.badge | strip
          assign badge_bg = block.settings.badge_bg | default: '#102a43'
          assign badge_color = block.settings.badge_color | default: '#ffffff'
          assign brand_desc = block.settings.description | strip
          assign cta_text = block.settings.cta_text | strip
          assign brand_link = block.settings.link
          assign block_ratio = block.settings.image_aspect_ratio_override | default: 'inherit'
          assign block_height = block.settings.custom_height | default: 0
          assign block_fit = block.settings.image_fit_override | default: 'inherit'
          assign block_zoom = block.settings.custom_zoom | default: 0
          assign block_media_bg = block.settings.custom_media_bg
          assign block_pad_top = block.settings.custom_pad_top | default: -1
          assign block_pad_bottom = block.settings.custom_pad_bottom | default: -1

          assign block_pos_y = block.settings.custom_pos_y | default: 'inherit'

          assign resolved_btn_style = section.settings.button_style | default: 'link'
          if block.settings.button_style_override != blank and block.settings.button_style_override != 'inherit'
            assign resolved_btn_style = block.settings.button_style_override
          endif

          assign has_body = false
          if brand_name != blank or brand_desc != blank or cta_text != blank
            if resolved_btn_style != 'hidden' or brand_name != blank or brand_desc != blank
              assign has_body = true
            endif
          endif
        -%}
        <a
          href="{% if brand_link != blank %}{{ brand_link }}{% elsif brand_name != blank %}#collection-{{ brand_name | handleize }}{% else %}#{% endif %}"
          class="frubs-brand-tile{% unless has_body %} is-image-only{% endunless %}"
          id="shopify-block-{{ block.id }}"
          {% if brand_name != blank %}onclick="if (typeof window.navigateToBrand === 'function') { window.navigateToBrand('{{ brand_name | escape }}'); return false; }"{% endif %}
          aria-label="{% if brand_name != blank %}Explore {{ brand_name | escape }}{% elsif badge_text != blank %}{{ badge_text | escape }}{% else %}Brand Thumbnail{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div
            class="frubs-brand-tile-media"
            style="
              {% if block_ratio != 'inherit' and block_ratio != blank %}
                {% if block_ratio == 'custom' and block_height > 0 %}height: {{ block_height }}px; aspect-ratio: unset;
                {% elsif block_ratio == '1_1' %}aspect-ratio: 1 / 1; height: auto;
                {% elsif block_ratio == '3_4' %}aspect-ratio: 3 / 4; height: auto;
                {% elsif block_ratio == '4_3' %}aspect-ratio: 4 / 3; height: auto;
                {% elsif block_ratio == '16_9' %}aspect-ratio: 16 / 9; height: auto;
                {% elsif block_ratio == 'natural' %}aspect-ratio: auto; height: auto;
                {% endif %}
              {% endif %}
              {% if block_media_bg != blank %}background-color: {{ block_media_bg }};{% endif %}
              {% if block_pad_top >= 0 %}padding-top: {{ block_pad_top }}px;{% endif %}
              {% if block_pad_bottom >= 0 %}padding-bottom: {{ block_pad_bottom }}px;{% endif %}
            "
          >
            {% if badge_text != blank %}
              <span class="frubs-brand-tile-badge" style="background: {{ badge_bg }}; color: {{ badge_color }};">
                {{ badge_text | escape }}
              </span>
            {% endif %}
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.image.alt | default: brand_name | default: 'Brand Thumbnail' | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
                style="
                  {% if block_fit != 'inherit' and block_fit != blank %}object-fit: {{ block_fit }};{% endif %}
                  {% if block_pos_y != 'inherit' and block_pos_y != blank %}object-position: center {{ block_pos_y }};{% endif %}
                  {% if block_zoom > 0 %}transform: scale({{ block_zoom | divided_by: 100.0 }});{% endif %}
                "
              />
            {% else %}
              <div class="frubs-brand-placeholder" style="background: #f1f5f9; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; min-height: 200px;">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                  <path d="M20.38 3.46L16 2a4 4 0 01-8 0L3.62 3.46a2 2 0 00-1.34 2.23l.58 3.47a1 1 0 00.99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 002-2V10h2.15a1 1 0 00.99-.84l.58-3.47a2 2 0 00-1.34-2.23z"/>
                </svg>
              </div>
            {% endif %}
          </div>
          {% if has_body %}
          <div class="frubs-brand-tile-body">
            {% if brand_name != blank %}
              <h3 class="frubs-brand-tile-title">{{ brand_name | escape }}</h3>
            {% endif %}
            {% if brand_desc != blank %}
              <p class="frubs-brand-tile-sub">{{ brand_desc | escape }}</p>
            {% endif %}
            {% if cta_text != blank and resolved_btn_style != 'hidden' %}
              <span
                class="frubs-brand-tile-cta{% if resolved_btn_style == 'pill' %} frubs-btn-pill{% elsif resolved_btn_style == 'outline' %} frubs-btn-outline{% endif %}"
                style="
                  {% if block.settings.button_margin_top != blank and block.settings.button_margin_top >= 0 %}margin-top: {{ block.settings.button_margin_top }}px;{% endif %}
                  {% if block.settings.button_margin_bottom != blank and block.settings.button_margin_bottom >= 0 %}margin-bottom: {{ block.settings.button_margin_bottom }}px;{% endif %}
                "
              >
                {{ cta_text | escape }}
              </span>
            {% endif %}
          </div>
          {% endif %}
        </a>
      {% endfor %}
    {% endif %}
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Brand & Article Gallery",
  "class": "enamels-brand-gallery-wrapper",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Section",
      "default": true
    },
    {
      "type": "text",
      "id": "brands_tag",
      "label": "Section Header Tag",
      "default": "PURPOSE-BUILT CLINICAL APPAREL"
    },
    {
      "type": "text",
      "id": "brands_title",
      "label": "Section Title",
      "default": "Explore Our Brands"
    },
    {
      "type": "textarea",
      "id": "brands_subtitle",
      "label": "Section Subtitle",
      "default": "Discover purpose-built medical uniforms tailored from proprietary stretch fabrics, luxury micro-drapes, and executive silhouettes."
    },
    {
      "type": "header",
      "content": "Thumbnail & Card Dimensions"
    },
    {
      "type": "range",
      "id": "thumbnail_width_desktop",
      "label": "Thumbnail Width Desktop (px)",
      "min": 160,
      "max": 450,
      "step": 5,
      "default": 240,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "thumbnail_height_desktop",
      "label": "Thumbnail Height Desktop (px)",
      "min": 160,
      "max": 550,
      "step": 5,
      "default": 320,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "thumbnail_width_mobile",
      "label": "Thumbnail Width Mobile (px)",
      "min": 120,
      "max": 300,
      "step": 5,
      "default": 160,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "thumbnail_height_mobile",
      "label": "Thumbnail Height Mobile (px)",
      "min": 120,
      "max": 400,
      "step": 5,
      "default": 210,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "custom", "label": "Custom (Height in px)" },
        { "value": "1_1", "label": "1:1 Square" },
        { "value": "3_4", "label": "3:4 Portrait" },
        { "value": "4_3", "label": "4:3 Classic" },
        { "value": "16_9", "label": "16:9 Widescreen" },
        { "value": "natural", "label": "Natural / Auto" }
      ],
      "default": "3_4"
    },
    {
      "type": "select",
      "id": "image_fit_mode",
      "label": "Image Fit Mode",
      "options": [
        { "value": "cover", "label": "Cover (Fill Container)" },
        { "value": "contain", "label": "Contain (Preserve Full Image)" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "image_pos_x",
      "label": "Horizontal Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "image_pos_y",
      "label": "Vertical Image Position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Thumbnail Border Radius (px)",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "thumbnail_spacing",
      "label": "Spacing Between Thumbnails Desktop (px)",
      "min": 8,
      "max": 48,
      "step": 2,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "thumbnail_spacing_mobile",
      "label": "Spacing Between Thumbnails Mobile (px)",
      "min": 6,
      "max": 28,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "caption_spacing",
      "label": "Spacing Between Image and Caption (px)",
      "min": 4,
      "max": 32,
      "step": 2,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Section & Thumbnail Spacing (Top & Bottom)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Section Top Space (Padding Top in px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Section Bottom Space (Padding Bottom in px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "header_margin_bottom",
      "label": "Space Below Heading / Above Thumbnails (px)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "thumbnail_margin_top",
      "label": "Extra Space Above Thumbnail Grid (px)",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "thumbnail_margin_bottom",
      "label": "Space Below Thumbnail Grid (px)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Thumbnail Image Spacing & Letterbox Controls"
    },
    {
      "type": "range",
      "id": "image_zoom",
      "label": "Image Zoom / Scale (%) - Crop Out Black Letterbox Bars",
      "min": 100,
      "max": 180,
      "step": 2,
      "default": 100,
      "unit": "%",
      "info": "Increase zoom to crop out black bands or screenshot borders on top and bottom."
    },
    {
      "type": "range",
      "id": "thumbnail_pad_top",
      "label": "Thumbnail Top Inner Space / Padding (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "thumbnail_pad_bottom",
      "label": "Thumbnail Bottom Inner Space / Padding (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "thumbnail_media_bg",
      "label": "Thumbnail Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Thumbnail Button & Caption Controls"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Thumbnail Button Style",
      "options": [
        { "value": "link", "label": "Teal Text Link with Arrow" },
        { "value": "pill", "label": "Teal Solid Button Pill" },
        { "value": "outline", "label": "Teal Outline Button" }
      ],
      "default": "link"
    },
    {
      "type": "range",
      "id": "button_margin_top",
      "label": "Space Above Thumbnail Button (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_margin_bottom",
      "label": "Space Below Thumbnail Button (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand / Article Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Brand / Article Name",
          "default": "Vilora Series"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Thumbnail Image"
        },
        {
          "type": "select",
          "id": "image_aspect_ratio_override",
          "label": "Aspect Ratio Override",
          "options": [
            { "value": "inherit", "label": "Inherit Section Default" },
            { "value": "custom", "label": "Custom (Use Height Below)" },
            { "value": "1_1", "label": "1:1 Square" },
            { "value": "3_4", "label": "3:4 Portrait" },
            { "value": "4_3", "label": "4:3 Classic" },
            { "value": "16_9", "label": "16:9 Widescreen" },
            { "value": "natural", "label": "Natural / Auto" }
          ],
          "default": "inherit"
        },
        {
          "type": "range",
          "id": "custom_height",
          "label": "Block Custom Height (px)",
          "min": 0,
          "max": 600,
          "step": 10,
          "default": 0,
          "info": "Set to 0 to use section height"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Text"
        },
        {
          "type": "color",
          "id": "badge_bg",
          "label": "Badge Background Color",
          "default": "#be185d"
        },
        {
          "type": "color",
          "id": "badge_color",
          "label": "Badge Text Color",
          "default": "#ffffff"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short Description"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button Label",
          "default": "Explore Series →"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Target Link / Collection"
        },
        {
          "type": "header",
          "content": "Thumbnail Fit, Zoom & Spacing Adjustments"
        },
        {
          "type": "select",
          "id": "image_fit_override",
          "label": "Image Fit Override",
          "options": [
            { "value": "inherit", "label": "Inherit Section Default" },
            { "value": "cover", "label": "Cover (Fill & Crop to Frame)" },
            { "value": "contain", "label": "Contain (Fit Full Image)" },
            { "value": "fill", "label": "Fill (Stretch to Edge)" }
          ],
          "default": "inherit"
        },
        {
          "type": "select",
          "id": "custom_pos_y",
          "label": "Vertical Focal Alignment",
          "options": [
            { "value": "inherit", "label": "Inherit Section Default" },
            { "value": "center", "label": "Center" },
            { "value": "top", "label": "Top (Align Top)" },
            { "value": "bottom", "label": "Bottom (Align Bottom)" }
          ],
          "default": "inherit"
        },
        {
          "type": "range",
          "id": "custom_zoom",
          "label": "Thumbnail Image Zoom Override (%)",
          "min": 0,
          "max": 180,
          "step": 2,
          "default": 0,
