

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign is_customizer = false
  assign is_bulk = false
  assign is_intl = false
  assign is_order_verif = false

  if request.path contains 'customizer' or request.path contains 'customize'
    assign is_customizer = true
  elsif request.path contains 'bulk'
    assign is_bulk = true
  elsif request.path contains 'international' or request.path contains 'intl'
    assign is_intl = true
  elsif request.path contains 'order' or request.path contains 'confirm' or request.path contains 'verif'
    assign is_order_verif = true
  endif
%}

{%- if is_customizer -%}
  <div class="customizer-full-page" style="width: 100%; max-width: 1140px; margin: 30px auto; padding: 0 16px;">
    {% render 'enamels-customization-wizard' %}
  </div>
{%- elsif is_bulk -%}
  <div class="bulk-full-page" style="width: 100%; max-width: 1140px; margin: 30px auto; padding: 0 16px;">
    {% render 'enamels-bulk-orders-workflow' %}
  </div>
{%- elsif is_order_verif -%}
  <div class="order-verif-full-page" style="width: 100%; max-width: 1020px; margin: 30px auto; padding: 0 16px;">
    {% render 'enamels-order-verification' %}
  </div>
{%- elsif is_intl -%}
  <div class="intl-full-page" style="width: 100%; max-width: 800px; margin: 40px auto; padding: 0 16px;">
    <script>
      if (typeof window.enamelsSetIntlMode === 'function') {
        window.enamelsSetIntlMode(true);
      }
      setTimeout(function() {
        if (typeof window.openInternationalModal === 'function') {
          window.openInternationalModal();
        }
      }, 100);
    </script>
    <div style="text-align: center; padding: 40px 20px;">
      <h1 style="color: #0f172a; font-size: 28px; font-weight: 800; margin-bottom: 12px;">🌍 International Delivery Active</h1>
      <p style="color: #64748b; font-size: 15px; margin-bottom: 24px;">Flat PKR 4,000 per scrub unit worldwide express courier dispatch (DHL / FedEx Express).</p>
      <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a href="#customizer" onclick="window.openCustomizerModal(); return false;" style="background: #008779; color: #fff; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 700;">Customize Your Scrub →</a>
        <a href="/collections/all" style="background: #0f172a; color: #fff; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 700;">Shop Ready Collections →</a>
      </div>
    </div>
  </div>
{%- else -%}
<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="
    section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}
    {% if section.settings.section_height != "" %} {{ section.settings.section_height | prepend: "section--height-" }}{% endif %}
  "
>
  <div>
    <div
      class="
        spacing-style
        layout-panel-flex
        layout-panel-flex--column
        section-content-wrapper
        mobile-column
      "
      style="
        {% render 'layout-panel-style', settings: section.settings %}
        {% render 'spacing-style', settings: section.settings %}
      "
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>
{%- endif -%}

<script>
  (function handle404CustomizerRouting() {
    var path = window.location.pathname.toLowerCase();
    var hash = window.location.hash.toLowerCase();
    var href = window.location.href.toLowerCase();

    if (path.indexOf('customizer') !== -1 || hash.indexOf('customizer') !== -1 || href.indexOf('customizer') !== -1) {
      // Hide any default 404 text blocks
      var contentWrapper = document.querySelector('.section-content-wrapper');
      if (contentWrapper) {
        contentWrapper.style.display = 'none';
      }

      // If full page not rendered server-side, open modal
      var inlineCustomizer = document.querySelector('.customizer-full-page');
      if (!inlineCustomizer && typeof window.openCustomizerModal === 'function') {
        window.openCustomizerModal();
      }
    }
  })();
</script>

{% schema %}
{
  "name": "t:names.404",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.horizontal_alignment_flex_direction_column == 'fake-value' }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "",
          "label": "t:options.auto"
        },
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "full-screen",
          "label": "t:options.full_screen"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.direction_start"
        },
        {
          "value": "center",
          "label": "t:options.direction_center"
        },
        {
          "value": "flex-end",
          "label": "t:options.direction_end"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
