{% comment %}
  Enamels Dedicated Sale & Promotional Section
  Features:
  - Genuine sale eligibility filtering: checks tag 'sale-active' or verified compare_at_price > price
  - Excludes non-discounted products and expired promotions
  - Full Theme Editor controls: collection picker, thumbnail, title, description, badge toggles
  - Layout Mode: Horizontal Carousel with fractional visible cards OR Responsive Product Grid
  - Calculates real discount percentage dynamically: (compare_at - price) / compare_at * 100
  - Clean empty state when no active promotions match
{% endcomment %}

{{ 'enamels-product-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'enamels-product-carousel.js' | asset_url }}" defer></script>

{%- liquid
  assign target_collection = section.settings.sale_collection
  if target_collection == blank or target_collection.all_products_count == 0
    if collections['sale'] != blank
      assign target_collection = collections['sale']
    elsif collection != blank
      assign target_collection = collection
    else
      assign target_collection = collections.all
    endif
  endif

  assign heading_tag = section.settings.header_tag | default: 'VERIFIED CLINICAL PROMOTIONS' | strip
  assign title_text = section.settings.heading | default: 'Sale & Special Promotions' | strip
  assign desc_text = section.settings.subtext | default: 'Discover genuine promotional offers on premium medical scrubs, lab coats, and surgical caps. Every sale piece is crafted from our authentic 4-way stretch and fluid-repellent fabrics.' | strip

  # Visible Columns Calculation
  assign visible_desktop = section.settings.products_visible_desktop | default: '4'
  if visible_desktop == 'custom' or section.settings.products_desktop_custom != blank
    assign visible_desktop = section.settings.products_desktop_custom | strip | default: '4'
  endif

  assign visible_tablet = section.settings.products_visible_tablet | default: '2.5'
  if visible_tablet == 'custom' or section.settings.products_tablet_custom != blank
    assign visible_tablet = section.settings.products_tablet_custom | strip | default: '2.5'
  endif

  assign visible_mobile = section.settings.products_visible_mobile | default: '1.5'
  if visible_mobile == 'custom' or section.settings.products_mobile_custom != blank
    assign visible_mobile = section.settings.products_mobile_custom | strip | default: '1.5'
  endif

  assign gap_desktop = section.settings.gap_desktop | default: 16
  assign gap_tablet = gap_desktop | times: 0.8 | round
  assign gap_mobile = section.settings.gap_mobile | default: 10

  assign is_grid_mode = false
  if section.settings.layout_mode == 'grid'
    assign is_grid_mode = true
  endif

  assign products_per_page = section.settings.products_per_page | default: 24
  assign show_sale_badge = section.settings.show_sale_badge
  if show_sale_badge == nil
    assign show_sale_badge = true
  endif
  assign sale_badge_text = section.settings.sale_badge_text | default: 'SALE' | strip
  assign sale_badge_bg = section.settings.sale_badge_color | default: '#e11d48'
  assign show_percent = section.settings.show_discount_percentage
  if show_percent == nil
    assign show_percent = true
  endif

  assign filter_rule = section.settings.filter_rule | default: 'tag_or_discount'
-%}

<div
  class="enamels-carousel-section enamels-sale-section-container"
  id="enamels-sale-section-{{ section.id }}"
  style="
    background: {{ section.settings.bg_color | default: '#ffffff' }};
    padding: {{ section.settings.padding_top | default: 40 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px;
    --carousel-cols-desktop: {{ visible_desktop }};
    --carousel-cols-tablet: {{ visible_tablet }};
    --carousel-cols-mobile: {{ visible_mobile }};
    --carousel-gap: {{ gap_desktop }}px;
    --carousel-gap-tablet: {{ gap_tablet }}px;
    --carousel-gap-mobile: {{ gap_mobile }}px;
    --grid-cols-desktop: 4;
    --grid-cols-tablet: 3;
    --grid-cols-mobile: 2;
  "
  data-enamels-carousel
  data-autoplay="{{ section.settings.enable_autoplay | default: false }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | default: 5 }}"
  data-mouse-wheel="{{ section.settings.enable_mouse_wheel | default: true }}"
  {{ section.shopify_attributes }}
>
  <div class="enamels-carousel-container">
    <!-- Sale Section Header -->
    <div class="enamels-carousel-header" style="align-items: flex-end;">
      <div class="enamels-carousel-header__text">
        {% if heading_tag != blank %}
          <span style="display: inline-block; background: rgba(225, 29, 72, 0.08); color: #e11d48; border: 1px solid rgba(225, 29, 72, 0.2); font-size: 0.72rem; font-weight: 800; padding: 4px 10px; border-radius: 999px; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 8px;">
            {{ heading_tag | escape }}
          </span>
        {% endif %}
        {% if title_text != blank %}
          <h2 class="enamels-carousel-header__title">{{ title_text | escape }}</h2>
        {% endif %}
        {% if desc_text != blank %}
          <p class="enamels-carousel-header__subtitle" style="max-width: 680px;">{{ desc_text | strip_html | escape }}</p>
        {% endif %}
      </div>

      <div class="enamels-carousel-header__actions">
        <!-- Expand to Grid / Show Less Toggle -->
        <button
          type="button"
          class="enamels-carousel-expand-btn"
          data-carousel-expand
          data-expand-label="Expand Grid"
          data-collapse-label="Show Less"
          aria-expanded="{% if is_grid_mode %}true{% else %}false{% endif %}"
        >
          <span class="enamels-btn-text">{% if is_grid_mode %}Show Less{% else %}Expand Grid{% endif %}</span>
          <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        {% if target_collection.url != blank %}
          <a href="{{ target_collection.url }}" class="enamels-carousel-view-all">
            <span>All Sale Items</span>
            <span aria-hidden="true">→</span>
          </a>
        {% endif %}

        <!-- Desktop Navigation Arrows -->
        {%- if section.settings.show_arrows and is_grid_mode == false -%}
          <div class="enamels-carousel-nav-arrows">
            <button
              type="button"
              class="enamels-carousel-arrow enamels-carousel-arrow--prev"
              data-carousel-prev
              aria-label="Previous sale products"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button
              type="button"
              class="enamels-carousel-arrow enamels-carousel-arrow--next"
              data-carousel-next
              aria-label="Next sale products"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>

    {% if target_collection != blank and target_collection.products.size > 0 %}
      {% paginate target_collection.products by products_per_page %}
        {%- liquid
          assign eligible_count = 0
        -%}

        <div class="enamels-carousel-viewport">
          <div
            class="enamels-carousel-track{% if is_grid_mode %} is-grid-mode{% endif %}"
            data-carousel-track
            tabindex="0"
            role="region"
            aria-label="{{ title_text | default: 'Sale Products' | escape }}"
          >
            {% for product in target_collection.products %}
              {%- liquid
                # Genuine Sale Qualification Evaluation
                assign is_on_sale = false
                assign has_sale_tag = false
                if product.tags contains 'sale-active' or product.tags contains 'sale' or product.tags contains 'badge:sale'
                  assign has_sale_tag = true
                endif

                assign has_real_discount = false
                if product.compare_at_price > product.price
                  assign has_real_discount = true
                endif

                case filter_rule
                  when 'discount_only'
                    if has_real_discount
                      assign is_on_sale = true
                    endif
                  when 'tag_only'
                    if has_sale_tag
                      assign is_on_sale = true
                    endif
                  when 'tag_or_discount'
                    if has_real_discount or has_sale_tag
                      assign is_on_sale = true
                    endif
                  when 'all_in_collection'
                    assign is_on_sale = true
                endcase
              -%}

              {% if is_on_sale %}
                {% assign eligible_count = eligible_count | plus: 1 %}
                {%- render 'enamels-product-carousel-card',
                  prod: product,
                  show_swatches: true,
                  show_secondary_image: true,
                  show_sale_badge: show_sale_badge,
                  priority_index: forloop.index0
                -%}
              {% endif %}
            {% endfor %}

            {% if eligible_count == 0 %}
              <div class="enamels-carousel-empty" style="grid-column: 1 / -1;">
                <div style="font-size: 32px; margin-bottom: 8px;">🏷️</div>
                <h3 style="font-size: 16px; font-weight: 700; color: #102a43; margin: 0 0 6px;">
                  {{ section.settings.empty_state_heading | default: 'No Active Sale Promotions At This Moment' | escape }}
                </h3>
                <p style="font-size: 13px; color: #64748b; margin: 0 auto 16px; max-width: 480px; line-height: 1.5;">
                  {{ section.settings.empty_state_text | default: 'All current promotional items have been claimed or offer periods have concluded. Please explore our regular catalogue.' | escape }}
                </p>
                <a href="/collections/all" class="enamels-carousel-view-all" style="background: #102a43; color: #ffffff; border-color: #102a43;">
                  Browse Full Catalogue →
                </a>
              </div>
            {% endif %}
          </div>
        </div>

        <!-- Optional Progress Scrollbar Indicator -->
        {%- if is_grid_mode == false and eligible_count > 0 -%}
          <div class="enamels-carousel-progress" data-carousel-progress aria-hidden="true">
            <div class="enamels-carousel-progress-bar" data-progress-bar></div>
          </div>
        {%- endif -%}

        {% if paginate.pages > 1 and eligible_count > 0 and is_grid_mode %}
          <div style="margin-top: 36px; text-align: center;">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}
      {% endpaginate %}
    {% else %}
      <div class="enamels-carousel-empty">
        <div style="font-size: 32px; margin-bottom: 8px;">🏷️</div>
        <h3 style="font-size: 16px; font-weight: 700; color: #102a43; margin: 0 0 6px;">
          {{ section.settings.empty_state_heading | default: 'No Sale Products Designated' | escape }}
        </h3>
        <p style="font-size: 13px; color: #64748b; margin: 0 auto 16px; max-width: 480px;">
          {{ section.settings.empty_state_text | default: 'Select a collection with active sale products or assign the "sale-active" tag in Shopify Admin.' | escape }}
        </p>
        <a href="/collections/all" class="enamels-carousel-view-all" style="background: #102a43; color: #ffffff; border-color: #102a43;">
          Explore All Scrubs →
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Sale Products Showcase",
  "class": "enamels-sale-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Collection & Product Eligibility"
    },
    {
      "type": "collection",
      "id": "sale_collection",
      "label": "Sale Collection Source",
      "info": "Select the dedicated Sale collection, or leave blank to automatically query the store's sale catalogue."
    },
    {
      "type": "select",
      "id": "filter_rule",
      "label": "Sale Eligibility Verification Rule",
      "options": [
        {
          "value": "tag_or_discount",
          "label": "Verified Discount or 'sale-active' Tag"
        },
        {
          "value": "discount_only",
          "label": "Strict Compare-At Discount Only"
        },
        {
          "value": "tag_only",
          "label": "Tagged 'sale-active' Only"
        },
        {
          "value": "all_in_collection",
          "label": "All Products in Collection"
        }
      ],
      "default": "tag_or_discount"
    },
    {
      "type": "header",
      "content": "Headings & Content"
    },
    {
      "type": "text",
      "id": "header_tag",
      "label": "Section Header Tag",
      "default": "VERIFIED CLINICAL PROMOTIONS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Sale & Special Promotions"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Introductory Supporting Text",
      "default": "Discover genuine promotional offers on premium medical scrubs, lab coats, and surgical caps. Every sale piece is crafted from our authentic 4-way stretch and fluid-repellent fabrics."
    },
    {
      "type": "header",
      "content": "Layout Mode & Visible Products"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout Mode",
      "options": [
        { "value": "carousel", "label": "Horizontal Carousel (Scrollable)" },
        { "value": "grid", "label": "Product Grid (Static)" }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "products_visible_desktop",
      "label": "Products Visible on Desktop",
      "options": [
        { "value": "2", "label": "2 products" },
        { "value": "2.5", "label": "2.5 products (2 full + 0.5 peek)" },
        { "value": "3", "label": "3 products" },
        { "value": "3.5", "label": "3.5 products (3 full + 0.5 peek)" },
        { "value": "4", "label": "4 products" },
        { "value": "4.5", "label": "4.5 products (4 full + 0.5 peek)" },
        { "value": "5", "label": "5 products" },
        { "value": "5.5", "label": "5.5 products (5 full + 0.5 peek)" },
        { "value": "6", "label": "6 products" },
        { "value": "custom", "label": "Custom Decimal (Use field below)" }
      ],
      "default": "4"
    },
    {
      "type": "text",
      "id": "products_desktop_custom",
      "label": "Custom Desktop Visible Products",
      "info": "Overrides dropdown when entered (e.g. 2.75, 3.25, 4.2)"
    },
    {
      "type": "select",
      "id": "products_visible_tablet",
      "label": "Products Visible on Tablet",
      "options": [
        { "value": "1.5", "label": "1.5 products" },
        { "value": "2", "label": "2 products" },
        { "value": "2.2", "label": "2.2 products" },
        { "value": "2.5", "label": "2.5 products" },
        { "value": "3", "label": "3 products" },
        { "value": "3.5", "label": "3.5 products" },
        { "value": "4", "label": "4 products" },
        { "value": "custom", "label": "Custom Decimal (Use field below)" }
      ],
      "default": "2.5"
    },
    {
      "type": "text",
      "id": "products_tablet_custom",
      "label": "Custom Tablet Visible Products",
      "info": "e.g. 2.3, 2.7"
    },
    {
      "type": "select",
      "id": "products_visible_mobile",
      "label": "Products Visible on Mobile",
      "options": [
        { "value": "1", "label": "1 product" },
        { "value": "1.2", "label": "1.2 products (1 full + peek)" },
        { "value": "1.3", "label": "1.3 products" },
        { "value": "1.5", "label": "1.5 products (1 full + half peek)" },
        { "value": "1.8", "label": "1.8 products" },
        { "value": "2", "label": "2 products" },
        { "value": "2.2", "label": "2.2 products (2 full + peek)" },
        { "value": "2.5", "label": "2.5 products" },
        { "value": "custom", "label": "Custom Decimal (Use field below)" }
      ],
      "default": "1.5"
    },
    {
      "type": "text",
      "id": "products_mobile_custom",
      "label": "Custom Mobile Visible Products",
      "info": "e.g. 1.25, 1.4, 2.1"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products Per Page (Grid Mode)",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24
    },
    {
      "type": "header",
      "content": "Card Dimensions & Spacing"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap Between Cards (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 6,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Gap Between Cards (Mobile)",
      "default": 10
    },
    {
      "type": "header",
      "content": "Navigation & Interaction Controls"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Desktop Left/Right Navigation Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_mouse_wheel",
      "label": "Enable Mouse Wheel Horizontal Scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Speed (seconds)",
      "default": 5
    },
    {
      "type": "header",
      "content": "Badges & Visual Pricing"
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show Sale Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "sale_badge_text",
      "label": "Sale Badge Text",
      "default": "SALE"
    },
    {
      "type": "color",
      "id": "sale_badge_color",
      "label": "Sale Badge Background Color",
      "default": "#e11d48"
    },
    {
      "type": "checkbox",
      "id": "show_discount_percentage",
      "label": "Show Calculated % Discount Badge",
      "default": true
    },
    {
      "type": "header",
      "content": "Empty State Messaging"
    },
    {
      "type": "text",
      "id": "empty_state_heading",
      "label": "Empty State Heading",
      "default": "No Active Sale Promotions At This Moment"
    },
    {
      "type": "textarea",
      "id": "empty_state_text",
      "label": "Empty State Explanation",
      "default": "All current promotional items have been claimed or offer periods have concluded. Please explore our regular catalogue or check back soon for upcoming flash sales."
    },
    {
      "type": "header",
      "content": "Section Spacing & Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Enamels Sale Section"
    }
  ]
}
{% endschema %}
