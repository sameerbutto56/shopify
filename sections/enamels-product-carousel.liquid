{% comment %}
  Enamels Dedicated Product Carousel Section
  Section: enamels-product-carousel.liquid
  Reusable dynamic product carousel that can be added anywhere across the store.
{% endcomment %}

{{ 'enamels-product-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'enamels-product-carousel.js' | asset_url }}" defer></script>

{%- liquid
  # Target Collection Resolution
  assign target_collection = nil
  if section.settings.collection != blank
    assign target_collection = collections[section.settings.collection]
  elsif section.blocks.size == 0
    assign target_collection = collections['all']
  endif

  # Visible Columns Calculation
  assign visible_desktop = section.settings.products_visible_desktop | default: '4'
  if visible_desktop == 'custom' or section.settings.products_desktop_custom != blank
    assign visible_desktop = section.settings.products_desktop_custom | strip | default: '4'
  endif

  assign visible_tablet = section.settings.products_visible_tablet | default: '2.5'
  if visible_tablet == 'custom' or section.settings.products_tablet_custom != blank
    assign visible_tablet = section.settings.products_tablet_custom | strip | default: '2.5'
  endif

  assign visible_mobile = section.settings.products_visible_mobile | default: '1.5'
  if visible_mobile == 'custom' or section.settings.products_mobile_custom != blank
    assign visible_mobile = section.settings.products_mobile_custom | strip | default: '1.5'
  endif

  # Gap and Sizing
  assign gap_desktop = section.settings.gap_desktop | default: 16
  assign gap_tablet = gap_desktop | times: 0.8 | round
  assign gap_mobile = section.settings.gap_mobile | default: 10

  # Aspect Ratio Calculation
  capture aspect_ratio_css
    render 'product-thumb-ratio', choice: section.settings.aspect_ratio
  endcapture

  assign image_fit_css = section.settings.image_fit
  if image_fit_css == blank or image_fit_css == 'inherit'
    assign image_fit_css = settings.product_card_image_fit | default: 'contain'
  endif
  assign image_pos_css = section.settings.image_position
  if image_pos_css == blank or image_pos_css == 'inherit'
    assign image_pos_css = settings.product_card_image_position | default: 'center'
  endif

  # Product Limits
  assign max_grid_items = section.settings.max_products_grid | default: 24

  # Initial Layout Mode
  assign is_grid_mode = false
  if section.settings.layout_mode == 'grid'
    assign is_grid_mode = true
  endif

  # View All URL
  assign view_all_url = section.settings.view_all_link
  if view_all_url == blank and target_collection != blank
    assign view_all_url = target_collection.url
  endif
  if view_all_url == blank
    assign view_all_url = '/collections/all'
  endif
-%}

<section
  class="enamels-carousel-section"
  id="enamels-carousel-{{ section.id }}"
  style="
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top | default: 36 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;
    --carousel-cols-desktop: {{ visible_desktop }};
    --carousel-cols-tablet: {{ visible_tablet }};
    --carousel-cols-mobile: {{ visible_mobile }};
    --carousel-gap: {{ gap_desktop }}px;
    --carousel-gap-tablet: {{ gap_tablet }}px;
    --carousel-gap-mobile: {{ gap_mobile }}px;
    --grid-cols-desktop: 4;
    --grid-cols-tablet: 3;
    --grid-cols-mobile: 2;
  "
  data-enamels-carousel
  data-autoplay="{{ section.settings.enable_autoplay | default: false }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | default: 5 }}"
  data-mouse-wheel="{{ section.settings.enable_mouse_wheel | default: true }}"
  {{ section.shopify_attributes }}
>
  <div class="enamels-carousel-container">
    <!-- Carousel Header -->
    <div class="enamels-carousel-header">
      <div class="enamels-carousel-header__text">
        {%- if section.settings.title != blank -%}
          <h2 class="enamels-carousel-header__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="enamels-carousel-header__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>

      <div class="enamels-carousel-header__actions">
        <!-- View All Link / Expand Button -->
        {%- if section.settings.show_view_all -%}
          {%- if section.settings.view_all_behavior == 'expand_inline' -%}
            <button
              type="button"
              class="enamels-carousel-expand-btn"
              data-carousel-expand
              data-expand-label="{{ section.settings.view_all_label | default: 'View All' | escape }}"
              data-collapse-label="Show Less"
              aria-expanded="{% if is_grid_mode %}true{% else %}false{% endif %}"
            >
              <span class="enamels-btn-text">{{ section.settings.view_all_label | default: 'View All' | escape }}</span>
              <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
          {%- elsif section.settings.view_all_behavior == 'both' -%}
            <button
              type="button"
              class="enamels-carousel-expand-btn"
              data-carousel-expand
              data-expand-label="Expand Grid"
              data-collapse-label="Show Less"
              aria-expanded="{% if is_grid_mode %}true{% else %}false{% endif %}"
            >
              <span class="enamels-btn-text">Expand Grid</span>
            </button>
            <a href="{{ view_all_url }}" class="enamels-carousel-view-all">
              <span>{{ section.settings.view_all_label | default: 'Full Collection' | escape }}</span>
              <span aria-hidden="true">→</span>
            </a>
          {%- else -%}
            <a href="{{ view_all_url }}" class="enamels-carousel-view-all">
              <span>{{ section.settings.view_all_label | default: 'View All' | escape }}</span>
              <span aria-hidden="true">→</span>
            </a>
          {%- endif -%}
        {%- endif -%}

        <!-- Desktop Navigation Arrows -->
        {%- if section.settings.show_arrows and is_grid_mode == false -%}
          <div class="enamels-carousel-nav-arrows">
            <button
              type="button"
              class="enamels-carousel-arrow enamels-carousel-arrow--prev"
              data-carousel-prev
              aria-label="Previous products"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button
              type="button"
              class="enamels-carousel-arrow enamels-carousel-arrow--next"
              data-carousel-next
              aria-label="Next products"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>

    <!-- Carousel Viewport & Track -->
    <div class="enamels-carousel-viewport">
      <div
        class="enamels-carousel-track{% if is_grid_mode %} is-grid-mode{% endif %}"
        data-carousel-track
        tabindex="0"
        role="region"
        aria-label="{{ section.settings.title | default: 'Product Carousel' | escape }}"
      >
        {%- if target_collection != blank and target_collection.products.size > 0 -%}
          {%- for prod in target_collection.products limit: max_grid_items -%}
            {%- render 'enamels-product-carousel-card',
              prod: prod,
              show_swatches: section.settings.show_color_swatches,
              show_secondary_image: section.settings.show_secondary_image_on_hover,
              show_sale_badge: section.settings.show_sale_badge,
              card_aspect_ratio: aspect_ratio_css,
              card_image_fit: image_fit_css,
              card_image_pos: image_pos_css,
              priority_index: forloop.index0
            -%}
          {%- endfor -%}
        {%- elsif section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign prod = block.settings.product -%}
            {%- if prod != blank -%}
              {%- render 'enamels-product-carousel-card',
                prod: prod,
                show_swatches: section.settings.show_color_swatches,
                show_secondary_image: section.settings.show_secondary_image_on_hover,
                show_sale_badge: section.settings.show_sale_badge,
                card_aspect_ratio: aspect_ratio_css,
                card_image_fit: image_fit_css,
                card_image_pos: image_pos_css,
                priority_index: forloop.index0
              -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <div class="enamels-carousel-empty">
            <p>No products currently found in this collection. Please select an active collection in Shopify Studio.</p>
          </div>
        {%- endif -%}
      </div>
    </div>

    <!-- Optional Progress Scrollbar Indicator -->
    {%- if section.settings.indicator_style == 'scrollbar' and is_grid_mode == false -%}
      <div class="enamels-carousel-progress" data-carousel-progress aria-hidden="true">
        <div class="enamels-carousel-progress-bar" data-progress-bar></div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Enamels Product Carousel",
  "tag": "section",
  "class": "enamels-product-carousel-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Collection & Content"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Shopify Collection",
      "info": "Displays products dynamically from the selected Shopify collection."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Featured Medical Scrubs"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Designed for clinical excellence, endurance, and comfort."
    },
    {
      "type": "header",
      "content": "Layout Mode & Visible Products"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout Mode",
      "options": [
        { "value": "carousel", "label": "Horizontal Carousel (Scrollable)" },
        { "value": "grid", "label": "Product Grid (Static)" }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "products_visible_desktop",
      "label": "Products Visible on Desktop",
      "options": [
        { "value": "2", "label": "2 products" },
        { "value": "2.5", "label": "2.5 products (2 full + 0.5 peek)" },
        { "value": "3", "label": "3 products" },
        { "value": "3.5", "label": "3.5 products (3 full + 0.5 peek)" },
        { "value": "4", "label": "4 products" },
        { "value": "4.5", "label": "4.5 products (4 full + 0.5 peek)" },
        { "value": "5", "label": "5 products" },
        { "value": "5.5", "label": "5.5 products (5 full + 0.5 peek)" },
        { "value": "6", "label": "6 products" },
        { "value": "custom", "label": "Custom Decimal (Use field below)" }
      ],
      "default": "4"
    },
    {
      "type": "text",
      "id": "products_desktop_custom",
      "label": "Custom Desktop Visible Products",
      "info": "Overrides dropdown when entered (e.g. 2.75, 3.25, 4.2)"
    },
    {
      "type": "select",
      "id": "products_visible_tablet",
      "label": "Products Visible on Tablet",
      "options": [
        { "value": "1.5", "label": "1.5 products" },
        { "value": "2", "label": "2 products" },
        { "value": "2.2", "label": "2.2 products" },
        { "value": "2.5", "label": "2.5 products" },
        { "value": "3", "label": "3 products" },
        { "value": "3.5", "label": "3.5 products" },
        { "value": "4", "label": "4 products" },
        { "value": "custom", "label": "Custom Decimal (Use field below)" }
      ],
      "default": "2.5"
    },
    {
      "type": "text",
      "id": "products_tablet_custom",
      "label": "Custom Tablet Visible Products",
      "info": "e.g. 2.3, 2.7"
    },
    {
      "type": "select",
      "id": "products_visible_mobile",
      "label": "Products Visible on Mobile",
      "options": [
        { "value": "1", "label": "1 product" },
        { "value": "1.2", "label": "1.2 products (1 full + peek)" },
        { "value": "1.3", "label": "1.3 products" },
        { "value": "1.5", "label": "1.5 products (1 full + half peek)" },
        { "value": "1.8", "label": "1.8 products" },
        { "value": "2", "label": "2 products" },
        { "value": "2.2", "label": "2.2 products (2 full + peek)" },
        { "value": "2.5", "label": "2.5 products" },
        { "value": "custom", "label": "Custom Decimal (Use field below)" }
      ],
      "default": "1.5"
    },
    {
      "type": "text",
      "id": "products_mobile_custom",
      "label": "Custom Mobile Visible Products",
      "info": "e.g. 1.25, 1.4, 2.1"
    },
    {
      "type": "range",
      "id": "max_products_carousel",
      "min": 4,
      "max": 30,
      "step": 2,
      "label": "Maximum Products in Carousel",
      "default": 12
    },
    {
      "type": "range",
      "id": "max_products_grid",
      "min": 6,
      "max": 48,
      "step": 2,
      "label": "Maximum Products in Grid / View All Mode",
      "default": 24
    },
    {
      "type": "header",
      "content": "Card Dimensions & Spacing"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap Between Cards (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 6,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Gap Between Cards (Mobile)",
      "default": 10
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Thumbnail Aspect Ratio",
      "options": [
        { "value": "inherit", "label": "Use theme default (Product cards)" },
        { "value": "2_3", "label": "Standard 2:3 Portrait (1200 × 1800 px)" },
        { "value": "3_4", "label": "Portrait (3:4)" },
        { "value": "1_1", "label": "Square (1:1)" },
        { "value": "4_5", "label": "Portrait (4:5)" },
        { "value": "custom", "label": "Custom (theme width × height)" },
        { "value": "natural", "label": "Natural Image Dimensions" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Product Image Fit",
      "options": [
        { "value": "inherit", "label": "Use theme default" },
        { "value": "contain", "label": "Contain (Full item visible without cropping)" },
        { "value": "cover", "label": "Cover (Fills thumbnail frame)" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "inherit", "label": "Use theme default" },
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "inherit"
    },
    {
      "type": "header",
      "content": "Navigation & Interaction Controls"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Desktop Left/Right Navigation Arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "indicator_style",
      "label": "Carousel Scroll Indicator",
      "options": [
        { "value": "scrollbar", "label": "Progress Scrollbar" },
        { "value": "none", "label": "None" }
      ],
      "default": "scrollbar"
    },
    {
      "type": "checkbox",
      "id": "enable_mouse_wheel",
      "label": "Enable Smooth Trackpad / Mouse-Wheel Horizontal Scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Speed (seconds)",
      "default": 5
    },
    {
      "type": "header",
      "content": "View All & Expansion"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Option",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Button Label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Custom View All Destination (Overrides Collection URL)"
    },
    {
      "type": "select",
      "id": "view_all_behavior",
      "label": "View All Action",
      "options": [
        { "value": "navigate", "label": "Navigate to Collection Page" },
        { "value": "expand_inline", "label": "Expand into Full Grid Inline" },
        { "value": "both", "label": "Collection Link & Grid Toggle" }
      ],
      "default": "navigate"
    },
    {
      "type": "header",
      "content": "Product Badges & Details"
    },
    {
      "type": "checkbox",
      "id": "show_color_swatches",
      "label": "Show Variant Color Swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show Sale / Discount Badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image_on_hover",
      "label": "Show Secondary Image on Hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Spacing & Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Custom Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Shopify Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Enamels Product Carousel",
      "settings": {
        "title": "Featured Medical Scrubs",
        "products_visible_desktop": "4",
        "products_visible_tablet": "2.5",
        "products_visible_mobile": "1.5"
      }
    }
  ]
}
{% endschema %}
