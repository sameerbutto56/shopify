{% comment %}
  Section contract: Enamels Customization Wizard Section
  Provides step-by-step product customization & embroidery engine on product or landing pages.
  @example
  <!-- In templates/product.json or page.customizer.json -->
{% endcomment %}

{%- liquid
  assign pad_top_desk = section.settings.padding_top_desktop | default: section.settings.padding_top | default: 48
  assign pad_top_mob = section.settings.padding_top_mobile | default: 24
  assign pad_bot_desk = section.settings.padding_bottom_desktop | default: section.settings.padding_bottom | default: 48
  assign pad_bot_mob = section.settings.padding_bottom_mobile | default: 28
  assign max_w = section.settings.container_max_width | default: 1140
  assign t_size_desk = section.settings.title_size_desktop | default: 30
  assign t_size_mob = section.settings.title_size_mobile | default: 22
  assign sub_size_desk = section.settings.subtitle_size_desktop | default: 15
  assign sub_size_mob = section.settings.subtitle_size_mobile | default: 13
-%}

<div
  class="enamels-customizer-section"
  id="enamels-customizer-sec-{{ section.id }}"
  style="
    background-color: {{ section.settings.bg_color | default: '#f8fafc' }};
    padding-top: {{ pad_top_desk }}px;
    padding-bottom: {{ pad_bot_desk }}px;
  "
>
  <style>
    @media (max-width: 640px) {
      #enamels-customizer-sec-{{ section.id }} {
        padding-top: {{ pad_top_mob }}px !important;
        padding-bottom: {{ pad_bot_mob }}px !important;
      }
      #enamels-customizer-sec-{{ section.id }} .customizer-section-title {
        font-size: {{ t_size_mob }}px !important;
      }
      #enamels-customizer-sec-{{ section.id }} .customizer-section-subtitle {
        font-size: {{ sub_size_mob }}px !important;
      }
    }
  </style>

  <div class="page-width" style="max-width: {{ max_w }}px; margin: 0 auto; padding: 0 16px;">
    {% if section.settings.show_header %}
      <div class="customizer-section-header text-center" style="max-width: 720px; margin: 0 auto 36px auto; text-align: center;">
        {% if section.settings.badge != blank %}
          <span class="customizer-badge" style="display: inline-block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #0d9488; background: #ccfbf1; padding: 4px 12px; border-radius: 999px; margin-bottom: 12px;">
            {{ section.settings.badge | escape }}
          </span>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="customizer-section-title" style="font-size: {{ t_size_desk }}px; font-weight: 800; color: #0f172a; margin: 0 0 12px 0; letter-spacing: -0.02em;">
            {{ section.settings.title | escape }}
          </h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="customizer-section-subtitle" style="font-size: {{ sub_size_desk }}px; color: #64748b; line-height: 1.6; margin: 0;">
            {{ section.settings.subtitle | escape }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <div class="customizer-wizard-embed-container">
      {% render 'enamels-customization-wizard',
        embroidery_product: section.settings.embroidery_product,
        patch_product: section.settings.patch_product,
        logo_product: section.settings.logo_product,
        cap_product: section.settings.cap_product,
        sleeves_product: section.settings.sleeves_product
      %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customization Wizard",
  "tag": "section",
  "class": "section-enamels-customizer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show section header",
      "default": true
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge label",
      "default": "Official Clinical Personalization"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Step-by-Step Custom Fit & Embroidery"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading Size (Desktop)",
      "default": 30
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 16,
      "max": 34,
      "step": 1,
      "unit": "px",
      "label": "Heading Size (Mobile)",
      "default": 22
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Tailor your scrubs with clinical precision: choose your fit, select official shades, and preview live chest pocket embroidery."
    },
    {
      "type": "range",
      "id": "subtitle_size_desktop",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subheading Size (Desktop)",
      "default": 15
    },
    {
      "type": "range",
      "id": "subtitle_size_mobile",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Subheading Size (Mobile)",
      "default": 13
    },
    {
      "type": "header",
      "content": "Add-On Products & Services (Optional)"
    },
    {
      "type": "paragraph",
      "content": "Select existing products to bill separately in checkout for customization and accessories. If left blank, details attach as line-item order properties."
    },
    {
      "type": "product",
      "id": "embroidery_product",
      "label": "Name Embroidery Service Product"
    },
    {
      "type": "product",
      "id": "patch_product",
      "label": "Name Patch Service Product"
    },
    {
      "type": "product",
      "id": "logo_product",
      "label": "Hospital Logo Service Product"
    },
    {
      "type": "product",
      "id": "cap_product",
      "label": "Matching Cap Companion Product"
    },
    {
      "type": "product",
      "id": "sleeves_product",
      "label": "Arm Sleeves Companion Product"
    },
    {
      "type": "header",
      "content": "Layout, Sizing & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f8fafc"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Container Max Width",
      "default": 1140
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (Desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (Mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (Desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (Mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Customization Studio"
    }
  ]
}
{% endschema %}
