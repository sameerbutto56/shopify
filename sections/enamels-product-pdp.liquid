{% comment %}
  ==============================================================================
  ENAMELS ONLINE — AMAZON-INSPIRED PREMIUM PRODUCT DETAIL PAGE (PDP)
  Structured 3-Column Desktop Grid: Media Gallery | Product Info | Buy Box
  100% Manageable via Shopify Theme Editor (Blocks & Section Settings)
  Preserves Enamels clinical luxury aesthetic with authentic variant switching,
  customization line-item properties, size guide, reviews, and cart drawer handoff.
  ==============================================================================
{% endcomment %}

{{ 'enamels-pdp-amazon.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media

  # Calculations for compare price & discount
  assign has_discount = false
  if current_variant.compare_at_price > current_variant.price
    assign has_discount = true
    assign savings_amount = current_variant.compare_at_price | minus: current_variant.price
    assign savings_pct = savings_amount | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif

  # Pakistan & International shipping rules
  assign standard_shipping_fee = section.settings.shipping_fee_pk | default: 250
  assign free_shipping_threshold = section.settings.free_shipping_threshold | default: 7000
  assign intl_shipping_base = section.settings.shipping_fee_intl | default: 4000
  assign intl_shipping_addon = section.settings.shipping_fee_intl_addon | default: 1800

  # Media gallery settings
  assign gallery_fit = section.settings.gallery_image_fit | default: 'contain'
  assign gallery_ratio = section.settings.gallery_aspect_ratio | default: '3/4'
  assign enable_zoom = section.settings.enable_image_zoom
  assign enable_lightbox = section.settings.enable_lightbox

  # Layout settings
  assign max_width = section.settings.container_width | default: 1380
  assign column_ratio = section.settings.column_ratio | default: '4.8:5:3.4'
  
  assign col_media = '4.8fr'
  assign col_info = '5fr'
  assign col_buybox = '3.4fr'
  if column_ratio == '4.5:4.5:3'
    assign col_media = '4.5fr'
    assign col_info = '4.5fr'
    assign col_buybox = '3fr'
  elsif column_ratio == '5:4:3'
    assign col_media = '5fr'
    assign col_info = '4fr'
    assign col_buybox = '3fr'
  elsif column_ratio == '4:5:3'
    assign col_media = '4fr'
    assign col_info = '5fr'
    assign col_buybox = '3fr'
  endif
-%}

<div
  class="enamels-pdp-page"
  id="enamels-pdp-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  style="
    --pdp-gallery-fit: {{ gallery_fit }};
    --pdp-gallery-ratio: {{ gallery_ratio }};
    --pdp-col-media: {{ col_media }};
    --pdp-col-info: {{ col_info }};
    --pdp-col-buybox: {{ col_buybox }};
    --pdp-btn-bg: {{ section.settings.atc_btn_bg | default: '#102a43' }};
    --pdp-btn-color: {{ section.settings.atc_btn_color | default: '#ffffff' }};
    --pdp-buynow-bg: {{ section.settings.buy_now_btn_bg | default: '#008779' }};
    --pdp-buynow-color: {{ section.settings.buy_now_btn_color | default: '#ffffff' }};
    --pdp-btn-radius: {{ section.settings.btn_border_radius | default: 8 }}px;
    padding-top: {{ section.settings.padding_top | default: 20 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    {% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}
  "
>
  <div class="page-container pdp-shell-container" style="max-width: {{ max_width }}px; margin: 0 auto; padding: 0 20px;">

    {%- if section.settings.show_breadcrumbs -%}
      <!-- Breadcrumb Navigation -->
      <nav class="enamels-pdp-breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="breadcrumb-sep" aria-hidden="true">›</span>
        {%- if product.collections.size > 0 -%}
          <a href="{{ product.collections.first.url }}">{{ product.collections.first.title | escape }}</a>
          <span class="breadcrumb-sep" aria-hidden="true">›</span>
        {%- endif -%}
        {%- if product.type != blank -%}
          <a href="{{ routes.all_products_collection_url }}?filter.p.product_type={{ product.type | url_encode }}">{{ product.type | escape }}</a>
          <span class="breadcrumb-sep" aria-hidden="true">›</span>
        {%- endif -%}
        <span class="breadcrumb-current" aria-current="page">{{ product.title | escape }}</span>
      </nav>
    {%- endif -%}

    <!-- 3-COLUMN AMAZON PDP GRID -->
    <div class="enamels-pdp-grid">

      <!-- ======================================================================
           COLUMN 1: ADVANCED PRODUCT MEDIA GALLERY
           ====================================================================== -->
      <div class="enamels-pdp-media-col" id="pdp-media-col-{{ section.id }}">
        
        <!-- Thumbnails Rail -->
        {%- if product.media.size > 1 -%}
          <div class="enamels-pdp-thumbs-rail" id="pdp-thumbs-rail-{{ section.id }}" role="tablist" aria-label="Product Media Thumbnails">
            {%- for media in product.media -%}
              <button
                type="button"
                role="tab"
                class="pdp-thumb-item {% if forloop.first %}active{% endif %}"
                data-media-id="{{ media.id }}"
                data-media-type="{{ media.media_type }}"
                data-media-url="{{ media | image_url: width: 1400 }}"
                {% if media.media_type == 'video' %}
                  data-video-url="{{ media.sources[0].url }}"
                {% endif %}
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="Thumbnail {{ forloop.index }} of {{ product.media.size }}"
              >
                <img
                  src="{{ media | image_url: width: 140, height: 180, crop: 'center' }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  class="pdp-thumb-img"
                  width="70"
                  height="90"
                  loading="lazy"
                />
                {%- if media.media_type == 'video' -%}
                  <span class="pdp-thumb-video-icon" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                  </span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Main Product Media Stage -->
        <div class="enamels-pdp-main-stage aspect-{{ gallery_ratio | replace: '/', '_' }}" id="pdp-main-stage-{{ section.id }}">
          
          <!-- Badge Overlay (Sale / Bestseller) -->
          <div class="pdp-badge-overlay">
            {%- if has_discount -%}
              <span class="pdp-badge-sale" id="pdp-media-badge-sale">
                -{{ savings_pct }}% OFF
              </span>
            {%- elsif product.tags contains 'bestseller' or product.tags contains 'Bestseller' or product.tags contains 'best-seller' -%}
              <span class="pdp-badge-bestseller">
                ★ BESTSELLER
              </span>
            {%- endif -%}
          </div>

          <!-- Fullscreen Expand Button -->
          {%- if enable_lightbox -%}
            <button
              type="button"
              class="pdp-media-fullscreen-btn pdp-stage-zoom-btn"
              id="pdp-expand-modal-btn-{{ section.id }}"
              aria-label="View Fullscreen High-Resolution Image"
              title="Expand to Fullscreen"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
              </svg>
            </button>
          {%- endif -%}

          <!-- Main Media Wrapper -->
          <div
            class="pdp-main-media-wrap pdp-stage-media-wrap"
            id="pdp-main-wrap-{{ section.id }}"
            {% if enable_zoom %}data-zoom-enabled="true"{% endif %}
          >
            {%- if featured_media.media_type == 'video' -%}
              <video
                id="pdp-main-video-{{ section.id }}"
                class="pdp-main-video active"
                controls
                playsinline
                preload="metadata"
                poster="{{ featured_media.preview_image | image_url: width: 1000 }}"
              >
                {%- for source in featured_media.sources -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
                Your browser does not support video playback.
              </video>
              <img
                id="pdp-main-img-{{ section.id }}"
                class="pdp-main-img pdp-stage-img fit-{{ gallery_fit }}"
                src="{{ featured_media.preview_image | image_url: width: 1200 }}"
                alt="{{ featured_media.alt | default: product.title | escape }}"
                width="800"
                height="1000"
                style="display: none;"
              />
            {%- elsif featured_media != blank -%}
              <img
                id="pdp-main-img-{{ section.id }}"
                class="pdp-main-img pdp-stage-img fit-{{ gallery_fit }}"
                src="{{ featured_media | image_url: width: 1200 }}"
                alt="{{ featured_media.alt | default: product.title | escape }}"
                width="800"
                height="1000"
                loading="eager"
                fetchpriority="high"
                data-highres-url="{{ featured_media | image_url: width: 2000 }}"
              />
            {%- else -%}
              <div class="pdp-media-placeholder" style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 380px; color: #94a3b8; gap: 8px;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
                <span style="font-size: 13px; font-weight: 600;">Clinical Product Imagery</span>
              </div>
            {%- endif -%}

            {%- if enable_zoom -%}
              <!-- Hover Zoom Lens Canvas / Overlay (Desktop) -->
              <div class="pdp-media-zoom-overlay" id="pdp-zoom-overlay-{{ section.id }}" aria-hidden="true"></div>
            {%- endif -%}
          </div>

          <!-- Mobile / Tablet Navigation Arrows -->
          {%- if product.media.size > 1 -%}
            <button type="button" class="pdp-media-nav-prev" id="pdp-media-prev-{{ section.id }}" aria-label="Previous Media">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button type="button" class="pdp-media-nav-next" id="pdp-media-next-{{ section.id }}" aria-label="Next Media">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>

            <!-- Mobile Dots Pagination Indicator -->
            <div class="pdp-mobile-dots" id="pdp-mobile-dots-{{ section.id }}" aria-hidden="true">
              {%- for media in product.media -%}
                <span class="pdp-mobile-dot {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}"></span>
              {%- endfor -%}
            </div>
          {%- endif -%}

        </div>
      </div>


      <!-- ======================================================================
           COLUMN 2: PRODUCT INFORMATION, VARIANTS & SPECIFICATIONS
           ====================================================================== -->
      <div class="enamels-pdp-info-col" id="pdp-info-col-{{ section.id }}">
        
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'vendor_sku' -%}
              <!-- Brand / Vendor & SKU Row -->
              <div class="pdp-vendor-row pdp-vendor-sku-row" {{ block.shopify_attributes }}>
                {%- if block.settings.show_vendor and product.vendor != blank -%}
                  <a href="{{ product.vendor | url_for_vendor }}" class="pdp-vendor-link">
                    {{ product.vendor | default: 'ENAMELS' | escape }}
                  </a>
                {%- endif -%}

                {%- if block.settings.show_sku and current_variant.sku != blank -%}
                  <span class="pdp-sku-badge" id="pdp-live-sku">
                    SKU: <strong>{{ current_variant.sku }}</strong>
                  </span>
                {%- endif -%}

                {%- if block.settings.show_article_name and product.metafields.custom.article_name != blank -%}
                  <span class="pdp-article-badge">
                    Article: {{ product.metafields.custom.article_name | escape }}
                  </span>
                {%- endif -%}

                {%- if block.settings.show_category and product.type != blank -%}
                  <span class="pdp-article-badge">
                    {{ product.type | escape }}
                  </span>
                {%- endif -%}
              </div>

            {%- when 'title_rating' -%}
              <!-- Product Title & Verified Ratings Row -->
              <div class="pdp-title-rating-block" {{ block.shopify_attributes }}>
                <h1 class="pdp-main-title pdp-title" style="font-size: {{ block.settings.title_size | default: 26 }}px;">
                  {{ product.title | escape }}
                </h1>

                {%- if block.settings.show_rating -%}
                  <div class="pdp-rating-row">
                    <div class="pdp-stars pdp-stars-visual" aria-label="Rating: {{ block.settings.rating_score | default: '4.9' }} out of 5 stars">
                      ★★★★★
                    </div>
                    <span class="pdp-rating-score pdp-rating-num">{{ block.settings.rating_score | default: '4.9' }}</span>
                    <a href="#pdp-reviews-section-{{ section.id }}" class="pdp-reviews-count pdp-reviews-link" onclick="document.getElementById('pdp-reviews-section-{{ section.id }}')?.scrollIntoView({behavior: 'smooth'}); return false;">
                      ({{ block.settings.reviews_count | default: '128' }} verified ratings)
                    </a>
                    {%- if block.settings.show_verified_badge -%}
                      <span class="pdp-verified-badge">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                        </svg>
                        Verified Clinical Grade
                      </span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>

            {%- when 'price' -%}
              <!-- Pricing & Savings Block -->
              <div class="pdp-price-box" {{ block.shopify_attributes }}>
                {%- if has_discount and block.settings.show_discount_badge -%}
                  <div class="pdp-sale-badge-pill" id="pdp-sale-pill">
                    Limited Time Offer — Save {{ savings_pct }}%
                  </div>
                {%- endif -%}

                <div class="pdp-price-wrap">
                  <span class="pdp-price-current pdp-current-price" id="pdp-live-price">
                    {{ current_variant.price | money }}
                  </span>

                  {%- if block.settings.show_compare_at_price -%}
                    <span
                      class="pdp-price-compare pdp-compare-price"
                      id="pdp-live-compare-price"
                      {% unless has_discount %}style="display: none;"{% endunless %}
                    >
                      {{ current_variant.compare_at_price | money }}
                    </span>
                  {%- endif -%}

                  {%- if block.settings.show_discount_badge -%}
                    <span
                      class="pdp-discount-pill pdp-save-badge"
                      id="pdp-live-savings-badge"
                      {% unless has_discount %}style="display: none;"{% endunless %}
                    >
                      Save {{ savings_amount | money }} ({{ savings_pct }}%)
                    </span>
                  {%- endif -%}
                </div>

                {%- if block.settings.show_tax_note -%}
                  <div class="pdp-tax-note">
                    {{ block.settings.tax_note_text | default: 'Inclusive of all taxes. Free delivery on orders over PKR 7,000 in Pakistan.' }}
                  </div>
                {%- endif -%}
              </div>

            {%- when 'variant_picker' -%}
              <!-- Advanced Variant Selection (Color Swatches & Size Chips) -->
              <div class="pdp-variant-picker-block" {{ block.shopify_attributes }} id="pdp-variant-picker-{{ section.id }}">
                
                {%- unless product.has_only_default_variant -%}
                  {%- for option in product.options_with_values -%}
                    {%- assign option_name_downcase = option.name | downcase -%}

                    <!-- COLOR OPTION (Swatches) -->
                    {%- if option_name_downcase contains 'color' or option_name_downcase contains 'colour' or option_name_downcase contains 'shade' -%}
                      <div class="pdp-option-group pdp-color-group" data-option-index="{{ forloop.index0 }}">
                        <div class="pdp-option-header">
                          <span class="pdp-option-label">{{ option.name }}:</span>
                          <span class="pdp-selected-val" id="pdp-selected-color-label">{{ option.selected_value }}</span>
                        </div>

                        <div class="pdp-swatches-grid" role="radiogroup" aria-label="{{ option.name }}">
                          {%- for value in option.values -%}
                            {%- liquid
                              # Find matching variant for swatch image
                              assign swatch_variant = null
                              for v in product.variants
                                if v.options[forloop.parentloop.index0] == value
                                  assign swatch_variant = v
                                  break
                                endif
                              endfor

                              # CSS Color Fallback
                              assign color_slug = value | downcase | replace: ' ', '-'
                            -%}

                            <button
                              type="button"
                              role="radio"
                              class="pdp-swatch-chip {% if option.selected_value == value %}selected active{% endif %}"
                              data-option-index="{{ forloop.parentloop.index0 }}"
                              data-value="{{ value | escape }}"
                              data-color-slug="{{ color_slug }}"
                              {% if swatch_variant.featured_media != blank %}
                                data-variant-media-id="{{ swatch_variant.featured_media.id }}"
                                data-variant-img="{{ swatch_variant.featured_media | image_url: width: 1400 }}"
                              {% endif %}
                              aria-checked="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                              aria-label="{{ value | escape }}"
                            >
                              <span class="pdp-swatch-color-circle pdp-swatch-dot" style="background-color: var(--color-{{ color_slug }}, #008779);">
                                {%- if swatch_variant.featured_media != blank -%}
                                  <img
                                    src="{{ swatch_variant.featured_media | image_url: width: 64, height: 64, crop: 'center' }}"
                                    alt="{{ value | escape }}"
                                    class="pdp-swatch-img"
                                    width="28"
                                    height="28"
                                    loading="lazy"
                                  />
                                {%- endif -%}
                              </span>
                              <span class="pdp-swatch-label">{{ value }}</span>
                            </button>
                          {%- endfor -%}
                        </div>
                      </div>

                    <!-- SIZE OPTION (Interactive Chips & Size Guide) -->
                    {%- elsif option_name_downcase contains 'size' -%}
                      <div class="pdp-option-group pdp-size-group" data-option-index="{{ forloop.index0 }}">
                        <div class="pdp-option-header">
                          <div class="pdp-option-label-wrap">
                            <span class="pdp-option-label">{{ option.name }}:</span>
                            <span class="pdp-selected-val" id="pdp-selected-size-label">{{ option.selected_value }}</span>
                          </div>

                          <!-- Size Guide Trigger Button -->
                          {%- if block.settings.show_size_guide_btn -%}
                            <button
                              type="button"
                              class="pdp-size-guide-btn pdp-size-guide-trigger"
                              id="pdp-open-size-chart-btn"
                              aria-haspopup="dialog"
                            >
                              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="2" y="6" width="20" height="12" rx="2"/>
                                <line x1="6" y1="6" x2="6" y2="10"/>
                                <line x1="10" y1="6" x2="10" y2="13"/>
                                <line x1="14" y1="6" x2="14" y2="10"/>
                                <line x1="18" y1="6" x2="18" y2="13"/>
                              </svg>
                              Size Guide & Measurements
                            </button>
                          {%- endif -%}
                        </div>

                        <div class="pdp-sizes-grid pdp-sizes-bar" role="radiogroup" aria-label="{{ option.name }}">
                          {%- for value in option.values -%}
                            {%- liquid
                              # Check variant availability for this size
                              assign size_available = false
                              for v in product.variants
                                if v.options[forloop.parentloop.index0] == value and v.available
                                  assign size_available = true
                                  break
                                endif
                              endfor
                            -%}

                            <button
                              type="button"
                              role="radio"
                              class="pdp-size-pill pdp-size-btn {% if option.selected_value == value %}selected active{% endif %} {% unless size_available %}unavailable is-sold-out{% endunless %}"
                              data-option-index="{{ forloop.parentloop.index0 }}"
                              data-value="{{ value | escape }}"
                              data-available="{{ size_available }}"
                              aria-checked="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                              aria-label="{{ value | escape }} {% unless size_available %}(Sold Out){% endunless %}"
                            >
                              <span class="pdp-size-text">{{ value }}</span>
                              {%- unless size_available -%}
                                <span class="pdp-size-soldout-line" aria-hidden="true"></span>
                              {%- endunless -%}
                            </button>
                          {%- endfor -%}
                        </div>
                      </div>

                    <!-- OTHER GENERIC OPTIONS (e.g. Fit, Sleeve Length) -->
                    {%- else -%}
                      <div class="pdp-option-group" data-option-index="{{ forloop.index0 }}">
                        <div class="pdp-option-header">
                          <span class="pdp-option-label">{{ option.name }}:</span>
                          <span class="pdp-selected-val">{{ option.selected_value }}</span>
                        </div>

                        <div class="pdp-sizes-grid pdp-sizes-bar" role="radiogroup" aria-label="{{ option.name }}">
                          {%- for value in option.values -%}
                            <button
                              type="button"
                              role="radio"
                              class="pdp-size-pill pdp-size-btn {% if option.selected_value == value %}selected active{% endif %}"
                              data-option-index="{{ forloop.parentloop.index0 }}"
                              data-value="{{ value | escape }}"
                              aria-checked="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                            >
                              <span class="pdp-size-text">{{ value }}</span>
                            </button>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endif -%}

                  {%- endfor -%}
                {%- endunless -%}

              </div>

            {%- when 'customization' -%}
              <!-- Medical Embroidery & Name Engraving Customization Block -->
              {%- if block.settings.enable_customization -%}
                <div class="pdp-customization-box pdp-customization-card" {{ block.shopify_attributes }} id="pdp-customization-section-{{ section.id }}">
                  <div class="pdp-custom-header">
                    <div class="pdp-custom-title-row">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#008779" stroke-width="2">
                        <path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                      </svg>
                      <h3 class="pdp-custom-title">{{ block.settings.custom_title | default: 'Doctor Name & Credentials Personalization' }}</h3>
                    </div>
                    <label class="pdp-custom-toggle-label">
                      <input type="checkbox" id="pdp-custom-checkbox-{{ section.id }}" class="pdp-custom-toggle-input" />
                      <span class="pdp-custom-toggle-text">Add Personalization</span>
                    </label>
                  </div>

                  <div class="pdp-custom-body" id="pdp-custom-body-{{ section.id }}" style="display: none;">
                    <p class="pdp-custom-desc">
                      {{ block.settings.custom_desc | default: 'Precision computerized clinical embroidery. Please provide your name, title, and preferred thread color.' }}
                    </p>

                    <div class="pdp-custom-fields-grid">
                      <!-- Field 1: Doctor Name -->
                      <div class="pdp-custom-field pdp-field-full">
                        <label for="pdp-doctor-name-input-{{ section.id }}" class="pdp-field-label">
                          Name & Credentials (e.g., Dr. Sameer Ahmed, MBBS):
                        </label>
                        <input
                          type="text"
                          id="pdp-doctor-name-input-{{ section.id }}"
                          class="pdp-custom-input"
                          placeholder="Dr. Full Name, FCPS / MBBS"
                          maxlength="45"
                        />
                      </div>

                      <!-- Field 2: Customization Type -->
                      <div class="pdp-custom-field">
                        <label for="pdp-custom-type-select-{{ section.id }}" class="pdp-field-label">
