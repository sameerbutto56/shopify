       MOBILE STICKY BUY BAR (Fixed at viewport bottom on mobile)
       ====================================================================== -->
  <div class="enamels-pdp-sticky-bar pdp-mobile-sticky-bar" id="pdp-mobile-sticky-bar-{{ section.id }}" aria-hidden="true">
    <div class="pdp-sticky-content pdp-mobile-sticky-info">
      {%- if featured_media != blank -%}
        <img
          src="{{ featured_media | image_url: width: 90, height: 90, crop: 'center' }}"
          alt="{{ product.title | escape }}"
          class="pdp-mobile-sticky-thumb"
          width="44"
          height="44"
          id="pdp-mobile-sticky-thumb"
        />
      {%- endif -%}
      <div class="pdp-sticky-meta pdp-mobile-sticky-text">
        <div class="pdp-sticky-title pdp-mobile-sticky-title">{{ product.title | truncate: 28 }}</div>
        <div class="pdp-sticky-price pdp-mobile-sticky-price" id="pdp-mobile-sticky-price">{{ current_variant.price | money }}</div>
      </div>
    </div>

    <button
      type="button"
      class="pdp-sticky-atc-btn pdp-mobile-sticky-btn"
      id="pdp-mobile-sticky-atc-btn"
      {% unless current_variant.available %}disabled{% endunless %}
    >
      {%- if current_variant.available -%}
        Add to Cart
      {%- else -%}
        Sold Out
      {%- endif -%}
    </button>
  </div>


  <!-- ======================================================================
       MODAL 1: SIZE GUIDE & MEASUREMENTS MODAL
       ====================================================================== -->
  <div class="pdp-modal-overlay pdp-size-modal-backdrop" id="pdp-size-guide-modal-{{ section.id }}" role="dialog" aria-modal="true" aria-labelledby="pdp-size-guide-title" style="display: none;">
    <div class="pdp-modal-dialog pdp-size-modal-card">
      <div class="pdp-modal-header">
        <h3 class="pdp-modal-title" id="pdp-size-guide-title">Enamels Medical Scrubs — Official Size Chart</h3>
        <button type="button" class="pdp-modal-close" id="pdp-close-size-guide-btn" aria-label="Close modal">✕</button>
      </div>

      <div class="pdp-modal-body">
        <p style="font-size: 13px; color: #64748b; margin-bottom: 16px;">
          All measurements are taken flat across the garment. If you fall between two sizes, choose the larger size for a relaxed clinical fit or the smaller size for a tailored fit.
        </p>

        <!-- Top Size Chart Table -->
        <h4 style="font-size: 14px; font-weight: 700; color: #102a43; margin-bottom: 8px;">Scrub Top (Inches)</h4>
        <div class="pdp-table-scroll">
          <table class="pdp-size-chart-table pdp-size-table">
            <thead>
              <tr>
                <th>Size</th>
                <th>Chest</th>
                <th>Length</th>
                <th>Shoulder</th>
                <th>Sleeve</th>
              </tr>
            </thead>
            <tbody>
              <tr><td><strong>XS</strong></td><td>36"</td><td>27"</td><td>16.5"</td><td>7.5"</td></tr>
              <tr><td><strong>S</strong></td><td>38"</td><td>28"</td><td>17.5"</td><td>8.0"</td></tr>
              <tr><td><strong>M</strong></td><td>40"</td><td>29"</td><td>18.5"</td><td>8.5"</td></tr>
              <tr><td><strong>L</strong></td><td>43"</td><td>30"</td><td>19.5"</td><td>9.0"</td></tr>
              <tr><td><strong>XL</strong></td><td>46"</td><td>31"</td><td>20.5"</td><td>9.5"</td></tr>
              <tr><td><strong>2XL</strong></td><td>49"</td><td>32"</td><td>21.5"</td><td>10.0"</td></tr>
            </tbody>
          </table>
        </div>

        <!-- Trouser Size Chart Table -->
        <h4 style="font-size: 14px; font-weight: 700; color: #102a43; margin: 20px 0 8px;">Scrub Trouser / Pants (Inches)</h4>
        <div class="pdp-table-scroll">
          <table class="pdp-size-chart-table pdp-size-table">
            <thead>
              <tr>
                <th>Size</th>
                <th>Waist (Elastic)</th>
                <th>Hips</th>
                <th>Inseam</th>
                <th>Thigh</th>
              </tr>
            </thead>
            <tbody>
              <tr><td><strong>XS</strong></td><td>26" - 29"</td><td>37"</td><td>29"</td><td>22"</td></tr>
              <tr><td><strong>S</strong></td><td>29" - 32"</td><td>39"</td><td>30"</td><td>23"</td></tr>
              <tr><td><strong>M</strong></td><td>32" - 35"</td><td>42"</td><td>30.5"</td><td>24.5"</td></tr>
              <tr><td><strong>L</strong></td><td>35" - 38"</td><td>45"</td><td>31"</td><td>26"</td></tr>
              <tr><td><strong>XL</strong></td><td>38" - 42"</td><td>48"</td><td>31.5"</td><td>27.5"</td></tr>
              <tr><td><strong>2XL</strong></td><td>42" - 46"</td><td>51"</td><td>32"</td><td>29"</td></tr>
            </tbody>
          </table>
        </div>

        <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 12px 16px; margin-top: 18px; display: flex; align-items: center; gap: 10px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <span style="font-size: 13px; color: #166534; font-weight: 500;">
            Backed by Enamels 7-Day Size Exchange Guarantee across Pakistan.
          </span>
        </div>
      </div>
    </div>
  </div>


  <!-- ======================================================================
       MODAL 2: FULLSCREEN HIGH-RESOLUTION MEDIA LIGHTBOX
       ====================================================================== -->
  <div class="pdp-modal-overlay pdp-lightbox-overlay" id="pdp-fullscreen-modal-{{ section.id }}" role="dialog" aria-modal="true" style="display: none;">
    <button type="button" class="pdp-lightbox-close" id="pdp-close-fullscreen-btn" aria-label="Close Lightbox">✕</button>
    <div class="pdp-lightbox-body">
      <img src="" id="pdp-lightbox-img" class="pdp-lightbox-img" alt="{{ product.title | escape }}" />
    </div>
  </div>

</div><!-- /.enamels-pdp-page -->


<!-- ==========================================================================
     CLIENT-SIDE REAL-TIME VARIANT SYNCHRONIZATION & INTERACTIVITY SCRIPT
     ========================================================================== -->
<script>
  (function() {
    // Serialized product variants from Shopify Liquid
    const productVariants = {{ product.variants | json }};
    const productOptions = {{ product.options_with_values | json }};
    const sectionId = "{{ section.id }}";
    const container = document.getElementById("enamels-pdp-" + sectionId);
    if (!container) return;

    // Currency Formatting Symbol
    const currencySymbol = "{{ cart.currency.symbol | default: 'Rs.' }}";

    // State tracking
    let selectedOptions = [];
    {%- for option in product.options_with_values -%}
      selectedOptions[{{ forloop.index0 }}] = "{{ option.selected_value | escape }}";
    {%- endfor -%}

    let activeVariant = productVariants[0];
    const initialVariantId = {{ current_variant.id }};
    const foundInitial = productVariants.find(v => v.id === initialVariantId);
    if (foundInitial) {
      activeVariant = foundInitial;
      selectedOptions = [...activeVariant.options];
    }

    // Elements
    const mainImg = document.getElementById("pdp-main-img-" + sectionId);
    const mainVideo = document.getElementById("pdp-main-video-" + sectionId);
    const mainWrap = document.getElementById("pdp-main-wrap-" + sectionId);
    const thumbsRail = document.getElementById("pdp-thumbs-rail-" + sectionId);
    const thumbButtons = container.querySelectorAll(".pdp-thumb-item");
    const mobileDots = container.querySelectorAll(".pdp-mobile-dot");

    const livePriceEl = document.getElementById("pdp-live-price");
    const liveCompareEl = document.getElementById("pdp-live-compare-price");
    const liveSavingsEl = document.getElementById("pdp-live-savings-badge");
    const salePillEl = document.getElementById("pdp-sale-pill");
    const mediaBadgeSaleEl = document.getElementById("pdp-media-badge-sale");

    const buyboxPriceEl = document.getElementById("pdp-buybox-price-display");
    const buyboxCompareEl = document.getElementById("pdp-buybox-compare-display");
    const stockBadge = document.getElementById("pdp-stock-badge");
    const stockText = document.getElementById("pdp-stock-text");
    const liveSku = document.getElementById("pdp-live-sku");

    const activeVariantInput = document.getElementById("pdp-active-variant-id");
    const atcBtn = document.getElementById("pdp-submit-atc-btn-" + sectionId);
    const buyNowBtn = document.getElementById("pdp-submit-buy-now-btn-" + sectionId);
    const atcBtnText = document.getElementById("pdp-atc-btn-text");

    const mobileStickyBar = document.getElementById("pdp-mobile-sticky-bar-" + sectionId);
    const mobileStickyPrice = document.getElementById("pdp-mobile-sticky-price");
    const mobileStickyAtcBtn = document.getElementById("pdp-mobile-sticky-atc-btn");
    const mobileStickyThumb = document.getElementById("pdp-mobile-sticky-thumb");

    const qtyInput = document.getElementById("pdp-qty-input-" + sectionId);
    const qtyMinus = document.getElementById("pdp-qty-minus-" + sectionId);
    const qtyPlus = document.getElementById("pdp-qty-plus-" + sectionId);

    // Customization elements
    const customCheckbox = document.getElementById("pdp-custom-checkbox-" + sectionId);
    const customBody = document.getElementById("pdp-custom-body-" + sectionId);
    const doctorNameInput = document.getElementById("pdp-doctor-name-input-" + sectionId);
    const customTypeSelect = document.getElementById("pdp-custom-type-select-" + sectionId);
    const threadColorSelect = document.getElementById("pdp-thread-color-select-" + sectionId);
    const customNotesTextarea = document.getElementById("pdp-custom-notes-" + sectionId);

    // Currency Formatter Helper
    function formatMoney(cents) {
      if (!cents && cents !== 0) return '';
      const amount = (cents / 100).toLocaleString('en-PK', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
      return `${currencySymbol} ${amount}`;
    }

    // -------------------------------------------------------------------------
    // 1. VARIANT SYNCHRONIZATION
    // -------------------------------------------------------------------------
    function updateVariantUI() {
      // Find matching variant based on selectedOptions array
      const matchedVariant = productVariants.find(variant => {
        return variant.options.every((optVal, idx) => optVal === selectedOptions[idx]);
      });

      if (matchedVariant) {
        activeVariant = matchedVariant;
        if (activeVariantInput) activeVariantInput.value = matchedVariant.id;

        // Price formatting
        const priceFormatted = formatMoney(matchedVariant.price);
        if (livePriceEl) livePriceEl.textContent = priceFormatted;
        if (buyboxPriceEl) buyboxPriceEl.textContent = priceFormatted;
        if (mobileStickyPrice) mobileStickyPrice.textContent = priceFormatted;

        // Compare price & savings
        if (matchedVariant.compare_at_price && matchedVariant.compare_at_price > matchedVariant.price) {
          const compFormatted = formatMoney(matchedVariant.compare_at_price);
          const saveAmount = matchedVariant.compare_at_price - matchedVariant.price;
          const savePct = Math.round((saveAmount / matchedVariant.compare_at_price) * 100);

          if (liveCompareEl) {
            liveCompareEl.textContent = compFormatted;
            liveCompareEl.style.display = 'inline';
          }
          if (buyboxCompareEl) {
            buyboxCompareEl.textContent = compFormatted;
            buyboxCompareEl.style.display = 'inline';
          }
          if (liveSavingsEl) {
            liveSavingsEl.textContent = `Save ${formatMoney(saveAmount)} (${savePct}%)`;
            liveSavingsEl.style.display = 'inline';
          }
          if (salePillEl) {
            salePillEl.textContent = `Limited Time Offer — Save ${savePct}%`;
            salePillEl.style.display = 'inline-block';
          }
          if (mediaBadgeSaleEl) {
            mediaBadgeSaleEl.textContent = `-${savePct}% OFF`;
            mediaBadgeSaleEl.style.display = 'inline-block';
          }
        } else {
          if (liveCompareEl) liveCompareEl.style.display = 'none';
          if (buyboxCompareEl) buyboxCompareEl.style.display = 'none';
          if (liveSavingsEl) liveSavingsEl.style.display = 'none';
          if (salePillEl) salePillEl.style.display = 'none';
          if (mediaBadgeSaleEl) mediaBadgeSaleEl.style.display = 'none';
        }

        // SKU
        if (liveSku) {
          if (matchedVariant.sku) {
            liveSku.innerHTML = `SKU: <strong>${matchedVariant.sku}</strong>`;
            liveSku.style.display = 'inline-block';
          } else {
            liveSku.style.display = 'none';
          }
        }

        // Availability & Stock status
        if (matchedVariant.available) {
          if (stockBadge) {
            stockBadge.className = 'buybox-stock-status pdp-stock-status in-stock';
          }
          if (stockText) {
            stockText.textContent = 'In Stock & Ready to Ship';
          }
          if (atcBtn) {
            atcBtn.removeAttribute('disabled');
            if (atcBtnText) {
              atcBtnText.innerHTML = `
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="vertical-align: middle; margin-right: 6px;">
                  <circle cx="9" cy="21" r="1"></circle>
                  <circle cx="20" cy="21" r="1"></circle>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                {{ section.settings.atc_btn_text | default: 'Add to Cart' }}
              `;
            }
          }
          if (buyNowBtn) {
            buyNowBtn.removeAttribute('disabled');
            buyNowBtn.style.display = 'flex';
          }
          if (mobileStickyAtcBtn) {
            mobileStickyAtcBtn.removeAttribute('disabled');
            mobileStickyAtcBtn.textContent = 'Add to Cart';
          }
        } else {
          if (stockBadge) {
            stockBadge.className = 'buybox-stock-status pdp-stock-status out-of-stock';
          }
          if (stockText) {
            stockText.textContent = 'Currently Sold Out';
          }
          if (atcBtn) {
            atcBtn.setAttribute('disabled', 'disabled');
            if (atcBtnText) atcBtnText.textContent = 'Sold Out';
          }
          if (buyNowBtn) {
            buyNowBtn.setAttribute('disabled', 'disabled');
            buyNowBtn.style.display = 'none';
          }
          if (mobileStickyAtcBtn) {
            mobileStickyAtcBtn.setAttribute('disabled', 'disabled');
            mobileStickyAtcBtn.textContent = 'Sold Out';
          }
        }

        // Update Size Pills availability state based on currently selected color
        updateSizeAvailability();

        // Variant Featured Image Switch
        if (matchedVariant.featured_media && matchedVariant.featured_media.src) {
          switchMainImage(matchedVariant.featured_media.src, matchedVariant.featured_media.id);
        }

        // Update URL parameter without reload
        if (window.history && window.history.replaceState) {
          const newUrl = new URL(window.location.href);
          newUrl.searchParams.set('variant', matchedVariant.id);
          window.history.replaceState(null, '', newUrl.toString());
        }
      }
    }

    // Helper: Update size pills availability when color changes
    function updateSizeAvailability() {
      const sizePills = container.querySelectorAll('.pdp-size-pill');
      sizePills.forEach(pill => {
        const optIdx = parseInt(pill.getAttribute('data-option-index'), 10);
        const sizeVal = pill.getAttribute('data-value');
        
        // Check if there is an available variant with selectedOptions for other options + this size
        const isAvail = productVariants.some(v => {
          return v.available && v.options.every((opt, i) => {
            if (i === optIdx) return opt === sizeVal;
            return opt === selectedOptions[i];
          });
        });

        if (isAvail) {
          pill.classList.remove('unavailable', 'is-sold-out');
          pill.setAttribute('data-available', 'true');
        } else {
          pill.classList.add('unavailable', 'is-sold-out');
          pill.setAttribute('data-available', 'false');
        }
      });
    }

    // -------------------------------------------------------------------------
    // 2. MEDIA GALLERY SWITCHER
    // -------------------------------------------------------------------------
    function switchMainImage(imgUrl, mediaId) {
      if (!imgUrl) return;

      if (mainVideo) {
        mainVideo.pause();
        mainVideo.style.display = 'none';
      }

      if (mainImg) {
        mainImg.style.display = 'block';
        mainImg.src = imgUrl;
        mainImg.setAttribute('data-highres-url', imgUrl);
      }

      if (mobileStickyThumb) {
        mobileStickyThumb.src = imgUrl;
      }

      // Highlight matching thumbnail
      if (mediaId && thumbButtons.length > 0) {
        thumbButtons.forEach(btn => {
          if (btn.getAttribute('data-media-id') === String(mediaId)) {
            btn.classList.add('active');
            btn.setAttribute('aria-selected', 'true');
            btn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } else {
            btn.classList.remove('active');
            btn.setAttribute('aria-selected', 'false');
          }
        });
      }
    }

    function switchMainVideo(videoUrl, posterUrl) {
      if (mainImg) mainImg.style.display = 'none';
      if (mainVideo) {
        mainVideo.style.display = 'block';
        mainVideo.src = videoUrl;
        if (posterUrl) mainVideo.poster = posterUrl;
        mainVideo.load();
        mainVideo.play().catch(() => {});
      }
    }

    // Thumb click handlers
    thumbButtons.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        const mType = btn.getAttribute('data-media-type');
        const mUrl = btn.getAttribute('data-media-url');
        const mId = btn.getAttribute('data-media-id');

        thumbButtons.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        // Sync mobile dots
        if (mobileDots[idx]) {
          mobileDots.forEach(d => d.classList.remove('active'));
          mobileDots[idx].classList.add('active');
        }

        if (mType === 'video') {
          const vUrl = btn.getAttribute('data-video-url');
          switchMainVideo(vUrl, mUrl);
        } else {
          switchMainImage(mUrl, mId);
        }
      });
    });

    // Mobile swipe and prev/next handlers
    let currentMediaIndex = 0;
    const prevBtn = document.getElementById("pdp-media-prev-" + sectionId);
    const nextBtn = document.getElementById("pdp-media-next-" + sectionId);

    function showMediaAtIndex(index) {
      if (index < 0) index = thumbButtons.length - 1;
      if (index >= thumbButtons.length) index = 0;
      currentMediaIndex = index;
      if (thumbButtons[index]) {
        thumbButtons[index].click();
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => showMediaAtIndex(currentMediaIndex - 1));
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', () => showMediaAtIndex(currentMediaIndex + 1));
    }

    // Touch Swipe on Main Stage
    if (mainWrap) {
      let touchStartX = 0;
      let touchEndX = 0;
      mainWrap.addEventListener('touchstart', e => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      mainWrap.addEventListener('touchend', e => {
        touchEndX = e.changedTouches[0].screenX;
        if (touchStartX - touchEndX > 45) {
          showMediaAtIndex(currentMediaIndex + 1); // Swipe left -> next
        } else if (touchEndX - touchStartX > 45) {
          showMediaAtIndex(currentMediaIndex - 1); // Swipe right -> prev
        }
      }, { passive: true });
    }

    // Desktop Hover Zoom Effect
    const zoomOverlay = document.getElementById("pdp-zoom-overlay-" + sectionId);
    if (mainWrap && mainWrap.getAttribute('data-zoom-enabled') === 'true' && zoomOverlay && mainImg) {
      mainWrap.addEventListener('mouseenter', () => {
        if (window.innerWidth < 1024) return;
        const highRes = mainImg.getAttribute('data-highres-url') || mainImg.src;
        zoomOverlay.style.backgroundImage = `url('${highRes}')`;
        zoomOverlay.style.opacity = '1';
        zoomOverlay.style.pointerEvents = 'auto';
      });

      mainWrap.addEventListener('mousemove', e => {
        if (window.innerWidth < 1024) return;
        const rect = mainWrap.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        zoomOverlay.style.backgroundPosition = `${x}% ${y}%`;
      });

      mainWrap.addEventListener('mouseleave', () => {
        zoomOverlay.style.opacity = '0';
        zoomOverlay.style.pointerEvents = 'none';
      });
    }

    // Fullscreen Lightbox
    const expandBtn = document.getElementById("pdp-expand-modal-btn-" + sectionId);
    const fullscreenModal = document.getElementById("pdp-fullscreen-modal-" + sectionId);
    const closeFullscreenBtn = document.getElementById("pdp-close-fullscreen-btn");
    const lightboxImg = document.getElementById("pdp-lightbox-img");

    if (expandBtn && fullscreenModal && lightboxImg) {
      expandBtn.addEventListener('click', () => {
        const targetSrc = mainImg ? (mainImg.getAttribute('data-highres-url') || mainImg.src) : '';
        lightboxImg.src = targetSrc;
        fullscreenModal.style.display = 'flex';
      });

      if (closeFullscreenBtn) {
        closeFullscreenBtn.addEventListener('click', () => {
          fullscreenModal.style.display = 'none';
        });
      }
      fullscreenModal.addEventListener('click', (e) => {
        if (e.target === fullscreenModal) fullscreenModal.style.display = 'none';
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && fullscreenModal.style.display === 'flex') {
          fullscreenModal.style.display = 'none';
        }
      });
    }

    // -------------------------------------------------------------------------
    // 3. COLOR & SIZE OPTION SELECTION LISTENERS
    // -------------------------------------------------------------------------
    // Color Swatches
    const colorSwatches = container.querySelectorAll(".pdp-swatch-chip");
    const selectedColorLabel = document.getElementById("pdp-selected-color-label");

    colorSwatches.forEach(swatch => {
      swatch.addEventListener('click', () => {
        const optIdx = parseInt(swatch.getAttribute('data-option-index'), 10);
        const val = swatch.getAttribute('data-value');
        selectedOptions[optIdx] = val;

        colorSwatches.forEach(s => {
          s.classList.remove('selected', 'active');
          s.setAttribute('aria-checked', 'false');
        });
        swatch.classList.add('selected', 'active');
        swatch.setAttribute('aria-checked', 'true');

        if (selectedColorLabel) selectedColorLabel.textContent = val;

        // Image switch directly if swatch holds variant image
        const variantImg = swatch.getAttribute('data-variant-img');
        const variantMediaId = swatch.getAttribute('data-variant-media-id');
        if (variantImg) {
          switchMainImage(variantImg, variantMediaId);
        }

        updateVariantUI();
      });
    });

    // Size Pills
    const sizePills = container.querySelectorAll(".pdp-size-pill");
    const selectedSizeLabel = document.getElementById("pdp-selected-size-label");

    sizePills.forEach(pill => {
      pill.addEventListener('click', () => {
        const optIdx = parseInt(pill.getAttribute('data-option-index'), 10);
        const val = pill.getAttribute('data-value');
        selectedOptions[optIdx] = val;

        // Update siblings within same group
        const group = pill.closest('.pdp-option-group');
        if (group) {
          group.querySelectorAll('.pdp-size-pill').forEach(p => {
            p.classList.remove('selected', 'active');
            p.setAttribute('aria-checked', 'false');
          });
        }
        pill.classList.add('selected', 'active');
        pill.setAttribute('aria-checked', 'true');

        if (selectedSizeLabel) selectedSizeLabel.textContent = val;

        updateVariantUI();
      });
    });

    // -------------------------------------------------------------------------
    // 4. QUANTITY STEPPER
    // -------------------------------------------------------------------------
    if (qtyMinus && qtyPlus && qtyInput) {
      qtyMinus.addEventListener('click', () => {
        let val = parseInt(qtyInput.value, 10) || 1;
        if (val > 1) qtyInput.value = val - 1;
      });
      qtyPlus.addEventListener('click', () => {
        let val = parseInt(qtyInput.value, 10) || 1;
        if (val < 99) qtyInput.value = val + 1;
      });
    }

    // -------------------------------------------------------------------------
    // 5. CUSTOMIZATION TOGGLE & LINE ITEM PROPERTIES
    // -------------------------------------------------------------------------
    if (customCheckbox && customBody) {
      customCheckbox.addEventListener('change', () => {
        if (customCheckbox.checked) {
          customBody.style.display = 'block';
          if (doctorNameInput) doctorNameInput.focus();
        } else {
          customBody.style.display = 'none';
        }
      });
    }

    function collectLineItemProperties() {
      const properties = {};
      if (customCheckbox && customCheckbox.checked) {
        const nameVal = doctorNameInput ? doctorNameInput.value.trim() : '';
        const typeVal = customTypeSelect ? customTypeSelect.value : '';
        const threadVal = threadColorSelect ? threadColorSelect.value : '';
        const notesVal = customNotesTextarea ? customNotesTextarea.value.trim() : '';

        if (nameVal) properties['Doctor Name'] = nameVal;
        if (typeVal) properties['Customization Type'] = typeVal;
        if (threadVal) properties['Thread Color'] = threadVal;
        if (notesVal) properties['Custom Notes'] = notesVal;
      }
      return properties;
    }

    // -------------------------------------------------------------------------
    // 6. FUNCTIONAL ADD TO CART & BUY NOW VIA SHOPIFY CART API
    // -------------------------------------------------------------------------
    async function addToCart(isBuyNow = false) {
      if (!activeVariant || !activeVariant.id || !activeVariant.available) return;

      const qty = parseInt(qtyInput ? qtyInput.value : 1, 10) || 1;
      const properties = collectLineItemProperties();

      const btnTarget = isBuyNow ? buyNowBtn : atcBtn;
      const originalText = btnTarget ? btnTarget.innerHTML : '';
      if (btnTarget) {
        btnTarget.setAttribute('disabled', 'disabled');
        btnTarget.innerHTML = `<span style="display: inline-block; animation: spin 0.7s infinite linear;">↻</span> Adding...`;
      }

      // Prepare items payload: main scrub + checked companion items
      const itemsPayload = [
        {
          id: activeVariant.id,
          quantity: qty,
          properties: properties
        }
      ];

      // Check for checked bundle companion items (Caps, Sleeves)
      const capCheckbox = document.getElementById('pdp-add-cap-' + sectionId);
      const sleevesCheckbox = document.getElementById('pdp-add-sleeves-' + sectionId);

      // Find real matching companion variant IDs from catalogue or demo items
      if (capCheckbox && capCheckbox.checked) {
        itemsPayload.push({
          id: activeVariant.id,
          quantity: 1,
          properties: { 'Add-on': 'Matching BunFit Scrub Cap' }
        });
      }
      if (sleevesCheckbox && sleevesCheckbox.checked) {
        itemsPayload.push({
          id: activeVariant.id,
          quantity: 1,
          properties: { 'Add-on': 'Med Sleeves Graduated Compression' }
        });
      }

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(itemsPayload.length === 1 ? itemsPayload[0] : { items: itemsPayload })
        });

        if (!response.ok) {
          const errData = await response.json();
          throw new Error(errData.description || 'Could not add to cart');
        }

        const itemData = await response.json();

        if (isBuyNow) {
          window.location.href = '/checkout';
          return;
        }

        // Trigger Enamels Cart Drawer or global cart refresh
        if (typeof window.openCartDrawer === 'function') {
          window.openCartDrawer();
        } else {
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { item: itemData }, bubbles: true }));
          
          // Fallback check for theme cart drawer
          const drawer = document.querySelector('cart-drawer, #cart-drawer, .enamels-cart-drawer');
          if (drawer && typeof drawer.open === 'function') {
            drawer.open();
          } else if (drawer) {
            drawer.classList.add('active', 'open');
          }
        }

        if (btnTarget) {
          btnTarget.innerHTML = `✓ Added to Cart!`;
          setTimeout(() => {
            btnTarget.removeAttribute('disabled');
            btnTarget.innerHTML = originalText;
          }, 1800);
        }

      } catch (err) {
        console.error('Cart add error:', err);
        alert('Notice: ' + err.message);
        if (btnTarget) {
          btnTarget.removeAttribute('disabled');
          btnTarget.innerHTML = originalText;
        }
      }
    }

    if (atcBtn) {
      atcBtn.addEventListener('click', () => addToCart(false));
    }
    if (buyNowBtn) {
      buyNowBtn.addEventListener('click', () => addToCart(true));
    }
    if (mobileStickyAtcBtn) {
      mobileStickyAtcBtn.addEventListener('click', () => addToCart(false));
    }

    // -------------------------------------------------------------------------
    // 7. ACCORDIONS TOGGLE
    // -------------------------------------------------------------------------
    const accordionHeaders = container.querySelectorAll(".pdp-accordion-trigger, .pdp-accordion-header");
    accordionHeaders.forEach(header => {
      header.addEventListener('click', () => {
        const item = header.closest('.pdp-accordion-item');
        if (!item) return;
        const content = item.querySelector('.pdp-accordion-body, .pdp-accordion-content');
        const isExpanded = header.getAttribute('aria-expanded') === 'true';

        if (isExpanded) {
          header.setAttribute('aria-expanded', 'false');
          item.classList.remove('active');
          if (content) content.style.display = 'none';
        } else {
          header.setAttribute('aria-expanded', 'true');
          item.classList.add('active');
          if (content) content.style.display = 'block';
        }
      });
    });

    // -------------------------------------------------------------------------
    // 8. SIZE GUIDE MODAL
    // -------------------------------------------------------------------------
    const openSizeGuideBtn = document.getElementById("pdp-open-size-chart-btn");
    const sizeGuideModal = document.getElementById("pdp-size-guide-modal-" + sectionId);
    const closeSizeGuideBtn = document.getElementById("pdp-close-size-guide-btn");

    if (openSizeGuideBtn && sizeGuideModal) {
      openSizeGuideBtn.addEventListener('click', () => {
        sizeGuideModal.style.display = 'flex';
      });

      if (closeSizeGuideBtn) {
        closeSizeGuideBtn.addEventListener('click', () => {
          sizeGuideModal.style.display = 'none';
        });
      }

      sizeGuideModal.addEventListener('click', (e) => {
        if (e.target === sizeGuideModal) sizeGuideModal.style.display = 'none';
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && sizeGuideModal.style.display === 'flex') {
          sizeGuideModal.style.display = 'none';
        }
      });
    }

    // -------------------------------------------------------------------------
    // 9. MOBILE STICKY BAR VISIBILITY
    // -------------------------------------------------------------------------
    if (mobileStickyBar && atcBtn) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            mobileStickyBar.classList.remove('visible');
          } else {
            mobileStickyBar.classList.add('visible');
          }
        });
      }, { threshold: 0.1 });

      observer.observe(atcBtn);
    }

    // Initial variant synchronization
    updateVariantUI();

  })();
</script>

