{% comment %}
  Enamels Frontpage Categories Section
  Shop by category with an interactive expandable "View All" & "Show Less" experience.
  - Initial state: Horizontally scrolling category carousel with desktop arrow navigation & mobile swipe.
  - Expanded state: Smoothly animates open revealing all configured category cards in a responsive grid.
  - Show Less state: Collapses smoothly back to initial carousel with graceful scroll positioning.
{% endcomment %}

<section
  class="enamels-categories-section"
  id="enamels-cats-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="enamels-cats__container">
    <!-- Header -->
    <div class="enamels-section-head">
      <div class="enamels-section-head__title-group">
        <h2 class="enamels-section-head__title">{{ section.settings.title | default: 'Shop by category' }}</h2>
        {% if section.settings.subtitle != blank %}
          <p class="enamels-section-head__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>

      <!-- Interactive View All / Show Less Toggle Button -->
      {% if section.settings.enable_view_all and section.blocks.size > 0 %}
        <button
          type="button"
          class="enamels-cat-toggle-btn"
          aria-expanded="false"
          aria-controls="enamels-cats-drawer-{{ section.id }}"
          data-cat-toggle
        >
          <span
            class="enamels-cat-toggle-btn__label"
            data-label-collapsed="{{ section.settings.view_all_label | default: 'View all' | escape }}"
            data-label-expanded="{{ section.settings.show_less_label | default: 'Show less' | escape }}"
          >
            {{ section.settings.view_all_label | default: 'View all' }}
          </span>
          <span class="enamels-cat-toggle-btn__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </button>
      {% endif %}
    </div>

    <!-- 1. Desktop / Tablet Carousel Track -->
    <div class="enamels-cats-carousel-wrap enamels-cats-desktop-track" data-carousel-wrap>
      {% if section.settings.show_arrows != false or section.settings.show_arrows_mobile %}
        <button
          type="button"
          class="enamels-cat-arrow enamels-cat-arrow--left {% unless section.settings.show_arrows_mobile %}enamels-cat-arrow--hide-mob{% endunless %} {% if section.settings.show_arrows == false %}enamels-cat-arrow--hide-desk{% endif %}"
          aria-label="Scroll left"
          data-cat-prev
        >
          {% if section.settings.arrow_icon_style == 'arrow' %}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          {% elsif section.settings.arrow_icon_style == 'bold_chevron' %}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          {% else %}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          {% endif %}
        </button>
      {% endif %}

      <div class="enamels-cats-track" data-carousel-track tabindex="0" role="region" aria-label="Category carousel">
        {% for block in section.blocks %}
          {% render 'enamels-category-card', block: block, section: section, card_class: 'enamels-cat-card--carousel', stagger_index: forloop.index %}
        {% endfor %}
      </div>

      {% if section.settings.show_arrows != false or section.settings.show_arrows_mobile %}
        <button
          type="button"
          class="enamels-cat-arrow enamels-cat-arrow--right {% unless section.settings.show_arrows_mobile %}enamels-cat-arrow--hide-mob{% endunless %} {% if section.settings.show_arrows == false %}enamels-cat-arrow--hide-desk{% endif %}"
          aria-label="Scroll right"
          data-cat-next
        >
          {% if section.settings.arrow_icon_style == 'arrow' %}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          {% elsif section.settings.arrow_icon_style == 'bold_chevron' %}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          {% else %}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          {% endif %}
        </button>
      {% endif %}
    </div>

    <!-- 2. Mobile Responsive 2-Pills-Per-Row Layout with Horizontal Paging for Additional Categories -->
    <div class="enamels-cats-mobile-wrap" data-mobile-wrap>
      <div class="enamels-cats-mobile-scroller" data-mobile-scroller tabindex="0" role="region" aria-label="Mobile category pills">
        {% assign page_size = 6 %}
        {% assign total_pages = section.blocks.size | plus: page_size | minus: 1 | divided_by: page_size %}
        {% for page_idx in (1..total_pages) %}
          {% assign page_offset = page_idx | minus: 1 | times: page_size %}
          <div class="enamels-cats-mobile-page" data-page-index="{{ forloop.index0 }}">
            {% for block in section.blocks offset: page_offset limit: page_size %}
              {% render 'enamels-category-card', block: block, section: section, card_class: 'enamels-cat-card--mobile', stagger_index: forloop.index %}
            {% endfor %}
          </div>
        {% endfor %}
      </div>

      {% if total_pages > 1 %}
        <div class="enamels-cats-mobile-pagination" aria-label="Category pages">
          {% for page_idx in (1..total_pages) %}
            <button type="button" class="enamels-cats-mobile-dot {% if forloop.first %}is-active{% endif %}" data-dot-index="{{ forloop.index0 }}" aria-label="Go to category slide {{ forloop.index }}"></button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- 3. Expandable Grid View (Reveals underneath smoothly) -->
    <div
      id="enamels-cats-drawer-{{ section.id }}"
      class="enamels-cats-drawer"
      data-cat-drawer
      aria-hidden="true"
    >
      <div class="enamels-cats-drawer__inner">
        <div class="enamels-cats-drawer__header">
          <span class="enamels-cats-drawer__count">{{ section.blocks.size }} Categories Available</span>
          <span class="enamels-cats-drawer__hint">Click any category to explore its full collection</span>
        </div>

        <div class="enamels-cats-grid enamels-cats-grid--desktop-{{ section.settings.grid_cols_desktop | default: 6 }} enamels-cats-grid--tablet-{{ section.settings.grid_cols_tablet | default: 3 }} enamels-cats-grid--mobile-{{ section.settings.grid_cols_mobile | default: 2 }}">
          {% for block in section.blocks %}
            {% render 'enamels-category-card', block: block, section: section, card_class: 'enamels-cat-card--grid', stagger_index: forloop.index %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #enamels-cats-{{ section.id }} {
    --cats-visible-desk: {{ section.settings.cards_visible_desktop | default: 6 }};
    --cats-visible-tab: {{ section.settings.cards_visible_tablet | default: 3 }};
    --cats-visible-mob: {{ section.settings.cards_visible_mobile | default: 1.25 }};
    --cats-title-size-desk: {{ section.settings.title_size_desktop | default: 20 }}px;
    --cats-title-size-mob: {{ section.settings.title_size_mobile | default: 16 }}px;
    --cats-sub-size-desk: {{ section.settings.subtitle_size_desktop | default: 13 }}px;
    --cats-sub-size-mob: {{ section.settings.subtitle_size_mobile | default: 11 }}px;
    --cats-card-h-desk: {{ section.settings.card_height_desktop | default: 60 }}px;
    --cats-card-h-mob: {{ section.settings.card_height_mobile | default: 52 }}px;
    --cats-card-pad-v: {{ section.settings.card_padding_vertical | default: 6 }}px;
    --cats-card-pad-h: {{ section.settings.card_padding_horizontal | default: 12 }}px;
    --cats-card-title-size-desk: {{ section.settings.card_title_size_desktop | default: 13 }}px;
    --cats-card-title-size-mob: {{ section.settings.card_title_size_mobile | default: 12 }}px;
    --cats-card-sub-size-desk: {{ section.settings.card_sub_size_desktop | default: 11 }}px;
    --cats-card-sub-size-mob: {{ section.settings.card_sub_size_mobile | default: 10 }}px;
    --cats-card-img-max-h-desk: {{ section.settings.card_img_max_h_desktop | default: 52 }}px;
    --cats-card-img-max-h-mob: {{ section.settings.card_img_max_h_mobile | default: 46 }}px;
    --cats-card-radius: {{ section.settings.card_radius | default: 8 }}px;
    --cats-card-bg: {{ section.settings.card_bg | default: '#dfdfdf' }};
    --cats-card-title-color: {{ section.settings.card_title_color | default: '#111111' }};
    --cats-card-sub-color: {{ section.settings.card_sub_color | default: '#666666' }};
    --cats-gap-desk: {{ section.settings.card_gap_desktop | default: section.settings.card_gap | default: 10 }}px;
    --cats-gap-mob: {{ section.settings.card_gap_mobile | default: 8 }}px;
    --cats-pad-top-desk: {{ section.settings.padding_top_desktop | default: section.settings.padding_top | default: 16 }}px;
    --cats-pad-top-mob: {{ section.settings.padding_top_mobile | default: 12 }}px;
    --cats-pad-bot-desk: {{ section.settings.padding_bottom_desktop | default: section.settings.padding_bottom | default: 28 }}px;
    --cats-pad-bot-mob: {{ section.settings.padding_bottom_mobile | default: 20 }}px;
    --cats-container-max-w: {{ section.settings.container_max_width | default: 1320 }}px;
    --cats-mob-card-w: {{ section.settings.card_width_mobile | default: 72 }}%;
    --cats-arrow-bg: {{ section.settings.arrow_bg | default: '#ffffff' }};
    --cats-arrow-color: {{ section.settings.arrow_color | default: '#111111' }};
    --cats-arrow-border: {{ section.settings.arrow_border_color | default: 'rgba(0,0,0,0.12)' }};
    --cats-arrow-size-desk: {{ section.settings.arrow_size | default: 36 }}px;
    --cats-arrow-size-mob: {{ section.settings.arrow_size_mobile | default: 32 }}px;
    --cats-pill-arrow-color: {{ section.settings.pill_arrow_color | default: '#111111' }};
    --cats-pill-arrow-size: {{ section.settings.pill_arrow_size | default: 13 }}px;

    padding-top: var(--cats-pad-top-desk);
    padding-bottom: var(--cats-pad-bot-desk);
    {% if section.settings.section_bg != blank %}background-color: {{ section.settings.section_bg }};{% endif %}
    position: relative;
    overflow-x: clip;
  }

  #enamels-cats-{{ section.id }} .enamels-cats__container {
    max-width: var(--cats-container-max-w);
    margin: 0 auto;
    padding: 0 16px;
  }

  /* Header */
  .enamels-section-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    gap: 12px;
  }

  .enamels-section-head__title-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .enamels-section-head__title {
    font-size: var(--cats-title-size-desk);
    font-weight: 700;
    color: {{ section.settings.title_color | default: '#111111' }};
    margin: 0;
    letter-spacing: -0.01em;
  }

  .enamels-section-head__subtitle {
    font-size: var(--cats-sub-size-desk);
    color: #666666;
    margin: 0;
  }

  /* Interactive View All Toggle Button */
  .enamels-cat-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: none;
    padding: 8px 14px;
    border-radius: 20px;
    cursor: pointer;
    color: #333333;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    min-height: 44px;
    min-width: 44px;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }

  .enamels-cat-toggle-btn:hover {
    background-color: rgba(0, 0, 0, 0.05);
    color: #111111;
  }

  .enamels-cat-toggle-btn:active {
    transform: scale(0.97);
  }

  .enamels-cat-toggle-btn__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .enamels-cat-toggle-btn[aria-expanded="true"] .enamels-cat-toggle-btn__icon {
    transform: rotate(180deg);
  }

  .enamels-cat-toggle-btn[aria-expanded="true"] {
    background-color: #111111;
    color: #ffffff;
  }

  .enamels-cat-toggle-btn[aria-expanded="true"]:hover {
    background-color: #222222;
    color: #ffffff;
  }

  /* Carousel Wrapper */
  .enamels-cats-carousel-wrap {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  @media (min-width: 768px) {
    .enamels-cats-desktop-track {
      display: flex !important;
    }
    .enamels-cats-mobile-wrap {
      display: none !important;
    }
    .enamels-cats-desktop-track:not(.has-overflow) .enamels-cat-arrow {
      display: none !important;
    }
  }

  .enamels-cat-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: var(--cats-arrow-size-desk, 36px);
    height: var(--cats-arrow-size-desk, 36px);
    border-radius: 50%;
    background-color: var(--cats-arrow-bg, #ffffff);
    border: 1px solid var(--cats-arrow-border, rgba(0, 0, 0, 0.12));
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
    color: var(--cats-arrow-color, #111111);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 8;
    padding: 0;
    transition: background-color 0.2s ease, transform 0.2s ease, opacity 0.2s ease, box-shadow 0.2s ease;
    opacity: 0.95;
    outline: none;
  }

  .enamels-cat-arrow:hover {
    background-color: #f7f7f7;
    opacity: 1;
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.16);
  }

  .enamels-cat-arrow--left {
    left: -14px;
  }

  .enamels-cat-arrow--right {
    right: -14px;
  }

  .enamels-cat-arrow--hide-desk {
    display: none !important;
  }

  /* Carousel Track */
  .enamels-cats-track {
    display: flex;
    gap: var(--cats-gap-desk);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 6px 2px;
    width: 100%;
    align-items: stretch;
    touch-action: pan-x pan-y;
    overscroll-behavior-x: contain;
    cursor: grab;
  }

  .enamels-cats-track:active {
    cursor: grabbing;
  }

  .enamels-cats-track::-webkit-scrollbar {
    display: none;
  }

  /* Category Card Base */
  #enamels-cats-{{ section.id }} .enamels-cat-card,
  .enamels-cat-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: var(--cats-card-bg) !important;
    border-radius: var(--cats-card-radius);
    padding: var(--cats-card-pad-v) var(--cats-card-pad-h);
    text-decoration: none;
    overflow: hidden;
    position: relative;
    min-height: var(--cats-card-h-desk);
    scroll-snap-align: start;
    transition: transform 0.25s cubic-bezier(0.2, 0, 0.2, 1), box-shadow 0.25s cubic-bezier(0.2, 0, 0.2, 1), background-color 0.2s ease;
  }

  .enamels-cat-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
  }

  /* Red Payment Warning Ribbon (Top-Left Corner of Customize Pill) */
  .enamels-cat-advance-tag {
    position: absolute;
    top: 0;
    left: 0;
    background: #dc2626;
    background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
    color: #ffffff !important;
    font-size: 7.5px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 3px 7px;
    border-top-left-radius: var(--cats-card-radius, 8px);
    border-bottom-right-radius: 6px;
    line-height: 1.15;
    white-space: nowrap;
    box-shadow: 0 2px 6px rgba(220, 38, 38, 0.45);
    z-index: 10;
    pointer-events: none;
    display: inline-flex;
    align-items: center;
    font-family: inherit;
  }

  .enamels-cat-card--customizer {
    position: relative;
  }

  .enamels-cat-card--carousel {
    flex: 0 0 calc((100% - (var(--cats-gap-desk) * (var(--cats-visible-desk) - 1))) / var(--cats-visible-desk));
    min-width: 0;
  }

  @media (max-width: 1024px) {
    .enamels-cat-card--carousel {
      flex: 0 0 calc((100% - (var(--cats-gap-desk) * (var(--cats-visible-tab) - 1))) / var(--cats-visible-tab));
    }
  }

  @media (max-width: 767px) {
    .enamels-cat-card--carousel {
      flex: 0 0 calc((100% - (var(--cats-gap-mob) * (var(--cats-visible-mob) - 1))) / var(--cats-visible-mob));
      min-width: 160px;
    }
  }

  .enamels-cat-card__content {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-right: 8px;
    min-width: 0;
    z-index: 2;
  }

  .enamels-cat-card__title {
    font-size: var(--cats-card-title-size-desk);
    font-weight: 700;
    color: var(--cats-card-title-color);
    text-transform: uppercase;
    line-height: 1.15;
    letter-spacing: 0.02em;
    word-break: break-word;
  }

  .enamels-cat-card__subtitle {
    font-size: var(--cats-card-sub-size-desk);
    color: var(--cats-card-sub-color);
    margin-top: 2px;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .enamels-cat-card__badge {
    position: absolute;
    top: 4px;
    left: 8px;
    background: #111111;
    color: #ffffff;
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 1px 5px;
    border-radius: 3px;
    z-index: 3;
  }

  #enamels-cats-{{ section.id }} .enamels-cat-card__media,
  .enamels-cats-section .enamels-cat-card__media {
    flex: 0 0 65px !important;
    height: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    position: relative !important;
    background: transparent !important;
    background-color: transparent !important;
    aspect-ratio: auto !important;
    width: auto !important;
  }

  #enamels-cats-{{ section.id }} .enamels-cat-card__media img,
  .enamels-cats-section .enamels-cat-card__media img {
    position: static !important;
    height: 100% !important;
    width: auto !important;
    max-height: var(--cats-card-img-max-h-desk) !important;
    object-fit: {{ section.settings.image_fit | default: 'contain' }} !important;
    display: block !important;
    transition: transform 0.3s ease;
  }

  .enamels-cat-card:hover .enamels-cat-card__media img {
    transform: scale(1.05);
  }

  /* Pill Card Arrow Icon (Inside Each Pill) */
  .enamels-cat-card__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-left: 6px;
    color: var(--cats-pill-arrow-color, #111111);
    opacity: 0.7;
    transition: transform 0.2s ease, opacity 0.2s ease;
    z-index: 2;
  }

  .enamels-cat-card:hover .enamels-cat-card__arrow {
    transform: translateX(3px);
    opacity: 1;
  }

  /* Full-Size Thumbnail Display in Category / Size Pills */
  #enamels-cats-{{ section.id }} .enamels-cat-card--full-image,
  .enamels-cat-card--full-image {
    padding: 0 !important;
    position: relative !important;
    overflow: hidden !important;
    display: block !important;
    height: var(--cats-card-h-desk) !important;
    min-height: var(--cats-card-h-desk) !important;
    max-height: var(--cats-card-h-desk) !important;
    border-radius: var(--cats-card-radius) !important;
    box-sizing: border-box !important;
    border: 2px solid transparent !important;
    transition: transform 0.2s cubic-bezier(0.2, 0, 0.2, 1), box-shadow 0.2s ease, border-color 0.2s ease !important;
  }

  @media (max-width: 767px) {
    #enamels-cats-{{ section.id }} .enamels-cat-card--full-image,
    .enamels-cat-card--full-image {
      height: var(--cats-card-h-mob) !important;
      min-height: var(--cats-card-h-mob) !important;
      max-height: var(--cats-card-h-mob) !important;
    }
  }

  #enamels-cats-{{ section.id }} .enamels-cat-card--full-image .enamels-cat-full-image,
  .enamels-cat-card--full-image .enamels-cat-full-image {
    width: 100% !important;
    height: 100% !important;
    min-width: 100% !important;
    min-height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block !important;
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    border-radius: var(--cats-card-radius) !important;
    transition: transform 0.3s cubic-bezier(0.2, 0, 0.2, 1) !important;
  }

  .enamels-cat-card--full-image:hover .enamels-cat-full-image {
    transform: scale(1.04);
  }

  /* Clear Selection States */
  .enamels-cat-card--full-image.active,
  .enamels-cat-card--full-image:focus-visible,
  .enamels-cat-card--full-image[aria-current="true"] {
    border-color: #008779 !important;
    box-shadow: 0 0 0 2px #008779, 0 4px 12px rgba(0, 135, 121, 0.2) !important;
    outline: none !important;
  }

  /* 2. Expandable Drawer Section */
  .enamels-cats-drawer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows {{ section.settings.anim_speed | default: 0.4 }}s cubic-bezier(0.4, 0, 0.2, 1), opacity {{ section.settings.anim_speed | default: 0.4 }}s ease;
