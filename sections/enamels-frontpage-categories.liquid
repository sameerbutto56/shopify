{% comment %}
  Enamels Frontpage Categories Section
  Shop by category with an interactive expandable "View All" & "Show Less" experience.
  - Initial state: Horizontally scrolling category carousel with desktop arrow navigation & mobile swipe.
  - Expanded state: Smoothly animates open revealing all configured category cards in a responsive grid.
  - Show Less state: Collapses smoothly back to initial carousel with graceful scroll positioning.
{% endcomment %}

<section
  class="enamels-categories-section"
  id="enamels-cats-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="enamels-cats__container">
    <!-- Header -->
    <div class="enamels-section-head">
      <div class="enamels-section-head__title-group">
        <h2 class="enamels-section-head__title">{{ section.settings.title | default: 'Shop by category' }}</h2>
        {% if section.settings.subtitle != blank %}
          <p class="enamels-section-head__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>

      <!-- Interactive View All / Show Less Toggle Button -->
      {% if section.settings.enable_view_all and section.blocks.size > 0 %}
        <button
          type="button"
          class="enamels-cat-toggle-btn"
          aria-expanded="false"
          aria-controls="enamels-cats-drawer-{{ section.id }}"
          data-cat-toggle
        >
          <span
            class="enamels-cat-toggle-btn__label"
            data-label-collapsed="{{ section.settings.view_all_label | default: 'View all' | escape }}"
            data-label-expanded="{{ section.settings.show_less_label | default: 'Show less' | escape }}"
          >
            {{ section.settings.view_all_label | default: 'View all' }}
          </span>
          <span class="enamels-cat-toggle-btn__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </button>
      {% endif %}
    </div>

    <!-- 1. Initial Collapsed Carousel -->
    <div class="enamels-cats-carousel-wrap" data-carousel-wrap>
      <button
        type="button"
        class="enamels-cat-arrow enamels-cat-arrow--left"
        aria-label="Scroll left"
        data-cat-prev
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="enamels-cats-track" data-carousel-track tabindex="0" role="region" aria-label="Category carousel">
        {% for block in section.blocks %}
          {% assign col = block.settings.collection %}
          {% assign card_title = block.settings.title | default: col.title %}
          {% assign card_subtitle = block.settings.subtitle %}
          {% assign card_badge = block.settings.badge_text %}
          {% assign card_link = block.settings.link | default: col.url | default: '#' %}
          {% assign card_img = block.settings.image %}
          {% if card_img == blank and col.featured_image != blank %}
            {% assign card_img = col.featured_image %}
          {% endif %}
          {% assign card_fallback = block.settings.fallback_asset %}
          {% assign card_title_upper = card_title | upcase %}
          {% assign card_link_lower = card_link | downcase %}
          {% assign is_customizer_pill = false %}
          {% assign is_bulk_pill = false %}
          {% assign is_intl_pill = false %}

          {% if card_link_lower contains 'customizer' or card_title_upper contains 'CUSTOMIZE' %}
            {% assign is_customizer_pill = true %}
          {% elsif card_link_lower contains 'bulk' or card_title_upper contains 'BULK' %}
            {% assign is_bulk_pill = true %}
          {% elsif card_link_lower contains 'intl' or card_link_lower contains 'international' or card_title_upper contains 'INTERNATIONAL' %}
            {% assign is_intl_pill = true %}
          {% endif %}

          {%- assign card_bg_val = block.settings.card_bg | default: section.settings.card_bg | default: '#dfdfdf' -%}
          {%- if card_bg_val == blank or card_bg_val == 'rgba(0,0,0,0)' -%}
            {%- assign card_bg_val = '#dfdfdf' -%}
          {%- endif -%}

          <a
            href="{% if is_customizer_pill %}#customizer{% elsif is_bulk_pill %}#bulk-orders{% elsif is_intl_pill %}#international-delivery{% else %}{{ card_link }}{% endif %}"
            {% if is_customizer_pill %}
              onclick="if(typeof window.openCustomizerModal==='function'){window.openCustomizerModal(); return false;}"
            {% elsif is_bulk_pill %}
              onclick="if(typeof window.openBulkOrdersModal==='function'){window.openBulkOrdersModal(); return false;}"
            {% elsif is_intl_pill %}
              onclick="if(typeof window.openInternationalModal==='function'){window.openInternationalModal(); return false;}"
            {% endif %}
            class="enamels-cat-card enamels-cat-card--carousel"
            style="background-color: {{ card_bg_val }} !important;"
            {{ block.shopify_attributes }}
          >
            {% if card_badge != blank %}
              <span class="enamels-cat-card__badge">{{ card_badge }}</span>
            {% endif %}

            <div class="enamels-cat-card__content">
              <span class="enamels-cat-card__title">{{ card_title }}</span>
              {% if card_subtitle != blank %}
                <span class="enamels-cat-card__subtitle">{{ card_subtitle }}</span>
              {% endif %}
            </div>

            <div class="enamels-cat-card__media">
              {% if card_img != blank %}
                <img
                  src="{{ card_img | image_url: width: 320 }}"
                  alt="{{ card_title | escape }}"
                  loading="lazy"
                  width="120"
                  height="70"
                >
              {% elsif card_fallback != blank %}
                <img
                  src="{{ card_fallback | asset_url }}"
                  alt="{{ card_title | escape }}"
                  loading="lazy"
                  width="120"
                  height="70"
                >
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>

      <button
        type="button"
        class="enamels-cat-arrow enamels-cat-arrow--right"
        aria-label="Scroll right"
        data-cat-next
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <!-- 2. Expandable Grid View (Reveals underneath smoothly) -->
    <div
      id="enamels-cats-drawer-{{ section.id }}"
      class="enamels-cats-drawer"
      data-cat-drawer
      aria-hidden="true"
    >
      <div class="enamels-cats-drawer__inner">
        <div class="enamels-cats-drawer__header">
          <span class="enamels-cats-drawer__count">{{ section.blocks.size }} Categories Available</span>
          <span class="enamels-cats-drawer__hint">Click any category to explore its full collection</span>
        </div>

        <div class="enamels-cats-grid enamels-cats-grid--desktop-{{ section.settings.grid_cols_desktop | default: 6 }} enamels-cats-grid--tablet-{{ section.settings.grid_cols_tablet | default: 3 }} enamels-cats-grid--mobile-{{ section.settings.grid_cols_mobile | default: 2 }}">
          {% for block in section.blocks %}
            {% assign col = block.settings.collection %}
            {% assign card_title = block.settings.title | default: col.title %}
            {% assign card_subtitle = block.settings.subtitle %}
            {% assign card_badge = block.settings.badge_text %}
            {% assign card_link = block.settings.link | default: col.url | default: '#' %}
            {% assign card_img = block.settings.image %}
            {% if card_img == blank and col.featured_image != blank %}
              {% assign card_img = col.featured_image %}
            {% endif %}
            {% assign card_fallback = block.settings.fallback_asset %}
            {% assign card_title_upper = card_title | upcase %}
            {% assign card_link_lower = card_link | downcase %}
            {% assign is_customizer_pill = false %}
            {% assign is_bulk_pill = false %}
            {% assign is_intl_pill = false %}

            {% if card_link_lower contains 'customizer' or card_title_upper contains 'CUSTOMIZE' %}
              {% assign is_customizer_pill = true %}
            {% elsif card_link_lower contains 'bulk' or card_title_upper contains 'BULK' %}
              {% assign is_bulk_pill = true %}
            {% elsif card_link_lower contains 'intl' or card_link_lower contains 'international' or card_title_upper contains 'INTERNATIONAL' %}
              {% assign is_intl_pill = true %}
            {% endif %}

            {%- assign card_bg_val = block.settings.card_bg | default: section.settings.card_bg | default: '#dfdfdf' -%}
            {%- if card_bg_val == blank or card_bg_val == 'rgba(0,0,0,0)' -%}
              {%- assign card_bg_val = '#dfdfdf' -%}
            {%- endif -%}

            <a
              href="{% if is_customizer_pill %}#customizer{% elsif is_bulk_pill %}#bulk-orders{% elsif is_intl_pill %}#international-delivery{% else %}{{ card_link }}{% endif %}"
              {% if is_customizer_pill %}
                onclick="if(typeof window.openCustomizerModal==='function'){window.openCustomizerModal(); return false;}"
              {% elsif is_bulk_pill %}
                onclick="if(typeof window.openBulkOrdersModal==='function'){window.openBulkOrdersModal(); return false;}"
              {% elsif is_intl_pill %}
                onclick="if(typeof window.openInternationalModal==='function'){window.openInternationalModal(); return false;}"
              {% endif %}
              class="enamels-cat-card enamels-cat-card--grid"
              style="--stagger-index: {{ forloop.index }}; background-color: {{ card_bg_val }} !important;"
            >
              {% if card_badge != blank %}
                <span class="enamels-cat-card__badge">{{ card_badge }}</span>
              {% endif %}

              <div class="enamels-cat-card__content">
                <span class="enamels-cat-card__title">{{ card_title }}</span>
                {% if card_subtitle != blank %}
                  <span class="enamels-cat-card__subtitle">{{ card_subtitle }}</span>
                {% endif %}
              </div>

              <div class="enamels-cat-card__media">
                {% if card_img != blank %}
                  <img
                    src="{{ card_img | image_url: width: 360 }}"
                    alt="{{ card_title | escape }}"
                    loading="lazy"
                    width="140"
                    height="80"
                  >
                {% elsif card_fallback != blank %}
                  <img
                    src="{{ card_fallback | asset_url }}"
                    alt="{{ card_title | escape }}"
                    loading="lazy"
                    width="140"
                    height="80"
                  >
                {% endif %}
              </div>
            </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #enamels-cats-{{ section.id }} {
    --cats-visible-desk: {{ section.settings.cards_visible_desktop | default: 6 }};
    --cats-visible-tab: {{ section.settings.cards_visible_tablet | default: 3 }};
    --cats-visible-mob: {{ section.settings.cards_visible_mobile | default: 1.25 }};
    --cats-title-size-desk: {{ section.settings.title_size_desktop | default: 20 }}px;
    --cats-title-size-mob: {{ section.settings.title_size_mobile | default: 16 }}px;
    --cats-sub-size-desk: {{ section.settings.subtitle_size_desktop | default: 13 }}px;
    --cats-sub-size-mob: {{ section.settings.subtitle_size_mobile | default: 11 }}px;
    --cats-card-h-desk: {{ section.settings.card_height_desktop | default: 60 }}px;
    --cats-card-h-mob: {{ section.settings.card_height_mobile | default: 52 }}px;
    --cats-card-pad-v: {{ section.settings.card_padding_vertical | default: 6 }}px;
    --cats-card-pad-h: {{ section.settings.card_padding_horizontal | default: 12 }}px;
    --cats-card-title-size-desk: {{ section.settings.card_title_size_desktop | default: 13 }}px;
    --cats-card-title-size-mob: {{ section.settings.card_title_size_mobile | default: 12 }}px;
    --cats-card-sub-size-desk: {{ section.settings.card_sub_size_desktop | default: 11 }}px;
    --cats-card-sub-size-mob: {{ section.settings.card_sub_size_mobile | default: 10 }}px;
    --cats-card-img-max-h-desk: {{ section.settings.card_img_max_h_desktop | default: 52 }}px;
    --cats-card-img-max-h-mob: {{ section.settings.card_img_max_h_mobile | default: 46 }}px;
    --cats-card-radius: {{ section.settings.card_radius | default: 8 }}px;
    --cats-card-bg: {{ section.settings.card_bg | default: '#dfdfdf' }};
    --cats-card-title-color: {{ section.settings.card_title_color | default: '#111111' }};
    --cats-card-sub-color: {{ section.settings.card_sub_color | default: '#666666' }};
    --cats-gap-desk: {{ section.settings.card_gap_desktop | default: section.settings.card_gap | default: 10 }}px;
    --cats-gap-mob: {{ section.settings.card_gap_mobile | default: 8 }}px;
    --cats-pad-top-desk: {{ section.settings.padding_top_desktop | default: section.settings.padding_top | default: 16 }}px;
    --cats-pad-top-mob: {{ section.settings.padding_top_mobile | default: 12 }}px;
    --cats-pad-bot-desk: {{ section.settings.padding_bottom_desktop | default: section.settings.padding_bottom | default: 28 }}px;
    --cats-pad-bot-mob: {{ section.settings.padding_bottom_mobile | default: 20 }}px;
    --cats-container-max-w: {{ section.settings.container_max_width | default: 1320 }}px;
    --cats-mob-card-w: {{ section.settings.card_width_mobile | default: 72 }}%;

    padding-top: var(--cats-pad-top-desk);
    padding-bottom: var(--cats-pad-bot-desk);
    {% if section.settings.section_bg != blank %}background-color: {{ section.settings.section_bg }};{% endif %}
    position: relative;
    overflow-x: clip;
  }

  #enamels-cats-{{ section.id }} .enamels-cats__container {
    max-width: var(--cats-container-max-w);
    margin: 0 auto;
    padding: 0 16px;
  }

  /* Header */
  .enamels-section-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    gap: 12px;
  }

  .enamels-section-head__title-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .enamels-section-head__title {
    font-size: var(--cats-title-size-desk);
    font-weight: 700;
    color: {{ section.settings.title_color | default: '#111111' }};
    margin: 0;
    letter-spacing: -0.01em;
  }

  .enamels-section-head__subtitle {
    font-size: var(--cats-sub-size-desk);
    color: #666666;
    margin: 0;
  }

  /* Interactive View All Toggle Button */
  .enamels-cat-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: none;
    padding: 8px 14px;
    border-radius: 20px;
    cursor: pointer;
    color: #333333;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    min-height: 44px;
    min-width: 44px;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }

  .enamels-cat-toggle-btn:hover {
    background-color: rgba(0, 0, 0, 0.05);
    color: #111111;
  }

  .enamels-cat-toggle-btn:active {
    transform: scale(0.97);
  }

  .enamels-cat-toggle-btn__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .enamels-cat-toggle-btn[aria-expanded="true"] .enamels-cat-toggle-btn__icon {
    transform: rotate(180deg);
  }

  .enamels-cat-toggle-btn[aria-expanded="true"] {
    background-color: #111111;
    color: #ffffff;
  }

  .enamels-cat-toggle-btn[aria-expanded="true"]:hover {
    background-color: #222222;
    color: #ffffff;
  }

  /* Carousel Wrapper */
  .enamels-cats-carousel-wrap {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .enamels-cat-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    color: #222222;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
    padding: 0;
    transition: background-color 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
    opacity: 0.9;
  }

  .enamels-cat-arrow:hover {
    background-color: #f7f7f7;
    opacity: 1;
    transform: translateY(-50%) scale(1.08);
  }

  .enamels-cat-arrow--left {
    left: -14px;
  }

  .enamels-cat-arrow--right {
    right: -14px;
  }

  /* Carousel Track */
  .enamels-cats-track {
    display: flex;
    gap: var(--cats-gap-desk);
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 6px 2px;
    width: 100%;
    align-items: stretch;
  }

  .enamels-cats-track::-webkit-scrollbar {
    display: none;
  }

  /* Category Card Base */
  #enamels-cats-{{ section.id }} .enamels-cat-card,
  .enamels-cat-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: var(--cats-card-bg) !important;
    border-radius: var(--cats-card-radius);
    padding: var(--cats-card-pad-v) var(--cats-card-pad-h);
    text-decoration: none;
    overflow: hidden;
    position: relative;
    min-height: var(--cats-card-h-desk);
    scroll-snap-align: start;
    transition: transform 0.25s cubic-bezier(0.2, 0, 0.2, 1), box-shadow 0.25s cubic-bezier(0.2, 0, 0.2, 1), background-color 0.2s ease;
  }

  .enamels-cat-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
  }

  .enamels-cat-card--carousel {
    flex: 0 0 calc((100% - (var(--cats-gap-desk) * (var(--cats-visible-desk) - 1))) / var(--cats-visible-desk));
    min-width: 0;
  }

  @media (max-width: 1024px) {
    .enamels-cat-card--carousel {
      flex: 0 0 calc((100% - (var(--cats-gap-desk) * (var(--cats-visible-tab) - 1))) / var(--cats-visible-tab));
    }
  }

  @media (max-width: 767px) {
    .enamels-cat-card--carousel {
      flex: 0 0 calc((100% - (var(--cats-gap-mob) * (var(--cats-visible-mob) - 1))) / var(--cats-visible-mob));
      min-width: 160px;
    }
  }

  .enamels-cat-card__content {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-right: 8px;
    min-width: 0;
    z-index: 2;
  }

  .enamels-cat-card__title {
    font-size: var(--cats-card-title-size-desk);
    font-weight: 700;
    color: var(--cats-card-title-color);
    text-transform: uppercase;
    line-height: 1.15;
    letter-spacing: 0.02em;
    word-break: break-word;
  }

  .enamels-cat-card__subtitle {
    font-size: var(--cats-card-sub-size-desk);
    color: var(--cats-card-sub-color);
    margin-top: 2px;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .enamels-cat-card__badge {
    position: absolute;
    top: 4px;
    left: 8px;
    background: #111111;
    color: #ffffff;
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 1px 5px;
    border-radius: 3px;
    z-index: 3;
  }

  #enamels-cats-{{ section.id }} .enamels-cat-card__media,
  .enamels-cats-section .enamels-cat-card__media {
    flex: 0 0 65px !important;
    height: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    position: relative !important;
    background: transparent !important;
    background-color: transparent !important;
    aspect-ratio: auto !important;
    width: auto !important;
  }

  #enamels-cats-{{ section.id }} .enamels-cat-card__media img,
  .enamels-cats-section .enamels-cat-card__media img {
    position: static !important;
    height: 100% !important;
    width: auto !important;
    max-height: var(--cats-card-img-max-h-desk) !important;
    object-fit: {{ section.settings.image_fit | default: 'contain' }} !important;
    display: block !important;
    transition: transform 0.3s ease;
  }

  .enamels-cat-card:hover .enamels-cat-card__media img {
    transform: scale(1.05);
  }

  /* 2. Expandable Drawer Section */
  .enamels-cats-drawer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows {{ section.settings.anim_speed | default: 0.4 }}s cubic-bezier(0.4, 0, 0.2, 1), opacity {{ section.settings.anim_speed | default: 0.4 }}s ease;
    opacity: 0;
    visibility: hidden;
  }

  .enamels-cats-drawer[aria-hidden="false"] {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
  }

  .enamels-cats-drawer__inner {
    overflow: hidden;
    padding-top: 16px;
  }

  .enamels-cats-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0 14px;
    border-top: 1px dashed rgba(0, 0, 0, 0.15);
    margin-bottom: 12px;
  }

  .enamels-cats-drawer__count {
    font-size: 0.76rem;
    font-weight: 700;
    color: #111111;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .enamels-cats-drawer__hint {
    font-size: 0.72rem;
    color: #777777;
    font-style: italic;
  }

  /* Responsive Expanded Grid Layouts */
  .enamels-cats-grid {
    display: grid;
    gap: var(--cats-gap-desk);
  }

  .enamels-cats-grid--desktop-8 { grid-template-columns: repeat(8, 1fr); }
  .enamels-cats-grid--desktop-7 { grid-template-columns: repeat(7, 1fr); }
  .enamels-cats-grid--desktop-6 { grid-template-columns: repeat(6, 1fr); }
  .enamels-cats-grid--desktop-5 { grid-template-columns: repeat(5, 1fr); }
  .enamels-cats-grid--desktop-4 { grid-template-columns: repeat(4, 1fr); }
  .enamels-cats-grid--desktop-3 { grid-template-columns: repeat(3, 1fr); }

  /* Card in Expanded Grid with subtle cascade entry */
  .enamels-cats-drawer[aria-hidden="false"] .enamels-cat-card--grid {
    animation: enamelsCardFadeIn 0.4s ease forwards;
    animation-delay: calc(var(--stagger-index, 1) * 0.03s);
  }

  @keyframes enamelsCardFadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Tablet Adjustments */
  @media (max-width: 1024px) {
    .enamels-cat-card--carousel {
      flex: 0 0 calc((100% - (var(--cats-gap-desk) * 2)) / 3);
      min-width: 180px;
    }

    .enamels-cats-grid--tablet-5 { grid-template-columns: repeat(5, 1fr); }
    .enamels-cats-grid--tablet-4 { grid-template-columns: repeat(4, 1fr); }
    .enamels-cats-grid--tablet-3 { grid-template-columns: repeat(3, 1fr); }
    .enamels-cats-grid--tablet-2 { grid-template-columns: repeat(2, 1fr); }
  }

  /* Mobile Adjustments */
  @media (max-width: 640px) {
    #enamels-cats-{{ section.id }} {
      padding-top: var(--cats-pad-top-mob);
      padding-bottom: var(--cats-pad-bot-mob);
    }

    #enamels-cats-{{ section.id }} .enamels-cats__container {
      padding: 0 12px;
    }

    .enamels-section-head__title {
      font-size: var(--cats-title-size-mob);
    }

    .enamels-section-head__subtitle {
      font-size: var(--cats-sub-size-mob);
    }

    .enamels-cat-toggle-btn {
      font-size: 0.78rem;
      padding: 6px 10px;
    }

    .enamels-cat-arrow {
      display: none;
    }

    .enamels-cats-track {
      gap: var(--cats-gap-mob);
    }

    .enamels-cat-card--carousel {
      flex: 0 0 var(--cats-mob-card-w);
      min-width: 160px;
    }

    .enamels-cat-card {
      min-height: var(--cats-card-h-mob);
      padding: var(--cats-card-pad-v) var(--cats-card-pad-h);
    }

    .enamels-cat-card__title {
      font-size: var(--cats-card-title-size-mob);
    }

    .enamels-cat-card__subtitle {
      font-size: var(--cats-card-sub-size-mob);
    }

    .enamels-cat-card__media {
      flex: 0 0 54px;
    }

    .enamels-cat-card__media img {
      max-height: var(--cats-card-img-max-h-mob);
    }

    .enamels-cats-grid {
      gap: var(--cats-gap-mob);
    }

    .enamels-cats-grid--mobile-3 {
      grid-template-columns: repeat(3, 1fr);
    }

    .enamels-cats-grid--mobile-2 {
      grid-template-columns: repeat(2, 1fr);
    }

    .enamels-cats-grid--mobile-1 {
      grid-template-columns: 1fr;
    }

    .enamels-cats-drawer__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
  }

  /* Accessibility: Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .enamels-cats-drawer {
      transition: none !important;
    }

    .enamels-cat-toggle-btn__icon {
      transition: none !important;
    }

    .enamels-cat-card {
      transition: none !important;
    }

    .enamels-cats-drawer[aria-hidden="false"] .enamels-cat-card--grid {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  (function () {
    function initEnamelsCategories() {
      const section = document.getElementById('enamels-cats-{{ section.id }}');
      if (!section) return;

      const toggleBtn = section.querySelector('[data-cat-toggle]');
      const drawer = section.querySelector('[data-cat-drawer]');
      const labelSpan = section.querySelector('.enamels-cat-toggle-btn__label');
      const track = section.querySelector('[data-carousel-track]');
      const prevBtn = section.querySelector('[data-cat-prev]');
      const nextBtn = section.querySelector('[data-cat-next]');

      // Carousel Arrow Navigation
      if (track && prevBtn && nextBtn) {
        const scrollStep = () => track.clientWidth * 0.75;

        prevBtn.onclick = () => {
          track.scrollBy({ left: -scrollStep(), behavior: 'smooth' });
        };

        nextBtn.onclick = () => {
          track.scrollBy({ left: scrollStep(), behavior: 'smooth' });
        };

        // Update arrow visibility based on scroll position
        const updateArrows = () => {
          const atStart = track.scrollLeft <= 5;
          const atEnd = track.scrollLeft >= track.scrollWidth - track.clientWidth - 5;
          prevBtn.style.opacity = atStart ? '0.3' : '1';
          prevBtn.style.pointerEvents = atStart ? 'none' : 'auto';
          nextBtn.style.opacity = atEnd ? '0.3' : '1';
          nextBtn.style.pointerEvents = atEnd ? 'none' : 'auto';
        };

        track.addEventListener('scroll', updateArrows, { passive: true });
        window.addEventListener('resize', updateArrows, { passive: true });
        updateArrows();
      }

      // View All / Show Less Expand & Collapse
      if (toggleBtn && drawer && labelSpan) {
        const labelCollapsed = labelSpan.getAttribute('data-label-collapsed') || 'View all';
        const labelExpanded = labelSpan.getAttribute('data-label-expanded') || 'Show less';

        toggleBtn.onclick = function () {
          const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';

          if (!isExpanded) {
            // EXPAND
            toggleBtn.setAttribute('aria-expanded', 'true');
            drawer.setAttribute('aria-hidden', 'false');
            labelSpan.textContent = labelExpanded;
          } else {
            // COLLAPSE
            toggleBtn.setAttribute('aria-expanded', 'false');
            drawer.setAttribute('aria-hidden', 'true');
            labelSpan.textContent = labelCollapsed;

            // Graceful scroll adjustment if customer scrolled past the header
            const rect = section.getBoundingClientRect();
            if (rect.top < 0) {
              section.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        };
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initEnamelsCategories);
    } else {
      initEnamelsCategories();
    }

    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        initEnamelsCategories();
      }
    });
    document.addEventListener('shopify:section:select', function(event) {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        initEnamelsCategories();
      }
    });
  })();
</script>

