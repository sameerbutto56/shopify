<script>
  (function () {
    function initEnamelsCategories() {
      const section = document.getElementById('enamels-cats-{{ section.id }}');
      if (!section) return;

      const toggleBtn = section.querySelector('[data-cat-toggle]');
      const drawer = section.querySelector('[data-cat-drawer]');
      const labelSpan = section.querySelector('.enamels-cat-toggle-btn__label');
      const track = section.querySelector('[data-carousel-track]');
      const prevBtn = section.querySelector('[data-cat-prev]');
      const nextBtn = section.querySelector('[data-cat-next]');

      // Carousel Arrow Navigation & Smooth Scrolling
      if (track) {
        const getCardWidth = () => {
          const firstCard = track.querySelector('.enamels-cat-card');
          if (firstCard && firstCard.offsetWidth > 40) {
            return firstCard.offsetWidth + 12;
          }
          return Math.max(180, track.clientWidth * 0.75);
        };

        if (prevBtn) {
          prevBtn.onclick = (e) => {
            e.preventDefault();
            e.stopPropagation();
            const step = getCardWidth() * 1.5;
            if (track.scrollLeft <= 8) {
              // Smooth scroll to end
              track.scrollTo({ left: track.scrollWidth, behavior: 'smooth' });
            } else {
              track.scrollBy({ left: -step, behavior: 'smooth' });
            }
          };
        }

        if (nextBtn) {
          nextBtn.onclick = (e) => {
            e.preventDefault();
            e.stopPropagation();
            const step = getCardWidth() * 1.5;
            const maxScroll = track.scrollWidth - track.clientWidth - 8;
            if (track.scrollLeft >= maxScroll) {
              // Smooth scroll back to beginning
              track.scrollTo({ left: 0, behavior: 'smooth' });
            } else {
              track.scrollBy({ left: step, behavior: 'smooth' });
            }
          };
        }

        // Keep arrows ALWAYS active and clickable
        const updateArrows = () => {
          if (!prevBtn || !nextBtn) return;
          const maxScroll = track.scrollWidth - track.clientWidth - 6;
          const atStart = track.scrollLeft <= 6;
          const atEnd = track.scrollLeft >= maxScroll;
          // Never set pointerEvents = 'none' so arrows are always editable/clickable
          prevBtn.style.opacity = atStart ? '0.75' : '1';
          prevBtn.style.pointerEvents = 'auto';
          nextBtn.style.opacity = atEnd ? '0.75' : '1';
          nextBtn.style.pointerEvents = 'auto';
        };

        track.addEventListener('scroll', updateArrows, { passive: true });
        window.addEventListener('resize', updateArrows, { passive: true });
        setTimeout(updateArrows, 150);

        // Prevent native HTML5 link drag which kills mousemove
        track.addEventListener('dragstart', (e) => {
          e.preventDefault();
        });

        // Mouse Drag to Scroll
        let isDown = false;
        let startX = 0;
        let scrollStart = 0;
        let hasMoved = false;

        track.addEventListener('mousedown', (e) => {
          if (e.button !== 0) return;
          isDown = true;
          hasMoved = false;
          startX = e.pageX - track.offsetLeft;
          scrollStart = track.scrollLeft;
          track.style.scrollBehavior = 'auto';
          track.style.cursor = 'grabbing';
          track.style.userSelect = 'none';
        });

        window.addEventListener('mouseup', () => {
          if (!isDown) return;
          isDown = false;
          track.style.scrollBehavior = 'smooth';
          track.style.cursor = 'grab';
          track.style.userSelect = '';
          setTimeout(() => { hasMoved = false; }, 80);
        });

        track.addEventListener('mouseleave', () => {
          if (!isDown) return;
          isDown = false;
          track.style.scrollBehavior = 'smooth';
          track.style.cursor = 'grab';
          track.style.userSelect = '';
        });

        track.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const currentX = e.pageX - track.offsetLeft;
          const walk = (currentX - startX) * 1.5;
          if (Math.abs(walk) > 5) {
            hasMoved = true;
          }
          track.scrollLeft = scrollStart - walk;
        });

        // Suppress accidental card clicks if user was dragging
        track.querySelectorAll('.enamels-cat-card').forEach((card) => {
          card.addEventListener('click', (e) => {
            if (hasMoved) {
              e.preventDefault();
              e.stopPropagation();
              return false;
            }
          }, true);
        });

        // Horizontal Mouse Wheel Scroll
        track.addEventListener('wheel', (e) => {
          if (Math.abs(e.deltaY) > Math.abs(e.deltaX) && !e.shiftKey) {
            const canScrollLeft = e.deltaY < 0 && track.scrollLeft > 0;
            const canScrollRight = e.deltaY > 0 && track.scrollLeft < (track.scrollWidth - track.clientWidth - 2);
            if (canScrollLeft || canScrollRight) {
              e.preventDefault();
              track.scrollLeft += e.deltaY;
            }
          }
        }, { passive: false });
      }

      // View All / Show Less Expand & Collapse
      if (toggleBtn && drawer && labelSpan) {
        const labelCollapsed = labelSpan.getAttribute('data-label-collapsed') || 'View all';
        const labelExpanded = labelSpan.getAttribute('data-label-expanded') || 'Show less';

        toggleBtn.onclick = function () {
          const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';

          if (!isExpanded) {
            // EXPAND
            toggleBtn.setAttribute('aria-expanded', 'true');
            drawer.setAttribute('aria-hidden', 'false');
            labelSpan.textContent = labelExpanded;
          } else {
            // COLLAPSE
            toggleBtn.setAttribute('aria-expanded', 'false');
            drawer.setAttribute('aria-hidden', 'true');
            labelSpan.textContent = labelCollapsed;

            // Graceful scroll adjustment if customer scrolled past the header
            const rect = section.getBoundingClientRect();
            if (rect.top < 0) {
              section.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        };
      }

      // Check Desktop Track Overflow
      const carouselWrap = section.querySelector('.enamels-cats-desktop-track');
      if (track && carouselWrap) {
        const checkDesktopOverflow = () => {
          const isOverflowing = track.scrollWidth > track.clientWidth + 4;
          carouselWrap.classList.toggle('has-overflow', isOverflowing);
        };
        checkDesktopOverflow();
        window.addEventListener('resize', checkDesktopOverflow, { passive: true });
        setTimeout(checkDesktopOverflow, 150);
      }

      // Mobile Scroller Dot Synchronization & Click Navigation
      const mobileScroller = section.querySelector('[data-mobile-scroller]');
      const mobileDots = section.querySelectorAll('.enamels-cats-mobile-dot');

      if (mobileScroller && mobileDots.length > 0) {
        const updateMobileDots = () => {
          const scrollLeft = mobileScroller.scrollLeft;
          const pageWidth = mobileScroller.clientWidth || 1;
          const pageIndex = Math.min(mobileDots.length - 1, Math.max(0, Math.round(scrollLeft / pageWidth)));
          mobileDots.forEach((dot, idx) => {
            dot.classList.toggle('is-active', idx === pageIndex);
          });
        };

        mobileScroller.addEventListener('scroll', updateMobileDots, { passive: true });

        mobileDots.forEach((dot, idx) => {
          dot.addEventListener('click', (e) => {
            e.preventDefault();
            const pageWidth = mobileScroller.clientWidth;
            mobileScroller.scrollTo({
              left: idx * pageWidth,
              behavior: 'smooth'
            });
          });
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initEnamelsCategories);
    } else {
      initEnamelsCategories();
    }

    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        initEnamelsCategories();
      }
    });
    document.addEventListener('shopify:section:select', function(event) {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        initEnamelsCategories();
      }
    });
  })();
</script>

