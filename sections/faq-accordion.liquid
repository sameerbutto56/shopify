{% comment %}
  Frequently Asked Questions (FAQ) Accordion Section
{% endcomment %}

<div class="faq-section section-padding" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="page-width page-width--narrow">
    {% if section.settings.heading != blank %}
      <div class="faq-header text-center">
        {% if section.settings.subheading != blank %}
          <p class="faq-subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
        <h2 class="faq-title h3">{{ section.settings.heading | escape }}</h2>
      </div>
    {% endif %}

    <div class="faq-accordion-list">
      {% for block in section.blocks %}
        <details class="faq-item" {{ block.shopify_attributes }}>
          <summary class="faq-question">
            <span>{{ block.settings.question | escape }}</span>
            <span class="faq-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </summary>
          <div class="faq-answer">
            <p>{{ block.settings.answer | escape }}</p>
          </div>
        </details>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .faq-section {
    padding: 60px 0;
  }
  .faq-header {
    margin-bottom: 36px;
    text-align: center;
  }
  .faq-subheading {
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.15em;
    font-weight: 600;
    color: #6b7280;
    margin-bottom: 8px;
  }
  .faq-title {
    margin: 0;
    font-weight: 700;
  }
  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq-item {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 16px 20px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .faq-item[open] {
    border-color: #111827;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    user-select: none;
    color: #111827;
  }
  .faq-question::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    display: flex;
    align-items: center;
    transition: transform 0.25s ease;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
  .faq-answer {
    padding-top: 14px;
    font-size: 14px;
    line-height: 1.6;
    color: #4b5563;
    border-top: 1px solid #f3f4f6;
    margin-top: 12px;
  }
  .faq-answer p {
    margin: 0;
  }
</style>

{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Help & Support"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111827"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question & Answer",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion"
    }
  ]
}
{% endschema %}
