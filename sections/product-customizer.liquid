{% comment %}
  ENAMELS ONLINE — MODULAR PRODUCT CUSTOMIZER & EMBROIDERY STUDIO SECTION
  Supports 8-step customizer on PDP or standalone landing pages:
  - Standard & Custom Measurement Sizing
  - Official Clinical Shade Swatches + Make Your Own Color
  - Garment Alterations (Shirt/Trouser/Sleeve length)
  - Photorealistic Macro Chest Pocket Live Embroidery Studio
  - Hospital Logo / Insignia Placement
  - Companion Add-ons (Matching Cap & Medical Sleeves)
{% endcomment %}

<section
  class="enamels-pdp-customizer-section section-padding"
  id="ProductCustomizer-{{ section.id }}"
  data-section-id="{{ section.id }}"
  style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0; background-color: {{ section.settings.bg_color }};"
>
  <div class="page-container">
    {% if section.settings.show_header %}
      <div class="section-header-wrap" style="text-align: {{ section.settings.header_alignment }}; margin-bottom: 28px;">
        {% if section.settings.badge != blank %}
          <span class="section-tag-sub">{{ section.settings.badge | escape }}</span>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="section-title-main" style="color: {{ section.settings.heading_color }};">
            {{ section.settings.title | escape }}
          </h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="section-title-desc" style="color: {{ section.settings.text_color }};">
            {{ section.settings.subtitle | escape }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <!-- Render the Complete PDP Customization Studio -->
    <div class="pdp-studio-standalone-embed">
      {% render 'enamels-product-detail' %}
    </div>
  </div>
</section>

<style>
  #ProductCustomizer-{{ section.id }} .chroma-view-panel#view-product-studio {
    display: block !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }
  #ProductCustomizer-{{ section.id }} .page-container {
    max-width: 1200px;
  }
</style>

{% schema %}
{
  "name": "Product Customizer",
  "tag": "section",
  "class": "section-enamels-product-customizer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show Section Header",
      "default": false
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Section Tag Badge",
      "default": "BESPOKE PERSONALIZATION STUDIO"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Step-by-Step Custom Fit & Embroidery"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Tailor your scrubs with clinical precision: choose your fit, select official shades, and preview live chest pocket embroidery."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#102a43"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#64748b"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Product Customizer Studio"
    }
  ]
}
{% endschema %}
