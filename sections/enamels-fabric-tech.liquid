{% comment %}
  ENAMELS ONLINE — MODULAR FABRIC TECHNOLOGY SECTION
  Clinical material performance showcase with configurable benefit blocks.
{% endcomment %}

<section
  class="enamels-fabric-tech-section section-padding"
  id="FabricTech-{{ section.id }}"
  style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0; background-color: {{ section.settings.bg_color }}; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;"
>
  <div class="page-container">
    {% if section.settings.title != blank or section.settings.badge != blank %}
      <div class="section-header-wrap" style="text-align: {{ section.settings.header_alignment }};">
        {% if section.settings.badge != blank %}
          <span class="section-tag-sub">{{ section.settings.badge | escape }}</span>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="section-title-main" style="color: {{ section.settings.heading_color }};">
            {{ section.settings.title | escape }}
          </h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="section-title-desc" style="color: {{ section.settings.text_color }};">
            {{ section.settings.subtitle | escape }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <div class="fabric-tech-grid" style="grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="fabric-tech-card" {{ block.shopify_attributes }}>
            <div class="fabric-tech-icon-circle" style="background-color: {{ block.settings.icon_bg }}; color: {{ block.settings.icon_color }};">
              <span class="fabric-tech-icon-symbol">{{ block.settings.icon_emoji | default: '⚡' }}</span>
            </div>
            <h3 class="fabric-tech-title" style="color: {{ section.settings.heading_color }};">
              {{ block.settings.title | escape }}
            </h3>
            <p class="fabric-tech-desc" style="color: {{ section.settings.text_color }};">
              {{ block.settings.description | escape }}
            </p>
            {% if block.settings.spec_badge != blank %}
              <span class="fabric-tech-badge">{{ block.settings.spec_badge | escape }}</span>
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Fallback Blocks -->
        <div class="fabric-tech-card">
          <div class="fabric-tech-icon-circle" style="background-color: #e0f2fe; color: #0284c7;">
            <span class="fabric-tech-icon-symbol">🔄</span>
          </div>
          <h3 class="fabric-tech-title">4-Way Mechanical Stretch</h3>
          <p class="fabric-tech-desc">72% Poly, 21% Rayon, 7% Spandex. Engineered for unrestricted mobility during intense surgeries and patient transfers.</p>
          <span class="fabric-tech-badge">Zero Sag Recovery</span>
        </div>
        <div class="fabric-tech-card">
          <div class="fabric-tech-icon-circle" style="background-color: #dcfce7; color: #16a34a;">
            <span class="fabric-tech-icon-symbol">🛡️</span>
          </div>
          <h3 class="fabric-tech-title">Antimicrobial Shield</h3>
          <p class="fabric-tech-desc">Infused with silver-ion technology that neutralizes odor-causing bacteria and resists hospital pathogen colonization.</p>
          <span class="fabric-tech-badge">ISO 20743 Certified</span>
        </div>
        <div class="fabric-tech-card">
          <div class="fabric-tech-icon-circle" style="background-color: #fef3c7; color: #d97706;">
            <span class="fabric-tech-icon-symbol">💧</span>
          </div>
          <h3 class="fabric-tech-title">Fluid Barrier Nanotech</h3>
          <p class="fabric-tech-desc">Liquid droplets bead and roll off upon contact, preventing blood, saline, and chemical penetration to base layers.</p>
          <span class="fabric-tech-badge">Repel-Tech Matrix</span>
        </div>
        <div class="fabric-tech-card">
          <div class="fabric-tech-icon-circle" style="background-color: #ede9fe; color: #7c3aed;">
            <span class="fabric-tech-icon-symbol">👔</span>
          </div>
          <h3 class="fabric-tech-title">Wrinkle-Release & Durability</h3>
          <p class="fabric-tech-desc">Tested through 100+ high-temperature clinical autoclave wash cycles with zero color fade and zero puckering.</p>
          <span class="fabric-tech-badge">Autoclave Safe</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .fabric-tech-grid {
    display: grid;
    gap: 24px;
    margin-top: 36px;
  }
  .fabric-tech-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .fabric-tech-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -6px rgba(16, 42, 67, 0.08);
  }
  .fabric-tech-icon-circle {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    margin-bottom: 16px;
  }
  .fabric-tech-title {
    font-size: 17px;
    font-weight: 700;
    margin: 0 0 8px 0;
    line-height: 1.3;
  }
  .fabric-tech-desc {
    font-size: 13px;
    line-height: 1.6;
    margin: 0 0 16px 0;
  }
  .fabric-tech-badge {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #0d9488;
    background: #ccfbf1;
    padding: 3px 8px;
    border-radius: 4px;
    margin-top: auto;
  }
  @media (max-width: 900px) {
    .fabric-tech-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
  @media (max-width: 600px) {
    .fabric-tech-grid {
      grid-template-columns: 1fr !important;
      gap: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Fabric Technology",
  "tag": "section",
  "class": "section-enamels-fabric-tech",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Section Tag Badge",
      "default": "PROPRIETARY TEXTILE SCIENCE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Clinical Fabric Engineering"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Tested and certified for the rigorous demands of healthcare professionals and surgical operating suites."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on Desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#102a43"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#64748b"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Fabric Benefit",
      "settings": [
        {
          "type": "text",
          "id": "icon_emoji",
          "label": "Icon (Emoji)",
          "default": "⚡"
        },
        {
          "type": "color",
          "id": "icon_bg",
          "label": "Icon Background Color",
          "default": "#e0f2fe"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon Color",
          "default": "#0284c7"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "4-Way Mechanical Stretch"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "72% Poly, 21% Rayon, 7% Spandex. Unrestricted mobility during prolonged surgical operations."
        },
        {
          "type": "text",
          "id": "spec_badge",
          "label": "Specification Badge",
          "default": "Clinical Grade"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fabric Technology",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon_emoji": "🔄",
            "icon_bg": "#e0f2fe",
            "icon_color": "#0284c7",
            "title": "4-Way Mechanical Stretch",
            "description": "72% Poly, 21% Rayon, 7% Spandex. Unrestricted mobility during surgeries and long shifts.",
            "spec_badge": "Zero Sag Recovery"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_emoji": "🛡️",
            "icon_bg": "#dcfce7",
            "icon_color": "#16a34a",
            "title": "Antimicrobial Shield",
            "description": "Infused with silver-ion technology that neutralizes odor-causing bacteria and resists pathogens.",
            "spec_badge": "ISO 20743 Certified"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_emoji": "💧",
            "icon_bg": "#fef3c7",
            "icon_color": "#d97706",
            "title": "Fluid Barrier Nanotech",
            "description": "Liquid droplets bead and roll off upon contact, preventing fluid penetration to base layers.",
            "spec_badge": "Repel-Tech Matrix"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_emoji": "👔",
            "icon_bg": "#ede9fe",
            "icon_color": "#7c3aed",
            "title": "Wrinkle-Release & Autoclave Safe",
            "description": "Tested through 100+ industrial laundry autoclave wash cycles with zero color fade.",
            "spec_badge": "Autoclave Safe"
          }
        }
      ]
    }
  ]
}
{% endschema %}
