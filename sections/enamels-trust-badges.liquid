{% comment %}
  Enamels Modular Trust Badges Section
  Provides value proposition badges (Free Shipping, COD, Easy Exchange, Embroidery)
  with customizable icons/emojis, titles, subtitles, and background color.
{% endcomment %}

{%- liquid
  assign enable_section = section.settings.enable_section
  assign bg_color = section.settings.trust_badges_bg | default: '#f8fafc'
  assign blocks_count = section.blocks.size
-%}

{% if enable_section %}
<style>
  .enamels-trust-badges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
  }
  @media (max-width: 640px) {
    .enamels-trust-badges-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 12px !important;
    }
    #homepage-trust-badges {
      padding: 24px 0 !important;
    }
  }
</style>

<section class="enamels-homepage-modular-section" style="background-color: {{ bg_color }}; border-top: 1px solid #e2e8f0; padding: 40px 0;" id="homepage-trust-badges" aria-label="Customer Guarantees and Trust Badges">
  <div class="page-container">
    <div class="enamels-trust-badges-grid">
      {% for block in section.blocks %}
        {% if block.type == 'trust_badge' %}
          <div style="text-align: center; padding: 16px;" id="shopify-block-{{ block.id }}" {{ block.shopify_attributes }}>
            <div style="font-size: 26px; margin-bottom: 8px;">{{ block.settings.icon_emoji | default: '✨' }}</div>
            <h4 style="font-size: 13px; font-weight: 700; margin: 0 0 4px; text-transform: uppercase;">{{ block.settings.title | escape }}</h4>
            <p style="font-size: 11px; color: #64748b; margin: 0;">{{ block.settings.subtitle | escape }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Trust & Service Badges",
  "class": "enamels-trust-badges-wrapper",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Section",
      "default": true
    },
    {
      "type": "color",
      "id": "trust_badges_bg",
      "label": "Background Color",
      "default": "#f8fafc"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "text",
          "id": "icon_emoji",
          "label": "Icon or Emoji",
          "default": "🚚"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust & Service Badges"
    }
  ]
}
{% endschema %}
