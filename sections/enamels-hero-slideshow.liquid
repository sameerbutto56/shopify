            "button_onclick": "window.navigateToCollection('clogs', 'category')"
          }
        },
        {
          "type": "slide",
          "settings": {
            "asset_image_name": "banner-abbotabad.jpg",
            "badge": "New Arrivals 2026",
            "heading": "Medical Uniform Architecture",
            "subheading": "Precision-tailored lab coats, scrubs, and surgical headwear.",
            "button_label": "Explore Complete Catalog",
            "button_link": "#category-scrubs",
            "button_onclick": "window.navigateToCollection('all', 'category')"
          }
        },
        {
          "type": "slide",
          "settings": {
            "asset_image_name": "banner-caps.jpg",
            "badge": "Surgical Headwear",
            "heading": "BunFit™ Surgical Caps",
            "subheading": "Contoured volume pleats, breathable antimicrobial cotton, and sweatband lining.",
            "button_label": "Shop Surgical Caps",
            "button_link": "#collection-caps",
            "button_onclick": "window.navigateToCollection('caps', 'category')"
          }
        },
        {
          "type": "slide",
          "settings": {
            "asset_image_name": "banner-velora.jpg",
            "badge": "Luxury Micro-Drape",
            "heading": "Velora Series Scrubs",
            "subheading": "Silky-soft drape with wrinkle-release properties that stay sharp all day.",
