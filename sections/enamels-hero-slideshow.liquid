          "label": "Secondary Button Label"
        },
        {
          "type": "url",
          "id": "secondary_button_link",
          "label": "Secondary Button Link"
        },
        {
          "type": "text",
          "id": "secondary_button_onclick",
          "label": "Secondary Button JS Action (Optional)",
          "info": "e.g. window.navigateToView('ready-to-wear')"
        },
        {
          "type": "header",
          "content": "Image Overlay"
        },
        {
