{% comment %}
  Section: enamels-fabric-showcase.liquid
  Description: Fully customizable Technical Fabric Showcase section with interactive specs,
  performance rating meters, strict 2-column grid layout, independent responsive display controls,
  and individual element visibility toggles.
  Complete editability in Shopify Studio with zero unwanted fallbacks.
{% endcomment %}

{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign max_w = section.settings.container_width | default: 1320
  assign p_top = section.settings.padding_top | default: 48
  assign p_bottom = section.settings.padding_bottom | default: 48

  # Header Settings (strictly no hardcoded fallback output)
  assign show_header = true
  if section.settings.show_header == false
    assign show_header = false
  endif
  assign header_align = section.settings.header_alignment | default: 'center'

  assign show_eyebrow = true
  if section.settings.show_eyebrow == false
    assign show_eyebrow = false
  endif
  assign eyebrow = section.settings.eyebrow
  assign eyebrow_bg = section.settings.eyebrow_bg | default: '#e6fffa'
  assign eyebrow_color = section.settings.eyebrow_color | default: '#008779'
  assign eyebrow_size = section.settings.eyebrow_size | default: 11

  assign show_title = true
  if section.settings.show_title == false
    assign show_title = false
  endif
  assign title = section.settings.title
  assign title_size_desk = section.settings.title_size_desktop | default: 32
  assign title_size_mob = section.settings.title_size_mobile | default: 24
  assign title_weight = section.settings.title_weight | default: '800'
  assign title_transform = section.settings.title_transform | default: 'none'
  assign title_color = section.settings.title_color | default: '#0f172a'

  assign show_subtitle = true
  if section.settings.show_subtitle == false
    assign show_subtitle = false
  endif
  assign subtitle = section.settings.subtitle
  assign subtitle_color = section.settings.subtitle_color | default: '#64748b'
  assign subtitle_size = section.settings.subtitle_size | default: 15

  # Grid & Layout Settings (Strict 2-Column Responsive System)
  assign desk_cols = section.settings.desktop_columns | default: '2'
  assign tab_cols = section.settings.tablet_columns | default: '2'
  assign mob_layout = section.settings.mobile_columns | default: '2'
  assign gap_h = section.settings.grid_gap_horizontal | default: section.settings.grid_gap | default: 28
  assign gap_v = section.settings.grid_gap_vertical | default: section.settings.grid_gap | default: 28
  assign gap_mob_h = section.settings.grid_gap_mobile_horizontal | default: 12
  assign gap_mob_v = section.settings.grid_gap_mobile_vertical | default: 16
  assign grid_align = section.settings.grid_alignment | default: 'stretch'

  # Card Styling Settings
  assign card_max_w = section.settings.card_max_width | default: 0
  assign card_min_h = section.settings.card_min_height | default: 0
  assign card_padding = section.settings.card_padding | default: 24
  assign card_border_w = section.settings.card_border_width | default: 1
  assign card_radius = section.settings.card_border_radius | default: 16
  assign card_bg_global = section.settings.card_bg | default: '#ffffff'
  assign card_border_global = section.settings.card_border_color | default: '#e2e8f0'
  assign card_hover_border = section.settings.card_hover_border_color | default: '#008779'
  assign card_shadow = section.settings.card_shadow | default: 'hover_elevate'
  assign card_align = section.settings.card_text_alignment | default: 'left'

  # Typography (Cards)
  assign card_title_size = section.settings.card_title_size | default: 20
  assign card_title_color = section.settings.card_title_color | default: '#0f172a'
  assign card_tagline_size = section.settings.card_tagline_size | default: 12
  assign card_tagline_color = section.settings.card_tagline_color | default: '#008779'
  assign card_desc_size = section.settings.card_desc_size | default: 13
  assign card_desc_color = section.settings.card_desc_color | default: '#475569'

  # Image Global Settings
  assign show_images_global = true
  if section.settings.show_images == false
    assign show_images_global = false
  endif
  assign img_ratio_global = section.settings.image_aspect_ratio | default: '16_9'
  assign img_max_h = section.settings.image_max_height | default: 0
  assign img_fit_global = section.settings.image_fit | default: 'cover'
  assign img_pos_global = section.settings.image_position | default: 'center'
  assign img_radius = section.settings.image_radius | default: 0

  # Badges Global Settings
  assign show_badges_global = true
  if section.settings.show_badges == false
    assign show_badges_global = false
  endif
  assign badge_bg = section.settings.badge_bg | default: 'rgba(255, 255, 255, 0.95)'
  assign badge_text_color = section.settings.badge_text_color | default: '#0f172a'

  # Performance Metrics Global Settings
  assign show_metrics_global = true
  if section.settings.show_metrics == false
    assign show_metrics_global = false
  endif
  assign metrics_bg = section.settings.metrics_bg | default: '#f8fafc'
  assign metrics_border = section.settings.metrics_border_color | default: '#edf2f7'
  assign meter_start_color = section.settings.meter_fill_color_start | default: '#008779'
  assign meter_end_color = section.settings.meter_fill_color_end | default: '#14b8a6'

  assign meter_soft = section.settings.meter_softness_label
  assign meter_breath = section.settings.meter_breath_label
  assign meter_stretch = section.settings.meter_stretch_label
  assign meter_dur = section.settings.meter_dur_label

  # Action Buttons Global Settings
  assign show_exp_btn_global = true
  if section.settings.show_explore_button == false
    assign show_exp_btn_global = false
  endif
  assign btn_exp_lbl_global = section.settings.btn_explore_label
  assign btn_exp_bg = section.settings.btn_explore_bg | default: '#0f172a'
  assign btn_exp_color = section.settings.btn_explore_color | default: '#ffffff'

  assign show_cust_btn_global = true
  if section.settings.show_customize_button == false
    assign show_cust_btn_global = false
  endif
  assign btn_cust_lbl_global = section.settings.btn_customize_label
  assign btn_cust_bg = section.settings.btn_customize_bg | default: '#f0fdfa'
  assign btn_cust_color = section.settings.btn_customize_color | default: '#008779'
  assign btn_cust_border = section.settings.btn_customize_border | default: '#99f6e4'

  assign btn_radius = section.settings.button_border_radius | default: 8
  assign btn_style = section.settings.button_style | default: 'solid'
-%}

<section
  class="enamels-fabric-showcase-section"
  id="enamels-fabrics-{{ section.id }}"
  style="background-color: {{ bg_color }}; padding-top: {{ p_top }}px; padding-bottom: {{ p_bottom }}px;"
  {% if title != blank %}aria-label="{{ title | escape }}"{% endif %}
>
  <div class="page-container" style="max-width: {{ max_w }}px; margin: 0 auto; padding-left: 20px; padding-right: 20px;">
    
    <!-- Section Header (Only renders if enabled and at least one text field is non-empty) -->
    {%- if show_header -%}
      {%- assign has_header_content = false -%}
      {%- if show_eyebrow and eyebrow != blank -%}{%- assign has_header_content = true -%}{%- endif -%}
      {%- if show_title and title != blank -%}{%- assign has_header_content = true -%}{%- endif -%}
      {%- if show_subtitle and subtitle != blank -%}{%- assign has_header_content = true -%}{%- endif -%}

      {%- if has_header_content -%}
        <div class="fabric-showcase-header fabric-header-align-{{ header_align }}">
          {%- if show_eyebrow and eyebrow != blank -%}
            <span class="fabric-eyebrow" style="background-color: {{ eyebrow_bg }}; color: {{ eyebrow_color }}; font-size: {{ eyebrow_size }}px;">
              {{ eyebrow | escape }}
            </span>
          {%- endif -%}
          {%- if show_title and title != blank -%}
            <h2 class="fabric-title" style="color: {{ title_color }}; font-weight: {{ title_weight }}; text-transform: {{ title_transform }};">
              {{ title | escape }}
            </h2>
          {%- endif -%}
          {%- if show_subtitle and subtitle != blank -%}
            <p class="fabric-subtitle" style="color: {{ subtitle_color }}; font-size: {{ subtitle_size }}px;">
              {{ subtitle | escape }}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    <!-- Fabric Grid (Strict Two-Column Flow: Card 1 & 2 in Row 1; Card 3 & 4 in Row 2; etc.) -->
    <div
      class="fabric-cards-grid grid-desk-{{ desk_cols }} grid-tab-{{ tab_cols }} layout-mob-{{ mob_layout }}"
      style="--fab-gap-h: {{ gap_h }}px; --fab-gap-v: {{ gap_v }}px; --fab-gap-mob-h: {{ gap_mob_h }}px; --fab-gap-mob-v: {{ gap_mob_v }}px;"
    >
      {% for block in section.blocks %}
        {%- liquid
          # Card Enable Check
          if block.settings.enable_card == false
            continue
          endif

          # Content fields (No default string fallback)
          assign b_name = block.settings.title
          assign b_sub = block.settings.tagline
          assign b_desc = block.settings.description
          assign b_badges = block.settings.badges | split: ','

          # Image handling
          assign card_show_img = true
          if show_images_global == false or block.settings.show_card_image == false
            assign card_show_img = false
          endif
          assign b_image = block.settings.image

          assign card_ratio = img_ratio_global
          if block.settings.custom_aspect_ratio != 'inherit' and block.settings.custom_aspect_ratio != blank
            assign card_ratio = block.settings.custom_aspect_ratio
          endif

          assign card_img_fit = img_fit_global
          if block.settings.image_fit != 'inherit' and block.settings.image_fit != blank
            assign card_img_fit = block.settings.image_fit
          endif

          assign card_img_pos = block.settings.image_position | default: img_pos_global

          # Metric ratings
          assign b_soft = block.settings.rating_softness | default: 5
          assign b_breath = block.settings.rating_breathability | default: 4
          assign b_stretch = block.settings.rating_stretch | default: 5
          assign b_dur = block.settings.rating_durability | default: 5

          # Card-level badges visibility
          assign card_show_badges = true
          if show_badges_global == false or block.settings.show_card_badges == false or block.settings.badges == blank
            assign card_show_badges = false
          endif

          # Card-level metrics visibility
          assign card_show_metrics = true
          if show_metrics_global == false or block.settings.show_card_metrics == false
            assign card_show_metrics = false
          endif

          # Explore button URL & visibility
          assign card_show_explore = true
          if show_exp_btn_global == false or block.settings.show_card_explore_btn == false
            assign card_show_explore = false
          endif

          assign col_target = collections[block.settings.collection]
          assign b_link = ''
          if col_target != blank and col_target.url != blank
            assign b_link = col_target.url
          elsif block.settings.explore_link != blank
            assign b_link = block.settings.explore_link
          elsif block.settings.collection != blank
            assign b_link = '/collections/' | append: block.settings.collection
          else
            assign b_link = routes.all_products_collection_url
          endif

          assign b_exp_lbl = block.settings.btn_explore_text
          if b_exp_lbl == blank
            assign b_exp_lbl = btn_exp_lbl_global
          endif
          if b_exp_lbl == blank
            assign card_show_explore = false
          endif

          # Customize button URL & visibility
          assign card_show_cust = true
          if show_cust_btn_global == false or block.settings.show_card_customize_btn == false
            assign card_show_cust = false
          endif

          assign b_custom_link = block.settings.customize_link
          if b_custom_link == blank
            assign b_custom_link = '/pages/customize-your-own-scrub'
          endif

          assign b_cust_lbl = block.settings.btn_customize_text
          if b_cust_lbl == blank
            assign b_cust_lbl = btn_cust_lbl_global
          endif
          if b_cust_lbl == blank
            assign card_show_cust = false
          endif

          # Custom card styling overrides
          assign this_card_bg = card_bg_global
          if block.settings.card_bg != blank and block.settings.card_bg != 'rgba(0,0,0,0)'
            assign this_card_bg = block.settings.card_bg
          endif

          assign this_card_title_color = card_title_color
          if block.settings.card_text_color != blank and block.settings.card_text_color != 'rgba(0,0,0,0)'
            assign this_card_title_color = block.settings.card_text_color
          endif
        -%}

        <div
          class="enamels-fabric-card shadow-style-{{ card_shadow }}"
          id="shopify-block-{{ block.id }}"
          style="background-color: {{ this_card_bg }}; border-color: {{ card_border_global }}; border-width: {{ card_border_w }}px; border-radius: {{ card_radius }}px; {% if card_min_h > 0 %}min-height: {{ card_min_h }}px;{% endif %} {% if card_max_w > 0 %}max-width: {{ card_max_w }}px; margin-left: auto; margin-right: auto;{% endif %}"
          {{ block.shopify_attributes }}
        >
          
          <!-- Card Image & Badge Banner -->
          {%- if card_show_img and b_image != blank -%}
            <div
              class="fabric-card-media-wrap aspect-ratio-{{ card_ratio }}"
              style="border-top-left-radius: {{ card_radius }}px; border-top-right-radius: {{ card_radius }}px; {% if img_radius > 0 %}border-radius: {{ img_radius }}px; overflow: hidden; margin: 12px 12px 0;{% endif %} {% if img_max_h > 0 %}max-height: {{ img_max_h }}px;{% endif %}"
            >
              <img
                src="{{ b_image | image_url: width: 700 }}"
                alt="{{ b_name | default: 'Fabric' | escape }}"
                loading="lazy"
                decoding="async"
                width="700"
                height="400"
                class="fabric-card-img img-fit-{{ card_img_fit }} img-pos-{{ card_img_pos }}"
                style="{% if img_max_h > 0 %}max-height: {{ img_max_h }}px;{% endif %}"
              >

              {%- if card_show_badges -%}
                <div class="fabric-badge-strip">
                  {% for badge in b_badges %}
                    {% assign b_trimmed = badge | strip %}
                    {% if b_trimmed != blank %}
                      <span class="fabric-feature-pill" style="background: {{ badge_bg }}; color: {{ badge_text_color }};">
                        {{ b_trimmed }}
                      </span>
                    {% endif %}
                  {% endfor %}
                </div>
              {%- endif -%}
            </div>
          {%- elsif card_show_badges -%}
            <!-- Badges rendered inside card if no image -->
            <div class="fabric-badge-strip-inline" style="padding: 16px {{ card_padding }}px 0;">
              {% for badge in b_badges %}
                {% assign b_trimmed = badge | strip %}
                {% if b_trimmed != blank %}
                  <span class="fabric-feature-pill" style="background: {{ badge_bg }}; color: {{ badge_text_color }}; border: 1px solid #e2e8f0;">
                    {{ b_trimmed }}
                  </span>
                {% endif %}
              {% endfor %}
            </div>
          {%- endif -%}

          <!-- Card Content Body (Flex Layout with Equal-Height Bottom Pinning) -->
          <div class="fabric-card-body align-{{ card_align }}" style="padding: {{ card_padding }}px;">
            <div class="fabric-card-meta">
              {%- if b_name != blank -%}
                <h3 class="fabric-card-title" style="font-size: {{ card_title_size }}px; color: {{ this_card_title_color }};">
                  {{ b_name }}
                </h3>
              {%- endif -%}

              {%- if b_sub != blank -%}
                <span class="fabric-card-tagline" style="font-size: {{ card_tagline_size }}px; color: {{ card_tagline_color }};">
                  {{ b_sub }}
                </span>
              {%- endif -%}
            </div>

            {%- if b_desc != blank -%}
              <p class="fabric-card-desc" style="font-size: {{ card_desc_size }}px; color: {{ card_desc_color }};">
                {{ b_desc }}
              </p>
            {%- endif -%}

            <!-- Performance Metrics Radar / Bars (Only if enabled and at least 1 label is present) -->
            {%- if card_show_metrics -%}
              {%- assign has_metrics = false -%}
              {%- if meter_soft != blank or meter_breath != blank or meter_stretch != blank or meter_dur != blank -%}
                {%- assign has_metrics = true -%}
              {%- endif -%}

              {%- if has_metrics -%}
                <div
                  class="fabric-metrics-panel"
                  style="background-color: {{ metrics_bg }}; border-color: {{ metrics_border }};"
                  aria-label="Performance Metrics for {{ b_name | default: 'Fabric' | escape }}"
                >
                  
                  <!-- Softness Meter -->
                  {%- if meter_soft != blank -%}
                    <div class="metric-meter-row">
                      <div class="metric-info">
                        <span class="metric-name">{{ meter_soft }}</span>
                        <span class="metric-score" style="color: {{ meter_start_color }};">{{ b_soft }} / 5</span>
                      </div>
                      <div class="metric-track">
                        <div class="metric-fill" style="width: {{ b_soft | times: 20 }}%; background: linear-gradient(90deg, {{ meter_start_color }} 0%, {{ meter_end_color }} 100%);"></div>
                      </div>
                    </div>
                  {%- endif -%}

                  <!-- Breathability Meter -->
                  {%- if meter_breath != blank -%}
                    <div class="metric-meter-row">
                      <div class="metric-info">
                        <span class="metric-name">{{ meter_breath }}</span>
                        <span class="metric-score" style="color: {{ meter_start_color }};">{{ b_breath }} / 5</span>
                      </div>
                      <div class="metric-track">
                        <div class="metric-fill" style="width: {{ b_breath | times: 20 }}%; background: linear-gradient(90deg, {{ meter_start_color }} 0%, {{ meter_end_color }} 100%);"></div>
                      </div>
                    </div>
                  {%- endif -%}

                  <!-- 4-Way Stretch Meter -->
                  {%- if meter_stretch != blank -%}
                    <div class="metric-meter-row">
                      <div class="metric-info">
                        <span class="metric-name">{{ meter_stretch }}</span>
                        <span class="metric-score" style="color: {{ meter_start_color }};">{{ b_stretch }} / 5</span>
                      </div>
                      <div class="metric-track">
                        <div class="metric-fill" style="width: {{ b_stretch | times: 20 }}%; background: linear-gradient(90deg, {{ meter_start_color }} 0%, {{ meter_end_color }} 100%);"></div>
                      </div>
                    </div>
                  {%- endif -%}

                  <!-- Durability Meter -->
                  {%- if meter_dur != blank -%}
                    <div class="metric-meter-row">
                      <div class="metric-info">
                        <span class="metric-name">{{ meter_dur }}</span>
                        <span class="metric-score" style="color: {{ meter_start_color }};">{{ b_dur }} / 5</span>
                      </div>
                      <div class="metric-track">
                        <div class="metric-fill" style="width: {{ b_dur | times: 20 }}%; background: linear-gradient(90deg, {{ meter_start_color }} 0%, {{ meter_end_color }} 100%);"></div>
                      </div>
                    </div>
                  {%- endif -%}

                </div>
              {%- endif -%}
            {%- endif -%}

            <!-- Action CTAs (Anchored at the bottom) -->
            {%- if card_show_explore or card_show_cust -%}
              <div class="fabric-actions-row {% if card_show_explore and card_show_cust %}two-buttons{% else %}single-button{% endif %}">
                {%- if card_show_explore and b_exp_lbl != blank -%}
                  <a
                    href="{{ b_link }}"
                    class="btn-fabric-explore btn-style-{{ btn_style }}"
                    style="background: {{ btn_exp_bg }}; color: {{ btn_exp_color }}; border-radius: {{ btn_radius }}px;"
                  >
                    <span>{{ b_exp_lbl | escape }}</span>
                    <span class="arrow-icon" aria-hidden="true">→</span>
                  </a>
                {%- endif -%}

                {%- if card_show_cust and b_cust_lbl != blank -%}
                  <a
                    href="{{ b_custom_link }}"
                    class="btn-fabric-customize btn-style-{{ btn_style }}"
                    style="background: {{ btn_cust_bg }}; color: {{ btn_cust_color }}; border-color: {{ btn_cust_border }}; border-radius: {{ btn_radius }}px;"
                  >
                    <span>{{ b_cust_lbl | escape }}</span>
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}

          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

<style>
  .enamels-fabric-showcase-section {
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }
  .fabric-showcase-header {
    max-width: 820px;
    margin: 0 auto 44px;
  }
  .fabric-header-align-center {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }
  .fabric-header-align-left {
    text-align: left;
    margin-left: 0;
    margin-right: auto;
  }
  .fabric-header-align-right {
    text-align: right;
    margin-left: auto;
    margin-right: 0;
  }
  .fabric-eyebrow {
    display: inline-block;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 12px;
    line-height: 1.3;
  }
  .fabric-title {
    font-size: {{ title_size_desk }}px;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
    line-height: 1.25;
  }
  @media (max-width: 640px) {
    .fabric-title {
      font-size: {{ title_size_mob }}px !important;
    }
  }
  .fabric-subtitle {
    line-height: 1.6;
    margin: 0;
  }

  /* Strict CSS Grid Layout */
  #enamels-fabrics-{{ section.id }} .fabric-cards-grid {
    display: grid !important;
    grid-template-columns: repeat({{ desk_cols }}, minmax(0, 1fr)) !important;
    column-gap: var(--fab-gap-h, 28px) !important;
    row-gap: var(--fab-gap-v, 28px) !important;
    align-items: {{ grid_align }} !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  /* Tablet: Independent Column System (Defaults to 2 Columns) */
  @media (max-width: 991px) {
    #enamels-fabrics-{{ section.id }} .fabric-cards-grid {
      grid-template-columns: repeat({{ tab_cols }}, minmax(0, 1fr)) !important;
      column-gap: calc(var(--fab-gap-h, 28px) * 0.75) !important;
      row-gap: calc(var(--fab-gap-v, 28px) * 0.85) !important;
    }
  }

  /* Mobile: Configurable (2 Columns, 1 Column, or Horizontal Carousel) */
  @media (max-width: 640px) {
    {% if mob_layout == '2' or mob_layout == '2_col' %}
      #enamels-fabrics-{{ section.id }} .fabric-cards-grid {
        display: grid !important;
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        column-gap: var(--fab-gap-mob-h, 12px) !important;
        row-gap: var(--fab-gap-mob-v, 16px) !important;
      }
      #enamels-fabrics-{{ section.id }} .fabric-card-body {
        padding: 14px !important;
      }
      #enamels-fabrics-{{ section.id }} .fabric-card-title {
        font-size: 16px !important;
      }
      #enamels-fabrics-{{ section.id }} .fabric-card-tagline {
        font-size: 10px !important;
      }
      #enamels-fabrics-{{ section.id }} .fabric-card-desc {
        font-size: 11px !important;
        line-height: 1.4 !important;
      }
      #enamels-fabrics-{{ section.id }} .fabric-metrics-panel {
        padding: 10px !important;
        gap: 8px !important;
      }
      #enamels-fabrics-{{ section.id }} .metric-info {
        font-size: 10px !important;
      }
      #enamels-fabrics-{{ section.id }} .btn-fabric-explore,
      #enamels-fabrics-{{ section.id }} .btn-fabric-customize {
        padding: 8px 10px !important;
        font-size: 11px !important;
      }
    {% elsif mob_layout == '1' or mob_layout == '1_col' %}
      #enamels-fabrics-{{ section.id }} .fabric-cards-grid {
        display: grid !important;
        grid-template-columns: 1fr !important;
        row-gap: var(--fab-gap-mob-v, 16px) !important;
      }
    {% elsif mob_layout == 'scroll' %}
      #enamels-fabrics-{{ section.id }} .fabric-cards-grid {
        display: flex !important;
        overflow-x: auto !important;
        scroll-snap-type: x mandatory !important;
        -webkit-overflow-scrolling: touch !important;
        padding-bottom: 16px !important;
        margin-left: -20px !important;
        margin-right: -20px !important;
        padding-left: 20px !important;
        padding-right: 20px !important;
        gap: var(--fab-gap-mob-h, 12px) !important;
        scrollbar-width: thin;
      }
      #enamels-fabrics-{{ section.id }} .fabric-cards-grid::-webkit-scrollbar {
        height: 4px;
      }
      #enamels-fabrics-{{ section.id }} .fabric-cards-grid::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
      }
      #enamels-fabrics-{{ section.id }} .enamels-fabric-card {
        flex: 0 0 calc(85vw - 20px) !important;
        max-width: 380px !important;
        scroll-snap-align: start !important;
      }
    {% endif %}
  }

  /* Equal Height Card Containers & Content Flow */
  #enamels-fabrics-{{ section.id }} .enamels-fabric-card {
    border-style: solid;
    overflow: hidden;
    display: flex !important;
    flex-direction: column !important;
    height: 100% !important;
    width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .shadow-style-none {
    box-shadow: none;
  }
  .shadow-style-subtle {
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
  }
  .shadow-style-medium {
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
  }
  .shadow-style-hover_elevate {
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  }
  .shadow-style-hover_elevate:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px rgba(0, 135, 121, 0.12);
  }

  /* Card Media */
  .fabric-card-media-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #f8fafc;
  }
  .aspect-ratio-16_9 { aspect-ratio: 16 / 9; }
  .aspect-ratio-4_3 { aspect-ratio: 4 / 3; }
  .aspect-ratio-1_1 { aspect-ratio: 1 / 1; }
  .aspect-ratio-3_2 { aspect-ratio: 3 / 2; }
  .aspect-ratio-2_1 { aspect-ratio: 2 / 1; }
  .aspect-ratio-auto { height: auto; min-height: 220px; }

  .fabric-card-img {
    width: 100%;
    height: 100%;
    display: block;
    transition: transform 0.4s ease;
  }
  .img-fit-cover { object-fit: cover; }
  .img-fit-contain { object-fit: contain; }
  .img-pos-center { object-position: center; }
  .img-pos-top { object-position: top; }
  .img-pos-bottom { object-position: bottom; }

  .enamels-fabric-card:hover .fabric-card-img {
    transform: scale(1.03);
  }

  .fabric-badge-strip {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    z-index: 2;
  }
  .fabric-badge-strip-inline {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .fabric-feature-pill {
    font-size: 11px;
    font-weight: 700;
    backdrop-filter: blur(4px);
    padding: 4px 10px;
    border-radius: 999px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    line-height: 1.3;
  }

  /* Card Body (Vertical Alignment & Spacing) */
  #enamels-fabrics-{{ section.id }} .fabric-card-body {
    display: flex !important;
    flex-direction: column !important;
    flex: 1 1 auto !important;
    justify-content: space-between !important;
    box-sizing: border-box !important;
  }
  .fabric-card-body.align-center {
    text-align: center;
  }
  .fabric-card-body.align-left {
    text-align: left;
  }
  .fabric-card-title {
    font-weight: 800;
    margin: 0 0 6px;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .fabric-card-tagline {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: block;
    margin-bottom: 12px;
    line-height: 1.3;
  }
  #enamels-fabrics-{{ section.id }} .fabric-card-desc {
    flex-grow: 1 !important;
    margin: 0 0 16px 0 !important;
    line-height: 1.6;
  }

  /* Metrics Panel */
  #enamels-fabrics-{{ section.id }} .fabric-metrics-panel {
    border: 1px solid;
    border-radius: 12px;
    padding: 16px;
    margin-top: auto !important;
    margin-bottom: 16px !important;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-sizing: border-box;
  }
  .metric-meter-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .metric-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
  }
  .metric-name {
    font-weight: 600;
    color: #334155;
  }
  .metric-score {
    font-weight: 700;
    font-size: 11px;
  }
  .metric-track {
    width: 100%;
    height: 7px;
    background: #e2e8f0;
    border-radius: 999px;
    overflow: hidden;
  }
  .metric-fill {
    height: 100%;
    border-radius: 999px;
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Actions Row */
  #enamels-fabrics-{{ section.id }} .fabric-actions-row {
    display: grid;
    gap: 10px;
    margin-top: auto !important;
  }
  .fabric-actions-row.two-buttons {
    grid-template-columns: 1fr 1fr;
  }
  .fabric-actions-row.single-button {
    grid-template-columns: 1fr;
  }
  @media (max-width: 480px) {
    .fabric-actions-row.two-buttons {
      grid-template-columns: 1fr;
    }
  }

  .btn-fabric-explore,
  .btn-fabric-customize {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 12px 16px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
    transition: all 0.2s ease;
    box-sizing: border-box;
    line-height: 1.3;
  }
  .btn-style-pill {
    border-radius: 999px !important;
  }
  .btn-style-outline {
    background: transparent !important;
    border: 1.5px solid currentColor !important;
  }

  .btn-fabric-explore:hover {
    filter: brightness(1.15);
    transform: translateY(-1px);
  }
  .btn-fabric-customize {
    border: 1.5px solid;
  }
  .btn-fabric-customize:hover {
    filter: brightness(0.96);
    transform: translateY(-1px);
  }
