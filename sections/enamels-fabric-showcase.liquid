{% comment %}
  Section: enamels-fabric-showcase.liquid
  Description: Interactive Technical Fabric Showcase with rating meters, clinical specs, and customization CTAs.
  Fully editable via Shopify Theme Editor.
{% endcomment %}

{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign max_w = section.settings.container_width | default: 1320
  assign p_top = section.settings.padding_top | default: 48
  assign p_bottom = section.settings.padding_bottom | default: 48

  assign eyebrow = section.settings.eyebrow | default: 'ENGINEERED CLINICAL TEXTILES'
  assign eyebrow_bg = section.settings.eyebrow_bg | default: '#e6fffa'
  assign eyebrow_color = section.settings.eyebrow_color | default: '#008779'

  assign title = section.settings.title | default: 'Explore Our Technical Fabrics'
  assign title_size_desk = section.settings.title_size_desktop | default: 32
  assign title_size_mob = section.settings.title_size_mobile | default: 24
  assign title_color = section.settings.title_color | default: '#0f172a'

  assign subtitle = section.settings.subtitle | default: 'Precision-woven for intense hospital shifts. Discover the tactile science behind our antimicrobial, fluid-repellent, and 4-way stretch clinical weaves.'
  assign subtitle_color = section.settings.subtitle_color | default: '#64748b'

  assign btn_exp_lbl = section.settings.btn_explore_label | default: 'View Collection'
  assign btn_cust_lbl = section.settings.btn_customize_label | default: 'Customize in this Fabric'

  assign meter_soft = section.settings.meter_softness_label | default: 'Silky Softness'
  assign meter_breath = section.settings.meter_breath_label | default: 'Thermal Breathability'
  assign meter_stretch = section.settings.meter_stretch_label | default: '4-Way Micro-Stretch'
  assign meter_dur = section.settings.meter_dur_label | default: 'Autoclave & Wash Resilience'
-%}

<section
  class="enamels-fabric-showcase-section"
  id="enamels-fabrics-{{ section.id }}"
  style="background-color: {{ bg_color }}; padding-top: {{ p_top }}px; padding-bottom: {{ p_bottom }}px;"
  aria-label="{{ title | escape }}"
>
  <div class="page-container" style="max-width: {{ max_w }}px; margin: 0 auto; padding-left: 20px; padding-right: 20px;">
    
    <!-- Section Header -->
    <div class="fabric-showcase-header" style="text-align: center; max-width: 760px; margin: 0 auto 48px;">
      {% if eyebrow != blank %}
        <span class="fabric-eyebrow" style="background-color: {{ eyebrow_bg }}; color: {{ eyebrow_color }};">
          {{ eyebrow | escape }}
        </span>
      {% endif %}
      {% if title != blank %}
        <h2 class="fabric-title" style="color: {{ title_color }};">
          {{ title | escape }}
        </h2>
      {% endif %}
      {% if subtitle != blank %}
        <p class="fabric-subtitle" style="color: {{ subtitle_color }};">
          {{ subtitle | escape }}
        </p>
      {% endif %}
    </div>

    <!-- Fabric Grid -->
    <div class="fabric-cards-grid">
      {% for block in section.blocks %}
        {%- liquid
          assign b_name = block.settings.title | default: 'Technical Fabric'
          assign b_sub = block.settings.tagline | default: 'Clinical Grade Performance'
          assign b_desc = block.settings.description
          assign b_soft = block.settings.rating_softness | default: 5
          assign b_breath = block.settings.rating_breathability | default: 4
          assign b_stretch = block.settings.rating_stretch | default: 5
          assign b_dur = block.settings.rating_durability | default: 5
          assign b_badges = block.settings.badges | split: ','

          assign col_target = collections[block.settings.collection]
          assign b_link = ''
          if col_target != blank and col_target.url != blank
            assign b_link = col_target.url
          elsif block.settings.explore_link != blank
            assign b_link = block.settings.explore_link
          else
            assign b_link = routes.all_products_collection_url
          endif

          assign b_custom_link = block.settings.customize_link | default: '/pages/customizer'
          assign b_image = block.settings.image
        -%}
        <div class="enamels-fabric-card" id="shopify-block-{{ block.id }}" {{ block.shopify_attributes }}>
          
          <!-- Card Image & Badge Banner -->
          <div class="fabric-card-media-wrap">
            {% if b_image != blank %}
              <img
                src="{{ b_image | image_url: width: 600 }}"
                alt="{{ b_name | escape }}"
                loading="lazy"
                decoding="async"
                width="600"
                height="340"
                class="fabric-card-img"
              >
            {% else %}
              <div class="fabric-card-img-placeholder" style="background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);">
                <span class="placeholder-icon">🔬</span>
              </div>
            {% endif %}

            <div class="fabric-badge-strip">
              {% for badge in b_badges %}
                {% assign b_trimmed = badge | strip %}
                {% if b_trimmed != blank %}
                  <span class="fabric-feature-pill">{{ b_trimmed }}</span>
                {% endif %}
              {% endfor %}
            </div>
          </div>

          <!-- Card Content -->
          <div class="fabric-card-body">
            <div class="fabric-card-meta">
              <h3 class="fabric-card-title">{{ b_name }}</h3>
              <span class="fabric-card-tagline">{{ b_sub }}</span>
            </div>

            {% if b_desc != blank %}
              <p class="fabric-card-desc">{{ b_desc }}</p>
            {% endif %}

            <!-- Performance Metrics Radar / Bars -->
            <div class="fabric-metrics-panel" aria-label="Performance Metrics for {{ b_name | escape }}">
              
              <!-- Softness Meter -->
              <div class="metric-meter-row">
                <div class="metric-info">
                  <span class="metric-name">{{ meter_soft }}</span>
                  <span class="metric-score">{{ b_soft }} / 5</span>
                </div>
                <div class="metric-track">
                  <div class="metric-fill" style="width: {{ b_soft | times: 20 }}%;"></div>
                </div>
              </div>

              <!-- Breathability Meter -->
              <div class="metric-meter-row">
                <div class="metric-info">
                  <span class="metric-name">{{ meter_breath }}</span>
                  <span class="metric-score">{{ b_breath }} / 5</span>
                </div>
                <div class="metric-track">
                  <div class="metric-fill" style="width: {{ b_breath | times: 20 }}%;"></div>
                </div>
              </div>

              <!-- 4-Way Stretch Meter -->
              <div class="metric-meter-row">
                <div class="metric-info">
                  <span class="metric-name">{{ meter_stretch }}</span>
                  <span class="metric-score">{{ b_stretch }} / 5</span>
                </div>
                <div class="metric-track">
                  <div class="metric-fill" style="width: {{ b_stretch | times: 20 }}%;"></div>
                </div>
              </div>

              <!-- Durability Meter -->
              <div class="metric-meter-row">
                <div class="metric-info">
                  <span class="metric-name">{{ meter_dur }}</span>
                  <span class="metric-score">{{ b_dur }} / 5</span>
                </div>
                <div class="metric-track">
                  <div class="metric-fill" style="width: {{ b_dur | times: 20 }}%;"></div>
                </div>
              </div>

            </div>

            <!-- Action CTAs -->
            <div class="fabric-actions-row">
              <a href="{{ b_link }}" class="btn-fabric-explore">
                <span>{{ btn_exp_lbl | escape }}</span>
                <span class="arrow-icon">→</span>
              </a>
              <a href="{{ b_custom_link }}" class="btn-fabric-customize">
                <span>{{ btn_cust_lbl | escape }}</span>
              </a>
            </div>

          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

<style>
  .enamels-fabric-showcase-section {
    border-top: 1px solid #f1f5f9;
  }
  .fabric-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 12px;
  }
  .fabric-title {
    font-size: {{ title_size_desk }}px;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }
  @media (max-width: 640px) {
    .fabric-title {
      font-size: {{ title_size_mob }}px !important;
    }
  }
  .fabric-subtitle {
    font-size: 15px;
    line-height: 1.6;
    margin: 0;
  }
  .fabric-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }
  @media (max-width: 991px) {
    .fabric-cards-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
  .enamels-fabric-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .enamels-fabric-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 135, 121, 0.1);
    border-color: #008779;
  }
  .fabric-card-media-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #f8fafc;
  }
  .fabric-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .enamels-fabric-card:hover .fabric-card-img {
    transform: scale(1.03);
  }
  .fabric-card-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36px;
  }
  .fabric-badge-strip {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    z-index: 2;
  }
  .fabric-feature-pill {
    font-size: 11px;
    font-weight: 700;
    color: #0f172a;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(4px);
    padding: 4px 10px;
    border-radius: 999px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  }
  .fabric-card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-between;
  }
  .fabric-card-title {
    font-size: 20px;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 4px;
    letter-spacing: -0.01em;
  }
  .fabric-card-tagline {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #008779;
    display: block;
    margin-bottom: 12px;
  }
  .fabric-card-desc {
    font-size: 13px;
    color: #475569;
    line-height: 1.6;
    margin: 0 0 20px;
  }
  .fabric-metrics-panel {
    background: #f8fafc;
    border: 1px solid #edf2f7;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .metric-meter-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .metric-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
  }
  .metric-name {
    font-weight: 600;
    color: #334155;
  }
  .metric-score {
    font-weight: 700;
    color: #008779;
    font-size: 11px;
  }
  .metric-track {
    width: 100%;
    height: 7px;
    background: #e2e8f0;
    border-radius: 999px;
    overflow: hidden;
  }
  .metric-fill {
    height: 100%;
    background: linear-gradient(90deg, #008779 0%, #14b8a6 100%);
    border-radius: 999px;
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .fabric-actions-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: auto;
  }
  @media (max-width: 480px) {
    .fabric-actions-row {
      grid-template-columns: 1fr;
    }
  }
  .btn-fabric-explore,
  .btn-fabric-customize {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 12px 16px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 8px;
    text-align: center;
    transition: all 0.2s ease;
  }
  .btn-fabric-explore {
    background: #0f172a;
    color: #ffffff;
  }
  .btn-fabric-explore:hover {
    background: #1e293b;
    color: #ffffff;
  }
  .btn-fabric-customize {
    background: #f0fdfa;
    color: #008779;
    border: 1.5px solid #99f6e4;
  }
  .btn-fabric-customize:hover {
    background: #008779;
    color: #ffffff;
    border-color: #008779;
  }
</style>

{% schema %}
{
  "name": "Explore Our Fabrics",
  "tag": "section",
  "class": "section-enamels-fabrics",
  "settings": [
    {
      "type": "header",
      "content": "Section Header & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Container Max Width",
      "default": 1320
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Tag Text",
      "default": "ENGINEERED CLINICAL TEXTILES"
    },
    {
      "type": "color",
      "id": "eyebrow_bg",
      "label": "Eyebrow Background",
      "default": "#e6fffa"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Text Color",
      "default": "#008779"
    },
    {
      "type": "text",
      "id": "title",
