      "default": "Explore Our Technical Fabrics"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "min": 22,
      "max": 44,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size (Desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 18,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size (Mobile)",
      "default": 24
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading Color",
      "default": "#0f172a"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Precision-woven for intense hospital shifts. Discover the tactile science behind our antimicrobial, fluid-repellent, and 4-way stretch clinical weaves."
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#64748b"
    },
    {
      "type": "header",
      "content": "Action Buttons Labels"
    },
    {
      "type": "text",
      "id": "btn_explore_label",
      "label": "Collection Button Label",
      "default": "View Collection"
    },
    {
      "type": "text",
      "id": "btn_customize_label",
      "label": "Customize Button Label",
