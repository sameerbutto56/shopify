{% comment %}
  Section: enamels-bundle-builder.liquid
  Description: Interactive Clinical Bundle Builder with category tabs, real variant pickers,
  live tiered discount calculation, and multi-item cart submission.
  Full Shopify Theme Editor editability for every text, color, button, icon, and collection.
{% endcomment %}

{%- liquid
  assign bg_color = section.settings.bg_color | default: '#f8fafc'
  assign max_w = section.settings.container_width | default: 1320
  assign p_top = section.settings.padding_top | default: 48
  assign p_bottom = section.settings.padding_bottom | default: 80

  assign show_eyebrow = section.settings.show_eyebrow
  assign eyebrow = section.settings.eyebrow | default: 'CREATE YOUR COMPLETE CLINICAL SET'
  assign eyebrow_bg = section.settings.eyebrow_bg | default: '#e6fffa'
  assign eyebrow_color = section.settings.eyebrow_color | default: '#008779'

  assign title = section.settings.title | default: 'Build Your Clinical Bundle & Save'
  assign title_size_desk = section.settings.title_size_desktop | default: 32
  assign title_size_mob = section.settings.title_size_mobile | default: 24
  assign title_color = section.settings.title_color | default: '#0f172a'

  assign subtitle = section.settings.subtitle | default: 'Mix and match tops, trousers, lab coats, and accessories. Unlock up to 10% instant bundle savings and free clinical delivery.'
  assign subtitle_color = section.settings.subtitle_color | default: '#64748b'
  assign text_align = section.settings.text_alignment | default: 'center'

  # Tier Ribbon Settings
  assign show_tier_ribbon = section.settings.show_tier_ribbon
  assign tier1_count = section.settings.tier1_count | default: 2
  assign tier1_discount = section.settings.tier1_discount | default: 5
  assign tier1_text = section.settings.tier1_text | default: 'Pick Any 2: Save 5%'

  assign tier2_count = section.settings.tier2_count | default: 3
  assign tier2_discount = section.settings.tier2_discount | default: 10
  assign tier2_text = section.settings.tier2_text | default: 'Pick Any 3+: Save 10%'

  assign shipping_text = section.settings.shipping_text | default: 'Nationwide Free Shipping'
  assign shipping_icon = section.settings.shipping_icon | default: '🚚'

  # Tab 1: Tops
  assign show_tab_tops = section.settings.tab_tops_show
  assign tab_tops_label = section.settings.tab_tops_label | default: '1. Scrub Tops'
  assign tab_tops_icon = section.settings.tab_tops_icon | default: '🥼'
  assign col_tops = collections[section.settings.col_tops]

  # Tab 2: Trousers
  assign show_tab_trousers = section.settings.tab_trousers_show
  assign tab_trousers_label = section.settings.tab_trousers_label | default: '2. Scrub Trousers'
  assign tab_trousers_icon = section.settings.tab_trousers_icon | default: '👖'
  assign col_trousers = collections[section.settings.col_trousers]

  # Tab 3: Lab Coats
  assign show_tab_labcoats = section.settings.tab_labcoats_show
  assign tab_labcoats_label = section.settings.tab_labcoats_label | default: '3. Lab Coats'
  assign tab_labcoats_icon = section.settings.tab_labcoats_icon | default: '🩺'
  assign col_labcoats = collections[section.settings.col_labcoats]

  # Tab 4: Caps
  assign show_tab_caps = section.settings.tab_caps_show
  assign tab_caps_label = section.settings.tab_caps_label | default: '4. Surgical Caps'
  assign tab_caps_icon = section.settings.tab_caps_icon | default: '🧢'
  assign col_caps = collections[section.settings.col_caps]

  # Tab 5: Accessories
  assign show_tab_accessories = section.settings.tab_accessories_show
  assign tab_accessories_label = section.settings.tab_accessories_label | default: '5. Underscrubs / Gear'
  assign tab_accessories_icon = section.settings.tab_accessories_icon | default: '✨'
  assign col_accessories = collections[section.settings.col_accessories]

  # Card & Action Settings
  assign products_limit = section.settings.products_limit | default: 12
  assign btn_add_label = section.settings.btn_add_label | default: '+ Add to Bundle'
  assign btn_added_label = section.settings.btn_added_label | default: '✓ Added in Bundle'
  assign empty_state_text = section.settings.empty_state_text | default: 'Collection currently being updated'
  assign show_sale_pill = section.settings.show_sale_pill
  assign sale_pill_text = section.settings.sale_pill_text | default: 'SALE'

  # Sticky Bar Settings
  assign show_sticky_bar = section.settings.show_sticky_bar
  assign empty_tray_hint = section.settings.empty_tray_hint | default: 'Select items to start your bundle'
  assign btn_cart_label = section.settings.btn_cart_label | default: 'Add Bundle to Cart'
  assign btn_cart_bg = section.settings.btn_cart_bg | default: '#008779'
  assign btn_cart_text_color = section.settings.btn_cart_text_color | default: '#ffffff'
  assign redirect_target = section.settings.redirect_target | default: 'cart'
-%}

<section
  class="enamels-bundle-builder-section"
  id="enamels-bundle-builder-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-tier1-count="{{ tier1_count }}"
  data-tier1-discount="{{ tier1_discount }}"
  data-tier2-count="{{ tier2_count }}"
  data-tier2-discount="{{ tier2_discount }}"
  data-btn-add-label="{{ btn_add_label | escape }}"
  data-btn-added-label="{{ btn_added_label | escape }}"
  data-redirect="{{ redirect_target }}"
  style="background-color: {{ bg_color }}; padding-top: {{ p_top }}px; padding-bottom: {% if show_sticky_bar %}calc({{ p_bottom }}px + 60px){% else %}{{ p_bottom }}px{% endif %};"
  aria-label="{{ title | escape }}"
>
  <div class="page-container" style="max-width: {{ max_w }}px; margin: 0 auto; padding-left: 20px; padding-right: 20px;">
    
    <!-- Section Header -->
    <div class="bundle-header" style="text-align: {{ text_align }}; max-width: 800px; margin: 0 auto 36px;">
      {% if show_eyebrow and eyebrow != blank %}
        <span class="bundle-eyebrow" style="background-color: {{ eyebrow_bg }}; color: {{ eyebrow_color }};">
          {{ eyebrow | escape }}
        </span>
      {% endif %}
      {% if title != blank %}
        <h2 class="bundle-title" style="color: {{ title_color }};">
          {{ title | escape }}
        </h2>
      {% endif %}
      {% if subtitle != blank %}
        <p class="bundle-subtitle" style="color: {{ subtitle_color }};">
          {{ subtitle | escape }}
        </p>
      {% endif %}

      <!-- Tiered Discount Ribbon -->
      {% if show_tier_ribbon %}
        <div class="bundle-tiers-ribbon">
          <div class="tier-step active" id="tier-step-1-{{ section.id }}">
            <span class="tier-bullet">1</span>
            <span class="tier-label">{{ tier1_text | escape }}</span>
          </div>
          <div class="tier-divider"></div>
          <div class="tier-step" id="tier-step-2-{{ section.id }}">
            <span class="tier-bullet">2</span>
            <span class="tier-label">{{ tier2_text | escape }}</span>
          </div>
          <div class="tier-divider"></div>
          <div class="tier-step">
            <span class="tier-bullet">{{ shipping_icon | escape }}</span>
            <span class="tier-label">{{ shipping_text | escape }}</span>
          </div>
        </div>
      {% endif %}
    </div>

    <!-- Category Tabs Navigation -->
    <div class="bundle-tabs-container">
      <div class="bundle-tabs-scroller" role="tablist">
        {% if show_tab_tops %}
          <button type="button" class="bundle-tab-btn active" role="tab" aria-selected="true" data-tab="tops" onclick="window.enamelsSwitchBundleTab('{{ section.id }}', 'tops')">
            <span class="tab-icon">{{ tab_tops_icon }}</span>
            <span class="tab-text">{{ tab_tops_label | escape }}</span>
            <span class="tab-count-badge" id="b-count-tops-{{ section.id }}">0</span>
          </button>
        {% endif %}

        {% if show_tab_trousers %}
          <button type="button" class="bundle-tab-btn {% unless show_tab_tops %}active{% endunless %}" role="tab" aria-selected="{% if show_tab_tops %}false{% else %}true{% endif %}" data-tab="trousers" onclick="window.enamelsSwitchBundleTab('{{ section.id }}', 'trousers')">
            <span class="tab-icon">{{ tab_trousers_icon }}</span>
            <span class="tab-text">{{ tab_trousers_label | escape }}</span>
            <span class="tab-count-badge" id="b-count-trousers-{{ section.id }}">0</span>
          </button>
        {% endif %}

        {% if show_tab_labcoats %}
          <button type="button" class="bundle-tab-btn" role="tab" aria-selected="false" data-tab="labcoats" onclick="window.enamelsSwitchBundleTab('{{ section.id }}', 'labcoats')">
            <span class="tab-icon">{{ tab_labcoats_icon }}</span>
            <span class="tab-text">{{ tab_labcoats_label | escape }}</span>
            <span class="tab-count-badge" id="b-count-labcoats-{{ section.id }}">0</span>
          </button>
        {% endif %}

        {% if show_tab_caps %}
          <button type="button" class="bundle-tab-btn" role="tab" aria-selected="false" data-tab="caps" onclick="window.enamelsSwitchBundleTab('{{ section.id }}', 'caps')">
            <span class="tab-icon">{{ tab_caps_icon }}</span>
            <span class="tab-text">{{ tab_caps_label | escape }}</span>
            <span class="tab-count-badge" id="b-count-caps-{{ section.id }}">0</span>
          </button>
        {% endif %}

        {% if show_tab_accessories %}
          <button type="button" class="bundle-tab-btn" role="tab" aria-selected="false" data-tab="accessories" onclick="window.enamelsSwitchBundleTab('{{ section.id }}', 'accessories')">
            <span class="tab-icon">{{ tab_accessories_icon }}</span>
            <span class="tab-text">{{ tab_accessories_label | escape }}</span>
            <span class="tab-count-badge" id="b-count-accessories-{{ section.id }}">0</span>
          </button>
        {% endif %}
      </div>
    </div>

    <!-- Tab Panels Container -->
    <div class="bundle-tab-panels">
      {% if show_tab_tops %}
        <div class="bundle-panel active" id="bpanel-{{ section.id }}-tops" role="tabpanel">
          {% render 'enamels-bundle-product-grid',
            collection_obj: col_tops,
            section_id: section.id,
            category_key: 'tops',
            products_limit: products_limit,
            btn_add_label: btn_add_label,
            btn_added_label: btn_added_label,
            empty_state_text: empty_state_text,
            show_sale_pill: show_sale_pill,
            sale_pill_text: sale_pill_text
          %}
        </div>
      {% endif %}

      {% if show_tab_trousers %}
        <div class="bundle-panel {% unless show_tab_tops %}active{% endunless %}" id="bpanel-{{ section.id }}-trousers" role="tabpanel" style="{% if show_tab_tops %}display: none;{% endif %}">
          {% render 'enamels-bundle-product-grid',
            collection_obj: col_trousers,
            section_id: section.id,
            category_key: 'trousers',
            products_limit: products_limit,
            btn_add_label: btn_add_label,
            btn_added_label: btn_added_label,
            empty_state_text: empty_state_text,
            show_sale_pill: show_sale_pill,
            sale_pill_text: sale_pill_text
          %}
        </div>
      {% endif %}

      {% if show_tab_labcoats %}
        <div class="bundle-panel" id="bpanel-{{ section.id }}-labcoats" role="tabpanel" style="display: none;">
          {% render 'enamels-bundle-product-grid',
            collection_obj: col_labcoats,
            section_id: section.id,
            category_key: 'labcoats',
            products_limit: products_limit,
            btn_add_label: btn_add_label,
            btn_added_label: btn_added_label,
            empty_state_text: empty_state_text,
            show_sale_pill: show_sale_pill,
            sale_pill_text: sale_pill_text
          %}
        </div>
      {% endif %}

      {% if show_tab_caps %}
        <div class="bundle-panel" id="bpanel-{{ section.id }}-caps" role="tabpanel" style="display: none;">
          {% render 'enamels-bundle-product-grid',
            collection_obj: col_caps,
            section_id: section.id,
            category_key: 'caps',
            products_limit: products_limit,
            btn_add_label: btn_add_label,
            btn_added_label: btn_added_label,
            empty_state_text: empty_state_text,
            show_sale_pill: show_sale_pill,
            sale_pill_text: sale_pill_text
          %}
        </div>
      {% endif %}

      {% if show_tab_accessories %}
        <div class="bundle-panel" id="bpanel-{{ section.id }}-accessories" role="tabpanel" style="display: none;">
          {% render 'enamels-bundle-product-grid',
            collection_obj: col_accessories,
            section_id: section.id,
            category_key: 'accessories',
            products_limit: products_limit,
            btn_add_label: btn_add_label,
            btn_added_label: btn_added_label,
            empty_state_text: empty_state_text,
            show_sale_pill: show_sale_pill,
            sale_pill_text: sale_pill_text
          %}
        </div>
      {% endif %}
    </div>

  </div>

  <!-- Sticky Bottom Bundle Summary Bar -->
  {% if show_sticky_bar %}
    <div class="enamels-sticky-bundle-bar" id="sticky-bundle-bar-{{ section.id }}">
      <div class="page-container" style="max-width: {{ max_w }}px; margin: 0 auto; padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px;">
        
        <!-- Selected Items Mini Previews -->
        <div class="bundle-bar-left" style="display: flex; align-items: center; gap: 14px;">
          <div class="bundle-bar-items-tray" id="bundle-tray-{{ section.id }}">
            <div class="tray-empty-hint">{{ empty_tray_hint | escape }}</div>
          </div>
          <div class="bundle-bar-meta">
            <div class="bundle-count-line"><strong id="bundle-total-count-{{ section.id }}">0</strong> items selected</div>
            <div class="bundle-discount-badge" id="bundle-tier-badge-{{ section.id }}">
              Add {{ tier1_count }} items for {{ tier1_discount }}% off
            </div>
          </div>
        </div>

        <!-- Price & Checkout CTA -->
        <div class="bundle-bar-right" style="display: flex; align-items: center; gap: 16px;">
          <div class="bundle-price-box" style="text-align: right;">
            <div class="bundle-original-price" id="bundle-original-price-{{ section.id }}" style="display: none;">PKR 0</div>
            <div class="bundle-final-price" id="bundle-final-price-{{ section.id }}">PKR 0</div>
          </div>
          <button
            type="button"
            class="btn-add-bundle-cart"
            id="btn-add-bundle-{{ section.id }}"
            disabled
            onclick="window.enamelsSubmitBundleToCart('{{ section.id }}')"
            style="background-color: {{ btn_cart_bg }}; color: {{ btn_cart_text_color }};"
          >
            <span class="btn-text">{{ btn_cart_label | escape }}</span>
            <span class="btn-loading" style="display: none;">Adding to Cart...</span>
          </button>
        </div>

      </div>
    </div>
  {% endif %}
</section>

<style>
  .enamels-bundle-builder-section {
    position: relative;
    border-top: 1px solid #e2e8f0;
  }
  .bundle-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 12px;
  }
  .bundle-title {
    font-size: {{ title_size_desk }}px;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }
  @media (max-width: 640px) {
    .bundle-title {
      font-size: {{ title_size_mob }}px !important;
    }
  }
  .bundle-subtitle {
    font-size: 15px;
    line-height: 1.6;
    margin: 0 auto 24px;
  }
  .bundle-tiers-ribbon {
    display: inline-flex;
    align-items: center;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    padding: 6px 16px;
    gap: 12px;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.05);
  }
  @media (max-width: 768px) {
    .bundle-tiers-ribbon {
      flex-direction: column;
      border-radius: 12px;
      align-items: flex-start;
      padding: 12px;
      width: 100%;
    }
    .tier-divider { display: none; }
  }
  .tier-step {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #475569;
  }
  .tier-step.active {
    color: #008779;
    font-weight: 700;
  }
  .tier-bullet {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #f1f5f9;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 800;
    color: #0f172a;
  }
  .tier-step.active .tier-bullet {
    background: #008779;
    color: #ffffff;
  }
  .tier-divider {
    width: 1px;
    height: 16px;
    background: #cbd5e1;
  }

  /* Tabs Bar */
  .bundle-tabs-container {
    margin-bottom: 32px;
    border-bottom: 2px solid #e2e8f0;
  }
  .bundle-tabs-scroller {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 12px;
    scrollbar-width: none;
  }
  .bundle-tabs-scroller::-webkit-scrollbar { display: none; }
  .bundle-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    color: #334155;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .bundle-tab-btn:hover {
    border-color: #008779;
    color: #008779;
  }
  .bundle-tab-btn.active {
    background: #008779;
    border-color: #008779;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(0, 135, 121, 0.2);
  }
  .tab-count-badge {
    background: rgba(0, 0, 0, 0.08);
    font-size: 11px;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 999px;
  }
  .bundle-tab-btn.active .tab-count-badge {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  /* Sticky Summary Bar */
  .enamels-sticky-bundle-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #ffffff;
    border-top: 2px solid #008779;
    box-shadow: 0 -8px 24px rgba(15, 23, 42, 0.12);
    z-index: 99;
  }
  .bundle-bar-items-tray {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tray-empty-hint {
    font-size: 12px;
    color: #64748b;
    font-style: italic;
  }
  .tray-item-thumb {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    border: 1.5px solid #008779;
    object-fit: cover;
    background: #f8fafc;
  }
  .bundle-bar-meta {
    font-size: 13px;
  }
  .bundle-count-line {
    font-weight: 700;
    color: #0f172a;
  }
  .bundle-discount-badge {
    font-size: 11px;
    font-weight: 700;
    color: #008779;
  }
  .bundle-original-price {
    font-size: 12px;
    color: #94a3b8;
    text-decoration: line-through;
  }
  .bundle-final-price {
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
  }
  .btn-add-bundle-cart {
    padding: 14px 28px;
    font-size: 14px;
    font-weight: 700;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .btn-add-bundle-cart:hover:not(:disabled) {
    opacity: 0.9;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 135, 121, 0.25);
  }
  .btn-add-bundle-cart:disabled {
    background: #cbd5e1 !important;
    color: #94a3b8 !important;
    cursor: not-allowed;
  }
</style>

<script>
(function() {
  var bundleState = {};

  window.enamelsSwitchBundleTab = function(sectionId, tabKey) {
    var sectionEl = document.getElementById('enamels-bundle-builder-' + sectionId);
    if (!sectionEl) return;
    
    var tabs = sectionEl.querySelectorAll('.bundle-tab-btn');
    tabs.forEach(function(t) {
      var isTarget = t.getAttribute('data-tab') === tabKey;
      t.classList.toggle('active', isTarget);
      t.setAttribute('aria-selected', isTarget ? 'true' : 'false');
    });

    var panels = sectionEl.querySelectorAll('.bundle-panel');
    panels.forEach(function(p) {
      p.style.display = 'none';
      p.classList.remove('active');
    });

    var activePanel = document.getElementById('bpanel-' + sectionId + '-' + tabKey);
    if (activePanel) {
      activePanel.style.display = 'block';
      activePanel.classList.add('active');
    }
  };

  window.enamelsToggleBundleItem = function(sectionId, itemData) {
    if (!bundleState[sectionId]) bundleState[sectionId] = [];
    var list = bundleState[sectionId];
    
    var existingIndex = -1;
    for (var i = 0; i < list.length; i++) {
      if (list[i].variantId === itemData.variantId) {
        existingIndex = i;
        break;
      }
    }

    if (existingIndex !== -1) {
      list.splice(existingIndex, 1);
    } else {
      list.push(itemData);
    }

    renderBundleSummary(sectionId);
  };

  function renderBundleSummary(sectionId) {
    var sectionEl = document.getElementById('enamels-bundle-builder-' + sectionId);
    if (!sectionEl) return;

    var t1Count = parseInt(sectionEl.getAttribute('data-tier1-count')) || 2;
    var t1Disc = parseInt(sectionEl.getAttribute('data-tier1-discount')) || 5;
    var t2Count = parseInt(sectionEl.getAttribute('data-tier2-count')) || 3;
    var t2Disc = parseInt(sectionEl.getAttribute('data-tier2-discount')) || 10;
    var btnAddTxt = sectionEl.getAttribute('data-btn-add-label') || '+ Add to Bundle';
    var btnAddedTxt = sectionEl.getAttribute('data-btn-added-label') || '✓ Added in Bundle';

    var list = bundleState[sectionId] || [];
    var totalCount = list.length;
    var subtotal = 0;
    var trayEl = document.getElementById('bundle-tray-' + sectionId);
    var countEl = document.getElementById('bundle-total-count-' + sectionId);
    var origPriceEl = document.getElementById('bundle-original-price-' + sectionId);
    var finalPriceEl = document.getElementById('bundle-final-price-' + sectionId);
    var badgeEl = document.getElementById('bundle-tier-badge-' + sectionId);
    var btn = document.getElementById('btn-add-bundle-' + sectionId);

    // Update Category Badges
    var catCounts = { tops: 0, trousers: 0, labcoats: 0, caps: 0, accessories: 0 };
    list.forEach(function(item) {
      subtotal += item.price;
      if (item.category && catCounts[item.category] !== undefined) {
        catCounts[item.category]++;
      }
    });

    ['tops', 'trousers', 'labcoats', 'caps', 'accessories'].forEach(function(c) {
      var el = document.getElementById('b-count-' + c + '-' + sectionId);
      if (el) el.textContent = catCounts[c];
    });

    if (countEl) countEl.textContent = totalCount;

    // Render Tray Thumbs
    if (trayEl) {
      if (totalCount === 0) {
        var emptyHint = sectionEl.querySelector('.tray-empty-hint');
        trayEl.innerHTML = '<div class="tray-empty-hint">' + (emptyHint ? emptyHint.textContent : 'Select items to start your bundle') + '</div>';
      } else {
        var html = '';
        list.forEach(function(it) {
          html += '<img src="' + it.img + '" alt="' + it.title.replace(/"/g, '&quot;') + '" class="tray-item-thumb" title="' + it.title.replace(/"/g, '&quot;') + '">';
        });
        trayEl.innerHTML = html;
      }
    }

    // Dynamic Discount Tiers Calculation from Section Attributes
    var discountPercent = 0;
    if (totalCount >= t2Count) {
      discountPercent = t2Disc;
    } else if (totalCount >= t1Count) {
      discountPercent = t1Disc;
    }

    var finalPrice = subtotal * (1 - (discountPercent / 100));

    if (badgeEl) {
      if (discountPercent === t2Disc && t2Disc > 0) {
        badgeEl.textContent = '🎉 ' + t2Disc + '% Bundle Discount Applied!';
        badgeEl.style.color = '#15803d';
      } else if (discountPercent === t1Disc && t1Disc > 0) {
        var diff = t2Count - totalCount;
        badgeEl.textContent = '✨ ' + t1Disc + '% Bundle Discount Applied! Add ' + diff + ' more for ' + t2Disc + '% off';
        badgeEl.style.color = '#008779';
      } else if (totalCount > 0 && totalCount < t1Count) {
        var needed = t1Count - totalCount;
        badgeEl.textContent = 'Add ' + needed + ' more item to save ' + t1Disc + '%';
        badgeEl.style.color = '#008779';
      } else {
        badgeEl.textContent = 'Add ' + t1Count + ' items for ' + t1Disc + '% off, ' + t2Count + '+ for ' + t2Disc + '% off';
        badgeEl.style.color = '#64748b';
      }
    }

    if (origPriceEl) {
      if (discountPercent > 0) {
        origPriceEl.style.display = 'block';
        origPriceEl.textContent = 'PKR ' + Math.round(subtotal).toLocaleString();
      } else {
        origPriceEl.style.display = 'none';
      }
    }

    if (finalPriceEl) {
      finalPriceEl.textContent = 'PKR ' + Math.round(finalPrice).toLocaleString();
    }

    if (btn) {
      btn.disabled = (totalCount === 0);
    }

    // Update active button states in all cards
    var allCards = document.querySelectorAll('#enamels-bundle-builder-' + sectionId + ' .enamels-bundle-card');
    allCards.forEach(function(card) {
      var vId = card.getAttribute('data-active-variant-id');
      var isSelected = false;
      for (var j = 0; j < list.length; j++) {
        if (list[j].variantId === vId) {
          isSelected = true;
          break;
        }
      }
      var toggleBtn = card.querySelector('.btn-bundle-select');
      if (toggleBtn) {
        if (isSelected) {
          toggleBtn.classList.add('selected');
          toggleBtn.textContent = btnAddedTxt;
        } else {
          toggleBtn.classList.remove('selected');
          toggleBtn.textContent = btnAddTxt;
        }
      }
    });
  }

  window.enamelsSubmitBundleToCart = function(sectionId) {
    var sectionEl = document.getElementById('enamels-bundle-builder-' + sectionId);
    var list = bundleState[sectionId] || [];
    if (list.length === 0) return;

    var redirectTarget = (sectionEl && sectionEl.getAttribute('data-redirect') === 'checkout') ? '/checkout' : '/cart';

    var btn = document.getElementById('btn-add-bundle-' + sectionId);
    var txt = btn ? btn.querySelector('.btn-text') : null;
    var load = btn ? btn.querySelector('.btn-loading') : null;
    if (btn) btn.disabled = true;
    if (txt) txt.style.display = 'none';
    if (load) load.style.display = 'inline';

    var items = list.map(function(it) {
      return {
        id: it.variantId,
        quantity: 1,
        properties: {
          'Bundle Offer': 'Clinical Set Builder',
          'Selected Option': it.option || 'Default'
        }
      };
    });

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: items })
    })
    .then(function(res) {
      if (!res.ok) throw new Error('Cart add failed');
      return res.json();
    })
    .then(function() {
      window.location.href = redirectTarget;
    })
    .catch(function(err) {
      window.location.href = redirectTarget;
    });
  };

  // Theme Editor Live Synchronization
  document.addEventListener('shopify:section:load', function(e) {
    if (e.target.classList.contains('section-enamels-bundle-builder') || e.target.querySelector('.enamels-bundle-builder-section')) {
      var s = e.target.querySelector('.enamels-bundle-builder-section') || e.target;
      var sid = s.getAttribute('data-section-id');
      if (sid) renderBundleSummary(sid);
    }
  });
})();
</script>

