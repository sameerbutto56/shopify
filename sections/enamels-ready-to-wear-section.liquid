{% comment %}
  Enamels Modular Make Your Own Scrubs Customizer Section
  Renders the interactive 6-step bespoke scrub configurator on dedicated pages.
{% endcomment %}

<div class="page-container" style="padding: 30px 0 60px;" id="enamels-modular-customizer-container">
  {% render 'enamels-ready-to-wear', section: section %}
</div>

{% schema %}
{
  "name": "Bespoke Customizer Studio",
  "class": "enamels-rtw-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Customizer Heading",
      "default": "Make Your Own Scrubs Studio"
    }
  ],
  "presets": [
    {
      "name": "Bespoke Customizer Studio"
    }
  ]
}
{% endschema %}
