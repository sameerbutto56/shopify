{% comment %}
  Enamels Dedicated Category Section — Surgical Caps
  Provides fully independent Theme Editor settings for Caps (BunFit™) category,
  custom title, image size, aspect ratio, text alignment, colors, and direct collection routing.
{% endcomment %}

{%- liquid
  assign enable_section = section.settings.enable_section
  assign col = section.settings.collection
  assign category_title = section.settings.title | default: col.title | strip
  assign category_tag = section.settings.tag | strip
  assign category_desc = section.settings.description | default: col.description | strip
  assign btn_label = section.settings.button_label | strip
  assign btn_link = section.settings.button_link | default: col.url | default: '#category-caps'
  assign img_pos = section.settings.image_position | default: 'right'
  assign text_align = section.settings.text_alignment | default: 'left'
  assign aspect_ratio = section.settings.aspect_ratio | default: '4_3'
  assign bg_color = section.settings.section_bg | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#102a43'
  assign pad_top = section.settings.padding_top | default: 56
  assign pad_bottom = section.settings.padding_bottom | default: 56

  assign has_text_content = false
  if category_title != blank or category_tag != blank or category_desc != blank or btn_label != blank
    assign has_text_content = true
  endif
  if section.settings.show_features
    if section.settings.feat_1 != blank or section.settings.feat_2 != blank or section.settings.feat_3 != blank
      assign has_text_content = true
    endif
  endif
-%}

{% if enable_section %}
{%- style -%}
  #shopify-section-{{ section.id }} .category-visual-col {
    max-width: {{ section.settings.image_max_width_desktop | default: 560 }}px;
    width: 100%;
  }
  #shopify-section-{{ section.id }} .category-img-frame {
    border-radius: {{ section.settings.image_border_radius | default: 16 }}px;
    overflow: hidden;
    {% if section.settings.aspect_ratio == 'custom' %}
      height: {{ section.settings.image_height_desktop | default: 420 }}px;
      aspect-ratio: unset;
    {% elsif section.settings.aspect_ratio == '1_1' %}
      aspect-ratio: 1 / 1;
      height: auto;
    {% elsif section.settings.aspect_ratio == '3_4' %}
      aspect-ratio: 3 / 4;
      height: auto;
    {% elsif section.settings.aspect_ratio == '16_9' %}
      aspect-ratio: 16 / 9;
      height: auto;
    {% elsif section.settings.aspect_ratio == 'natural' %}
      aspect-ratio: auto;
      height: auto;
    {% else %}
      aspect-ratio: 4 / 3;
      height: auto;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .category-showcase-img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit_mode | default: 'cover' }};
    object-position: {{ section.settings.image_pos_x | default: 'center' }} {{ section.settings.image_pos_y | default: 'center' }};
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .category-visual-col {
      max-width: {{ section.settings.image_max_width_mobile | default: 340 }}px;
      margin: 0 auto;
    }
    {% if section.settings.aspect_ratio == 'custom' %}
      #shopify-section-{{ section.id }} .category-img-frame {
        height: {{ section.settings.image_height_mobile | default: 260 }}px;
      }
    {% endif %}
  }
{%- endstyle -%}
<section
  class="enamels-category-section-wrap enamels-homepage-modular-section"
  id="enamels-category-caps-section"
  style="
    background-color: {{ bg_color }};
    padding-top: {{ pad_top }}px;
    padding-bottom: {{ pad_bottom }}px;
    color: {{ text_color }};
  "
>
  <div class="page-container">
    <div class="category-showcase-layout img-pos-{{ img_pos }}{% unless has_text_content %} is-image-only{% endunless %}">
      <!-- Text & Action Content -->
      {% if has_text_content %}
      <div class="category-content-col align-{{ text_align }}">
        {% if category_tag != blank %}
          <span class="category-pill-tag">{{ category_tag | escape }}</span>
        {% endif %}

        {% if category_title != blank %}
          <h2 class="category-showcase-title" style="color: {{ text_color }};">
            {{ category_title | escape }}
          </h2>
        {% endif %}

        {% if category_desc != blank %}
          <p class="category-showcase-desc">
            {{ category_desc | escape }}
          </p>
        {% endif %}

        {% if section.settings.show_features %}
          <div class="category-features-grid">
            {% if section.settings.feat_1 != blank %}
              <div class="cat-feat-pill">✓ {{ section.settings.feat_1 | escape }}</div>
            {% endif %}
            {% if section.settings.feat_2 != blank %}
              <div class="cat-feat-pill">✓ {{ section.settings.feat_2 | escape }}</div>
            {% endif %}
            {% if section.settings.feat_3 != blank %}
              <div class="cat-feat-pill">✓ {{ section.settings.feat_3 | escape }}</div>
            {% endif %}
          </div>
        {% endif %}

        {% if btn_label != blank %}
          <div class="category-action-row">
            <a
              href="{{ btn_link }}"
              class="enamels-theme-btn-primary"
              style="
                background-color: {{ section.settings.button_bg | default: '#008779' }};
                color: {{ section.settings.button_color | default: '#ffffff' }};
              "
              onclick="if(window.selectProductCategory) { window.selectProductCategory('caps'); }"
            >
              {{ btn_label | escape }}
            </a>
          </div>
        {% endif %}
      </div>
      {% endif %}

      <!-- Category Visual Column -->
      <div class="category-visual-col">
        <div class="category-img-frame ratio-{{ aspect_ratio }}">
          {% assign showcase_img = section.settings.image %}
          {% if showcase_img == blank and col.featured_image != blank %}
            {% assign showcase_img = col.featured_image %}
          {% endif %}
          {% if showcase_img != blank %}
            <img
              src="{{ showcase_img | image_url: width: 1000 }}"
              alt="{{ showcase_img.alt | default: category_title | default: 'Surgical Caps' | escape }}"
              class="category-showcase-img"
              loading="lazy"
              width="600"
              height="450"
            />
          {% else %}
            <div class="category-img-placeholder" style="background: #f1f5f9; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; min-height: 280px;">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                <path d="M20.38 3.46L16 2a4 4 0 01-8 0L3.62 3.46a2 2 0 00-1.34 2.23l.58 3.47a1 1 0 00.99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 002-2V10h2.15a1 1 0 00.99-.84l.58-3.47a2 2 0 00-1.34-2.23z"/>
              </svg>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Category — Caps",
  "class": "enamels-category-caps-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Shopify Collection Source",
      "info": "Automatically loads collection title, description, featured image, and link from Shopify Admin."
    },
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Caps Section",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Category Heading",
      "default": "Surgical Caps (BunFit™)"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Category Tagline",
      "default": "THEATRE ERGONOMICS & COMFORT"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Short Description",
      "default": "Engineered with breathable sweatbands, pony/bun pouches, and elastic adjusters for surgeons, anesthetists, and scrub nurses."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Category Showcase Image"
    },
    {
      "type": "header",
      "content": "Thumbnail & Image Dimensions"
    },
    {
      "type": "range",
      "id": "image_max_width_desktop",
      "label": "Image Max Width Desktop (px)",
      "min": 250,
      "max": 800,
      "step": 10,
      "default": 560,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_height_desktop",
      "label": "Image Height Desktop (px)",
      "min": 200,
      "max": 700,
      "step": 10,
      "default": 420,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_max_width_mobile",
      "label": "Image Max Width Mobile (px)",
      "min": 180,
      "max": 480,
      "step": 10,
      "default": 340,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Image Height Mobile (px)",
      "min": 160,
      "max": 450,
      "step": 10,
      "default": 260,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "custom", "label": "Custom (Height in px)" },
        { "value": "1_1", "label": "Square (1:1)" },
        { "value": "4_3", "label": "Standard (4:3)" },
        { "value": "3_4", "label": "Portrait (3:4)" },
        { "value": "16_9", "label": "Landscape (16:9)" },
        { "value": "natural", "label": "Natural / Auto" }
      ],
      "default": "4_3"
    },
    {
      "type": "select",
      "id": "image_fit_mode",
      "label": "Image Fit Mode",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "image_pos_x",
      "label": "Horizontal Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "image_pos_y",
      "label": "Vertical Image Position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image Border Radius (px)",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Placement Desktop",
      "options": [
        { "value": "right", "label": "Image on Right" },
        { "value": "left", "label": "Image on Left" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Button & Destination"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore Surgical Caps →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Destination Link / Collection",
      "default": "/collections/all"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background Color",
      "default": "#008779"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Feature Badges"
    },
    {
      "type": "checkbox",
      "id": "show_features",
      "label": "Display Feature Badges",
      "default": true
    },
    {
      "type": "text",
      "id": "feat_1",
      "label": "Feature 1",
      "default": "BunFit™ Ponytail Pouch"
    },
    {
      "type": "text",
      "id": "feat_2",
      "label": "Feature 2",
      "default": "Absorbent Forehead Terry Band"
    },
    {
      "type": "text",
      "id": "feat_3",
      "label": "Feature 3",
      "default": "Autoclavable Color Fastness"
    },
    {
      "type": "header",
      "content": "Section Spacing & Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading & Text Color",
      "default": "#102a43"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 16,
      "max": 120,
      "step": 4,
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 16,
      "max": 120,
      "step": 4,
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Category — Caps"
    }
  ]
}
{% endschema %}
