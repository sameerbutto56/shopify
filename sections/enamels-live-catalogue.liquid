{% comment %}
  Enamels Modular Live Catalogue Section
  Renders curated real Shopify products on the homepage with block-driven interactive category pills,
  sort options, responsive grid layout, and clean empty states.
{% endcomment %}

{%- liquid
  assign enable_section = section.settings.enable_section
  assign tag_text = section.settings.section_tag | strip
  assign title_text = section.settings.section_title | strip
  assign subtitle_text = section.settings.section_subtitle | strip
  assign show_filter_pills = section.settings.show_filter_pills
  assign show_sort = section.settings.show_sort
  assign grid_cols = section.settings.grid_columns | default: 4

  assign filter_blocks_count = 0
  for block in section.blocks
    if block.type == 'filter_pill' and block.settings.visible != false
      assign filter_blocks_count = filter_blocks_count | plus: 1
    endif
  endfor
-%}

{% if enable_section %}
{%- style -%}
  #homepage-live-catalogue-section {
    padding-top: {{ section.settings.padding_top | default: 48 }}px !important;
    padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px !important;
    background-color: {{ section.settings.section_bg | default: '#ffffff' }};
  }
  #homepage-live-catalogue-section .categories-section-header {
    margin-bottom: {{ section.settings.header_margin_bottom | default: 16 }}px;
  }
  #homepage-live-catalogue-section #homepage-live-products-grid {
    display: grid !important;
    grid-template-columns: repeat(auto-fill, minmax({{ section.settings.card_min_width_desktop | default: 260 }}px, 1fr)) !important;
    gap: {{ section.settings.grid_gap_desktop | default: 24 }}px !important;
    margin-bottom: {{ section.settings.thumbnail_margin_bottom | default: 0 }}px !important;
  }
  #homepage-live-catalogue-section .product-preview-card {
    border-radius: {{ section.settings.card_border_radius | default: 12 }}px;
    background-color: {{ section.settings.card_bg | default: '#ffffff' }};
  }
  #homepage-live-catalogue-section .card-thumb-wrap {
    overflow: hidden;
    background-color: {{ section.settings.thumbnail_media_bg | default: '#ffffff' }};
    padding-top: {{ section.settings.thumbnail_pad_top | default: 0 }}px;
    padding-bottom: {{ section.settings.thumbnail_pad_bottom | default: 0 }}px;
    border-top-left-radius: {{ section.settings.card_border_radius | default: 12 }}px;
    border-top-right-radius: {{ section.settings.card_border_radius | default: 12 }}px;
    {% if section.settings.thumbnail_aspect_ratio == 'custom' %}
      height: {{ section.settings.thumbnail_height_desktop | default: 320 }}px;
      aspect-ratio: unset;
    {% elsif section.settings.thumbnail_aspect_ratio == '1_1' %}
      aspect-ratio: 1 / 1;
      height: auto;
    {% elsif section.settings.thumbnail_aspect_ratio == '3_4' %}
      aspect-ratio: 3 / 4;
      height: auto;
    {% elsif section.settings.thumbnail_aspect_ratio == '4_3' %}
      aspect-ratio: 4 / 3;
      height: auto;
    {% elsif section.settings.thumbnail_aspect_ratio == '16_9' %}
      aspect-ratio: 16 / 9;
      height: auto;
    {% elsif section.settings.thumbnail_aspect_ratio == 'natural' %}
      aspect-ratio: auto;
      height: auto;
    {% elsif section.settings.thumbnail_aspect_ratio == '4_5' %}
      aspect-ratio: 4 / 5;
      height: auto;
    {% else %}
      aspect-ratio: var(--product-thumbnail-aspect-ratio, 2 / 3);
      height: auto;
    {% endif %}
  }
  #homepage-live-catalogue-section .card-img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit_mode | default: 'contain' }};
    object-position: {{ section.settings.image_pos_x | default: 'center' }} {{ section.settings.image_pos_y | default: 'center' }};
    transform: scale({{ section.settings.image_zoom | default: 100 | divided_by: 100.0 }});
    transform-origin: center center;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #homepage-live-catalogue-section .card-body-wrap {
    padding: {{ section.settings.caption_padding | default: 16 }}px;
  }
  @media (max-width: 768px) {
    #homepage-live-catalogue-section {
      padding-top: {{ section.settings.padding_top | default: 48 | times: 0.7 | round }}px !important;
      padding-bottom: {{ section.settings.padding_bottom | default: 48 | times: 0.7 | round }}px !important;
    }
    #homepage-live-catalogue-section #homepage-live-products-grid {
      grid-template-columns: repeat(auto-fill, minmax({{ section.settings.card_min_width_mobile | default: 160 }}px, 1fr)) !important;
      gap: {{ section.settings.grid_gap_mobile | default: 12 }}px !important;
    }
    {% if section.settings.thumbnail_aspect_ratio == 'custom' %}
      #homepage-live-catalogue-section .card-thumb-wrap {
        height: {{ section.settings.thumbnail_height_mobile | default: 220 }}px;
      }
    {% endif %}
  }
{%- endstyle -%}
<section class="page-container enamels-homepage-modular-section" id="homepage-live-catalogue-section" aria-label="Curated Live Product Catalogue">
  {% if tag_text != blank or title_text != blank or subtitle_text != blank %}
    <div class="categories-section-header" style="margin-bottom: {{ section.settings.header_margin_bottom | default: 16 }}px;">
      {% if tag_text != blank %}
        <span class="categories-section-tag">{{ tag_text | escape }}</span>
      {% endif %}
      {% if title_text != blank %}
        <h2 class="categories-section-title">{{ title_text | escape }}</h2>
      {% endif %}
      {% if subtitle_text != blank %}
        <p class="categories-section-subtitle">{{ subtitle_text | escape }}</p>
      {% endif %}
    </div>
  {% endif %}

  {% if show_filter_pills or show_sort %}
  <!-- Category Filter & Sort Bar -->
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin: 20px 0 28px; padding-bottom: 16px; border-bottom: 1px solid #e2e8f0;">
    {% if show_filter_pills %}
    <div style="display: flex; gap: 8px; flex-wrap: wrap;" id="homepage-category-filter-pills">
      {% assign pill_idx = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'filter_pill' and block.settings.visible != false %}
          <button
            type="button"
            class="filter-pill-btn {% if pill_idx == 0 %}active{% endif %}"
            id="hp-filter-{{ block.settings.category_key | default: 'all' | handleize }}"
            data-cat="{{ block.settings.category_key | default: 'all' }}"
            onclick="if (typeof window.filterHomepageGrid === 'function') window.filterHomepageGrid('{{ block.settings.category_key | default: 'all' }}');"
            {{ block.shopify_attributes }}
          >
            <span class="filter-pill-text">{{ block.settings.title | escape }}</span>
          </button>
          {% assign pill_idx = pill_idx | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}

    {% if show_sort %}
    <div style="display: flex; align-items: center; gap: 8px;">
      <label for="homepage-sort-select" style="font-size: 12px; color: #64748b; font-weight: 600;">Sort By:</label>
      <select id="homepage-sort-select" class="form-field-select" style="padding: 6px 12px; font-size: 12px; width: auto;" onchange="if (typeof window.sortHomepageGrid === 'function') window.sortHomepageGrid(this.value);">
        <option value="featured">Featured</option>
        <option value="price-low">Price: Low to High</option>
        <option value="price-high">Price: High to Low</option>
        <option value="name">Name: A to Z</option>
      </select>
    </div>
    {% endif %}
  </div>
  {% endif %}

  <!-- The Grid container where real Shopify products like 'junaid' immediately render -->
  <div
    class="enamels-products-grid"
    id="homepage-live-products-grid"
  >
    <!-- Populated dynamically via window.renderHomepageLiveGrid() -->
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Live Product Catalogue",
  "class": "enamels-live-catalogue-wrapper",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Section",
      "default": true
    },
    {
      "type": "text",
      "id": "section_tag",
      "label": "Section Header Tag",
      "default": "ONLINE STORE APPAREL & ACCESSORIES"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Curated Product Catalogue"
    },
    {
      "type": "textarea",
      "id": "section_subtitle",
      "label": "Section Subtitle",
      "default": "Explore our live collection of clinical scrubs, lab coats, surgical caps, and accessories."
    },
    {
      "type": "checkbox",
      "id": "show_filter_pills",
      "label": "Show Category Filter Pills",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show Sort Dropdown",
      "default": true
    },
    {
      "type": "header",
      "content": "Thumbnail & Product Card Dimensions"
    },
    {
      "type": "range",
      "id": "card_min_width_desktop",
      "label": "Card Min Width Desktop (px)",
      "min": 180,
      "max": 450,
      "step": 10,
      "default": 260,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_min_width_mobile",
      "label": "Card Min Width Mobile (px)",
      "min": 130,
      "max": 280,
      "step": 10,
      "default": 160,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "thumbnail_aspect_ratio",
      "label": "Card Media Aspect Ratio",
      "options": [
        { "value": "4_5", "label": "Tall Portrait (4:5)" },
        { "value": "3_4", "label": "Standard Portrait (3:4)" },
        { "value": "1_1", "label": "Square (1:1)" },
        { "value": "4_3", "label": "Landscape (4:3)" },
        { "value": "16_9", "label": "Wide (16:9)" },
        { "value": "custom", "label": "Custom Height (px)" },
        { "value": "natural", "label": "Natural / Auto" }
      ],
      "default": "4_5"
    },
    {
      "type": "range",
      "id": "thumbnail_height_desktop",
      "label": "Custom Media Height Desktop (px)",
      "min": 180,
      "max": 600,
      "step": 10,
      "default": 320,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "thumbnail_height_mobile",
      "label": "Custom Media Height Mobile (px)",
      "min": 140,
      "max": 400,
      "step": 10,
      "default": 220,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_fit_mode",
      "label": "Image Fit Mode",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "image_pos_x",
      "label": "Horizontal Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "image_pos_y",
      "label": "Vertical Image Position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card Border Radius (px)",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "grid_gap_desktop",
      "label": "Grid Gap Desktop (px)",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "label": "Grid Gap Mobile (px)",
      "min": 8,
      "max": 24,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "caption_padding",
      "label": "Card Body / Caption Padding (px)",
      "min": 8,
      "max": 32,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Section & Thumbnail Spacing (Top & Bottom)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Section Top Space (Padding Top in px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Section Bottom Space (Padding Bottom in px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "header_margin_bottom",
      "label": "Space Below Heading / Above Thumbnails (px)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "thumbnail_margin_bottom",
      "label": "Space Below Thumbnail Grid (px)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Thumbnail Image Spacing & Letterbox Controls"
    },
    {
      "type": "range",
      "id": "image_zoom",
      "label": "Image Zoom / Scale (%) - Crop Out Black Letterbox Bars",
      "min": 100,
      "max": 180,
      "step": 2,
      "default": 100,
      "unit": "%",
      "info": "Increase zoom to crop out black bands or screenshot borders on top and bottom."
    },
    {
      "type": "range",
      "id": "thumbnail_pad_top",
      "label": "Thumbnail Top Inner Space / Padding (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "thumbnail_pad_bottom",
      "label": "Thumbnail Bottom Inner Space / Padding (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "thumbnail_media_bg",
      "label": "Thumbnail Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "filter_pill",
      "name": "Category Filter Pill",
      "settings": [
        {
          "type": "checkbox",
          "id": "visible",
          "label": "Show Pill",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "label": "Filter Pill Label",
          "default": "All Products"
        },
        {
          "type": "select",
          "id": "category_key",
          "label": "Filter Category Target",
          "options": [
            { "value": "all", "label": "All Products" },
            { "value": "scrubs", "label": "Scrubs" },
            { "value": "lab-coat", "label": "Lab Coats" },
            { "value": "caps", "label": "Surgical Caps" },
            { "value": "accessories", "label": "Accessories & Sleeves" },
            { "value": "sprinter", "label": "Sprinter Series" },
            { "value": "vilora", "label": "Vilora Series" },
            { "value": "crown", "label": "Crown Series" }
          ],
          "default": "all"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Live Product Catalogue"
    }
  ]
}
{% endschema %}
