    "faq_accordion": {
      "type": "faq-accordion",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "How do I choose between Sprinter, Velora, and Crown scrubs?",
            "answer": "Sprinter is built with 4-way mechanical athletic stretch twill for high-activity wards and ERs. Velora features a luxury micro-drape with fluid contour and wrinkle-release for outpatient comfort. Crown provides executive structure with a standing mandarin collar for department heads."
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Can I get my name and hospital logo embroidered?",
            "answer": "Yes. We offer computerized precision embroidery for doctor names, qualifications, department titles, and certified hospital crests (including AKUH, Shaukat Khanum, Doctors Hospital, and custom institutional logos)."
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "What is the advance payment requirement for custom orders?",
            "answer": "Standard ready-to-wear scrubs can be ordered via Cash on Delivery (COD). Any orders featuring personalized name embroidery, hospital crests, or custom tailored sizing require a minimum 50% advance deposit via bank transfer before production begins."
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "What is your size exchange policy?",
            "answer": "We offer a 7-day hassle-free size exchange policy across Pakistan. Simply contact our WhatsApp concierge (+92 301 13 31 133) with your order number, and our team will guide you through the instant exchange process."
          }
        }
      },
      "block_order": [
        "faq_1",
        "faq_2",
        "faq_3",
        "faq_4"
      ],
