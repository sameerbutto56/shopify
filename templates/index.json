      "type": "faq-accordion",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "What is the delivery time across Pakistan?",
            "answer": "Standard shipping takes 2-4 business days for major cities (Karachi, Lahore, Islamabad, Rawalpindi) and 3-5 business days for other regions across Pakistan via Trax, PostEx, and TCS."
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Is Cash on Delivery (COD) available?",
            "answer": "Yes! Cash on Delivery is available nationwide across all cities, towns, and medical institutions in Pakistan."
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "How do I choose the correct scrub size?",
            "answer": "Our scrubs follow standard clinical sizing from XS to XXL. Check the detailed Size Guide on any product page, or contact our WhatsApp concierge team for instant sizing recommendations."
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "What is your size exchange and return policy?",
            "answer": "We offer a 7-day hassle-free exchange policy. If your scrubs don't fit perfectly, simply reach out to us on WhatsApp and we will dispatch your replacement size."
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "question": "Can I add custom doctor name embroidery?",
            "answer": "Yes! Use our Step-by-Step Customization Wizard on any scrub page to choose Direct Name Embroidery (+Rs. 450), Name Patch (+Rs. 350), or Hospital Logo Embroidery (+Rs. 650) with live chest pocket preview."
          }
        }
      },
