{% comment %}
  Enamels Customer & Administrator Account Template
  Separates retail customer experience from internal Store Administrator profile.
  - Normal customers see dedicated Customer Account Dashboard (order history, custom scrub status, addresses).
  - Authorized Store Staff / Admins see the comprehensive Administrative Desks (Customize Orders, Bulk Queries, Store Controls).
{% endcomment %}

{%- liquid
  assign is_store_admin = false
  if customer and (customer.tags contains 'admin' or customer.tags contains 'staff' or customer.tags contains 'owner')
    assign is_store_admin = true
  endif
-%}

{%- if is_store_admin -%}
  {% section 'enamels-admin-profile' %}
{%- else -%}
  {% section 'enamels-customer-account' %}
{%- endif -%}
