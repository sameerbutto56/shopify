{% comment %}
  Enamels Branded Customer / Administrator Sign In
{% endcomment %}

<div class="customer-auth-container" style="max-width: 480px; margin: 60px auto 100px; padding: 32px 24px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.04); font-family: inherit;">
  <div style="text-align: center; margin-bottom: 24px;">
    <h1 style="font-size: 24px; font-weight: 800; color: #102a43; margin: 0;">Sign In to Enamels</h1>
    <p style="font-size: 13px; color: #64748b; margin: 6px 0 0;">Access your Profile, Customize Orders Desk, and Bulk Enquiries.</p>
  </div>

  {% form 'customer_login' %}
    {{ form.errors | default_errors }}

    <div style="margin-bottom: 16px;">
      <label for="CustomerEmail" style="display: block; font-size: 12px; font-weight: 700; color: #334155; margin-bottom: 6px; text-transform: uppercase;">Email Address</label>
      <input type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" required style="width: 100%; padding: 10px 14px; border: 1.5px solid #cbd5e1; border-radius: 6px; font-size: 14px; box-sizing: border-box;">
    </div>

    {% if form.password_needed %}
      <div style="margin-bottom: 20px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
          <label for="CustomerPassword" style="font-size: 12px; font-weight: 700; color: #334155; text-transform: uppercase;">Password</label>
          <a href="#recover" onclick="document.getElementById('recover-password-box').style.display='block'; return false;" style="font-size: 12px; color: #008779; text-decoration: none;">Forgot password?</a>
        </div>
        <input type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" required style="width: 100%; padding: 10px 14px; border: 1.5px solid #cbd5e1; border-radius: 6px; font-size: 14px; box-sizing: border-box;">
      </div>
    {% endif %}

    <button type="submit" style="width: 100%; background: #102a43; color: #ffffff; border: none; padding: 12px; border-radius: 6px; font-size: 14px; font-weight: 700; cursor: pointer;">
      Sign In
    </button>

    <div style="text-align: center; margin-top: 20px; font-size: 13px; color: #64748b;">
      Don't have an account? <a href="{{ routes.account_register_url }}" style="color: #008779; font-weight: 700; text-decoration: none;">Create account</a>
    </div>


  {% endform %}

  <div id="recover-password-box" style="display: none; margin-top: 24px; padding-top: 20px; border-top: 1px solid #e2e8f0;">
    <h3 style="font-size: 16px; font-weight: 700; color: #102a43; margin: 0 0 8px;">Reset Password</h3>
    <p style="font-size: 12px; color: #64748b; margin: 0 0 14px;">We will send you an email to reset your password.</p>
    {% form 'recover_customer_password' %}
      {{ form.errors | default_errors }}
      <div style="margin-bottom: 14px;">
        <input type="email" name="email" id="RecoverEmail" placeholder="Enter your email" required style="width: 100%; padding: 10px 14px; border: 1.5px solid #cbd5e1; border-radius: 6px; font-size: 14px; box-sizing: border-box;">
      </div>
      <button type="submit" style="width: 100%; background: #008779; color: #ffffff; border: none; padding: 10px; border-radius: 6px; font-size: 13px; font-weight: 700; cursor: pointer;">
        Send Reset Email
      </button>
    {% endform %}
  </div>
</div>
